        "text": "霜",
        "variant": "雲",
        "source": "一作「雲」"
      }
    ]
  },
  {
    "uid": "QTS_110_003_01",
    "volume": 110,
    "author": {
      "canonical": "張諤",
      "recorded": "張諤"
    },
    "title": "三日岐王宅",
    "poem": [
      "玉女貴妃生，嫛婗始發聲。",
      "金盆浴未了，綳子繡初成。",
      "翡翠雕芳縟，真珠帖小纓。",
      "何時學健步？鬬取落花輕。"
    ]
  },
  {
    "uid": "QTS_110_004_01",
    "volume": 110,
    "author": {
      "canonical": "張諤",
      "recorded": "張諤"
    },
    "title": "滿月",
    "poem": [
      "社金流茂祉，庭玉表奇才。",
      "竹似因談植，蘭疑入夢栽。",
      "烏將八子去，鳳逐九雛來。",
      "今夜明珠色，當隨滿月開。"
    ]
  },
  {
    "uid": "QTS_110_005_01",
    "volume": 110,
    "author": {
      "canonical": "張諤",
      "recorded": "張諤"
    },
    "title": "岐王山亭",
    "poem": [
      "王家傍綠池，春色正相宜。",
      "豈有樓臺好，兼看草樹奇。",
      "石榴天上葉，椰子日南枝。",
      "出入千門裏，年年樂未移。"
    ]
  },
  {
    "uid": "QTS_110_006_01",
    "volume": 110,
    "author": {
      "canonical": "張諤",
      "recorded": "張諤"
    },
    "title": "岐王席上詠美人",
    "poem": [
      "半額畫雙蛾，盈盈燭下歌。",
      "玉杯寒意少，金屋夜情多。",
      "香豔王分帖，裙嬌敕賜羅。",
      "平陽莫相妬，喚出不如他。"
    ],
    "variants": [
