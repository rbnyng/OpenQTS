    "title": "從軍行",
    "poem": [
      "烽火照西京",
      "心中自不平",
      "牙璋辭鳳闕",
      "鐵騎繞龍城",
      "雪暗凋旗畫",
      "風多雜鼓聲",
      "寧爲百夫長",
      "勝作一書生"
    ]
  },
