[
  {
    "uid": "QTS_850_001_01",
    "volume": 850,
    "author": {
      "canonical": "曇翼",
      "recorded": "曇翼",
      "gender": "male"
    },
    "title": "招隱",
    "poem": [
      "連峰數千里，修林帶平津。",
      "雲起遠山翳，風至□荒榛。",
      "茅茨隱不見，雞鳴知有人。",
      "躡磴踐其跡，處處見遺薪。",
      "乃知百代下，固有上皇民。"
    ]
  },
  {
    "uid": "QTS_850_002_01",
    "volume": 850,
    "author": {
      "canonical": "隱求",
      "recorded": "隱求",
      "gender": "male"
    },
    "title": "石橋琪樹",
    "poem": [
      "山上天將近，人間路漸遙。",
      "誰當雲裏見，知欲渡仙橋。"
    ]
  },
  {
    "uid": "QTS_850_003_01",
    "volume": 850,
    "author": {
      "canonical": "智遠",
      "recorded": "智遠",
      "gender": "male"
    },
    "title": "律僧",
    "poem": [
      "濾水與龕燈，長長護有情。",
      "自從青草出，便不下階行。",
      "北闕應無夢，南山舊有名。",
      "將何喻浮世，惟指浪漚輕。"
    ]
  },
  {
    "uid": "QTS_850_004_01",
    "volume": 850,
    "author": {
      "canonical": "無悶",
      "recorded": "無悶",
      "gender": "male"
    },
    "title": "暮春送人",
    "poem": [
      "折柳亭邊手重攜，江煙澹澹草萋萋。",
      "杜鵑不解離人意，更向落花枝上啼。"
    ]
  },
  {
    "uid": "QTS_850_005_01",
    "volume": 850,
    "author": {
      "canonical": "無悶",
      "recorded": "無悶",
      "gender": "male"
    },
    "title": "寒林石屏",
    "poem": [
      "草堂無物伴身閑，惟有屏風枕簟間。",
      "本向他山求得石，卻於石上看他山。"
    ]
  },
  {
    "uid": "QTS_850_006_01",
    "volume": 850,
    "author": {
      "canonical": "尚志",
      "recorded": "尚志",
      "gender": "male"
    },
    "title": "江上秋志",
    "poem": [
      "到來江上久，誰念旅遊心。",
      "故國無秋信，鄰家有暮砧。",
      "坐遙翻不睡，愁極卻成吟。",
      "即恐髭連鬢，還為白所侵。"
    ]
  },
  {
    "uid": "QTS_850_007_01",
    "volume": 850,
    "author": {
      "canonical": "玄寶",
      "recorded": "玄寶",
      "gender": "male"
    },
    "title": "路",
    "poem": [
      "南北東西去，茫茫萬古塵。",
      "關河無盡處，風雪有行人。",
      "險極山通蜀，平多地入秦。",
      "營營名利者，來往豈辭頻。"
    ]
  },
  {
    "uid": "QTS_850_008_01",
    "volume": 850,
    "author": {
      "canonical": "懷浦",
      "recorded": "懷浦",
      "gender": "male"
    },
    "title": "贈智舟三藏",
    "poem": [
      "壯歲心難伏，師心伏豈難。",
      "尋常獨在院，行坐不離壇。",
      "嶽雪當禪暝，松聲入咒寒。",
      "更因文字外，多把史書看。"
    ]
  },
  {
    "uid": "QTS_850_009_01",
    "volume": 850,
    "author": {
      "canonical": "懷浦",
      "recorded": "懷浦",
      "gender": "male"
    },
    "title": "初冬旅舍早懷",
    "poem": [
      "枕上角聲微，離情未息機。",
      "夢回三楚寺，寒入五更衣。",
      "月沒棲禽動，霜晴凍葉飛。",
      "自慚行役早，深與道相違。"
    ]
  },
  {
    "uid": "QTS_850_010_01",
    "volume": 850,
    "author": {
      "canonical": "亞棲",
      "recorded": "亞棲",
      "gender": "male",
      "wikidata_id": "Q18908168"
    },
    "title": "對禦書後一絕",
    "poem": [
      "通神筆法得玄門，親入長安謁至尊。",
      "莫怪出來多意氣，草書曾悅聖明君。"
    ]
  },
  {
    "uid": "QTS_850_011_01",
    "volume": 850,
    "author": {
      "canonical": "亞棲",
      "recorded": "亞棲",
      "gender": "male",
      "wikidata_id": "Q18908168"
    },
    "title": "題英禪師",
    "poem": [
      "將知德行異尋常，每見持經在道場。",
      "欲識用心精潔處，一瓶秋水一爐香。"
    ]
  },
  {
    "uid": "QTS_850_012_01",
    "volume": 850,
    "author": {
      "canonical": "惟審",
      "recorded": "惟審",
      "gender": "male"
    },
    "title": "別友人",
    "poem": [
      "一身無定處，萬里獨銷魂。",
      "芳草迷歸路，春衣滴淚痕。",
      "幾時休旅食，向夜宿江村。",
      "欲識異鄉苦，空山啼暮猿。"
    ]
  },
  {
    "uid": "QTS_850_013_01",
    "volume": 850,
    "author": {
      "canonical": "惟審",
      "recorded": "惟審",
      "gender": "male"
    },
    "title": "賦得聞曉鶯啼",
    "poem": [
      "捲簾清夢後，芳樹引流鶯。",
      "隔葉傳春意，穿花送曉聲。",
      "未調雲路翼，空負桂枝情。",
      "莫盡關關興，羈愁正厭生。"
    ]
  },
  {
    "uid": "QTS_850_014_01",
    "volume": 850,
    "author": {
      "canonical": "惟審",
      "recorded": "惟審",
      "gender": "male"
    },
    "title": "春日旅懷呈知己",
    "poem": [
      "生涯萬事有蒼蒼，應任流萍便越鄉。",
      "春水獨行人漸遠，故園歸夢夜空長。",
      "一聲隔浦猿啼處，數滴驚心淚滿裳。",
      "不為知音皆鮑叔，信誰江上去茫茫。"
    ]
  },
  {
    "uid": "QTS_850_015_01",
    "volume": 850,
    "author": {
      "canonical": "墓幽",
      "recorded": "墓幽",
      "gender": "male"
    },
    "title": "劍客",
    "poem": [
      "去住知何處，空將一劍行。",
      "殺人雖取次，為事愛公平。",
      "戟立嗔髭鬢，星流忿眼睛。",
      "曉來湘市說，拂曙別遼城。"
    ]
  },
  {
    "uid": "QTS_850_016_01",
    "volume": 850,
    "author": {
      "canonical": "墓幽",
      "recorded": "墓幽",
      "gender": "male"
    },
    "title": "酬和友人見寄",
    "poem": [
      "勞歌好自看，終久偶齊桓。",
      "五字若教易，一名爭得難。",
      "侵窗紅樹老，蔭砌雪花殘。",
      "莫效齊僚屬，東歸剪釣竿。"
    ]
  },
  {
    "uid": "QTS_850_017_01",
    "volume": 850,
    "author": {
      "canonical": "墓幽",
      "recorded": "墓幽",
      "gender": "male"
    },
    "title": "冬日淮上別文上人",
    "poem": [
      "家國各萬里，同吟六七年。",
      "可堪隨北雁，迢遞向南天。",
      "水共行人遠，山將落日連。",
      "春淮有雙鯉，莫忘尺書傳。"
    ]
  },
  {
    "uid": "QTS_850_018_01",
    "volume": 850,
    "author": {
      "canonical": "墓幽",
      "recorded": "墓幽",
      "gender": "male"
    },
    "title": "柳",
    "poem": [
      "今古憑君一贈行，幾回折盡複重生。",
      "五株斜傍淵明宅，千樹低垂太尉營。",
      "臨水帶煙藏翡翠，倚風兼雨宿流鶯。",
      "隋皇堤畔依依在，曾惹當時歌吹聲。"
    ]
  },
  {
    "uid": "QTS_850_019_01",
    "volume": 850,
    "author": {
      "canonical": "墓幽",
      "recorded": "墓幽",
      "gender": "male"
    },
    "title": "三峽聞猿",
    "poem": [
      "誰向茲來不恨生，聲聲都是斷腸聲。",
      "七千裏外一家住，十二峰前獨自行。",
      "瘴雨晚藏神女廟，蠻煙寒鎖夜郎城。",
      "憑君且聽哀吟好，會待青雲道路平。"
    ]
  },
  {
    "uid": "QTS_850_020_01",
    "volume": 850,
    "author": {
      "canonical": "墓幽",
      "recorded": "墓幽",
      "gender": "male"
    },
    "title": "燈",
    "poem": [
      "鐘斷危樓鳥不飛，熒熒何處最相宜。",
      "香然水寺僧開卷，筆寫春幃客著詩。",
      "忽爾思多穿壁處，偶然心盡斷纓時。",
      "孫康勤苦誰能念，少減餘光借與伊。"
    ]
  },
  {
    "uid": "QTS_850_021_01",
    "volume": 850,
    "author": {
      "canonical": "釋彪",
      "recorded": "釋彪",
      "gender": "male"
    },
    "title": "寶琴",
    "poem": [
      "吾有一寶琴，價重雙南金。",
      "刻作龍鳳象，彈為山水音。",
      "星從徽裏發，風來弦上吟。",
      "鐘期不可遇，誰辨曲中心。"
    ]
  },
  {
    "uid": "QTS_850_022_01",
    "volume": 850,
    "author": {
      "canonical": "法輪",
      "recorded": "法輪",
      "gender": "male"
    },
    "title": "觀大駕出敘事寄懷",
    "poem": [
      "紫台宵漏竭，青門曙鼓通。",
      "輕霞照複道，徐吹轉相風。",
      "玉鸞光萬騎，金輿鬱五戎。",
      "鳴笳猶度闕，清蹕尚喧宮。",
      "雲旗亂陌紫，羽旆雜塵紅。",
      "百城歸北麗，兩漢久慚雄。",
      "吾曹陋薄技，餘慶洽微躬。",
      "平源已起洛，印手亦還豐。",
      "得奉衣冠盛，仍觀書軌同。",
      "猶言待封告，未忍向華嵩。"
    ]
  },
  {
    "uid": "QTS_850_023_01",
    "volume": 850,
    "author": {
      "canonical": "尚能",
      "recorded": "尚能",
      "gender": "male"
    },
    "title": "中秋旅懷",
    "poem": [
      "所畜惟騷雅，兼之得固窮。",
      "望鄉連北斗，聽雨帶西風。",
      "稼穡村坊遠，煙波路徑通。",
      "冥搜清絕句，恰似有神功。"
    ]
  },
  {
    "uid": "QTS_850_024_01",
    "volume": 850,
    "author": {
      "canonical": "尚能",
      "recorded": "尚能",
      "gender": "male"
    },
    "title": "句",
    "poem": [
      "霜洲楓落盡，月館竹生寒。"
    ]
  },
  {
    "uid": "QTS_850_025_01",
    "volume": 850,
    "author": {
      "canonical": "常雅",
      "recorded": "常雅",
      "gender": "male"
    },
    "title": "題伍相廟",
    "poem": [
      "蒼蒼古廟映林巒，漠漠煙霞覆古壇。",
      "精魄不知何處在，威風猶入浙江寒。"
    ]
  },
  {
    "uid": "QTS_850_026_01",
    "volume": 850,
    "author": {
      "canonical": "滄浩",
      "recorded": "滄浩",
      "gender": "male"
    },
    "title": "懷舊山",
    "poem": [
      "一坐西林寺，從來未下山。",
      "不因尋長者，無事到人間。",
      "宿雨愁為客，寒花笑未還。",
      "空懷舊山月，童子誦經閑。"
    ]
  },
  {
    "uid": "QTS_850_027_01",
    "volume": 850,
    "author": {
      "canonical": "若水",
      "recorded": "若水",
      "gender": "male"
    },
    "title": "題慧山泉",
    "poem": [
      "石脈綻寒光，松根噴曉涼。",
      "注瓶雲母滑，漱齒茯苓香。",
      "野客偷煎茗，山僧借淨床。",
      "安禪何所問，孤月在中央。"
    ]
  },
  {
    "uid": "QTS_850_028_01",
    "volume": 850,
    "author": {
      "canonical": "文鑒",
      "recorded": "文鑒",
      "gender": "male"
    },
    "title": "題馬跡山",
    "poem": [
      "瀛洲西望沃洲山，山在平湖縹緲間。",
      "常說使君千里馬，至今龍跡尚堪攀。"
    ]
  }
]