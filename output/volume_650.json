  },
  {
    "uid": "QTS_650_018_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "漳州於使君罷郡如之任漳南去上國二十四州使君無非親故",
    "poem": [
      "漳南罷郡如之任，二十四州相次迎。",
      "泊岸旗幡郵吏拜，連山風雨探人行。",
      "月中倚棹吟漁浦，花底垂鞭醉鳳城。",
      "聖主此時思共理，又應何處救蒼生。"
    ]
  },
  {
    "uid": "QTS_650_019_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "送弟子伍秀才赴舉",
    "poem": [
      "天遣相門延積慶，今同太廟薦嘉賓。",
      "柳條此日同誰折，桂樹明年為爾春。",
      "倚棹寒吟漁浦月，垂鞭醉入鳳城塵。",
      "由來不要文章得，要且文章出眾人。"
    ]
  },
  {
    "uid": "QTS_650_020_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "貽高讜",
    "poem": [
      "都緣相府有宗兄，卻恐妨君正路行。",
      "石上長松自森秀，雪中孤玉更凝明。",
      "西陵曉月中秋色，北固軍鼙半夜聲。",
      "幸有清才與洪筆，何愁高節不公卿。"
    ]
  },
  {
    "uid": "QTS_650_021_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "題長洲陳明府小亭",
    "poem": [
      "坐看孤峭卻勞神，還是微吟到日曛。",
      "松鶴認名呼得下，沙蟬飛處聽猶聞。",
      "夜闌亦似深山月，雨後唯關滿屋雲。",
      "便此消遙應不易，朱衣紅旆未容君。"
    ]
  },
  {
    "uid": "QTS_650_022_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "送朱二十赴漣水",
    "poem": [
      "到縣卻應嫌水闊，離家終是見山疎。",
      "笙歌不駐難辭酒，舟楫將行負擔書。",
      "為政必能安楚老，向公猶可釣淮魚。",
      "鸞凰取便多如此，掠地斜飛上太虛。"
    ]
  },
  {
    "uid": "QTS_650_023_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "德政上睦州胡中丞",
    "poem": [
      "上德由來合動天，旌旗到日是豐年。",
      "羣書已熟無人似，五字研成舉世傳。",
      "莫道政聲同宇宙，須知紫氣滿山川。",
      "豈唯里巷皆蘇息，猶有恩波及釣船。"
    ]
  },
  {
    "uid": "QTS_650_024_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "袁明府以家醞寄余，余以山梅答贈，非唯四韻，兼亦雙關",
    "poem": [
      "封匏寄酒提攜遠，織籠盛梅答贈遲。",
      "九度攪和誰用法，四邊窺摘自攀枝。",
      "樽罍泛蟻堪嘗日，童稚驅禽欲熟時。",
      "畢卓醉狂潘氏少，傾來擲去恰相宜。"
    ]
  },
  {
    "uid": "QTS_650_025_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "上杭州姚郎中",
    "poem": [
      "能除疾瘼似良醫，一郡鄉風當日移。",
      "身貴久離行藥伴，才高獨作後人師。",
      "春遊下馬皆成醼，吏散看山即有詩。",
      "借問公方與文道，而今中夏更傳誰？"
    ],
