[
  {
    "uid": "QTS_650_001_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "元日",
    "poem": [
      "晨雞兩遍報更闌，刁斗無聲曉漏幹。",
      "暖日映山調正氣，東風入樹舞殘寒。",
      "軒車欲識人間感，獻歲須來帝里看。",
      "纔酌屠蘇定年齒，坐中惟笑鬢毛斑。"
    ]
  },
  {
    "uid": "QTS_650_002_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "別從兄郜",
    "poem": [
      "展翅開帆祇待風，吹噓成事古今同。",
      "已呼斷雁歸行裏，全勝枯鱗在轍中。",
      "若許死前恩少報，終期言下命潛通。",
      "臨岐再拜無餘事，願取文章達聖聰。"
    ]
  },
  {
    "uid": "QTS_650_003_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "寄江陵王少府",
    "poem": [
      "分手頻曾變寒暑，迢迢遠意各何如。",
      "波濤一阻兩鄉夢，歲月無過雙鯉魚。",
      "吟處落花藏筆硯，睡時斜雨濕圖書。",
      "此來俗輩皆疎我，唯有故人心不疎。"
    ],
    "variants": [
      {
        "line": 4,
        "text": "此",
        "variant": "比",
        "source": "一作「比」"
      }
    ]
  },
  {
    "uid": "QTS_650_004_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "題睦州烏龍山禪居",
    "poem": [
      "曙後月華猶冷濕，自知坐臥逼天宮。",
      "晨雞未暇鳴山底，早日先來照屋東。",
      "人世驅馳方丈內，海波搖動一杯中。",
      "伴師長住應難住，歸去仍須入俗籠。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "曙後",
        "variant": "暑夜",
        "source": "一作「暑夜」"
      },
      {
        "line": 1,
        "text": "宮",
        "variant": "星",
        "source": "一作「星」"
      }
    ]
  },
  {
    "uid": "QTS_650_005_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "寄杭州於郎中",
    "poem": [
      "雖云聖代識賢明，自是山河應數生。",
      "大雅篇章無弟子，高門世業有公卿。",
      "入樓早月中秋色，繞郭寒潮半夜聲。",
      "白屋青雲至懸闊，愚儒肝膽若為傾。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "明",
        "variant": "名",
        "source": "一作「名」"
      }
    ]
  },
  {
    "uid": "QTS_650_006_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "寄靈武胡常侍",
    "poem": [
      "青雲直上路初通，已在明君倚注中。",
      "欲遣為霖安九有，先令作相贊東宮。",
      "自從忠讜承天睠，更用文篇續國風。",
      "最是何人感恩德，謝敷星下釣漁翁。"
    ]
  },
  {
    "uid": "QTS_650_007_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "上張舍人",
    "poem": [
      "海內芳聲誰可竝，承家三代相門深。",
      "剖符已副東人望，援筆曾傳聖主心。",
      "此地清廉惟飲水，四方焦熱待為霖。",
      "他年莫學鴟夷子，遠泛扁舟用鑄金。"
    ]
  },
  {
    "uid": "QTS_650_008_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "題慈谿張丞壁",
    "poem": [
      "因君貳邑藍溪上，遣我維舟紅葉時。",
      "共向鄉中非半面，俱驚鬢裏有新絲。",
      "竚看孤潔成三考，應笑愚疎捨一枝。",
      "貌似故人心尚喜，相逢況是舊相知。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "孤",
        "variant": "廉",
        "source": "一作「廉」"
      }
    ]
  },
  {
    "uid": "QTS_650_009_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "贈鄰居袁明府",
    "poem": [
      "隔竹每呼皆得應，二心親熟更如何。",
      "文章鍛煉猶相似，年齒參差不校多。",
      "雨後卷簾看越嶺，更深欹枕聽湖波。",
      "朝昏幸得同醒醉，遮莫光陰自下坡。"
    ]
  },
  {
    "uid": "QTS_650_010_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "孫氏林亭",
    "poem": [
      "池亭才有二三畝，風景勝於千萬家。",
      "瑟瑟林排全巷竹，猩猩血染半園花。",
      "竝牀欹枕逢春盡，援筆持杯到日斜。",
      "丱角相知成白首，而今歡笑莫咨嗟。"
    ]
  },
  {
    "uid": "QTS_650_011_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "漳州陽亭言事寄於使君",
    "poem": [
      "謝守登城對遠峰，金英泛泛滿金鐘。",
      "樓頭風景八九月，牀下水雲千萬重。",
      "紅旆朝昏雖許近，清才今古定難逢。",
      "鯉魚縱是凡鱗鬣，得在膺門合作龍。"
    ]
  },
  {
    "uid": "QTS_650_012_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "別胡中丞",
    "poem": [
      "二年朝夜見雙旌，心魄知恩夢亦驚。",
      "幽賤麤能分菽麥，從容豈合遇公卿。",
      "吹噓若自毫端出，羽翼應從肉上生。",
      "卻恨此身唯一死，空將一死報猶輕。"
    ]
  },
  {
    "uid": "QTS_650_013_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "遊張公洞寄陶校書",
    "poem": [
      "步步勢穿江底去，此中危滑轉身難。",
      "下蒸陰氣松蘿濕，外制溫風杖屨寒。",
      "數里煙雲方覺異，前程世界更應寬。",
      "由來委曲尋仙路，不似先生換骨丹。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "屨",
        "variant": "履",
        "source": "一作「履」"
      }
    ]
  },
  {
    "uid": "QTS_650_014_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "題睦州郡中千峰榭",
    "poem": [
      "豈知平地似天台，朱戶深沈別徑開。",
      "曳響露蟬穿樹去，斜行沙鳥向池來。",
      "窗中早月當琴榻，牆上秋山入酒杯。",
      "何事此中如世外？應緣羊祜是仙才。"
    ]
  },
  {
    "uid": "QTS_650_015_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "登新城縣樓贈蔡明府",
    "poem": [
      "楊震東來是宦遊，政成登此自消憂。",
      "草中白道穿村去，樹裏清溪照郭流。",
      "縱目四山宜永日，開襟五月似高秋。",
      "不知縣籍添新戶，但見川原桑柘稠。"
    ]
  },
  {
    "uid": "QTS_650_016_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "和於中丞登扶風亭",
    "poem": [
      "避石攀蘿去不迷，行時舉步似丹梯。",
      "東軒海日已先照，下界晨雞猶未啼。",
      "郭裏雲山全占寺，村前竹樹半藏溪。",
      "謝公吟望多來此，此地應將峴首齊。"
    ]
  },
  {
    "uid": "QTS_650_017_01",
    "volume": 650,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "贈信州高員外",
    "poem": [
      "溪勢盤回繞郡流，饒陽春色滿溪樓。",
      "豈唯啼鳥催人醉，更有繁花笑客愁。",
      "蹇拙命中迷直道，仁慈風裏駐扁舟。",
      "膺門若感深恩去，終殺微軀未足酬。"
    ],
    "variants": [
