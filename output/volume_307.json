[
  {
    "uid": "QTS_307_001_01",
    "volume": 307,
    "author": {
      "canonical": "丘丹",
      "recorded": "丘丹"
    },
    "title": "憶長安。四月",
    "poem": [
      "憶長安，四月時，南郊萬乘旌旗。",
      "嘗酎玉卮更獻，含桃絲籠交馳。",
      "芳草落花無限，金張許史相隨。"
    ]
  },
  {
    "uid": "QTS_307_002_01",
    "volume": 307,
    "author": {
      "canonical": "丘丹",
      "recorded": "丘丹"
    },
    "title": "狀江南。季冬",
    "poem": [
      "江南季冬月，紅蟹大如𤬊。",
      "湖水龍為鏡，爐峰氣作煙。"
    ]
  },
  {
    "uid": "QTS_307_003_01",
    "volume": 307,
    "author": {
      "canonical": "丘丹",
      "recorded": "丘丹"
    },
    "title": "和韋使君秋夜見寄",
    "poem": [
      "露滴梧葉鳴，秋風桂花發。",
      "中有學仙侶，吹簫弄山月。"
    ]
  },
  {
    "uid": "QTS_307_004_01",
    "volume": 307,
    "author": {
      "canonical": "丘丹",
      "recorded": "丘丹"
    },
    "title": "奉酬韋蘇州使君",
    "poem": [
      "久作煙霞侶，暫將簪組親。",
      "還同褚伯玉，入館忝州人。"
    ]
  },
  {
    "uid": "QTS_307_005_01",
    "volume": 307,
    "author": {
      "canonical": "丘丹",
      "recorded": "丘丹"
    },
    "title": "和韋使君聽江笛送陳侍禦",
    "poem": [
      "離樽聞夜笛，寥亮入寒城。",
      "月落車馬散，淒惻主人情。"
    ]
  },
  {
    "uid": "QTS_307_006_01",
    "volume": 307,
    "author": {
      "canonical": "丘丹",
      "recorded": "丘丹"
    },
    "title": "奉酬韋使君送歸山之作",
    "poem": [
      "側聞郡守至，偶乘黃犢出。",
      "不別桃源人，一見經累日。",
      "蟬鳴念秋稼，蘭酌動離瑟。",
      "臨水降麾幢，野艇才容膝。",
      "參差碧山路，目送江帆疾。",
      "涉海得驪珠，棲梧慚鳳質。",
      "愧非鄭公里，歸掃蒙籠室。"
    ]
  },
  {
    "uid": "QTS_307_007_01",
    "volume": 307,
    "author": {
      "canonical": "丘丹",
      "recorded": "丘丹"
    },
    "title": "奉酬重送歸山",
    "poem": [
      "賣藥有時至，自知來往疏。",
      "遽辭池上酌，新得山中書。",
      "步出芙蓉府，歸乘觳觫車。",
      "猥蒙招隱作，豈愧班生廬。"
    ]
  },
  {
    "uid": "QTS_307_008_01",
    "volume": 307,
    "author": {
      "canonical": "丘丹",
      "recorded": "丘丹"
    },
    "title": "經湛長史草堂",
    "poem": [
      "身退謝名累，道存嘉止足。",
      "設醴降華幡，掛冠守空穀。",
      "偶尋野外寺，仰慕賢者躅。",
      "不見昔簪裾，猶有舊松竹。",
      "煙霞雖異世，風韻如在矚。",
      "余即江海上，歸轍青山曲。"
    ],
    "notes": [
      {
        "content": "一作題湛長史舊居",
        "context": "湛長史草堂",
        "original_title": "經湛長史草堂（一作題湛長史舊居）"
      }
    ]
  },
  {
    "uid": "QTS_307_009_01",
    "volume": 307,
    "author": {
      "canonical": "丘丹",
      "recorded": "丘丹"
    },
    "title": "蕭山祗園寺",
    "poem": [
      "東晉許征君，西方彥上人。",
      "生時猶定見，悟後了前因。",
      "靈塔多年古，高僧苦行頻。",
      "碑存才記日，藤老豈知春。",
      "車騎歸蕭詧，雲林識許詢。",
      "千秋不相見，悟定是吾身。"
    ]
  },
  {
    "uid": "QTS_307_010_01",
    "volume": 307,
    "author": {
      "canonical": "丘丹",
      "recorded": "丘丹"
    },
    "title": "奉使過石門觀瀑",
    "poem": [
      "溪上望懸泉，耿耿雲中見。",
      "披榛上岩岫，峭壁正東面。",
      "千仞瀉聯珠，一潭噴飛霰。",
      "嵯濛滿山響，坐覺炎氛變。",
      "照日類虹霓，從風似綃練。",
      "靈奇既天造，惜處窮海甸。",
      "吾祖昔登臨，謝公亦遊衍。",
      "王程懼淹泊，下磴空延眷。",
      "千里雷尚聞，巒回樹蔥蒨。",
      "此來共賤役，探討愧前彥。",
      "永欲洗塵纓，終當愜此願。"
    ]
  },
  {
    "uid": "QTS_307_011_01",
    "volume": 307,
    "author": {
      "canonical": "丘丹",
      "recorded": "丘丹"
    },
    "title": "秋夕宿石門館",
    "poem": [
      "暝從石門宿，搖落四岩空。",
      "潭月漾山足，天河瀉澗中。",
      "杉松寒似雨，猿鳥夕驚風。",
      "獨臥不成寢，蒼然想謝公。"
    ]
  },
  {
    "uid": "QTS_307_012_01",
    "volume": 307,
    "author": {
      "canonical": "賈弇",
      "recorded": "賈弇"
    },
    "title": "狀江南。孟夏",
    "poem": [
      "江南孟夏天，慈竹筍如編。",
      "蜃氣為樓閣，蛙聲作管弦。"
    ]
  },
  {
    "uid": "QTS_307_013_01",
    "volume": 307,
    "author": {
      "canonical": "沈仲昌",
      "recorded": "沈仲昌"
    },
    "title": "狀江南。仲秋",
    "poem": [
      "江南仲秋天，驔鼻大如船。",
      "雷是樟亭浪，苔為界石錢。"
    ]
  },
  {
