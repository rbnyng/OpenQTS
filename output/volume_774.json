      },
      {
        "line": 2,
        "text": "近",
        "variant": "向",
        "source": "一作「向」"
      }
    ]
  },
  {
    "uid": "QTS_774_004_01",
    "volume": 774,
    "author": {
      "canonical": "吉師老",
      "recorded": "吉師老"
    },
    "title": "鴛鴦",
    "poem": [
      "江島濛濛煙靄微，綠蕪深處刷毛衣。",
      "渡頭驚起一雙去，飛上文君舊錦機。"
    ]
  },
  {
    "uid": "QTS_774_005_01",
    "volume": 774,
    "author": {
      "canonical": "吳商浩",
      "recorded": "吳商浩"
    },
    "title": "巫峽聽猿",
    "poem": [
      "巴江猨嘯苦，響入客舟中。",
      "孤枕破殘夢，三聲隨曉風。",
      "連雲波澹澹，和霧雨濛濛。",
      "巫峽去家遠，不堪魂斷空。"
    ]
  },
  {
    "uid": "QTS_774_006_01",
    "volume": 774,
    "author": {
      "canonical": "吳商浩",
      "recorded": "吳商浩"
    },
    "title": "長安春贈友人",
    "poem": [
      "繁華堪泣帝城春，粉堞青樓勢礙雲。",
      "花對玉鉤簾外發，歌飄塵土路邊聞。",
      "幾多遠客魂空斷，何處王孫酒自醺。",
      "各有歸程千萬里，東風時節恨離羣。"
    ]
  },
  {
    "uid": "QTS_774_007_01",
    "volume": 774,
    "author": {
      "canonical": "吳商浩",
      "recorded": "吳商浩"
    },
    "title": "塞上即事",
    "poem": [
      "身似星流跡似蓬，玉關孤望杳溟濛。",
      "寒沙萬里平鋪月，曉角一聲高捲風。",
      "戰士歿邊魂尚哭，單于獵處火猶紅。",
      "分明更想殘宵夢，故國依然在甬東。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "捲",
        "variant": "繞",
        "source": "一作「繞」"
      },
      {
        "line": 3,
        "text": "火",
        "variant": "燒",
        "source": "一作「燒」"
      },
      {
        "line": 4,
        "text": "在",
        "variant": "到",
        "source": "一作「到」"
      }
    ]
  },
  {
    "uid": "QTS_774_008_01",
    "volume": 774,
    "author": {
      "canonical": "吳商浩",
      "recorded": "吳商浩"
    },
    "title": "宿山驛",
    "poem": [
      "文戰何堪功未圖，又驅羸馬指天衢。",
      "露華凝夜渚蓮盡，月彩滿輪山驛孤。",
      "岐路辛勤終日有，鄉關音信來年無。",
      "好同范蠡扁舟興，高掛一帆歸五湖。"
    ],
    "variants": [
      {
        "line": 4,
        "text": "同",
        "variant": "乘",
        "source": "一作「乘」"
      }
    ]
  },
  {
    "uid": "QTS_774_009_01",
    "volume": 774,
    "author": {
      "canonical": "吳商浩",
      "recorded": "吳商浩"
    },
    "title": "北邙山",
    "poem": [
      "北邙山草又青青，今日銷魂事可明。",
      "綠酒醉來春未歇，白楊風起柳初晴。",
      "岡原旋葬松新長，年代無人闕半平。",
      "堪取金爐九還藥，不能隨夢向浮生。"
    ]
  },
  {
    "uid": "QTS_774_010_01",
    "volume": 774,
    "author": {
      "canonical": "吳商浩",
      "recorded": "吳商浩"
    },
    "title": "秋塘曉望",
    "poem": [
      "鐘盡疎桐散曙鴉，故山煙樹隔天涯。",
      "西風一夜秋塘曉，零落幾多紅藕花。"
    ]
  },
  {
    "uid": "QTS_774_011_01",
    "volume": 774,
    "author": {
      "canonical": "吳商浩",
      "recorded": "吳商浩"
    },
    "title": "水樓感事",
    "poem": [
      "高柳螿啼雨後秋，年光空感淚如流。",
      "滿湖菱荇東歸晚，閑倚南軒盡日愁。"
    ]
  },
  {
    "uid": "QTS_774_012_01",
    "volume": 774,
    "author": {
      "canonical": "吳商浩",
      "recorded": "吳商浩"
    },
    "title": "泊舟",
    "poem": [
      "身逐煙波魂自驚，木蘭舟上一帆輕。",
      "雲中有寺在何處？山底宿時聞磬聲。"
    ]
  },
  {
    "uid": "QTS_774_013_01",
    "volume": 774,
    "author": {
      "canonical": "吳商浩",
      "recorded": "吳商浩"
    },
    "title": "湘雲",
    "poem": [
      "□滿湘江雲瑩空，紛紛長對水溶溶。",
      "日西遙望自歸處，盡掛九疑千萬峰。"
    ],
    "notes": [
      {
        "content": "首句缺一字。",
        "context": "湘雲",
        "original_title": "湘雲",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_774_014_01",
    "volume": 774,
    "author": {
      "canonical": "沈祖仙",
      "recorded": "沈祖仙",
      "gender": "male"
    },
    "title": "秋閨",
    "poem": [
      "白馬三軍客，青娥十載思。",
      "玉庭霜落夜，羅幌月明時。",
      "鑪冷蜘蛛喜，燈高熠耀期。",
      "愁多不可曙，流涕坐空幃。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "高",
        "variant": "寒",
        "source": "一作「寒」"
      }
    ]
  },
  {
    "uid": "QTS_774_015_01",
    "volume": 774,
    "author": {
      "canonical": "邵士彥",
      "recorded": "邵士彥"
    },
    "title": "秋閨",
    "poem": [
      "斜日空庭暮，幽閨積恨盈。",
      "細風吹帳冷，微月度窗明。",
      "怨坐啼相續，愁眠夢不成。",
      "調琴欲有弄，畏作斷腸聲。"
    ]
  },
  {
    "uid": "QTS_774_016_01",
    "volume": 774,
    "author": {
      "canonical": "吳大江",
      "recorded": "吳大江",
      "gender": "male",
      "english_name": "Wu Dajiang",
      "wikidata_id": "Q40187187"
    },
    "title": "擣衣",
    "poem": [
      "沙塞秋應晚，金閨恨已空。",
      "那堪裂紈素，時許出房櫳。",
      "杵影弄寒月，砧聲調夜風。",
      "裁縫雙淚盡，萬里寄雲中。"
    ]
  },
  {
    "uid": "QTS_774_017_01",
    "volume": 774,
    "author": {
      "canonical": "荊叔",
      "recorded": "荊叔"
    },
    "title": "題慈恩塔",
    "poem": [
      "漢國山河在，秦陵草樹深。",
      "暮雲千里色，無處不傷心。"
    ]
  },
  {
    "uid": "QTS_774_018_01",
    "volume": 774,
    "author": {
      "canonical": "蕭靜",
      "recorded": "蕭靜"
    },
    "title": "三湘有懷",
    "poem": [
      "柳絮飛來別洛陽，梅花落後到三湘。",
      "世情已逐浮雲散，離恨空隨江水長。"
    ]
  },
  {
    "uid": "QTS_774_019_01",
    "volume": 774,
    "author": {
      "canonical": "元凜",
      "recorded": "元凜"
    },
    "title": "九日對酒",
    "poem": [
      "嘉辰復遇登高臺，良朋笑語傾金罍。",
      "煙攤秋色正堪翫，風惹菊香無限來。",
      "未保亂離今日後，且謀歡洽玉山頹。",
      "誰知靖節當時事，空學狂歌倒載迴。"
    ]
  },
  {
    "uid": "QTS_774_020_01",
    "volume": 774,
    "author": {
      "canonical": "元凜",
      "recorded": "元凜"
    },
    "title": "中秋夜不見月",
    "poem": [
      "蟾輪何事色全微，賺得佳人出繡幃。",
      "四野霧凝空寂寞，九霄雲鎖絕光輝。",
      "吟詩得句翻停筆，玩處臨尊卻掩扉。",
      "公子倚欄猶悵望，嬾將紅燭草堂歸。"
    ]
  },
  {
    "uid": "QTS_774_021_01",
    "volume": 774,
    "author": {
      "canonical": "徐振",
      "recorded": "徐振"
    },
    "title": "雷塘",
    "poem": [
      "九重城闕悲涼盡，一聚園林怨恨長。",
      "花憶所為猶自笑，草知無道更應荒。",
      "詩名占得風流在，酒興催教運祚亡。",
      "若問皇天惆悵事，只應斜日照雷塘。"
    ]
  },
  {
    "uid": "QTS_774_022_01",
    "volume": 774,
    "author": {
      "canonical": "徐振",
      "recorded": "徐振"
    },
    "title": "古意",
    "poem": [
      "擾擾都城曉又昬，六街車馬五侯門。",
      "箕山渭水空明月，可是巢由絕子孫。"
    ]
  },
  {
    "uid": "QTS_774_023_01",
    "volume": 774,
    "author": {
      "canonical": "張侹",
      "recorded": "張侹"
    },
    "title": "寄人",
    "poem": [
      "酷憐風月為多情，還到春時別恨生。",
      "倚柱尋思倍惆悵，一場春夢不分明。"
    ]
  },
  {
    "uid": "QTS_774_024_01",
    "volume": 774,
    "author": {
      "canonical": "方澤",
      "recorded": "方澤"
    },
    "title": "武昌阻風",
    "poem": [
      "江上春風留客舟，無窮歸思滿東流。",
      "與君盡日閒臨水，貪看飛花忘卻愁。"
    ]
  },
  {
    "uid": "QTS_774_025_01",
    "volume": 774,
    "author": {
      "canonical": "景池",
      "recorded": "景池"
    },
    "title": "秋夜宿淮口",
    "poem": [
      "露白草猶青，淮舟倚岸停。",
      "風帆幾處客，天地兩河星。",
      "樹靜禽眠草，沙寒鹿過汀。",
      "明朝誰結伴，直去泛滄溟。"
    ]
  },
  {
    "uid": "QTS_774_026_01",
    "volume": 774,
    "author": {
      "canonical": "張鴻",
      "recorded": "張鴻",
      "gender": "male",
      "wikidata_id": "Q11069248"
    },
    "title": "贈喬尊師",
    "poem": [
      "長忌時人識，有家雲澗深。",
      "性惟耽嗜酒，貧不破除琴。",
      "靜鼓三通齒，頻湯一味參。",
      "知師最知我，相引坐檉陰。"
    ]
  },
  {
    "uid": "QTS_774_027_01",
    "volume": 774,
    "author": {
      "canonical": "姚揆",
      "recorded": "姚揆",
      "gender": "male",
      "english_name": "Yao Kui",
      "wikidata_id": "Q18908235"
    },
    "title": "村行",
    "poem": [
      "天淡雨初晴，遊人恨不勝。",
      "亂山啼蜀魄，孤棹宿巴陵。",
      "影暗村橋柳，光寒水寺燈。",
      "罷吟思故國，窗外有漁罾。"
    ]
  },
  {
    "uid": "QTS_774_028_01",
    "volume": 774,
    "author": {
      "canonical": "姚揆",
      "recorded": "姚揆",
      "gender": "male",
      "english_name": "Yao Kui",
      "wikidata_id": "Q18908235"
    },
    "title": "潁川客舍",
    "poem": [
      "素琴孤劍尚閒遊，誰共芳尊話唱酬。",
      "鄉夢有時生枕上，客情終日在眉頭。",
      "雲拖雨腳連天去，樹夾河聲繞郡流。",
      "回首帝京歸未得，不堪吟倚夕陽樓。"
    ]
  },
  {
    "uid": "QTS_774_029_01",
    "volume": 774,
    "author": {
      "canonical": "王訓",
      "recorded": "王訓",
      "gender": "male",
      "wikidata_id": "Q88743894"
    },
    "title": "獨不見",
    "poem": [
      "日晚宜春暮，風軟上林朝。",
      "對酒近初節，開樓蕩夜謠。",
      "石橋通小澗，竹路上青霄。",
      "持底誰見許，長愁成細腰。"
    ]
  },
  {
    "uid": "QTS_774_030_01",
    "volume": 774,
    "author": {
      "canonical": "張熾",
      "recorded": "張熾"
    },
    "title": "歸去來引",
    "poem": [
      "歸去來，歸期不可違。",
      "相見旋明月，浮雲共我歸。"
    ]
  },
  {
    "uid": "QTS_774_031_01",
    "volume": 774,
    "author": {
      "canonical": "虞羽客",
      "recorded": "虞羽客"
    },
    "title": "結客少年塲行",
    "poem": [
      "幽并俠少年，金絡控連錢。",
      "竊符方救趙，擊築正懷燕。",
      "輕生辭鳳闕，揮袂上祁連。",
      "陸離橫寶劍，出沒騖征旃。",
      "蒙輪恆顧敵，超乘忽爭先。",
      "摧枯逾百戰，拓地遠三千。",
      "骨都魂已散，樓蘭首復傳。",
      "龍城含宿霧，瀚海接遙天。",
      "歌吹金微返，振旅玉門旋。",
      "烽火今已息，非復照甘泉。"
    ],
