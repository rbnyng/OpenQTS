[
  {
    "uid": "QTS_801_001_01",
    "volume": 801,
    "author": {
      "canonical": "郎大家宋氏",
      "recorded": "郎大家宋氏",
      "gender": "female"
    },
    "title": "採桑",
    "poem": [
      "春來南鴈歸，日去西蠶遠。",
      "妾思紛何極，客遊殊未返。"
    ]
  },
  {
    "uid": "QTS_801_002_01",
    "volume": 801,
    "author": {
      "canonical": "郎大家宋氏",
      "recorded": "郎大家宋氏",
      "gender": "female"
    },
    "title": "宛轉歌二首 其一",
    "poem": [
      "風已清，月朗琴復鳴。",
      "掩抑非千態，殷勤是一聲。",
      "歌宛轉，宛轉和且長。",
      "願為雙鴻鵠，比翼共翱翔。"
    ],
    "notes": [
      {
        "content": "一作崔液詩。",
        "context": "宛轉歌二首",
        "original_title": "宛轉歌二首",
