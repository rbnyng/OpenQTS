  {
    "uid": "QTS_801_021_01",
    "volume": 801,
    "author": {
      "canonical": "崔公遠",
      "recorded": "崔公遠",
      "gender": "female"
    },
    "title": "獨夜詞",
    "poem": [
      "晴天霜落寒風急，錦帳羅幃羞更入。",
      "秦箏不復續斷弦，回身掩淚挑燈立。"
    ]
  },
  {
    "uid": "QTS_801_022_01",
    "volume": 801,
    "author": {
      "canonical": "崔公遠",
      "recorded": "崔公遠",
      "gender": "female"
    },
    "title": "句",
    "poem": [
      "看花獨不語，裴回雙淚潸。",
      "君今遠戍在何處，遣妾秋來長望天。"
    ]
  },
  {
    "uid": "QTS_801_023_01",
    "volume": 801,
    "author": {
      "canonical": "張琰",
      "recorded": "張琰",
      "gender": "female"
    },
    "title": "春詞二首 其一",
    "poem": [
      "垂柳鳴黃鸝，關關若求友。",
      "春情不可耐，愁殺閨中婦。",
      "日暮登高樓，誰憐小垂手。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_801_023_02",
    "volume": 801,
    "author": {
      "canonical": "張琰",
      "recorded": "張琰",
      "gender": "female"
    },
    "title": "春詞二首 其二",
    "poem": [
      "昨日桃花飛，今朝梨花吐。",
      "春色能幾時，那堪此愁緒。",
      "蕩子遊不歸，春來淚如雨。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_801_024_01",
    "volume": 801,
    "author": {
      "canonical": "張琰",
      "recorded": "張琰",
      "gender": "female"
    },
    "title": "銅雀臺",
    "poem": [
      "君王冥漠不可見，銅雀歌舞空裴回。",
      "西陵嘖嘖悲宿鳥，高殿沉沉閉青苔。",
      "青苔無人跡，紅粉空自哀。"
    ],
    "notes": [
