        "text": "鴻",
        "variant": "黃",
        "source": "一作「黃」"
      }
    ]
  },
  {
    "uid": "QTS_801_002_02",
    "volume": 801,
    "author": {
      "canonical": "郎大家宋氏",
      "recorded": "郎大家宋氏",
      "gender": "female"
    },
    "title": "宛轉歌二首 其二",
    "poem": [
      "日已暮，長簷鳥聲度。",
      "此時望君君不來，此時思君君不顧。",
      "歌宛轉，宛轉那能異棲宿。",
      "願為形與影，出入恆相逐。"
    ],
    "notes": [
      {
        "line": 3,
        "content": "一本無此二字。",
        "context": "歌宛轉，宛轉那能異棲宿。"
      }
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_801_003_01",
    "volume": 801,
    "author": {
      "canonical": "郎大家宋氏",
      "recorded": "郎大家宋氏",
      "gender": "female"
    },
    "title": "長相思",
    "poem": [
      "長相思，久離別。",
      "關山阻，風煙絕。",
      "臺上鏡文銷，袖中書字滅。",
      "不見君形影，何曾有歡悅。"
    ]
  },
  {
    "uid": "QTS_801_004_01",
    "volume": 801,
    "author": {
      "canonical": "郎大家宋氏",
      "recorded": "郎大家宋氏",
      "gender": "female"
    },
    "title": "朝雲引",
    "poem": [
      "巴西巫峽指巴東，朝雲觸石上朝空。",
      "巫山巫峽高何已，行雨行雲一時起。",
      "一時起，三春暮。",
      "若言來，且就陽臺路。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "指",
        "variant": "連",
        "source": "一作「連」"
      }
    ]
  },
  {
    "uid": "QTS_801_005_01",
    "volume": 801,
    "author": {
      "canonical": "梁瓊",
      "recorded": "梁瓊",
      "gender": "female"
    },
    "title": "宿巫山寄遠人",
    "poem": [
      "巫山雲，巫山雨，朝雲暮雨無定所。",
      "南峰忽暗北峰晴，空裏仙人語笑聲。",
      "曾侍荊王枕席處，直至如今如有靈。",
      "春風澹澹白雲閒，驚湍流水響千山。",
      "一夜此中對明月，憶得此中與君別。",
      "感物情懷如舊時，君今渺渺在天涯。",
      "曉看襟上淚流處，點點血痕猶在衣。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "荊",
        "variant": "君",
        "source": "一作「君」"
      }
    ]
  },
  {
    "uid": "QTS_801_006_01",
    "volume": 801,
    "author": {
      "canonical": "梁瓊",
      "recorded": "梁瓊",
      "gender": "female"
    },
    "title": "昭君怨",
    "poem": [
      "自古無和親，貽災到妾身。",
      "朔風嘶去馬，漢月出行輪。",
      "衣薄狼山雪，妝成虜塞春。",
      "迴看父母國，生死畢胡塵。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "貽災",
        "variant": "天貽",
        "source": "一作「天貽」"
      }
    ]
  },
  {
    "uid": "QTS_801_007_01",
    "volume": 801,
    "author": {
      "canonical": "梁瓊",
      "recorded": "梁瓊",
      "gender": "female"
    },
    "title": "銅雀臺",
    "poem": [
      "歌扇向陵開，齊行奠玉杯。",
      "舞時飛燕列，夢裏片雲來。",
      "月色空餘恨，松聲莫更哀。",
      "誰憐未死妾，掩袂下銅臺。"
    ]
  },
  {
    "uid": "QTS_801_008_01",
    "volume": 801,
    "author": {
      "canonical": "梁瓊",
      "recorded": "梁瓊",
      "gender": "female"
    },
    "title": "遠意",
    "poem": [
      "脈脈長攄氣，微微不離心。",
      "叩頭從此去，煩惱阿誰禁。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "離",
        "variant": "動",
        "source": "一作「動」"
      }
    ]
  },
  {
    "uid": "QTS_801_009_01",
    "volume": 801,
    "author": {
      "canonical": "梁瓊",
      "recorded": "梁瓊",
      "gender": "female"
    },
    "title": "句",
    "poem": [
      "玉枕空流別後淚，羅衣已盡去時香。"
    ]
  },
  {
    "uid": "QTS_801_010_01",
    "volume": 801,
    "author": {
      "canonical": "劉雲",
      "recorded": "劉雲",
      "gender": "female"
    },
    "title": "有所思",
    "poem": [
      "朝亦有所思，暮亦有所思。",
      "登樓望君處，藹藹蕭關道。",
      "掩淚向浮雲，誰知妾懷抱。",
      "玉井蒼苔春院深，桐花落盡無人埽。"
    ],
    "variants": [
