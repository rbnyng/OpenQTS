  },
  {
    "uid": "QTS_653_027_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "寄謝麟",
    "poem": [
      "越國雲溪秀髮時，蔣京詞賦謝麟詩。",
      "後來若要知優劣，學圃無過老圃知。"
    ]
  },
  {
    "uid": "QTS_653_028_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "與長洲陳子美長官",
    "poem": [
      "枕上愁多百緒牽，常時睡覺在溪前。",
      "人前儘是交親力，莫道升沉總信天。"
    ]
  },
  {
    "uid": "QTS_653_029_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "新安殷明府家樂方響",
    "poem": [
      "葛溪鐵片梨園調，耳底丁東十六聲。",
      "彭澤主人憐妙樂，玉杯春暖許同傾。"
    ]
  },
  {
    "uid": "QTS_653_030_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "別殷明府",
    "poem": [
      "許教門館久踟躕，仲叔懷恩對玉壺。",
      "唯有離心欲銷客，空垂雙淚不成珠。"
    ]
  },
  {
    "uid": "QTS_653_031_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "送水墨項處士歸天台",
    "poem": [
      "仙嶠倍分元化功，揉藍翠色一重重。",
      "還家莫更尋山水，自有雲山在筆峰。"
    ]
  },
  {
    "uid": "QTS_653_032_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "贈會稽楊長官",
    "poem": [
      "直鉤終日竟無魚，鐘鼓聲中與世疎。",
      "若向湖邊訪幽拙，蕭條四壁是閒居。"
    ]
  },
  {
    "uid": "QTS_653_033_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "贈申長官",
    "poem": [
      "言下隨機見物情，看看獄路草還生。",
      "旅人莫怪無魚食，直為寒江水至清。"
    ]
  },
  {
    "uid": "QTS_653_034_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "將歸湖上留別陳宰",
    "poem": [
      "歸去春山逗晚晴，縈廻樹石罅中行。",
      "明時不是無知己，自憶湖邊釣與耕。"
    ]
  },
  {
    "uid": "QTS_653_035_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "貽亮上人",
    "poem": [
      "秋水一泓常見底，澗松千尺不生枝。",
      "人間學佛知多少，淨盡心花只有師。"
    ]
  },
  {
    "uid": "QTS_653_036_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "貽曦上人",
    "poem": [
      "四十年來多少人，一分零落九成塵。",
      "與師猶得重相見，亦是枯株勉強春。"
    ]
  },
  {
    "uid": "QTS_653_037_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "書原上鮑處士屋壁",
    "poem": [
      "水闊坐看千萬里，青蕪蓋地接天津。",
      "禰衡莫愛山中靜，遶舍山多卻礙人。"
    ]
  },
  {
    "uid": "QTS_653_038_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "別孫蜀",
    "poem": [
      "吳越思君意易傷，別君添我鬢邊霜。",
      "由來淛水偏堪恨，截斷千山作兩鄉。"
    ]
  },
  {
    "uid": "QTS_653_039_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "贈江上老人",
    "poem": [
      "潭底錦鱗多識釣，未投香餌即先知。",
      "欲教魚目無分別，須學揉藍染釣絲。"
    ]
  },
  {
    "uid": "QTS_653_040_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "贈東溪貧道",
    "poem": [
      "非唯劍鶴獨難留，觸事皆聞被債收。",
      "賴是豪家念寒餒，卻還漁島與漁舟。"
    ]
  },
  {
    "uid": "QTS_653_041_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "詠花",
    "poem": [
      "狂心醉眼共裵回，一半先開笑未開。",
      "此日不能偷折去，胡蜂直恐趂人來。"
    ]
  },
  {
    "uid": "QTS_653_042_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "路入金州江中作",
    "poem": [
      "棹尋椒岸縈廻去，數里時逢一兩家。",
      "知是從來貢金處，江邊牧豎亦披沙。"
    ]
  },
  {
    "uid": "QTS_653_043_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "夜會鄭氏昆季林亭",
    "poem": [
      "捲簾圓月照方塘，坐久尊空竹有霜。",
      "白犬吠風驚雁起，猶能一一旋成行。"
    ]
  },
  {
    "uid": "QTS_653_044_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "題黃山人庭前孤桂",
    "poem": [
      "映窗孤桂非手植，子落月中聞落時。",
      "仙客此時頭不白，看來看去有枯枝。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "中",
        "variant": "明",
        "source": "一作「明」"
      }
    ]
  },
  {
    "uid": "QTS_653_045_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "送僧南遊",
    "poem": [
      "三秋萬里五溪行，風裏孤雲不計程。",
      "若念猩猩解言語，放生先合放猩猩。"
    ]
  },
  {
    "uid": "QTS_653_046_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "惜花",
    "poem": [
      "可憐妍豔正當時，剛被狂風一夜吹。",
      "今日流鶯來舊處，百般言語殢空枝。"
    ]
  },
  {
    "uid": "QTS_653_047_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "題天柱觀魚尊師舊院",
    "poem": [
      "早識吾師頻到此，芝童藥犬亦相迎。",
      "今師一去無來日，花洞石壇空月明。"
    ]
  },
  {
    "uid": "QTS_653_048_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "東陽道中作",
    "poem": [
      "百花香氣傍行人，花底垂鞭日易曛。",
      "野父不知寒食節，穿林轉壑自燒雲。"
    ]
  },
  {
    "uid": "QTS_653_049_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "題畫建溪圖",
    "poem": [
      "六幅輕綃畫建溪，刺桐花下路高低。",
      "分明記得曾行處，只欠猿聲與鳥啼。"
    ]
  },
  {
    "uid": "QTS_653_050_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "蜀中",
    "poem": [
      "遊子去遊多不歸，春風酒味勝餘時。",
      "閒來卻伴巴兒醉，荳蔻花邊唱竹枝。"
    ]
  },
  {
    "uid": "QTS_653_051_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "衢州別李秀才",
    "poem": [
      "千山紅樹萬山雲，把酒相看日又曛。",
      "一曲驪歌兩行淚，更知何處再逢君。"
    ]
  },
  {
    "uid": "QTS_653_052_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "題君山",
    "poem": [
      "曾於方外見麻姑，聞說君山自古無。",
      "元是崑崙山頂石，海風吹落洞庭湖。"
    ]
  },
  {
    "uid": "QTS_653_053_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "題嚴子陵祠二首 其一",
    "poem": [
      "物色旁求至漢庭，一宵同寢見交情。",
      "先生不入雲臺像，贏得桐江萬古名。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_653_053_02",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "題嚴子陵祠二首 其二",
    "poem": [
      "蒼翠雲峰開俗眼，泓澄煙水浸塵心。",
      "惟將道業為芳餌，釣得高名直到今。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_653_054_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "失題",
    "poem": [
      "十六聲中運手輕，一聲聲似自然聲。",
      "不緣精妙過流輩，爭得江南別有名。"
    ]
  },
  {
    "uid": "QTS_653_055_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "句",
    "poem": [
      "弟子已攀桂，先生猶臥雲。",
      "把得新詩草裏論。",
      "枯井夜聞鄰果落，廢巢寒見別禽來。"
    ],
