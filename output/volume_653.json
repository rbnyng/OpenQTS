    ]
  },
  {
    "uid": "QTS_653_024_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "江南聞新曲",
    "poem": [
      "席上新聲花下杯，一聲聲被拍聲摧。",
      "樂工不識長安道，儘是書中寄曲來。"
    ]
  },
  {
    "uid": "QTS_653_025_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "經故侯郎中舊居",
    "poem": [
      "一朝寂寂與冥冥，壟樹未長墳草青。",
      "高節雄才向何處，夜闌空鎖滿池星。"
    ]
  },
  {
    "uid": "QTS_653_026_01",
    "volume": 653,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "越中逢孫百篇",
    "poem": [
      "上才乘酒到山陰，日日成篇字字金。",
      "鏡水周廻千萬頃，波瀾倒瀉入君心。"
    ],
