[
  {
    "uid": "QTS_783_001_01",
    "volume": 783,
    "author": {
      "canonical": "辛學士",
      "recorded": "辛學士",
      "gender": "male"
    },
    "title": "答王無功入長安詠秋蓬見示",
    "poem": [
      "托根雖異所，飄葉早相依。",
      "因風若有便，更共入雲飛。"
    ]
  },
  {
    "uid": "QTS_783_002_01",
    "volume": 783,
    "author": {
      "canonical": "盧尚書",
      "recorded": "盧尚書",
      "gender": "male"
    },
    "title": "哭李遠",
    "poem": [
      "昨日舟還浙水湄，今朝丹旐欲何為。",
      "才收北浦一竿釣，未了西齋半局棋。",
      "洛下已傳平子賦，臨川爭寫謝公詩。",
      "不堪舊里經行處，風木蕭蕭鄰笛悲。"
    ]
  },
  {
    "uid": "QTS_783_003_01",
    "volume": 783,
    "author": {
      "canonical": "鄭僕射",
      "recorded": "鄭僕射"
    },
    "title": "湘中怨諷",
    "poem": [
      "青鷁苦幽獨，隔江相對稀。",
      "夜寒蘆葉雨，空作一聲歸。"
    ]
  },
  {
    "uid": "QTS_783_004_01",
    "volume": 783,
    "author": {
      "canonical": "鄭中丞",
      "recorded": "鄭中丞",
      "gender": "male"
    },
    "title": "登汾上閣",
    "poem": [
      "汾桂秋水闊，宛似到閶門。",
      "惆悵江湖思，惟將南客論。"
    ]
  },
  {
    "uid": "QTS_783_005_01",
    "volume": 783,
    "author": {
      "canonical": "韓常侍",
      "recorded": "韓常侍",
      "gender": "male"
    },
    "title": "為御史銜命出關讞獄，道中看華山有詩",
    "poem": [
      "野麋蒙象暫如犀，心不驚鷗角駭雞。",
      "一路好山無伴看，斷腸煙景寄猨啼。"
    ],
    "notes": [
      {
        "content": "御史出使，不得與人同行，故云無伴。",
        "context": "為御史銜命出關讞獄，道中看華山有詩"
      }
    ]
  },
  {
    "uid": "QTS_783_006_01",
    "volume": 783,
    "author": {
      "canonical": "韓常侍",
      "recorded": "韓常侍",
      "gender": "male"
    },
    "title": "寄織錦篇與薛郎中",
    "poem": [
      "錦字龍梭織錦篇，鳳凰文采間非煙。",
      "並他時世新花樣，虛費工夫不直錢。"
    ],
    "notes": [
      {
        "content": "時為補闕，謝病歸山。",
        "context": "寄織錦篇與薛郎中",
        "original_title": "寄織錦篇與薛郎中",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_783_007_01",
    "volume": 783,
    "author": {
      "canonical": "韓常侍",
      "recorded": "韓常侍",
      "gender": "male"
    },
    "title": "和人憶鶴",
    "poem": [
      "拂拂雲衣冠紫煙，已為丁令一千年。",
      "留君且伴居山客，幸有松梢明月天。"
    ]
  },
  {
    "uid": "QTS_783_008_01",
    "volume": 783,
    "author": {
      "canonical": "韓常侍",
      "recorded": "韓常侍",
      "gender": "male"
    },
    "title": "句",
    "poem": [
      "情多不似家山水，夜夜聲聲旁枕流。",
      "[3]"
    ]
  },
  {
    "uid": "QTS_783_009_01",
    "volume": 783,
    "author": {
      "canonical": "梁補闕",
      "recorded": "梁補闕",
      "gender": "male"
    },
    "title": "贈米都知",
    "poem": [
      "供奉三朝四十年，聖時流落發衰殘。",
      "貪將樂府歌明代，不把清吟換好官。"
    ]
  },
  {
    "uid": "QTS_783_010_01",
    "volume": 783,
    "author": {
      "canonical": "盧尚書",
      "recorded": "盧尚書",
      "gender": "male"
    },
    "title": "題安國觀",
    "poem": [
      "夕照紗窗起暗塵，青松繞殿不知春。",
      "君看白首誦經者，半是宮中歌舞人。"
    ],
    "notes": [
      {
        "content": "東都政平坊安國觀，玉真公主所建，女冠多上陽退宮嬪御。",
        "context": "題安國觀",
        "original_title": "題安國觀",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_783_011_01",
    "volume": 783,
    "author": {
      "canonical": "蘇廣文",
      "recorded": "蘇廣文"
    },
    "title": "自商山宿隱居",
    "poem": [
      "聞道桃源堪避秦，尋幽數日不逢人。",
      "煙霞洞裏無雞犬，風雨林中有鬼神。",
      "黃公石上三芝秀，陶令門前五柳春。",
      "醉臥白雲閒入夢，不知何物是吾身。"
    ],
    "notes": [
      {
        "content": "一作靈一詩。",
        "context": "自商山宿隱居",
        "original_title": "自商山宿隱居",
        "type": "footnote"
      }
    ],
    "variants": [
      {
        "line": 3,
        "text": "石上",
        "variant": "庭下",
        "source": "一作「庭下」"
      }
    ]
  },
  {
    "uid": "QTS_783_012_01",
    "volume": 783,
    "author": {
      "canonical": "蘇廣文",
      "recorded": "蘇廣文"
    },
    "title": "夜歸華川因寄幕府",
    "poem": [
      "山村寥落野人稀，竹裏衡門掩翠微。",
      "溪路夜隨明月入，亭皋春伴白雲歸。",
      "嵇康懶慢仍耽酒，范蠡逋逃又拂衣。",
      "汀畔數鷗閒不起，只應知我已忘機。"
    ]
  },
  {
    "uid": "QTS_783_013_01",
    "volume": 783,
    "author": {
      "canonical": "蘇廣文",
      "recorded": "蘇廣文"
    },
    "title": "春日過田明府遇焦山人",
    "poem": [
      "陶公歸隱白雲溪，買得春泉溉藥畦。",
      "夜靜林間風虎嘯，月明竹上露禽棲。",
      "陳倉邑吏驚烽火，太白山人訝鼓鼙。",
      "相見只言秦漢事，武陵溪裏草萋萋。"
    ]
  },
  {
    "uid": "QTS_783_014_01",
    "volume": 783,
    "author": {
      "canonical": "任生",
      "recorded": "任生"
    },
    "title": "題升山",
    "poem": [
      "城外升山寺，城中望宛然。",
      "及登無半日，欲到已經年。"
    ]
  },
  {
    "uid": "QTS_783_015_01",
    "volume": 783,
    "author": {
      "canonical": "任生",
      "recorded": "任生"
    },
    "title": "投曹文姬詩",
    "poem": [
      "玉皇前殿掌書仙，一染塵心下九天。",
      "莫怪濃香熏骨膩，雲衣曾惹御爐煙。"
    ],
    "notes": [
      {
        "content": "文姬，長安中娼女，工翰墨，時號「書仙」。",
        "context": "投曹文姬詩",
        "original_title": "投曹文姬詩",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_783_016_01",
    "volume": 783,
    "author": {
      "canonical": "吳公",
      "recorded": "吳公",
      "gender": "male"
    },
    "title": "絕句",
    "poem": [
      "去國投茲土，編茅隱舊蹤。",
      "年年秋水上，獨對數株松。"
    ],
    "notes": [
      {
        "content": "吳塘山田園幽曠，林木蒼翠，唐末有吳公者，棄官隱此，石上刻有詩，後書乾寧三年秋。",
        "context": "絕句",
        "original_title": "絕句",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_783_017_01",
    "volume": 783,
    "author": {
      "canonical": "曹生",
      "recorded": "曹生"
    },
    "title": "獻盧常侍",
    "poem": [
      "拜玉亭前閒送客，此時孤恨感離鄉。",
      "尋思往歲絕纓事，肯向朱門泣夜長。"
    ],
    "notes": [
      {
        "content": "《雲溪友議》記「盧常侍鉟牧廬江，日相座薦生來署郡職生，恱營妓名丹霞者，盧牧沮而不許，㑹餞朝客於短亭，生獻詩云。」",
        "context": "獻盧常侍",
        "original_title": "獻盧常侍",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_783_018_01",
    "volume": 783,
    "author": {
      "canonical": "繆氏子",
      "recorded": "繆氏子"
    },
    "title": "賦新月",
    "poem": [
      "初月如弓未上弦，分明掛在碧霄邊。",
      "時人莫道蛾眉小，三五團圓照滿天。"
    ],
    "notes": [
      {
        "content": "開元時，繆氏有子七歲，聰慧能文，以神童召試，賦新月詩稱旨。",
        "context": "賦新月",
        "original_title": "賦新月",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_783_019_01",
    "volume": 783,
    "author": {
      "canonical": "京兆韋氏子",
      "recorded": "京兆韋氏子"
    },
    "title": "悼妓詩",
    "poem": [
      "惆悵金泥簇蝶裙，春來猶見伴行雲。",
      "不教佈施剛留得，渾似初逢李少君。"
    ],
    "notes": [
      {
        "content": "唐闕史韋嘗納一妓於洛，顔色明秀，尤善音律工書，嘗令寫杜工部詩，有訛輙能改正，韋甚溺之，年二十一卒，韋情痛，有嵩山任處士得返魂術，用一經身金縷裙導其魂招之，果暎幃而出，幽芳怨態，若不自勝，與之言，頷首而已，逾刻滅，生長慟賦詩。",
        "context": "悼妓詩",
        "original_title": "悼妓詩",
        "type": "footnote"
      }
    ]
  }
]