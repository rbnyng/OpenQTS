  {
    "uid": "QTS_810_021_01",
    "volume": 810,
    "author": {
      "canonical": "法照",
      "recorded": "法照",
      "gender": "male"
    },
    "title": "送清江上人",
    "poem": [
      "越人僧體古，清慮洗塵勞。",
      "一國詩名遠，多生律行高。",
      "見山援葛藟，避世著方袍。",
      "早晚雲門去，儂應逐爾曹。"
    ],
    "notes": [
      {
        "content": "僧伽闍衣為方袍。",
        "context": "送清江上人"
      }
    ]
  },
  {
    "uid": "QTS_810_022_01",
    "volume": 810,
    "author": {
      "canonical": "法照",
      "recorded": "法照",
      "gender": "male"
    },
    "title": "送無著禪師歸新羅",
    "poem": [
      "萬里歸鄉路，隨緣不算程。",
      "尋山百衲弊，過海一杯輕。",
      "夜宿依雲色，晨齋就水聲。",
      "何年持貝葉，卻到漢家城。"
    ]
  },
  {
    "uid": "QTS_810_023_01",
    "volume": 810,
    "author": {
      "canonical": "釋泚",
      "recorded": "釋泚",
      "gender": "male"
    },
    "title": "遊元象泊",
    "poem": [
      "空水潮色淨，澹然湖上心。",
      "舳艫輕且進，汀洲如可尋。",
      "秋風洄溯險，落日波濤深。",
      "寂寞武陵去，中流方至今。"
    ]
  },
  {
    "uid": "QTS_810_024_01",
    "volume": 810,
    "author": {
      "canonical": "釋泚",
      "recorded": "釋泚",
      "gender": "male"
    },
    "title": "北原別業",
    "poem": [
      "野外車騎絕，古村桑柘陰。",
      "流鶯出谷靜，春草閉門深。",
      "學稼農為業，忘情道作心。",
      "因知上皇日，鑿井在靈林。"
    ],
