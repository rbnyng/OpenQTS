      "gender": "male"
    },
    "title": "聽鶯歌",
    "poem": [
      "新鶯傍簷曉更悲，孤音清泠囀素枝。",
      "口邊血出語未盡，豈是怨恨人不知。",
      "不食枯桑葚，不銜苦李花。",
      "偶然弄樞機，婉轉淩煙霞。",
      "眾雛飛鳴何侷促，自覘遊蜂啄枯木。",
      "玄猿何事朝夜啼，白鷺長在汀洲宿。",
      "黑雕黃鶴豈不高，金籠玉鉤傷羽毛。",
      "三江七澤去不得，風煙日暮生波濤。",
      "飛去來，莫上高城頭，莫下空園裏。",
      "城頭鴟烏拾膻腥，空園燕雀爭泥滓。",
      "願當結舌含白雲，五月六月一聲不可聞。"
    ]
  },
  {
    "uid": "QTS_810_002_01",
    "volume": 810,
    "author": {
      "canonical": "靈澈",
      "recorded": "靈澈",
      "gender": "male"
    },
    "title": "歸湖南作",
    "poem": [
      "山邊水邊待月明，暫向人間借路行。",
      "如今還向山邊去，只有湖水無行路。"
    ]
  },
  {
    "uid": "QTS_810_003_01",
    "volume": 810,
    "author": {
      "canonical": "靈澈",
      "recorded": "靈澈",
      "gender": "male"
    },
    "title": "初到汀州",
    "poem": [
      "初放到滄洲，前心詎解愁。",
      "舊交容不拜，臨老學梳頭。",
      "禪室白雲去，故山明月秋。",
      "幾年猶在此，北戶水南流。"
    ]
  },
  {
    "uid": "QTS_810_004_01",
    "volume": 810,
    "author": {
      "canonical": "靈澈",
      "recorded": "靈澈",
      "gender": "male"
    },
    "title": "九日和於使君思上京親故",
    "poem": [
      "清晨有高會，賓從出東方。",
      "楚俗風煙古，汀洲草木涼。",
      "山情來遠思，菊意在重陽。",
      "心憶華池上，從容鴛鷺行。"
    ]
  },
  {
    "uid": "QTS_810_005_01",
    "volume": 810,
    "author": {
      "canonical": "靈澈",
      "recorded": "靈澈",
      "gender": "male"
    },
    "title": "送道虔上人遊方",
    "poem": [
      "律儀通外學，詩思入玄關。",
      "煙景隨緣到，風姿與道閒。",
      "貫花留淨室，咒水度空山。",
      "誰識浮雲意，悠悠天地間。"
    ]
  },
  {
    "uid": "QTS_810_006_01",
    "volume": 810,
    "author": {
      "canonical": "靈澈",
      "recorded": "靈澈",
      "gender": "male"
    },
    "title": "送鑒供奉歸蜀寧親",
    "poem": [
      "林間出定戀庭闈，聖主恩深暫許歸。",
      "雙樹欲辭金錫冷，四花猶向玉階飛。",
      "梁山拂漢分清境，蜀雪和煙惹翠微。",
      "此去不須求綵服，紫衣全勝老萊衣。"
    ]
  },
  {
    "uid": "QTS_810_007_01",
    "volume": 810,
    "author": {
      "canonical": "靈澈",
      "recorded": "靈澈",
      "gender": "male"
    },
    "title": "天姥岑望天台山",
    "poem": [
      "天台眾峰外，華頂當寒空。",
      "有時半不見，崔嵬在雲中。"
    ]
  },
  {
    "uid": "QTS_810_008_01",
    "volume": 810,
    "author": {
      "canonical": "靈澈",
      "recorded": "靈澈",
      "gender": "male"
    },
    "title": "遠公墓",
    "poem": [
      "古墓石稜稜，寒雲晚景凝。",
      "空悲虎溪月，不見鴈門僧。"
    ]
  },
  {
    "uid": "QTS_810_009_01",
    "volume": 810,
    "author": {
      "canonical": "靈澈",
      "recorded": "靈澈",
      "gender": "male"
    },
    "title": "宿東林寺",
    "poem": [
      "天寒猛虎叫巖雪，林下無人空有月。",
      "千年像教今不聞，焚香獨為鬼神說。"
    ],
