    "poem": [
      "殷勤移植地",
      "曲檻小闌邊",
      "共約重芳日",
      "還憂不盛妍",
      "阻風開步障",
      "乘月溉寒泉",
      "誰料花前後",
      "蛾眉卻不全"
    ]
