    "poem": [
      "珠碎眼前珍",
      "花凋世外春",
      "未銷心裏恨",
      "又失掌中身",
      "玉笥猶殘藥",
      "香匳已染塵",
      "前哀將後感",
      "無淚可霑巾"
    ],
