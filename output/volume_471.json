[
  {
    "uid": "QTS_471_001_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "五雜組",
    "poem": [
      "五雜組，刺繡窠。",
      "往復還，織錦梭。",
      "不得已，戍交河。"
    ]
  },
  {
    "uid": "QTS_471_002_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "剪綵花",
    "poem": [
      "敢競桃李色，自呈刀尺功。",
      "蝶猶迷剪翠，人豈辨裁紅。"
    ]
  },
  {
    "uid": "QTS_471_003_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "春晦送客",
    "poem": [
      "野酌亂無巡",
      "送君兼送春",
      "明年春色至",
      "莫作未歸人"
    ]
  },
  {
    "uid": "QTS_471_004_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "自君之出矣",
    "poem": [
      "自君之出矣",
      "寶鏡為誰明",
      "思君如隴水",
      "長聞嗚咽聲"
    ]
  },
  {
    "uid": "QTS_471_005_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "四氣",
    "poem": [
      "春禽猶競囀",
      "夏木忽交陰",
      "稍覺秋山遠",
      "俄驚冬霰深"
    ]
  },
  {
    "uid": "QTS_471_006_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "四色",
    "poem": [
      "壺中冰始結",
      "盤上露初圓",
      "何意瑤池雪",
      "欲奪鶴毛鮮",
      "道士牛已至",
      "仙家鳥亦來",
      "骨為神不朽",
      "眼向故人開",
      "勞魴蓮渚內",
      "汗馬火旂間",
      "平生血誠盡",
      "不獨左輪殷",
      "已見池盡墨",
      "誰言突不黔",
      "漆身恩未報",
      "貂裘弊豈嫌"
    ]
  },
  {
    "uid": "QTS_471_007_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "大言",
    "poem": [
      "四溟杯渌醑",
      "五岳髻青螺",
      "揮汗曾成雨",
      "畫地亦成河"
    ]
  },
  {
    "uid": "QTS_471_008_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "細言",
    "poem": [
      "蚊眉自可托",
      "蝸角豈勞爭",
      "欲效絲毫力",
      "誰知螻蟻誠"
    ]
  },
  {
    "uid": "QTS_471_009_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "山中桂",
    "poem": [
      "八樹拂丹霄",
      "四時青不凋",
      "秋風何處起",
      "先褭最長條"
    ]
  },
  {
    "uid": "QTS_471_010_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "蘆花",
    "poem": [
      "夾岸復連沙",
      "枝枝搖浪花",
      "月明渾似雪",
      "無處認漁家"
    ]
  },
  {
    "uid": "QTS_471_011_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "江邊柳",
    "poem": [
      "嫋嫋古堤邊，青青一樹煙。",
      "若為絲不斷，留取繫郎船。"
    ]
  },
  {
    "uid": "QTS_471_012_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "江上山",
    "poem": [
      "綺霞明赤岸，錦纜繞丹枝。",
      "楚客正愁絕，西風且莫吹。"
    ],
    "notes": [
      {
        "type": "title_note",
        "content": "一本無山字",
        "context": "江上山"
      }
    ]
  },
  {
    "uid": "QTS_471_013_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "游絲",
    "poem": [
      "游絲何所似，應最似春心。",
      "一向風前亂，千條不可尋。"
    ]
  },
  {
    "uid": "QTS_471_014_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "柳絮",
    "poem": [
      "無風纔到地，有風還滿空。",
      "緣渠偏似雪，莫近鬢毛生。"
    ]
  },
  {
    "uid": "QTS_471_015_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "殘鶯",
    "poem": [
      "花闌鶯亦懶，不語似含情。",
      "何言百囀舌，唯餘一兩聲。"
    ]
  },
  {
    "uid": "QTS_471_016_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "早蟬",
    "poem": [
      "一聲清溽暑，幾處促流年。",
      "志士心偏苦，初聞獨泫然。"
    ]
  },
  {
    "uid": "QTS_471_017_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "秋蛩",
    "poem": [
      "雨絕蒼苔地，月斜青草階。",
      "蛩鳴誰不怨，況是正離懷。"
    ]
  },
  {
    "uid": "QTS_471_018_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "江上聞猿",
    "poem": [
      "楓岸月斜明",
      "猿啼旅夢驚",
      "愁多腸易斷",
      "不待第三聲"
    ]
  },
  {
    "uid": "QTS_471_019_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "折柳贈行人",
    "poem": [
      "那言柳亂垂，盡日任風吹。",
      "欲識千條恨，和煙折一枝。"
    ]
  },
  {
    "uid": "QTS_471_020_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "題蒲葵扇",
    "poem": [
      "傾心曾向日，在手幸遙風。",
      "羨爾逢提握，知名自謝公。"
    ]
  },
  {
    "uid": "QTS_471_021_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "贈苦行僧",
    "poem": [
      "幽深紅葉寺，清淨白毫僧。",
      "古殿長鳴磬，低頭禮晝燈。"
    ]
  },
  {
    "uid": "QTS_471_022_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "兩頭纖纖",
    "poem": [
      "兩頭纖纖八字眉，半白半黑燈影帷。",
      "腷腷膊膊曉禽飛，磊磊落落秋果垂。"
    ]
  },
  {
    "uid": "QTS_471_023_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "了語",
    "poem": [
      "掃卻煙塵寇初剿，深水高林放魚鳥。",
      "雞人唱絕殘漏曉，仙樂拍終天悄悄。"
    ]
  },
  {
    "uid": "QTS_471_024_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "不了語",
    "poem": [
      "浮名世利知多少，朝市喧喧塵擾擾。",
      "車馬交馳往復來，鐘鼓相催天又曉。"
    ]
  },
  {
    "uid": "QTS_471_025_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "聽彈沈湘",
    "poem": [
      "賈誼投文弔屈平，瑤琴能寫此時情。",
      "秋風一奏沈湘曲，流水千年作恨聲。"
    ]
  },
  {
    "uid": "QTS_471_026_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "豪家夏冰詠",
    "poem": [
      "金錯銀盤貯賜冰，清光如聳玉山棱。",
      "無論塵客閒停扇，直到消時不見蠅。"
    ]
  },
  {
    "uid": "QTS_471_027_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "宿棣華館聞雁",
    "poem": [
      "不堪旅宿棣花館，況有離羣鴻雁聲。",
      "一點秋燈殘影下，不知寒夢幾回驚。"
    ]
  },
  {
    "uid": "QTS_471_028_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "農家望晴",
    "poem": [
      "嘗聞秦地西風雨，爲問西風早晚回。",
      "白髮老農如鶴立，麥場高處望雲開。"
    ]
  },
  {
    "uid": "QTS_471_029_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "宮人斜",
    "poem": [
      "幾多紅粉委黃泥，野鳥如鴿又似啼。",
      "應有春魂化為燕，年年飛入未央棲。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "年",
        "variant": "來",
        "source": "一作「來」"
      }
    ]
  },
  {
    "uid": "QTS_471_030_01",
    "volume": 471,
    "author": {
      "canonical": "雍裕之",
      "recorded": "雍裕之"
    },
    "title": "曲江池上",
    "poem": [
      "殷勤春在曲江頭，金籍群仙佔勝遊。",
      "何必三山待鸞鶴，年年此地是瀛洲。"
    ]
  }
]