      "recorded": "於鵠",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yu Hu",
      "wikidata_id": "Q22101220"
    },
    "title": "寄續尊師",
    "poem": [
      "得道任發白，亦逢城市遊。",
      "新經天上取，稀藥洞中收。",
      "春木帶枯葉，新蒲生漫流。",
      "年年望靈鶴，常在此山頭。"
    ]
  },
  {
