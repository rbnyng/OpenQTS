    "total_parts": 2
  },
  {
    "uid": "QTS_491_022_01",
    "volume": 491,
    "author": {
      "canonical": "王初",
      "recorded": "王初"
    },
    "title": "春日詠梅花二首 其一",
    "poem": [
      "靚妝才罷粉痕新，遞曉風回散玉塵。",
      "若遣有情應悵望，已兼殘雪又兼春。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_491_022_02",
    "volume": 491,
    "author": {
      "canonical": "王初",
      "recorded": "王初"
    },
    "title": "春日詠梅花二首 其二",
    "poem": [
      "青帝來時值遠芳，殘花殘雪尚交光。",
      "來年擬待春消息，得見春風已斷腸。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_491_023_01",
    "volume": 491,
    "author": {
      "canonical": "王初",
      "recorded": "王初"
    },
    "title": "即夕",
    "poem": [
      "榆葉飄零碧漢流，玉蟾珠露兩清秋。",
      "仙家若有單棲恨，莫向銀臺半夜遊。"
    ]
  },
  {
    "uid": "QTS_491_024_01",
    "volume": 491,
    "author": {
      "canonical": "王初",
      "recorded": "王初"
    },
    "title": "送陳校勘入宿",
    "poem": [
      "日落風回卷碧霓，芳蓬一夜拆龍泥。",
      "銀臺級級連清漢，桂子香濃月杵低。"
    ]
  },
  {
    "uid": "QTS_491_025_01",
    "volume": 491,
    "author": {
      "canonical": "王初",
      "recorded": "王初"
    },
    "title": "即夕",
    "poem": [
      "風幌涼生白袷衣，星榆才亂絳河低。",
      "月明休近相思樹，恐有韓憑一處棲。"
    ]
  },
  {
    "uid": "QTS_491_026_01",
    "volume": 491,
    "author": {
      "canonical": "王初",
      "recorded": "王初"
    },
    "title": "早春詠雪",
    "poem": [
      "句芒宮樹已先開，珠蘂瓊花鬬剪裁。",
      "散作上林今夜雪，送教春色一時來。"
    ]
  },
  {
    "uid": "QTS_491_027_01",
    "volume": 491,
    "author": {
      "canonical": "王初",
      "recorded": "王初"
    },
    "title": "望雪",
    "poem": [
      "銀花珠樹曉來看，宿醉初醒一倍寒。",
      "已似王恭披鶴氅，憑欄仍是玉欄干。"
    ]
  },
  {
    "uid": "QTS_491_028_01",
    "volume": 491,
    "author": {
      "canonical": "王初",
      "recorded": "王初"
    },
    "title": "雪霽",
    "poem": [
      "星榆葉葉晝離披，雲粉千重凝不飛。",
      "崑玉樓臺珠樹密，夜來誰向月中歸。"
    ]
  },
  {
    "uid": "QTS_491_029_01",
    "volume": 491,
    "author": {
      "canonical": "王初",
      "recorded": "王初"
    },
    "title": "舟次汴堤",
    "poem": [
      "曲岸蘭叢雁飛起，野客維舟碧煙裏。",
      "竿頭五兩轉天風，白日楊花滿流水。"
    ]
  },
  {
    "uid": "QTS_491_030_01",
    "volume": 491,
    "author": {
      "canonical": "劉軻",
      "recorded": "劉軻",
      "gender": "male",
      "english_name": "Liu Ke",
      "wikidata_id": "Q18906295"
    },
    "title": "玉聲如樂",
    "poem": [
      "玉叩能旋止，人言與樂並。",
      "繁音忽已闋，雅韻詘然清。",
      "佩想停仙步，泉疑咽夜聲。",
      "曲終無異聽，響極有餘情。",
      "特達知難擬，玲瓏豈易名。",
      "崑山如可得，一片佇為榮。"
    ]
  },
  {
    "uid": "QTS_491_031_01",
    "volume": 491,
    "author": {
      "canonical": "朱晝",
      "recorded": "朱晝"
    },
    "title": "喜陳懿老示新製",
    "poem": [
      "一別一千日，一日十二憶。",
      "苦心無閒時，今夕見玉色。",
      "玉色復何異，弘明含群德。",
      "有文如星宿，飛入我胸臆。",
      "憂愁方破壞，歡喜重補塞。",
      "使我心貌全，且非黃金力。",
      "將攀下風手，願假仙鸞翼。",
      "〈〉"
    ],
    "notes": [
      {
        "line": 15,
        "content": "自注云：「予欲見詩人孟郊，故寄城於此。」",
        "context": "〈〉"
      }
    ]
  },
  {
    "uid": "QTS_491_032_01",
    "volume": 491,
    "author": {
      "canonical": "朱晝",
      "recorded": "朱晝"
    },
    "title": "贈友人古鏡",
    "poem": [
      "我有古時鏡，初自壞陵得。",
      "蛟龍猶泥蟠，魑魅幸月蝕。",
      "摩久見菱蘂，青於藍水色。",
      "贈君將照色，無使心受惑。"
    ]
  },
  {
    "uid": "QTS_491_033_01",
    "volume": 491,
    "author": {
      "canonical": "朱晝",
      "recorded": "朱晝"
    },
    "title": "賦得花藤藥合寄潁陰故人",
    "poem": [
      "藤生南海濱，引蔓青且長。",
      "剪削為花枝，何人無文章。",
      "非才亦有心，割骨聞餘芳。",
      "繁葉落何處，孤貞在中央。",
      "願盛黃金膏，寄與青眼郎。",
      "路遠莫知意，水深天蒼蒼。"
    ]
  },
  {
    "uid": "QTS_491_034_01",
    "volume": 491,
    "author": {
      "canonical": "朱晝",
      "recorded": "朱晝"
    },
    "title": "春色滿皇州",
    "poem": [
      "藹藹復悠悠，春歸十二樓。",
      "最明雲裏闕，先滿日邊州。",
      "色媚青門外，光搖紫陌頭。",
      "上林榮舊樹，太液鏡新流。",
      "暖帶祥煙起，清添瑞景浮。",
      "陽和如啟蟄，從此事芳遊。"
    ]
  },
  {
    "uid": "QTS_491_035_01",
    "volume": 491,
    "author": {
      "canonical": "朱晝",
      "recorded": "朱晝"
    },
    "title": "楊柳枝詞",
    "poem": [
      "三條陌上拂金羈，萬里橋邊映酒旗。",
      "此日令人腸欲斷，不堪將入笛中吹。"
    ]
  },
