  {
    "uid": "QTS_491_005_01",
    "volume": 491,
    "author": {
      "canonical": "李播",
      "recorded": "李播"
    },
    "title": "見志",
    "poem": [
      "去歲買琴不與價，今年沽酒未還錢。",
      "門前債主雁行立，屋裏醉人魚貫眠。"
    ]
  },
  {
    "uid": "QTS_491_006_01",
    "volume": 491,
    "author": {
      "canonical": "王季則",
      "recorded": "王季則"
    },
    "title": "魚上冰",
    "poem": [
      "北陸收寒盡，東風解凍初。",
      "冰消通淺溜，氣變躍潛魚。",
      "應節似知化，揚鬐任所如。",
      "浮沉非樂藻，沿泝異傳書。",
      "結網時空久，臨川意有餘。",
      "為龍將可望，今日媿才虛。"
    ]
  },
  {
    "uid": "QTS_491_007_01",
    "volume": 491,
    "author": {
      "canonical": "紀元皋",
      "recorded": "紀元皋"
    },
    "title": "魚上冰",
    "poem": [
      "春生寒氣{滅，稍動伏泉魚。",
      "乍喜東風至，來觀曲浦初。",
      "近冰朱鬣見，望日錦鱗舒。",
      "漸覺流澌退，還忻掉尾餘。",
      "噞喁情自樂，沿泝意寧疏。",
      "倘得隨鯤化，終能戾太虛。"
    ]
  },
  {
    "uid": "QTS_491_008_01",
    "volume": 491,
    "author": {
      "canonical": "吳晃",
      "recorded": "吳晃"
    },
    "title": "魚上冰",
    "poem": [
      "春水潛鱗發，寒潭舊藻疏。",
      "揚鬐順氣後，振鬣上冰初。",
      "戲廣憐空潔，浮清媚景虛。",
      "戒貪還避餌，思達每懷書。",
      "濕映流澌薄，狂遊觸浪餘。",
      "終希泮渙澤，為化北溟魚。"
    ]
  },
  {
    "uid": "QTS_491_009_01",
    "volume": 491,
    "author": {
      "canonical": "鄭還古",
      "recorded": "鄭還古",
      "gender": "male",
      "english_name": "Zheng Haigu",
      "wikidata_id": "Q16260209"
    },
    "title": "贈柳氏妓",
    "poem": [
      "冶豔出神仙，歌聲勝管弦。",
      "{詞輕白紵曲，歌遏碧雲天。",
      "未擬生裴秀，如何乞鄭玄。",
      "不堪金谷水，橫過墜樓前。"
    ]
  },
  {
    "uid": "QTS_491_010_01",
    "volume": 491,
    "author": {
      "canonical": "鄭還古",
      "recorded": "鄭還古",
      "gender": "male",
      "english_name": "Zheng Haigu",
      "wikidata_id": "Q16260209"
    },
    "title": "吉州道中",
    "poem": [
      "吉州新置掾，馳驛到條山。",
      "薏苡殊非謗，羊腸未是艱。",
      "自慚多白髮，爭敢競朱顏。",
      "若有前生債，今朝不懊還。"
    ]
  },
  {
    "uid": "QTS_491_011_01",
    "volume": 491,
    "author": {
      "canonical": "鄭還古",
      "recorded": "鄭還古",
      "gender": "male",
      "english_name": "Zheng Haigu",
      "wikidata_id": "Q16260209"
    },
    "title": "望思臺",
    "poem": [
      "讒語能令骨肉離，姦情難測事堪悲。",
      "何因掘得江充骨，搗作微塵祭望思。"
    ]
  },
  {
    "uid": "QTS_491_012_01",
    "volume": 491,
    "author": {
      "canonical": "獨孤鉉",
      "recorded": "獨孤鉉",
      "gender": "male",
      "wikidata_id": "Q18908267"
    },
    "title": "日南長至",
    "poem": [
      "玉曆頒新律，凝陰發一陽。",
      "輪輝猶惜短，圭影此偏長。",
      "晷度經南斗，流晶盡北堂。",
      "乍疑周戶耀，可愛逗林光。",
      "積雪銷微照，初萌動早芒。",
      "更升臺上望，雲物已昭彰。"
    ]
  },
  {
    "uid": "QTS_491_013_01",
    "volume": 491,
    "author": {
      "canonical": "王初",
      "recorded": "王初"
    },
    "title": "延平天慶觀",
    "poem": [
      "劍化江邊綠構新，層台不染玉梯塵。",
      "千章隱篆標龍簡，一曲空歌降鳳鈞。",
      "嵐氣濕衣雲葉晚，天香飄戶月枝春。",
      "盟經早晚聞仙語，學種三芝伴羽人。"
    ]
  },
  {
    "uid": "QTS_491_014_01",
    "volume": 491,
    "author": {
      "canonical": "王初",
      "recorded": "王初"
    },
    "title": "送葉秀才",
    "poem": [
      "快騎璁瓏刻玉羈，河梁返照上征衣。",
      "層冰春近蟠龍起，九澤雲閑獨鶴飛。",
      "行想北山清夢斷，重遊西洛故人稀。",
      "漢庭狗監深知己，有日前驅負弩歸。"
    ]
  },
  {
    "uid": "QTS_491_015_01",
    "volume": 491,
    "author": {
      "canonical": "王初",
      "recorded": "王初"
    },
    "title": "送王秀才謁池州吳都督",
    "poem": [
      "池陽去去躍雕鞍，十裏長亭百草乾。",
      "衣袂障風金鏤細，劍光橫雪玉龍寒。",
      "晴郊別岸鄉魂斷，曉樹啼烏客夢殘。",
      "南館星郎東道主，搖鞭休問路行難。"
    ]
  },
  {
    "uid": "QTS_491_016_01",
    "volume": 491,
    "author": {
      "canonical": "王初",
      "recorded": "王初"
    },
    "title": "青帝",
    "poem": [
      "青帝邀春隔歲還，月娥孀獨夜漫漫。",
      "韓憑舞羽身猶在，素女商弦調未殘。",
      "終古蘭巖棲偶鶴，從來玉穀有離鸞。",
      "幾時幽恨飄然斷，共待天池一水乾。"
    ]
  },
  {
    "uid": "QTS_491_017_01",
    "volume": 491,
    "author": {
      "canonical": "王初",
      "recorded": "王初"
    },
    "title": "銀河",
    "poem": [
      "閶闔疏雲漏絳津，橋頭秋夜鵲飛頻。",
      "猶殘仙媛湔裙水，幾見星妃度襪塵。",
      "歷歷素榆飄玉葉，涓涓清月濕冰輪。",
      "年來若有乘槎客，為弔波靈是楚臣。"
    ]
  },
  {
    "uid": "QTS_491_018_01",
    "volume": 491,
    "author": {
      "canonical": "王初",
      "recorded": "王初"
    },
    "title": "書秋",
    "poem": [
      "千里南雲度塞鴻，秋容無跡淡平空。",
      "人間玉嶺清宵月，天上銀河白晝風。",
      "潘賦登山魂易斷，楚歌遺佩怨何窮。",
      "往來未若奇張翰，欲鱠霜鯨碧海東。"
    ]
  },
  {
    "uid": "QTS_491_019_01",
    "volume": 491,
    "author": {
      "canonical": "王初",
      "recorded": "王初"
    },
    "title": "自和書秋",
    "poem": [
      "隴首斜飛避弋鴻，頹雲蕭索見層空。",
      "漢宮夜結雙莖露，閶闔涼生六幕風。",
      "湘女怨弦愁不禁，鄂君香被夢難窮。",
      "江邊兩槳連歌渡，驚散游魚蓮葉東。"
    ]
  },
  {
    "uid": "QTS_491_020_01",
    "volume": 491,
    "author": {
      "canonical": "王初",
      "recorded": "王初"
    },
    "title": "立春後作",
    "poem": [
      "東君珂佩響珊珊，青馭多時下九關。",
      "方信玉霄千萬里，春風猶未到人間。"
    ]
  },
  {
    "uid": "QTS_491_021_01",
    "volume": 491,
    "author": {
