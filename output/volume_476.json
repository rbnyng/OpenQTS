[
  {
    "uid": "QTS_476_001_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "至日荷李常侍過郊居",
    "poem": [
      "賤子守柴荊",
      "誰人記姓名",
      "風雲千騎降",
      "草木一陽生",
      "禮異江河動",
      "還殊裡巷驚",
      "稱觴容侍坐",
      "看著許同行",
      "遇覺滄溟淺",
      "恩疑太岳輕",
      "盡搜天地物",
      "無諭此時情"
    ]
  },
  {
    "uid": "QTS_476_002_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "日暮天無雲",
    "poem": [
      "杳杳復蒼然",
      "無雲日暮天",
      "象分青氣外",
      "景盡赤霄前",
      "漸吐星河色",
      "遙生水木煙",
      "從容難附麗",
      "顧步欲澄鮮",
      "但見收三素",
      "何能測上玄",
      "應非暫呈瑞",
      "不許出山川"
    ],
    "variants": [
      {
        "line": 7,
        "text": "容",
        "variant": "龍",
        "source": "一作「龍」"
      }
    ]
  },
  {
    "uid": "QTS_476_003_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "新成小亭月夜",
    "poem": [
      "已被月知處，斬新風到來。",
      "無人伴幽境，多取木蘭栽。"
    ]
  },
  {
    "uid": "QTS_476_004_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "和竇中丞歲酒喜見小男兩歲",
    "poem": [
      "更添十歲應為相",
      "歲酒從今把未休",
      "聞得一毛添五色",
      "眼看相逐鳳池頭"
    ]
  },
  {
    "uid": "QTS_476_005_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "寒食",
    "poem": [
      "東風潑火雨新體",
      "舁盡春泥掃雪溝",
      "走馬犢車當御路",
      "漢陽公主謝雞毬"
    ]
  },
  {
    "uid": "QTS_476_006_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "送僧遊山",
    "poem": [
      "雲身自在山山去，何處靈山不是歸？",
      "日暮寒林投古寺，雪花飛滿水田衣。"
    ]
  },
  {
    "uid": "QTS_476_007_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "雪中答僧書",
    "poem": [
      "八行銀字非常草",
      "六出天花盡是梅",
      "無所與陳童子別",
      "雪中辛苦遠山來"
    ]
  },
  {
    "uid": "QTS_476_008_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "題逍遙樓傷故韋大夫",
    "poem": [
      "利及生人無更為",
      "落花流水舊城池",
      "逍遙樓上雕龍宇",
      "便是羊公墮淚碑"
    ]
  },
  {
    "uid": "QTS_476_009_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "戲贈費觀卿",
    "poem": [
      "但恐紅塵虛白首",
      "寧論蹇逸分先後",
      "莫占鶯花笑寂寥",
      "長安春色年年有"
    ]
  },
  {
    "uid": "QTS_476_010_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "與左興宗湓城別",
    "poem": [
      "江逢九派人將別",
      "猿到三聲月為秋",
      "不知相見更何日",
      "此夜少年堪白頭"
    ]
  },
  {
    "uid": "QTS_476_011_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "八月十五夜臥疾",
    "poem": [
      "一年只有今宵月",
      "盡上江樓獨病眠",
      "寂寞竹窗閒不閉",
      "夜深斜影道床前"
    ]
  },
  {
    "uid": "QTS_476_012_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "正月十五日",
    "poem": [
      "漢家遺事今宵見，楚郭明燈幾處張。",
      "深夜行歌聲絕後，紫姑神下月蒼蒼。"
    ]
  },
  {
    "uid": "QTS_476_013_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "曲池陪宴即事上竇中丞",
    "poem": [
      "水自山阿繞坐來",
      "珊瑚臺上木棉開",
      "欲知舉目無情罰",
      "一片花流酒一杯"
    ]
  },
  {
    "uid": "QTS_476_014_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "董監廟",
    "poem": [
      "仁傑淫祠廢欲無",
      "枯楓老櫟兩三株",
      "神烏慣得商人食",
      "飛趂征帆過蠡湖"
    ]
  },
  {
    "uid": "QTS_476_015_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "贈侯山人",
    "poem": [
      "一見清容愜素聞",
      "有人傳是紫陽君",
      "來時玉女裁春服",
      "剪破湘山幾片雲"
    ]
  },
  {
    "uid": "QTS_476_016_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "送馬判官赴安南",
    "poem": [
      "故人交趾去從軍",
      "應笑狂生揮陣雲",
      "省得蔡州今日事",
      "舊曾都護帳前聞"
    ]
  },
  {
    "uid": "QTS_476_017_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "送準上人歸石經院",
    "poem": [
      "旃檀刻像今猶少",
      "白石鎸經古未曾",
      "歸去更尋翻譯寺",
      "前山應遇雁門僧"
    ]
  },
  {
    "uid": "QTS_476_018_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "寒食野望",
    "poem": [
      "拜掃無過骨肉親",
      "一年唯此兩三辰",
      "冢頭莫種有花樹",
      "春色不關泉下人"
    ]
  },
  {
    "uid": "QTS_476_019_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "袛役遇風謝湘中春色",
    "poem": [
      "水生風熟布帆新",
      "只見公程不見春",
      "應被百花撩亂笑",
      "比來天地一閒人"
    ],
    "variants": [
      {
        "line": 2,
        "text": "只",
        "variant": "唯",
        "source": "一作「唯」"
      }
    ]
  },
  {
    "uid": "QTS_476_020_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "湘江夜泛",
    "poem": [
      "江流如箭月如弓",
      "行盡三湘數夜中",
      "無那子規知向蜀",
      "一聲聲似怨春風"
    ],
    "variants": [
      {
        "line": 4,
        "text": "春",
        "variant": "東",
        "source": "一作「東」"
      }
    ]
  },
  {
    "uid": "QTS_476_021_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "蜀江水",
    "poem": [
      "日夜朝宗來萬里",
      "共憐江水引蕃心",
      "若論巴峽愁人處",
      "猿比灘聲是好音"
    ],
    "notes": [
      {
        "content": "來自蕃界",
        "context": "蜀江水",
        "original_title": "蜀江水〈來自蕃界〉"
      }
    ]
  },
  {
    "uid": "QTS_476_022_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "寄安南馬中丞",
    "poem": [
      "龍韜能致虎符分",
      "萬里霜臺壓瘴雲",
      "蕃客不須愁海路",
      "波神今伏馬將軍"
    ]
  },
  {
    "uid": "QTS_476_023_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "甘子堂陪宴上韋大夫",
    "poem": [
      "武陵樓上春長早",
      "甘子堂前落花遲",
      "楚樂怪來聲競起",
      "新歌盡是大夫詞"
    ]
  },
  {
    "uid": "QTS_476_024_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "清溪村居兩首",
    "poem": [
      "家占溪南千個竹",
      "地臨湖上一群山",
      "漁船多在馬長放",
      "出處自由閒不閒",
      "深樹黃鸝曉一聲",
      "林西江上月猶明",
      "野人早起無他事",
      "貪繞沙泉看筍生"
    ]
  },
  {
    "uid": "QTS_476_025_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "奉和興元鄭相公早春送楊侍郎",
    "poem": [
      "征鞍欲上醉還留",
      "南浦春生百草頭",
      "丞相新裁別離曲",
      "聲聲飛出舊梁州"
    ]
  },
  {
    "uid": "QTS_476_026_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "送舍弟孺復往廬山",
    "poem": [
      "能騎竹馬辨西東",
      "未省煙花暫不同",
      "第一早歸春欲盡",
      "廬山好看過湖風"
    ]
  },
  {
    "uid": "QTS_476_027_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "野別留少微上人",
    "poem": [
      "若為相見還分散",
      "翻覺浮雲亦不閒",
      "何處留師暫且住",
      "家貧唯有坐中山"
    ]
  },
  {
    "uid": "QTS_476_028_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "經古墓",
    "poem": [
      "碑折松枯山火燒",
      "夜臺從閉不曾朝",
      "那將逝者比流水",
      "流水東流逢上潮"
    ]
  },
  {
    "uid": "QTS_476_029_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "贈靈徹上人",
    "poem": [
      "詩句能生世界春",
      "僧家更有姓湯人",
      "況聞暗憶前朝事",
      "知是修行第幾身"
    ]
  },
  {
    "uid": "QTS_476_030_01",
    "volume": 476,
    "author": {
      "canonical": "熊孺登",
      "recorded": "熊孺登"
    },
    "title": "春郊醉中贈章八元",
    "poem": [
      "三月踏青能幾日，百回添酒莫辭頻。",
      "看君到臥楊花裏，始覺春光爲醉人。"
    ]
  }
]