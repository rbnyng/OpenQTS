      "wikidata_id": "Q45422558"
    },
    "title": "讓皇帝廟樂章 迎神",
    "poem": [
      "皇矣天宗，德先王季。",
      "因心則友，克讓以位。",
      "爰命有司，式尊前志。",
      "神其降靈，昭饗祀事。"
    ]
  },
  {
    "uid": "QTS_252_024_01",
    "volume": 252,
    "author": {
      "canonical": "李紓",
      "recorded": "李紓",
      "gender": "male",
