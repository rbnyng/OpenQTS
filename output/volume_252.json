      "recorded": "李紓",
      "gender": "male",
      "period": "High Tang",
      "english_name": "Li Shu",
      "wikidata_id": "Q45422558"
    },
    "title": "唐德明興聖廟樂章 迎神",
    "poem": [
      "元尊九德，佐堯光宅。",
      "烈祖太宗，方周作伯。",
      "響懷霜露，樂變金石。",
      "白雲青風，髣髴來格。"
    ]
  },
  {
    "uid": "QTS_252_017_01",
    "volume": 252,
    "author": {
      "canonical": "李紓",
      "recorded": "李紓",
      "gender": "male",
