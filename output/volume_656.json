    "title": "七夕",
    "poem": [
      "絡角星河菡萏天，一家歡笑設紅筵。",
      "應傾謝女珠璣篋，盡寫檀郎錦繡篇。",
      "香帳簇成排窈窕，金鍼穿罷拜嬋娟。",
      "銅壺漏報天將曉，惆悵佳期又一年。"
    ],
    "variants": [
      {
        "line": 4,
        "text": "期",
        "variant": "人",
        "source": "一作「人」"
      }
    ]
  },
