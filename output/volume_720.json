      "canonical": "裴說",
      "recorded": "裴說"
    },
    "title": "寄僧尚顏",
    "poem": [
      "曾居五老峰，所得共誰同。",
      "才大天全與，吟精楚欲空。",
      "客來庭減日，鳥過竹生風。",
      "早晚搖輕拂，重歸瀑布中。"
    ],
    "variants": [
      {
