        "text": "鑒開",
        "variant": "開香",
        "source": "一作「開香」"
      },
      {
        "line": 3,
        "text": "垂垂",
        "variant": "重重",
        "source": "一作「重重」"
      }
    ]
  },
  {
    "uid": "QTS_720_004_01",
    "volume": 720,
    "author": {
      "canonical": "裴說",
      "recorded": "裴說"
    },
    "title": "春早寄華下同人",
    "poem": [
      "正是花時節，思君寢復興。",
      "市沽終不醉，春夢亦無憑。",
      "岳面懸青雨，河心走濁氷。",
      "東門一條路，離恨鎮相仍。"
    ]
  },
  {
    "uid": "QTS_720_005_01",
    "volume": 720,
    "author": {
      "canonical": "裴說",
      "recorded": "裴說"
    },
    "title": "贈衡山令",
    "poem": [
      "君吟十二載，辛苦必能官。",
      "造化猶難隱，生靈豈易謾。",
      "猿跳高岳靜，魚擺大江寬。",
      "與我為同道，相留夜話闌。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "十二載",
        "variant": "三十載",
        "source": "一作「三十載」"
      }
    ]
  },
  {
    "uid": "QTS_720_006_01",
    "volume": 720,
    "author": {
      "canonical": "裴說",
      "recorded": "裴說"
    },
    "title": "南中縣令",
    "poem": [
      "寂寥雖下邑，良宰有清威。",
      "苦節長如病，為官豈肯肥。",
      "山多村地狹，水淺客舟稀。",
      "上國搜賢急，陶公早晚歸。"
    ]
  },
  {
    "uid": "QTS_720_007_01",
    "volume": 720,
    "author": {
      "canonical": "裴說",
      "recorded": "裴說"
    },
    "title": "寄曹松",
    "poem": [
      "莫怪苦吟遲，詩成鬢亦絲。",
      "鬢絲猶可染，詩病卻難醫。",
      "山暝雲橫處，星沈月側時。",
      "冥搜不可得，一句至公知。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "沈",
        "variant": "稠",
        "source": "一作「稠」"
      }
    ]
  },
  {
    "uid": "QTS_720_008_01",
    "volume": 720,
    "author": {
      "canonical": "裴說",
      "recorded": "裴說"
    },
    "title": "贈賔貢",
    "poem": [
      "惟君懷至業，萬里信悠悠。",
      "路向東溟出，枝來北闕求。",
      "家無一夜夢，帆掛來年秋。",
      "鬢髮爭禁得，孤舟徃復愁。"
    ]
  },
  {
    "uid": "QTS_720_009_01",
    "volume": 720,
    "author": {
      "canonical": "裴說",
      "recorded": "裴說"
    },
    "title": "漢南郵亭",
    "poem": [
      "高閣水風清，開門日送迎。",
      "帆張獨鳥起，樂奏大魚驚。",
      "驟雨拖山過，微風拂面生。",
      "閒吟雖得句，留此謝多情。"
    ]
  },
  {
    "uid": "QTS_720_010_01",
    "volume": 720,
    "author": {
      "canonical": "裴說",
      "recorded": "裴說"
    },
    "title": "棋",
    "poem": [
      "十九條平路，言平又嶮巇。",
      "人心無算處，國手有輸時。",
      "勢逈流星遠，聲乾下雹遲。",
      "臨軒才一局，寒日又西垂。"
    ]
  },
  {
    "uid": "QTS_720_011_01",
    "volume": 720,
    "author": {
      "canonical": "裴說",
      "recorded": "裴說"
    },
    "title": "夏日即事",
    "poem": [
      "僻居門巷靜，竟日坐階墀。",
      "鵲喜雖傳信，蛩吟不見詩。",
      "筍抽通舊竹，梅落立閒枝。",
      "此際無塵撓，僧來稱所宜。"
    ],
    "variants": [
