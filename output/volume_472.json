      }
    ]
  },
  {
    "uid": "QTS_472_025_02",
    "volume": 472,
    "author": {
      "canonical": "劉皂",
      "recorded": "劉皂"
    },
    "title": "長門怨 其二",
    "poem": [
      "宮殿沉沉月欲分，昭陽更漏不堪聞。",
      "珊瑚枕上千行淚，不是思君是恨君。"
    ],
    "part_index": 2,
    "total_parts": 3,
    "variants": [
      {
        "line": 1,
        "text": "欲",
        "variant": "色",
        "source": "一作「色」"
      }
    ]
  },
  {
    "uid": "QTS_472_025_03",
    "volume": 472,
    "author": {
      "canonical": "劉皂",
      "recorded": "劉皂"
    },
    "title": "長門怨 其三",
    "poem": [
      "蟬鬢慵梳倚帳門，蛾睂不掃慣承恩。",
      "旁人未必知心事，一面殘妝空淚痕。"
    ],
    "part_index": 3,
    "total_parts": 3
  },
  {
    "uid": "QTS_472_026_01",
    "volume": 472,
    "author": {
      "canonical": "劉皂",
      "recorded": "劉皂"
    },
    "title": "旅次朔方",
    "poem": [
      "客舍并州數十霜，歸心日夜憶咸陽。",
      "無端又渡桑亁水，卻望并州似故鄉。"
    ],
    "notes": [
      {
        "content": "一作賈島詩",
        "context": "旅次朔方",
        "original_title": "旅次朔方〈一作賈島詩〉"
      }
    ]
  },
  {
    "uid": "QTS_472_027_01",
    "volume": 472,
    "author": {
      "canonical": "楊厚",
      "recorded": "楊厚"
    },
    "title": "早起",
    "poem": [
      "星漢轉寒更，伊余索寞情。",
      "鐘催歸夢斷，雁引遠愁生。",
      "危壁蘭光暗，疎簾露氣清。",
      "閒庭聊一望，海日未分明。"
    ]
  },
  {
    "uid": "QTS_472_028_01",
    "volume": 472,
    "author": {
      "canonical": "裴交泰",
      "recorded": "裴交泰",
      "period": "Five Dynasties and Ten Kingdoms"
    },
    "title": "長門怨",
    "poem": [
      "自閉長門經幾秋，羅衣濕盡淚還流。",
      "一種蛾睂明月夜，南宮歌管北宮愁。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "管",
        "variant": "吹",
        "source": "一作「吹」"
      }
    ]
  },
  {
    "uid": "QTS_472_029_01",
    "volume": 472,
    "author": {
      "canonical": "李秘",
      "recorded": "李祕"
    },
    "title": "禁中送任山人",
    "poem": [
      "子去非長往，君恩取大還。",
      "補天留彩石，縮地入青山。",
      "獻壽千春外，來朝數月間。",
      "莫拋殘藥物，竊取駐童顔。"
    ],
    "notes": [
      {
        "content": "此人自青城獻伏火諸石恩命令扵本山更取大還",
        "context": "中送任山人",
        "original_title": "禁中送任山人〈此人自青城獻伏火諸石恩命令扵本山更取大還〉"
      }
    ],
