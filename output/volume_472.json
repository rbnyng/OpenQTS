[
  {
    "uid": "QTS_472_001_01",
    "volume": 472,
    "author": {
      "canonical": "段弘古",
      "recorded": "段弘古"
    },
    "title": "奉陪呂使君樓上夜看花",
    "poem": [
      "城上芳園花滿枝，城頭太守夜看時。",
      "為報林中高舉燭，感人情思欲題詩。"
    ],
    "notes": [
      {
        "content": "一本下有「把火」二字",
        "context": "使君樓上夜",
        "original_title": "奉陪呂使君樓上夜〈一本下有「把火」二字〉看花"
      }
    ],
    "variants": [
      {
        "line": 2,
        "text": "為",
        "variant": "與",
        "source": "一作「與」"
      }
    ]
  },
  {
    "uid": "QTS_472_002_01",
    "volume": 472,
    "author": {
      "canonical": "何元上",
      "recorded": "何元上"
    },
    "title": "所居寺院涼夜書情呈上呂和叔溫郎中",
    "poem": [
      "庾公念病宜清暑，遣向僧家占上方。",
      "月光似水衣裳濕，松氣如秋枕簟涼。",
      "幸以薄才當客次，無因弱羽逐鸞翔。",
      "何由一示雲霄路，腸斷星星兩鬢霜。"
    ]
  },
  {
    "uid": "QTS_472_003_01",
    "volume": 472,
    "author": {
      "canonical": "宋濟",
      "recorded": "宋濟"
    },
    "title": "塞上聞笛",
    "poem": [
      "胡兒吹笛戍樓間，樓上蕭條海月閒。",
      "借問梅花何處落，風吹一夜滿關山。"
    ]
  },
  {
    "uid": "QTS_472_004_01",
    "volume": 472,
    "author": {
      "canonical": "宋濟",
      "recorded": "宋濟"
    },
    "title": "東鄰美人歌",
    "poem": [
      "花暖江城斜日陰，鶯啼繡戶曉雲深。",
      "春風不道珠簾隔，傳得歌聲與客心。"
    ]
  },
  {
    "uid": "QTS_472_005_01",
    "volume": 472,
    "author": {
      "canonical": "符載",
      "recorded": "符載",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Fu Zai",
      "wikidata_id": "Q18908389"
    },
    "title": "題李八百洞",
    "poem": [
      "太極之年混沌坼，此山亦是神仙宅。",
      "後世何人來飛昇，紫陽真人李八百。"
    ]
  },
  {
    "uid": "QTS_472_006_01",
    "volume": 472,
    "author": {
      "canonical": "符載",
      "recorded": "符載",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Fu Zai",
      "wikidata_id": "Q18908389"
    },
    "title": "甘州歌",
    "poem": [
      "月裏嫦娥不畵眉，只將雲霧作羅衣。",
      "不知夢逐青鸞去，猶把花枝蓋面歸。"
    ]
  },
  {
    "uid": "QTS_472_007_01",
    "volume": 472,
    "author": {
      "canonical": "符載",
      "recorded": "符載",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Fu Zai",
      "wikidata_id": "Q18908389"
    },
    "title": "句",
    "poem": [
      "綠迸穿籬筍，紅飄隔戶花。"
    ],
    "part_index": 1
  },
  {
    "uid": "QTS_472_008_01",
    "volume": 472,
    "author": {
      "canonical": "張儼",
      "recorded": "張儼"
    },
    "title": "貞元八年十二月謁先主廟絶句三首 其一",
    "poem": [
      "仗順繼皇業，併吞勢由已。",
      "天命屈雄圖，誰歌大風起。"
    ],
    "part_index": 1,
    "total_parts": 3
  },
  {
    "uid": "QTS_472_008_02",
    "volume": 472,
    "author": {
      "canonical": "張儼",
      "recorded": "張儼"
    },
    "title": "貞元八年十二月謁先主廟絶句三首 其二",
    "poem": [
      "得股肱賢明，能以奇用兵。",
      "何事傷客情，何人歸帝京。"
    ],
    "part_index": 2,
    "total_parts": 3
  },
  {
    "uid": "QTS_472_008_03",
    "volume": 472,
    "author": {
      "canonical": "張儼",
      "recorded": "張儼"
    },
    "title": "貞元八年十二月謁先主廟絶句三首 其三",
    "poem": [
      "雄名垂竹帛，荒陵壓阡陌。",
      "終古更何聞，悲風入松栢。"
    ],
    "part_index": 3,
    "total_parts": 3
  },
  {
    "uid": "QTS_472_009_01",
    "volume": 472,
    "author": {
      "canonical": "先汪",
      "recorded": "先汪"
    },
    "title": "題安樂山",
    "poem": [
      "碧峯橫倚白雲端，隋氏真人化蹟殘。",
      "翠栢不凋龍骨瘦，石泉猶在鏡光寒。"
    ],
    "notes": [
      {
        "content": "合江青溪上六七里隋劉珍登真之地有祠",
        "context": "題安樂山",
        "original_title": "題安樂山〈合江青溪上六七里隋劉珍登真之地有祠〉"
      }
    ]
  },
  {
    "uid": "QTS_472_010_01",
    "volume": 472,
    "author": {
      "canonical": "李赤",
      "recorded": "李赤"
    },
    "title": "姑熟雜詠 姑熟溪",
    "poem": [
      "愛此溪水閒，乘流興無極。",
      "擊檝怕鷗驚，垂竿待魚食。",
      "波翻曉霞影，岸疊春山色。",
      "何處浣紗人，紅顔未相識。"
    ],
    "notes": [
      {
        "content": "一作李白詩",
        "context": "姑熟雜詠",
        "original_title": "姑熟雜詠〈一作李白詩〉"
      }
    ]
  },
  {
    "uid": "QTS_472_011_01",
    "volume": 472,
    "author": {
      "canonical": "李赤",
      "recorded": "李赤"
    },
    "title": "姑熟雜詠 丹陽湖",
    "poem": [
      "湖與元氣通，風波浩難止。",
      "天外賈客歸，雲間片帆起。",
      "龜遊蓮葉上，鳥宿蘆花裏。",
      "少女棹舟歸，歌聲逐流水。"
    ]
  },
  {
    "uid": "QTS_472_012_01",
    "volume": 472,
    "author": {
      "canonical": "李赤",
      "recorded": "李赤"
    },
    "title": "姑熟雜詠 謝公宅",
    "poem": [
      "青山日將暝，寂寞謝公宅。",
      "竹裏無人聲，池中虛月白。",
      "荒庭衰草遍，廢井蒼苔積。",
      "唯有清風聞，時時起泉石。"
    ]
  },
  {
    "uid": "QTS_472_013_01",
    "volume": 472,
    "author": {
      "canonical": "李赤",
      "recorded": "李赤"
    },
    "title": "姑熟雜詠 凌敲臺",
    "poem": [
      "曠望登古臺，臺高極人目。",
      "疊嶂列遠空，閒花雜平陸。",
      "白雲入忩牖，野翆生松竹。",
      "欲覽碑上文，苔侵豈堪讀。"
    ]
  },
  {
    "uid": "QTS_472_014_01",
    "volume": 472,
    "author": {
      "canonical": "李赤",
      "recorded": "李赤"
    },
    "title": "姑熟雜詠 桓公井",
    "poem": [
      "桓公名已古，廢井曾未竭。",
      "石甃冷蒼苔，寒泉湛孤月。",
      "秋來桐暫落，春至桃還發。",
      "路遠人罕窺，誰能見清澈。"
    ]
  },
  {
    "uid": "QTS_472_015_01",
    "volume": 472,
    "author": {
      "canonical": "李赤",
      "recorded": "李赤"
    },
    "title": "姑熟雜詠 慈姥竹",
    "poem": [
      "野竹攢石生，含煙映江島。",
      "翠色落波深，虛聲帶寒早。",
      "龍吟曾未聼，鳳曲吹應好。",
      "不學蒲柳凋，貞心常自保。"
    ]
  },
  {
    "uid": "QTS_472_016_01",
    "volume": 472,
    "author": {
      "canonical": "李赤",
      "recorded": "李赤"
    },
    "title": "姑熟雜詠 望夫山",
    "poem": [
      "顒望臨碧空，怨情感離別。",
      "芳草不知愁，巖花但爭發。",
      "雲山萬重隔，音信千里絶。",
      "春去秋復來，相思幾時歇。"
    ]
  },
  {
    "uid": "QTS_472_017_01",
    "volume": 472,
    "author": {
      "canonical": "李赤",
      "recorded": "李赤"
    },
    "title": "姑熟雜詠 牛渚磯",
    "poem": [
      "絶璧臨巨川，連峰勢相向。",
      "亂石流洑間，廻波自成浪。",
      "但驚羣木秀，莫測精靈狀。",
      "更聼猿夜啼，憂心醉江上。"
    ]
  },
  {
    "uid": "QTS_472_018_01",
    "volume": 472,
    "author": {
      "canonical": "李赤",
      "recorded": "李赤"
    },
    "title": "姑熟雜詠 靈墟山",
    "poem": [
      "丁令辭世人，拂衣向仙路。",
      "伏錬九丹成，方隨五雲去。",
      "松蘿蔽幽洞，桃杏深隠處。",
      "不知曾化鶴，遼海歸幾度。"
    ]
  },
  {
    "uid": "QTS_472_019_01",
    "volume": 472,
    "author": {
      "canonical": "李赤",
      "recorded": "李赤"
    },
    "title": "姑熟雜詠 天門山",
    "poem": [
      "迥出江水上，雙峰自相對。",
      "岸映松色寒，石分浪花碎。",
      "參差遠天際，縹緲晴霞外。",
      "落日舟去遙，回首沈青靄。"
    ]
  },
  {
    "uid": "QTS_472_020_01",
    "volume": 472,
    "author": {
      "canonical": "薛𦀒",
      "recorded": "薛𦀒"
    },
    "title": "勅贈康尚書美人",
    "poem": [
      "天門喜氣曉氛氳，聖主臨軒召冠軍。",
      "欲令従此行霖雨，先賜巫山一片雲。"
    ],
    "notes": [
      {
        "content": "日知",
        "context": "勅贈康尚書",
        "original_title": "勅贈康尚書〈日知〉美人"
      }
    ]
  },
  {
    "uid": "QTS_472_021_01",
    "volume": 472,
    "author": {
      "canonical": "孫叔向",
      "recorded": "孫叔向"
    },
    "title": "將赴東都上李相國",
    "poem": [
      "四海兵初偃，平津閣正開。",
      "誰知大爐火，還有不然灰。"
    ]
  },
  {
    "uid": "QTS_472_022_01",
    "volume": 472,
    "author": {
      "canonical": "孫叔向",
      "recorded": "孫叔向"
    },
    "title": "題昭應溫泉",
    "poem": [
      "一道溫泉繞御樓，先皇曾向此中游。",
      "雖然水是無情物，也到宮前咽不流。"
    ]
  },
  {
    "uid": "QTS_472_023_01",
    "volume": 472,
    "author": {
      "canonical": "孫叔向",
      "recorded": "孫叔向"
    },
    "title": "送咸安公主",
    "poem": [
      "鹵簿遲遲出國門，漢家公主嫁烏孫。",
      "玉顔便向穹廬去，衞霍空承眀主恩。"
    ]
  },
  {
    "uid": "QTS_472_024_01",
    "volume": 472,
    "author": {
      "canonical": "劉皂",
      "recorded": "劉皂"
    },
    "title": "邊城柳",
    "poem": [
      "一株新柳色，十里斷孤城。",
      "為近東西路，長懸離別情。"
    ]
  },
  {
    "uid": "QTS_472_025_01",
    "volume": 472,
    "author": {
      "canonical": "劉皂",
      "recorded": "劉皂"
    },
    "title": "長門怨 其一",
    "poem": [
      "雨滴長門秋夜長，愁心和雨到昭陽。",
      "淚痕不學君恩斷，拭卻千行更萬行。"
    ],
    "notes": [
      {
        "content": "三首",
        "context": "長門怨",
        "original_title": "長門怨〈三首〉"
      }
    ],
