[
  {
    "uid": "QTS_760_001_01",
    "volume": 760,
    "author": {
      "canonical": "周庠",
      "recorded": "周庠"
    },
    "title": "寄禪月大師",
    "poem": [
      "昨日塵遊到幾家，就中偏省近宣麻。",
      "水田鋪座時移畫，金地譚空說盡沙。",
      "傍竹欲添犀浦石，栽松更碾味江茶。",
      "有時捻得休公卷，倚柱晤吟見落霞。"
    ]
  },
  {
    "uid": "QTS_760_002_01",
    "volume": 760,
    "author": {
      "canonical": "張格",
      "recorded": "張格",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Zhang Ge",
      "wikidata_id": "Q8070177"
    },
    "title": "寄禪月大師",
    "poem": [
      "龍華咫尺斷來音，日夕空馳詠德心。",
      "禪月字清師號別，壽春詩古帝恩深。",
      "畫成羅漢驚三界，書似張顛直萬金。",
      "莫倚名高忘故舊，曉晴閒步一相尋。"
    ]
  },
  {
    "uid": "QTS_760_003_01",
    "volume": 760,
    "author": {
      "canonical": "王鍇",
      "recorded": "王鍇",
      "gender": "male",
      "english_name": "Wang Kai",
      "wikidata_id": "Q45446445"
    },
    "title": "贈禪月大師",
    "poem": [
      "長愛吾師性自然，天心白月水中蓮。",
      "神通力遍恆沙外，詩句名高八米前。",
      "尋訪不聞朝振錫，修行唯說夜安禪。",
      "太平時節俱無事，莫惜時來話草玄。"
    ]
  },
  {
    "uid": "QTS_760_004_01",
    "volume": 760,
    "author": {
      "canonical": "牛希濟",
      "recorded": "牛希濟",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Niu Xiji",
      "wikidata_id": "Q10406211"
    },
    "title": "奉詔賦蜀主降唐",
    "poem": [
      "滿城文武欲朝天，不覺鄰師犯塞煙。",
      "唐主再懸新日月，蜀王難保舊山川。",
      "非干將相扶持拙，自是君臣數盡年。",
      "古往今來亦如此，幾曾歡笑幾澘然。"
    ]
  },
  {
    "uid": "QTS_760_005_01",
    "volume": 760,
    "author": {
      "canonical": "馮涓",
      "recorded": "馮涓",
      "gender": "male",
      "wikidata_id": "Q18909215"
    },
    "title": "蜀馱引",
    "poem": [
      "昂藏大步蠶叢國，曲頸微伸高九尺。",
      "卓女窺窗莫我知，嚴仙據案何曾識。",
      "自古皆傳蜀道難，爾何能過拔蛇山。",
      "忽驚登得雞翁磧，又恐礙著鹿頭關。"
    ]
  },
  {
    "uid": "QTS_760_006_01",
    "volume": 760,
    "author": {
      "canonical": "馮涓",
      "recorded": "馮涓",
      "gender": "male",
      "wikidata_id": "Q18909215"
    },
    "title": "句",
    "poem": [
      "不隨俗物皆成土，只待良時卻補天。",
      "釜魚化作池中物，木履浮為天際船。"
    ],
    "notes": [
      {
        "line": 2,
        "content": "《題支機石》，見《紀事》。",
        "context": "句"
      }
    ]
  },
  {
    "uid": "QTS_760_007_01",
    "volume": 760,
    "author": {
      "canonical": "李浩弼",
      "recorded": "李浩弼"
    },
    "title": "從幸秦川賦鷙獸詩",
    "poem": [
      "巖下年年自寢訛，生靈餐盡意如何。",
      "爪牙眾後民隨減，溪壑深來骨已多。",
      "天子紀綱猶被弄，客人窮獨固難過。",
      "長途莫怪無人跡，盡被山王棱殺他。"
    ]
  },
  {
    "uid": "QTS_760_008_01",
    "volume": 760,
    "author": {
      "canonical": "楊玢",
      "recorded": "楊玢"
    },
    "title": "批子弟理舊居狀",
    "poem": [
      "四鄰侵我我從伊，畢竟須思未有時。",
      "試上含元殿基望，秋風秋草正離離。"
    ],
    "notes": [
      {
        "content": "《談苑》云：「玢自蜀歸唐，長安舊居多為鄰里侵占，子弟欲詣府訴其事，以狀白玢，玢批紙尾云云，子弟不復敢言。」",
        "context": "批子弟理舊居狀",
        "original_title": "批子弟理舊居狀",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_760_009_01",
    "volume": 760,
    "author": {
      "canonical": "楊玢",
      "recorded": "楊玢"
    },
    "title": "登慈恩寺塔",
    "poem": [
      "紫雲樓下曲江平，鴉噪殘陽麥隴青。",
      "莫上慈恩最高處，不堪看又不堪聽。"
    ]
  },
  {
    "uid": "QTS_760_010_01",
    "volume": 760,
    "author": {
      "canonical": "楊玢",
      "recorded": "楊玢"
    },
    "title": "遣歌妓",
    "poem": [
      "垂老無端用意乖，誰知道侶厭清齋。",
      "如今又采蘼蕪去，辜負張君繡靸鞋。"
    ]
  },
  {
    "uid": "QTS_760_011_01",
    "volume": 760,
    "author": {
      "canonical": "韓昭",
      "recorded": "韓昭"
    },
    "title": "和題劍門",
    "poem": [
      "閉關防老寇，孰敢振威稜。",
      "險固疑天設，山河自古憑。",
      "三川奚所賴，雙劍最堪矜。",
      "鳥道微通處，煙霞鎖百層。"
    ]
  },
  {
    "uid": "QTS_760_012_01",
    "volume": 760,
    "author": {
      "canonical": "韓昭",
      "recorded": "韓昭"
    },
    "title": "從幸秦川過白衛獻詩",
    "poem": [
      "吾王巡狩為安邊，此去秦亭尚數千。",
      "夜照路岐山店火，曉通消息戍瓶煙。",
      "為雲巫峽雖神女，跨鳳秦樓是謫仙。",
      "八駿似龍人似虎，何愁飛過大漫天。"
    ]
  },
  {
    "uid": "QTS_760_013_01",
    "volume": 760,
    "author": {
      "canonical": "楊鼎夫",
      "recorded": "楊鼎夫"
    },
    "title": "記皂江墮水事",
    "poem": [
      "青城山峭皂江寒，欲度當時作等閒。",
      "棹逆狂風趨近岸，舟逢怪石碎前灣。",
      "手攜弱杖倉皇處，命出洪濤頃刻間。",
      "今日深恩無以報，令人羞記雀銜環。"
    ],
    "notes": [
      {
        "content": "鼎夫遊青城山，過皂江至中流，遇暴風。船抵巨石，覆洪濤間，同濟盡沒，獨鼎夫似有物扶助。達岸，有老人以杖接引，鼎夫未及致謝，旋失所之。因作詩以記。",
        "context": "記皂江墮水事",
        "original_title": "記皂江墮水事",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_760_014_01",
    "volume": 760,
    "author": {
      "canonical": "蔣貽恭",
      "recorded": "蔣貽恭"
    },
    "title": "題張道隱太山祠畫龍",
    "poem": [
      "世人空解競丹青，惟子通玄得墨靈。",
      "應有鬼神看下筆，豈無風雨助成形。",
      "威疑噴浪歸滄海，勢欲拏雲上杳冥。",
      "靜閉綠堂深夜後，曉來簾幕似聞腥。"
    ]
  },
  {
    "uid": "QTS_760_015_01",
    "volume": 760,
    "author": {
      "canonical": "蔣貽恭",
      "recorded": "蔣貽恭"
    },
    "title": "詠蠶",
    "poem": [
      "辛勤得繭不盈筐，燈下繅絲恨更長。",
      "著處不知來處苦，但貪衣上繡鴛鴦。"
    ]
  },
  {
