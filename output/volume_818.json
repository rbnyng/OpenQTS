      "recorded": "皎然",
      "gender": "male",
      "period": "High Tang",
      "english_name": "Jiaoran",
      "wikidata_id": "Q11644522"
    },
    "title": "送劉司法之越",
    "poem": [
      "蕭蕭鳴夜角，驅馬背城濠。",
      "雨後寒流急，秋來朔吹高。",
      "三山期望海，八月欲觀濤。",
      "幾日西陵路，應逢謝法曹。"
    ],
