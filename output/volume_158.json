    "title": "守睢陽作",
    "poem": [
      "接戰春來苦，孤城日漸危。",
      "合圍侔月暈，分手若魚麗。",
      "屢厭黃塵起，時將白羽揮。",
      "裹瘡猶出陣，飲血更登陴。",
      "忠信應難敵，堅貞諒不移。",
      "無人報天子，心計欲何施。"
    ],
    "variants": [
