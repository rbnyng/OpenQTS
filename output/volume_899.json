[
  {
    "uid": "QTS_899_001_01",
    "volume": 899,
    "author": {
      "canonical": "庾傳素",
      "recorded": "庾傳素"
    },
    "title": "木蘭花",
    "poem": [
      "木蘭紅豔多情態，不似凡花人不愛。",
      "移來孔雀檻邊栽，折向鳳凰釵上戴。",
      "是何芍藥爭風彩，自共牡丹長作對。",
      "若教為女嫁東風，除卻黃鶯難匹配。"
    ]
  },
  {
    "uid": "QTS_899_002_01",
    "volume": 899,
    "author": {
      "canonical": "劉侍讀",
      "recorded": "劉侍讀"
    },
    "title": "生查子",
    "poem": [
      "深秋更漏長，滴盡銀台燭。",
      "獨步出幽閨，月晃波澄綠。",
      "菱荷風乍觸，一對鴛鴦宿。",
      "虛棹玉釵驚，驚起還相續。"
    ]
  },
  {
    "uid": "QTS_899_003_01",
    "volume": 899,
    "author": {
      "canonical": "許岷",
      "recorded": "許岷"
    },
    "title": "木蘭花",
    "poem": [
      "小庭日晚花零落，倚戶無聊妝臉薄。",
      "寶箏金鴨任生塵，繡畫工夫全放卻。",
      "有時覷著同心結，萬恨千愁無處說。",
      "當初不合盡饒伊，贏得如今長恨別。",
      "江南日暖芭蕉展，美人折得親裁剪。",
      "書成小簡寄情人，臨行更把輕輕撚。",
      "其中撚破相思字，卻恐郎疑蹤不似。",
      "若還猜妾倩人書，誤了平生多少事。"
    ]
  },
  {
    "uid": "QTS_899_004_01",
    "volume": 899,
    "author": {
      "canonical": "林楚翹",
      "recorded": "林楚翹"
    },
    "title": "菩薩蠻",
    "poem": [
      "畫堂春晝垂珠箔，臥來揉惹金釵落。",
      "簟滑枕頭移，鬢蟬狂欲飛。",
      "笑拖嬌眼慢，羅袖籠花面。",
      "重道好郎君，人前莫惱人。"
    ]
  },
  {
    "uid": "QTS_899_005_01",
    "volume": 899,
    "author": {
      "canonical": "無名氏",
      "recorded": "無名氏",
      "gender": "male",
      "english_name": "anonymous",
      "wikidata_id": "Q4233718"
    },
    "title": "一片子",
    "poem": [
      "柳色青山映，梨花雪鳥蔵。",
      "綠窗桃李下，閑坐歎春芳。"
    ]
  },
  {
    "uid": "QTS_899_006_01",
    "volume": 899,
    "author": {
      "canonical": "無名氏",
      "recorded": "無名氏",
      "gender": "male",
      "english_name": "anonymous",
      "wikidata_id": "Q4233718"
    },
    "title": "塞姑",
    "poem": [
      "昨日盧梅塞口，整見諸人鎮守。",
      "都䕶三年不歸，折盡江邊楊柳。"
    ]
  },
  {
    "uid": "QTS_899_007_01",
    "volume": 899,
    "author": {
      "canonical": "無名氏",
      "recorded": "無名氏",
      "gender": "male",
      "english_name": "anonymous",
      "wikidata_id": "Q4233718"
    },
    "title": "醉公子",
    "poem": [
      "門外猧兒吠，知是蕭郎至。",
      "剗襪下香階，冤家今夜醉。",
      "扶得入羅幃，不肯脫羅衣。",
      "醉則從他醉，還勝獨睡時。"
    ]
  },
  {
    "uid": "QTS_899_008_01",
    "volume": 899,
    "author": {
      "canonical": "無名氏",
      "recorded": "無名氏",
      "gender": "male",
      "english_name": "anonymous",
      "wikidata_id": "Q4233718"
    },
    "title": "菩薩蠻",
    "poem": [
      "牡丹含露眞珠顆，美人折向庭前過。",
      "含笑問檀郎：花強妾貌強？",
      "檀郎故相惱：須道花枝好。",
      "一面發嬌嗔，碎挼花打人。"
    ]
  },
  {
    "uid": "QTS_899_009_01",
    "volume": 899,
    "author": {
      "canonical": "無名氏",
      "recorded": "無名氏",
      "gender": "male",
      "english_name": "anonymous",
      "wikidata_id": "Q4233718"
    },
    "title": "賀聖朝",
    "poem": [
      "白露㸃，曉星明滅，秋風落葉。",
      "故址頹垣，冷煙衰草，前朝宮闕。",
      "長安道上行客，依舊利深名切。",
      "改變容顔，消磨今古，隴頭殘月。"
    ]
  },
  {
    "uid": "QTS_899_010_01",
    "volume": 899,
    "author": {
      "canonical": "無名氏",
      "recorded": "無名氏",
      "gender": "male",
      "english_name": "anonymous",
      "wikidata_id": "Q4233718"
    },
    "title": "虞美人",
    "poem": [
      "帳中草草軍情變，月下旌旗亂。",
      "褫衣推枕愴離情，遠風吹下楚歌聲，正三更。",
      "撫騅欲下重相顧，豔態花無主。",
      "手中蓮鍔凜秋霜，九泉歸去是仙鄉，恨茫茫。"
    ]
  },
  {
    "uid": "QTS_899_011_01",
    "volume": 899,
    "author": {
      "canonical": "無名氏",
      "recorded": "無名氏",
      "gender": "male",
      "english_name": "anonymous",
      "wikidata_id": "Q4233718"
    },
    "title": "後庭宴",
    "poem": [
      "千里故鄉，十年華屋，亂魂飛過屏山簇。",
      "眼重眉褪不勝春，菱花知我銷香玉。",
      "雙雙燕子歸來，應解笑人幽獨。",
      "斷歌零舞，遺恨清江曲。",
      "萬樹綠低迷，一庭紅撲簌。"
    ]
  },
  {
    "uid": "QTS_899_012_01",
    "volume": 899,
    "author": {
      "canonical": "無名氏",
      "recorded": "無名氏",
      "gender": "male",
      "english_name": "anonymous",
      "wikidata_id": "Q4233718"
    },
    "title": "擷芳詞",
    "poem": [
      "風揺蕩，雨濛茸，翠條柔弱花頭重。",
      "春衫窄，香肌濕。",
      "記得年時，共伊曾摘。",
      "都如夢，何曾共，可憐孤似釵頭鳯。",
      "關山隔，晩雲碧。",
      "燕兒來也，又無消息。"
    ]
  },
  {
    "uid": "QTS_899_013_01",
    "volume": 899,
    "author": {
      "canonical": "無名氏",
      "recorded": "無名氏",
      "gender": "male",
      "english_name": "anonymous",
      "wikidata_id": "Q4233718"
    },
    "title": "魚遊春水",
    "poem": [
      "秦樓東風裏，燕子還來尋舊壘。",
      "餘寒猶峭，紅日薄侵羅綺。",
      "嫩草方抽碧玉茵，媚柳輕窣黃金縷。",
      "鶯轉上林，魚遊春水。",
      "㡬曲闌干遍倚，又是一番新桃李。",
      "佳人應怪歸遲，梅妝涙洗。",
      "鳯簫聲絶沈孤雁，望斷清波無雙鯉。",
      "雲山萬重，寸心千里。"
    ]
  },
  {
    "uid": "QTS_899_014_01",
    "volume": 899,
    "author": {
      "canonical": "楊玉環",
