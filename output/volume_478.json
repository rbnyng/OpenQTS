        "variant": "鴛鴦",
        "source": "一作「鴛鴦」"
      },
      {
        "line": 1,
        "text": "輕",
        "variant": "馨",
        "source": "一作「馨」"
      }
    ]
  },
  {
    "uid": "QTS_478_009_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "簾",
    "poem": [
      "勞將素手捲蝦鬚，瓊室流光更綴珠。",
      "玉漏報來過半夜，可憐潘岳立踟躕。"
    ]
  },
  {
    "uid": "QTS_478_010_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "階",
    "poem": [
      "甃玉編金次第平，花紋隱起踏無聲。",
      "幾重便上華堂裏，得見天人吹鳳笙。"
    ]
  },
  {
    "uid": "QTS_478_011_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "扇",
    "poem": [
      "寳扇持來入禁宮，本教花下動香風。",
      "姮娥須逐彩雲降，不可通宵在月中。"
    ]
  },
  {
    "uid": "QTS_478_012_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "解內人嘲",
    "poem": [
      "粉面仙郎選聖朝，偶逢秦女學吹簫。",
      "須教翡翠聞王母，不奈烏鳶噪鵲橋。"
    ],
    "notes": [
      {
        "content": "時內人以暢吳音嘲之，暢才捷，作詩酬，詩云雲",
        "context": "解內人嘲",
        "original_title": "解內人嘲〈時內人以暢吳音嘲之，暢才捷，作詩酬，詩云雲〉"
      }
    ]
  },
  {
    "uid": "QTS_478_013_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "成都贈別席䕫",
    "poem": [
      "不值分流二江水，定應猶得且同行。",
      "三千里外情人別，更被子規啼數聲。"
    ]
  },
  {
    "uid": "QTS_478_014_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "逰城東王駙馬亭",
    "poem": [
      "城外無塵水間松，秋天木落見山容。",
      "共尋蕭史江亭去，一望終南紫閣峰。"
    ]
  },
  {
    "uid": "QTS_478_015_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "望毛女峰",
    "poem": [
      "我種東峰千葉蓮，此峯毛女始求仙。",
      "今朝暗筭當時事，已是人間七萬年。"
    ]
  },
  {
    "uid": "QTS_478_016_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "送李山人歸山",
    "poem": [
      "來從千山萬山裏，歸向千山萬山去。",
      "山中白雲千萬重，卻望人間不知處。"
    ]
  },
  {
    "uid": "QTS_478_017_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "長安新晴",
    "poem": [
      "九重深淺人不知，金殿玉樓倚朝日。",
      "一夜城中新雨晴，御溝流得宮花出。"
    ]
  },
  {
    "uid": "QTS_478_018_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "出藍田關寄董使君",
    "poem": [
      "萬里煙蘿錦悵間，雲迎水送度藍關。",
      "七盤九折難行處，盡是龔黃界外山。"
    ]
  },
  {
    "uid": "QTS_478_019_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "題悟公禪堂",
    "poem": [
      "臨壇付法十三春，家本長城若下人。",
      "芸閣少年應不識，南山鈔主是前身。"
    ]
  },
  {
    "uid": "QTS_478_020_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "宿陜府北樓奉酬崔大夫二首 其一",
    "poem": [
      "樓壓黃河山滿坐，風清水涼誰忍臥。",
      "人定軍州禁漏傳，不妨秋月城頭過。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_478_020_02",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "宿陜府北樓奉酬崔大夫二首 其二",
    "poem": [
      "一別朱門三四春，再來應笑尚風塵。",
      "昨宵唯有樓前月，識是謝公詩酒人。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_478_021_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "陜州逢竇鞏同宿寄江陵韋協律",
    "poem": [
      "共出丘門歲九霜，相逢悽愴對離觴。",
      "荊南為報韋從事，一宿同眠御史牀。"
    ]
  },
  {
    "uid": "QTS_478_022_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "夜到泗州酬崔使君",
    "poem": [
      "徐城洪盡到淮頭，月裏山河見泗州。",
      "聞道泗濱清廟磬，雅聲今在謝家樓。"
    ]
  },
  {
    "uid": "QTS_478_023_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "送崔員外使回入京金鉤驛逢因贈",
    "poem": [
      "六星宮裏一星歸，行到金鉤近紫微。",
      "侍史別來經歲月，今宵應夢䕶香衣。"
    ],
    "notes": [
      {
        "content": "一本無下六字",
        "context": "鉤驛逢因贈",
        "original_title": "送崔員外使回入京金鉤驛逢因贈〈一本無下六字〉"
      }
    ]
  },
  {
    "uid": "QTS_478_024_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "成都送別費冠卿",
    "poem": [
      "紅椒花落桂花開，萬里同逰俱未回。",
      "莫厭客中頻送客，思鄉獨上望鄉臺。"
    ]
  },
  {
    "uid": "QTS_478_025_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "題商山廟",
    "poem": [
      "商洛秦時四老翁，人傳羽化此山空。",
      "若無仙眼何由見，總在廟前花洞中。"
    ]
  },
  {
    "uid": "QTS_478_026_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "題獨孤少府園林",
    "poem": [
      "四面青山是四隣，煙霞成伴草成茵。",
      "年年洞口桃花發，不記曾經迷㡬人。"
    ]
  },
  {
    "uid": "QTS_478_027_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "送獨孤秀才下第歸太白山",
    "poem": [
      "逸翮暫時成落羽，將歸太白賞靈蹤。",
      "須尋最近碧霄處，擬倩和雲買一峯。"
    ]
  },
  {
    "uid": "QTS_478_028_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "下第後病中",
    "poem": [
      "獻玉頻年命未通，窮秋成病悟真空。",
      "笑看朝市趨名者，不病那知在病中。"
    ]
  },
  {
    "uid": "QTS_478_029_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "送深上人歸江南",
    "poem": [
      "留得蓮花偈付誰，獨攜金䇿欲歸時。",
      "江南無限蕭家寺，曾與白雲何處期。"
    ]
  },
  {
    "uid": "QTS_478_030_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "題自然觀",
    "poem": [
      "劍閣門西第一峯，道陵成道有高蹤。",
      "行人若上升仙處，須撥白雲三四重。"
    ]
  },
  {
    "uid": "QTS_478_031_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "疾愈步庭花",
    "poem": [
      "桃紅李白覺春歸，強步閒庭力尚微。",
      "從困不扶靈壽杖，恐驚花裏早鶯飛。"
    ]
  },
  {
    "uid": "QTS_478_032_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "籌筆店江亭",
    "poem": [
      "九折巖邊下馬行，江亭暫歇聽江聲。",
      "白雲綠樹不關我，枉與樵人樂一生。"
    ]
  },
  {
    "uid": "QTS_478_033_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "贈賀若少府",
    "poem": [
      "十日廣陵城裏住，聽君花下撫金徽。",
      "新聲指上懷中紙，莫怪潛偷數曲歸。"
    ]
  },
  {
    "uid": "QTS_478_034_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "太子劉舍人邀看花",
    "poem": [
      "年少風流七品官，朱衣白馬冶遊盤。",
      "負心不報春光主，幾處偷看紅牡丹。"
    ]
  },
  {
    "uid": "QTS_478_035_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "薔薇花",
    "poem": [
      "錦窠花朶燈叢醉，翠葉眉稠裛露垂。",
      "莫引美人來架下，恐驚紅片落燕支。"
    ]
  },
  {
    "uid": "QTS_478_036_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "句",
    "poem": [
      "蜀道易，易於履平地。"
    ],
    "part_index": 1
  },
  {
    "uid": "QTS_478_037_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "句",
    "poem": [
      "蟬噪入雲樹，風開無主花。"
    ],
    "part_index": 1
  }
]