[
  {
    "uid": "QTS_478_001_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "雲安公主下降奉詔作催粧詩",
    "poem": [
      "雲安公主貴，出嫁五侯家。",
      "天母親調粉，日兄憐賜花。",
      "催鋪百子帳，待障七香車。",
      "借問妝成未，東方欲曉霞。"
    ],
    "notes": [
      {
        "content": "一本無此六字",
        "context": "安公主下降",
        "original_title": "雲安公主下降〈一本無此六字〉奉詔作催粧詩〈順宗女下嫁劉士涇百僚舉暢為儐相〉"
      },
      {
        "content": "順宗女下嫁劉士涇百僚舉暢為儐相",
        "context": "詔作催粧詩",
        "original_title": "雲安公主下降〈一本無此六字〉奉詔作催粧詩〈順宗女下嫁劉士涇百僚舉暢為儐相〉"
      }
    ]
  },
  {
    "uid": "QTS_478_002_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "山出雲",
    "poem": [
      "靈山蓄雲彩，紛郁出清晨。",
      "望樹繁花白，看峰小雪新。",
      "映松張蓋影，依澗布魚鱗。",
      "高似從龍處，低如觸石頻。",
      "濃光藏半岫，淺色類飄塵。",
      "玉葉開天際，遙憐占早春。"
    ]
  },
  {
    "uid": "QTS_478_003_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "驚雪",
    "poem": [
      "怪得北風急，前庭如月輝。",
      "天人寧許巧，翦水作花飛。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "許",
        "variant": "底",
        "source": "一作「底」"
      }
    ]
  },
  {
    "uid": "QTS_478_004_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "聞早蟬",
    "poem": [
      "落日早蟬急，客心聞更愁。",
      "一聲來枕上，夢裏故園秋。"
    ]
  },
  {
    "uid": "QTS_478_005_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "別劉端公",
    "poem": [
      "連騎出都門，秋蟬噪高柳。",
      "落日辭故人，自醉不闗酒。"
    ]
  },
  {
    "uid": "QTS_478_006_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "新晴愛月",
    "poem": [
      "野性平生惟愛月，新晴半夜覩嬋娟。",
      "起來自擘紗窗破，恰漏清光落枕前。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "愛",
        "variant": "好",
        "source": "一作「好」"
      },
      {
        "line": 2,
        "text": "恰",
        "variant": "教",
        "source": "一作「教」"
      }
    ]
  },
  {
    "uid": "QTS_478_007_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "雲安公主出降雜詠催妝二首 其一",
    "poem": [
      "天上瓊花不避秋，今宵織女嫁牽牛。",
      "萬人惟待乘鸞出，乞巧齊登眀月樓。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_478_007_02",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "雲安公主出降雜詠催妝二首 其二",
    "poem": [
      "少妝銀粉飾金鈿，端正天花貴自然。",
      "聞道禁中時節異，九秋香滿鏡臺前。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_478_008_01",
    "volume": 478,
    "author": {
      "canonical": "陸暢",
      "recorded": "陸暢"
    },
    "title": "坐障",
    "poem": [
      "白玉爲竿丁字成，黃金繡帶短長輕。",
      "強遮天上花顏色，不隔雲中語笑聲。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "白",
        "variant": "碧",
