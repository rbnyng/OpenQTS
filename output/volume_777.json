    ]
  },
  {
    "uid": "QTS_777_017_01",
    "volume": 777,
    "author": {
      "canonical": "朱晦",
      "recorded": "朱晦"
    },
    "title": "秋日送別",
    "poem": [
      "荒郊古陌時時斷，野水浮雲處處秋。",
      "唯有河邊衰柳樹，蟬聲相送到揚州。"
    ]
  },
  {
    "uid": "QTS_777_018_01",
    "volume": 777,
    "author": {
      "canonical": "石召",
      "recorded": "石召"
    },
    "title": "送人歸山",
    "poem": [
      "相逢唯道在，誰不共知貧。",
      "歸路分殘雨，停舟別故人。",
      "霜明松嶺曉，花暗竹房春。",
      "亦有棲閒意，何年可寄身。"
    ]
  },
  {
    "uid": "QTS_777_019_01",
    "volume": 777,
    "author": {
      "canonical": "石召",
      "recorded": "石召"
    },
    "title": "早行遇雪",
    "poem": [
      "荒郊昨夜雪，羸馬又須行。",
      "四顧無人跡，雞鳴第一聲。"
    ]
  },
  {
    "uid": "QTS_777_020_01",
    "volume": 777,
    "author": {
      "canonical": "林珝",
      "recorded": "林珝"
    },
    "title": "送安養閻主簿還竹寺",
    "poem": [
      "分手怨河梁，南征厯漢陽。",
      "江山追宋玉，雲雨夢襄王。",
      "醉裏宜城近，歌中郢路長。",
      "更尋棲枳處，猶是念仇香。"
    ]
  },
  {
    "uid": "QTS_777_021_01",
    "volume": 777,
    "author": {
      "canonical": "衛葉",
      "recorded": "衛葉"
    },
    "title": "晚投南村",
    "poem": [
      "客行逢日暮，原野散秋暉。",
      "南陌人初斷，西林鳥盡歸。",
      "暗蓬沙上轉，寒葉月中飛。",
      "村落無多在，聲聲近擣衣。"
    ]
  }
]