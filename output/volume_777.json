[
  {
    "uid": "QTS_777_001_01",
    "volume": 777,
    "author": {
      "canonical": "邢象玉",
      "recorded": "邢象玉"
    },
    "title": "古意",
    "poem": [
      "家中酒新熟，園裏葉初榮。",
      "佇杯欲取醉，悒然思友生。",
      "忽聞有奇客，何姓復何名。",
      "嗜酒陶彭澤，能琴阮步兵。",
      "何須問寒暑，徑共坐山亭。",
      "舉袂祛啼鳥，揚巾掃落英。",
      "心神無俗累，歌詠有新聲。",
      "新聲是何曲，滄浪之水清。"
    ]
  },
  {
    "uid": "QTS_777_002_01",
    "volume": 777,
    "author": {
      "canonical": "張敬徽",
      "recorded": "張敬徽"
    },
    "title": "採蓮曲",
    "poem": [
      "遊女泛江晴，蓮紅水復清。",
      "競多愁日暮，爭疾畏船傾。",
      "波動疑釵落，風生覺袖輕。",
      "相看未盡意，歸浦櫂歌聲。"
    ]
  },
  {
    "uid": "QTS_777_003_01",
    "volume": 777,
    "author": {
      "canonical": "徐玄之",
      "recorded": "徐玄之"
    },
    "title": "采蓮",
    "poem": [
      "越艷荊姝慣采蓮，蘭橈畫檝滿長川。",
      "秋來江上澄如練，映水紅妝如可見。",
      "此時蓮浦珠翠光，此日荷風羅綺香。",
      "纖手周遊不暫息，紅英爛熳殊未極。",
      "夕鳥棲林人慾稀，長歌哀怨采蓮歸。"
    ]
  },
  {
    "uid": "QTS_777_004_01",
    "volume": 777,
    "author": {
      "canonical": "郭汭",
      "recorded": "郭汭"
    },
    "title": "同崔員外溫泉宮即事",
    "poem": [
      "輦輅移雙闕，宸游整六師。",
      "天迴紫微座，日轉羽林旗。",
      "雷氣寒戈戟，軍容壯武貔。",
      "弓鳴射雁處，泉暖躍龍時。",
      "惠化成觀俗，謳謠入賦詩。",
      "同歡王道盛，相與詠雍熙。"
    ]
  },
  {
    "uid": "QTS_777_005_01",
    "volume": 777,
    "author": {
      "canonical": "權徹",
      "recorded": "權徹"
    },
    "title": "題沈黎城",
    "poem": [
      "蘇子臥北海，馬翁渡南洲。",
      "跡恨事乃立，功達名遂休。",
      "夜聞羽書至，召募此邊州。",
      "鐵騎耀楚甲，玉匣橫吳鉤。",
      "雪厚羣山凍，蓬飛荒塞秋。",
      "久戍曷辭苦，數戰期封侯。",
      "不學豎儒輩，談經空白頭。"
    ]
  },
  {
    "uid": "QTS_777_006_01",
    "volume": 777,
    "author": {
      "canonical": "豆盧回",
      "recorded": "豆盧回"
    },
    "title": "登樂游原懷古",
    "poem": [
      "緬惟漢宣帝，初謂皇曾孫。",
      "雖在繈褓中，亦遭巫蠱冤。",
      "至哉丙廷尉，感激義彌敦。",
      "馳逐蓮勺道，出入諸陵門。",
      "一朝風雲會，竟登天位尊。",
      "握符升寶曆，負扆御華軒。",
      "赫奕文物備，葳蕤休瑞繁。",
      "卒為中興主，垂名於後昆。",
      "雄圖奄已謝，餘址空復存。",
      "昔為樂游苑，今為狐兔園。",
      "朝見牧豎集，夕聞棲鳥喧。",
      "蕭條灞亭岸，寂寞杜陵原。",
      "冪�野煙起，蒼茫嵐氣昏。",
      "二曜屢回薄，四時更涼溫。",
      "天道尚如此，人理安可論。"
    ]
  },
  {
    "uid": "QTS_777_007_01",
    "volume": 777,
    "author": {
      "canonical": "張南容",
      "recorded": "張南容"
    },
    "title": "靜女歌",
    "poem": [
      "靜女樂於靜，動合古人則。",
      "妙年工詩書，弱歲勤組織。",
      "端居愁若癡，誰復理容色。",
      "十五坐幽閨，四鄰不相識。",
      "夭夭鄰家子，百花裝首飾。",
      "日月淇上游，笑人不踰閾。",
      "河水自濁濟自清，仙臺蛾眉秦鏡明。",
      "為照齊王門下醜，何如漢帝掌中輕。"
    ]
  },
  {
    "uid": "QTS_777_008_01",
    "volume": 777,
    "author": {
      "canonical": "沈徽",
      "recorded": "沈徽"
    },
    "title": "古興二首 其一",
    "poem": [
      "蔓草自細微，女蘿始夭夭。",
      "夤緣至百尺，榮耀非一朝。",
      "敷色高碧嶺，流芳薄丹霄。",
      "如何摧秀木，正為餘波漂。",
      "莖葉落巖跡，英蕤從風飆。",
      "洪柯不足恃，況乃託陵苕。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_777_008_02",
    "volume": 777,
    "author": {
      "canonical": "沈徽",
      "recorded": "沈徽"
    },
    "title": "古興二首 其二",
    "poem": [
      "長安富豪右，信是天下樞。",
      "戚里笙歌發，禁門冠蓋趨。",
      "攀雲無醜士，唾地盡成珠。",
      "日晏下雙闕，煙花亂九衢。",
      "恩榮在片言，零落亦須臾。",
      "何意還自及，曲池今已蕪。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_777_009_01",
    "volume": 777,
    "author": {
      "canonical": "林琨",
      "recorded": "林琨",
