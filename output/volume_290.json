      "recorded": "楊凝",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yang Ning",
      "wikidata_id": "Q11100355"
    },
    "title": "詠雨",
    "poem": [
      "塵浥多人路，泥歸足燕家。",
      "可憐繚亂點，濕盡滿宮花。"
    ]
  },
  {
    "uid": "QTS_290_014_01",
    "volume": 290,
    "author": {
      "canonical": "楊凝",
      "recorded": "楊凝",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yang Ning",
      "wikidata_id": "Q11100355"
    },
    "title": "柳絮",
    "poem": [
      "河畔多楊柳，追遊盡狹斜。",
      "春風一回送，亂入莫愁家。"
    ]
  },
  {
    "uid": "QTS_290_015_01",
    "volume": 290,
    "author": {
      "canonical": "楊凝",
      "recorded": "楊凝",
      "gender": "male",
