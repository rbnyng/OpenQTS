      "recorded": "劉禹錫",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Liu Yuxi",
      "wikidata_id": "Q706837"
    },
    "title": "秋夕不寐寄樂天",
    "poem": [
      "洞戶夜簾卷。",
      "華堂秋簟清。",
      "螢飛過池影。",
      "蛩思繞階聲。",
      "老枕知將雨。",
      "高窗報欲明。",
      "何人諳此景。",
      "遠問白先生。"
    ]
  },
  {
    "uid": "QTS_358_005_01",
    "volume": 358,
    "author": {
      "canonical": "劉禹錫",
      "recorded": "劉禹錫",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Liu Yuxi",
      "wikidata_id": "Q706837"
    },
    "title": "冬日晨興寄樂天",
    "poem": [
      "庭樹曉禽動。",
      "郡樓殘點聲。",
      "燈挑紅燼落。",
      "酒煖白光生。",
      "髪少嫌梳利。",
      "顏哀恨鏡明。",
      "獨吟誰應和。",
      "須寄洛陽城。"
    ]
  },
  {
    "uid": "QTS_358_006_01",
    "volume": 358,
    "author": {
      "canonical": "劉禹錫",
      "recorded": "劉禹錫",
