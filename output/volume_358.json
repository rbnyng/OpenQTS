    },
    "title": "和重題",
    "poem": [
      "林端落照盡。",
      "湖上遠嵐清。",
      "水榭芝蘭室。",
      "仙舟魚鳥情。",
      "人琴久寂寞。",
      "煙月若平生。",
      "一泛釣璜處。",
      "再吟鏘玉聲。"
    ]
  },
  {
    "uid": "QTS_358_060_01",
    "volume": 358,
    "author": {
