      "recorded": "劉禹錫",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Liu Yuxi",
      "wikidata_id": "Q706837"
    },
    "title": "酬令狐相公杏園花下飮有懷見寄",
    "poem": [
      "年年曲江望。",
      "花發卽經過。",
      "未飲心先醉。",
      "臨風思倍多。",
      "三春看又盡。",
      "兩地欲如何。",
      "日望長安道。",
      "空成勞者歌。"
    ]
  },
  {
    "uid": "QTS_358_030_01",
    "volume": 358,
    "author": {
