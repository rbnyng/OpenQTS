      "recorded": "劉禹錫",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Liu Yuxi",
      "wikidata_id": "Q706837"
    },
    "title": "秋日書懷寄白賓客",
    "poem": [
      "州遠雄無益。",
      "年高健亦衰。",
      "興情逢酒在。",
      "筋力上樓知。",
      "蟬噪芳意盡。",
      "雁來愁望時。",
      "商山紫芝客。",
      "應不向秋悲。"
    ]
  },
  {
    "uid": "QTS_358_010_01",
    "volume": 358,
    "author": {
      "canonical": "劉禹錫",
      "recorded": "劉禹錫",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Liu Yuxi",
      "wikidata_id": "Q706837"
    },
    "title": "酬樂天初冬早寒見寄",
    "poem": [
      "乍起衣猶冷。",
      "微吟帽半欹。",
      "霜凝南屋瓦。",
      "雞唱後園枝。",
      "洛水碧雲曉。",
      "吳宮黃葉時。",
      "兩傳千里意。",
      "書札不如詩。"
    ]
  },
  {
    "uid": "QTS_358_011_01",
    "volume": 358,
    "author": {
