      "english_name": "Liu Yuxi",
      "wikidata_id": "Q706837"
    },
    "title": "有感",
    "poem": [
      "死且不自覺。",
      "其餘安可論。",
      "昨宵鳳池客。",
      "今日雀羅門。",
      "騎吏塵未息。",
      "銘旌風已翻。",
      "平生紅粉愛。",
      "惟解哭黃昏。"
    ]
  },
