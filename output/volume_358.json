    },
    "title": "題報恩寺",
    "poem": [
      "雲外支硎寺。",
      "名聲敵虎丘。",
      "石文留馬跡。",
      "峯勢聳牛頭。",
      "泉眼潛通海。",
      "松門預帶秋。",
      "遲回好風景。",
      "王謝昔曾遊。"
    ]
  },
