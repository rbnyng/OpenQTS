  {
    "uid": "QTS_690_009_06",
    "volume": 690,
    "author": {
      "canonical": "王渙",
      "recorded": "王渙"
    },
    "title": "惆悵詩十二首 其六",
    "poem": [
      "夜寒春病不勝懷，玉瘦花啼萬事乖。",
      "薄倖檀郎斷芳信，驚嗟猶夢合歡鞋。"
    ],
    "part_index": 6,
    "total_parts": 12
  },
  {
    "uid": "QTS_690_009_07",
    "volume": 690,
    "author": {
      "canonical": "王渙",
      "recorded": "王渙"
    },
    "title": "惆悵詩十二首 其七",
    "poem": [
      "嗚咽離聲管吹秋，妾身今日為君休。",
      "齊奴不說平生事，忍看花枝謝玉樓。"
    ],
    "part_index": 7,
    "total_parts": 12
  },
  {
    "uid": "QTS_690_009_08",
    "volume": 690,
    "author": {
      "canonical": "王渙",
      "recorded": "王渙"
    },
    "title": "惆悵詩十二首 其八",
    "poem": [
      "青絲一綹墮雲鬟，金剪刀鳴不忍看。",
      "持謝君王寄幽怨，可能從此住人間。"
    ],
    "part_index": 8,
    "total_parts": 12
  },
  {
    "uid": "QTS_690_009_09",
    "volume": 690,
    "author": {
      "canonical": "王渙",
      "recorded": "王渙"
    },
    "title": "惆悵詩十二首 其九",
    "poem": [
      "陳宮興廢事難期，三閣空餘綠草基。",
      "狎客淪亡麗華死，他年江令獨來時。"
    ],
    "part_index": 9,
    "total_parts": 12
  },
  {
    "uid": "QTS_690_009_10",
    "volume": 690,
    "author": {
      "canonical": "王渙",
      "recorded": "王渙"
    },
    "title": "惆悵詩十二首 其十",
    "poem": [
      "晨肇重來路已迷，碧桃花謝武陵溪。",
      "仙山目斷無尋處，流水潺湲日漸西。"
    ],
    "part_index": 10,
    "total_parts": 12
  },
  {
    "uid": "QTS_690_009_11",
    "volume": 690,
    "author": {
      "canonical": "王渙",
      "recorded": "王渙"
    },
    "title": "惆悵詩十二首 其十一",
    "poem": [
      "少卿降北子卿還，朔野離觴慘別顏。",
      "卻到茂陵唯一慟，節毛零落鬢毛斑。"
    ],
    "part_index": 11,
    "total_parts": 12
  },
  {
    "uid": "QTS_690_009_12",
    "volume": 690,
    "author": {
      "canonical": "王渙",
      "recorded": "王渙"
    },
    "title": "惆悵詩十二首 其十二",
    "poem": [
      "夢裏分明入漢宮，覺來燈背錦屏空。",
      "紫臺月落闗山曉，腸斷君恩信畫工。"
    ],
    "part_index": 12,
    "total_parts": 12
  },
  {
    "uid": "QTS_690_010_01",
    "volume": 690,
    "author": {
      "canonical": "戴司顏",
      "recorded": "戴司顏"
    },
    "title": "江上雨",
    "poem": [
      "非不欲前去，此情非自由。",
      "星辰照何處，風雨送涼秋。",
      "寒鎖空江夢，聲隨黃葉愁。",
      "蕭蕭猶未已，早晚去蘋洲。"
    ]
  },
  {
    "uid": "QTS_690_011_01",
    "volume": 690,
    "author": {
      "canonical": "戴司顏",
      "recorded": "戴司顏"
    },
    "title": "塞上",
    "poem": [
      "空蹟晝蒼茫，沙腥古戰場。",
      "逢春多霰雪，生計在牛羊。",
      "冷角吹鄉淚，乾榆落夢牀。",
      "從來山水客，誰謂到漁陽？"
    ]
  },
  {
    "uid": "QTS_690_012_01",
    "volume": 690,
    "author": {
      "canonical": "戴司顏",
      "recorded": "戴司顏"
    },
    "title": "句",
    "poem": [
      "遠來朝鳳闕，歸去戀元侯。",
      "[3]"
    ]
  },
  {
    "uid": "QTS_690_013_01",
    "volume": 690,
    "author": {
      "canonical": "吳仁璧",
      "recorded": "吳仁璧"
    },
    "title": "投謝錢武肅",
    "poem": [
      "東門上相好知音，數盡臺前郭隗金。",
      "累重雖然容食椹，力微無計報焚林。",
      "弊貂不稱芙蓉幕，衰朽仍慚玳瑁簪。",
      "十里溪光一山月，可堪從此負歸心。"
    ]
  },
  {
    "uid": "QTS_690_014_01",
    "volume": 690,
    "author": {
      "canonical": "吳仁璧",
      "recorded": "吳仁璧"
    },
    "title": "客路",
    "poem": [
      "人寰急景如波委，客路浮雲似蓋輕。",
      "回首故山天外碧，十年無計卻歸耕。"
    ]
  },
  {
    "uid": "QTS_690_015_01",
    "volume": 690,
    "author": {
      "canonical": "吳仁璧",
      "recorded": "吳仁璧"
    },
    "title": "南徐題友人郊居",
    "poem": [
      "門前樵徑連江寺，岸下漁磯繫海槎。",
      "待到秋深好時節，與君長醉隱侯家。"
    ]
  },
  {
    "uid": "QTS_690_016_01",
    "volume": 690,
    "author": {
      "canonical": "吳仁璧",
      "recorded": "吳仁璧"
    },
    "title": "讀度人經寄鄭仁表",
    "poem": [
      "身雖一旦塵中老，名擬三清會裏題。",
      "二午九齋餘日在，請君相伴醉如泥。"
    ]
  },
  {
    "uid": "QTS_690_017_01",
    "volume": 690,
    "author": {
      "canonical": "吳仁璧",
      "recorded": "吳仁璧"
    },
    "title": "秋日聽僧彈琴",
    "poem": [
      "金徽玉軫韻泠然，言下浮生指下泉。",
      "恰稱秋風西北起，一時吹入碧湘煙。"
    ]
  },
  {
    "uid": "QTS_690_018_01",
    "volume": 690,
    "author": {
      "canonical": "吳仁璧",
      "recorded": "吳仁璧"
    },
    "title": "賈誼",
    "poem": [
      "扶持一疏滿遺編，漢陛前頭正少年。",
      "誰道恃才輕絳灌，卻將惆悵弔湘川。"
    ]
  },
  {
    "uid": "QTS_690_019_01",
    "volume": 690,
    "author": {
      "canonical": "吳仁璧",
      "recorded": "吳仁璧"
    },
    "title": "春雪",
    "poem": [
      "雪霽凝光入坐寒，天明猶自臥袁安。",
      "貂裘穿後鶴氅敝，自此風流不足看。"
    ]
  },
  {
    "uid": "QTS_690_020_01",
    "volume": 690,
    "author": {
      "canonical": "吳仁璧",
      "recorded": "吳仁璧"
    },
    "title": "衰柳",
    "poem": [
      "金風漸利露珠團，廣陌長堤黛色殘。",
      "水殿狂遊隋煬帝，一千餘里可堪看。"
    ]
  },
  {
    "uid": "QTS_690_021_01",
    "volume": 690,
    "author": {
      "canonical": "吳仁璧",
      "recorded": "吳仁璧"
    },
    "title": "鳳仙花",
    "poem": [
      "香紅嫩綠正開時，冷蝶飢蜂兩不知。",
      "此際最宜何處看？朝陽初上碧梧枝。"
    ]
  },
  {
    "uid": "QTS_690_022_01",
    "volume": 690,
    "author": {
      "canonical": "吳仁璧",
      "recorded": "吳仁璧"
    },
    "title": "金錢花",
    "poem": [
      "淺絳濃香幾朶勻，日鎔金鑄萬家新。",
      "堪疑劉寵遺芳在，不許山陰父老貧。"
    ]
  },
  {
    "uid": "QTS_690_023_01",
    "volume": 690,
    "author": {
      "canonical": "吳仁璧",
      "recorded": "吳仁璧"
    },
    "title": "錢塘鶴",
    "poem": [
      "人間路靄青天半，鼇岫雲生碧海涯。",
      "雖抱雕籠密扃鑰，可能長在叔倫家。"
    ]
  },
  {
    "uid": "QTS_690_024_01",
    "volume": 690,
    "author": {
      "canonical": "吳仁璧",
      "recorded": "吳仁璧"
    },
    "title": "句",
    "poem": [
