  },
  {
    "uid": "QTS_690_009_03",
    "volume": 690,
    "author": {
      "canonical": "王渙",
      "recorded": "王渙"
    },
    "title": "惆悵詩十二首 其三",
    "poem": [
      "謝家池館花籠月，蕭寺房廊竹颭風。",
      "夜半酒醒憑檻立，所思多在別離中。"
    ],
    "part_index": 3,
    "total_parts": 12
  },
  {
    "uid": "QTS_690_009_04",
    "volume": 690,
    "author": {
      "canonical": "王渙",
      "recorded": "王渙"
    },
    "title": "惆悵詩十二首 其四",
    "poem": [
      "隋師戰艦欲亡陳，國破應難保此身。",
      "訣別徐郎淚如雨，鏡鸞分後屬何人？"
    ],
    "part_index": 4,
    "total_parts": 12
  },
  {
    "uid": "QTS_690_009_05",
    "volume": 690,
    "author": {
      "canonical": "王渙",
      "recorded": "王渙"
    },
    "title": "惆悵詩十二首 其五",
    "poem": [
      "七夕瓊筵隨事陳，兼花連蒂共傷神。",
      "蜀王殿裏三更月，不見驪山私語人。"
    ],
