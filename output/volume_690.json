      }
    ]
  },
  {
    "uid": "QTS_690_006_01",
    "volume": 690,
    "author": {
      "canonical": "王駕",
      "recorded": "王駕"
    },
    "title": "過故友居",
    "poem": [
      "鄰笛寒吹日落初，舊居今已別人居。",
      "亂來兒姪皆分散，惆悵僧房認得書。"
    ]
  },
  {
    "uid": "QTS_690_007_01",
    "volume": 690,
    "author": {
      "canonical": "王渙",
      "recorded": "王渙"
    },
    "title": "上裵侍郎",
    "poem": [
      "青衿七十牓三年，建禮含香次第遷。",
      "珠彩下連星錯落，桂花曾對月嬋娟。",
      "玉經磨琢多成器，劍拔沈埋更倚天。",
      "應念銜恩最深者，春來為壽拜尊前。"
    ]
  },
  {
    "uid": "QTS_690_008_01",
    "volume": 690,
    "author": {
      "canonical": "王渙",
      "recorded": "王渙"
    },
    "title": "悼亡",
    "poem": [
      "春來得病夏來加，深掩粧窗臥碧紗。",
      "為怯暗藏秦女扇，怕驚愁度阿香車。",
      "腰肢暗想風欺柳，粉態難忘露洗花。",
      "今日青門葬君處，亂蟬衰草夕陽斜。"
    ]
  },
  {
    "uid": "QTS_690_009_01",
    "volume": 690,
    "author": {
      "canonical": "王渙",
      "recorded": "王渙"
    },
    "title": "惆悵詩十二首 其一",
    "poem": [
      "八蠶薄絮鴛鴦綺，半夜佳期並枕眠。",
      "鐘動紅娘喚歸去，對人勻淚拾金鈿。"
    ],
    "part_index": 1,
    "total_parts": 12
  },
  {
