[
  {
    "uid": "QTS_767_001_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "吳 黃金車",
    "poem": [
      "分擘山河即漸開，許昌基業已傾頹。",
      "黃金車與斑斕耳，早個須知入讖來。"
    ]
  },
  {
    "uid": "QTS_767_002_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "吳 赤壁",
    "poem": [
      "會獵書來舉國驚，只應周魯不教迎。",
      "曹公一戰奔波後，赤壁功傳萬古名。"
    ]
  },
  {
    "uid": "QTS_767_003_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "吳 魯肅指囷",
    "poem": [
      "破產移家事亦難，佐吳從此霸江山。",
      "爭教不立功勳得，指出千囷如等閒。"
    ]
  },
  {
    "uid": "QTS_767_004_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "吳 甘寧斫營",
    "poem": [
      "夜深偷入魏軍營，滿寨驚忙火似星。",
      "百口寶刀千匹絹，也應消得與甘寧。"
    ]
  },
  {
    "uid": "QTS_767_005_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "吳 徐盛",
    "poem": [
      "欲把江山鼎足分，邢真銜冊到江南。",
      "當時將相誰堪重，徐盛將軍最不甘。"
    ]
  },
  {
    "uid": "QTS_767_006_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "吳 魯肅",
    "poem": [
      "斫案興言斷眾疑，鼎分從此定雄雌。",
      "若無子敬心相似，爭得烏林破魏師。"
    ]
  },
  {
    "uid": "QTS_767_007_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "吳 武昌",
    "poem": [
      "西塞山高截九垓，讖謠終日自相催。",
      "武昌魚美應難戀，歷數須歸建業來。"
    ]
  },
  {
    "uid": "QTS_767_008_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "吳 顧雍",
    "poem": [
      "贊國經綸更有誰，蔡公相歎亦相師。",
      "貴為丞相封侯了，歸後家人總不知。"
    ]
  },
  {
    "uid": "QTS_767_009_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "吳 呂蒙",
    "poem": [
      "幼小家貧實可哀，願征行去志難回。",
      "不探虎穴求身達，爭得人間富貴來。"
    ]
  },
  {
    "uid": "QTS_767_010_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "吳 介象",
    "poem": [
      "好道君王遇亦難，變通靈異幾多般。",
      "介先生有神仙術，釣得鱸魚在玉盤。"
    ]
  },
  {
    "uid": "QTS_767_011_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "吳 濡須塢",
    "poem": [
      "風揭洪濤響若雷，枕波為壘險相隈。",
      "莫言有個濡須塢，幾度曹公失志回。"
    ]
  },
  {
    "uid": "QTS_767_012_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "吳 周泰",
    "poem": [
      "名與諸公又不同，金瘡痕在滿身中。",
      "不將御蓋宣恩澤，誰信將軍別有功。"
    ]
  },
  {
    "uid": "QTS_767_013_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "吳 張紘",
    "poem": [
      "東部張公與眾殊，共施經略贊全吳。",
      "陳琳漫自稱雄伯，神氣應須怯大巫。"
    ]
  },
  {
    "uid": "QTS_767_014_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "吳 太史慈",
    "poem": [
      "聖德招賢遠近知，曹公心計卻成欺。",
      "陳韓昔日嘗投楚，豈是當歸召得伊。"
    ]
  },
  {
    "uid": "QTS_767_015_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "吳 孫堅後",
    "poem": [
      "委存張公翊聖材，幾將賢德贊文臺。",
      "爭教不霸江山得，日月徵曾入夢來。"
    ]
  },
  {
    "uid": "QTS_767_016_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "吳 陸統",
    "poem": [
      "將軍身歿有兒孤，虎子為名教讀書。",
      "更向宮中教騎馬，感君恩重合何如。"
    ]
  },
  {
    "uid": "QTS_767_017_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "吳 青蓋",
    "poem": [
      "歷數將終勢已摧，不修君德更堪哀。",
      "被他青蓋言相誤，元是須教入晉來。"
    ]
  },
  {
    "uid": "QTS_767_018_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "晉 七寶鞭",
    "poem": [
      "天命須知豈偶然，亂臣徒欲用兵權。",
      "聖謨廟略還應別，渾不消他七寶鞭。"
    ]
  },
  {
    "uid": "QTS_767_019_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "晉 庾悅鵝炙",
    "poem": [
      "春暖江南景氣新，子鵝炙美就中珍。",
      "庾家廚盛劉公困，渾弗相貽也惱人。"
    ]
  },
  {
    "uid": "QTS_767_020_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "晉 謝玄",
    "poem": [
      "百萬兵來逼合肥，謝玄為將統雄師。",
      "旌旗首尾千餘里，渾不消他一局棊。"
    ]
  },
  {
    "uid": "QTS_767_021_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "晉 謝混",
    "poem": [
      "尚主當初偶未成，此時誰合更關情。",
      "可憐謝混風華在，千古翻傳禁臠名。"
    ]
  },
  {
    "uid": "QTS_767_022_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "晉 陸玩",
    "poem": [
      "陸公高論亦由衷，謙讓還慚未有功。",
      "天下忠良人慾盡，始應交我作三公。"
    ]
  },
  {
    "uid": "QTS_767_023_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "晉 王坦之",
    "poem": [
      "晉祚安危只此行，坦之何必苦憂驚。",
      "謝公合定寰區在，爭遣當時事得成。"
    ]
  },
  {
    "uid": "QTS_767_024_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "晉 蒲葵扇",
    "poem": [
      "拋捨東山歲月遙，幾施經略挫雄豪。",
      "若非名德喧寰宇，爭得蒲葵價數高。"
    ]
  },
  {
    "uid": "QTS_767_025_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "晉 王郎",
    "poem": [
      "太尉門庭亦甚高，王郎名重禮相饒。",
      "自家妻父猶如此，誰更逢君得折腰。"
    ]
  },
  {
    "uid": "QTS_767_026_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "晉 劉毅",
    "poem": [
      "繞床堪壯喝盧聲，似鐵容儀眾盡驚。",
      "二十七人同舉義，幾人全得舊功名？"
    ]
  },
  {
    "uid": "QTS_767_027_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "晉 王恭",
    "poem": [
      "春風濯濯柳容儀，鶴氅神情舉世推。",
      "可惜教君仗旄鉞，枉將心地托牢之。"
    ]
  },
  {
    "uid": "QTS_767_028_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "晉 謝公賭墅",
    "poem": [
      "發遣將軍欲去時，略無情撓只貪棊。",
      "自從乞與羊曇後，賭墅功成更有誰？"
    ]
  },
  {
    "uid": "QTS_767_029_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "晉 苻堅投筆",
    "poem": [
      "投筆填江語未終，謝安乘此立殊功。",
      "三台星爛乾坤在，且與張華死不同。"
    ]
  },
  {
    "uid": "QTS_767_030_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "晉 衛玠",
    "poem": [
      "叔寶羊車海內稀，山家女婿好風姿。",
      "江東士女無端甚，看殺玉人渾不知。"
    ]
  },
  {
    "uid": "QTS_767_031_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "晉 郭璞脫襦",
    "poem": [
      "吟坐因思郭景純，每言窮達似通神。",
      "到頭分命難移改，解脫青襦與別人。"
    ]
  },
  {
    "uid": "QTS_767_032_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "晉 庾樓",
    "poem": [
      "江州樓上月明中，從事同登眺遠空。",
      "玉樹忽薶千載後，有誰重此繼清風？"
    ]
  },
  {
    "uid": "QTS_767_033_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "晉 新亭",
    "poem": [
      "容易乘虛逼帝畿，滿江艛艦與旌旗。",
      "盧循若解新亭上，勝負還應未可知。"
    ]
  },
  {
    "uid": "QTS_767_034_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "宋 大峴",
    "poem": [
      "大峴纔過喜可知，指空言已副心期。",
      "公孫計策嗟無用，天與南朝作霸基。"
    ]
  },
  {
    "uid": "QTS_767_035_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "宋 放宮人",
    "poem": [
      "納諫廷臣免犯顏，自然恩可霸江山。",
      "姚興侍女方承寵，放出宮闈若等閒。"
    ]
  },
  {
    "uid": "QTS_767_036_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "宋 借南苑",
    "poem": [
      "人主詞應不偶然，幾人曾說笑掀天。",
      "不知南苑今何在，借與張公三百年。"
    ]
  },
  {
    "uid": "QTS_767_037_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "宋 謝澹雲霞友",
    "poem": [
      "仗氣淩人豈可親，只將范泰是知聞。",
      "緣何喚作雲霞友，卻恐雲霞未似君。"
    ]
  },
  {
    "uid": "QTS_767_038_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "宋 烏衣巷",
    "poem": [
      "古蹟荒基好歎嗟，滿川吟景只煙霞。",
      "烏衣巷在何人住，回首令人憶謝家。"
    ]
  },
  {
    "uid": "QTS_767_039_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "宋 袁粲",
    "poem": [
      "負才尚氣滿朝知，高臥閒吟見客稀。",
      "獨步何人識袁尹，白楊郊外醉方歸。"
    ]
  },
  {
    "uid": "QTS_767_040_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "宋 劉伯龍",
    "poem": [
      "位重何如不厭貧，伯龍孤子只修身。",
      "固知生計還須有，窮鬼臨時也笑人。"
    ]
  },
  {
    "uid": "QTS_767_041_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "宋 王方平",
    "poem": [
      "拂衣耕釣已多時，江上山前樂可知。",
      "著卻貂裘將採藥，任他人喚作漁師。"
    ]
  },
  {
    "uid": "QTS_767_042_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "宋 黃羅襦",
    "poem": [
      "戚屬羣臣盡見猜，預憂身後又堪哀。",
      "到頭委付何曾是，虛把羅襦與彥回。"
    ]
  },
  {
    "uid": "QTS_767_043_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "宋 謝朏",
    "poem": [
      "謝家諸子盡蘭香，各震芳名滿帝鄉。",
      "惟有千金更堪重，只將高臥向齊王。"
    ]
  },
  {
    "uid": "QTS_767_044_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "宋 羊玄保",
    "poem": [
      "運命將來各有期，好官才闕即思之。",
      "就中堪愛羊玄保，偏受君王分外知。"
    ]
  },
  {
    "uid": "QTS_767_045_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "齊 謝朏",
    "poem": [
      "解璽傳呼詔侍中，卻來高臥豈疏慵。",
      "此時忠節還稀有，堪羨君王特地容。"
    ]
  },
  {
    "uid": "QTS_767_046_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "齊 小兒執燭",
    "poem": [
      "謝公情量已難量，忠宋心誠豈暫忘。",
      "執燭小兒渾放去，略無言語與君王。"
    ]
  },
  {
    "uid": "QTS_767_047_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "齊 王僧佑",
    "poem": [
      "肯與公卿作等倫，澹然名德只推君。",
      "任他車騎來相訪，簫鼓盈庭似不聞。"
    ]
  },
  {
    "uid": "QTS_767_048_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "齊 王僧虔",
    "poem": [
      "位高名重不堪疑，懇讓儀同帝亦知。",
      "不學常流爭進取，卻憂門有二台司。"
    ]
  },
  {
    "uid": "QTS_767_049_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "齊 明帝裹蒸",
    "poem": [
      "至尊尊貴異人間，御膳天廚豈等閒。",
      "惜得裹蒸無用處，不如安霸取江山。"
    ]
  },
  {
    "uid": "QTS_767_050_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "齊 鬱林王",
    "poem": [
      "強哀強慘亦從伊，歸到私庭喜可知。",
      "喜字漫書三十六，到頭能得幾多時。"
    ]
  },
  {
    "uid": "QTS_767_051_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "齊 何氏小山",
    "poem": [
      "顯達何曾肯繫心，築居郊外好園林。",
      "賺他謝朏出山去，贏得高名直至今。"
    ]
  },
  {
    "uid": "QTS_767_052_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "齊 王倫之",
    "poem": [
      "豫章太守重詞林，圖畫陳蕃與華歆。",
      "更奠子將並孺子，為君千載作知音。"
    ]
  },
  {
    "uid": "QTS_767_053_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "齊 潘妃",
    "poem": [
      "曾步金蓮寵絕倫，豈甘今日委埃塵。",
      "玉兒還有懷恩處，不肯將身嫁小臣。"
    ]
  },
  {
    "uid": "QTS_767_054_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "齊 王亮",
    "poem": [
      "後見梁王未免哀，奈何無計拯傾頹。",
      "若教彼相顛扶得，爭遣明公到此來。"
    ]
  },
  {
    "uid": "QTS_767_055_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 分宮女",
    "poem": [
      "滌蕩齊宮法令新，分張宮女二千人。",
      "可憐無限如花貌，重見世間桃李春。"
    ]
  },
  {
    "uid": "QTS_767_056_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 馬仙埤",
    "poem": [
      "齊朝太守不甘降，忠節當時動四方。",
      "義士要教天下見，且留君住待袁昂。"
    ]
  },
  {
    "uid": "QTS_767_057_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 勍敵",
    "poem": [
      "傳聞天子重儒才，特為皇華綺宴開。",
      "今日方驚遇勍敵，此人元自北朝來。"
    ]
  },
  {
    "uid": "QTS_767_058_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 蔡撙",
    "poem": [
      "紫茄白莧以為珍，守任清真轉更貧。",
      "不飲吳興郡中水，古今能有幾多人？"
    ]
  },
  {
    "uid": "QTS_767_059_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 楚祠",
    "poem": [
      "曾與蕭侯醉玉杯，此時神影盡傾頹。",
      "莫雲千古無靈聖，也向西川助敵來。"
    ]
  },
  {
    "uid": "QTS_767_060_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 謝朏小輿",
    "poem": [
      "小輿升殿掌鈞台，不免無憀卻憶回。",
      "應恨被他何胤誤，悔先容易出山來。"
    ]
  },
  {
    "uid": "QTS_767_061_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 八關齋",
    "poem": [
      "依憑金地甚虔誠，忍溺空王為聖明。",
      "內殿設齋申禱祝，豈無功德及臺城。"
    ]
  },
  {
    "uid": "QTS_767_062_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 庾信",
    "poem": [
      "苦心詞賦向誰談，淪落周朝志豈甘。",
      "可惜多才庾開府，一生惆悵憶江南。"
    ]
  },
  {
    "uid": "QTS_767_063_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 王僧辨",
    "poem": [
      "彼此英雄各有名，石頭高臥擬爭衡。",
      "當時堪笑王僧辨，待欲將心託聖明。"
    ]
  },
  {
    "uid": "QTS_767_064_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 武帝蚌盤",
    "poem": [
      "金翠絲黃略不舒，蚌盤清宴意何如。",
      "豈知三閣繁華日，解為君王妙破除。"
    ]
  },
  {
    "uid": "QTS_767_065_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 虞居士",
    "poem": [
      "苦諫將軍總不知，幾隨煙焰作塵飛。",
      "東山居士何人識，惟有君王卻許歸。"
    ]
  },
  {
    "uid": "QTS_767_066_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 姚察",
    "poem": [
      "曾佐徐陵向北遊，剖陳疑事動名流。",
      "卻歸掌選清何甚，一匹花綀不肯收。"
    ]
  },
  {
    "uid": "QTS_767_067_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 宣帝傷將卒",
    "poem": [
      "前後兵師戰勝回，百餘城壘盡歸來。",
      "當時將卒應知感，況得君王為舉哀。"
    ]
  },
  {
    "uid": "QTS_767_068_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 臨春閣",
    "poem": [
      "臨春高閣上侵雲，風起香飄數里聞。",
      "自是君王正沈醉，豈知消息報隋軍。"
    ]
  },
  {
    "uid": "QTS_767_069_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 綺閣",
    "poem": [
      "結綺高宜眺海涯，上淩丹漢拂雲霞。",
      "一千朱翠同居此，爭奈恩多屬麗華。"
    ]
  },
  {
    "uid": "QTS_767_070_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 望僊閣",
    "poem": [
      "多少沈檀結築成，望仙為號倚青冥。",
      "不知孔氏何形狀，醉得君王不解醒。"
    ]
  },
  {
    "uid": "QTS_767_071_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 三閣",
    "poem": [
      "三閣相通綺宴開，數千朱翠繞周回。",
      "只知斷送君王醉，不道韓擒已到來。"
    ]
  },
  {
    "uid": "QTS_767_072_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 狎客",
    "poem": [
      "八宮妃盡賦篇章，風揭歌聲錦繡香。",
      "選得十人為狎客，有誰能解諫君王？"
    ]
  },
  {
    "uid": "QTS_767_073_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 淮水",
    "poem": [
      "文物衣冠盡入秦，六朝繁盛忽埃塵。",
      "自從淮水乾枯後，不見王家更有人。"
    ]
  },
  {
    "uid": "QTS_767_074_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 江令宅",
    "poem": [
      "不向南朝立諫名，舊居基在事分明。",
      "令人惆悵江中令，只作篇章過一生。"
    ]
  },
  {
    "uid": "QTS_767_075_01",
    "volume": 767,
    "author": {
      "canonical": "孫元晏",
      "recorded": "孫元晏"
    },
    "title": "梁 後庭舞",
    "poem": [
      "嬿婉回風態若飛，麗華翹袖玉為姿。",
      "後庭一曲從教舞，舞破江山君未知。"
    ]
  }
]