[
  {
    "uid": "QTS_014_001_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 太清宮樂章 煌煌",
    "poem": [
      "煌煌道宮，肅肅太清。",
      "禮光尊祖，樂備充庭。",
      "罄竭誠至，希夷降靈。",
      "雲凝翠蓋，風焰紅旌。",
      "眾真以從，九奏初迎。",
      "永惟休佑，是錫和平。"
    ]
  },
  {
    "uid": "QTS_014_002_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 太清宮樂章 沖和",
    "poem": [
      "虛無結思，鐘磬和音。",
      "歌以頌德，香以達心。",
      "禮殊祼鬯，義感昭臨。",
      "靈車至止，慶垂愔愔。"
    ]
  },
  {
    "uid": "QTS_014_003_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 太清宮樂章 香初上",
    "poem": [
      "肅肅我祖，綿綿道宗。",
      "至感潛達，靈心暗通。",
      "雲輧禦氣，芝蓋隨風。",
      "四時禋祀，萬國來同。"
    ]
  },
  {
    "uid": "QTS_014_004_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 太清宮樂章 再上",
    "poem": [
      "仙宗績道，我李承天。",
      "慶深虛極，符光象先。",
      "俗登仁壽，化闡蟺涓。",
      "五千貽範，億萬斯年。"
    ]
  },
  {
    "uid": "QTS_014_005_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 太清宮樂章 終上",
    "poem": [
      "不宰元功，無為上聖。",
      "洪源長髮，誕受天命。",
      "金奏迎真，璿宮展盛。",
      "備禮周樂，垂光儲慶。"
    ]
  },
  {
    "uid": "QTS_014_006_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 太清宮樂章 紫極舞",
    "poem": [
      "至道生元氣，重圓法混成。",
      "無為觀大象，沖用體常名。",
      "仙樂臨丹闕，雲車出玉京。",
      "靈符百代應，瑞節九貞迎。",
      "寶運開皇極，天臨映太清。",
      "長垂一德慶，永庇萬方寧。"
    ]
  },
  {
    "uid": "QTS_014_007_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 太清宮樂章 序入破第一奏",
    "poem": [
      "真宗開妙理，沖教統清虛。",
      "化演無為日，言昭有象初。",
      "瑤台肅靈瑞，金闕映仙居。",
      "一奏三清樂，長回八景輿。"
    ]
  },
  {
    "uid": "QTS_014_008_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 太清宮樂章 第二奏",
    "poem": [
      "虛極仙宗本，希夷象帝先。",
      "百靈朝太上，萬法祖重圓。",
      "善貸惟沖德，功成謂自然。",
      "雲門達和氣，思用合鈞天。"
    ]
  },
  {
    "uid": "QTS_014_009_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 太清宮樂章 第三奏",
    "poem": [
      "元符傳紫極，寶祚啟高真。",
      "道德先垂裕，沖和已化淳。",
      "人風齊太古，天瑞葉惟新。",
      "仙樂清都上，長明交泰辰。"
    ]
  },
  {
    "uid": "QTS_014_010_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 太清宮樂章 登歌",
    "poem": [
      "嚴禋展事，理潔烝嘗。",
      "皇矣聖祖，德惟馨香。",
      "盛薦既撤，工歌載揚。",
      "大來之慶，降福穰穰。"
    ]
  },
  {
    "uid": "QTS_014_011_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 太清宮樂章 真和",
    "poem": [
      "玉磬含香，金爐既馥。",
      "風馭泠泠，雲壇肅肅。",
      "杳歸大象，霈流嘉福。",
      "俾甯萬邦，無思不服。"
    ]
  },
  {
    "uid": "QTS_014_012_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 德明興聖廟樂章 迎神",
    "poem": [
      "元尊九德，佐堯光宅。",
      "烈祖太宗，方周作伯。",
      "響懷霜露，樂變金石。",
      "白雲清風，仿佛來格。"
    ]
  },
  {
    "uid": "QTS_014_013_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 德明興聖廟樂章 登歌奠幣",
    "poem": [
      "四時有典，百事來祭。",
      "尊祖奉宗，嚴禋大帝。",
      "禮先蒼璧，奠幣黝制。",
      "於斯萬年，熙成帝系。"
    ]
  },
  {
    "uid": "QTS_014_014_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 德明興聖廟樂章 迎俎",
    "poem": [
      "盛牲實俎，涓選休成。",
      "鼎煁陽燧，玉盥陰精。",
      "有飶嘉豆，既和大羹。",
      "侑以清樂，細齊人情。"
    ]
  },
  {
    "uid": "QTS_014_015_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 德明興聖廟樂章 德明酌獻",
    "poem": [
      "清廟奕奕，和樂雍雍。",
      "器尊犧象，禮屬宗公。",
      "白水方祼，黃流在中。",
      "謨明之德，萬古清風。"
    ]
  },
  {
    "uid": "QTS_014_016_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 德明興聖廟樂章 興聖酌獻",
    "poem": [
      "閟宮靜謐，合樂周張。",
      "泰奠始獻，百末重觴。",
      "震澹存誠，庶幾迪嘗。",
      "遙源之祚，天漢靈長。"
    ]
  },
  {
    "uid": "QTS_014_017_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 德明興聖廟樂章 亞獻終獻",
    "poem": [
      "惟清惟肅，靡聞靡見。",
      "舉備九成，俯終三獻。",
      "慶彰曼壽，胙徹嘉薦。",
      "瘞玉埋牲，禮神斯遍。"
    ]
  },
  {
    "uid": "QTS_014_018_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 德明興聖廟樂章 送神",
    "poem": [
      "元精回復，靈貺繁滋。",
      "風灑蘭路，雲搖桂旗。",
      "高丘緬邈，涼部逶遲。",
      "瞻望靡及，纏綿永思。"
    ]
  },
  {
    "uid": "QTS_014_019_01",
    "volume": 14,
    "author": {
      "canonical": "徐彥伯",
      "recorded": "徐彥伯",
      "gender": "male",
      "period": "Early Tang",
      "wikidata_id": "Q11070620"
    },
    "title": "郊廟歌辭 儀坤廟樂章 永和",
    "poem": [
      "猗若清廟，肅肅熒熒。",
      "國薦嚴祀，坤興淑靈。",
      "有幾在室，有樂在庭。",
      "臨茲孝享，百祿惟寧。"
    ]
  },
  {
    "uid": "QTS_014_020_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 儀坤廟樂章 金奏",
    "poem": [
      "陰靈曜祉，軒曜降精。",
      "祥符淑氣，慶集柔明。",
      "瑤俎既列，雕桐發聲。",
      "徽猷永遠，比德皇英。"
    ],
    "notes": [
      {
        "content": "一本無此章",
        "context": "樂章 金奏",
        "original_title": "郊廟歌辭 儀坤廟樂章 金奏〈一本無此章〉"
      }
    ]
  },
  {
    "uid": "QTS_014_021_01",
    "volume": 14,
    "author": {
      "canonical": "丘說",
      "recorded": "丘說"
    },
    "title": "郊廟歌辭 儀坤廟樂章 太和",
    "poem": [
      "孝哉我後，沖乎乃聖。",
      "道映重華，德輝文命。",
      "慕深視篋，情殷撫鏡。",
      "萬國移風，兆人承慶。"
    ]
  },
  {
    "uid": "QTS_014_022_01",
    "volume": 14,
    "author": {
      "canonical": "張齊賢",
      "recorded": "張齊賢",
      "gender": "male",
      "english_name": "Zhang Qixian",
      "wikidata_id": "Q45528324"
    },
    "title": "郊廟歌辭 儀坤廟樂章 肅和",
    "poem": [
      "祼圭既濯，郁鬯既陳。",
      "畫幕雲舉，黃流玉醇。",
      "儀充獻酌，禮盛眾禋。",
      "地察惟孝，愉焉饗親。"
    ]
  },
  {
    "uid": "QTS_014_023_01",
    "volume": 14,
    "author": {
      "canonical": "鄭善玉",
      "recorded": "鄭善玉"
    },
    "title": "郊廟歌辭 儀坤廟樂章 雍和",
    "poem": [
      "酌鬱既灌，薌蕭方爇。",
      "籩豆靜器，簠簋芬飶。",
      "魚臘薦美，牲牷表潔。",
      "是戢是將，載迎載列。"
    ]
  },
  {
    "uid": "QTS_014_024_01",
    "volume": 14,
    "author": {
      "canonical": "薛稷",
      "recorded": "薛稷",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Xue Ji",
      "wikidata_id": "Q6147970"
    },
    "title": "郊廟歌辭 儀坤廟樂章 昭升",
    "poem": [
      "陽靈配德，陰魄昭升。",
      "堯壇鳳下，漢室龍興。",
      "俔天作對，前旒是凝。",
      "化行南國，道盛西陵，造舟集灌，無德而稱。",
      "我粢既絜，我醴既澄。",
      "陰陰靈廟，光靈若憑。",
      "德馨惟享，孝思烝烝。"
    ]
  },
  {
    "uid": "QTS_014_025_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 儀坤廟樂章 坤貞",
    "poem": [
      "幹道既亨，坤元以貞。",
      "肅雍攸在，輔佐斯成。",
      "外睦九族，內光一庭。",
      "克生睿哲，祚我休明。",
      "欽若徽範，悠哉淑靈。",
      "建茲清宮，於彼上京。",
      "縮茅以獻，絜秬惟馨。",
      "實受其福，期乎億齡。"
    ]
  },
  {
    "uid": "QTS_014_026_01",
    "volume": 14,
    "author": {
      "canonical": "徐堅",
      "recorded": "徐堅",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Xu Jian",
      "wikidata_id": "Q11070414"
    },
    "title": "郊廟歌辭 儀坤廟樂章 壽和",
    "poem": [
      "於穆清廟，肅雍嚴祀。",
      "合福受厘，介以繁祉。"
    ]
  },
  {
    "uid": "QTS_014_027_01",
    "volume": 14,
    "author": {
      "canonical": "胡雄",
      "recorded": "胡雄"
    },
    "title": "郊廟歌辭 儀坤廟樂章 舒和",
    "poem": [
      "送文迎武遞參差，一始一終光聖儀。",
      "四海生人歌有慶，千齡孝享肅無虧。"
    ]
  },
  {
    "uid": "QTS_014_028_01",
    "volume": 14,
    "author": {
      "canonical": "劉子玄",
      "recorded": "劉子玄",
      "gender": "male",
      "wikidata_id": "Q10899597"
    },
    "title": "郊廟歌辭 儀坤廟樂章 安和",
    "poem": [
      "妙算申帷幄，神謀及廟庭。",
      "兩階文物備，七德武功成。",
      "校獵長楊苑，屯軍細柳營。",
      "將軍獻凱入，歌舞溢重城。"
    ]
  },
  {
    "uid": "QTS_014_029_01",
    "volume": 14,
    "author": {
      "canonical": "員半千",
      "recorded": "員半千",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Yuan Panqian",
      "wikidata_id": "Q18907097"
    },
    "title": "郊廟歌辭 儀坤廟樂章 雍和",
    "poem": [
      "孝享雲畢，惟徹有章。",
      "雲感玄羽，風淒素商。",
      "瞻望神座，祗戀匪遑。",
      "禮終樂闋，肅雍鏘鏘。"
    ]
  },
  {
    "uid": "QTS_014_030_01",
    "volume": 14,
    "author": {
      "canonical": "祝欽明",
      "recorded": "祝欽明",
      "gender": "male",
      "wikidata_id": "Q88744861"
    },
    "title": "郊廟歌辭 儀坤廟樂章 永和",
    "poem": [
      "閟宮實實，清廟微微。",
      "降格無象，馨香有依。",
      "式昭纂慶，方融嗣徽。",
      "明禋是享，神保聿歸。"
    ]
  },
  {
    "uid": "QTS_014_031_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 儀坤廟樂章 迎神",
    "poem": [
      "月靈降德，坤元授光。",
      "娥英比秀，任姒均芳。",
      "瑤台薦祉，金屋延祥。",
      "迎神有樂，歆此嘉薌。"
    ]
  },
  {
    "uid": "QTS_014_032_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 儀坤廟樂章 送神",
    "poem": [
      "玉帛儀大，金絲奏廣。",
      "靈應有孚，冥征不爽。",
      "降彼休福，歆茲禋享。",
      "送樂有章，神麾其上。"
    ]
  },
  {
    "uid": "QTS_014_033_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 昭德皇后廟樂章 永和",
    "poem": [
      "穆清廟，薦嚴禋。",
      "昭禮備，和樂新。",
      "望靈光，集元辰。",
      "祚無極，享萬春。"
    ]
  },
  {
    "uid": "QTS_014_034_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 昭德皇后廟樂章 肅和",
    "poem": [
      "誠心達，娛樂分。",
      "升簫膋，鬱氛氳。",
      "茅既縮，鬯既熏。",
      "後來思，福如雲。"
    ]
  },
  {
    "uid": "QTS_014_035_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 昭德皇后廟樂章 雍和",
    "poem": [
      "我將我享，盡明而誠。",
      "載芬黍稷，載滌犧牲。",
      "懿矣元良，萬邦以貞。",
      "心乎愛敬，若睹容聲。"
    ]
  },
  {
    "uid": "QTS_014_036_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 昭德皇后廟樂章 坤元",
    "poem": [
      "於穆先後，麗聖稱崇。",
      "母臨萬宇，道被六宮。",
      "昌時協慶，理內成功。",
      "殷薦明德，傳芳國風。"
    ]
  },
  {
    "uid": "QTS_014_037_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 昭德皇后廟樂章 壽和",
    "poem": [
      "工祝致告，徽音不遐。",
      "酒醴咸旨，馨香具嘉。",
      "受厘獻祉，永慶邦家。"
    ]
  },
  {
    "uid": "QTS_014_038_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 昭德皇后廟樂章 舒和",
    "poem": [
      "金枝羽部徹清歌，瑤台肅穆笙磬羅。",
      "諧音遍響合明意，萬類昭融靈應多。"
    ]
  },
  {
    "uid": "QTS_014_039_01",
    "volume": 14,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 昭德皇后廟樂章 凱安",
    "poem": [
      "辰位列四星，帝功參十亂。",
