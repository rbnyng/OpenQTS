      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "送崔侍御書記赴山北座主尚書招辟",
    "poem": [
      "書記向丘門，旌幢夾谷尊。",
      "從來遊幕意，此去並酬恩。",
      "雁呌嫌冰合，驄嘶喜雪繁。",
      "同為入室士，不覺別銷魂。"
    ]
  },
  {
    "uid": "QTS_589_004_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "入朝遇雪",
    "poem": [
      "霜鬢持霜簡，朝天向雪天。",
      "玉階初辨色，瓊樹乍相鮮。",
      "密翳空難曙，盈徵瑞不愆。",
      "誰為洛陽客，是日更高眠。"
    ]
  },
  {
    "uid": "QTS_589_005_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "勉力",
    "poem": [
      "日月不並照，升沈俱有時。",
      "自媒徒欲速，孤立卻宜遲。",
      "盡力唯求己，公心任遇誰。",
      "人間不得意，半是鬢先衰。"
    ]
  },
  {
    "uid": "QTS_589_006_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "郊居寄友人",
    "poem": [
      "林色樹還曛，何時得見君。",
      "獨居度永日，相去遠浮雲。",
      "故疾隨秋至，離懷覺夜分。",
      "蛩聲非自苦，偏是旅人聞。"
    ]
  },
  {
    "uid": "QTS_589_007_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "送陸肱歸吳興",
    "poem": [
      "雪後江上去，風光故國新。",
      "清渾天氣曉，綠動浪花春。",
      "勸酒提壺鳥，乘舟震澤人。",
      "誰知滄海月，取桂卻來秦。"
    ]
  },
  {
    "uid": "QTS_589_008_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "暮秋重過山僧院",
    "poem": [
      "卻接良宵坐，明河幾轉流。",
      "安禪逢小暑，抱疾入高秋。",
      "靜室聞玄理，深山可白頭。",
      "朝朝獻林果，亦欲學獼猴。"
    ]
  },
  {
    "uid": "QTS_589_009_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "送新安少府",
    "poem": [
      "南浮雖六月，風水已秋涼。",
      "日亂看江樹，身飛逐楚檣。",
      "後期誰可定，臨別語空長。",
      "遠宦須清苦，幽蘭貴獨芳。"
    ]
  },
  {
    "uid": "QTS_589_010_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "送人歸吳",
    "poem": [
      "何人不歸去，君去是閒人。",
      "帝里求相識，山家即近鄰。",
      "交情吾道一作「古」，一作「舊」可，離思柳條新。",
      "未飲青門酒，先如醉夢身。"
    ]
  },
  {
    "uid": "QTS_589_011_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "送姚評事",
    "poem": [
      "儒服從戎去，須知勝事全。",
      "使君開幕日，天子偃戈年。",
      "風雨依嵩嶺，桑麻接楚田。",
      "新詩隨過客，旋滿洛陽傳。"
    ]
  },
  {
    "uid": "QTS_589_012_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "題棲雲寺立上人院",
    "poem": [
      "是法從生有，修持歷劫塵。",
      "獨居岩下室，長似定中身。",
      "樹老風終夜，山寒雪見春。",
      "不知諸祖後，傳印是何人。"
    ]
  },
  {
    "uid": "QTS_589_013_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "黔中罷職過峽州題田使君北樓",
    "poem": [
      "巴中初去日，已遇使君留。",
      "及得尋東道，還陪上北樓。",
      "江衝巫峽出，檣過洛宮收。",
      "好是從戎罷，看山覺自由。"
    ]
  },
  {
    "uid": "QTS_589_014_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "江上送從兄群玉校書東遊",
    "poem": [
      "逍遙蓬閣吏，才子復詩流。",
      "墳籍因窮覽，江湖卻縱遊。",
      "眠波聽戍鼓，飯浦約魚舟。",
      "處處迎高密，先應掃郡樓。"
    ]
  },
  {
    "uid": "QTS_589_015_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "宛陵東峰亭與友人話別",
    "poem": [
      "坐舉天涯目，停杯語日晡。",
      "修篁齊迥檻，列岫限平蕪。",
      "亂水通三楚，歸帆掛五湖。",
      "不知從此去，何處是前塗。"
    ]
  },
  {
    "uid": "QTS_589_016_01",
    "volume": 589,
    "author": {
