      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "岐山逢陝下故人",
    "poem": [
      "三秦一會面，二陝久分攜。",
      "共憶黃河北，相留白日西。",
      "寄來書少達，別後夢多迷。",
      "早晚期于此，看花聽鳥啼。"
    ]
  },
  {
