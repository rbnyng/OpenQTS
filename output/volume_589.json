      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "送壽昌曹明府",
    "poem": [
      "惠人須宰邑，為政貴通經。",
      "卻用清琴理，猶嫌薄俗聽。",
      "漲江晴漸淥，春嶠燒還青。",
      "若宿嚴陵瀨，誰當是客星。"
    ]
  },
  {
    "uid": "QTS_589_021_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "哭賈島",
    "poem": [
      "秦樓吟苦夜，南望只悲君。",
      "一宦終遐徼，千山隔旅墳。",
      "恨聲流蜀魄，冤氣入湘雲。",
      "無限風騷句，時來日夜聞。"
    ]
  },
  {
    "uid": "QTS_589_022_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "送薛能赴鎮徐方",
    "poem": [
      "列土人間盛，彭門屬九州。",
      "山河天設險，禮樂牧分憂。",
      "皎日為明信，清風占早秋。",
      "雖同郤縠舉，郤縠不封矦。"
    ]
  },
  {
    "uid": "QTS_589_023_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "送鳳翔范書記",
    "poem": [
      "西京無暑氣，夏景似清秋",
      "天府來相辟，高人去自由。",
      "江山通蜀國，日月近神州。",
      "若共將軍語，河蘭地未收。"
    ]
  },
  {
    "uid": "QTS_589_024_01",
    "volume": 589,
    "author": {
