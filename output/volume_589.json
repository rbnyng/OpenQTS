      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "華山尋隱者",
    "poem": [
      "自入華山居，關東相見疎。",
      "瓢中誰寄酒，葉上我留書。",
      "巢鳥寒棲盡，潭泉暮凍餘。",
      "長聞得藥力，此說又何如。"
    ]
  },
  {
    "uid": "QTS_589_017_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "題薦福寺僧棲白上人院",
    "poem": [
      "空門有才子，得道亦吟詩。",
      "內殿頻徵入，孤峰久作期。",
      "高名何代比，密行幾生持。",
      "長愛喬松院，清涼坐夏時。"
    ]
  },
  {
    "uid": "QTS_589_018_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "遊四明山劉樊二真人祠，題山下孫氏居",
    "poem": [
      "久在仙壇下，全家是地仙。",
      "池塘來乳洞，禾黍接芝田。",
      "起看青山足，還傾白酒眠。",
      "不知塵世事，雙鬢逐流年。"
    ]
  },
  {
    "uid": "QTS_589_019_01",
    "volume": 589,
    "author": {
      "canonical": "李頻",
      "recorded": "李頻",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Pin",
      "wikidata_id": "Q6539003"
    },
    "title": "和太學趙鴻博士歸蔡中",
    "poem": [
      "得祿從高第，還鄉見後生。",
      "田園休問主，詞賦已垂名。",
      "掃壁前題出，開牕舊景清。",
      "遙知賢太守，致席日邀迎。"
    ]
  },
  {
    "uid": "QTS_589_020_01",
    "volume": 589,
    "author": {
