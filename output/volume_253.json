  {
    "uid": "QTS_253_007_01",
    "volume": 253,
    "author": {
      "canonical": "閻防",
      "recorded": "閻防"
    },
    "title": "百丈谿新埋茅茨讀書",
    "poem": [
      "浪跡棄人世，遠山自幽獨。",
      "始傍巢由蹤，吾其獲心曲。",
      "荒庭何所有，老樹半空腹。",
      "秋蜩鳴北林，暮鳥穿我屋。",
      "棲違樂遵渚，恬曠寡所欲。",
      "開卦推盈虛，散帙攻節目。",
      "養閒度人事，達命知止足。",
      "不學東周儒，俟時勞伐輻。"
    ],
    "variants": [
      {
        "line": 8,
        "text": "周",
        "variant": "國",
        "source": "一作「國」"
      }
    ]
  },
  {
