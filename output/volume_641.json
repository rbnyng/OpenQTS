      "wikidata_id": "Q22098757"
    },
    "title": "小遊仙詩九十八首",
    "poem": [
      "上元元日豁明堂，五帝望空拜玉皇。",
      "萬樹琪花千圃藥，心知不敢輒形相。"
    ]
  },
  {
    "uid": "QTS_641_003_01",
    "volume": 641,
    "author": {
      "canonical": "曹唐",
      "recorded": "曹唐",
      "gender": "male",
      "english_name": "Cao Tang",
      "wikidata_id": "Q22098757"
    },
    "title": "小遊仙詩九十八首",
    "poem": [
      "騎龍重過玉溪頭，紅葉還春碧水流。",
      "省得壺中見天地，壺中天地不曾秋。"
    ]
  },
  {
    "uid": "QTS_641_004_01",
    "volume": 641,
    "author": {
      "canonical": "曹唐",
      "recorded": "曹唐",
      "gender": "male",
