[
  {
    "uid": "QTS_711_001_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "依御史溫飛卿華清宮二十二韻",
    "poem": [
      "地靈蒸水暖，天氣待宸遊。",
      "巖拱蓮花秀，峰高玉蘂秋。",
      "朝元雕翠閣，乞巧繡瓊樓。",
      "碧海供驪嶺，黃金絡馬頭。",
      "五王更入帳，七貴迭封侯。",
      "夕雨鳴鴛瓦，朝陽煜柘裘。",
      "伊皐爭負鼎，舜禹讓垂旒。",
      "墮珥閒應拾，遺釵醉不收。",
      "飛煙籠劍戟，殘月照旌斿。",
      "履朔求衣早，臨陽解佩羞。",
      "宮詞裁錦段，御筆落銀鉤。",
      "帝里新豐縣，長安舊雍州。",
      "雪衣傳貝葉，蟬鬢插山榴。",
      "對景瞻瑤兔，昇天駕綵虬。",
      "丹書陳北虜，玄甲擐犀牛。",
      "聖誥多屯否，生靈少怨尤。",
      "穹旻當有輔，帷幄豈無籌。",
      "鳳態傷紅豔，鸞輿緩紫騮。",
      "樹名端正在，人慾夢魂休。",
      "讖語山旁鬼，塵銷隴畔丘。",
      "重來芳草恨，往事落花愁。",
      "五十年鴻業，東憑渭水流。"
    ],
    "notes": [
      {
        "content": "一本無「御史」二字。",
        "context": "依御史溫飛卿華清宮二十二韻",
        "original_title": "依御史溫飛卿華清宮二十二韻",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_711_002_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "尚書命題瓦硯",
    "poem": [
      "遠向端溪得，皆因郢匠成。",
      "鑿山青靄斷，琢石紫花輕。",
      "散墨松香起，濡毫藻句清。",
      "入臺知價重，著匣恐塵生。",
      "守黑還全器，臨池早著名。",
      "春闈攜就處，軍幙載將行。",
      "不獨雄文陣，兼能助筆耕。",
      "莫嫌涓滴潤，深染古今情。",
      "洗處無瑕玷，添時識滿盈。",
      "蘭亭如見用，敲戛有金聲。"
    ]
  },
  {
    "uid": "QTS_711_003_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "東風解凍省試",
    "poem": [
      "暖氣飄蘋末，凍痕銷水中。",
      "扇氷初覺泮，吹海旋成空。",
      "入律三春照，朝宗萬里通。",
      "岸分天影闊，色照日光融。",
      "波起輕搖緑，鱗遊乍躍紅。",
      "殷勤排弱羽，飛翥趂和風。"
    ]
  },
  {
    "uid": "QTS_711_004_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "和僕射二十四丈牡丹八韻",
    "poem": [
      "帝王城裏看，無故亦無新。",
      "忍摘都縁借，移栽未有因。",
      "光陰嫌太促，開落一何頻。",
      "羞殺登墻女，饒將解佩人。",
      "蘂堪靈鳳啄，香許白龍親。",
      "素練籠霞曉，紅妝帶臉春。",
      "莫辭終夕醉，易老少年身。",
      "買取歸天上，寧教逐世塵。"
    ]
  },
  {
    "uid": "QTS_711_005_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "釣絲竹",
    "poem": [
      "藋藋拂清流，堪維舴艋舟。",
      "野蟲懸作餌，溪月曲為鉤。",
      "雨潤搖堦長，風吹繞指柔。",
      "若將諸樹比，還使緑楊羞。",
      "蠶婦非堯女，漁人是子猷。",
      "湖邊舊栽處，長映讀書樓。"
    ]
  },
  {
    "uid": "QTS_711_006_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "尚書會仙亭詠薔薇，夤坐中，聯四韻，晚歸補緝所聯，因成一篇",
    "poem": [
      "結緑根株翡翠莖，句芒中夜刺猩猩。",
      "景陽妝赴嚴鐘出，楚峽神教暮雨晴。",
      "躑躅豈能同日語，玫瑰方可一時呈。",
      "風吹嫩帶香苞展，露灑啼思淚點輕。",
      "阿母蘂宮期索去，昭君榆塞闕齎行。",
      "藂高恐礙銜泥燕，架隱宜棲報曙鶯。",
      "鬬日只憂燒密葉，映階疑欲讓雙旌。",
      "含煙散纈佳人惜，落地遺鈿少妓爭。",
      "丹渥不因輸繡段，錢圓誰把買花聲？",
      "海棠若要分流品，秋菊春蘭兩恰平。"
    ]
  },
  {
    "uid": "QTS_711_007_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "和尚書十二韻",
    "poem": [
      "名齊火浣溢山椒，誰把驚虹掛一條。",
      "天外倚來秋水刃，海心飛上白龍綃。",
      "民田鑿斷雲根引，僧圃穿通竹影澆。",
      "噴石似煙輕漠漠，濺崖如雨冷瀟瀟。",
      "水中蠶緒纏蒼壁，日裏虹精掛絳霄。",
      "寒漱緑陰仙桂老，碎流紅豔野桃夭。",
      "千尋練寫長年在，六出花開夏日消。",
      "急恐劃分青嶂骨，久應�裂翠微腰。",
      "濯纓便可譏漁父，洗耳還宜傲帝堯。",
      "林際猨猱偏得飯，岸邊烏鵲擬為橋。",
      "赤城未到詩先寄，廬阜曾遊夢已遙。",
      "數夜積霖聲更遠，郡樓欹枕聽良宵。"
    ],
    "notes": [
      {
        "content": "詠泉山瀑布",
        "context": "和尚書",
        "original_title": "和尚書《詠泉山瀑布》十二韻"
      }
    ]
  },
  {
    "uid": "QTS_711_008_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "自詠十韻",
    "poem": [
      "只合滄洲釣與耕，忽依螢燭愧功成。",
      "未遊宦路叨卑宦，纔到名場得大名。",
      "梁苑二年陪眾客，溫陵十載佐雙旌。",
      "錢財儘是侯王惠，骨肉偕承里巷榮。",
      "拙賦偏聞鐫印賣，惡詩親見畫圖呈。",
      "多栽桃李期春色，闊鑿池塘許月明。",
      "寒益輕裯饒美寢，出乘車馬免徒行。",
      "麤支菽粟防飢歉，薄有桮盤備送迎。",
      "僧俗共鄰棲隱樂，妻孥同愛水雲清。",
      "如今便死還甘分，莫更嫌他白髮生。"
    ],
    "notes": [
      {
        "line": 5,
        "content": "使宅行夤回文八體詩圖兩面，庚午秋，使樓赴宴，親見每一倒翻讀八韻也。",
        "context": "多栽桃李期春色，闊鑿池塘許月明。"
      }
    ]
  },
  {
    "uid": "QTS_711_009_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "鏡中覽懷",
    "poem": [
      "晨起梳頭忽自悲，鏡中親見數莖絲。",
      "從今休說龍泉劍，世上恩讐報已遲。"
    ],
    "notes": [
      {
        "content": "一本無「懷」字，一本作《覽鏡書懷》。",
        "context": "鏡中覽懷",
        "original_title": "鏡中覽懷",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_711_010_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "楚國史",
    "poem": [
      "六國商於恨最多，良弓休綰劍休磨。",
      "君王不翦如簧舌，再得張儀欲奈何。"
    ]
  },
  {
    "uid": "QTS_711_011_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "張儀",
    "poem": [
      "荊楚南來又北歸，分明舌在不應違。",
      "懷王本是無心者，籠得蒼蠅卻放飛。"
    ]
  },
  {
    "uid": "QTS_711_012_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "薔薇",
    "poem": [
      "朝露灑時如濯錦，晚風飄處似遺鈿。",
      "重門剩著黃金鎖，莫被飛瓊摘上天。"
    ]
  },
  {
    "uid": "QTS_711_013_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "大夫松",
    "poem": [
      "五樹旌封許歲寒，挽柯攀葉也無端。",
      "爭如澗底凌霜節，不受秦皇亂世官。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "亂世",
        "variant": "號此",
        "source": "一作「號此」"
      }
    ]
  },
  {
    "uid": "QTS_711_014_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "杏園",
    "poem": [
      "杏苑簫聲好醉鄉，春風嘉宴更無雙。",
      "憑誰為謔穆天子，莫把瑤池並曲江。"
    ]
  },
  {
    "uid": "QTS_711_015_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "蕉葉",
    "poem": [
      "緑綺新裁織女機，擺風搖日影離披。",
      "只應青帝行春罷，閒倚東牆卓翠旗。"
    ]
  },
  {
    "uid": "QTS_711_016_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "路旁草",
    "poem": [
      "楚甸秦原萬里平，誰教根向路傍生。",
      "輕蹄繡轂長相蹋，合是榮時不得榮。"
    ]
  },
  {
    "uid": "QTS_711_017_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "讀漢紀",
    "poem": [
      "布衣空手取中原，勁卒雄師不足論。",
      "楚國八千秦百萬，豁開胸臆一時吞。"
    ]
  },
  {
    "uid": "QTS_711_018_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "李夫人二首 其一",
    "poem": [
      "不望金輿到錦帷，人間樂極即須悲。",
      "若言要識愁中貌，也似君恩日日衰。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_711_018_02",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "李夫人二首 其二",
    "poem": [
      "招得香魂爵少翁，九華燈燭曉還空。",
      "漢王不及吳王樂，且與西施死處同。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_711_019_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "明妃",
    "poem": [
      "不用牽心恨畫工，帝家無策及邊戎。",
      "香魂若得昇明月，夜夜還應照漢宮。"
    ]
  },
  {
    "uid": "QTS_711_020_01",
    "volume": 711,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "馬嵬",
    "poem": [
      "二百年來事遠聞，從龍誰解盡如雲。",
      "張均兄弟皆何在？卻是楊妃死報君。"
    ],
