      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "謝田贊善見寄",
    "poem": [
      "五侯三任未相稱，頭白如絲作縣丞。",
      "錯判符曹群吏笑，亂書岩石一山憎。",
      "自知酒病衰腸怯，遙怕春殘百鳥淩。",
      "年少力生猶不敵，況加憔悴悶騰騰。"
    ]
  },
