      "wikidata_id": "Q697433"
    },
    "title": "同於汝錫遊降聖觀",
    "poem": [
      "秦時桃樹滿山坡，騎鹿先生降大羅。",
      "路盡溪頭逢地少，門連內裏見天多。",
      "荒泉壞簡硃砂暗，古塔殘經篆字訛。",
      "聞說開元齋醮日，曉移行漏帝親過。"
    ]
  },
  {
    "uid": "QTS_300_012_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "逍遙翁溪亭",
    "poem": [
      "逍遙翁在此裴回，帝改溪名起石臺。",
      "車馬到春常借問，子孫因選暫歸來，稀疏野竹人移折，零落蕉花雨打開。",
      "無主青山何所直，賣供官稅不如灰。"
    ]
  },
  {
    "uid": "QTS_300_013_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "尋李山人不遇",
    "poem": [
      "山客長須少在時，溪中放鶴洞中棋。",
      "生金有氣尋還遠，仙藥成窠見即移。",
      "莫為無家陪寺食，應緣將米寄人炊。",
      "從頭石上留名去，獨向南峰問老師。"
    ]
  },
  {
    "uid": "QTS_300_014_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "題石甕寺",
    "poem": [
      "青崖白石夾城東，泉脈鐘聲內裏通。",
      "地壓龍蛇山色別，屋連宮殿匠名同。",
      "簷燈經夏紗籠黑，溪葉先秋臘樹紅。",
      "天子親題詩總在，畫扉長鎖碧龕中。"
    ]
  },
  {
    "uid": "QTS_300_015_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "早登西禪寺閣",
    "poem": [
      "上方臺殿第三層，朝壁紅窗日氣凝。",
      "煙霧開時分遠寺，山川晴處見崇陵。",
      "沙灣漾水圖新粉，綠野荒阡暈色繒。",
      "莫說城南月燈閣，自諸樓看總難勝。"
    ]
  },
  {
    "uid": "QTS_300_016_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "題江寺兼求藥子",
    "poem": [
      "隋朝舊寺楚江頭，深謝師僧引客遊。",
      "空賞野花無過夜，若看琪樹即須秋。",
      "紅珠落地求誰與，青角垂階自不收。",
      "願乞野人三兩粒，歸家將助小庭幽。"
    ]
  },
  {
    "uid": "QTS_300_017_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "題詵法師院",
    "poem": [
      "三年說戒龍宮裏，巡禮還來向水行。",
      "多愛貧窮人遠請，長修破落寺先成。",
      "秋天盆底新荷色，夜地房前小竹聲。",
      "僧院不求諸處好，轉經唯有一窗明。"
    ]
  },
  {
    "uid": "QTS_300_018_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "酬於汝錫曉雪見寄",
    "poem": [
      "欲明天色白漫漫，打葉穿簾雪未幹。",
      "薄落階前人踏盡，差池樹裏鳥銜殘。",
      "旋銷迎暖沾牆少，斜舞遮春到地難。",
      "勞動更裁新樣綺，紅燈一夜剪刀寒。"
    ]
  },
  {
    "uid": "QTS_300_019_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "從軍後寄山中友人",
    "poem": [
      "愛仙無藥住溪貧，脫卻山衣事漢臣。",
      "夜半聽雞梳白髮，天明走馬入紅塵。",
      "村童近去嫌腥食，野鶴高飛避俗人。",
      "勞動先生遠相示，別來弓箭不離身。"
    ]
  },
  {
    "uid": "QTS_300_020_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "寄汴州令狐相公",
    "poem": [
      "三軍江口擁雙旌，虎帳長開自教兵。",
      "機鎖惡徒狂寇盡，恩驅老將壯心生。",
      "水門向晚茶商鬧，橋市通宵酒客行。",
      "秋日梁王池閣好，新歌散入管弦聲。"
    ]
  },
  {
    "uid": "QTS_300_021_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "別李贊侍御",
    "poem": [
      "同受艱難驃騎營，半年中聽揭槍聲。",
      "草頭送酒驅村樂，賊裏看花著探兵。",
      "講易工夫尋已聖，說詩門戶別來情。",
      "薦書自入無消息，賣盡寒衣卻出城。"
    ]
  },
  {
    "uid": "QTS_300_022_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "和蔣學士新授章服",
    "poem": [
      "五色箱中絳服春，笏花成就白魚新。",
      "看宣賜處驚回眼，著謝恩時便稱身。",
      "瑞草唯承天上露，紅鸞不受世間塵。",
      "翰林同賀文章出，驚動茫茫下界人。"
    ]
  },
  {
    "uid": "QTS_300_023_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "歲晚自感",
    "poem": [
      "人皆欲得長年少，無那排門白髮催。",
      "一向破除愁不盡，百方迴避老須來。",
      "草堂未辦終須置，松樹難成亦且栽。",
      "瀝酒願從今日後，更逢二十度花開。"
    ]
  },
  {
    "uid": "QTS_300_024_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "昭應官舍",
    "poem": [
      "癡頑終日羨人閑，卻喜因官得近山。",
      "斜對寺樓分寂寂，遠從溪路借潺潺。",
      "眇身多病唯親藥，空院無錢不要關。",
      "文案把來看未會，雖書一字甚慚顏。"
    ]
  },
  {
    "uid": "QTS_300_025_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "寄舊山僧",
    "poem": [
      "因依老宿發心初，半學修心半讀書。",
      "雪後每常同席臥，花時未省兩山居。",
      "獵人箭底求傷雁，釣戶竿頭乞活魚。",
      "一向風塵取煩惱，不知衰病日難除。"
    ]
  },
  {
    "uid": "QTS_300_026_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "武陵春日",
    "poem": [
      "尋春何事卻悲涼，春到他鄉憶故鄉。",
      "秦女洞桃欹澗碧，楚王堤柳舞煙黃。",
      "波濤入夢家山遠，名利關身客路長。",
      "不似冥心叩塵寂，玉編金軸有仙方。"
    ]
  },
  {
    "uid": "QTS_300_027_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "寄分司張郎中",
    "poem": [
      "一別京華年歲久，卷中多見嶺南詩。",
      "聲名已壓眾人上，愁思未平雙鬢知。",
      "江郡遷移猶遠地，仙官榮寵是分司。",
      "青天白日當頭上，會有求閑不得時。"
    ]
  },
  {
    "uid": "QTS_300_028_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "上武元衡相公",
    "poem": [
      "旌旗坐鎮蜀江雄，帝命重開舊合崇。",
      "褒貶唐書天曆上，捧持堯日慶雲中。",
      "孤情迥出鸞皇遠，健思潛搜海嶽空。",
      "長得蕭何為國相，自西流水盡朝宗。"
    ]
  },
  {
    "uid": "QTS_300_029_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "上張弘靖相公",
    "poem": [
      "傳封三世盡河東，家占中條第一峰。",
      "旱歲天教作霖雨，明時帝用補山龍。",
      "草開舊路沙痕在，日照新池鳳跡重。",
      "卑散自知霄漢隔，若為門下賜從容。"
    ]
  },
  {
    "uid": "QTS_300_030_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "上裴度舍人",
    "poem": [
      "小松雙對鳳池開，履跡衣香逼上臺。",
      "天意皆從彩毫出，宸心盡向紫煙來。",
      "非時玉案呈宣旨，每日金階謝賜回。",
      "仙侶何因記名姓，縣丞頭白走塵埃。"
    ]
  },
  {
    "uid": "QTS_300_031_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "上杜元穎相公",
    "poem": [
      "學士金鑾殿後居，天中行坐侍龍輿。",
      "承恩不許離床謝，密詔常教倚案書。",
      "馬上喚遮紅觜鴨，船頭看釣赤鱗魚。",
      "閑曹散吏無相識，猶記荊州拜謁初。"
    ]
  },
  {
    "uid": "QTS_300_032_01",
    "volume": 300,
    "author": {
      "canonical": "王建",
      "recorded": "王建",
      "gender": "male",
      "wikidata_id": "Q697433"
    },
    "title": "贈盧汀諫議",
    "poem": [
      "青蛾不得在床前，空室焚香獨自眠。",
      "功證詩篇離景象，藥成官位屬神仙。",
      "閑過寺觀長沖夜，立送封章直上天。",
      "近見蘭臺諸吏說，禦詩新集未教傳。"
