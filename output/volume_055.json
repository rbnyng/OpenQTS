  {
    "uid": "QTS_055_004_01",
    "volume": 55,
    "author": {
      "canonical": "王勃",
      "recorded": "王勃",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Wang Bo",
      "wikidata_id": "Q1275321"
    },
    "title": "倬彼我系",
    "poem": [
      "伊我祖德，思濟九埏。",
      "不常厥所，於茲五遷。",
      "欲及時也，夫豈願焉。",
      "其位雖屈，其言則傳。"
    ]
  },
  {
    "uid": "QTS_055_005_01",
    "volume": 55,
