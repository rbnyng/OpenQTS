      "wikidata_id": "Q1275321"
    },
    "title": "倬彼我系",
    "poem": [
      "伊余小子，信慙明哲。",
      "彼網有條，彼車有轍。",
      "思屏人事，克終前烈。",
      "於嗟代網，卒余來絏。"
    ]
  },
  {
    "uid": "QTS_055_007_01",
    "volume": 55,
    "author": {
      "canonical": "王勃",
      "recorded": "王勃",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Wang Bo",
      "wikidata_id": "Q1275321"
    },
    "title": "倬彼我系",
    "poem": [
      "來絏伊何，謂余曰仕。",
      "我瞻先達，三十方起。",
      "夫豈不懷，高山仰止。",
      "願言毓德，啜菽飲水。"
    ]
  },
  {
    "uid": "QTS_055_008_01",
    "volume": 55,
    "author": {
      "canonical": "王勃",
      "recorded": "王勃",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Wang Bo",
      "wikidata_id": "Q1275321"
    },
    "title": "倬彼我系",
    "poem": [
      "有鳥反哺，其聲嗷嗷。",
      "言念舊德，憂心忉忉。",
      "今我不養，歲月其滔。",
      "僶俛從役，豈敢告勞。"
    ]
  },
  {
    "uid": "QTS_055_009_01",
    "volume": 55,
    "author": {
      "canonical": "王勃",
      "recorded": "王勃",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Wang Bo",
      "wikidata_id": "Q1275321"
    },
    "title": "倬彼我系",
    "poem": [
      "從役伊何，薄求卑位。",
      "告勞伊何，來參卿事。",
      "名存實爽，負信愆義。",
      "靜言遐思，中心是愧。"
    ]
  },
