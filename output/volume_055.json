      "period": "Early Tang",
      "english_name": "Wang Bo",
      "wikidata_id": "Q1275321"
    },
    "title": "倬彼我系",
    "poem": [
      "晉曆崩坼，衣冠擾弊。",
      "粵自太原，播徂江澨。",
      "禮喪賢隱，時屯道閉。",
      "王室如燬，生人多殪。"
    ]
  },
  {
    "uid": "QTS_055_003_01",
    "volume": 55,
    "author": {
