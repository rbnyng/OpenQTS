[
  {
    "uid": "QTS_729_001_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "秦門 胡亥",
    "poem": [
      "鹿馬何難辨是非，寧勞卜筮問安危。",
      "權臣為亂多如此，亡國時君不自知。"
    ]
  },
  {
    "uid": "QTS_729_002_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "秦門 再吟",
    "poem": [
      "盜賊縱橫主惡聞，遂為流矢犯君軒。",
      "怪言何不早言者，若使早言還不存。"
    ]
  },
  {
    "uid": "QTS_729_003_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "秦門 趙高",
    "poem": [
      "趙高、胡亥速天誅，率土興兵怨毒痡。",
      "豐沛見機羣小吏，功成兒戲亦何殊。"
    ]
  },
  {
    "uid": "QTS_729_004_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "秦門 陳涉",
    "poem": [
      "秦法煩苛霸業隳，一夫攘臂萬夫隨。",
      "王侯無種英雄志，燕雀喧喧安得知。"
    ]
  },
  {
    "uid": "QTS_729_005_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "秦門 項籍",
    "poem": [
      "九垓垂定棄謀臣，一陣無功便殺身。",
      "壯士誠知輕性命，不思辜負八千人。"
    ]
  },
  {
    "uid": "QTS_729_006_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "秦門 范增",
    "poem": [
      "智士寧為暗主謨，范公曾不讀兵書。",
      "平生心力為誰盡，一事無成空背疽。"
    ]
  },
  {
    "uid": "QTS_729_007_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "前漢門 高祖",
    "poem": [
      "愛子從烹報主時，安知強啜不含悲。",
      "太公懸命臨刀几，忍取桮羹欲為誰？"
    ]
  },
  {
    "uid": "QTS_729_008_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "前漢門 再吟",
    "poem": [
      "北伐匈奴事可悲，當時將相是其誰？",
      "君臣束手平城裏，三十萬兵能忍飢。"
    ]
  },
  {
    "uid": "QTS_729_009_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "前漢門 周苛紀信",
    "poem": [
      "為主堅能不顧身，赴湯蹈火見忠臣。",
      "後來邦國論心義，誰是君王出熱人。"
    ]
  },
  {
    "uid": "QTS_729_010_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "前漢門 酇侯",
    "poem": [
      "共怪酇侯第一功，咸稱得地合先封。",
      "韓生不是蕭君薦，獵犬何人為指蹤。"
    ]
  },
  {
    "uid": "QTS_729_011_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "前漢門 曲逆侯",
    "poem": [
      "社肉分平未足奇，須觀大用展無私。",
      "一朝如得宰天下，必使還如宰社時。"
    ]
  },
  {
    "uid": "QTS_729_012_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "前漢門 薛公",
    "poem": [
      "黥布稱兵孰敢當？薛公三計為斟量。",
      "上中良策知非用，南取長沙是死鄉。"
    ]
  },
  {
    "uid": "QTS_729_013_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "前漢門 條侯",
    "poem": [
      "上將風戈賞罰明，矛鋋嚴閉亞夫營。",
      "人君卻稟將軍令，按轡垂鞭為緩行。"
    ]
  },
  {
    "uid": "QTS_729_014_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "前漢門 平津侯",
    "poem": [
      "儒素逢時得自媒，忽從徒步列公台。",
      "北辰如不延吾輩，東閣何由逐汝開。"
    ]
  },
  {
    "uid": "QTS_729_015_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "前漢門 博陸侯",
    "poem": [
      "棟樑徒自保堅貞，毀穴難防雀鼠爭。",
      "不是主人知詐偽，如何柱石免欹傾。"
    ]
  },
  {
    "uid": "QTS_729_016_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "前漢門 夏賀良",
    "poem": [
      "漢代中微亦再昌，忠臣憂國冀修禳。",
      "赤精符讖誠非妄，枉殺無辜夏賀良。"
    ]
  },
  {
    "uid": "QTS_729_017_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "前漢門 王莽",
    "poem": [
      "權歸諸呂牝雞鳴，殷鑒昭然詎可輕。",
      "新室不因崇外戚，水中安敢寄生營。"
    ]
  },
  {
    "uid": "QTS_729_018_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "前漢門 再吟",
    "poem": [
      "重賦嚴刑作禍胎，豈知由此亂離媒。",
      "家傳揖讓亦難濟，況是身從傾篡來。"
    ]
  },
  {
    "uid": "QTS_729_019_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "前漢門 又吟",
    "poem": [
      "銅馬朱眉滿四方，總縁居攝亂天常。",
      "因君多少布衣士，不是公卿即帝王。"
    ]
  },
  {
    "uid": "QTS_729_020_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "前漢門 毛延壽",
    "poem": [
      "不拔金釵賂漢臣，徒嗟玉豔委胡塵。",
      "能知貨賄移妍醜，豈獨丹青畫美人。"
    ]
  },
  {
    "uid": "QTS_729_021_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "前漢門 劉聖公",
    "poem": [
      "不納良謀劉縯言，胡為銜璧向崇宣。",
      "傷哉亂帝途窮處，何必當時譖福先。"
    ]
  },
  {
    "uid": "QTS_729_022_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "前漢門 樊崇、徐宣",
    "poem": [
      "庸中佼佼鐵錚錚，百萬長驅入帝京。",
      "首事縱隳三善在，歸仁何慮不全生。"
    ]
  },
  {
    "uid": "QTS_729_023_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "前漢門 僭號公孫述",
    "poem": [
      "劍蜀金湯孰敢爭，子陽才業匪雄英。",
      "方知在德不在險，危棧何曾阻漢兵。"
    ]
  },
  {
    "uid": "QTS_729_024_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "後漢門 光武",
    "poem": [
      "成敗非儒孰可量，儒生何指指蕭王。",
      "蕭王得眾能寬裕，吳漢歸來帝業昌。"
    ]
  },
  {
    "uid": "QTS_729_025_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "後漢門 明帝",
    "poem": [
      "朝臣咸佞孰知非，張佚公忠語獨奇。",
      "博士一言除太傅，諡為明帝信其宜。"
    ]
  },
  {
    "uid": "QTS_729_026_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "後漢門 桓帝",
    "poem": [
      "能嫌跋扈斬梁王，寧便榮枯信段張。",
      "襄楷忠言誰佞惑，忍教奸禍起蕭牆。"
    ]
  },
  {
    "uid": "QTS_729_027_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "後漢門 靈帝",
    "poem": [
      "榜懸金價鬻官榮，千萬為公五百卿。",
      "公瑾、孔明窮退者，安知高臥遇雄英。"
    ]
  },
  {
    "uid": "QTS_729_028_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "後漢門 廢帝",
    "poem": [
      "亂兵如蝟走王師，社稷顛危孰為持。",
      "夜逐螢光尋道路，漢家天子步歸時。"
    ]
  },
  {
    "uid": "QTS_729_029_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "後漢門 獻帝",
    "poem": [
      "只為曹侯數貴人，普天黔首盡黃巾。",
      "漢靈早聽侍中諫，安得獻生稱不辰。"
    ]
  },
  {
    "uid": "QTS_729_030_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "後漢門 再吟",
    "poem": [
      "咸怨刑科有黨偏，耕夫無不事戎旃。",
      "是時老幼飢號處，一斛黃禾五百千。"
    ]
  },
  {
    "uid": "QTS_729_031_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "後漢門 子密",
    "poem": [
      "子密封侯豈所宜，能高德義必無為。",
      "當時若縛還彭氏，率土何憂不自歸。"
    ]
  },
  {
    "uid": "QTS_729_032_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "後漢門 羊續",
    "poem": [
      "魚懸潔白振清風，祿散親賔嵗自窮。",
      "單席寒廳慙使者，葛衣何以至三公？"
    ]
  },
  {
    "uid": "QTS_729_033_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "後漢門 楊震",
    "poem": [
      "為國推賢匪惠私，十金為報遽相危。",
      "無言暗室何人見，咫尺斯須已四知。"
    ]
  },
  {
    "uid": "QTS_729_034_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "後漢門 趙孝",
    "poem": [
      "緑林清旦正朝飢，豈計行人瘦與肥。",
      "為感在原哀叫切，鶺鴒休報聽雙飛。"
    ]
  },
  {
    "uid": "QTS_729_035_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "後漢門 馬後",
    "poem": [
      "麄衣閒寂閱羣書，薦達嬪妃廣帝居。",
      "再實傷根嫌貴寵，惠慈勞悴育皇儲。"
    ]
  },
  {
    "uid": "QTS_729_036_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "後漢門 魏博妻",
    "poem": [
      "蘿掛青松是所依，松凋蘿更改何枝。",
      "操刀必割腕可斷，磐石徒堅心不移。"
    ]
  },
  {
    "uid": "QTS_729_037_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "後漢門 曹娥",
    "poem": [
      "心摧目斷哭江濆，窺浪無蹤日又昬。",
      "不入重泉尋水底，此生安得見沈魂。"
    ]
  },
  {
    "uid": "QTS_729_038_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "後漢門 周都妻",
    "poem": [
      "緑水雙鴛一已沈，皇天更欲配何禽。",
      "不將血涕隨霜刃，誰見朱殷未死心。"
    ]
  },
  {
    "uid": "QTS_729_039_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "後漢門 鮑宣妻",
    "poem": [
      "君惡奢華意不歡，一言從儉亦何難。",
      "但能和樂同琴瑟，未必恩情在綺紈。"
    ]
  },
  {
    "uid": "QTS_729_040_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "後漢門 呂母",
    "poem": [
      "獄無良吏雪無由，處處戈鋋自執仇。",
      "呂母銜冤窮老婦，亦能為帥復私讎。"
    ]
  },
  {
    "uid": "QTS_729_041_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三國門 蜀先主",
    "poem": [
      "豫州軍敗信途窮，徐庶推能薦臥龍。",
      "不是卑詞三訪謁，誰令玄德主巴卭。"
    ]
  },
  {
    "uid": "QTS_729_042_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三國門 再吟",
    "poem": [
      "一家區宇忽三分，齷齪車書曷足論。",
      "定有伊薑為佐輔，忍教鴻雁各乾坤。"
    ]
  },
  {
    "uid": "QTS_729_043_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三國門 後主",
    "poem": [
      "萬峰如劍載前來，危閣橫空信險哉。",
      "對此玄休長歎息，方知劉禪是庸才。"
    ]
  },
  {
    "uid": "QTS_729_044_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三國門 吳後主",
    "poem": [
      "吳宮季主恣驕奢，移盡江南百媚花。",
      "一旦狂風江上起，花隨風散落誰家？"
    ]
  },
  {
    "uid": "QTS_729_045_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三國門 王表",
    "poem": [
      "王表聞聲莫見身，吳中敬事甚君親。",
      "是知邦國將亡滅，不聽人臣聽鬼神。"
    ]
  },
  {
    "uid": "QTS_729_046_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三國門 魯肅",
    "poem": [
      "輕財重義見英奇，聖主賢臣是所依。",
      "公瑾窘飢求子敬，一言纔起數船歸。"
    ]
  },
  {
    "uid": "QTS_729_047_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "晉門 晉武帝",
    "poem": [
      "漢貪金帛鬻公卿，財贍羸軍冀國寧。",
      "晉武鬻官私室富，是知猶不及桓靈。"
    ]
  },
  {
    "uid": "QTS_729_048_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "晉門 再吟",
    "poem": [
      "君人為理在安民，論道求賢德自新。",
      "經國逺圖無所問，何曾言指一何神。"
    ]
  },
  {
    "uid": "QTS_729_049_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "晉門 惠帝",
    "poem": [
      "蛙鳴堪笑問官私，更勸飢人食肉糜。",
      "蒙昧萬機猶婦女，寇戎安得不紛披。"
    ]
  },
  {
    "uid": "QTS_729_050_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "晉門 賈后",
    "poem": [
      "賈后甘為廢戮人，齊王還殺趙王倫。",
      "一從天下無真主，瓜割中原四百春。"
    ]
  },
  {
    "uid": "QTS_729_051_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "晉門 懷帝",
    "poem": [
      "蕃漢戈矛遍九垓，兩京簪紱走黃埃。",
      "劉聰大會平陽日，遣帝行觴事可哀。"
    ]
  },
  {
    "uid": "QTS_729_052_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "晉門 愍帝",
    "poem": [
      "耕牛喫盡大田荒，二兩黃金糴斗糧。",
      "卿粥又聞無麴屑，不降胡虜奈飢腸。"
    ]
  },
  {
    "uid": "QTS_729_053_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "晉門 郭欽",
    "poem": [
      "誰疑忠諫郭欽言，不逐戎夷出塞垣。",
      "晉室既無明聖主，果為胡虜亂中原。"
    ]
  },
  {
    "uid": "QTS_729_054_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "晉門 王夷甫",
    "poem": [
      "六合誰為輔弼臣，八風昬處盡胡塵。",
      "是知濟弱扶傾術，不屬高談虛論人。"
    ]
  },
  {
    "uid": "QTS_729_055_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "晉門 王茂弘",
    "poem": [
      "韓魏荊揚日豈堪，胡風看欲過江南。",
      "中原一片生靈血，誰秉王綱色不慙。"
    ]
  },
  {
    "uid": "QTS_729_056_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "晉門 吳隱之",
    "poem": [
      "聞說貪泉近鬱林，隱之今日得深斟。",
      "徒言滴水能穿石，其那堅貞匪石心。"
    ]
  },
  {
    "uid": "QTS_729_057_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "晉門 再吟",
    "poem": [
      "貪泉何處是泉源，只在靈臺一點間。",
      "必也心源元自有，此泉何必在江山。"
    ]
  },
  {
    "uid": "QTS_729_058_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 前趙劉聰",
    "poem": [
      "戎羯誰令識善言，刑將不捨遽能原。",
      "垂成卻罷鳳儀殿，仍改逍遙納諫園。"
    ]
  },
  {
    "uid": "QTS_729_059_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 前涼張軌",
    "poem": [
      "官從主簿至專征，誰遣涼王破趙名。",
      "益信用賢由拔擢，穰苴不是將家生。"
    ]
  },
  {
    "uid": "QTS_729_060_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 後魏武帝",
    "poem": [
      "太武南征似卷蓬，徐陽兗蔡殺皆空。",
      "從來弔伐寧如此，千里無煙血草紅。"
    ]
  },
  {
    "uid": "QTS_729_061_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 三廢帝",
    "poem": [
      "明莊節閔並罹殃，命在朱、高二悖王。",
      "已歎一年三易換，更嗟毆辱下東廊。"
    ]
  },
  {
    "uid": "QTS_729_062_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 苻堅",
    "poem": [
      "百萬南征幾馬歸，叛亡如蝟亦何悲。",
      "賔擒敵國諸戎主，更遣權兵過在誰？"
    ]
  },
  {
    "uid": "QTS_729_063_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 再呤",
    "poem": [
      "空知勇銳不知兵，困獸孤軍未可輕。",
      "安有長驅百餘萬，身馳幾旅欲先征。"
    ]
  },
  {
    "uid": "QTS_729_064_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 又吟",
    "poem": [
      "水影星光怪異多，不思修德事干戈。",
      "無謀拒諫仍輕敵，國破身擒將奈何。"
    ]
  },
  {
    "uid": "QTS_729_065_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 宋武帝",
    "poem": [
      "棲棲老楚未遭時，債主憑陵似迫危。",
      "人傑既為王謐識，刁逵誅斬獨何悲。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "債主",
        "variant": "悲憤",
        "source": "一作「悲憤」"
      }
    ]
  },
  {
    "uid": "QTS_729_066_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 二廢帝",
    "poem": [
      "肆意荒狂殺不辜，方嗟廢帝又蒼梧。",
      "自言威震為英武，肯慮湘東與玉夫。"
    ]
  },
  {
    "uid": "QTS_729_067_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 齊廢帝東昬侯",
    "poem": [
      "定策誰扶捕鼠兒，不憂蕭衍畏潘妃。",
      "長圍既合刀臨項，猶惜金錢對落暉。"
    ]
  },
  {
    "uid": "QTS_729_068_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 梁武帝",
    "poem": [
      "梁武年高厭六龍，繁華聲色盡歸空。",
      "不求賢德追堯舜，翻作憂囚一病翁。"
    ]
  },
  {
    "uid": "QTS_729_069_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 再吟",
    "poem": [
      "興亡何故遽環迴，湯紂身為事可哀。",
      "莫是自長嫌勝己，蔽賢猶執匹夫才。"
    ]
  },
  {
    "uid": "QTS_729_070_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 簡文帝",
    "poem": [
      "救兵方至強抽軍，與賊開城是簡文。",
      "曲項琵琶催酒處，不圖為樂向誰云？"
    ]
  },
  {
    "uid": "QTS_729_071_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 元帝",
    "poem": [
      "木柵江城困魏軍，王褒橫議遏謀臣。",
      "遦降未免俱為戮，一死安能謝益仁。"
    ]
  },
  {
    "uid": "QTS_729_072_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 謝舉",
    "poem": [
      "叛奴逃數豈堪留，忠節曾無肯到頭。",
      "朱异早能同遠見，青衫寧假帝登樓。"
    ]
  },
  {
    "uid": "QTS_729_073_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 朱异",
    "poem": [
      "徒覽儒書不學兵，彥和虗得不廉名。",
      "四郊多壘猶相罪，國破將何謝太清。"
    ]
  },
  {
    "uid": "QTS_729_074_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 傅昭",
    "poem": [
      "為政殘苛獸亦飢，除飢機在養疲羸。",
      "人能善政獸何暴，焉用勞人以檻為。"
    ]
  },
  {
    "uid": "QTS_729_075_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 宣帝",
    "poem": [
      "宣帝驕奢恣所為，後宮升降略無時。",
      "乘危自有妻公在，安許鸞凰是尉遲。"
    ]
  },
  {
    "uid": "QTS_729_076_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "六朝門 李集",
    "poem": [
      "忠諫能堅信正臣，三沈三屈竟何云。",
      "每沈良久方能語，及語還呼桀紂君。"
    ]
  },
  {
    "uid": "QTS_729_077_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "隋門 隋文帝",
    "poem": [
      "孤兒寡婦忍同欺，輔政剛教篡奪為。",
      "矯詔必能疎昉譯，直臣誠合重顏儀。"
    ]
  },
  {
    "uid": "QTS_729_078_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "隋門 獨孤後",
    "poem": [
      "腹生奚強有親疎，憐者為賢棄者愚。",
      "儲貳不遭讒搆死，隋亡寧便在江都。"
    ]
  },
  {
    "uid": "QTS_729_079_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "隋門 煬帝",
    "poem": [
      "拒諫勞兵作禍基，窮奢極武向戎夷。",
      "兆人疲弊不堪命，天下嗷嗷新主資。"
    ]
  },
  {
    "uid": "QTS_729_080_01",
    "volume": 729,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "隋門 賀若弼",
    "poem": [
      "破敵將軍意氣豪，請除傾國斬妖嬈。",
      "紅綃忍染嬌春雪，瞪目看行切玉刀。"
    ]
  }
]