[
  {
    "uid": "QTS_775_001_01",
    "volume": 775,
    "author": {
      "canonical": "崔江",
      "recorded": "崔江"
    },
    "title": "宜春郡城聞猨",
    "poem": [
      "怨抱霜枝向月啼，數聲清繞郡城低。",
      "那堪日夜有雲雨，便似巫山與建溪。"
    ]
  },
  {
    "uid": "QTS_775_002_01",
    "volume": 775,
    "author": {
      "canonical": "李伉",
      "recorded": "李伉",
      "gender": "male",
      "wikidata_id": "Q18909361"
    },
    "title": "謫宜陽到荊渚",
    "poem": [
      "漢江江水水連天，被謫宜陽路幾千。",
      "為問野人山鳥語，問予歸櫂是何年。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "問",
        "variant": "恨",
        "source": "一作「恨」"
      }
    ]
  },
  {
    "uid": "QTS_775_003_01",
    "volume": 775,
    "author": {
      "canonical": "劉望",
      "recorded": "劉望"
    },
    "title": "九嶷山",
    "poem": [
      "鼎湖冠劍有遺蹤，晉漢真人羽化同。",
      "九轉藥成丹竈冷，五車雲去玉堂空。",
      "仙家日月蓬壺裏，塵世煙花夢寐中。",
      "徒有舊山流水畔，老松枝葉苦吟風。"
    ],
    "notes": [
      {
        "content": "山在萍鄉，上有九嶷仙觀。",
        "context": "九嶷山",
        "original_title": "九嶷山",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_775_004_01",
    "volume": 775,
    "author": {
      "canonical": "易思",
      "recorded": "易思"
    },
    "title": "郡城放猨獻衛使君",
    "poem": [
      "千巖萬壑與雲連，放出雕籠任自然。",
      "葉灑驚風啼暮雨，月凝殘雪飲流泉。",
      "臨岐莫似三聲日，避射須依繞樹年。",
      "應解感恩尋太守，攀蘿時復到樓前。"
    ]
  },
  {
    "uid": "QTS_775_005_01",
    "volume": 775,
    "author": {
      "canonical": "易思",
      "recorded": "易思"
    },
    "title": "題袁州龍興寺",
    "poem": [
      "百尺古松松下寺，寶幡朱蓋畫珊珊。",
      "閒庭甘露幾回落，青石綠苔猶未乾。"
    ]
  },
  {
    "uid": "QTS_775_006_01",
    "volume": 775,
    "author": {
      "canonical": "易思",
      "recorded": "易思"
    },
    "title": "山中送弟方質",
    "poem": [
      "山中殷勤弟別兄，兄還送弟下山行。",
      "蘆花飛處秋風起，日暮不堪聞雁聲。"
    ]
  },
  {
    "uid": "QTS_775_007_01",
    "volume": 775,
    "author": {
      "canonical": "易思",
      "recorded": "易思"
    },
    "title": "尋易尊師不遇",
    "poem": [
      "爛熳紅霞光照衣，苔封白石路微微。",
      "華陽洞裏人何在，落盡松花不見歸。"
    ]
  },
  {
    "uid": "QTS_775_008_01",
    "volume": 775,
    "author": {
      "canonical": "趙防",
      "recorded": "趙防"
    },
    "title": "秋日寄弟",
    "poem": [
      "涼風颯庭戶，漸疑華髮侵。",
      "已經楊柳謝，猶聽蟪蛄吟。",
      "雨助灘聲出，雲連野色深。",
      "鶺鴒今在遠，年酒共誰斟？"
    ]
  },
  {
    "uid": "QTS_775_009_01",
    "volume": 775,
    "author": {
      "canonical": "劉廓",
      "recorded": "劉廓"
    },
    "title": "楊岐山",
    "poem": [
      "千峰圍古寺，深處敞樓臺。",
      "景異尋常處，人須特達來。",
      "松杉寒更茂，嵐靄晝還開。",
      "欲續豐碑語，含毫恨不才。"
    ]
  },
  {
    "uid": "QTS_775_010_01",
    "volume": 775,
    "author": {
      "canonical": "姚偓",
      "recorded": "姚偓"
    },
    "title": "南源山",
    "poem": [
      "修徑投幽隱，輕裘怯暮寒。",
      "閒僧能解榻，倦客得休鞍。",
      "白雨鳴山麓，青燈語夜闌。",
      "明朝梯石路，更仗筍輿安。"
    ]
  },
  {
    "uid": "QTS_775_011_01",
    "volume": 775,
    "author": {
      "canonical": "戴衢",
      "recorded": "戴衢"
    },
    "title": "下第夜吟",
    "poem": [
      "擾擾東西南北情，何人於此悟浮生。",
      "還緣無月春風夜，暫得獨聞流水聲。"
    ]
  },
  {
    "uid": "QTS_775_012_01",
    "volume": 775,
    "author": {
      "canonical": "戴衢",
      "recorded": "戴衢"
    },
    "title": "句",
    "poem": [
      "坐落千門日，吟殘午夜燈。"
    ]
  },
  {
    "uid": "QTS_775_013_01",
    "volume": 775,
    "author": {
      "canonical": "李建樞",
      "recorded": "李建樞"
    },
    "title": "詠月",
    "poem": [
      "昨夜圓非今夜圓，卻疑圓處減嬋娟。",
      "一年十二度圓缺，能得幾多時少年。"
    ]
  },
  {
    "uid": "QTS_775_014_01",
    "volume": 775,
    "author": {
      "canonical": "謝邈",
      "recorded": "謝邈"
    },
    "title": "謝人惠琴材",
    "poem": [
      "風撼桐絲帶月明，羽人乘醉截秋聲。",
      "七弦妙制饒仙品，三尺良材稱道情。",
      "池小未開春浪泛，岳低猶欠暮雲生。",
      "何因乞與元中術，臨化無妨膝上橫。"
    ]
  },
  {
    "uid": "QTS_775_015_01",
    "volume": 775,
    "author": {
      "canonical": "謝邈",
      "recorded": "謝邈"
    },
    "title": "謝僧寄拄杖",
    "poem": [
      "峭壁猨啼採處深，一枝奇異出孤岑。",
      "感師千里寄來意，發我片雲歸去心。",
      "窗外冷敲簷凍折，溪邊閒點戲魚沈。",
      "他年必藉相攜力，蹇步猶能返故林。"
    ]
  },
  {
    "uid": "QTS_775_016_01",
    "volume": 775,
    "author": {
      "canonical": "唐備",
      "recorded": "唐備"
    },
    "title": "失題二首 其一",
    "poem": [
      "天若無雪霜，青松不如草。",
      "地若無山川，何人重平道。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_775_016_02",
    "volume": 775,
    "author": {
      "canonical": "唐備",
      "recorded": "唐備"
    },
    "title": "失題二首 其二",
    "poem": [
      "一日天無風，四溟波盡息。",
      "人心風不吹，波浪高百尺。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_775_017_01",
    "volume": 775,
    "author": {
      "canonical": "唐備",
      "recorded": "唐備"
    },
    "title": "道傍木",
    "poem": [
      "狂風拔倒樹，樹倒根已露。",
      "上有數枝藤，青青猶未悟。"
    ]
  },
  {
    "uid": "QTS_775_018_01",
    "volume": 775,
    "author": {
      "canonical": "方棫",
      "recorded": "方棫"
    },
    "title": "失題",
    "poem": [
      "午醉醒來晚，無人夢自驚。",
      "夕陽如有意，長傍小窗明。"
    ],
    "notes": [
      {
        "content": "一作陳叔寶詩。",
        "context": "失題",
        "original_title": "失題",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_775_019_01",
    "volume": 775,
    "author": {
      "canonical": "范夜",
      "recorded": "范夜"
    },
    "title": "失題",
    "poem": [
      "舉意三江竭，興心四海枯。",
      "南遊李邕死，北望宋珪殂。"
    ]
  },
  {
    "uid": "QTS_775_020_01",
    "volume": 775,
    "author": {
      "canonical": "盧羣玉",
      "recorded": "盧羣玉"
    },
    "title": "失題",
    "poem": [
      "酒瀉銀瓶倒底清，夜深絲竹鳳凰鳴。",
      "紅妝醉起一花落，更引春風無限情。"
    ]
  },
  {
    "uid": "QTS_775_021_01",
    "volume": 775,
    "author": {
      "canonical": "盧羣玉",
      "recorded": "盧羣玉"
    },
    "title": "投盧尚書",
    "poem": [
      "無力不任為走役，有文安敢滯清平。",
      "從來若把耕桑定，免恃雕蟲悞此生。"
    ]
  },
  {
    "uid": "QTS_775_022_01",
    "volume": 775,
    "author": {
      "canonical": "楊行敏",
      "recorded": "楊行敏"
    },
    "title": "失題二首 其一",
    "poem": [
      "駑駘嘶叫知無定，騏驥低垂自有心。",
      "山上高松溪畔竹，清風纔動是知音。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_775_022_02",
    "volume": 775,
    "author": {
      "canonical": "楊行敏",
      "recorded": "楊行敏"
    },
    "title": "失題二首 其二",
    "poem": [
      "杜鵑花裏杜鵑啼，淺紫深紅更傍溪。",
      "遲日霽光搜客思，曉來山路恨如迷。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_775_023_01",
    "volume": 775,
    "author": {
      "canonical": "張懷",
      "recorded": "張懷"
    },
    "title": "吳江別王長史",
    "poem": [
      "多年襆被玉山岑，鬢雪欺人忽滿簪。",
      "駑馬雖然貪短豆，野麋終是憶長林。",
      "鱸魚未得乘歸興，鷗鳥惟應信此心。",
      "見說新橋好風景，會須乘月濯煩襟。"
    ]
  },
  {
    "uid": "QTS_775_024_01",
    "volume": 775,
    "author": {
      "canonical": "趙湘",
      "recorded": "趙湘"
    },
    "title": "題天台石橋",
    "poem": [
      "白石峰猶在，橫橋一徑微。",
      "多年無客過，落日有雲歸。",
      "水淨苔生髮，山寒樹著衣。",
      "如何方廣寺，千古去人稀。"
    ]
  },
  {
    "uid": "QTS_775_025_01",
    "volume": 775,
    "author": {
      "canonical": "楊持",
      "recorded": "楊持"
    },
    "title": "寄朗陵兄",
    "poem": [
      "刺舉官猶屈，風謠政已成。",
      "行看換龜組，奏最謁承明。"
    ]
  },
  {
    "uid": "QTS_775_026_01",
