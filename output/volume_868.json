    "title": "夢黃衣童子歌",
    "poem": [
      "中五之德方峨峨，胡胡呼呼何奈何。"
    ]
  },
  {
    "uid": "QTS_868_003_01",
    "volume": 868,
    "author": {
      "canonical": "劉禹錫",
      "recorded": "劉禹錫",
      "gender": "male",
