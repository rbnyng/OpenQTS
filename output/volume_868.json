    },
    "title": "夢揚州樂妓和詩",
    "poem": [
      "花作嬋娟玉作妝，風流爭似舊徐娘。",
      "夜深曲曲灣灣月，萬里隨君一寸腸。"
    ]
  },
  {
    "uid": "QTS_868_004_01",
    "volume": 868,
    "author": {
      "canonical": "邢鳳",
      "recorded": "邢鳳"
    },
    "title": "夢中美人歌",
    "poem": [
      "長安少女踏春陽，何處春陽不斷腸。",
      "舞袖弓彎渾忘卻，羅衣空換九秋霜。"
    ]
  },
  {
    "uid": "QTS_868_005_01",
    "volume": 868,
    "author": {
      "canonical": "石季武",
      "recorded": "石季武"
    },
    "title": "夢中詩",
    "poem": [
      "聳轡排金闕，乘軒上漢槎。",
      "浮名何足戀，高舉入煙霞。"
    ]
  },
  {
    "uid": "QTS_868_006_01",
    "volume": 868,
    "author": {
      "canonical": "王炎",
      "recorded": "王炎"
    },
    "title": "葬西施輓歌",
    "poem": [
      "西望吳王國，雲書鳳字牌。",
      "連江起珠帳，擇地葬金釵。",
      "滿地紅心草，三層碧玉階。",
      "春風無處所，淒恨不勝懷。"
    ]
  },
  {
    "uid": "QTS_868_007_01",
    "volume": 868,
    "author": {
      "canonical": "瀋亞之",
      "recorded": "瀋亞之"
    },
    "title": "秦夢詩三首：挽公主",
    "poem": [
      "泣葬一枝紅，生同死不同。",
      "金鈿墜芳草，香繡滿春風。",
      "舊日聞簫處，高樓當月中。",
      "梨花寒食夜，深閉翠微宮。"
    ],
    "part_index": 1,
    "total_parts": 3
  },
  {
    "uid": "QTS_868_007_02",
    "volume": 868,
    "author": {
      "canonical": "瀋亞之",
      "recorded": "瀋亞之"
    },
    "title": "秦夢詩三首：別穆公",
    "poem": [
      "擊髆舞，恨滿煙光無處所。",
      "淚如雨，欲擬著辭不成語。",
      "金鳳銜紅舊繡衣，幾度宮中同看舞。",
      "人間春日正歡樂，日暮東風何處去。"
    ],
    "part_index": 2,
    "total_parts": 3
  },
  {
    "uid": "QTS_868_007_03",
    "volume": 868,
    "author": {
      "canonical": "瀋亞之",
      "recorded": "瀋亞之"
    },
    "title": "秦夢詩三首：題宮門",
    "poem": [
      "君王多感放東歸，從此秦宮不復期。",
      "春景似傷秦喪主，落花如雨淚燕脂。"
    ],
    "part_index": 3,
    "total_parts": 3
  },
  {
    "uid": "QTS_868_008_01",
    "volume": 868,
    "author": {
      "canonical": "盧獻卿",
      "recorded": "盧獻卿",
      "gender": "male"
    },
    "title": "夢中詩",
    "poem": [
      "卜築郊原古，青山無四鄰。",
      "扶疏繞屋樹，寂寞獨歸人。"
    ]
  },
  {
    "uid": "QTS_868_009_01",
    "volume": 868,
    "author": {
      "canonical": "劉景復",
      "recorded": "劉景復"
    },
    "title": "夢為吳泰伯作勝兒歌",
    "poem": [
      "繁弦已停雜吹歇，勝兒調弄邏娑撥。",
      "四弦攏撚三五聲，喚起邊風駐明月。",
      "大聲嘈嘈奔淈淈，浪蹙波翻倒溟渤。",
      "小弦切切怨颸颸，鬼哭神悲秋窸窣。",
      "倒腕斜挑掣流電，春雷直戛騰秋鶻。",
      "漢妃徒得端正名，秦女虛誇有仙骨。",
      "我聞天寶十年前，涼州未作西戎窟。",
      "麻衣右衽皆漢民，不省胡塵暫蓬勃。",
      "太平之末狂胡亂，犬豕崩騰恣唐突。",
      "玄宗未到萬里橋，東洛西京一時沒。",
      "漢土民皆沒為虜，飲恨吞聲空嗢咽。",
      "時看漢月望漢天，怨氣沖星成彗孛。",
      "國門之西八九鎮，高城深壘閉閑卒。",
      "河湟咫尺不能收，挽粟推車徒兀兀。",
      "今朝聞奏涼州曲，使我心神暗超忽。",
      "勝兒若向邊塞彈，征人淚血應闌幹。"
    ]
  },
  {
    "uid": "QTS_868_010_01",
    "volume": 868,
    "author": {
      "canonical": "郭仁表",
      "recorded": "郭仁表"
    },
    "title": "夢中辭",
    "poem": [
      "飄風暴雨可思惟，鶴望巢門斂翅飛。",
      "吾道之宗正可依，萬物之先數在茲，不能行此欲何為。"
    ]
  },
  {
    "uid": "QTS_868_011_01",
    "volume": 868,
    "author": {
      "canonical": "國邵南",
      "recorded": "國邵南"
    },
    "title": "夢崔嘏妻詩",
    "poem": [
      "莫以真留妾，從他理管弦。",
      "容華難久駐，知得幾多年。"
    ]
  },
  {
    "uid": "QTS_868_012_01",
    "volume": 868,
    "author": {
      "canonical": "盧絳",
      "recorded": "盧絳"
    },
    "title": "夢白衣婦人歌詞",
    "poem": [
      "玉京人去秋蕭索，畫簷鵲起梧桐落。",
      "欹枕悄無言，月和殘夢圓。",
      "背燈惟暗泣，甚處砧聲急。",
      "眉黛小山攢，芭蕉生暮寒。",
      "清風明月夜深時，箕帚盧郎恨已遲。",
      "他日孟家坡上約，再來相見是佳期。"
    ]
  },
  {
    "uid": "QTS_868_013_01",
    "volume": 868,
    "author": {
      "canonical": "張生",
      "recorded": "張生"
    },
    "title": "夢舜撫琴歌",
    "poem": [
      "南風熏熏兮草芊芊，妙有之音兮歸清弦。",
      "蕩蕩之教兮由自然，熙熙之化兮吾道全，熏熏兮思何傳。"
    ]
  },
  {
    "uid": "QTS_868_014_01",
    "volume": 868,
    "author": {
      "canonical": "漳郡守",
      "recorded": "漳郡守",
      "gender": "male"
    },
    "title": "夢康仙示詩",
    "poem": [
      "賣藥因循未得還，卻因耽酒到人間。",
      "有心只戀琵琶阪，無意更登山上山。"
    ]
  },
  {
    "uid": "QTS_868_015_01",
    "volume": 868,
    "author": {
      "canonical": "獨孤遐叔妻白氏",
      "recorded": "獨孤遐叔妻白氏",
      "gender": "female"
    },
    "title": "夢中歌",
    "poem": [
      "今夕何夕，存耶沒耶？",
      "良人去兮天之涯，園樹傷心兮三見花。"
    ]
  },
  {
    "uid": "QTS_868_016_01",
    "volume": 868,
    "author": {
      "canonical": "張生妻",
      "recorded": "張生妻",
      "gender": "female"
    },
    "title": "夢中歌",
    "poem": [
      "歎衰草，絡緯聲切切。",
      "良人一去不復還，今夕坐愁鬢如雪。",
      "勸君酒，君莫辭。",
      "落花徒繞枝，流水無返期。",
      "莫恃少年時，少年能幾時。",
      "怨空閨，秋日亦難暮。",
      "夫婿斷音書，遙天雁空度。",
      "切切夕風急，露滋庭草濕。",
      "良人去不回，焉知掩閨泣。",
      "螢火穿白楊，悲風入荒草。",
      "疑是夢中游，愁迷故園道。",
      "花前始相見，花下又相送。",
      "何必言夢中，人生盡如夢。"
    ]
  },
  {
    "uid": "QTS_868_017_01",
    "volume": 868,
    "author": {
      "canonical": "張氏女",
      "recorded": "張氏女",
      "gender": "female"
    },
    "title": "夢王尚書口授吟",
    "poem": [
      "鬟梳鬧掃學宮妝，獨立閒庭納夜涼。",
      "手把玉簪敲砌竹，清歌一曲月如霜。"
    ]
  },
  {
    "uid": "QTS_868_018_01",
    "volume": 868,
    "author": {
      "canonical": "病狂人",
      "recorded": "病狂人"
    },
    "title": "歌",
    "poem": [
      "踏陽春，人間三月雨和塵。",
      "陽春踏，秋風起，腸斷人間白髮人。",
      "五靈華，曉玲瓏，天府由來汝府中。",
      "惆悵此情言不盡，一丸蘿蔔火吾宮。"
    ]
  },
  {
    "uid": "QTS_868_019_01",
    "volume": 868,
    "author": {
      "canonical": "陳季卿",
      "recorded": "陳季卿",
      "gender": "male"
    },
    "title": "題禪窟蘭若",
    "poem": [
      "霜鐘鳴時夕風急，亂鴉又望寒林集。",
      "此時輟棹悲且吟，獨向蓮華一峰立。"
    ]
  },
  {
    "uid": "QTS_868_020_01",
    "volume": 868,
    "author": {
      "canonical": "陳季卿",
      "recorded": "陳季卿",
      "gender": "male"
    },
    "title": "題潼關普通院門",
    "poem": [
      "度關悲失志，萬緒亂心機。",
      "下阪馬無力，掃門塵滿衣。",
      "計謀多不就，心口自相違。",
      "已作羞歸計，還勝羞不歸。"
    ]
  },
  {
    "uid": "QTS_868_021_01",
    "volume": 868,
    "author": {
      "canonical": "陳季卿",
      "recorded": "陳季卿",
      "gender": "male"
    },
    "title": "江亭晚望題書齋",
    "poem": [
      "立向江亭滿目愁，十年前事信悠悠。",
      "田園已逐浮雲散，鄉里半隨逝水流。",
      "川上莫逢諸釣叟，浦邊難得舊沙鷗。",
      "不緣齒發未遲暮，吟對遠山堪白頭。"
    ]
  },
  {
    "uid": "QTS_868_022_01",
    "volume": 868,
    "author": {
      "canonical": "陳季卿",
      "recorded": "陳季卿",
      "gender": "male"
    },
    "title": "別妻",
    "poem": [
      "月斜寒露白，此夕去留心。",
      "酒至添愁飲，詩成和淚吟。",
      "離歌淒鳳管，別鶴怨瑤琴。",
      "明夜相思處，秋風吹半衾。"
    ]
  },
  {
    "uid": "QTS_868_023_01",
    "volume": 868,
    "author": {
      "canonical": "陳季卿",
      "recorded": "陳季卿",
      "gender": "male"
    },
    "title": "別兄弟",
    "poem": [
      "謀身非不早，其奈命來遲。",
      "舊友皆霄漢，此身猶路岐。",
      "北風微雪後，晚景有雲時。",
      "惆悵清江上，區區趁試期。"
    ]
  },
  {
    "uid": "QTS_868_024_01",
    "volume": 868,
    "author": {
      "canonical": "周延翰",
      "recorded": "周延翰"
    },
    "title": "夢中句",
    "poem": [
      "紫髯之伴有丹砂。"
    ]
  },
  {
    "uid": "QTS_868_025_01",
    "volume": 868,
    "author": {
      "canonical": "任臒",
      "recorded": "任臒"
    },
    "title": "夢中和句",
    "poem": [
      "故國路遙歸去來，春風天遠望不盡。"
    ]
  },
  {
