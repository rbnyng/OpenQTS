    "title": "句 其三",
    "poem": [
      "百骸同草木，萬象入心靈。"
    ],
    "part_index": 3,
    "total_parts": 3
  },
  {
    "uid": "QTS_741_004_01",
    "volume": 741,
    "author": {
      "canonical": "江為",
      "recorded": "江為",
      "gender": "male",
      "wikidata_id": "Q22098538"
    },
    "title": "旅懷",
    "poem": [
      "迢迢江漢路，秋色又堪驚。",
      "半夜聞鴻雁，多年別弟兄。",
      "高風雲影斷，微雨菊花明。",
      "欲寄東歸信，裴回無限情。"
    ]
  },
  {
    "uid": "QTS_741_005_01",
    "volume": 741,
    "author": {
      "canonical": "江為",
      "recorded": "江為",
      "gender": "male",
      "wikidata_id": "Q22098538"
    },
    "title": "江行",
    "poem": [
      "越信隔年稀，孤舟幾夢歸。",
      "月寒花露重，江晚水煙微。",
      "峰直帆相望，沙空鳥自飛。",
      "何時洞庭上，春雨滿蓑衣。"
    ]
  },
  {
    "uid": "QTS_741_006_01",
    "volume": 741,
    "author": {
      "canonical": "江為",
      "recorded": "江為",
      "gender": "male",
      "wikidata_id": "Q22098538"
    },
    "title": "登潤州城",
    "poem": [
      "天末江城晚，登臨客望迷。",
      "春潮平島嶼，殘雨隔虹蜺。",
      "鳥與孤帆遠，煙和獨樹低。",
      "鄉山何處是？目斷廣陵西。"
    ]
  },
  {
    "uid": "QTS_741_007_01",
    "volume": 741,
    "author": {
      "canonical": "江為",
      "recorded": "江為",
      "gender": "male",
      "wikidata_id": "Q22098538"
    },
    "title": "岳陽樓",
    "poem": [
      "倚樓高望極，展轉念前途。",
      "晚葉紅殘楚，秋江碧入吳。",
      "雲中來鴈急，天末去帆孤。",
      "明月誰同我，悠悠上帝都。"
    ]
  },
  {
    "uid": "QTS_741_008_01",
    "volume": 741,
    "author": {
      "canonical": "江為",
      "recorded": "江為",
      "gender": "male",
      "wikidata_id": "Q22098538"
    },
    "title": "送客",
    "poem": [
      "明月孤舟遠，吟髭鑷更華。",
      "天形圍澤國，秋色露人家。",
      "水館螢交影，霜洲橘委花。",
      "何當尋舊隱，泉石好生涯。"
    ]
  },
  {
    "uid": "QTS_741_009_01",
    "volume": 741,
    "author": {
      "canonical": "江為",
      "recorded": "江為",
      "gender": "male",
      "wikidata_id": "Q22098538"
    },
    "title": "臨刑詩",
    "poem": [
      "街鼓侵人急，西傾日欲斜。",
      "黃泉無旅店，今夜宿誰家。"
    ]
  },
  {
    "uid": "QTS_741_010_01",
    "volume": 741,
    "author": {
      "canonical": "江為",
      "recorded": "江為",
      "gender": "male",
      "wikidata_id": "Q22098538"
    },
    "title": "塞下曲",
    "poem": [
      "萬里黃雲凍不飛，磧煙烽火夜深微。",
      "胡兒移帳寒笳絕，雪路時聞探馬歸。"
    ]
  },
  {
    "uid": "QTS_741_011_01",
    "volume": 741,
    "author": {
      "canonical": "江為",
      "recorded": "江為",
      "gender": "male",
      "wikidata_id": "Q22098538"
    },
    "title": "隋堤柳",
    "poem": [
      "錦纜龍舟萬里來，醉鄉繁盛忽塵埃。",
      "空餘兩岸千株柳，雨葉風花作恨媒。"
    ]
  },
