[
  {
    "uid": "QTS_772_001_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "奉和登會昌山應制",
    "poem": [
      "睿想入希夷，真遊到具茨。",
      "玉鸞登嶂遠，雲輅出花遲。",
      "泉壑凝神處，陽和布澤時。",
      "六龍多順動，四海正雍熙。"
    ],
    "notes": [
      {
        "content": "一作錢起詩。",
        "context": "奉和登會昌山應制",
        "original_title": "奉和登會昌山應制",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_772_002_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "王瓚 冬日與羣公泛舟焦山",
    "poem": [
      "江外水不凍，今年寒復遲。",
      "眾芳且未歇，近臘仍袷衣。",
      "載酒適我情，興來趣漸微。",
      "方舟大川上，環酌對落暉。",
      "兩片青石稜，波際無因依。",
      "三山安可到，欲到風引歸。",
      "滄溟壯觀多，心目豁暫時。",
      "況得窮日夕，乘槎何所之。",
      "縱步不知遠，夕陽猶未回。",
      "好花隨處發，流水趁人來。"
    ],
    "notes": [
      {
        "type": "title_note",
        "content": "詩二首",
        "context": "王瓚"
      }
    ],
    "variants": [
      {
        "line": 1,
        "text": "外水",
        "variant": "水初",
        "source": "一作「水初」"
      }
    ]
  },
  {
    "uid": "QTS_772_003_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "慕容韋 度揭鴻嶺",
    "poem": [
      "閩越曾為塞，將軍舊置營。",
      "我歌空感慨，西北望神京。"
    ],
    "notes": [
      {
        "type": "title_note",
        "content": "詩一首",
        "context": "慕容韋"
      },
      {
        "content": "漳州。",
        "context": "度揭鴻嶺",
        "original_title": "度揭鴻嶺",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_772_004_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "黃文 湘江",
    "poem": [
      "瀟湘江頭三月春，柳條弄日搖黃金。",
      "鷓鴣一聲在何許，黃陵廟前煙靄深。",
      "丹青欲畫無好手，穩提玉勒沈吟久。",
      "馬蹄不為行客留，心掛長林屢回首。"
    ],
    "notes": [
      {
        "type": "title_note",
        "content": "詩一首",
        "context": "黃文"
      }
    ]
  },
  {
    "uid": "QTS_772_005_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "唐溫如 題龍陽縣青草湖",
    "poem": [
      "西風吹老洞庭波，一夜湘君白髮多。",
      "醉後不知天在水，滿船清夢壓星河。"
    ],
    "notes": [
      {
        "type": "title_note",
        "content": "詩一首",
        "context": "唐溫如"
      }
    ]
  },
  {
    "uid": "QTS_772_006_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "歐陽賓 訾家洲",
    "poem": [
      "舊業分明桂水頭，人歸業盡水東流。",
      "春風日暮江頭立，不及漁人有釣舟。"
    ],
    "notes": [
      {
        "type": "title_note",
        "content": "詩一首",
        "context": "賓"
      }
    ]
  },
  {
    "uid": "QTS_772_007_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "何敬 題吉州龍溪",
    "poem": [
      "龍溪之山秀而峙，龍溪之水清無底。",
      "狂風激烈翻春濤，薄霧冥濛溢清泚。",
      "奔流百折銀河通，落花滾滾浮霞紅。",
      "四時佳境不可窮，仿佛直與桃源通。"
    ],
    "notes": [
      {
        "type": "title_note",
        "content": "詩一首",
        "context": "何敬"
      }
    ]
  },
  {
    "uid": "QTS_772_008_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "楊彝 過睦州青溪渡",
    "poem": [
      "天闊銜江雨，冥冥上客衣。",
      "潭清魚可數，沙晚鴈爭飛。",
      "川谷留雲氣，鵜鶘傍釣磯。",
      "飄零江海客，欹側一帆歸。"
    ],
    "notes": [
      {
        "type": "title_note",
        "content": "詩一首",
        "context": "楊彝"
      }
    ]
  },
  {
    "uid": "QTS_772_009_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "裴瑤 闔閭城懷古",
    "poem": [
      "五湖春水接遙天，國破君亡不記年。",
      "惟有妖娥曾舞處，古臺寂寞起愁煙。"
    ],
    "notes": [
      {
        "type": "title_note",
        "content": "詩一首",
        "context": "裴瑤"
      }
    ]
  },
  {
    "uid": "QTS_772_010_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "鄭玉 葦谷",
    "poem": [
      "水會三川漾碧波，雕陰人唱採花歌。",
      "舊時白翟今荒壤，葦谷淒淒風雨多。"
    ],
    "notes": [
      {
        "type": "title_note",
        "content": "詩一首",
        "context": "鄭玉"
      }
    ]
  },
  {
    "uid": "QTS_772_011_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "麻溫其 登岳陽樓",
    "poem": [
      "湖邊景物屬秋天，樓上風光似去年。",
      "仙侶緱生留福地，湘娥帝子寄哀弦。",
      "雲門自統軒臺外，木葉偏飛楚客前。",
      "極目江山何處是，一帆萬里信歸船。"
    ],
    "notes": [
      {
        "type": "title_note",
        "content": "詩一首",
        "context": "麻溫其"
      }
    ]
  },
  {
    "uid": "QTS_772_012_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "韋鎰 經望湖驛",
    "poem": [
      "大漠無屯雲，孤峰出亂柳。",
      "前驅白登道，顧失飛狐口。",
      "遙憶代王城，俯臨恆山後。",
      "纍纍多古墓，寂寞為墟久。",
      "豈不固金湯，終聞擊銅斗。",
      "交懽初仗信，接讌翻貽咎。",
      "埋寶賊夫人，磨笄傷彼婦。",
      "功成行且薄，義立名不朽。",
      "莫慎纖微端，其何社稷守。",
      "身歿國遂亡，此立人君醜。"
    ],
    "notes": [
      {
        "type": "title_note",
        "content": "詩一首",
        "context": "韋鎰"
      }
    ]
  },
  {
    "uid": "QTS_772_013_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "謝太虛 杪秋洞庭懷王道士",
    "poem": [
      "漂泊日復日，洞庭今更秋。",
      "青桃亦何意，此夜催人愁。",
      "惆悵客中月，裴回江上樓。",
      "心知楚天遠，目送滄波流。",
      "謝客久已滅，微言無處求。",
      "空餘白雲在，客興隨孤舟。",
      "千里杳難盡，一身常獨遊。",
      "故園復何許，江漢徒遲留。"
    ],
    "notes": [
      {
        "type": "title_note",
        "content": "詩一首",
        "context": "謝太虛"
      }
    ]
  },
  {
    "uid": "QTS_772_014_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "周岳秀 君山祠",
    "poem": [
      "萬頃湖波浸碧天，旌封香火幾千年。",
      "風濤澎湃魚龍舞，棟宇崢嶸燕雀遷。",
      "遠岫光中濃淡樹，斜陽影裏徃來船。",
      "江河願借吹噓便，應有神功在目前。"
    ],
    "notes": [
      {
        "type": "title_note",
        "content": "詩一首",
        "context": "周岳秀"
      }
    ]
  },
  {
    "uid": "QTS_772_015_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "馬逢 新樂府",
    "poem": [
      "溫谷春生至，宸游近甸榮。",
      "雲隨天上轉，風入御筵輕。",
      "翠蓋浮佳氣，朱樓依太清。",
      "朝臣冠劍退，宮女管弦迎。"
    ],
    "notes": [
      {
        "type": "title_note",
        "content": "詩五首",
        "context": "馬逢"
      }
    ]
  },
  {
    "uid": "QTS_772_016_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "馬逢 部落曲",
    "poem": [
      "蕃軍傍塞游，代馬噴風秋。",
      "老將垂金甲，閼支著錦裘。",
      "雕戈蒙豹尾，紅旆插狼頭。",
      "日暮天山下，鳴笳漢使愁。"
    ]
  },
  {
    "uid": "QTS_772_017_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "馬逢 從軍",
    "poem": [
      "漢馬千蹄合一群，單于鼓角隔山聞。",
      "沙塠風起紅樓下，飛上胡天作陣雲。"
    ]
  },
  {
    "uid": "QTS_772_018_01",
    "volume": 772,
    "author": {
      "canonical": "趙起",
      "recorded": "趙起"
    },
    "title": "馬逢 宮詞二首 其一",
    "poem": [
      "金吾持戟護軒簷，天樂傳教萬姓瞻。",
      "樓上美人相倚看，紅妝透出水晶簾。"
    ],
    "notes": [
      {
        "content": "一作顧況詩。",
        "context": "宮詞二首",
        "original_title": "宮詞二首",
