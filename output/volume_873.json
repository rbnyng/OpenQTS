    },
    "title": "題洛陽縣壁",
    "poem": [
      "猾吏畏服，縣妖破膽。",
      "好錄政聲，聞於御覽。"
    ]
  },
  {
    "uid": "QTS_873_002_01",
    "volume": 873,
    "author": {
      "canonical": "杜兼",
      "recorded": "杜兼",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Du Jian",
      "wikidata_id": "Q18906569"
    },
    "title": "題書卷後語",
    "poem": [
      "倩俸寫來手自校，汝曹讀之知聖道，墜之鬻之為不孝。"
    ]
  },
  {
    "uid": "QTS_873_003_01",
    "volume": 873,
    "author": {
      "canonical": "舒元輿",
      "recorded": "舒元輿",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Shu Yuanyu",
      "wikidata_id": "Q30018000"
    },
    "title": "題李陽冰玉箸篆詞",
    "poem": [
      "斯去千年，冰生唐時。",
      "冰複去矣，後來者誰？",
      "後千年有人，誰能待之。",
      "後千年無人，篆止於斯。",
      "嗚呼主人，為吾寶之。"
    ]
  },
  {
    "uid": "QTS_873_004_01",
    "volume": 873,
    "author": {
      "canonical": "裴諝",
      "recorded": "裴諝",
      "gender": "male",
      "period": "High Tang",
      "english_name": "Pei Xu",
      "wikidata_id": "Q18907048"
    },
    "title": "判誤書紙背",
    "poem": [
      "這畔似那畔，那畔似這畔。",
      "我也不辭與你判，笑殺門前著靴漢。"
    ]
  },
  {
    "uid": "QTS_873_005_01",
    "volume": 873,
    "author": {
      "canonical": "裴諝",
      "recorded": "裴諝",
      "gender": "male",
      "period": "High Tang",
      "english_name": "Pei Xu",
      "wikidata_id": "Q18907048"
    },
    "title": "又判爭貓兒狀",
    "poem": [
      "貓兒不識主，傍家搦老鼠。",
      "兩家不須爭，將來與裴諝。"
    ]
  },
  {
    "uid": "QTS_873_006_01",
    "volume": 873,
    "author": {
      "canonical": "李翱",
      "recorded": "李翱",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Li Ao",
      "wikidata_id": "Q700284"
    },
    "title": "斷僧通狀",
    "poem": [
      "上歲童子，二十受戒。",
      "君王不朝，父母不拜。",
      "口稱貧道，有錢放債。",
      "量決十下，牒出東界。"
    ]
  },
  {
    "uid": "QTS_873_007_01",
    "volume": 873,
    "author": {
      "canonical": "韓滉",
      "recorded": "韓滉",
      "gender": "male",
      "period": "High Tang",
      "english_name": "Han Huang",
      "wikidata_id": "Q31758"
    },
    "title": "判僧雲晏五人聚賭喧諍語",
    "poem": [
      "正法何曾執貝，空門不積餘財。",
      "白日既能賭博，通宵必醉尊罍。",
      "強說天堂難到，又言地獄長開。",
      "並付江神收管，波中便是泉台。"
    ]
  },
  {
    "uid": "QTS_873_008_01",
    "volume": 873,
    "author": {
      "canonical": "皇甫大夫",
      "recorded": "皇甫大夫"
    },
    "title": "判道士黃山隱",
    "poem": [
      "道士黃山隱，輕人複重財。",
      "太山將比甑，東海只容杯。",
      "綠綬藏雲帔，烏巾換鹿胎。",
      "黃泉六個鬼，今夜待君來。"
    ]
  },
  {
    "uid": "QTS_873_009_01",
    "volume": 873,
    "author": {
      "canonical": "羅紹戚",
      "recorded": "羅紹戚"
    },
    "title": "碾驢鞍判",
    "poem": [
      "鄴城大道甚寬，何故駕車碾鞍？",
      "領韝驢漢子科決，待駕車漢子喜歡。"
    ]
  },
  {
    "uid": "QTS_873_010_01",
    "volume": 873,
    "author": {
      "canonical": "蕭結",
      "recorded": "蕭結"
    },
    "title": "批州符",
    "poem": [
      "秧開五葉，蠶長三眠。",
      "人皆忙迫，劃甚閑船。"
    ]
  },
  {
    "uid": "QTS_873_011_01",
    "volume": 873,
    "author": {
      "canonical": "王魯",
      "recorded": "王魯",
      "gender": "male",
      "wikidata_id": "Q18118866"
    },
    "title": "判部民訴主簿牒",
    "poem": [
      "汝雖打草，吾已驚蛇。"
    ]
  },
  {
    "uid": "QTS_873_012_01",
    "volume": 873,
    "author": {
      "canonical": "伶人",
      "recorded": "伶人"
    },
    "title": "戲為冥吏判",
    "poem": [
      "焦湖百里，一任作獺。"
    ]
  },
  {
    "uid": "QTS_873_013_01",
    "volume": 873,
    "author": {
      "canonical": "張翱",
      "recorded": "張翱"
    },
    "title": "自狀",
    "poem": [
      "有張翱兮，寓止淮陰。",
      "來綺席兮，放恣胸襟。"
    ]
  },
  {
    "uid": "QTS_873_014_01",
    "volume": 873,
    "author": {
      "canonical": "趙武建",
      "recorded": "趙武建"
    },
    "title": "刺左右膊詩",
    "poem": [
      "野鴨灘頭宿，朝朝被鶻梢。",
      "忽驚飛入水，留命到今朝。"
    ]
  },
  {
    "uid": "QTS_873_015_01",
    "volume": 873,
    "author": {
      "canonical": "宋元素",
      "recorded": "宋元素"
    },
    "title": "刺左臂膊詩",
    "poem": [
      "昔日已前家未貧，苦將錢物結交親。",
      "如今失路尋知己，行盡關山無一人。"
    ]
  },
  {
    "uid": "QTS_873_016_01",
    "volume": 873,
    "author": {
      "canonical": "張幹",
      "recorded": "張幹"
    },
    "title": "刺左右膊句",
    "poem": [
      "生不怕京兆尹，死不畏閻羅王。"
    ]
  }
]