[
  {
    "uid": "QTS_010_001_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祀圜丘樂章 豫和",
    "poem": [
      "上靈睠命膺會昌，盛德殷薦葉辰良。",
      "景福降兮聖德遠，玄化穆兮天曆長。"
    ]
  },
  {
    "uid": "QTS_010_002_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祀圜丘樂章 太和",
    "poem": [
      "穆穆我後，道應千齡。",
      "登三處大，得一居貞。",
      "禮惟崇德，樂以和聲。",
      "百神仰止，天下文明。"
    ]
  },
  {
    "uid": "QTS_010_003_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祀圜丘樂章 肅和",
    "poem": [
      "闓陽播氣，甄曜垂明。",
      "有赫圜宰，深仁曲成。",
      "日麗蒼璧，煙開紫營。",
      "聿遵乾享，式降鴻禎。"
    ]
  },
  {
    "uid": "QTS_010_004_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祀圜丘樂章 雍和",
    "poem": [
      "欽惟大帝，戴仰皇穹。",
      "始命田燭，爰啟郊宮。",
      "雲門駭聽，雷鼓鳴空。",
      "神其介祀，景祚斯融。"
    ]
  },
  {
    "uid": "QTS_010_005_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祀圜丘樂章 壽和",
    "poem": [
      "八音斯奏，三獻畢陳。",
      "寶祚惟永，暉光日新。"
    ]
  },
  {
    "uid": "QTS_010_006_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祀圜丘樂章 舒和",
    "poem": [
      "疊璧凝影皇壇路，編珠流彩帝郊前。",
      "已奏黃鍾歌大呂，還符寶曆祚昌年。"
    ]
  },
  {
    "uid": "QTS_010_007_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祀圜丘樂章 凱安",
    "poem": [
      "昔在炎運終，中華亂無象。",
      "酆郊赤烏見，邙山黑雲上。",
      "大賚下周車，禁暴開殷網。",
      "幽明同葉贊，鼎祚齊天壤。"
    ]
  },
  {
    "uid": "QTS_010_008_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祀圜丘樂章 豫和",
    "poem": [
      "歌奏畢兮禮獻終，六龍馭兮神將昇。",
      "明德感兮非黍稷，降福簡兮祚休徵。"
    ]
  },
  {
    "uid": "QTS_010_009_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 郊天舊樂章 豫和",
    "poem": [
      "蘋蘩禮著，黍稷誠微。",
      "音盈鳳管，彩駐龍旂。",
      "洪歆式就，介福攸歸。",
      "送樂有闋，靈馭遄飛。"
    ]
  },
  {
    "uid": "QTS_010_010_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 郊天舊樂章 武后大享昊天樂章",
    "poem": [
      "大陰凝至化，真耀蘊軒儀。",
      "德邁娥臺敞，仁高姒幄披。",
      "捫天遂啟極，夢日乃昇曦。"
    ]
  },
  {
    "uid": "QTS_010_011_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 郊天舊樂章 武后大享昊天樂章",
    "poem": [
      "瞻紫極，望玄穹。",
      "翹至懇，罄深衷。",
      "聽雖遠，誠必通。",
      "垂厚澤，降雲宮。"
    ]
  },
  {
    "uid": "QTS_010_012_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 郊天舊樂章 武后大享昊天樂章",
    "poem": [
      "乾儀混成沖邃，天道下濟高明。",
      "闓陽晨披紫闕，太一曉降黃庭。",
      "圓壇敢申昭報，方璧冀展虔情。",
      "丹襟式敷衷懇，玄鑒庶察微誠。"
    ]
  },
  {
    "uid": "QTS_010_013_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 郊天舊樂章 武后大享昊天樂章",
    "poem": [
      "巍巍睿業廣，赫赫聖基隆。",
      "菲德承先顧，禎符萃眇躬。",
      "銘開武巖側，圖薦洛川中。",
      "微誠詎幽感，景命忽昭融。",
      "有懷慙紫極，無以謝玄穹。"
    ]
  },
  {
    "uid": "QTS_010_014_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 郊天舊樂章 武后大享昊天樂章",
    "poem": [
      "朝壇霧卷，曙嶺煙沈。",
      "爰設筐幣，式表誠心。",
      "筵輝麗璧，樂暢和音。",
      "仰惟靈鑒，俯察翹襟。"
    ]
  },
  {
    "uid": "QTS_010_015_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 郊天舊樂章 武后大享昊天樂章",
    "poem": [
      "昭昭上帝，穆穆下臨。",
      "禮崇備物，樂奏鏘金。",
      "蘭羞委薦，桂醑盈斟。",
      "敢希靈德，聿罄莊心。"
    ]
  },
  {
    "uid": "QTS_010_016_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 郊天舊樂章 武后大享昊天樂章",
    "poem": [
      "罇浮九醞，禮備三周。",
      "陳誠菲奠，契福神猷。"
    ]
  },
  {
    "uid": "QTS_010_017_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 郊天舊樂章 武后大享昊天樂章",
    "poem": [
      "奠璧郊壇昭大禮，鏘金拊石表虔誠。",
      "始奏承雲娛帝賞，復歌調露暢韶英。"
    ]
  },
  {
    "uid": "QTS_010_018_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 郊天舊樂章 武后大享昊天樂章",
    "poem": [
      "荷恩承顧託，執契恭臨撫。",
      "廟畧靜邊荒，天兵耀神武。",
      "有截資先化，無為遵舊矩。",
      "禎符降昊穹，大業光寰宇。"
    ]
  },
  {
    "uid": "QTS_010_019_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 郊天舊樂章 武后大享昊天樂章",
    "poem": [
      "肅肅祀典，邕邕禮秩。",
      "三獻已周，九成斯畢。",
      "爰撤其俎，載遷其實。",
      "或升或降，唯誠唯質。"
    ]
  },
  {
    "uid": "QTS_010_020_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 郊天舊樂章 武后大享昊天樂章",
    "poem": [
      "禮終肆類，樂闋九成。",
      "仰惟明德，敢薦非馨。",
      "顧慙菲奠，久駐雲軿。",
      "瞻荷靈澤，悚戀兼盈。"
    ]
  },
  {
    "uid": "QTS_010_021_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 郊天舊樂章 武后大享昊天樂章",
    "poem": [
      "式乾路，闢天扉。",
      "迴日馭，動雲衣。",
      "登金闕，入紫微。",
      "望仙駕，仰恩徽。"
    ]
  },
  {
    "uid": "QTS_010_022_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 中宗祀昊天樂章 豫和",
    "poem": [
      "天之曆數歸睿唐，顧惟菲德欽昊蒼。",
      "撰吉日兮表殷薦，冀神鑒兮降闓陽。"
    ]
  },
  {
    "uid": "QTS_010_023_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 中宗祀昊天樂章 太和",
    "poem": [
      "恭臨寶位，肅奉瑤圖。",
      "恆思解網，每軫泣辜。",
      "德慚巢燧，化劣唐虞。",
      "期我良弼，式贊嘉謨。"
    ]
  },
  {
    "uid": "QTS_010_024_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 中宗祀昊天樂章 告謝",
    "poem": [
      "得一流玄澤，通三御紫宸。",
      "遠葉千齡運，遐銷九域塵。",
      "絕瑞駢闐集，殊祥絡繹臻。",
      "登年慶棲畝，稔歲賀盈囷。"
    ]
  },
  {
    "uid": "QTS_010_025_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 中宗祀昊天樂章 肅和",
    "poem": [
      "悠哉廣覆，大矣曲成。",
      "九玄著象，七曜貞明。",
      "珪璧是奠，醞酎斯盈。",
      "作樂崇德，爰暢咸英。"
    ]
  },
  {
    "uid": "QTS_010_026_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 中宗祀昊天樂章 雍和",
    "poem": [
      "郊壇展敬，嚴配因心。",
      "孤竹簫管，空桑瑟琴。",
      "肅穆大禮，鏗鏘八音。",
      "恭惟上帝，希降靈歆。"
    ]
  },
  {
    "uid": "QTS_010_027_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 中宗祀昊天樂章 福和",
    "poem": [
      "九成爰奏，三獻式陳。",
      "欽承景福，恭託明禋。"
    ]
  },
  {
    "uid": "QTS_010_028_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 中宗祀昊天樂章 中宮助祭升壇",
    "poem": [
      "坤元光至德，柔訓闡皇風。",
      "芣苡芳聲遠，螽斯美化隆。",
      "睿範超千載，嘉猷備六宮。",
      "肅恭陪盛典，欽若薦禋宗。"
    ]
  },
  {
    "uid": "QTS_010_029_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 中宗祀昊天樂章 亞獻",
    "poem": [
      "三靈降饗，三後配神。",
      "虔敷藻奠，敬展郊禋。"
    ]
  },
  {
    "uid": "QTS_010_030_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 中宗祀昊天樂章 舒和",
    "poem": [
      "已陳粢盛敷嚴祀，更奏笙鏞協雅聲。",
      "璇圖寶曆欣寧謐，晏俗淳風樂太平。"
    ]
  },
  {
    "uid": "QTS_010_031_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 中宗祀昊天樂章 凱安",
    "poem": [
      "堂堂聖祖興，赫赫昌基泰。",
      "戎車盟津偃，玉帛塗山會。",
      "舜日啟祥暉，堯雲卷征斾。",
      "風猷被有截，聲教覃無外。"
    ]
  },
  {
    "uid": "QTS_010_032_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 明皇祀圜丘樂章 豫和",
    "poem": [
      "至矣丕搆，烝哉太平。",
      "授犧膺籙，復禹繼明。",
      "草木仁化，鳧鷖頌聲。",
      "祀宗陳德，無媿斯誠。"
    ]
  },
  {
    "uid": "QTS_010_033_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 明皇祀圜丘樂章 太和",
    "poem": [
      "郊壇齋帝，禮樂祀天。",
      "丹青寰宇，宮徵山川。",
      "神祇畢降，行止重旋。",
      "融融穆穆，納祉洪延。"
    ]
  },
  {
    "uid": "QTS_010_034_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 明皇祀圜丘樂章 肅和",
    "poem": [
      "止奏潛聆，登儀宿囀。",
      "太玉躬奉，參鍾首奠。",
      "簠簋聿昇，犧牲遰薦。",
      "昭事顒若，存存以俔。"
    ]
  },
  {
    "uid": "QTS_010_035_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 明皇祀圜丘樂章 雍和",
    "poem": [
      "爛雲普洽，律風無外。",
      "千品其凝，九賔斯會。",
      "禋尊晉燭，純犧滌汰。",
      "玄覆攸廣，鴻休汪濊。"
    ]
  },
  {
    "uid": "QTS_010_036_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 明皇祀圜丘樂章 壽和",
    "poem": [
      "六變爰闋，八階載虔。",
      "祐我皇祚，於萬斯年。"
    ]
  },
  {
    "uid": "QTS_010_037_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 明皇祀圜丘樂章 壽和",
    "poem": [
      "於赫聖祖，龍飛晉陽。",
      "底定萬國，奄有四方。",
      "功格上下，道冠農黃。",
      "郊天配享，德合無疆。"
    ]
  },
  {
    "uid": "QTS_010_038_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 明皇祀圜丘樂章 壽和",
    "poem": [
      "崇崇泰畤，肅肅嚴禋。",
      "粢盛既潔，金石畢陳。",
      "上帝來享，介福爰臻。",
      "受釐合祉，寶祚維新。"
    ]
  },
  {
    "uid": "QTS_010_039_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 明皇祀圜丘樂章 舒和",
    "poem": [
      "祝史正辭，人神葉慶。",
      "福以德招，享以誠應。",
      "六變雲備，百禮斯浹。",
      "祀事孔明。",
      "祚流萬葉。"
    ]
  },
  {
    "uid": "QTS_010_040_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 明皇祀圜丘樂章 凱安",
    "poem": [
      "馨香惟後德，明命光天保。",
      "肅和崇聖靈，陳信表皇道。",
      "玉鏚初蹈厲，金匏既靜好。"
    ]
  },
  {
    "uid": "QTS_010_041_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 明皇祀圜丘樂章 豫和",
    "poem": [
      "大號成命，思文配天。",
      "神光肸蠁，龍駕言旋。",
      "眇眇閶闔，昭昭上玄。",
      "俾昌而大。",
      "於斯萬年。"
    ]
  },
  {
    "uid": "QTS_010_042_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 明皇祀圜丘樂章 太和",
    "poem": [
      "六成既闋，三薦雲終。",
      "神心具醉，聖敬愈崇。",
      "受釐皇邸，回蹕帷宮。",
      "穰穰之福，永永無窮。"
    ]
  },
  {
    "uid": "QTS_010_043_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 封泰山樂章 豫和",
    "poem": [
      "款泰壇，柴泰清。",
      "受天命，報天成。",
      "竦皇心，薦樂聲。",
      "志上達，歌下迎。"
    ]
  },
  {
    "uid": "QTS_010_044_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 封泰山樂章 豫和",
    "poem": [
      "億上帝，臨下庭。",
      "騎日月，陪列星。",
      "嘉祝信，大糦馨。",
      "澹神心，醉皇靈。"
    ]
  },
  {
    "uid": "QTS_010_045_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 封泰山樂章 豫和",
    "poem": [
      "相百辟，貢八荒。",
      "九歌敘，萬舞翔。",
      "肅振振，鏗皇皇。",
      "帝欣欣，福穰穰。"
    ]
  },
  {
    "uid": "QTS_010_046_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 封泰山樂章 豫和",
    "poem": [
      "高在上，道光明。",
      "物資始，德難名。",
      "承眷命，牧蒼生。",
      "寰宇謐，太階平。"
    ]
  },
  {
    "uid": "QTS_010_047_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 封泰山樂章 豫和",
    "poem": [
      "天道無親，至誠與鄰。",
      "山川遍禮，宮徵維新。",
      "玉帛非盛，聰明會真。",
      "正斯一德，通乎百神。"
    ]
  },
  {
    "uid": "QTS_010_048_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 封泰山樂章 豫和",
    "poem": [
      "饗帝饗親，維孝維聖。",
      "緝熙懿德，敷揚成命。",
      "華夷志同，笙鏞禮盛。",
      "明靈降止，感此誠敬。"
    ]
  },
  {
    "uid": "QTS_010_049_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 封泰山樂章 太和",
    "poem": [
      "孝敬中發，和容外彰。",
      "騰華照㝢，如昇太陽。",
      "貞璧就奠，玄靈垂光。",
      "禮樂具舉，濟濟洋洋。"
    ]
  },
  {
    "uid": "QTS_010_050_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 封泰山樂章 肅和",
    "poem": [
      "奠祖配天，承天享帝。",
      "百靈咸秩，四海來祭。",
      "植我蒼璧，布我玄製。",
      "華日裵回，神煙容裔。"
    ]
  },
  {
    "uid": "QTS_010_051_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 封泰山樂章 雍和",
    "poem": [
      "俎豆有馥，粢盛潔豐。",
      "亦有和羹，既戒既平。",
      "鐘鼓管磬，肅唱和鳴。",
      "皇皇后祖，來我思成。"
    ]
  },
  {
    "uid": "QTS_010_052_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 封泰山樂章 壽和",
    "poem": [
      "烝烝我後，享獻惟夤。",
      "躬酌鬱鬯，跪奠明神。",
      "孝莫孝乎，配上帝親。",
      "敬莫敬乎，教天下臣。"
    ]
  },
  {
    "uid": "QTS_010_053_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 封泰山樂章 壽和",
    "poem": [
      "皇祖嚴配，配享皇天。",
      "皇皇降嘏，天子萬年。"
    ]
  },
  {
    "uid": "QTS_010_054_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 封泰山樂章 舒和",
    "poem": [
      "六鐘翕協六變成，八佾倘佯八風生。",
      "樂九歆兮人神感，美七德兮天地清。"
    ]
  },
  {
    "uid": "QTS_010_055_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 封泰山樂章 凱安",
    "poem": [
      "烈祖順三靈，文宗威四海。",
      "黃鉞誅羣盜，朱旗掃多罪。",
      "戢兵天下安，約法人心改。",
      "大哉干羽意，長見風雲在。"
    ]
  },
  {
    "uid": "QTS_010_056_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 封泰山樂章 豫和",
    "poem": [
      "樂已終，禋燎上。",
      "懷靈惠，結皇想。",
      "歸風疾，迴風爽。",
      "百神來，衆神往。"
    ]
  },
  {
    "uid": "QTS_010_057_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祈穀樂章 肅和",
    "poem": [
      "履艮斯繩，居中體正。",
      "龍運垂祉，昭符啟聖。",
      "式事嚴禋，聿懷嘉慶。",
      "惟帝永錫，時皇休命。"
    ]
  },
  {
    "uid": "QTS_010_058_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祈穀樂章 雍和",
    "poem": [
      "殷薦乘春，太壇臨曙。",
      "八簋盈和，六瑚登御。",
      "嘉稷匪歆，德馨斯飫。",
      "祝嘏無易，靈心有豫。"
    ]
  },
  {
    "uid": "QTS_010_059_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祈穀樂章 舒和",
    "poem": [
      "玉帛犧牲申敬享，金絲鏚羽盛音容。",
      "庶俾億齡禔景福，長欣萬宇洽時邕。"
    ]
  },
  {
    "uid": "QTS_010_060_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 明堂樂章 肅和",
    "poem": [
      "象天御宇，乘時布政。",
      "嚴配申虔，宗禋展敬。",
      "罇罍盈列，樹羽交映。",
      "玉幣通誠，祚隆皇聖。"
    ]
  },
  {
    "uid": "QTS_010_061_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 明堂樂章 雍和",
    "poem": [
      "八牖晨披，五精朝奠。",
      "霧凝璇篚，風清金縣。",
      "神滌備全，明粢豐衍。",
      "載絜彝俎，陳誠以薦。"
    ]
  },
  {
    "uid": "QTS_010_062_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 明堂樂章 舒和",
    "poem": [
      "御扆合宮承寶曆，席圖重館奉明靈。",
      "偃武修文九圍泰，沈烽靜柝八荒寧。"
    ]
  },
  {
    "uid": "QTS_010_063_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后明堂樂章 外辦將出",
    "poem": [
      "總章陳昔典，衢室禮惟神。",
      "宏規則天地，神用葉陶鈞。",
      "負扆三春旦，充庭萬宇賔。",
      "顧己誠虛薄，空慙億兆人。"
    ]
  },
  {
    "uid": "QTS_010_064_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后明堂樂章 皇帝行",
    "poem": [
      "仰膺曆數，俯順謳歌。",
      "遠安邇肅，俗阜時和。",
      "化光玉鏡，訟息金科。",
      "方興典禮，永戢干戈。"
    ]
  },
  {
    "uid": "QTS_010_065_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后明堂樂章 皇嗣出入升降",
    "poem": [
      "至人光俗，大孝通神。",
      "謙以表性，恭惟立身。",
      "洪規載啟，茂典方陳。",
      "譽隆三善，祥開萬春。"
    ]
  },
  {
    "uid": "QTS_010_066_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后明堂樂章 迎送王公",
    "poem": [
      "千官肅事，萬國朝宗。",
      "載延百辟，爰集三宮。",
      "君臣德合，魚水斯同。",
      "睿圖方永，周曆長隆。"
    ]
  },
  {
    "uid": "QTS_010_067_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后明堂樂章 登歌",
    "poem": [
      "禮崇宗祀，志表嚴禋。",
      "笙鏞合奏，文物維新。",
      "敬遵茂典，敢擇良辰。",
      "絜誠斯著，奠謁方申。"
    ]
  },
  {
    "uid": "QTS_010_068_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后明堂樂章 配饗",
    "poem": [
      "笙鏞間玉宇，文物昭清暉。",
      "睟影臨芳奠，休光下太微。",
      "孝思期有感，明絜庶無違。"
    ]
  },
  {
    "uid": "QTS_010_069_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后明堂樂章 宮音",
    "poem": [
      "履艮包羣望，居中冠百靈。",
      "萬方資廣運，庶品荷財成。",
      "神功諒匪測，盛德實難名。",
      "藻奠申誠敬，恭祀表惟馨。"
    ]
  },
  {
    "uid": "QTS_010_070_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后明堂樂章 角音",
    "poem": [
      "出震位，開平秩。",
      "扇條風，乘甲乙。",
      "龍德盛，鳥星出。",
      "薦珪篚，陳誠實。"
    ]
  },
  {
    "uid": "QTS_010_071_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后明堂樂章 徵音",
    "poem": [
      "赫赫離精御炎陸，滔滔熾景開隆暑。",
      "冀延神鑒俯蘭罇，式表虔襟陳桂俎。"
    ]
  },
  {
    "uid": "QTS_010_072_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后明堂樂章 商音",
    "poem": [
      "律中夷則，序應收成。",
      "功宣建武，義表惟明。",
      "爰申禮奠，庶展翹誠。",
      "九秋是式，百穀斯盈。"
    ]
  },
  {
    "uid": "QTS_010_073_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后明堂樂章 羽音",
    "poem": [
      "葭律肇啟隆冬，蘋藻攸陳饗祭。",
      "黃鍾既陳玉燭，紅粒方殷稔歲。"
    ]
  },
  {
    "uid": "QTS_010_074_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 雩祀樂章 肅和",
    "poem": [
      "朱鳥開辰，蒼龍啟暎。",
      "大帝昭饗，羣生展敬。",
      "禮備懷柔，功宣舞詠。",
      "旬液應序，年祥協慶。"
    ]
  },
  {
    "uid": "QTS_010_075_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 雩祀樂章 雍和",
    "poem": [
      "紺筵分彩，珤圖吐絢。",
      "風管晨凝，雲歌曉囀。",
      "肅事蘭羞，虔申桂奠。",
      "百穀斯登，萬箱攸薦。"
    ]
  },
  {
    "uid": "QTS_010_076_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 雩祀樂章 舒和",
    "poem": [
      "鳳曲登歌調令序，龍雩集舞汎祥風。",
      "彩旞雲迴昭睿德，朱干電發表神功。"
    ]
  },
  {
    "uid": "QTS_010_077_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 雩祀樂章 豫和",
    "poem": [
      "鳥緯遷序，龍星見辰。",
      "純陽在律，明德崇禋。",
      "五方降帝，萬宇安人。",
      "恭以致享，肅以迎神。"
    ]
  },
  {
    "uid": "QTS_010_078_01",
    "volume": 10,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 雩祀樂章 豫和",
    "poem": [
      "祀遵經設，享緣誠舉。",
      "獻畢於樽，徹臨於俎。",
      "舞止干戚，樂停柷敔。",
      "歌以送神，神還其所。"
    ]
  }
]