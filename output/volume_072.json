    },
    "title": "晦日置酒林亭",
    "poem": [
      "正月符嘉節，三春翫物華。",
      "忘懷寄尊酒，陶性狎山家。",
      "柳翠含煙葉，梅芳帶雪花。",
      "光陰不相借，遲遲落景斜。"
    ],
    "variants": [
      {
        "line": 4,
        "text": "借",
        "variant": "惜",
        "source": "一作「惜」"
      }
    ]
