[
  {
    "uid": "QTS_012_001_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭方丘樂章 順和",
    "poem": [
      "萬方資以化，交泰屬昇平。",
      "易從業惟簡，得一道斯寧。",
      "具儀光玉帛，送舞變咸英。",
      "黍稷良非貴，明德信惟馨。"
    ]
  },
  {
    "uid": "QTS_012_002_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭方丘樂章 肅和",
    "poem": [
      "至矣坤德，皇哉地祇。",
      "開元統紐，合大承規。",
      "九宮肅列，六典相儀。",
      "永言配命，長保無虧。"
    ]
  },
  {
    "uid": "QTS_012_003_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭方丘樂章 雍和",
    "poem": [
      "柔而能方，直而能敬。",
      "厚載以德，大亨以正。",
      "有滌斯牷，有馨斯盛。",
      "介茲景福，祚我休慶。"
    ]
  },
  {
    "uid": "QTS_012_004_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭方丘樂章 舒和",
    "poem": [
      "玉幣牲牷分薦享，羽旄干鏚遰成容。",
      "一德惟寧兩儀泰，三才保合四時邕。"
    ]
  },
  {
    "uid": "QTS_012_005_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭方丘樂章 順和",
    "poem": [
      "陰祇協贊，厚載方貞。",
      "牲幣具舉，簫管僃成。",
      "其禮惟肅，其德惟明。",
      "神之聽矣，式鑒虔誠。"
    ]
  },
  {
    "uid": "QTS_012_006_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后大享拜洛樂章 昭和",
    "poem": [
      "九玄眷命，三聖基隆。",
      "奉承先旨，明臺畢功。",
      "宗祀展敬，冀表深衷。",
      "永昌帝業，式播淳風。"
    ]
  },
  {
    "uid": "QTS_012_007_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后大享拜洛樂章 致和",
    "poem": [
      "神功不測兮運陰陽，包藏萬宇兮孕八荒。",
      "天符旣出兮帝業昌，願臨明祀兮降禎祥。"
    ]
  },
  {
    "uid": "QTS_012_008_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后大享拜洛樂章 咸和",
    "poem": [
      "坎澤祠容僃舉，坤壇祭典爰申。",
      "靈睠遙行秘躅，嘉貺薦委殊珍。",
      "肅禮恭禋載展，翹襟邈志逾殷。",
      "方期交際懸應，（下一句逸）"
    ]
  },
  {
    "uid": "QTS_012_009_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后大享拜洛樂章 九和",
    "poem": [
      "祇荷坤德，欽若乾靈。",
      "慙惕罔寘，興居匪寧。",
      "恭崇禮則，肅奉儀形。",
      "惟憑展敬，敢薦非馨。"
    ]
  },
  {
    "uid": "QTS_012_010_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后大享拜洛樂章 顯和",
    "poem": [
      "菲躬承睿顧，薄德忝坤儀。",
      "乾乾遵後命，翼翼奉先規。",
      "撫俗勤雖切，還淳化尚虧。",
      "未能弘至道，何以契明祇。"
    ]
  },
  {
    "uid": "QTS_012_011_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后大享拜洛樂章 顯和",
    "poem": [
      "顧德有慙虛菲，明祇屢降禎符。",
      "汜水初呈秘象，溫洛薦表昌圖。",
      "玄澤流恩載洽，丹襟荷渥增愉。"
    ]
  },
  {
    "uid": "QTS_012_012_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后大享拜洛樂章 昭和",
    "poem": [
      "舒陰致養，合大資生。",
      "德以恆固，功由永貞。",
      "升歌薦序，垂幣翹誠。",
      "虹開玉照，鳳引金聲。"
    ]
  },
  {
    "uid": "QTS_012_013_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后大享拜洛樂章 敬和",
    "poem": [
      "蘭俎旣昇，蘋羞可薦。",
      "金石載設，咸英已變。",
      "林澤斯總，山川是遍。",
      "敢用敷誠，實惟忘倦。"
    ]
  },
  {
    "uid": "QTS_012_014_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后大享拜洛樂章 齊和",
    "poem": [
      "沈潛演貺分三極，廣大凝禎總萬方。",
      "旣薦羽旌文化啟，還呈干鏚武威揚。"
    ]
  },
  {
    "uid": "QTS_012_015_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后大享拜洛樂章 德和",
    "poem": [
      "夕惕司龍契，晨兢當鳳扆。",
      "崇儒習舊規，偃伯循先旨。",
      "絕壤飛冠蓋，遐區麗山水。",
      "幸承三聖餘，忻屬千年始。"
    ]
  },
  {
    "uid": "QTS_012_016_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后大享拜洛樂章 禋和",
    "poem": [
      "百禮崇容，千官肅事。",
      "靈降無兆，神凝有粹。",
      "奠享咸周，威儀畢僃。",
      "奏夏登列，歌雍徹肆。"
    ]
  },
  {
    "uid": "QTS_012_017_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后大享拜洛樂章 通和",
    "poem": [
      "皇皇靈睠，穆穆神心。",
      "暫動凝質，還歸積陰。",
      "功玄樞紐，理寂高深。",
      "銜恩佩德，聳志翹襟。"
    ]
  },
  {
    "uid": "QTS_012_018_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后大享拜洛樂章 歸和",
    "poem": [
      "言旋雲洞兮躡煙途，永寧中宇兮安下都。",
      "包涵動植兮順榮枯，長貽寶貺兮贊璇圖。"
    ]
  },
  {
    "uid": "QTS_012_019_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 武后大享拜洛樂章 又歸和",
    "poem": [
      "調雲闋兮神座興，驂雲駕兮儼將昇。",
      "騰絳霄兮垂景祐，翹丹懇兮荷休徵。"
    ]
  },
  {
    "uid": "QTS_012_020_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭方丘樂章 順和",
    "poem": [
      "坤厚載物，德柔垂祉。",
      "九域咸雍，四溟為紀。",
      "敬因良節，虔修陰祀。",
      "廣樂式張，靈其降止。"
    ]
  },
  {
    "uid": "QTS_012_021_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭方丘樂章 金奏",
    "poem": [
      "坤元至德，品物資生。",
      "神凝博厚，道協高明。",
      "列鎮五嶽，環流四瀛。",
      "於何不載，萬寶斯成。"
    ]
  },
  {
    "uid": "QTS_012_022_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭方丘樂章 順和",
    "poem": [
      "樂僃金石，禮光尊俎。",
      "大享爰終，洪休是舉。",
      "雨零感節，雲飛應序。",
      "纓紱載辭，皇靈具舉。"
    ]
  },
  {
    "uid": "QTS_012_023_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭汾陰樂章 順和",
    "poem": [
      "大樂和暢，殷薦明神。",
      "一降通感，八變必臻。",
      "有求斯應，無德不親。",
      "降靈醉止，休徵萬人。"
    ]
  },
  {
    "uid": "QTS_012_024_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭汾陰樂章 太簇角",
    "poem": [
      "坤元載物，陽樂發生。",
      "播殖資始，品彙咸亨。",
      "列俎棋布，方壇砥平。",
      "神歆禋祀，後德惟明。"
    ]
  },
  {
    "uid": "QTS_012_025_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭汾陰樂章 姑洗徵",
    "poem": [
      "大君出震，有事郊禋。",
      "齋戒旣肅，馨香畢陳。",
      "樂和禮僃，候暖風春。",
      "恭惟降福，實賴明神。"
    ]
  },
  {
    "uid": "QTS_012_026_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭汾陰樂章 南呂羽",
    "poem": [
      "於穆濬哲，維清緝熙。",
      "肅事昭配，永言孝思。",
      "滌濯靜嘉，馨香在茲。",
      "神之聽之，用受福釐。"
    ]
  },
  {
    "uid": "QTS_012_027_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭汾陰樂章 太和",
    "poem": [
      "於穆聖皇，六葉重光。",
      "太原刻頌，后土疏場。",
      "寶鼎呈符，歊雲孕祥。",
      "禮樂備矣，降福穰穰。"
    ]
  },
  {
    "uid": "QTS_012_028_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭汾陰樂章 肅和",
    "poem": [
      "聿修嚴配，展事禋宗。",
      "祥符寶鼎，禮備黃琮。",
      "祀詞以信，明德惟聰。",
      "介茲景福，永永無窮。"
    ]
  },
  {
    "uid": "QTS_012_029_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭汾陰樂章 雍和",
    "poem": [
      "蠲我餴饎，絜我膋薌。",
      "有豆孔碩，為羞旣臧。",
      "至誠無昧，精意惟芳。",
      "神其醉止，欣欣樂康。"
    ]
  },
  {
    "uid": "QTS_012_030_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭汾陰樂章 壽和",
    "poem": [
      "禮物斯具，樂章乃陳。",
      "誰其作主，皇考聖真。",
      "對越在天，聖明佐神。",
      "窅然汾上，厚澤如春。"
    ]
  },
  {
    "uid": "QTS_012_031_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭汾陰樂章 舒和",
    "poem": [
      "樂奏雲闋，禮章載虔。",
      "禋宗於地，昭假於天。",
      "惟馨薦矣，旣醉歆焉。",
      "神之降福，永永萬年。"
    ]
  },
  {
    "uid": "QTS_012_032_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭汾陰樂章 凱安",
    "poem": [
      "維歲之吉，維辰之良。",
      "聖君紱冕，肅事壇場。",
      "大禮已備，大樂斯章。",
      "神其醉止，降福無疆。"
    ]
  },
  {
    "uid": "QTS_012_033_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭汾陰樂章 順和",
    "poem": [
      "方丘旣膳，嘉饗載謐。",
      "齊敬畢誠，陶匏貴質。",
      "秀畢豐薦，芳俎盈實。",
      "永永福流，其昇如日。"
    ]
  },
  {
    "uid": "QTS_012_034_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 禪社首樂章 順和",
    "poem": [
      "至哉含柔德，萬物資以生。",
      "常順稱厚載，流謙通變盈。",
      "聖心事能察，增廣陳厥誠。",
      "黃祇僾如在，泰折俟咸亨。"
    ]
  },
  {
    "uid": "QTS_012_035_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 禪社首樂章 太和",
    "poem": [
      "肅我成命，於昭黃祇。",
      "裘冕而祀，陟降在斯。",
      "五音克備，八音聿施。",
      "緝熙肆靖，厥心匪離。"
    ]
  },
  {
    "uid": "QTS_012_036_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 禪社首樂章 肅和",
    "poem": [
      "黃祇是祇，我其夙夜。",
      "寅畏誠絜，匪遑寧舍。",
      "禮以琮玉，薦厥茅藉。",
      "念茲降康，胡寧克暇。"
    ]
  },
  {
    "uid": "QTS_012_037_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 禪社首樂章 雍和",
    "poem": [
      "夙夜宥密，不敢寧宴。",
      "五齊旣陳，八音在縣。",
      "粢盛以潔，房俎斯薦。",
      "惟德惟馨，尚茲克徧。"
    ]
  },
  {
    "uid": "QTS_012_038_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 禪社首樂章 壽和",
    "poem": [
      "惟以明發，有懷載殷。",
      "樂盈而反，禮順其禋。",
      "立清以獻，薦欲是親。",
      "於穆不已，裒對斯臻。"
    ]
  },
  {
    "uid": "QTS_012_039_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 禪社首樂章 福和",
    "poem": [
      "穆穆天子，告成岱宗。",
      "大裘如濡，執珽有顒。",
      "樂以平志，禮以和容。",
      "上帝臨我，雲胡肅邕。"
    ]
  },
  {
    "uid": "QTS_012_040_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 禪社首樂章 太和",
    "poem": [
      "昭昭有唐，天俾萬國。",
      "列祖應命，四宗順則。",
      "申鍚無疆，宗我同德。",
      "曾孫繼序，享神配極。"
    ]
  },
  {
    "uid": "QTS_012_041_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 禪社首樂章 靈具醉",
    "poem": [
      "靈具醉，杳熙熙。",
      "靈將往，眇禗禗。",
      "顧明德，吐正辭。",
      "爛遺光，流禎祺。"
    ]
  },
  {
    "uid": "QTS_012_042_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭神州樂章 肅和",
    "poem": [
      "大矣坤儀，至哉神縣。",
      "包含日域，牢籠月竁。",
      "露絜三清，風調六變。",
      "皇祇介祉，式歆恭薦。"
    ]
  },
  {
    "uid": "QTS_012_043_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭神州樂章 雍和",
    "poem": [
      "泰折嚴享，陰郊展敬。",
      "禮以導神，樂以和性。",
      "黝牲在列，黃琮俯暎。",
      "九土旣平，萬邦貽慶。"
    ]
  },
  {
    "uid": "QTS_012_044_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭神州樂章 舒和",
    "poem": [
      "坤道降祥和庻品，靈心載德厚羣生。",
      "水土旣調三極泰，文武畢備九區平。"
    ]
  },
  {
    "uid": "QTS_012_045_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭神州樂章 迎神",
    "poem": [
      "黃輿厚載，赤寰歸德。",
      "含育九區，保安萬國。",
      "誠敬無怠，禋祀有則。",
      "樂以迎神，其儀不忒。"
    ]
  },
  {
    "uid": "QTS_012_046_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭神州樂章 送神",
    "poem": [
      "神州陰祀，洪恩廣濟。",
      "草樹霑和，飛沈沐惠。",
      "禮修鼎俎，奠歆瑤幣。",
      "送樂有章，靈軒其逝。"
    ]
  },
  {
    "uid": "QTS_012_047_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭大社樂章 肅和",
    "poem": [
      "后土凝德，神功協契。",
      "九域底平，兩儀交際。",
      "戊期應序，陰墉展幣。",
      "靈車少留，俯歆樽桂。"
    ]
  },
  {
    "uid": "QTS_012_048_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭大社樂章 雍和",
    "poem": [
      "美報崇本，嚴恭展事。",
      "受露疎壇，承風啟地。",
      "絜粢登俎，醇犧入饋。",
      "介福遠流，羣生畢遂。"
    ]
  },
  {
    "uid": "QTS_012_049_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭大社樂章 舒和",
    "poem": [
      "神道發生敷九稼，陰極乘仁暢八埏。",
      "緯武經文隆景化，登祥薦祉啟豐年。"
    ]
  },
  {
    "uid": "QTS_012_050_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭大社樂章 迎神",
    "poem": [
      "烈山有子，后土有臣。",
      "播種百穀，濟育兆人。",
      "春官緝禮，宗伯司禋。",
      "戊為吉日，迎享茲辰。"
    ]
  },
  {
    "uid": "QTS_012_051_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 祭大社樂章 送神",
    "poem": [
      "吉祥式就，酬功載畢。",
      "親地尊天，禮文經術。",
      "貺徵令序，福流初日。",
      "神馭爰歸，祠官其出。"
    ]
  },
  {
    "uid": "QTS_012_052_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 蠟百神樂章 肅和",
    "poem": [
      "序廹歲陰，日躔星紀。",
      "爰稽茂典，聿崇清祀。",
      "綺幣霞舒，瑞珪虹起。",
      "百禩垂裕，萬靈薦祉。"
    ]
  },
  {
    "uid": "QTS_012_053_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 蠟百神樂章 雍和",
    "poem": [
      "緹籥勁序，玄英晚候。",
      "姬蠟開儀，豳歌入奏。",
      "蕙馥雕俎，蘭芬玉酎。",
      "大享明祇，永綏多祐。"
    ]
  },
  {
    "uid": "QTS_012_054_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 蠟百神樂章 舒和",
    "poem": [
      "經緯兩儀文化洽，削平方域武功成。",
      "瑤弦自樂乾坤泰，玉鏚長歡區宇寧。"
    ]
  },
  {
    "uid": "QTS_012_055_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 蠟百神樂章 迎神",
    "poem": [
      "八蜡開祭，萬物合祀。",
      "上極天維，下窮坤紀。",
      "鼎俎流芬，罇彛薦美。",
      "有靈有祇，咸希來止。"
    ]
  },
  {
    "uid": "QTS_012_056_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 蠟百神樂章 送神",
    "poem": [
      "十旬歡洽，一日祠終。",
      "澄彝拂俎，報德酬功。",
      "慮虔容肅，禮縟儀豐。",
      "神其降祉，整馭隨風。"
    ]
  },
  {
    "uid": "QTS_012_057_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享先農樂章 咸和",
    "poem": [
      "粒食伊始，農之所先。",
      "古今攸賴，是曰人天。",
      "耕斯帝籍，播厥公田。",
      "式崇明祀，神其福焉。"
    ]
  },
  {
    "uid": "QTS_012_058_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享先農樂章 肅和",
    "poem": [
      "罇彝旣列，瑚簋方薦。",
      "歌工載登，幣禮斯奠。",
      "肅肅享祀，顒顒纓弁。",
      "神之聽之，福流寰縣。"
    ]
  },
  {
    "uid": "QTS_012_059_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享先農樂章 雍和",
    "poem": [
      "前夕視牲，質明奉俎。",
      "沐芳整弁，其儀式序。",
      "盛禮畢陳，嘉樂備舉。",
      "歆我懿德，非馨稷黍。"
    ]
  },
  {
    "uid": "QTS_012_060_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享先農樂章 舒和",
    "poem": [
      "羽籥低昻文綴已，干戚蹈厲武行初。",
      "望歲祈農神所聽，延祥介福豈雲虛。"
    ]
  },
  {
    "uid": "QTS_012_061_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享先農樂章 咸和",
    "poem": [
      "三推禮就，萬庾祈凝。",
      "夤賓志遠，藨蓘惟興。",
      "降歆肅薦，垂祐祇膺。",
      "送神有樂，神其上昇。"
    ]
  },
  {
    "uid": "QTS_012_062_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享先蠶樂章 永和",
    "poem": [
      "芳春開令序，韶苑暢和風。",
      "惟靈申廣祐，利物表神功。",
      "綺會周天宇，黼黻藻寰中。",
      "庶幾承慶節，歆奠下帷宮。"
    ]
  },
  {
    "uid": "QTS_012_063_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享先蠶樂章 肅和",
    "poem": [
      "明靈光至德，深功掩百神。",
      "祥源應節啟，福緒逐年新。",
      "萬宇承恩覆，七廟佇恭禋。",
      "於茲申至懇，方期遠慶臻。"
    ]
  },
  {
    "uid": "QTS_012_064_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享先蠶樂章 展敬",
    "poem": [
      "霞莊列寶衞，雲集動和聲。",
      "金巵薦綺席，玉幣委芳庭。",
      "因心罄丹欵，先己勵蒼生。",
      "所冀延明福，於茲享至誠。"
    ]
  },
  {
    "uid": "QTS_012_065_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享先蠶樂章 絜誠",
    "poem": [
      "桂筵開玉俎，蘭圃薦瓊芳。",
      "八音調鳳曆，三獻奉鸞觴。",
      "絜粢申大享，庭㝢冀降祥。",
      "神其覃有慶，契福永無疆。"
    ]
  },
  {
    "uid": "QTS_012_066_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享先蠶樂章 昭慶",
    "poem": [
      "仙壇禮旣畢，神駕儼將昇。",
      "佇屬深祥起，方期庶績凝。",
      "虔誠資宇內，務本勖黎蒸。",
      "靈心昭備享，率土洽休徵。"
    ]
  },
  {
    "uid": "QTS_012_067_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 釋奠文宣王樂章 誠和",
    "poem": [
      "聖道日用，神幾不測。",
      "金石以陳，弦歌載陟。",
      "爰釋其菜，匪馨於稷。",
      "來顧來享，是宗是極。"
    ]
  },
  {
    "uid": "QTS_012_068_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 釋奠文宣王樂章 承和",
    "poem": [
      "萬國以貞光上嗣，三善茂德表重輪。",
      "視膳寢門尊要道，高闢崇賢引正人。"
    ]
  },
  {
    "uid": "QTS_012_069_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 釋奠文宣王樂章 肅和",
    "poem": [
      "粵惟上聖，有縱自天。",
      "傍周萬物，俯應千年。",
      "舊章允著，嘉贄孔虔。",
      "王化茲首，儒風是宣。"
    ]
  },
  {
    "uid": "QTS_012_070_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 釋奠文宣王樂章 雍和",
    "poem": [
      "堂獻瑤篚，庭敷璆縣。",
      "禮備其容，樂和其變。",
      "肅肅親享，雍雍執奠。",
      "明德惟馨，蘋蘩可薦。"
    ]
  },
  {
    "uid": "QTS_012_071_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 釋奠文宣王樂章 舒和",
    "poem": [
      "隼集龜開昭聖烈，龍蹲鳳跱肅神儀。",
      "尊儒敬業宏圖闡，緯武經文盛德施。"
    ]
  },
  {
    "uid": "QTS_012_072_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享孔子廟樂章 迎神",
    "poem": [
      "通吳表聖，問老探真。",
      "三千弟子，五百賢人。",
      "億齡規法，萬載嗣禋。",
      "潔誠以祭，奏樂迎神。"
    ]
  },
  {
    "uid": "QTS_012_073_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享孔子廟樂章 送神",
    "poem": [
      "醴溢犧象，羞陳俎豆。",
      "魯壁類聞，泗川如覯。",
      "里校覃福，胄筵承祐。",
      "雅樂清音，送神具奏。"
    ]
  },
  {
    "uid": "QTS_012_074_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 釋奠武成王樂章 迎神",
    "poem": [
      "卜畋不從，兆發非熊。",
      "乃傾荒政，爰佐一戎。",
      "盛烈載垂，命祀惟崇。",
      "日練上戊，宿嚴閟宮。",
      "迎奏嘉至，感而遂通。"
    ]
  },
  {
    "uid": "QTS_012_075_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 釋奠武成王樂章 奠幣登歌",
    "poem": [
      "管磬升，羶薌集。",
      "上公進，嘉幣執。",
      "信以通，僾如及。",
      "恢帝功，錫後邑。",
      "四維張，百度立。",
      "綿億載，邈難挹。"
    ]
  },
  {
    "uid": "QTS_012_076_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 釋奠武成王樂章 迎俎酌獻",
    "poem": [
      "五齊潔，九牢碩。",
      "梡橜循，罍斝滌。",
      "進具物，揚鴻績。",
      "和奏發，高靈寂。",
      "虔告終，繁祉錫。",
      "昭秩祀，永無易。"
    ]
  },
  {
    "uid": "QTS_012_077_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 釋奠武成王樂章 亞獻終獻",
    "poem": [
      "貳觴以獻，三變其終。",
      "顧此非馨，尚達斯衷。",
      "茅縮可致，神歆載融。",
      "始神翊周，拯溺除凶。",
      "時維降祐，永絕興戎。"
    ]
  },
  {
    "uid": "QTS_012_078_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 釋奠武成王樂章 送神",
    "poem": [
      "明祀方終，備樂斯闋。",
      "黝纁就瘞，豆籩告撤。",
      "肸蠁尚餘，光景雲滅。",
      "返歸虛極，神心則悅。"
    ]
  },
  {
    "uid": "QTS_012_079_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享龍池樂章 第一章",
    "poem": [
      "恭聞帝里生靈沼，應報明君鼎業新。",
      "旣協翠泉光寶命，還符白水出真人。",
      "此時舜海潛龍躍，此地堯河帶馬廵。",
      "獨有前池一小雁，叨承舊惠入天津。"
    ]
  },
  {
    "uid": "QTS_012_080_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享龍池樂章 第二章",
    "poem": [
      "帝宅王家大道邊，神馬龍龜涌聖泉。",
      "昔日昔時經此地，看來看去漸成川。",
      "歌臺舞榭宜正月，柳岸梅洲勝往年。",
      "莫言波上春雲少，祇為從龍直上天。"
    ]
  },
  {
    "uid": "QTS_012_081_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享龍池樂章 第三章",
    "poem": [
      "龍池躍龍龍已飛，龍德先天天不違。",
      "池開天漢分黃道，龍向天門入紫微。",
      "邸第樓臺多氣色，君王鳧雁有光輝。",
      "為報寰中百川水，來朝此地莫東歸。"
    ]
  },
  {
    "uid": "QTS_012_082_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享龍池樂章 第四章",
    "poem": [
      "代邸東南龍躍泉，清漪碧浪遠浮天。",
      "樓臺影就波中出，日月光疑鏡裏懸。",
      "雁沼回流成舜海，龜書薦祉應堯年。",
      "大川旣濟慙為檝，報德空思奉細涓。"
    ]
  },
  {
    "uid": "QTS_012_083_01",
    "volume": 12,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享龍池樂章 第五章",
    "poem": [
      "龍池初出此龍山，常經此地謁龍顏。",
      "日日芙蓉生夏水，年年楊柳變春灣。",
      "堯壇寶匣餘煙霧，舜海漁舟尚往還。",
      "願似飄颻五雲影，從來從去九天間。"
    ]
  },
  {
    "uid": "QTS_012_084_01",
    "volume": 12,
    "author": {
