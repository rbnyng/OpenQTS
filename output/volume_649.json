[
  {
    "uid": "QTS_649_001_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "送崔拾遺出使江東",
    "poem": [
      "九門思諫諍，萬里采風謠。",
      "關外逢秋月，天涯過晚潮。",
      "雁飛雲杳杳，木落浦蕭蕭。",
      "空怨他鄉別，回舟暮寂寥。"
    ]
  },
  {
    "uid": "QTS_649_002_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "重陽日送洛陽李丞之任",
    "poem": [
      "為文通絕境，從宦及良辰。",
      "洛下知名早，腰邊結綬新。",
      "且傾浮菊酒，聊拂染衣塵。",
      "獨恨滄州侶，愁來別故人。"
    ]
  },
  {
    "uid": "QTS_649_003_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "江州送李侍御歸東洛",
    "poem": [
      "獨乘驄馬去，不並旅人還。",
      "中外名卿貴，田園高步閒。",
      "暮春經楚縣，新月上淮山。",
      "道路空瞻望，軒車不敢攀。"
    ]
  },
  {
    "uid": "QTS_649_004_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "送郭太祝歸江東",
    "poem": [
      "鄉人去欲盡，北雁又南飛。",
      "京洛風塵久，江淮音信稀。",
      "舊山知獨往，一醉莫相違。",
      "未得解羇旅，無勞問是非。"
    ]
  },
  {
    "uid": "QTS_649_005_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "送李恬及第後還貝州",
    "poem": [
      "成名年少日，就業聖人書。",
      "擢桂誰相比，籝金已不如。",
      "東城送歸客，秋日待征車。",
      "若到清潭畔，儒風變里閭。"
    ]
  },
  {
    "uid": "QTS_649_006_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "收兩京後還上都兼訪一二親故",
    "poem": [
      "離堂千里客，歸騎五陵人。",
      "路轉函關晚，煙開上苑新。",
      "天涯將野服，闕下見鄉親。",
      "問得存亡事，裁詩寄海濱。"
    ]
  },
  {
    "uid": "QTS_649_007_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "送汶上王明府之任",
    "poem": [
      "何時到故鄉，歸去佩銅章。",
      "親友移家盡，閭閻百戰傷。",
      "背關餘草木，出塞足風霜。",
      "遺老應相賀，知君不下堂。"
    ]
  },
  {
    "uid": "QTS_649_008_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "湖南使院遣情送江夏賀侍郎",
    "poem": [
      "雲雨一消散，悠悠關復河。",
      "俱從泛舟役，遂隔洞庭波。",
      "楚水去不盡，秋風今更過。",
      "無由得相見，卻恨寄書多。"
    ]
  },
  {
    "uid": "QTS_649_009_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "過申州作",
    "poem": [
      "萬人曾死戰，幾戶免刀兵。",
      "井邑初安堵，兒童未長成。",
      "涼風吹古木，野火燒殘營。",
      "寥落千餘里，山高水復清。"
    ],
    "variants": [
