      }
    ]
  },
  {
    "uid": "QTS_649_010_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "汝南過訪田評事",
    "poem": [
      "移家近漢陰，不復問華簪。",
      "買酒宜城遠，燒田夢澤深。",
      "暮山逢鳥入，寒水見魚沈。",
      "與物皆無累，終年愜本心。"
    ]
  },
  {
    "uid": "QTS_649_011_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "送道上人遊方",
    "poem": [
      "律儀通外學，詩思入玄關。",
      "煙景隨人別，風姿與物閑。",
      "貫花留靜室，咒水度空山。",
      "誰識浮雲意，悠悠天地間。"
    ]
  },
  {
    "uid": "QTS_649_012_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "送饒州王司法之任兼寄朱處士",
    "poem": [
      "莫辭還作吏，且喜速回車。",
      "留醉悲殘歲，含情寄遠書。",
      "共看衰老近，轉覺宦名虛。",
      "遙想清溪畔，幽人得自如。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "辭",
        "variant": "愁",
        "source": "一作「愁」"
      }
    ]
  },
  {
    "uid": "QTS_649_013_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "詹碏山居",
    "poem": [
      "愛此棲心靜，風塵路已賒。",
      "十餘莖野竹，一兩樹山花。",
      "遶石開泉細，穿蘿引徑斜。",
      "無人會幽意，來往在煙霞。"
    ]
  },
  {
    "uid": "QTS_649_014_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "曉角",
    "poem": [
      "畫角吹殘月，寒聲發戍樓。",
      "立霜嘶馬怨，攢磧泣兵愁。",
      "燕雁鳴雲畔，胡風冷草頭。",
      "罷聞三會後，天迥曉星流。"
    ]
  },
  {
    "uid": "QTS_649_015_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "冬日",
    "poem": [
      "燒火掩關坐，窮居客訪稀。",
      "凍雲愁暮色，寒日淡斜暉。",
      "穿牖竹風滿，繞庭雲葉飛。",
      "已嗟週一歲，羇寓尚何依。"
    ]
  },
  {
    "uid": "QTS_649_016_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "殘秋送友",
    "poem": [
      "早為千里別，況復是秋殘。",
      "木葉怨先老，江雲愁暮寒。",
      "交情如水淡，離酒泛杯寬。",
      "料想還家後，休吟行路難。"
    ]
  },
  {
    "uid": "QTS_649_017_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "客行",
    "poem": [
      "藕葉綴為衣，東西泣路岐。",
      "鄉心日落後，身計酒醒時。",
      "觸目多添感，凝情足所思。",
      "羈愁難盡遣，行坐一低睂。"
    ]
  },
  {
    "uid": "QTS_649_018_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "秋夜",
    "poem": [
      "度鴻驚睡醒，欹枕已三更。",
      "夢破寂寥思，燈殘零落明。",
      "空窗閒月色，幽壁靜蟲聲。",
      "況是離鄉久，依然無限情。"
    ]
  },
  {
    "uid": "QTS_649_019_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "新月",
    "poem": [
      "入夜天西見，蛾睂冷素光。",
      "潭魚驚釣落，雲雁怯弓張。",
      "隱隱臨珠箔，微微上粉牆。",
      "更憐三五夕，仙桂滿輪芳。"
    ]
  },
  {
    "uid": "QTS_649_020_01",
    "volume": 649,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "滁上懷周賀",
    "poem": [
      "就枕忽不寐，孤懷興歎初。",
      "南譙收舊歷，上苑絕來書。",
      "暝雪細聲積，晨鐘寒韻疎。",
      "侯門昔彈鋏，曾共食江魚。"
    ],
