  {
    "uid": "QTS_484_015_01",
    "volume": 484,
    "author": {
      "canonical": "趙蕃",
      "recorded": "趙蕃",
      "gender": "male",
      "english_name": "Zhao Fan",
      "wikidata_id": "Q45566745"
    },
    "title": "薦冰",
    "poem": [
      "仲月開凌室，齋心感聖情。",
      "寒姿分玉坐，皓彩發丹楹。",
      "積素因風壯，虛空向日明。",
      "遙涵窗戶冷，近映冕旒清。",
      "在掌光逾澈，當軒質自輕。",
      "良辰方可致，由此表精誠。"
    ]
  },
  {
    "uid": "QTS_484_016_01",
    "volume": 484,
    "author": {
      "canonical": "趙蕃",
      "recorded": "趙蕃",
      "gender": "male",
      "english_name": "Zhao Fan",
      "wikidata_id": "Q45566745"
    },
    "title": "老人星",
    "poem": [
      "大史占南極，秋分見壽星。",
      "增輝延寶曆，發曜起祥經。",
      "灼爍依狼地，昭彰近帝庭。",
      "高懸方杳杳，孤白乍熒熒。",
      "應見光新吐，休徵德自形。",
      "既能符聖祚，從此表遐齡。"
    ]
  }
