      "recorded": "天寶宮人",
      "gender": "female",
      "period": "High Tang"
    },
    "title": "題洛苑梧葉上",
    "poem": [
      "舊寵悲秋扇，新恩寄早春。",
      "聊題一片葉，將寄接流人。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "一片葉",
        "variant": "紅葉上",
        "source": "一作「紅葉上」"
      }
    ]
  },
  {
    "uid": "QTS_797_004_01",
    "volume": 797,
    "author": {
      "canonical": "天寶宮人",
      "recorded": "天寶宮人",
      "gender": "female",
      "period": "High Tang"
    },
    "title": "又題",
    "poem": [
      "一葉題詩出禁城，誰人酬和獨含情。",
      "自嗟不及波中葉，蕩漾乘春取次行。"
    ]
  },
  {
    "uid": "QTS_797_005_01",
    "volume": 797,
    "author": {
      "canonical": "德宗宮人",
      "recorded": "德宗宮人",
      "gender": "female",
      "period": "Middle Tang"
    },
    "title": "題花葉詩",
    "poem": [
      "一入深宮裏，無由得見春。",
      "題詩花葉上，寄與接流人。"
    ]
  },
  {
    "uid": "QTS_797_006_01",
    "volume": 797,
    "author": {
      "canonical": "宣宗宮人",
      "recorded": "宣宗宮人",
      "gender": "female",
      "period": "Late Tang"
    },
    "title": "題紅葉",
    "poem": [
      "流水何太急，深宮盡日閒。",
      "殷勤謝紅葉，好去到人間。"
    ]
  },
  {
    "uid": "QTS_797_007_01",
    "volume": 797,
    "author": {
      "canonical": "僖宗宮人",
      "recorded": "僖宗宮人",
      "gender": "female",
      "period": "Late Tang"
    },
    "title": "金鎖詩",
    "poem": [
      "玉燭製袍夜，金刀呵手裁。",
      "鎖寄千里客，鎖心終不開。"
    ],
    "variants": [
