  {
    "uid": "QTS_546_011_01",
    "volume": 546,
    "author": {
      "canonical": "彭蟾",
      "recorded": "彭蟾"
    },
    "title": "賀鄧璠使君正拜袁州",
    "poem": [
      "六年惠愛及黎甿，大府論功俟陟明。",
      "尺一詔書天上降，二千石祿世間榮。",
      "新添畫戟門增峻，舊躡青雲路轉平。",
      "更待皇恩醒善政，碧油幢到郡齋迎。"
    ]
  },
  {
    "uid": "QTS_546_012_01",
    "volume": 546,
    "author": {
      "canonical": "王樞",
      "recorded": "王樞",
      "gender": "male",
      "english_name": "Wang Shu",
      "wikidata_id": "Q18905467"
    },
    "title": "和嚴惲落花詩",
    "poem": [
      "花落花開人世夢，衰榮閒事且持杯。",
      "春風底事輕搖落，何似從來不要開。"
    ]
  },
  {
    "uid": "QTS_546_013_01",
    "volume": 546,
    "author": {
      "canonical": "張希復",
      "recorded": "張希復"
    },
    "title": "詠宣律和尚袈裟",
    "poem": [
      "共覆三衣中夜寒，披時不鎮尼師壇。",
      "無因蓋得龍宮地，畦裏塵飛葉相殘。"
    ]
  },
  {
    "uid": "QTS_546_014_01",
    "volume": 546,
    "author": {
      "canonical": "錢可復",
      "recorded": "錢可復",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Qian Kefu",
      "wikidata_id": "Q45582089"
    },
    "title": "鶯出谷",
    "poem": [
      "玉律陽和變，時禽羽翮新。",
      "載飛初出穀，一囀已驚人。",
      "拂柳宜煙暖，衝花覺露春。",
      "摶風翻翰疾，向日弄吭頻。",
      "求友心何切，遷喬幸有因。",
      "華林高玉樹，棲託及芳晨。"
    ]
  },
  {
    "uid": "QTS_546_015_01",
    "volume": 546,
    "author": {
      "canonical": "張鷺",
      "recorded": "張鷺",
      "gender": "male",
      "english_name": "Zhang Lu",
      "wikidata_id": "Q45537208"
    },
    "title": "鶯出谷",
    "poem": [
      "弱柳隨儔匹，遷鶯正及春。",
      "乘風音響遠，映日羽毛新。",
      "已得辭幽谷，還將脫俗塵。",
      "鴛鸞方可慕，燕雀迥無鄰。",
      "遊止知難屈，飜飛在此伸。",
      "一枝如借便，終冀託深仁。"
    ],
