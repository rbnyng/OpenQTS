      }
    ]
  },
  {
    "uid": "QTS_694_007_01",
    "volume": 694,
    "author": {
      "canonical": "王轂",
      "recorded": "王轂"
    },
    "title": "苦熱行",
    "poem": [
      "祝融南來鞭火龍，火旗焰焰燒天紅。",
      "日輪當午凝不去，萬國如在洪爐中。",
      "五嶽翠乾雲彩滅，陽侯海底愁波竭。",
      "何當一夕金風發，為我掃卻天下熱。"
    ]
  },
  {
    "uid": "QTS_694_008_01",
    "volume": 694,
    "author": {
      "canonical": "王轂",
      "recorded": "王轂"
    },
    "title": "暑日題道邊樹",
    "poem": [
      "火輪迸焰燒長空，浮埃撲面愁朦朦。",
      "羸童走馬喘不進，忽逢碧樹含清風。",
      "清風留我移時住，滿地濃陰嬾前去。",
      "卻歎人無及物功，不似團團道邊樹。"
    ]
  },
  {
    "uid": "QTS_694_009_01",
    "volume": 694,
    "author": {
      "canonical": "王轂",
      "recorded": "王轂"
    },
    "title": "紅薔薇歌",
    "poem": [
      "紅霞爛潑猩猩血，阿母瑤池曬仙纈。",
      "晚日春風奪眼明，蜀機錦彩渾疑黦。",
      "公子亭臺香觸人，百花懡㦬無精神。",
      "薴羅西子見應妬，風光占斷年年新。"
    ]
  },
  {
    "uid": "QTS_694_010_01",
    "volume": 694,
    "author": {
      "canonical": "王轂",
      "recorded": "王轂"
    },
    "title": "刺桐花",
    "poem": [
      "南國清和煙雨辰，刺桐夾道花開新。",
      "林梢簇簇紅霞爛，暑天別覺生精神。",
      "穠英闘火欺朱槿，棲鶴驚飛翅憂燼。",
      "直疑青帝去怱怱，收拾春風渾不盡。"
    ]
  },
  {
    "uid": "QTS_694_011_01",
    "volume": 694,
    "author": {
      "canonical": "王轂",
      "recorded": "王轂"
    },
    "title": "贈蒼溪王明府有文在手曰長生",
    "poem": [
      "執手長生在，人皆號地仙。",
      "水雲真遂性，龜鶴足齊年。",
      "但以酒養氣，何言命在天。",
      "況無婚嫁累，應拍尚平肩。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "足",
        "variant": "定",
        "source": "一作「定」"
      }
    ]
  },
  {
    "uid": "QTS_694_012_01",
    "volume": 694,
    "author": {
      "canonical": "王轂",
      "recorded": "王轂"
    },
    "title": "逢道者神和子",
    "poem": [
      "珍重神和子，聞名五十年。",
      "童顏終不改，綠髮尚依然。",
      "酒裏消閒日，人間作散仙。",
      "長生如可慕，相逐隱林泉。"
    ]
  },
  {
    "uid": "QTS_694_013_01",
    "volume": 694,
    "author": {
      "canonical": "王轂",
      "recorded": "王轂"
    },
    "title": "送友人歸閩",
    "poem": [
      "東南歸思切，把酒且留連。",
      "再會知何處，相看共黯然。",
      "猨啼梨嶺路，月白建溪船。",
      "莫戀家鄉住，酬身在少年。"
    ]
  },
  {
    "uid": "QTS_694_014_01",
    "volume": 694,
    "author": {
      "canonical": "王轂",
      "recorded": "王轂"
    },
    "title": "春草碧色",
    "poem": [
      "習習東風扇，萋萋草色新。",
      "淺深千里碧，高下一時春。",
      "嫩葉舒煙際，微香動水濱。",
      "金塘明夕照，輦路惹芳塵。",
      "造化功何廣，陽和力自均。",
      "今當發生日，瀝懇祝良辰。"
    ]
  },
  {
    "uid": "QTS_694_015_01",
    "volume": 694,
    "author": {
      "canonical": "王轂",
      "recorded": "王轂"
    },
    "title": "夢仙謠三首 其一",
    "poem": [
      "前程漸覺風光好，琪花片片粘瑤草。",
      "有人遺我五色丹，一粒吞之後天老。"
    ],
    "part_index": 1,
    "total_parts": 3
  },
  {
    "uid": "QTS_694_015_02",
    "volume": 694,
    "author": {
      "canonical": "王轂",
      "recorded": "王轂"
    },
    "title": "夢仙謠三首 其二",
    "poem": [
      "青童遞酒金觴疾，列坐紅霞神氣逸。",
      "笑說留連數日間，已是人間一千日。"
    ],
    "part_index": 2,
    "total_parts": 3
  },
  {
    "uid": "QTS_694_015_03",
    "volume": 694,
    "author": {
      "canonical": "王轂",
      "recorded": "王轂"
    },
    "title": "夢仙謠三首 其三",
    "poem": [
      "瑤臺絳節遊皆遍，異果奇花香撲面。",
      "松窗夢覺卻神清，殘月林前三兩片。"
    ],
    "part_index": 3,
    "total_parts": 3
  },
  {
    "uid": "QTS_694_016_01",
    "volume": 694,
    "author": {
      "canonical": "王轂",
      "recorded": "王轂"
    },
    "title": "後魏行",
    "poem": [
      "力微皇帝謗天嗣，太武兇殘人所畏。",
      "一朝𦍩䍽飛上天，子孫盡作河魚餌。"
    ]
  },
  {
    "uid": "QTS_694_017_01",
    "volume": 694,
    "author": {
      "canonical": "王轂",
      "recorded": "王轂"
    },
    "title": "秋",
    "poem": [
      "蟬噪古槐疏葉下，樹銜斜日映孤城。",
      "欲知潘鬢愁多少，一夜新添白數莖。"
    ],
