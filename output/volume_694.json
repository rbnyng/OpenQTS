  },
  {
    "uid": "QTS_694_021_01",
    "volume": 694,
    "author": {
      "canonical": "孫郃",
      "recorded": "孫郃"
    },
    "title": "哭方玄英先生",
    "poem": [
      "牛鬥文星落，知是先生死。",
      "湖上聞哭聲，門前見彈指。",
      "官無一寸祿，名傳千萬里。",
      "死著弊衣裳，生誰顧朱紫。",
      "我心痛其語，淚落不能已。",
      "猶喜韋補闕，揚名薦天子。"
    ]
  },
  {
    "uid": "QTS_694_022_01",
    "volume": 694,
    "author": {
      "canonical": "孫郃",
      "recorded": "孫郃"
    },
    "title": "句",
    "poem": [
      "仕宦類商賈，終日常東西。"
    ]
  },
  {
    "uid": "QTS_694_023_01",
    "volume": 694,
    "author": {
      "canonical": "褚載",
      "recorded": "褚載"
    },
    "title": "投節度邢公",
    "poem": [
      "西風昨夜墜紅蘭，一宿郵亭事萬般。",
      "無地可耕歸不得，有恩堪報死何難。",
      "流年怕老看將老，百計求安未得安。",
      "一卷新書滿懷淚，頻來門館訴飢寒。"
    ]
  },
  {
    "uid": "QTS_694_024_01",
    "volume": 694,
    "author": {
      "canonical": "褚載",
      "recorded": "褚載"
    },
    "title": "賀趙觀文重試及第",
    "poem": [
      "一枝仙桂兩回春，始覺文章可致身。",
      "已把色絲要上第，又將彩筆冠羣倫。",
      "龍泉再淬方知利，火浣重燒轉更新。",
      "今日街頭看御牓，大能榮耀苦心人。"
    ]
  },
  {
    "uid": "QTS_694_025_01",
    "volume": 694,
    "author": {
      "canonical": "褚載",
      "recorded": "褚載"
    },
    "title": "贈道士",
    "poem": [
      "簪星曳月下蓬壺，曾見東皐種白榆。",
      "六甲威靈藏瑞檢，五龍雷電遶霜都。",
      "惟教鶴探丹丘信，不使人窺太乙爐。",
      "聞說葛陂風浪惡，許騎青鹿從行無。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "使",
        "variant": "遣",
        "source": "一作「遣」"
      }
    ]
  },
  {
    "uid": "QTS_694_026_01",
    "volume": 694,
    "author": {
      "canonical": "褚載",
      "recorded": "褚載"
    },
    "title": "曉發",
    "poem": [
      "貪路貪名須早發，枕前無計暫裵回。",
      "纔聞雞唱呼童起，已有鈴聲過驛來。",
      "衣溼乍驚霑霧露，馬行仍未見塵埃。",
      "朝朝陌上侵星去，待得酬身了便回。"
    ]
  },
  {
    "uid": "QTS_694_027_01",
    "volume": 694,
    "author": {
      "canonical": "褚載",
      "recorded": "褚載"
    },
    "title": "曉感",
    "poem": [
      "曉鼓鼕鼕星漢微，佩金鳴玉鬬光輝。",
      "出門各自爭岐路，至老何人免是非。",
      "大道不應由曲取，浮生還要略知機。",
      "故園華表高高在，可得不如丁令威。"
    ]
  },
  {
    "uid": "QTS_694_028_01",
    "volume": 694,
    "author": {
      "canonical": "褚載",
      "recorded": "褚載"
    },
    "title": "南徐晚望",
    "poem": [
      "芳草鋪香晚岸晴，岸頭含醉去來行。",
      "僧歸岳外殘鐘寺，日下江邊調角城。",
      "入浙孤帆知楚信，過淮疎雨帶潮聲。",
      "如今未免風塵役，寧敢怱怱便濯纓。"
    ]
  },
  {
    "uid": "QTS_694_029_01",
    "volume": 694,
    "author": {
      "canonical": "褚載",
      "recorded": "褚載"
    },
    "title": "移石",
    "poem": [
      "嶙峋一片溪中石，恰稱幽人彈素琴。",
      "浪浸多年苔色在，洗來今日碏痕深。",
      "磨看粹色何殊玉，敲有奇聲直異金。",
      "不是不堪為器用，都緣良匠未留心。"
    ]
  },
  {
    "uid": "QTS_694_030_01",
    "volume": 694,
    "author": {
      "canonical": "褚載",
      "recorded": "褚載"
    },
    "title": "瀑布",
    "poem": [
      "瀉霧傾煙撼撼雷，滿山風雨助喧豗。",
      "爭知不是青天闕，撲下銀河一半來。"
    ]
  },
  {
    "uid": "QTS_694_031_01",
    "volume": 694,
    "author": {
      "canonical": "褚載",
      "recorded": "褚載"
    },
    "title": "定鼎門",
    "poem": [
      "郟鄏城高門倚天，九重蹤跡尚依然。",
      "須知道德無闗鎖，一閉乾坤一萬年。"
    ]
  },
  {
    "uid": "QTS_694_032_01",
    "volume": 694,
    "author": {
      "canonical": "褚載",
      "recorded": "褚載"
    },
    "title": "陳倉驛",
    "poem": [
      "錦翼花冠安在哉？雄飛雌伏盡塵埃。",
      "一雙童子應惆悵，不見真人更獵來。"
    ]
  },
  {
    "uid": "QTS_694_033_01",
    "volume": 694,
    "author": {
      "canonical": "褚載",
      "recorded": "褚載"
    },
    "title": "長城",
    "poem": [
      "秦築長城比鐵牢，蕃戎不敢過臨洮。",
      "焉知萬里連雲色，不及堯階三尺高。"
    ]
  },
  {
    "uid": "QTS_694_034_01",
    "volume": 694,
    "author": {
      "canonical": "褚載",
      "recorded": "褚載"
    },
    "title": "弔秦叟",
    "poem": [
      "市西樓店金千秤，渭北田園粟萬鐘。",
      "兒被殺傷妻被虜，一身隨駕到三峰。"
    ]
  },
  {
    "uid": "QTS_694_035_01",
    "volume": 694,
    "author": {
      "canonical": "褚載",
      "recorded": "褚載"
    },
    "title": "雲",
    "poem": [
      "盡日看雲首不回，無心都大似無才。",
      "可憐光采一片玉，萬里晴天何處來？"
    ],
    "notes": [
      {
        "content": "一作杜牧詩。",
        "context": "雲",
        "original_title": "雲",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_694_036_01",
    "volume": 694,
    "author": {
      "canonical": "褚載",
      "recorded": "褚載"
    },
    "title": "鶴",
    "poem": [
      "欲洗霜翎下澗邊，卻嫌菱刺汚香泉。",
      "沙鷗浦鴈應驚訝，一舉扶搖直上天。"
    ]
  },
  {
    "uid": "QTS_694_037_01",
    "volume": 694,
    "author": {
      "canonical": "褚載",
      "recorded": "褚載"
    },
    "title": "句",
    "poem": [
      "相逢多是醉醺然，應有囊中子母錢。",
      "有興欲沽紅麴酒，無人同上翠旌樓。",
      "星斗離披煙靄收，玉蟾蜍耀海東頭。",
      "鹿胎冠子水晶簪，長嘯欹眠紫桂陰。",
      "躞蹀馬搖金絡腦，嬋娟人墜玉搔頭。",
      "狂歌放飲渾成性，知道逍遙出俗籠。",
      "除卻洛陽才子後，更誰封恨弔懷沙。",
      "蓮浦浪澄堪倚釣，柳堤風暖好垂鞭。",
      "上馬等閒銷白日，出門輕薄倚黃金。",
      "淨名方丈雖然病，曼倩年涯未有多。"
    ],
