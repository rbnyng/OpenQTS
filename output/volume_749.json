[
  {
    "uid": "QTS_749_001_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "登毗陵青山樓",
    "poem": [
      "高樓閒上對晴空，豁目開襟半日中。",
      "千里吳山清不斷，一邊遼海浸無窮。",
      "人生歌笑開花霧，世界興亡落葉風。",
      "吟罷倚欄何限意，回頭城郭暮煙籠。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "霧",
        "variant": "露",
        "source": "一作「露」"
      }
    ]
  },
  {
    "uid": "QTS_749_002_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "晉陵罷任寓居，依韻和陳銳秀才見寄",
    "poem": [
      "掩門三徑莓苔綠，車馬誰來陋巷間。",
      "臥棄琴書公幹病，笑迎風月步兵閒。",
      "當秋每謝蛬清耳，漸老多慙酒借顔。",
      "濟物未能伸一術，敢於明代愛青山。"
    ]
  },
  {
    "uid": "QTS_749_003_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "春苔",
    "poem": [
      "春霖催得鎖煙濃，竹院莎齋徑小通。",
      "誰愛落花風味處，莫愁門巷襯殘紅。"
    ]
  },
  {
    "uid": "QTS_749_004_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "夏雲",
    "poem": [
      "如峰形狀在西郊，未見從龍上泬寥。",
      "多謝好風吹起後，化為甘雨濟田苗。"
    ]
  },
  {
    "uid": "QTS_749_005_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "書夏秀才幽居壁",
    "poem": [
      "永巷苔深戶半開，牀頭書劍積塵埃。",
      "最憐小檻疎篁晩，幽鳥雙雙何處來。"
    ]
  },
  {
    "uid": "QTS_749_006_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "紅花",
    "poem": [
      "紅花顏色掩千花，任是猩猩血未加。",
      "染出輕羅莫相貴，古人崇儉誡奢華。"
    ]
  },
  {
    "uid": "QTS_749_007_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "安福縣秋吟寄陳銳祕書",
    "poem": [
      "縣庭事簡得餘功，詩興秋來不可窮。",
      "臥聽寒蛬莎砌月，行衝落葉水村風。",
      "愁髭漸去人前白，醉面猶憐鑑裏紅。",
      "苦恨交親多契濶，未知良會㡬時同。"
    ]
  },
  {
    "uid": "QTS_749_008_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "新喻縣酬王仲華少府見貽",
    "poem": [
      "事簡開樽有逸情，共忻官舍月華清。",
      "每慙花欠河陽景，長愧琴無單父聲。",
      "未泰黎元慚曠職，縱行謙直是虛名。",
      "與君盡力行公道，敢向昌朝俟陟眀。"
    ]
  },
  {
    "uid": "QTS_749_009_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "暮春有感寄宋維員外",
    "poem": [
      "杜宇聲中老病心，此心無計駐光陰。",
      "西園雨過好花盡，南陌人稀芳草深。",
      "喧夢卻嫌鶯語老，伴吟惟怕月輪沉。",
      "眀年才候東風至，結駟期君預去尋。"
    ]
  },
  {
    "uid": "QTS_749_010_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "題吉水縣廳前新栽小松",
    "poem": [
      "劚開幽澗蘚苔斑，移得孤根植砌前。",
      "影小未遮官舍月，翠濃猶帶舊山煙。",
      "羣花解笑香寧久，衆木雖高節不堅。",
      "輸我婆娑欄檻內，晩風蕭颯學幽泉。"
    ]
  },
  {
    "uid": "QTS_749_011_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "贈念綬上人",
    "poem": [
      "五更初起掃松堂，瞑目先焚一炷香。",
      "念徹蓮經誰得見，千峰巖外曉蒼蒼。"
    ],
    "notes": [
      {
        "content": "法華經",
        "context": "贈念",
        "original_title": "贈念《法華經》綬上人"
      }
    ]
  },
  {
    "uid": "QTS_749_012_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "秋日途中",
    "poem": [
      "信步騰騰野㟁邊，離家都爲利名牽。",
      "疎林一路斜陽裏，颯颯西風滿耳蟬。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "㟁",
        "variant": "岸",
        "source": "一作「岸」"
      }
    ]
  },
  {
    "uid": "QTS_749_013_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "宿韋校書幽居",
    "poem": [
      "溪上高眠與鶴閒，開樽留我待柴關。",
      "園林月白秋霖歇，一夜泉聲似故山。"
    ]
  },
  {
    "uid": "QTS_749_014_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "依韻和友人秋夕見寄",
    "poem": [
      "夕風庭葉落，誰見此時情。",
      "不作關河夢，空聞砧杵聲。",
      "會須求至理，何必歎無成。",
      "好約高僧宿，同看海月生。"
    ]
  },
  {
    "uid": "QTS_749_015_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "吉水作尉酬高援秀才見贈",
    "poem": [
      "佐邑慙無術，敢言貧與清。",
      "風騷誰是主，煙月自關情。",
      "卷箔當山色，開窗就竹聲。",
      "憐君惠嘉句，資我欲垂名。"
    ]
  },
  {
    "uid": "QTS_749_016_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "送智雄上人",
    "poem": [
      "忽起遊方念，飄然不可留。",
      "未知攜一錫，乘興向何州。",
      "古㟁春雲散，遙天晩雨收。",
      "想應重會面，風月又清秋。"
    ]
  },
  {
    "uid": "QTS_749_017_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "覽友人卷",
    "poem": [
      "新詩開卷處，造化竭精英。",
      "雪霽楚山碧，月高湘水清。",
      "初吟塵慮息，再味古風生。",
      "自此寰區內，喧騰二雅名。"
    ]
  },
  {
    "uid": "QTS_749_018_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "送人南逰",
    "poem": [
      "浪跡天涯去，南荒必動情。",
      "草青虞帝廟，雲暗夜郎城。",
      "越鳥驚鄉夢，蠻風解宿酲。",
      "早思歸故里，華髮等閒生。"
    ]
  },
  {
    "uid": "QTS_749_019_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "晉陵縣夏日作",
    "poem": [
      "事簡公庭靜，開簾暑氣中。",
      "依經煎綠茗，入竹就清風。",
      "至論招禪客，忘機憶釣翁。",
      "晩涼安枕簟，海月出牆東。"
    ]
  },
  {
    "uid": "QTS_749_020_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "郵亭蚤起",
    "poem": [
      "郵舍殘燈在，村林雞唱頻。",
      "星河吟裏曉，川陸望中春。",
      "舊友青雲貴，殊鄉素髮新。",
      "悠悠念行計，難更駐征輪。"
    ]
  },
  {
    "uid": "QTS_749_021_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "客中寒食",
    "poem": [
      "旅次經寒食，思鄉淚濕巾。",
      "音書天外斷，桃李雨中春。",
      "欲飲都無緒，唯吟似有因。",
      "輸他郊郭外，多少踏青人。"
    ]
  },
  {
    "uid": "QTS_749_022_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "旅館秋夕",
    "poem": [
      "寥寥山館裏，獨坐酒初醒。",
      "舊業多年別，秋霖一夜聽。",
      "砌蛬聲漸息，窗燭影猶停。",
      "蚤晚無他事，休如泛水萍。"
    ]
  },
  {
    "uid": "QTS_749_023_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "宿青溪米處士幽居",
    "poem": [
      "寄宿溪光裏，夜涼高士家。",
      "養風窗外竹，叫月水中蛙。",
      "靜慮同搜句，清神旋煮茶。",
      "唯憂暁雞唱，塵裏事如麻。"
    ]
  },
  {
    "uid": "QTS_749_024_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "維舟秋浦，逢故人張矩同泊",
    "poem": [
      "卸帆清夜碧江濱，冉冉涼風動白蘋。",
      "波上正吟新霽月，岸頭恰見故鄉人。",
      "共驚別後霜侵鬢，互說年來疾逼身。",
      "且飲一壺銷百恨，會須遭遇識通津。"
    ]
  },
  {
    "uid": "QTS_749_025_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "代別",
    "poem": [
      "明日鳴鞭天一涯，悠悠此夕怯分離。",
      "紅樓有恨金波轉，翠黛無言玉筯垂。",
      "浮蟻不能迷遠意，廻紋從此寄相思。",
      "花時定是慵開鑑，獨向春風忍掃睂。"
    ]
  },
  {
    "uid": "QTS_749_026_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "悼懷王喪妃",
    "poem": [
      "花綻花開事可驚，暫來浮世返蓬瀛。",
      "楚宮夢斷雲空在，洛浦神歸月自眀。",
      "香解返魂成浪語，膠能續斷是虛名。",
      "音容寂寞春牢落，誰會樓中獨立情。"
    ]
  },
  {
    "uid": "QTS_749_027_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "酒醒",
    "poem": [
      "睡覺花陰芳草軟，不知明月出牆東。",
      "杯盤狼藉人何處，聚散空驚似夢中。"
    ]
  },
  {
    "uid": "QTS_749_028_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "送虞道士",
    "poem": [
      "煙霞聚散通三島，星斗分眀在一壺。",
      "笑說餘杭沽酒去，蔡家重要會麻姑。"
    ]
  },
  {
    "uid": "QTS_749_029_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "懷舊夜吟寄趙杞",
    "poem": [
      "長笛聲中海月飛，桃花零落滿庭墀。",
      "魂銷事去無尋處，酒醒孤吟不寐時。",
      "萱草豈能忘積恨，尺書誰與逹相思。",
      "悠悠方寸何因解，明日江樓望渺瀰。"
    ]
  },
  {
    "uid": "QTS_749_030_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "宿臨江驛",
    "poem": [
      "候館寥寥輟櫂過，酒醒無奈旅愁何。",
      "雨昬郊郭行人少，葦暗汀洲宿雁多。",
      "干祿已悲凋髮鬢，結茅終愧負煙蘿。",
      "篇章早晚逢知已，苦志忘形自有魔。"
    ]
  },
  {
    "uid": "QTS_749_031_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "途中柳",
    "poem": [
      "翠色晴來近，長亭路去遙。",
      "無人折煙縷，落日拂溪橋。"
    ]
  },
  {
    "uid": "QTS_749_032_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "隔牆花",
    "poem": [
      "顏色尤難近，馨香不易通。",
      "朱門金鎖隔，空使怨春風。"
    ]
  },
  {
    "uid": "QTS_749_033_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "廣陵寒食夜",
    "poem": [
      "廣陵寒食夜，豪貴足佳期。",
      "紫陌人歸後，紅樓月上時。",
      "綺羅香未歇，絲竹韻猶遲。",
      "明日踏青興，輸他輕薄兒。"
    ]
  },
  {
    "uid": "QTS_749_034_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "寄廬山莊隱士",
    "poem": [
      "煙蘿擁竹關，物外自求安。",
      "逼枕溪聲近，當簷岳色寒。",
      "藥苖應自採，琴調對誰彈。",
      "待了浮名後，依君共掛冠。"
    ]
  },
  {
    "uid": "QTS_749_035_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "吉水寄閻侍御",
    "poem": [
      "何處懷君切，令人慾白頭。",
      "偶尋花外寺，獨立水邊樓。",
      "不得論休戚，何因校獻酬。",
      "吟餘興難盡，風笛起漁舟。"
    ]
  },
  {
    "uid": "QTS_749_036_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "送張維貞少府之江陰",
    "poem": [
      "相送煙汀畔，酒闌登小舟。",
      "離京梅雨歇，到邑早蟬秋。",
      "俗必期康濟，詩誰互唱酬。",
      "晩涼諸吏散，海月入虛樓。"
    ],
    "variants": [
      {
        "line": 4,
        "text": "入",
        "variant": "上",
        "source": "一作「上」"
      }
    ]
  },
  {
    "uid": "QTS_749_037_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "鍾陵禁煙寄從弟",
    "poem": [
      "落絮飛花日又西，踏青無侶草萋萋。",
      "交親書斷竟不到，忍聽黃昏杜宇啼。"
    ]
  },
  {
    "uid": "QTS_749_038_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "夜泊江渚",
    "poem": [
      "水鄉眀月上晴空，汀島香生杜若風。",
      "不是當年獨醒客，且沽邨酒待漁翁。"
    ]
  },
  {
    "uid": "QTS_749_039_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "吉水縣依韻酬華松秀才見寄",
    "poem": [
      "官況蕭條在水村，吏歸無事好論文。",
      "枕欹獨聽殘春雨，夢去空尋五老雲。",
      "竹徑每憐和蘚步，禽聲偏愛隔花聞。",
      "詩情冷淡知音少，獨喜江皋得見君。"
    ]
  },
  {
    "uid": "QTS_749_040_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "貽廬山清溪觀王尊師",
    "poem": [
      "霞帔星冠復杖藜，積年修鍊住靈溪。",
      "松軒睡覺冷雲起，石磴坐來春日西。",
      "採藥每尋巖徑遠，彈琴常到月輪低。",
      "鼎中龍虎功成後，海上三山去不迷。"
    ]
  },
  {
    "uid": "QTS_749_041_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "王昭君",
    "poem": [
      "蛾眉翻自累，萬里䧟窮邊。",
      "滴淚胡風起，寛心漢月圎。",
      "飛塵長翳日，白草自連天。",
      "誰貢和親策，千秋汚簡編。"
    ]
  },
  {
    "uid": "QTS_749_042_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "送姚端先輩歸寧",
    "poem": [
      "知君歸覲省，稱意涉通津。",
      "解䌫汀洲曉，張帆煙水春。",
      "牽吟芳草遠，貰酒亂花新。",
      "拜慶庭闈處，蟾枝香滿身。"
    ]
  },
  {
    "uid": "QTS_749_043_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "江村晚秋作",
    "poem": [
      "高秋水村路，隔㟁見人家。",
      "好是經霜葉，紅於帶露花。",
      "臨罾魚易得，就店酒難賖。",
      "吟興胡能盡，風清日又斜。"
    ]
  },
  {
    "uid": "QTS_749_044_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "蛩",
    "poem": [
      "月冷莎庭夜巳深，百蟲聲外有清音。",
      "詩情正苦無眠處，愧爾堦前相伴吟。"
    ]
  },
  {
    "uid": "QTS_749_045_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "感秋書事",
    "poem": [
      "宦途憔悴雪生頭，家計相牽未得休。",
      "紅蓼白蘋消息斷，舊溪煙月負漁舟。"
    ]
  },
  {
    "uid": "QTS_749_046_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "訪廬山歸章禪伯",
    "poem": [
      "沈沈石室疎鐘後，寂寂莎池片月明。",
      "多少學徒求妙法，要於言下悟無生。"
    ]
  },
  {
    "uid": "QTS_749_047_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "廬山棲隱洞譚先生院留題",
    "poem": [
      "壇畔歸雲冷濕襟，拂苔移石坐花陰。",
      "偶然醒得莊周夢，始覺玄門興味深。"
    ]
  },
  {
    "uid": "QTS_749_048_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "江行值暴風雨",
    "poem": [
      "風狂雨暗舟人懼，自委神明志不邪。",
      "投得葦灣波浪息，㟁頭煙火近人家。"
    ]
  },
  {
    "uid": "QTS_749_049_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "杪秋夕吟懷寄宋維先輩",
    "poem": [
      "江島窮秋木葉稀，月高何處搗寒衣。",
      "苦嗟不見登龍客，此夜悠悠一夢飛。"
    ]
  },
  {
    "uid": "QTS_749_050_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "七夕",
    "poem": [
      "星河耿耿正新秋，絲竹千家列綵樓。",
      "可惜穿針方有興，纖纖初月苦難留。"
    ]
  },
  {
    "uid": "QTS_749_051_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "吉水作尉時酬閻侍御見寄",
    "poem": [
      "謬佐驅雞任，常思賦鵩人。",
      "未諧林下約，空感病來身。",
      "鏁徑青苔老，鋪階紅葉新。",
      "相思不可見，猶喜得書頻。"
    ]
  },
  {
    "uid": "QTS_749_052_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "清溪逢張維貞秀才",
    "poem": [
      "洞隠紅霞外，房開碧嶂根。",
      "昔年同鍊句，幾夜共聽猨。",
      "考古書千卷，忘憂酒一樽。",
      "如今歸建業，雅道喜重論。"
    ]
  },
  {
    "uid": "QTS_749_053_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "送閻侍御歸闕",
    "poem": [
      "羨君乘紫詔，歸路指通津。",
      "鼓櫂煙波暖，還京雨露新。",
      "趨朝丹禁暁，聳轡九衢春。",
      "自愧湮沈者，隨軒未有因。"
    ]
  },
  {
    "uid": "QTS_749_054_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "甲子歲罷吉水縣過鍾陵時暮春維舟江渚謁柴太尉席上作",
    "poem": [
      "公侯延駐暫踟躕，況值風光三月初。",
      "亂落杯盤花片小，靜籠池閣柳陰疎。",
      "舟維南浦程雖阻，飲預西園興有餘。",
      "卻笑田家門下客，當時容易歎車魚。"
    ]
  },
  {
    "uid": "QTS_749_055_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "海上春夕旅懷寄左偃",
    "poem": [
      "柳過清明絮亂飛，感時懷舊思悽悽。",
      "月生樓閣雲初散，家在汀洲夢去迷。",
      "髮白每慙清鑑啟，酒醒長怯子規啼。",
      "北山高臥風騷客，安得同吟復杖藜。"
    ]
  },
  {
    "uid": "QTS_749_056_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "江次維舟登古寺",
    "poem": [
      "輟櫂因過古梵宮，荒涼門徑鏁苔茸。",
      "綠陰滿地前朝樹，清韻含風後殿鐘。",
      "童子縱慵眠壞榻，老僧躭話指諸峰。",
      "吟餘卻返來時路，回首盤桓尚駐笻。"
    ]
  },
  {
    "uid": "QTS_749_057_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "春日招宋維先輩",
    "poem": [
      "甕中竹葉今朝熟，鑑裏桃花昨日開。",
      "為報廣寒攀桂客，莫辭相訪共銜杯。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "日",
        "variant": "夜",
        "source": "一作「夜」"
      }
    ]
  },
  {
    "uid": "QTS_749_058_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "吹笛兒",
    "poem": [
      "隴頭休聽月眀中，妙竹嘉音際會逢。",
      "見爾樽前吹一曲，令人重憶許雲封。"
    ]
  },
  {
    "uid": "QTS_749_059_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "所思",
    "poem": [
      "解珮當時在洛濱，悠悠疑是夢中身。",
      "自從物外無消息，花謝鶯啼近十春。"
    ]
  },
  {
    "uid": "QTS_749_060_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "吉水縣酬夏侯秀才見寄",
    "poem": [
      "啟鑑悠悠兩鬢蒼，病來心緒易淒涼。",
      "知音不到吟還懶，鏁印開簾又夕陽。"
    ]
  },
  {
    "uid": "QTS_749_061_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "和友人喜雪",
    "poem": [
      "臘雪頻頻降，成堆不可除。",
      "伴吟花莫並，銷瘴藥何如。",
      "謝女詩成處，袁安睡起初。",
      "深迷樵子徑，冷逼旅人居。",
      "惹砌催罇俎，飄窗入簿書。",
      "㝡宜樓上望，散亂滿空虛。"
    ]
  },
  {
    "uid": "QTS_749_062_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "感事呈所知",
    "poem": [
      "競愛松筠翠，皆憐桃李芳。",
      "如求濟世廣，桑柘願商量。"
    ]
  },
  {
    "uid": "QTS_749_063_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "送汪濤",
    "poem": [
      "知君別家後，不免淚霑襟。",
      "芳草千里路，夕陽孤客心。",
      "花飛當野渡，猨叫在煙岑。",
      "霄漢知音在，何須恨陸沈。"
    ]
  },
  {
    "uid": "QTS_749_064_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "言志寄劉鈞秀才",
    "poem": [
      "童稚親儒墨，時平喜道存。",
      "酬身指書劍，賦命委乾坤。",
      "秋爽鼓琴興，月清搜句魂。",
      "與君同此志，終待至公論。"
    ]
  },
  {
    "uid": "QTS_749_065_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "訪澄上人",
    "poem": [
      "尋師來靜境，神骨覺清涼。",
      "一餉逢秋雨，相留坐竹堂。",
      "石渠堆敗葉，莎砌咽寒螿。",
      "話到南能㫖，怡然萬慮忘。"
    ]
  },
  {
    "uid": "QTS_749_066_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "經古寺",
    "poem": [
      "殿宇半隳摧，門臨野水開。",
      "雲凝何代樹，草蔽此時臺。",
      "遶塔堆黃葉，沿階積綠苔。",
      "踟躕日將暮，棲鳥入巢來。"
    ]
  },
  {
    "uid": "QTS_749_067_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "送王道士逰東海",
    "poem": [
      "巨浸常牽夢，雲逰豈覺勞。",
      "遙空收晩雨，虛閣看秋濤。",
      "必若思三島，應須釣六鼇。",
      "如通十洲去，誰信碧天高。"
    ]
  },
  {
    "uid": "QTS_749_068_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "貽青陽宰",
    "poem": [
      "徵賦常登限，名山管最多。",
      "吏閑民訟少，時得訪煙蘿。"
    ]
  },
  {
    "uid": "QTS_749_069_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "哭故主人陳太師",
    "poem": [
      "十年孤跡寄侯門，入室升堂忝厚恩。",
      "逰遍春郊隨茜斾，飲殘秋月待金尊。",
      "車魚鄭重知難報，吐握周旋不可論。",
      "長慟裵回逝川上，白楊蕭颯又黃昏。"
    ]
  },
  {
    "uid": "QTS_749_070_01",
    "volume": 749,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "秋江夜泊寄劉鈞",
    "poem": [
      "萬里江山歛暮煙，旅情當此獨悠然。",
      "沙汀月冷帆初缷，葦㟁風多人未眠。",
      "已聽漁翁歌別浦，更堪邊雁過遙天。",
      "與君共俟酬身了，結侶波中寄釣船。"
    ]
  }
]