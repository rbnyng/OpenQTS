    "author": {
      "canonical": "趙鴻",
      "recorded": "趙鴻"
    },
    "title": "杜甫同谷茅茨",
    "poem": [
      "工部棲遲後，鄰家大半無。",
      "青羌迷道路，白社寄杯盂。",
      "大雅何人繼，全生此地孤。",
      "孤雲飛鳥什，空勒舊山隅。"
    ]
  },
  {
    "uid": "QTS_607_016_01",
    "volume": 607,
    "author": {
      "canonical": "趙鴻",
      "recorded": "趙鴻"
    },
    "title": "栗亭",
    "poem": [
      "杜甫栗亭詩，詩人多在口。",
      "悠悠二甲子，題紀今何有。"
    ]
  },
  {
    "uid": "QTS_607_017_01",
    "volume": 607,
    "author": {
      "canonical": "趙鴻",
      "recorded": "趙鴻"
    },
    "title": "泥功山",
    "poem": [
      "立石泥功狀，天然詭怪形。",
      "未嘗私禍福，終不費丹青。"
    ]
  },
  {
    "uid": "QTS_607_018_01",
    "volume": 607,
    "author": {
      "canonical": "童翰卿",
      "recorded": "童翰卿",
      "gender": "male"
    },
    "title": "昆明池織女石",
    "poem": [
      "一片昆明石，千秋織女名。",
      "見人虛脈脈，臨水更盈盈。",
      "苔作輕衣色，波為促杼聲。",
      "岸雲連鬢濕，沙月對眉生。",
      "有臉蓮同笑，無心鳥不驚。",
      "還如朝鏡裏，形影兩分明。"
    ]
  },
  {
    "uid": "QTS_607_019_01",
    "volume": 607,
    "author": {
      "canonical": "童翰卿",
      "recorded": "童翰卿",
      "gender": "male"
    },
    "title": "絕句",
    "poem": [
      "大朴逐物盡，哀我天地功。",
      "爭得榮辱心，灑然歸西風。"
    ]
  }
