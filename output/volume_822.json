      "gender": "male"
    },
    "title": "駕幸天長寺應制",
    "poem": [
      "天界宜春賞，禪門不掩關。",
      "宸游雙闕外，僧引百花間。",
      "車馬喧長路，煙雲淨遠山。",
      "觀空復觀俗，皇鑒此中閒。"
    ],
    "variants": [
