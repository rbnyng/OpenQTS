      "recorded": "廣宣",
      "gender": "male"
    },
    "title": "早秋降誕日獻壽二首應制 其二",
    "poem": [
      "萬方瞻聖日，九土仰清光。",
      "磬地山河壯，彌天福壽長。",
      "瑞煙熏法界，真偈啟仁王。",
      "看獻千秋樂，千秋樂未央。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_822_006_01",
