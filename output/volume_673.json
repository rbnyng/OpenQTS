        "source": "一作「坐」"
      }
    ]
  },
  {
    "uid": "QTS_673_032_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "春日秦國懷古",
    "poem": [
      "荒郊一望欲銷魂，涇水縈紆傍遠村。",
      "牛馬放多春草盡，原田耕破古碑存。",
      "雲和積雪蒼山晩，煙伴殘陽綠樹昏。",
      "數里黃沙行客路，不堪回首思秦原。"
    ],
    "variants": [
      {
        "line": 4,
        "text": "客路",
        "variant": "路客",
        "source": "一作「路客」"
      }
    ]
  },
  {
    "uid": "QTS_673_033_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "春日遊北園寄韓侍郎",
    "poem": [
      "灼灼春園晩色分，露珠千㸃映寒雲。",
      "多情舞蝶穿花去，解語流鶯隔水聞。",
      "冷酒桮中宜泛灔，暖風林下自氛氳。",
      "仙桃不肯全開拆，應借餘芳待使君。"
    ]
  },
  {
    "uid": "QTS_673_034_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "喜賀拔先輩衡陽除正字",
    "poem": [
      "黃紙晴空墜一緘，聖朝恩澤洗冤讒。",
      "李膺門客為閑客，梅福官銜改舊銜。",
      "名自石渠書典籍，香從芸閣著衣衫。",
      "寰中不用憂天旱，霖雨看看屬傅巖。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "朝",
        "variant": "明",
        "source": "一作「明」"
      }
    ]
  },
  {
    "uid": "QTS_673_035_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "客州賃居寄蕭郎中",
    "poem": [
      "松店茅軒向水開，東頭舍賃一裵徊。",
      "窗吟苦為秋江靜，枕夢驚因曉角催。",
      "鄰舍見愁賖酒與，主人知去索錢來。",
      "眼看白筆為霖雨，肻使紅鱗便曝腮。"
    ]
  },
  {
    "uid": "QTS_673_036_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "贈李裕先輩",
    "poem": [
      "曉擎弓箭入初場，一發曾穿百步楊。",
      "仙籍舊題前進士，聖朝新奏校書郎。",
      "馬疑金馬門前馬，香認芸香閣上香。",
      "閑伴李膺紅燭下，慢吟絲竹淺飛觴。"
    ]
  },
  {
    "uid": "QTS_673_037_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "桐栢觀",
    "poem": [
      "東南一境清心目，有此千峰挿翠微。",
      "人在下方衝月上，鶴從高處破煙飛。",
      "巖深水落寒侵骨，門靜花開色照衣。",
      "欲識蓬萊今便是，更於何處學忘機。"
    ]
  },
  {
    "uid": "QTS_673_038_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "塞上",
    "poem": [
      "受降城必破，回落隴頭移。",
      "蕃道北海北，謀生今始知。"
    ]
  },
  {
    "uid": "QTS_673_039_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "塞上曲",
    "poem": [
      "一陣風來一陣砂，有人行處沒人家。",
      "黃河九曲冰先合，紫塞三春不見花。"
    ]
  },
  {
    "uid": "QTS_673_040_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "塞下曲",
    "poem": [
      "石國胡兒向磧東，愛吹橫笛引秋風。",
      "夜來雲雨皆飛盡，月照平沙萬里空。"
    ]
  },
  {
    "uid": "QTS_673_041_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "詠猨",
    "poem": [
      "生在巫山更向西，不知何事到巴溪。",
      "中宵為憶秋雲伴，遙隔朱門向月啼。"
    ]
  },
  {
    "uid": "QTS_673_042_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "桃花",
    "poem": [
      "桃花春色暖先開，明媚誰人不看來。",
      "可惜狂風吹落後，殷紅片片㸃莓苔。"
    ]
  },
  {
    "uid": "QTS_673_043_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "薛老峰",
    "poem": [
      "薛老峰頭三箇字，須知此與石齊生。",
      "直教截斷蒼苔色，浮世人儕眼始明。"
    ]
  },
  {
    "uid": "QTS_673_044_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "弔李羣玉",
    "poem": [
      "羣玉詩名冠李唐，投詩換得校書郎。",
      "吟魂醉魄知何處，空有幽蘭隔岸香。"
    ]
  },
  {
    "uid": "QTS_673_045_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "無等巖",
    "poem": [
      "建造上方藤影裏，高僧往往似天台。",
      "不知名樹簷前長，曾問道人巖下來。"
    ]
  },
  {
    "uid": "QTS_673_046_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "句",
    "poem": [
      "古陵寒雨集，高鳥夕陽明。"
    ],
    "part_index": 1
  },
  {
    "uid": "QTS_673_047_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "句",
    "poem": [
      "高情千里外，長嘯一聲初。"
    ],
    "part_index": 1
  },
  {
    "uid": "QTS_673_048_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "句",
    "poem": [
      "月離山一丈，風吹花數苞。"
    ],
    "part_index": 1
  },
  {
    "uid": "QTS_673_049_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "句",
    "poem": [
      "曉來山鳥閙，雨過杏花稀。"
    ],
    "part_index": 1
  },
  {
    "uid": "QTS_673_050_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "句",
    "poem": [
      "曲渚回灣鎖釣舟。"
    ],
    "part_index": 1
  },
  {
    "uid": "QTS_673_051_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "句",
    "poem": [
      "平潮晩影沈清底，遠岳危欄等翠尖。"
    ],
    "part_index": 1
  },
  {
    "uid": "QTS_673_052_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "句",
    "poem": [
      "白日纔離滄海底，清光先照戶窗前。"
    ],
    "part_index": 1
  },
  {
    "uid": "QTS_673_053_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "句",
    "poem": [
      "連雲天塹有山色，極目海門無雁行。"
    ],
    "part_index": 1
  },
  {
    "uid": "QTS_673_054_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "句",
    "poem": [
      "可憐黃雀銜將去，從此莊周夢不成。"
    ],
    "part_index": 1
  },
  {
    "uid": "QTS_673_055_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "句",
    "poem": [
      "禪是大溈詩是朴，大唐天子只三人。"
    ],
    "part_index": 1
