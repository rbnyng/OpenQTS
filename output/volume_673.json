  {
    "uid": "QTS_673_008_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "寄塞北張符",
    "poem": [
      "隴樹塞風吹，遼城角幾枝。",
      "霜凝無暫歇，君貌莫應衰。",
      "萬里平沙際，一行邊雁移。",
      "那堪朔煙起，家信正相離。"
    ]
  },
  {
    "uid": "QTS_673_009_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "次梧州卻寄永州使君",
    "poem": [
      "隨風身不定，今夜在蒼梧。",
      "客淚有時有，猨聲無處無。",
      "潮添瘴海濶，煙拂粵山孤。",
      "卻憶零陵住，吟詩半玉壺。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "風",
        "variant": "雲",
        "source": "一作「雲」"
      }
    ]
  },
  {
    "uid": "QTS_673_010_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "贈念經僧",
    "poem": [
      "菴前古折碑，夜靜念經時。",
      "月皎海霞散，露濃山草垂。",
      "鬼聞拋故塚，禽聽離寒枝。",
      "想得天花墜，馨香拂白睂。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "皎",
        "variant": "皓",
        "source": "一作「皓」"
      }
    ]
  },
  {
    "uid": "QTS_673_011_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "董嶺水",
    "poem": [
      "湖州安吉縣，門與白雲齊。",
      "禹力不到處，河聲流向西。",
      "去衙山色遠，近水月光低。",
      "中有高人在，沙中曵杖藜。"
    ]
  },
  {
    "uid": "QTS_673_012_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "早春",
    "poem": [
      "良夜歳應足，嚴風為變春。",
      "遍回寒作暖，通改舊成新。",
      "秀樹因馨雨，融冰雨泛蘋。",
      "韶光不偏黨，積漸煦疲民。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "因馨雨",
        "variant": "花馨霧",
        "source": "一作「花馨霧」"
      }
    ]
  },
  {
