      }
    ]
  },
  {
    "uid": "QTS_673_031_01",
    "volume": 673,
    "author": {
      "canonical": "周朴",
      "recorded": "周朴"
    },
    "title": "福州開元寺塔",
    "poem": [
      "開元寺裏七重塔，遙對方山影擬齊。",
      "雜俗人看離世界，孤高僧上覺天低。",
      "唯堪片片紫霞映，不與濛濛白霧迷。",
      "心若無私羅漢在，參差免向日虹西。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "重",
        "variant": "層",
        "source": "一作「層」"
      },
      {
        "line": 2,
