  {
    "uid": "QTS_648_007_01",
    "volume": 648,
    "author": {
      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "過朱協律故山",
    "poem": [
      "地下無餘恨，人間得盛名。",
      "殘篇續大雅，稚子托諸生。",
      "度日山空暮，緣溪鶴自鳴。",
      "難收故交意，寒笛一聲聲。"
    ]
  },
  {
    "uid": "QTS_648_008_01",
    "volume": 648,
