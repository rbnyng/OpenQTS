      "canonical": "方干",
      "recorded": "方干"
    },
    "title": "涵碧亭",
    "poem": [
      "高低竹雜松，積翠複留風。",
      "路極陰溪裏，寒生暑氣中。",
      "閒雲低覆草，片水靜涵空。",
      "方見洋源牧，心侔造化功。"
    ],
    "variants": [
      {
