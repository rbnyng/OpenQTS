    "title": "梅花",
    "poem": [
      "繁如瑞雪壓枝開，越嶺吳溪免用栽。",
      "卻是五侯家未識，春風不放過江來。"
    ]
  },
  {
    "uid": "QTS_654_090_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "雞冠花",
    "poem": [
      "一枝穠艷對秋光，露滴風搖倚砌傍。",
      "曉景乍看何處似？謝家新染紫羅裳。"
    ]
  },
  {
    "uid": "QTS_654_091_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "汴河",
    "poem": [
      "煬帝開河鬼亦悲，生民不獨力空疲。",
      "至今嗚咽東流水，似向清平怨昔時。"
    ]
  },
  {
    "uid": "QTS_654_092_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "渡江有感",
    "poem": [
      "岸落殘紅錦雉飛，渡江船上夕陽微。",
      "一枝猶負平生意，歸去何曾勝不歸。"
    ]
  },
  {
    "uid": "QTS_654_093_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "題終南山僧堂",
    "poem": [
      "九衢終日見南山，名利何人肯掩關。",
      "唯有吾師達真理，坐看霜樹老雲間。"
    ]
  },
  {
    "uid": "QTS_654_094_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "大散嶺",
    "poem": [
      "過往長逢日色稀，雪花如掌撲行衣。",
      "嶺頭卻望人來處，特地身疑是鳥飛。"
    ]
  },
  {
    "uid": "QTS_654_095_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "嘉陵江",
    "poem": [
      "嘉陵南岸雨初收，江似秋嵐不煞流。",
      "此地終朝有行客，無人一為櫂扁舟。"
    ]
  },
  {
    "uid": "QTS_654_096_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "早行",
    "poem": [
      "雨灑江聲風又吹，扁舟正與睡相宜。",
      "無端戍鼓催前去，別卻青山向曉時。"
    ]
  },
  {
    "uid": "QTS_654_097_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "黃河曉渡",
    "poem": [
      "大河平野正窮秋，羸馬羸僮古渡頭。",
      "昨夜蓮花峰下月，隔簾相伴到明愁。"
    ]
  },
  {
    "uid": "QTS_654_098_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "溫泉",
    "poem": [
      "一條春水漱莓苔，幾繞玄宗浴殿回。",
      "此水貴妃曾照影，不堪流入舊宮來。"
    ]
  },
  {
    "uid": "QTS_654_099_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "秋怨",
    "poem": [
      "夢斷南窗啼曉烏，新霜昨夜下庭梧。",
      "不知簾外如珪月，還照邊城到曉無。"
    ]
  },
  {
    "uid": "QTS_654_100_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "歎別",
    "poem": [
      "北來南去幾時休，人在光陰似箭流。",
      "直待江山盡無路，始因拋得別離愁。"
    ]
  },
  {
    "uid": "QTS_654_101_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "送春",
    "poem": [
      "欲別東風剩黯然，亦知春去有明年。",
      "世間爭那人先老，更對殘花一醉眠。"
    ]
  },
  {
    "uid": "QTS_654_102_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "蠟燭",
    "poem": [
      "暖香紅焰一時燃，緹幕初垂月落天。",
      "堪恨蘭堂別離夜，如珠似淚滴樽前。"
    ]
  },
  {
    "uid": "QTS_654_103_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "陳宮",
    "poem": [
      "白玉尊前紫桂香，迎春閣上燕雙雙。",
      "陳王半醉貴妃舞，不覺隋兵夜渡江。"
    ]
  },
  {
    "uid": "QTS_654_104_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "水簾",
    "poem": [
      "萬點飛泉下白雲，似簾懸處望疑真。",
      "若將此水為霖雨，更勝長垂隔路塵。"
    ]
  },
  {
    "uid": "QTS_654_105_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "賞春",
    "poem": [
      "芳草和煙煖更青，閒門要路一時生。",
      "年年點檢人間事，唯有春風不世情。"
    ]
  },
  {
    "uid": "QTS_654_106_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "歎平泉",
    "poem": [
      "生前幾到此亭臺，尋歎投荒去不回。",
      "若遣春風會人意，花枝盡合向南開。"
    ]
  },
  {
    "uid": "QTS_654_107_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "長安春雨",
    "poem": [
      "兼風颯颯灑皇州，能滯輕寒阻勝遊。",
      "半夜五侯池館裏，美人驚起為花愁。"
    ],
