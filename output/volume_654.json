[
  {
    "uid": "QTS_654_001_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "歲仗",
    "poem": [
      "玉帛朝元萬國來，雞人曉唱五門開。",
      "春排北極迎仙馭，日捧南山入壽杯。",
      "歌舜熏風鏗劍佩，祝堯嘉氣靄樓臺。",
      "可憐四海車書共，重見蕭曹佐漢材。"
    ],
    "preface": "羅鄴，餘杭人。累舉進士不第，光化中，以韋莊奏，追賜進士及第，贈官補闕。詩一卷。",
    "variants": [
      {
        "line": 2,
        "text": "馭",
        "variant": "仗",
        "source": "一作「仗」"
      }
    ]
  },
  {
    "uid": "QTS_654_002_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "牡丹",
    "poem": [
      "落盡春紅始著花，花時比屋事豪奢。",
      "買栽池館恐無地，看到子孫能幾家。",
      "門倚長衢攢繡轂，幄籠輕日護香霞。",
      "歌鐘滿座爭歡賞，肯信流年鬂有華。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "著",
        "variant": "見",
        "source": "一作「見」"
      },
      {
        "line": 3,
        "text": "轂",
        "variant": "軛",
        "source": "一作「軛」"
      },
      {
        "line": 4,
        "text": "滿座",
        "variant": "對此",
        "source": "一作「對此」"
      }
    ]
  },
  {
    "uid": "QTS_654_003_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "長城",
    "poem": [
      "當時無德御乾坤，廣築徒勞萬古存。",
      "謾役生民防極塞，不知血刃起中原。",
      "珠璣旋見陪陵寢，社稷何曾保子孫。",
      "降虜至今猶自說，冤聲夜夜傍城根。"
    ],
    "variants": [
      {
        "line": 4,
        "text": "傍",
        "variant": "哭",
        "source": "一作「哭」"
      }
    ]
  },
  {
    "uid": "QTS_654_004_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "秋夕寄友人",
    "poem": [
      "秋夕蒼茫一雁過，西風白露滿宮莎。",
      "昨來京洛逢歸客，猶說軒車未渡河。",
      "莫把少年空倚賴，須知孤立易蹉跎。",
      "想君懷抱哀吟夜，銅雀臺前皓月多。"
    ]
  },
  {
    "uid": "QTS_654_005_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "冬夕江上言事五首 其一",
    "poem": [
      "葉落纔悲草又生，看看少壯是衰形。",
      "關中秋雨書難到，江上春寒酒易醒。",
      "多少繫心身未達，尋思舉目淚堪零。",
      "幾時拋得歸山去，松下看雲讀《道經》。"
    ],
    "part_index": 1,
    "total_parts": 5
  },
  {
    "uid": "QTS_654_005_02",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "冬夕江上言事五首 其二",
    "poem": [
      "喔喔晨雞滿樹霜，喧喧曉渡簇舟航。",
      "數星昨夜寒爐火，一陣誰家臘甕香。",
      "久別羇孤成潦倒，廻看書劍更蒼黃。",
      "逢人舉止皆言命，至竟謀閒可勝忙。"
    ],
    "part_index": 2,
    "total_parts": 5
  },
  {
    "uid": "QTS_654_005_03",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "冬夕江上言事五首 其三",
    "poem": [
      "野堂吟罷獨行行，點水微微凍不鳴。",
      "十里溪山新雪後，千家襟袖曉寒生。",
      "只宜醉夢依華寢，可稱羸蹄赴宿程。",
      "日苦幾多心下見，那堪歲晏又無成。"
    ],
    "part_index": 3,
    "total_parts": 5,
    "variants": [
      {
        "line": 4,
        "text": "心",
        "variant": "言",
        "source": "一作「言」"
      }
    ]
  },
  {
    "uid": "QTS_654_005_04",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "冬夕江上言事五首 其四",
    "poem": [
      "僻居多與懶相宜，吟擁寒爐過臘時。",
      "風柳欲生陽面葉，凍梅先綻嶺頭枝。",
      "山川自小拋耕釣，骨肉無因免別離。",
      "賴有陶情一尊酒，愁中相向展愁眉。"
    ],
    "part_index": 4,
    "total_parts": 5
  },
  {
    "uid": "QTS_654_005_05",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "冬夕江上言事五首 其五",
    "poem": [
      "一帶長溪淥浸門，數聲幽鳥啄雲根。",
      "松亭盡日唯空坐，難得儒翁共討論。"
    ],
    "part_index": 5,
    "total_parts": 5
  },
  {
    "uid": "QTS_654_006_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "春日宿崇賢里",
    "poem": [
      "柳暗榆飛春日深，水邊門巷獨來尋。",
      "舊山共是經年別，新句相逢竟夕吟。",
      "枕近禁街聞曉鼓，月當高竹見棲禽。",
      "勞歌莫問秋風計，恐起江河垂釣心。"
    ]
  },
  {
    "uid": "QTS_654_007_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "征人",
    "poem": [
      "青樓一別戍金微，力盡秋來破虜圍。",
      "錦字莫辭連夜織，塞鴻長是到春歸。",
      "正憐漢月當空照，不奈胡沙滿眼飛。",
      "唯有夢魂南去日，故鄉山水路依稀。"
    ]
  },
  {
    "uid": "QTS_654_008_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "鶯",
    "poem": [
      "暖辭雲谷背殘陽，飛下東風翅漸長。",
      "卻笑金籠是羈絆，豈知瑤草正芬芳。",
      "曉逢溪雨投紅樹，晚囀宮樓泣舊妝。",
      "何事離人不堪聽，灞橋斜日褭垂楊。"
    ]
  },
  {
    "uid": "QTS_654_009_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "槐花",
    "poem": [
      "行宮門外陌銅駝，兩畔分栽此最多。",
      "欲到清秋近時節，爭開金蘂向關河。",
      "層樓寄恨飄珠箔，駿馬憐香撼玉珂。",
      "愁殺江湖隨計者，年年為爾剩奔波。"
    ]
  },
  {
    "uid": "QTS_654_010_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "自蜀入關",
    "poem": [
      "文戰連輸未息機，束書攜劍定前非。",
      "近來從聽事難得，休去且無山可歸。",
      "匹馬出門還悵望，孤雲何處是因依。",
      "斜陽驛路西風緊，遙指人煙宿翠微。"
    ]
  },
  {
    "uid": "QTS_654_011_01",
    "volume": 654,
    "author": {
      "canonical": "羅鄴",
      "recorded": "羅鄴"
    },
    "title": "上陽宮",
    "poem": [
      "春半上陽花滿樓，太平天子昔巡遊。",
      "千門雖對嵩山在，一笑還隨洛水流。",
      "深鎖笙歌巢燕聽，遙瞻金碧路人愁。",
      "翠華卻自登仙去，腸斷宮娥望不休。"
    ],
    "variants": [
