        "text": "古",
        "variant": "石",
        "source": "一作「石」"
      }
    ]
  },
  {
    "uid": "QTS_643_007_02",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "上元懷古二首 其二",
    "poem": [
      "爭帝圖王德盡衰，驟興馳霸亦何為。",
      "君臣都是一場笑，家國共成千載悲。",
      "排岸遠檣森似槊，落波殘照赫如旗。",
      "今朝城上難回首，不見樓船索戰時。"
    ],
    "part_index": 2,
    "total_parts": 2,
    "variants": [
      {
        "line": 1,
        "text": "王",
        "variant": "皇",
        "source": "一作「皇」"
      },
