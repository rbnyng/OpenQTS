        "text": "興",
        "variant": "王",
        "source": "一作「王」"
      },
      {
        "line": 2,
        "text": "共",
        "variant": "同",
        "source": "一作「同」"
      }
    ]
  },
  {
    "uid": "QTS_643_008_01",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "隋堤柳",
    "poem": [
      "曾傍龍舟拂翠華，至今凝恨倚天涯。",
      "但經春色還秋色，不覺楊家是李家。",
      "背日古陰從北朽，逐波疏影向南斜。",
      "年年只有晴風便，遙為雷塘送雪花。"
    ]
  },
  {
    "uid": "QTS_643_009_01",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "蒲關西道中作",
    "poem": [
      "國東王氣凝蒲關，樓臺帖出晴空間。",
      "紫煙橫捧大舜廟，黃河直打中條山。",
      "地鎖咽喉千古壯，風傳歌吹萬家閒。",
      "來來去去身依舊，未及潘年鬢已斑。"
    ]
  },
  {
    "uid": "QTS_643_010_01",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "送李秀才入軍",
    "poem": [
      "弱柳貞松一地栽，不因霜霰自難媒。",
      "書生只是平時物，男子爭無亂世才。",
      "鐵馬已隨紅旆去，同人猶著白衣來。",
      "到頭功業須如此，莫為初心首重回。"
    ]
  },
  {
    "uid": "QTS_643_011_01",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "送蘄州裴員外",
    "poem": [
      "正作南宮第一人，蹔隨霓旆愴離羣。",
      "曉從闕下辭天子，春向江頭待使君。",
      "五馬尚迷青瑣路，雙魚猶惹翠蘭芬。",
      "明朝無路尋歸處，禁樹參差隔紫雲。"
    ]
  },
  {
    "uid": "QTS_643_012_01",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "代孔明哭先主",
    "poem": [
      "憶昔南陽顧草廬，便乘雷電捧乘輿。",
      "酌量諸夏須平取，期刻羣雄待遍鋤。",
      "南面未能成帝業，西陵那忍送宮車。",
      "九疑山下頻惆悵，曾許微臣水共魚。"
    ]
  },
  {
    "uid": "QTS_643_013_01",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "送職方王郎中吏部劉員外自太原鄭相公幕繼奉徵書歸省署",
    "poem": [
      "雙鳳銜書次第飛，玉皇催促列仙歸。",
      "雲開日月臨青瑣，風卷煙霞上紫微。",
      "蓮影一時空儉府，蘭香同處撲堯衣。",
      "此生長掃朱門者，每向人間夢粉闈。"
    ]
  },
  {
    "uid": "QTS_643_014_01",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "寒食二首 其一",
    "poem": [
      "柳帶東風一向斜，春陰澹澹蔽人家。",
      "有時三點兩點雨，到處十枝五枝花。",
      "萬井樓臺疑繡畫，九原珠翠似煙霞。",
      "年年今日誰相問，獨臥長安泣歲華。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_643_014_02",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "寒食二首 其二",
    "poem": [
      "風煙放蕩花披猖，鞦韆女兒飛短牆。",
      "繡袍馳馬拾遺翠，錦袖鬬雞喧廣場。",
      "天地氣和融霽色，池台日暖燒春光。",
      "自憐塵土無他事，空脫荷衣泥醉鄉。"
    ],
    "part_index": 2,
    "total_parts": 2,
    "variants": [
      {
        "line": 1,
        "text": "短",
        "variant": "出",
        "source": "一作「出」"
      }
    ]
  },
  {
    "uid": "QTS_643_015_01",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "又代孔明哭先主",
    "poem": [
      "鯨鬣翻騰四海波，始將天意用干戈。",
      "盡驅神鬼隨鞭策，全罩英雄入網羅。",
      "提劍尚殘吳郡國，垂衣猶欠魏山河。",
      "鼎湖無路追仙駕，空使群臣泣血多。"
    ]
  },
  {
    "uid": "QTS_643_016_01",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "貧女",
    "poem": [
      "平生不識繡衣裳，閒把荊釵亦自傷。",
      "鏡裏只應諳素貌，人間多自信紅妝。",
      "當年未嫁還憂老，終日求媒即道狂。",
      "兩意定知無說處，暗垂珠淚濕蠶筐。"
    ],
    "variants": [
      {
