  {
    "uid": "QTS_643_023_01",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "賀邢州盧員外",
    "poem": [
      "紫泥飛詔下金鑾，列象分明世仰觀。",
      "北省諫書藏舊草，南宮郎署握新蘭。",
      "春歸鳳沼恩波暖，曉入鴛行瑞氣寒。",
      "偏是此生棲息者，滿衣零淚一時幹。"
    ]
  },
  {
    "uid": "QTS_643_024_01",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "方干隱居",
    "poem": [
      "咬咬嘎嘎水禽聲，露洗松陰滿院清。",
      "溪畔印沙多鶴跡，檻前題竹有僧名。",
      "問人遠岫千重意，對客閑雲一片情。",
      "早晚塵埃得休去，且將書劔事先生。"
    ]
  },
  {
    "uid": "QTS_643_025_01",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "早春微雨",
    "poem": [
      "怪來鶯蝶似凝愁，不覺看花暫濕頭。",
      "疏影未藏千里樹，遠陰微翳萬家樓。",
      "青羅舞袖紛紛轉，紅臉啼珠旋旋收。",
      "歲旱且須教濟物，為霖何事愛風流。"
    ]
  },
  {
    "uid": "QTS_643_026_01",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "謁翰林劉學士不遇",
    "poem": [
      "夢繞清華宴地深，洞宮橫鎖曉沉沉。",
      "鵬飛碧海終難見，鶴入青霄豈易尋。",
      "六尺羈魂迷定止，兩行愁血謝知音。",
      "平生只聇淩風翼，隨得鳴珂上禁林。"
    ]
  },
  {
    "uid": "QTS_643_027_01",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "答劉書記見贈",
    "poem": [
      "吟近秋光思不窮，酷探騷雅愧無功。",
      "茫然心苦千篇拙，暝坐神凝萬象空。",
      "月上開襟當北戶，竹邊回首揖西風。",
      "知音頻有新詩贈，白雪紛紛落郢中。"
    ]
  },
  {
    "uid": "QTS_643_028_01",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "賀友人及第",
    "poem": [
      "得水蛟龍失水魚，此心相對兩何如。",
      "敢辭今日須行卷，猶喜他年待薦書。",
      "松桂也應情未改，萍蓬爭奈跡還疏。",
      "春風不見尋花伴，遙向青雲泥子虛。"
    ]
  },
  {
    "uid": "QTS_643_029_01",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "雨後過華嶽廟",
    "poem": [
      "華山黑影霄崔嵬，金天□□門未開。",
      "雨淋鬼火滅不滅，風送神香來不來。",
      "牆外素錢飄似雪，殿前陰柏吼如雷。",
      "知君暗宰人間事，休把蒼生夢裏裁。"
    ]
  },
  {
    "uid": "QTS_643_030_01",
    "volume": 643,
    "author": {
      "canonical": "李山甫",
      "recorded": "李山甫"
    },
    "title": "贈彈琴李處士",
    "poem": [
      "情知此事少知音，自是先生枉用心。",
      "世上幾時曾好古，人前何必更沾襟。",
      "致身不似笙竽巧，悅耳寧如鄭衛淫。",
      "三尺焦桐七條線，子期師曠兩沈沈。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "竽",
