[
  {
    "uid": "QTS_714_001_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "梅花",
    "poem": [
      "數萼初含雪，孤標畫本難。",
      "香中別有韻，清極不知寒。",
      "橫笛和愁聽，斜枝倚病看。",
      "朔風如解意，容易莫摧殘。"
    ],
    "preface": "崔道融，荊州人，以徴辟為永嘉令，累官右補闕。避地入閩。《申唐詩》三卷，《東浮集》九卷，今編詩一卷。"
  },
  {
    "uid": "QTS_714_002_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "銅雀妓二首 其一",
    "poem": [
      "嚴妝垂玉箸，妙舞對清風。",
      "無復君王顧，春來起漸慵。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_714_002_02",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "銅雀妓二首 其二",
    "poem": [
      "歌咽新翻曲，香銷舊賜衣。",
      "陵園春雨暗，不見六龍歸。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_714_003_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "春閨二首 其一",
    "poem": [
      "寒食月明雨，落花香滿泥。",
      "佳人持錦字，無雁寄遼西。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_714_003_02",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "春閨二首 其二",
    "poem": [
      "欲剪宜春字，春寒入剪刀。",
      "遼陽在何處？莫望寄征袍。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_714_004_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "訪僧不遇",
    "poem": [
      "尋僧已寂寞，林下鎖山房。",
      "松竹雖無語，牽衣借晚涼。"
    ]
  },
  {
    "uid": "QTS_714_005_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "田上",
    "poem": [
      "雨足高田白，披蓑半夜耕。",
      "人牛力俱盡，東方殊未明。"
    ]
  },
  {
    "uid": "QTS_714_006_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "月夕",
    "poem": [
      "月上隨人意，人閒月更清。",
      "朱樓高百尺，不見到天明。"
    ]
  },
  {
    "uid": "QTS_714_007_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "槿花",
    "poem": [
      "槿花不見夕，一日一回新。",
      "東風吹桃李，須到明年春。"
    ]
  },
  {
    "uid": "QTS_714_008_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "西施灘",
    "poem": [
      "宰嚭亡吳國，西施陷惡名。",
      "浣紗春水急，似有不平聲。"
    ]
  },
  {
    "uid": "QTS_714_009_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "江上逢故人",
    "poem": [
      "故里琴樽侶，相逢近臘梅。",
      "江村買一醉，破淚卻成咍。"
    ]
  },
  {
    "uid": "QTS_714_010_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "牧豎",
    "poem": [
      "牧豎持蓑笠，逢人氣傲然。",
      "臥牛吹短笛，耕卻傍溪田。"
    ]
  },
  {
    "uid": "QTS_714_011_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "過農家",
    "poem": [
      "欲羨農家子，秋新看刈禾。",
      "蘇秦無負郭，六印又如何。"
    ]
  },
  {
    "uid": "QTS_714_012_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "江夕",
    "poem": [
      "江心秋月白，起柁信潮行。",
      "蛟龍化為人，半夜吹笛聲。"
    ]
  },
  {
    "uid": "QTS_714_013_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "春墅",
    "poem": [
      "蛙聲近過社，農事忽已忙。",
      "鄰婦餉田歸，不見百花芳。"
    ]
  },
  {
    "uid": "QTS_714_014_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "江村",
    "poem": [
      "日暮片帆落，江村如有情。",
      "獨對沙上月，滿船人睡聲。"
    ]
  },
  {
    "uid": "QTS_714_015_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "擬樂府子夜四時歌四首 其一",
    "poem": [
      "吳子愛桃李，月色不到地。",
      "明朝欲看花，六宮人不睡。"
    ],
    "part_index": 1,
    "total_parts": 4
  },
  {
    "uid": "QTS_714_015_02",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "擬樂府子夜四時歌四首 其二",
    "poem": [
      "涼軒待月生，暗裏螢飛出。",
      "低迴不稱意，蛙鳴亂清瑟。"
    ],
    "part_index": 2,
    "total_parts": 4
  },
  {
    "uid": "QTS_714_015_03",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "擬樂府子夜四時歌四首 其三",
    "poem": [
      "月色明如晝，蟲聲入戶多。",
      "狂夫自不歸，滿地無天河。"
    ],
    "part_index": 3,
    "total_parts": 4
  },
  {
    "uid": "QTS_714_015_04",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "擬樂府子夜四時歌四首 其四",
    "poem": [
      "銀缸照殘夢，零淚沾粉臆。",
      "洞房猶自寒，何況關山北。"
    ],
    "part_index": 4,
    "total_parts": 4
  },
  {
    "uid": "QTS_714_016_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "寄人二首 其一",
    "poem": [
      "花上斷續雨，江頭來去風。",
      "相思春欲盡，未遣酒尊空。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_714_016_02",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "寄人二首 其二",
    "poem": [
      "澹澹長江水，悠悠遠客情。",
      "落花相與恨，到地一無聲。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_714_017_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "江鷗",
    "poem": [
      "白鳥波上棲，見人懶飛起。",
      "為有求魚心，不是戀江水。"
    ]
  },
  {
    "uid": "QTS_714_018_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "春晚",
    "poem": [
      "三月寒食時，日色濃於酒。",
      "落盡墻頭花，鶯聲隔原柳。"
    ]
  },
  {
    "uid": "QTS_714_019_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "漢宮詞",
    "poem": [
      "獨詔胡衣出，天花落殿堂。",
      "他人不敢妬，垂淚向君王。"
    ]
  },
  {
    "uid": "QTS_714_020_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "旅行",
    "poem": [
      "少壯經勤苦，衰年始浪遊。",
      "誰憐不龜手，他處卻封侯。"
    ]
  },
  {
    "uid": "QTS_714_021_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "班婕妤",
    "poem": [
      "寵極辭同輦，恩深棄後宮。",
      "自題秋扇後，不敢怨春風。"
    ]
  },
  {
    "uid": "QTS_714_022_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "元日有題",
    "poem": [
      "十載元正酒，相歡意轉深。",
      "自量麋鹿分，只合在山林。"
    ]
  },
  {
    "uid": "QTS_714_023_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "古樹",
    "poem": [
      "古樹春風入，陽和力太遲。",
      "莫言生意盡，更引萬年枝。"
    ]
  },
  {
    "uid": "QTS_714_024_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "春題二首 其一",
    "poem": [
      "青春未得意，見花卻如讐。",
      "路逢白面郎，醉插花滿頭。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_714_024_02",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "春題二首 其二",
    "poem": [
      "滿眼桃李花，愁人如不見。",
      "別有惜花人，東風莫吹散。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_714_025_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "長安春",
    "poem": [
      "長安牡丹開，繡轂輾晴雷。",
      "若使花長在，人應看不回。"
    ]
  },
  {
    "uid": "QTS_714_026_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "病起二首 其一",
    "poem": [
      "病起春已晚，曳笻傷緑苔。",
      "強攀庭樹枝，喚作花未開。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_714_026_02",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "病起二首 其二",
    "poem": [
      "病起遶庭除，春泥粘屐齒。",
      "如從萬里來，骨肉滿面喜。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_714_027_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "峽路",
    "poem": [
      "清猨啼不住，白水下來新。",
      "八月莫為客，夜長愁殺人。"
    ]
  },
  {
    "uid": "QTS_714_028_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "長門怨",
    "poem": [
      "長門春欲盡，明月照花枝。",
      "買得相如賦，君恩不可移。"
    ]
  },
  {
    "uid": "QTS_714_029_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "月夕有懷",
    "poem": [
      "圓光照一海，遠客在孤舟。",
      "相憶無期見，中宵獨上樓。"
    ]
  },
  {
    "uid": "QTS_714_030_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "夜泊九江",
    "poem": [
      "夜泊江門外，歡聲月裏樓。",
      "明朝歸去路，猶隔洞庭秋。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "裏",
        "variant": "下",
        "source": "一作「下」"
      }
    ]
  },
  {
    "uid": "QTS_714_031_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "寒食夜",
    "poem": [
      "滿地梨花白，風吹碎月明。",
      "大家寒食夜，獨貯望鄉情。"
    ]
  },
  {
    "uid": "QTS_714_032_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "歸燕",
    "poem": [
      "海燕頻來去，西人獨滯留。",
      "天邊又相送，腸斷故園秋。"
    ]
  },
  {
    "uid": "QTS_714_033_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "長安春",
    "poem": [
      "珠箔映高柳，美人紅袖垂。",
      "忽聞半天語，不見上樓時。"
    ]
  },
  {
    "uid": "QTS_714_034_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "鑾駕東回",
    "poem": [
      "兩川花捧御衣香，萬歲山呼輦路長。",
      "天子還從馬嵬過，別無惱恨似明皇。"
    ]
  },
  {
    "uid": "QTS_714_035_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "釣魚",
    "poem": [
      "閒釣江魚不釣名，瓦甌斟酒暮山青。",
      "醉頭倒向蘆花裏，卻笑無端犯客星。"
    ]
  },
  {
    "uid": "QTS_714_036_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "西施",
    "poem": [
      "薴蘿山下如花女，占得姑蘇臺上春。",
      "一笑不能忘敵國，五湖何處有功臣？"
    ]
  },
  {
    "uid": "QTS_714_037_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "馬嵬",
    "poem": [
      "萬乘淒涼蜀路歸，眼前朱翠與心違。",
      "重華不是風流主，湘水猶傳泣二妃。"
    ]
  },
  {
    "uid": "QTS_714_038_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "羯鼓",
    "poem": [
      "華清宮裏打撩聲，供奉絲簧束手聽。",
      "寂寞鑾輿斜谷裏，是誰翻得雨淋鈴。"
    ]
  },
  {
    "uid": "QTS_714_039_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "寄李左司",
    "poem": [
      "柏臺蘭省共清風，鳴玉朝聯夜被同。",
      "肯信人間有兄弟，一生長在別離中。"
    ],
    "notes": [
      {
        "content": "一本下有「五季在臺」四字。",
        "context": "寄李左司",
        "original_title": "寄李左司",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_714_040_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "梅",
    "poem": [
      "溪上寒梅初滿枝，夜來霜月透芳菲。",
      "清光寂寞思無盡，應待琴尊與解圍。"
    ]
  },
  {
    "uid": "QTS_714_041_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "天台陳逸人",
    "poem": [
      "絕粒空山秋復春，欲看滄海化成塵。",
      "近拋三井更深去，不怕虎狼唯怕人。"
    ]
  },
  {
    "uid": "QTS_714_042_01",
    "volume": 714,
    "author": {
      "canonical": "崔道融",
      "recorded": "崔道融"
    },
    "title": "雪竇禪師",
    "poem": [
      "雪竇峰前一派懸，雪竇五月無炎天。",
      "客塵半日洗欲盡，師到白頭林下禪。"
    ]
  },
  {
    "uid": "QTS_714_043_01",
    "volume": 714,
    "author": {
