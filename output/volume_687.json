      "wikidata_id": "Q9621970"
    },
    "title": "秋日經別墅",
    "poem": [
      "別墅蕭條海上村，偶期蘭菊與琴尊。",
      "簷橫碧嶂秋光近，樹帶閒潮晚色昬。",
      "幸有白雲眠楚客，不勞芳草思王孫。",
      "北山移去前文在，無復教人歎曉猨。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "閒",
        "variant": "寒",
        "source": "一作「寒」"
      }
    ]
  },
  {
