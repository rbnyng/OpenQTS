    },
    "title": "贈雲陽裴明府",
    "poem": [
      "南北三年一觧攜，海為深谷岸為蹊。",
      "已聞陳勝心降漢，誰為田橫國號齊。",
      "暴客至今猶戰鶴，故人何處尚驅雞？",
      "歸來能作煙波伴，我有魚舟在五溪。"
    ],
    "variants": [
      {
        "line": 4,
        "text": "魚",
        "variant": "漁",
        "source": "一作「漁」"
      }
    ]
  },
