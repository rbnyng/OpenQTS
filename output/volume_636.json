[
  {
    "uid": "QTS_636_001_01",
    "volume": 636,
    "author": {
      "canonical": "聶夷中",
      "recorded": "聶夷中"
    },
    "title": "雜興",
    "poem": [
      "兩葉能蔽目，雙豆能塞聰。",
      "理身不知道，將為天地聾。",
      "擾擾造化內，茫茫天地中。",
      "苟或有所願，毛髮亦不容。"
    ],
    "preface": "聶夷中字坦之，河東人。咸通十二年登第，官華隂尉。詩一卷。"
  },
  {
    "uid": "QTS_636_002_01",
    "volume": 636,
    "author": {
      "canonical": "聶夷中",
      "recorded": "聶夷中"
    },
    "title": "雜怨",
    "poem": [
      "生在綺羅下，豈識漁陽道。",
      "良人自戍來，夜夜夢中到。",
      "漁陽萬里遠，近於中門限。",
      "中門逾有時，漁陽常在眼。"
    ]
  },
  {
    "uid": "QTS_636_003_01",
    "volume": 636,
    "author": {
      "canonical": "聶夷中",
      "recorded": "聶夷中"
    },
    "title": "雜怨",
    "poem": [
      "君淚濡羅巾，妾淚滴路塵。",
      "羅巾今在手，日得隨妾身。",
      "路塵如因風，得上君車輪。"
    ]
  },
  {
    "uid": "QTS_636_004_01",
    "volume": 636,
    "author": {
      "canonical": "聶夷中",
      "recorded": "聶夷中"
    },
    "title": "行路難",
    "poem": [
      "莫言行路難，夷狄如中國。",
      "謂言骨肉親，中門如異域。",
      "出處全在人，路亦無通塞。",
      "門前兩條轍，何處去不得。"
    ]
  },
  {
    "uid": "QTS_636_005_01",
    "volume": 636,
    "author": {
      "canonical": "聶夷中",
      "recorded": "聶夷中"
    },
    "title": "大垂手",
    "poem": [
      "金刀翦輕雲，盤用黃金縷。",
      "裝束趙飛燕，教來掌上舞。",
      "舞罷飛燕死，片片隨風去。"
    ]
  },
  {
    "uid": "QTS_636_006_01",
    "volume": 636,
    "author": {
      "canonical": "聶夷中",
      "recorded": "聶夷中"
    },
    "title": "空城雀",
    "poem": [
      "一雀入官倉，所食能損幾。",
      "所慮往復頻，官倉乃害爾。",
      "魚網不在天，鳥網不在水。",
      "飲啄要自然，何必空城裏。"
    ]
  },
  {
    "uid": "QTS_636_007_01",
    "volume": 636,
    "author": {
      "canonical": "聶夷中",
      "recorded": "聶夷中"
    },
    "title": "胡無人行",
    "poem": [
      "男兒徇大義，立節不沽名。",
      "腰間懸陸離，大歌胡無行。",
      "不讀戰國書，不覽黃石經。",
      "醉臥咸陽樓，夢入受降城。",
      "更願生羽翼，飛身入青冥。",
      "請攜天子劔，斫下旄頭星。",
      "自然胡無人，雖有無戰爭。",
      "悠哉典屬國，驅羊老一生。"
    ]
  },
  {
    "uid": "QTS_636_008_01",
    "volume": 636,
    "author": {
      "canonical": "聶夷中",
      "recorded": "聶夷中"
    },
    "title": "詠田家",
    "poem": [
      "二月賣新絲，五月糶新穀。",
      "醫得眼前瘡，剜卻心頭肉。",
      "我願君王心，化作光明燭。",
      "不照綺羅筵，只照逃亡屋。"
    ]
  },
  {
    "uid": "QTS_636_009_01",
    "volume": 636,
    "author": {
      "canonical": "聶夷中",
      "recorded": "聶夷中"
    },
    "title": "燕臺二首 其一",
    "poem": [
      "燕臺累黃金，上欲招儒雅。",
      "貴得賢士來，更下於隗者。",
      "自然樂毅徒，趨風走天下。",
      "何必馳鳳書，旁求向林野。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_636_009_02",
    "volume": 636,
    "author": {
      "canonical": "聶夷中",
      "recorded": "聶夷中"
    },
    "title": "燕臺二首 其二",
    "poem": [
      "燕臺高百尺，燕滅臺亦平。",
      "一種是亡國，猶得禮賢名。",
      "何似章華畔，空餘禾黍生。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
