[
  {
    "uid": "QTS_203_001_01",
    "volume": 203,
    "author": {
      "canonical": "杜儼",
      "recorded": "杜儼"
    },
    "title": "客中作",
    "poem": [
      "書劒催人不暫閑，洛陽羈旅復秦關。",
      "容顏歲歲愁邊改，鄉國時時夢裏還。"
    ]
  },
  {
    "uid": "QTS_203_002_01",
    "volume": 203,
    "author": {
      "canonical": "趙良器",
      "recorded": "趙良器",
      "gender": "male",
      "period": "High Tang",
      "english_name": "Zhao Liangqi",
      "wikidata_id": "Q18908636"
    },
    "title": "三月三日曲江侍宴",
    "poem": [
      "聖祖發神謀，靈符葉帝求。",
      "一人光錫命，萬國荷時休。",
      "雷解圜丘畢，雲需曲水遊。",
      "岸花迎步輦，仙仗擁行舟。",
      "睿藻天中降，恩波海外流。",
      "小臣同品物，陪此樂皇猷。"
    ]
  },
  {
    "uid": "QTS_203_003_01",
    "volume": 203,
    "author": {
      "canonical": "趙良器",
      "recorded": "趙良器",
      "gender": "male",
      "period": "High Tang",
      "english_name": "Zhao Liangqi",
      "wikidata_id": "Q18908636"
    },
    "title": "鄭國夫人輓歌詞",
    "poem": [
      "淑德延公胄，宜家接帝姻。",
      "桂宮男掌僕，蘭殿女昇嬪。",
      "恩澤昭前命，盈虛變此辰。",
      "萬年今已矣，彤管列何人。"
    ]
  },
  {
    "uid": "QTS_203_004_01",
    "volume": 203,
    "author": {
      "canonical": "黃麟",
      "recorded": "黃麟"
    },
    "title": "郡中客舍",
    "poem": [
      "蟲響亂啾啾，更人正數籌。",
      "魂歸洞庭夜，霜臥洛陽秋。",
      "微月有時隱，長河到曉流。",
      "起來還囑雁，鄉信在吳洲。"
    ]
  },
  {
    "uid": "QTS_203_005_01",
    "volume": 203,
    "author": {
      "canonical": "郭向",
      "recorded": "郭向",
      "gender": "male",
      "english_name": "Guo Xiang",
      "wikidata_id": "Q18905812"
    },
    "title": "途中口號",
    "poem": [
      "抱玉三朝楚，懷書十上秦。",
      "年年洛陽陌，花鳥弄歸人。"
    ]
  },
  {
    "uid": "QTS_203_006_01",
    "volume": 203,
    "author": {
      "canonical": "郭良",
      "recorded": "郭良"
    },
    "title": "題李將軍山亭",
    "poem": [
      "鳳轄將軍位，龍門司隸家。",
      "衣冠爲隱逸，山水作繁華。",
      "徑出重林草，池搖兩岸花。",
      "誰知貴公第，亭院有煙霞。"
    ],
