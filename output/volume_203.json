  {
    "uid": "QTS_203_032_01",
    "volume": 203,
    "author": {
      "canonical": "張良璞",
      "recorded": "張良璞"
    },
    "title": "覽史",
    "poem": [
      "享年八十已，歷數窮蒼生。",
      "七虎門源上，咆哮關內鳴。",
      "建都用鶉宿，設險因金城。",
      "舜曲煙火起，汾河珠翠明。",
      "海雲引天仗，朔雪留邊兵。",
      "作孽人怨久，其亡鬼信盈。",
      "素靈感劉季，白馬從子嬰。",
      "昏虐不務德，百代無芳聲。"
    ]
  },
