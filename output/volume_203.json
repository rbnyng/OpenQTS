      }
    ]
  },
  {
    "uid": "QTS_203_007_01",
    "volume": 203,
    "author": {
      "canonical": "郭良",
      "recorded": "郭良"
    },
    "title": "早行",
    "poem": [
      "早行星尚在，數里未天明。",
      "不辨雲林色，空聞風水聲。",
      "月從山上落，河入斗間橫。",
      "漸至重門外，依稀見洛城。"
    ]
  },
  {
    "uid": "QTS_203_008_01",
    "volume": 203,
    "author": {
      "canonical": "王喬",
      "recorded": "王喬"
    },
    "title": "過故人舊宅",
    "poem": [
      "故人軒騎罷歸來，舊宅園林閑不開。",
      "唯餘挾瑟樓中婦，哭向平生歌舞臺。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "宅",
        "variant": "國",
        "source": "一作「國」"
      }
    ]
