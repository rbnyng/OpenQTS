      }
    ]
  },
  {
    "uid": "QTS_465_013_01",
    "volume": 465,
    "author": {
      "canonical": "楊衡",
      "recorded": "楊衡"
    },
    "title": "寄贈田倉曺灣",
    "poem": [
      "芳蘭媚庭除，灼灼紅英舒。",
      "身為陋巷客，門有絳轅車。",
      "朝覽夷胡傳，暮習潁陽書。",
      "盻雲高羽翼，待賈藴璠璵。",
      "纓弁雖雲阻，音塵豈復疎。",
      "若因風雨晦，應念寂寥居。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "胡",
        "variant": "吳",
        "source": "一作「吳」"
      }
    ]
  },
  {
    "uid": "QTS_465_014_01",
    "volume": 465,
    "author": {
      "canonical": "楊衡",
      "recorded": "楊衡"
    },
    "title": "詠春色",
    "poem": [
      "靄靄復濛濛，非霧滿晴空。",
      "密添宮柳翠，暗泄路桃紅。",
      "縈絲光乍失，緣隟影纔通。",
      "夕迷鴛枕上，朝漫綺弦中。",
      "促駟馳香陌，勞鶯轉豔叢。",
      "可憐腸斷望，倂在洛城東。"
    ],
    "variants": [
