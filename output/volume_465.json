[
  {
    "uid": "QTS_465_001_01",
    "volume": 465,
    "author": {
      "canonical": "楊衡",
      "recorded": "楊衡"
    },
    "title": "盧十五竹亭送姪偁歸山",
    "poem": [
      "落葉寒擁壁，清霜夜霑石。",
      "正是憶山時，復送歸山客。",
      "殷勤一尊酒，曉月當窗白。"
    ]
  },
  {
    "uid": "QTS_465_002_01",
    "volume": 465,
    "author": {
      "canonical": "楊衡",
      "recorded": "楊衡"
    },
    "title": "旅次江亭",
    "poem": [
      "扣舷不能寐，皓露清衣襟。",
      "彌傷孤舟夜，遠結萬里心。",
      "幽興惜瑤草，素懷寄鳴琴。",
      "三奏月初上，寂寥寒江深。"
    ]
  },
  {
    "uid": "QTS_465_003_01",
    "volume": 465,
    "author": {
      "canonical": "楊衡",
      "recorded": "楊衡"
    },
    "title": "賦得夜雨滴空堦送魏秀才",
    "poem": [
      "委簷方滴滴，霑紅復灑綠。",
      "醉聽作朦朧，愁聞多斷續。",
      "始兼泉響細稍雜更聲促",
      "百慮自縈心，況有人如玉。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "泉",
        "variant": "松",
        "source": "一作「松」"
      }
    ]
  },
  {
    "uid": "QTS_465_004_01",
    "volume": 465,
    "author": {
      "canonical": "楊衡",
      "recorded": "楊衡"
    },
    "title": "征人",
    "poem": [
      "西風屢鳴雁，東郊未升日。",
      "繁煙羃羃昬，暗騎蕭蕭出。",
      "望雲愁玉塞，眠月想蕙質。",
      "借問露霑衣，何如香滿室。"
    ],
    "notes": [
      {
        "content": "一作思歸",
        "context": "征人",
        "original_title": "征人〈一作思歸〉"
      }
    ]
  },
  {
    "uid": "QTS_465_005_01",
    "volume": 465,
    "author": {
      "canonical": "楊衡",
      "recorded": "楊衡"
    },
    "title": "遊陸先生故巖居",
    "poem": [
      "獨壑臨萬嶂，蒼苔絶行跡。",
      "仰窺猨掛樹，俯對鶴巢石。",
      "上有一巖屋，相傳靈人宅。",
      "深林無陽暉，幽水轉鮮碧。",
      "拾薪遇遺鼎，探穴得古籍。",
      "結念候雲興，燒香坐終夕。"
    ],
    "variants": [
