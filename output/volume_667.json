[
  {
    "uid": "QTS_667_001_01",
    "volume": 667,
    "author": {
      "canonical": "鄭損",
      "recorded": "鄭損"
    },
    "title": "星精亭",
    "poem": [
      "星沈萬古痕，孤絕勢無鄰。",
      "地窄少留竹，空多剩占雲。",
      "釣篷和雨看，樵斧帶霜聞。",
      "莫惜尋常到，清風不負人。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "鄰",
        "variant": "群",
        "source": "一作「群」"
      }
    ]
  },
  {
    "uid": "QTS_667_002_01",
    "volume": 667,
    "author": {
      "canonical": "鄭損",
      "recorded": "鄭損"
    },
    "title": "釣閣",
    "poem": [
      "小閣愜幽尋，周遭萬竹森。",
      "誰知一沼內，亦有五湖心。",
      "釣直魚應笑，身閒樂自深。",
      "晚來春醉熟，香餌任浮沈。"
    ]
  },
  {
    "uid": "QTS_667_003_01",
    "volume": 667,
    "author": {
      "canonical": "鄭損",
      "recorded": "鄭損"
    },
    "title": "玉聲亭",
    "poem": [
      "世間泉石本無價，那更天然落景中。",
      "漢佩琮琤寒溜雨，秦簫縹緲夜敲風。",
      "一方清氣群陰伏，半局閒棋萬慮空。",
      "借問主人能住久，後來好事有誰同。"
    ]
  },
  {
    "uid": "QTS_667_004_01",
    "volume": 667,
    "author": {
      "canonical": "鄭損",
      "recorded": "鄭損"
    },
    "title": "藝堂",
    "poem": [
      "堂開凍石千年翠，藝講秋膠百步威。",
      "揖讓未能忘典禮，英雄孰不慣戎衣。",
      "風波險似金機駭，日月忙如雪羽飛。",
      "莫怪尊前頻浩歎，男兒志願與時違。"
    ]
  },
  {
    "uid": "QTS_667_005_01",
    "volume": 667,
    "author": {
      "canonical": "鄭損",
      "recorded": "鄭損"
    },
    "title": "星精石",
    "poem": [
      "突險呀空龍虎蹲，由來英氣蓄寒根。",
      "蒼苔點染雲生靨，老雨淋漓鐵漬痕。",
      "松韻遠趨疑認祖，山陰輕覆似憐孫。",
      "孤巖恰恰容幽構，可愛江南釋子園。"
    ]
  },
  {
    "uid": "QTS_667_006_01",
    "volume": 667,
    "author": {
      "canonical": "鄭損",
      "recorded": "鄭損"
    },
    "title": "泛香亭",
    "poem": [
      "流杯處處稱佳致，何似斯亭出自然。",
      "山溜穿雲來幾里，石盤和蘚鑿何年。",
      "聲交鳴玉歌沈板，色幌寒金酒滿船。",
      "莫怪坐中難得醉，醒人心骨有潺湲。"
    ]
  },
  {
    "uid": "QTS_667_007_01",
    "volume": 667,
    "author": {
      "canonical": "張禕",
      "recorded": "張禕"
    },
    "title": "巴州寒食晚眺",
    "poem": [
      "東望青天周與秦，杏花榆葉故園春。",
      "野寺一傾寒食酒，晚來風景重愁人。"
    ]
  },
  {
    "uid": "QTS_667_008_01",
    "volume": 667,
    "author": {
      "canonical": "張禕",
      "recorded": "張禕"
    },
    "title": "題擊甌樓",
    "poem": [
      "駐旌元帥遺風在，擊缶高人逸興酣。",
      "水轉巴文清溜急，山連蒙岫翠光涵。"
    ]
  },
  {
    "uid": "QTS_667_009_01",
    "volume": 667,
    "author": {
      "canonical": "盧攜",
      "recorded": "盧攜",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Lu Xi",
      "wikidata_id": "Q10910064"
    },
    "title": "題司空圖壁",
    "poem": [
      "姓氏司空貴，官班御史卑。",
      "老夫如且在，不用歎屯奇。"
    ]
  },
  {
    "uid": "QTS_667_010_01",
    "volume": 667,
    "author": {
      "canonical": "李廷璧",
      "recorded": "李廷璧"
    },
    "title": "愁詩",
    "poem": [
      "到來難遣去難留，著骨黏心萬事休。",
      "潘岳愁絲生鬢裏，婕妤悲色上眉頭。",
      "長途詩盡空騎馬，遠雁聲初獨倚樓。",
      "更有相思不相見，酒醒燈背月如鉤。"
    ]
  },
  {
    "uid": "QTS_667_011_01",
    "volume": 667,
    "author": {
      "canonical": "許三畏",
      "recorded": "許三畏"
    },
    "title": "題菖蒲廢觀",
    "poem": [
      "本是安期燒藥處，今來改作坐禪宮。",
      "數僧梵響滿樓月，深谷猿聲半夜風。",
      "金簡事移松閣迥，綵雲影散閬山空。",
      "我來不見修真客，卻得真如問遠公。"
    ]
  },
  {
    "uid": "QTS_667_012_01",
    "volume": 667,
    "author": {
      "canonical": "盧嗣業",
      "recorded": "盧嗣業",
      "gender": "male",
      "english_name": "Lu Siye",
      "wikidata_id": "Q26186503"
    },
    "title": "致孫狀元訴醵罰錢",
    "poem": [
      "未識都知面，頻輸復分錢。",
      "苦心事筆硯，得志助花鈿。",
      "徒步求秋賦，持杯給暮饘。",
      "力微多謝病，非不奉同年。"
    ]
  },
  {
    "uid": "QTS_667_013_01",
    "volume": 667,
    "author": {
      "canonical": "牛嶠",
      "recorded": "牛嶠"
    },
    "title": "紅薔薇",
    "poem": [
      "曉啼珠露渾無力，繡簇羅襦不著行。",
      "若綴壽陽公主額，六宮爭肯學梅妝。"
    ]
  },
  {
    "uid": "QTS_667_014_01",
    "volume": 667,
    "author": {
      "canonical": "牛嶠",
      "recorded": "牛嶠"
    },
    "title": "楊柳枝五首 其一",
    "poem": [
      "解凍風來末上青，解垂羅袖拜卿卿。",
      "無端褭娜臨官路，舞送行人過一生。"
    ],
    "part_index": 1,
    "total_parts": 5
  },
  {
    "uid": "QTS_667_014_02",
    "volume": 667,
    "author": {
      "canonical": "牛嶠",
      "recorded": "牛嶠"
    },
    "title": "楊柳枝五首 其二",
    "poem": [
      "吳王宮裡色偏深，一簇纖條萬縷金。",
      "不憤錢塘蘇小小，引郎松下結同心。"
    ],
    "part_index": 2,
    "total_parts": 5,
    "variants": [
      {
        "line": 2,
        "text": "松",
        "variant": "枝",
        "source": "一作「枝」"
      }
    ]
  },
  {
    "uid": "QTS_667_014_03",
    "volume": 667,
    "author": {
      "canonical": "牛嶠",
      "recorded": "牛嶠"
    },
    "title": "楊柳枝五首 其三",
    "poem": [
      "橋北橋南千萬條，恨伊張緒不相饒。",
      "金羈白馬臨風望，認得羊家靜婉腰。"
    ],
    "part_index": 3,
    "total_parts": 5
  },
  {
    "uid": "QTS_667_014_04",
    "volume": 667,
    "author": {
      "canonical": "牛嶠",
      "recorded": "牛嶠"
    },
    "title": "楊柳枝五首 其四",
    "poem": [
      "狂雪隨風撲馬飛，惹煙無力被春欺。",
      "莫交移入靈和殿，宮女三千又妬伊。"
    ],
    "part_index": 4,
    "total_parts": 5
  },
  {
    "uid": "QTS_667_014_05",
    "volume": 667,
    "author": {
      "canonical": "牛嶠",
      "recorded": "牛嶠"
    },
    "title": "楊柳枝五首 其五",
    "poem": [
      "褭翠籠煙拂暖波，舞裙新染麴塵羅。",
      "章華臺畔隋堤上，傍得春風爾許多。"
    ],
    "part_index": 5,
    "total_parts": 5
  },
  {
    "uid": "QTS_667_015_01",
    "volume": 667,
    "author": {
      "canonical": "鄭合",
      "recorded": "鄭合"
    },
    "title": "及第後宿平康里詩",
    "poem": [
      "春來無處不閒行，楚潤相看別有情。",
      "好是五更殘酒醒，時時聞喚狀頭聲。"
    ]
  },
  {
    "uid": "QTS_667_016_01",
    "volume": 667,
    "author": {
      "canonical": "李搏",
      "recorded": "李搏"
    },
    "title": "賀裴廷裕蜀中登第詩",
    "poem": [
      "銅梁千里曙雲開，仙籙新從紫府來。",
      "天上已張新羽翼，世間無復舊塵埃。",
      "嘉禎果中君平卜，賀喜須斟卓氏杯。",
      "應笑戎藩刀筆吏，至今泥滓曝魚鰓。"
    ]
  },
  {
    "uid": "QTS_667_017_01",
    "volume": 667,
    "author": {
      "canonical": "李搏",
      "recorded": "李搏"
    },
    "title": "複謔廷裕",
    "poem": [
      "曾隨風水化凡鱗，安上門前一字新。",
      "聞道蜀江風景好，不知何似杏園春。"
    ]
  },
  {
    "uid": "QTS_667_018_01",
    "volume": 667,
    "author": {
      "canonical": "李克恭",
      "recorded": "李克恭",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Kegong",
      "wikidata_id": "Q11095512"
    },
    "title": "弔賈島",
    "poem": [
      "一一玄微縹緲成，盡吟方便爽神情。",
      "宣宗謫去為閒事，韓愈知來已振名。",
      "海底也應搜得淨，月輪常被玩教傾。",
      "如何未隔四十載，不遇論量向此生。"
    ]
  },
  {
    "uid": "QTS_667_019_01",
    "volume": 667,
    "author": {
      "canonical": "程賀",
      "recorded": "程賀"
    },
    "title": "君山",
    "poem": [
      "曾遊方外見麻姑，說道君山此本無。",
      "雲是昆侖山頂石，海風吹落洞庭湖。"
    ]
  },
  {
    "uid": "QTS_667_020_01",
    "volume": 667,
    "author": {
      "canonical": "盧尚卿",
      "recorded": "盧尚卿",
      "gender": "male"
    },
    "title": "東歸詩",
    "poem": [
      "九重丹詔下塵埃，深鎖文闈罷選才。",
      "桂樹放教遮月長，杏園終待隔年開。",
      "自從玉帳論兵後，不許金門諫獵來。",
      "今日灞陵橋上過，路人應笑臘前迴。"
    ]
  },
  {
    "uid": "QTS_667_021_01",
    "volume": 667,
    "author": {
      "canonical": "顧在鎔",
      "recorded": "顧在鎔"
    },
    "title": "題玉芝雙奉院",
    "poem": [
      "入門如洞府，花木與時稀。",
      "夜坐山當戶，秋吟葉滿衣。",
      "犬隨童子出，鳥避俗人飛。",
      "至藥應將熟，年年火氣微。"
    ]
  },
  {
    "uid": "QTS_667_022_01",
    "volume": 667,
    "author": {
      "canonical": "顧在鎔",
      "recorded": "顧在鎔"
    },
    "title": "宿麻平驛",
    "poem": [
      "及到怡情處，暫忘登陟勞。",
      "青山看不厭，明月坐來高。",
      "犬為孤村吠，猿因冷木號。",
      "微吟還獨酌，多興憶同袍。"
    ]
  },
  {
    "uid": "QTS_667_023_01",
    "volume": 667,
    "author": {
      "canonical": "顧在鎔",
      "recorded": "顧在鎔"
    },
    "title": "題光福上方塔",
    "poem": [
      "蒼島孤生白浪中，倚天高塔勢翻空。",
      "煙凝遠岫列寒翠，霜染疏林墮碎紅。",
      "汀沼或棲彭澤雁，樓臺深貯洞庭風。",
      "六時金磬落何處，偏傍蘆葦驚釣翁。"
    ]
  },
  {
    "uid": "QTS_667_024_01",
    "volume": 667,
    "author": {
      "canonical": "翁洮",
      "recorded": "翁洮"
    },
    "title": "枯木詩辭召命作",
    "poem": [
      "枯木傍溪崖，由來歲月賒。",
      "有根盤水石，無葉接煙霞。",
      "二月苔為色，三冬雪作花。",
      "不因星使至，誰識是靈槎。"
    ]
  },
  {
    "uid": "QTS_667_025_01",
    "volume": 667,
    "author": {
      "canonical": "翁洮",
      "recorded": "翁洮"
    },
    "title": "贈進士王雄",
    "poem": [
      "河清海晏少波濤，幾載垂鉤不得鰲。",
      "空向人間修諫草，又來江上詠離騷。",
      "笳吹古堞邊聲遠，嶽倚晴空楚色高。",
      "何事明廷有徐庶，總教三徑臥蓬蒿。"
    ]
  },
  {
    "uid": "QTS_667_026_01",
    "volume": 667,
    "author": {
      "canonical": "翁洮",
      "recorded": "翁洮"
    },
    "title": "漁者",
    "poem": [
      "一葉飄然任浪吹，雨蓑煙笠肯忘機。",
      "只貪濁水張羅衆，卻笑清流把釣稀。",
      "葦岸夜依明月宿，柴門晴櫂白雲歸。",
      "到頭得喪終須達，誰道漁樵有是非。"
    ]
  },
  {
    "uid": "QTS_667_027_01",
    "volume": 667,
    "author": {
      "canonical": "翁洮",
      "recorded": "翁洮"
    },
    "title": "上子男壽昌宰",
    "poem": [
      "陶公為政卓潘齊，入縣看花柳滿堤。",
      "百里江山聊展驥，九皋雲月怪驅雞。",
      "高樓野色迎襟袖，比屋歌聲遠鼓鼙。",
      "只恐攀轅留不住，明時霄漢有丹梯。"
    ]
  },
  {
    "uid": "QTS_667_028_01",
    "volume": 667,
    "author": {
      "canonical": "翁洮",
      "recorded": "翁洮"
    },
    "title": "贈方干先生",
    "poem": [
      "由來箕踞任天真，別有詩名出世塵。",
      "不愛春宮分桂樹，欲教天子枉蒲輪。",
      "城頭鼙鼓三聲曉，島外湖山一簇春。",
      "獨向若耶溪上住，誰知不是釣鰲人。"
    ]
  },
  {
    "uid": "QTS_667_029_01",
    "volume": 667,
    "author": {
      "canonical": "翁洮",
      "recorded": "翁洮"
    },
    "title": "贈進士李德新接海棠梨",
    "poem": [
      "蜀人猶說種難成，何事江東見接生。",
      "席上若微桃李伴，花中堪作牡丹兄。",
      "高軒日午爭濃豔，小徑風移旋落英。",
      "一種呈妍今得地，劒峰梨嶺謾縱橫。"
    ]
  },
  {
    "uid": "QTS_667_030_01",
    "volume": 667,
    "author": {
      "canonical": "翁洮",
      "recorded": "翁洮"
    },
    "title": "春日題航頭橋",
    "poem": [
      "故園橋上絕埃塵，此日憑欄興自新。",
      "雲影晚將仙掌曙，水光迷得武陵春。",
      "薜蘿煙裏高低路，楊柳風前去住人。",
      "莫怪馬卿題姓字，終朝雲雨化龍津。"
    ]
  },
  {
    "uid": "QTS_667_031_01",
    "volume": 667,
    "author": {
      "canonical": "翁洮",
      "recorded": "翁洮"
    },
    "title": "和方幹題李頻莊",
    "poem": [
      "高情度日非無事，自是高情不覺喧。",
      "海氣暗蒸蓮葉沼，山光晴逗葦花村。",
      "吟時勝概題詩板，靜處繁華付酒尊。",
      "閒伴白雲收桂子，每尋流水斸桐孫。",
      "猶憑律呂傳心曲，豈慮星霜到鬢根。",
      "多少清風歸此地，十年虛打五侯門。"
    ]
  },
  {
    "uid": "QTS_667_032_01",
    "volume": 667,
    "author": {
      "canonical": "翁洮",
      "recorded": "翁洮"
    },
    "title": "葦叢",
    "poem": [
      "得地自成叢，那因種植功。",
      "有花皆吐雪，無韻不含風。",
      "倒影翹沙鳥，幽根立水蟲。",
      "蕭蕭寒雨夜，江漢思無窮。",
      "。"
    ]
  },
  {
    "uid": "QTS_667_033_01",
    "volume": 667,
    "author": {
      "canonical": "翁洮",
      "recorded": "翁洮"
    },
    "title": "春",
    "poem": [
      "漠漠煙花處處通，遊人南北思無窮。",
      "林間鳥奏笙簧月，野外花含錦繡風。",
      "鸑抱雲霞朝鳳闕，魚翻波浪化龍宮。",
      "此時誰羨神仙客，車馬悠揚九陌中。"
    ]
  },
  {
    "uid": "QTS_667_034_01",
    "volume": 667,
    "author": {
      "canonical": "翁洮",
      "recorded": "翁洮"
    },
    "title": "夏",
    "poem": [
      "觸目皆因長養功，浮生何處問窮通。",
      "柳長北闕絲千縷，雲簇南山火萬籠。",
      "大野煙塵飄赫日，高樓簾幕逗薰風。",
      "身心已在喧闐處，惟羨滄浪把釣翁。"
    ]
  },
  {
    "uid": "QTS_667_035_01",
