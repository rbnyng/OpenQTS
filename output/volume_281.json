    "author": {
      "canonical": "張少博",
      "recorded": "張少博",
      "gender": "male",
      "wikidata_id": "Q18909080"
    },
    "title": "尚書郎上直聞春漏",
    "poem": [
      "建禮含香處，重城待漏辰。",
      "徐聲傳鳳闕，曉唱辨雞人。",
      "銀箭聽將盡，銅壺滴更新。",
      "催籌當五夜，移刻及三春。",
      "杳杳從天遠，泠泠出禁頻。",
      "直廬殘響曙，肅穆對鉤陳。"
    ]
  },
  {
    "uid": "QTS_281_025_01",
    "volume": 281,
    "author": {
      "canonical": "張少博",
      "recorded": "張少博",
      "gender": "male",
      "wikidata_id": "Q18909080"
    },
    "title": "雪夜觀象闕待漏",
    "poem": [
      "殘雪初睛後，鳴珂奉闕庭。",
      "九門傳曉漏，五夜候晨扃。",
      "北斗橫斜漢，東方落曙星。",
      "煙氛初動色，簪珮未分形。",
      "雪重猶垂白，山遙不辨青。",
      "雞人更唱處，偏入此時聽。"
    ]
  },
  {
    "uid": "QTS_281_026_01",
    "volume": 281,
    "author": {
      "canonical": "周徹",
      "recorded": "周徹"
    },
    "title": "尚書郎上直聞春漏",
    "poem": [
      "建禮通華省，含香直紫宸。",
      "靜聞銅史漏，暗識桂宮春。",
      "滴瀝疑將絕，清泠發更新。",
      "寒聲臨雁沼，疏韻應雞人。",
      "迥入千門徹，行催五夜頻。",
      "高臺閒自聽，非是駐征輪。"
    ]
  },
  {
    "uid": "QTS_281_027_01",
