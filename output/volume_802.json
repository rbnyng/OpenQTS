      "english_name": "Guan Panpan",
      "wikidata_id": "Q9422638"
    },
    "title": "燕子樓三首 其三",
    "poem": [
      "適看鴻雁岳陽回，又睹玄禽逼社來。",
      "瑤瑟玉簫無意緒，任從蛛網任從灰。"
    ],
    "part_index": 3,
    "total_parts": 3
  },
  {
    "uid": "QTS_802_002_01",
    "volume": 802,
    "author": {
