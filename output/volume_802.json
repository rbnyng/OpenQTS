      "recorded": "劉采春",
      "gender": "female"
    },
    "title": "囉嗊曲六首 其一",
    "poem": [
      "不喜秦淮水，生憎江上船。",
      "載兒夫婿去，經歲又經年。"
    ],
    "part_index": 1,
    "total_parts": 6
  },
  {
    "uid": "QTS_802_004_02",
    "volume": 802,
    "author": {
      "canonical": "劉采春",
      "recorded": "劉采春",
      "gender": "female"
    },
    "title": "囉嗊曲六首 其二",
    "poem": [
      "借問東園柳，枯來得幾年。",
      "自無枝葉分，莫恐太陽偏。"
    ],
    "part_index": 2,
    "total_parts": 6
  },
  {
    "uid": "QTS_802_004_03",
    "volume": 802,
    "author": {
      "canonical": "劉采春",
      "recorded": "劉采春",
      "gender": "female"
    },
    "title": "囉嗊曲六首 其三",
    "poem": [
      "莫作商人婦，金釵當卜錢。",
      "朝朝江口望，錯認幾人船。"
    ],
    "part_index": 3,
    "total_parts": 6
  },
  {
    "uid": "QTS_802_004_04",
    "volume": 802,
    "author": {
      "canonical": "劉采春",
      "recorded": "劉采春",
      "gender": "female"
    },
    "title": "囉嗊曲六首 其四",
    "poem": [
      "那年離別日，只道住桐廬。",
      "桐廬人不見，今得廣州書。"
    ],
    "part_index": 4,
    "total_parts": 6
  },
  {
    "uid": "QTS_802_004_05",
    "volume": 802,
    "author": {
      "canonical": "劉采春",
      "recorded": "劉采春",
      "gender": "female"
    },
    "title": "囉嗊曲六首 其五",
    "poem": [
      "昨日勝今日，今年老去年。",
      "黃河清有日，白髮黑無緣。"
    ],
    "part_index": 5,
    "total_parts": 6
  },
  {
    "uid": "QTS_802_004_06",
    "volume": 802,
    "author": {
      "canonical": "劉采春",
      "recorded": "劉采春",
      "gender": "female"
    },
    "title": "囉嗊曲六首 其六",
    "poem": [
      "昨日北風寒，牽船浦裏安。",
      "潮來打纜斷，搖櫓始知難。"
    ],
    "part_index": 6,
    "total_parts": 6
  },
  {
    "uid": "QTS_802_005_01",
    "volume": 802,
    "author": {
      "canonical": "太原妓",
      "recorded": "太原妓",
      "gender": "female"
    },
    "title": "寄歐陽詹",
    "poem": [
      "自從別後減容光，半是思郎半恨郎。",
      "欲識舊來雲髻樣，為奴開取縷金箱。"
    ]
  },
  {
    "uid": "QTS_802_006_01",
    "volume": 802,
    "author": {
      "canonical": "武昌妓",
      "recorded": "武昌妓",
      "gender": "female"
    },
    "title": "續韋蟾句",
    "poem": [
      "悲莫悲兮生別離，登山臨水送將歸。",
      "武昌無限新栽柳，不見楊花撲面飛。"
    ],
    "notes": [
      {
        "content": "韋蟾亷問鄂州，及罷，賔僚祖餞韋，以牋書文選句授坐客，請續，有妓起，口占二句，無不嘉歎，蟾贈數十千，納之。",
        "context": "續韋蟾句",
        "original_title": "續韋蟾句",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_802_007_01",
    "volume": 802,
    "author": {
      "canonical": "舞柘枝女",
      "recorded": "舞柘枝女",
      "gender": "female"
    },
    "title": "獻李觀察",
    "poem": [
      "湘江舞罷忽成悲，便脫蠻靴出絳帷。",
      "誰是蔡邕琴酒客，魏公懷舊嫁文姬。"
    ],
    "notes": [
      {
        "content": "李觀察翺答詩云：「姑蘇太守青娥女，流落長沙舞柘枝。滿座繡衣皆不識，可憐紅臉淚交垂。」",
        "context": "獻李觀察"
      }
    ]
  },
  {
    "uid": "QTS_802_008_01",
    "volume": 802,
    "author": {
      "canonical": "常浩",
      "recorded": "常浩",
      "gender": "female"
    },
    "title": "贈盧夫人",
    "poem": [
      "佳人惜顏色，恐逐芳菲歇。",
      "日暮出畫堂，下階拜新月。",
      "拜月如有詞，傍人那得知。",
      "歸來投玉枕，始覺淚痕垂。"
    ],
