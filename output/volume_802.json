    "volume": 802,
    "author": {
      "canonical": "張窈窕",
      "recorded": "張窈窕",
      "gender": "female"
    },
    "title": "上成都在事",
    "poem": [
      "昨日賣衣裳，今日賣衣裳。",
      "衣裳渾賣盡，羞見嫁時箱。",
      "有賣愁仍緩，無時心轉傷。",
      "故園有虜隔，何處事蠶桑。"
    ],
    "variants": [
      {
        "line": 4,
        "text": "有虜",
        "variant": "多阻",
        "source": "一作「多阻」"
      }
    ]
  },
  {
