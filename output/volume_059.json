      "wikidata_id": "Q1564707"
    },
    "title": "星",
    "poem": [
      "蜀郡靈槎轉，豐城寶劒新。",
      "將軍臨北塞，天子入西秦。",
      "未作三台輔，寧爲五老臣。",
      "今宵潁川曲，誰識聚賢人。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "劒",
        "variant": "氣",
        "source": "一作「氣」"
      }
    ]
  },
