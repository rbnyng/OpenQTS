      "recorded": "厲玄"
    },
    "title": "寄婺州溫郎中",
    "poem": [
      "積雪沒蘭溪，鄰州望不迷。",
      "波中分雁宿，樹杪接猨啼。",
      "婺女家空在，星郎手未攜。",
      "故山新寺額，掩泣荷重題。"
    ],
    "notes": [
      {
        "content": "時刺睦州",
        "context": "婺州溫郎中",
        "original_title": "寄婺州溫郎中〈時刺睦州〉"
      }
    ]
  },
  {
    "uid": "QTS_516_006_01",
    "volume": 516,
    "author": {
      "canonical": "厲玄",
      "recorded": "厲玄"
    },
    "title": "送顧非熊及第歸茅山",
    "poem": [
      "故山登第去，不似舊歸難。",
      "帆卷江初夜，梅生洞少寒。",
      "採薇留客飲，折竹掃仙壇。",
      "名在儀曹籍，何人肯掛冠。"
    ]
  },
  {
    "uid": "QTS_516_007_01",
    "volume": 516,
    "author": {
      "canonical": "厲玄",
      "recorded": "厲玄"
    },
    "title": "送黃曄明府岳州湘陰赴任",
    "poem": [
      "恩霑譴雪㡬人同，歸宰湘陰六月中。",
      "商嶺馬嘶殘暑雨，席帆高掛早秋風。",
      "貢名頻向書闈失，飛檄曾傳朔漠空。",
      "西省尚嗟君宦遠，水雞啼處莫聽鴻。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "席帆高",
        "variant": "洞庭帆",
        "source": "一作「洞庭帆」"
      }
    ]
  },
  {
