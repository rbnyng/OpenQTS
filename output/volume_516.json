      "recorded": "厲玄"
    },
    "title": "緱山月夜聞王子晉吹笙",
    "poem": [
      "緱山明月夜，岑寂隔塵氛。",
      "紫府參差曲，清宵次第聞。",
      "韻流多入洞，聲度半和雲。",
      "拂竹鸞驚侶，經松鶴對群。",
      "蟾光聽處合，仙路望中分。",
      "坐惜千巖曙，遺香過汝墳。"
    ],
    "variants": [
      {
        "line": 4,
        "text": "對",
        "variant": "舞",
        "source": "一作「舞」"
      }
    ]
  },
  {
