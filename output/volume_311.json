[
  {
    "uid": "QTS_311_001_01",
    "volume": 311,
    "author": {
      "canonical": "劉長川",
      "recorded": "劉長川"
    },
    "title": "寶劍篇",
    "poem": [
      "寶劍不可得，相逢幾許難。",
      "今朝一度見，赤色照人寒。",
      "匣裏星文動，環邊月影殘。",
      "自然神鬼伏，無事莫空彈。"
    ]
  },
  {
    "uid": "QTS_311_002_01",
    "volume": 311,
    "author": {
      "canonical": "劉長川",
      "recorded": "劉長川"
    },
    "title": "將赴東都上李相公",
    "poem": [
      "四海兵初偃，平津閣正開。",
      "誰知大爐下，還有不然灰。"
    ]
  },
  {
    "uid": "QTS_311_003_01",
    "volume": 311,
    "author": {
      "canonical": "鄭常",
      "recorded": "鄭常"
    },
    "title": "寄邢逸人",
    "poem": [
      "羨君無外事，日與世情違。",
      "地僻人難到，溪深鳥自飛。",
      "儒衣荷葉老，野飯藥苗肥。",
      "疇昔江湖意，而今憶共歸。"
    ]
  },
  {
    "uid": "QTS_311_004_01",
    "volume": 311,
    "author": {
      "canonical": "鄭常",
      "recorded": "鄭常"
    },
    "title": "送頭陀上人赴廬山寺",
    "poem": [
      "僧家無住著，早晚出東林。",
      "得道非真相，頭陀是苦心。",
      "持齋山果熟，倚錫野雲深。",
      "溪寺誰相待，香花與梵音。"
    ]
  },
  {
    "uid": "QTS_311_005_01",
    "volume": 311,
    "author": {
      "canonical": "鄭常",
      "recorded": "鄭常"
    },
    "title": "謫居漢陽白沙口阻雨，因題驛亭",
    "poem": [
      "漢陽無遠近，見說過湓城。",
      "雲雨經春客，江山幾日程。",
      "終隨鷗鳥去，只待海潮生。",
      "前路逢漁父，多慚問姓名。"
    ]
  },
  {
    "uid": "QTS_311_006_01",
    "volume": 311,
    "author": {
      "canonical": "陳存",
      "recorded": "陳存"
    },
    "title": "穆陵路",
    "poem": [
      "西遊匣長劍，日暮湘楚間。",
      "歇馬上秋草，逢人問故關。",
      "孤村綠塘水，曠野白雲山。",
      "方念此中去，何時此路還。"
    ]
  },
  {
    "uid": "QTS_311_007_01",
    "volume": 311,
    "author": {
      "canonical": "陳存",
      "recorded": "陳存"
    },
    "title": "清溪館作",
    "poem": [
      "指途清溪裏，左右唯深林。",
      "雲蔽望鄉處，雨愁為客心。",
      "遇人多物役，聽鳥時幽音。",
      "何必滄浪水，庶茲浣塵襟。"
    ]
  },
  {
    "uid": "QTS_311_008_01",
    "volume": 311,
    "author": {
      "canonical": "陳存",
      "recorded": "陳存"
    },
    "title": "寓居武丁館",
    "poem": [
      "暑雨飄已過，涼飆觸幽衿。",
      "虛館無喧塵，綠槐多晝陰。",
      "俯視古苔積，仰聆早蟬吟。",
      "放卷一長想，閉門千里心。"
    ]
  },
  {
    "uid": "QTS_311_009_01",
    "volume": 311,
    "author": {
      "canonical": "陳存",
      "recorded": "陳存"
    },
    "title": "楚州贈別周願侍禦",
    "poem": [
      "漂泊楚水來，舍舟坐高館。",
      "途窮在中路，孤征慕前伴。",
      "風雨一留宿，關山去欲懶。",
      "淮南木葉飛，夜聞廣陵散。"
    ]
  },
  {
    "uid": "QTS_311_010_01",
    "volume": 311,
    "author": {
      "canonical": "陳存",
      "recorded": "陳存"
    },
    "title": "送劉秀才南歸",
    "poem": [
      "鳥啼楊柳垂，此別千萬裏。",
      "古路入商山，春風去灞水。",
      "停車落日在，罷酒離人起。",
      "蓬戶寄龍沙，送歸情詎已。"
    ],
    "notes": [
      {
        "content": "一作劉複詩",
        "context": "劉秀才南歸",
        "original_title": "送劉秀才南歸（一作劉複詩）"
      }
    ]
  },
  {
    "uid": "QTS_311_011_01",
    "volume": 311,
    "author": {
      "canonical": "陳存",
      "recorded": "陳存"
    },
    "title": "丹陽作",
    "poem": [
      "暫入新豐市，猶聞舊酒香。",
      "抱琴沽一醉，盡日臥垂楊。"
    ],
    "notes": [
      {
        "content": "一作朱彬詩",
        "context": "丹陽作",
        "original_title": "丹陽作（一作朱彬詩）"
      }
    ]
  },
  {
    "uid": "QTS_311_012_01",
    "volume": 311,
    "author": {
      "canonical": "王觀",
      "recorded": "王觀",
      "gender": "male",
      "wikidata_id": "Q16260089"
    },
    "title": "早行",
    "poem": [
      "雞唱催人起，又生前去愁。",
      "路明殘月在，山露宿雲收。",
      "村店煙火動，漁家燈燭幽。",
      "趨名與趨利，行役幾時休。"
    ]
  },
  {
    "uid": "QTS_311_013_01",
    "volume": 311,
    "author": {
      "canonical": "崔瓘",
      "recorded": "崔瓘",
      "gender": "male",
      "period": "High Tang",
      "english_name": "Cui Guan",
      "wikidata_id": "Q18908615"
    },
    "title": "贈營妓",
    "poem": [
      "寒簷寂寂雨霏霏，候館蕭條燭燼微。",
      "只有今宵同此宴，翠娥佯醉欲先歸。"
    ]
  },
  {
    "uid": "QTS_311_014_01",
    "volume": 311,
    "author": {
      "canonical": "鄭審",
      "recorded": "鄭審"
    },
    "title": "酒席賦得匏瓢",
    "poem": [
      "華閣與賢開，仙瓢自遠來。",
      "幽林嘗伴許，陋巷亦隨回。",
      "掛影憐紅壁，傾心向綠杯。",
      "何曾斟酌處，不使玉山頹。"
    ]
  },
  {
    "uid": "QTS_311_015_01",
    "volume": 311,
    "author": {
      "canonical": "鄭審",
      "recorded": "鄭審"
    },
    "title": "奉使巡檢兩京路種果樹事畢入秦因詠",
    "poem": [
      "聖德周天壤，韶華滿帝畿。",
      "九重承渙汗，千里樹芳菲。",
      "陝塞餘陰薄，關河舊色微。",
      "發生和氣動，封植眾心歸。",
      "春露條應弱，秋霜果定肥。",
      "影移行子蓋，香撲使臣衣。",
      "入徑迷馳道，分行接禁闈。",
      "何當扈仙蹕，攀折奉恩輝。"
    ]
  },
