      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "送知己赴濮州",
    "poem": [
      "中路行僧謁，郵亭話海濤。",
      "劍搖林狖落，旗閃岳禽高。",
      "苔長空州獄，花開夢省曹。",
      "濮陽流政化，一半布風騷。"
    ],
    "variants": [
      {
        "line": 4,
        "text": "布",
        "variant": "自",
        "source": "一作「自」"
      }
    ]
