[
  {
    "uid": "QTS_512_001_01",
    "volume": 512,
    "author": {
      "canonical": "楊洵美",
      "recorded": "楊洵美"
    },
    "title": "答李昌期",
    "poem": [
      "三山載群仙，峨峨鹹浪中。",
      "雲衣剪不得，此路安可從。",
      "我生亦何事，出門如飛蓬。",
      "白日又黃昏，所悲瑤草空。",
      "蟲聲故鄉夢，枕上禾黍風。",
      "吾道如未喪，天運何時通。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "雲",
        "variant": "霞",
        "source": "一作「霞」"
      },
      {
        "line": 6,
        "text": "時",
        "variant": "處",
        "source": "一作「處」"
      }
    ]
  },
  {
    "uid": "QTS_512_002_01",
    "volume": 512,
    "author": {
      "canonical": "長孫翱",
      "recorded": "長孫翱"
    },
    "title": "宮詞",
    "poem": [
      "一道甘泉接御溝，上皇行處不曾秋。",
      "誰言水是無情物，也到宮前咽不流。"
    ]
  },
  {
    "uid": "QTS_512_003_01",
    "volume": 512,
    "author": {
      "canonical": "盧求",
      "recorded": "盧求",
      "gender": "male",
      "wikidata_id": "Q18905885"
    },
    "title": "和于中丞登越王樓見寄",
    "poem": [
      "高情推謝守，善政屬綿州。",
      "未落紫泥詔，閑登白雪樓。",
      "晴江如送日，寒嶺鎮迎秋。",
      "滿壁朝天士，唯予不繫舟。"
    ]
  },
  {
    "uid": "QTS_512_004_01",
    "volume": 512,
    "author": {
      "canonical": "歐陽袞",
      "recorded": "歐陽袞"
    },
    "title": "雨",
    "poem": [
      "細雨弄春陰，餘寒入晝深。",
      "山姿輕薄霧，煙色澹幽林。",
      "鹿踐莓苔滑，魚牽水荇沈。",
      "懷情方未已，清酒漫須斟。"
    ]
  },
  {
    "uid": "QTS_512_005_01",
    "volume": 512,
    "author": {
      "canonical": "歐陽袞",
      "recorded": "歐陽袞"
    },
    "title": "田家",
    "poem": [
      "黯黯日將夕，牛羊村外來。",
      "巖阿青氣發，籬落杏花開。",
      "草木應初感，鶬鶊亦已催。",
      "晚間春作好，行樂不須猜。"
    ]
  },
  {
    "uid": "QTS_512_006_01",
    "volume": 512,
    "author": {
      "canonical": "歐陽袞",
      "recorded": "歐陽袞"
    },
    "title": "神光寺",
    "poem": [
      "香剎懸青磴，飛樓界碧空。",
      "石門棲怖鴿，慈塔繞歸鴻。",
      "有法將心鏡，無名屬性通。",
      "從來樂幽寂，尋覓未能窮。"
    ]
  },
  {
    "uid": "QTS_512_007_01",
    "volume": 512,
    "author": {
      "canonical": "歐陽袞",
      "recorded": "歐陽袞"
    },
    "title": "和項斯遊頭陀寺上方",
    "poem": [
      "步入桃源裏，晴花更滿枝。",
      "峰廻山意曠，林杳竹光遲。",
      "遠寺尋龍藏，名香發雁池。",
      "間能將遠語，況及上陽時。"
    ]
  },
  {
    "uid": "QTS_512_008_01",
    "volume": 512,
    "author": {
      "canonical": "歐陽袞",
      "recorded": "歐陽袞"
    },
    "title": "秦原道中",
    "poem": [
      "分險架長瀾，斜梁控夕巒。",
      "宿雲依嶺斷，初月入江寒。",
      "緇化秦裘敝，塵驚漢策殘。",
      "無言倦行旅，遙路屬時難。"
    ]
  },
  {
    "uid": "QTS_512_009_01",
    "volume": 512,
    "author": {
      "canonical": "歐陽袞",
      "recorded": "歐陽袞"
    },
    "title": "月峰寺憶理公",
    "poem": [
      "共來江海上，清論一宵同。",
      "禪榻渾依舊，心期浩已空。",
      "驚春花落樹，聞梵澗搖風。",
      "二諦欣咨啟，還應夢寐通。"
    ]
  },
  {
    "uid": "QTS_512_010_01",
    "volume": 512,
    "author": {
      "canonical": "歐陽袞",
      "recorded": "歐陽袞"
    },
    "title": "寄陳去疾進士",
    "poem": [
      "放跡疑辭垢，棲心亦道門。",
      "玄言蘿幌馥，詩思竹爐溫。",
      "解帶搖花落，彈琴散鳥喧。",
      "江山茲夕意，唯有素交存。"
    ]
  },
  {
    "uid": "QTS_512_011_01",
    "volume": 512,
    "author": {
      "canonical": "歐陽袞",
      "recorded": "歐陽袞"
    },
    "title": "聽郢客歌陽春白雪",
    "poem": [
      "寂聽郢中人，高歌已絕倫。",
      "臨風飄白雪，向日奏陽春。",
      "調雅偏盈耳，聲長杳入神。",
      "連連貫珠並，嫋嫋遏雲頻。",
      "度曲知難和，凝情想任真。",
      "周郎如賞羨，莫使滯芳晨。"
    ]
  },
  {
    "uid": "QTS_512_012_01",
    "volume": 512,
    "author": {
      "canonical": "歐陽袞",
      "recorded": "歐陽袞"
    },
    "title": "南澗寺",
    "poem": [
      "春寺無人亂鳥啼，藤蘿陰磴野僧迷。",
      "雲藏古壁遺龍象，草沒香臺抱鹿麛。",
      "松籟泠泠疑梵唄，柳煙歷歷見招提。",
      "為耽寂樂親禪侶，莫怪閑行費馬蹄。"
    ]
  }
]