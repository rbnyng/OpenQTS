    "volume": 602,
    "author": {
      "canonical": "汪遵",
      "recorded": "汪遵",
      "gender": "male",
      "english_name": "Wang Zun",
      "wikidata_id": "Q22098887"
    },
    "title": "採桑婦",
    "poem": [
      "為報躊躇陌上郎，蠶飢日晚妾心忙。",
      "本來若愛黃金好，不肯攜籠更採桑。"
    ]
  },
  {
