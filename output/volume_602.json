    "volume": 602,
    "author": {
      "canonical": "汪遵",
      "recorded": "汪遵",
      "gender": "male",
      "english_name": "Wang Zun",
      "wikidata_id": "Q22098887"
    },
    "title": "北海",
    "poem": [
      "漢臣曾此作縲囚，茹血衣毛十九秋。",
      "鶴髮半垂龍節在，不聞青史說封侯。"
    ]
  },
  {
