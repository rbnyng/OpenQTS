    "title": "升平詞五首 其一",
    "poem": [
      "瑞氣繞宮樓，皇居上苑遊。",
      "遠岡連聖祚，平地載神州。",
      "會合兼重譯，潺湲近八流。",
      "中興豈假問，據此自千秋。"
    ],
    "part_index": 1,
    "total_parts": 5
  },
  {
    "uid": "QTS_640_001_02",
    "volume": 640,
    "author": {
      "canonical": "曹唐",
      "recorded": "曹唐",
      "gender": "male",
      "english_name": "Cao Tang",
      "wikidata_id": "Q22098757"
    },
    "title": "升平詞五首 其二",
    "poem": [
      "寥泬敞延英，朝班立位橫。",
      "宣傳無草動，拜舞有衣聲。",
      "鴛瓦霜消濕，蟲絲日照明。",
      "辛勤自不到，遙見似前程。"
    ],
    "part_index": 2,
    "total_parts": 5
  },
  {
    "uid": "QTS_640_001_03",
    "volume": 640,
    "author": {
      "canonical": "曹唐",
      "recorded": "曹唐",
      "gender": "male",
      "english_name": "Cao Tang",
      "wikidata_id": "Q22098757"
    },
    "title": "升平詞五首 其三",
    "poem": [
      "處處是歡心，時康歲已深。",
      "不同三尺劍，應似五弦琴。",
      "壽笑山猶盡，明嫌日有陰。",
      "何當憐一物，亦遣斷愁吟。"
    ],
    "part_index": 3,
    "total_parts": 5
  },
  {
    "uid": "QTS_640_001_04",
    "volume": 640,
    "author": {
      "canonical": "曹唐",
      "recorded": "曹唐",
      "gender": "male",
      "english_name": "Cao Tang",
      "wikidata_id": "Q22098757"
    },
    "title": "升平詞五首 其四",
    "poem": [
      "日日聽歌謠，區中盡祝堯。",
      "蟲蝗初不害，夷狄近全銷。",
      "史筆唯書瑞，天臺絕見妖。",
      "因令匹夫志，轉欲事清朝。"
    ],
    "part_index": 4,
    "total_parts": 5
  },
  {
    "uid": "QTS_640_001_05",
    "volume": 640,
    "author": {
      "canonical": "曹唐",
      "recorded": "曹唐",
      "gender": "male",
      "english_name": "Cao Tang",
      "wikidata_id": "Q22098757"
    },
    "title": "升平詞五首 其五",
    "poem": [
      "五帝三皇主，蕭曹魏邴臣。",
      "文章唯返樸，戈甲盡生塵。",
      "諫紙應無用，朝綱自有倫。",
      "升平不可記，所見是閒人。"
    ],
    "part_index": 5,
    "total_parts": 5
  },
