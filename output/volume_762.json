[
  {
    "uid": "QTS_762_001_01",
    "volume": 762,
    "author": {
      "canonical": "劉昭禹",
      "recorded": "劉昭禹"
    },
    "title": "括蒼山",
    "poem": [
      "盡日行方半，諸山直下看。",
      "白雲隨步起，危徑極天盤。",
      "瀑頂橋形小，溪邊店影寒。",
      "往來空太息，玄鬢改非難。"
    ]
  },
  {
    "uid": "QTS_762_002_01",
    "volume": 762,
    "author": {
      "canonical": "劉昭禹",
      "recorded": "劉昭禹"
    },
    "title": "憶天台山",
    "poem": [
      "常記遊靈境，道人情不低。",
      "巖房容偃息，天路許相攜。",
      "霞散曙峰外，虹生涼瀑西。",
      "何當塵役了，重去聽猨啼。"
    ]
  },
  {
    "uid": "QTS_762_003_01",
    "volume": 762,
    "author": {
      "canonical": "劉昭禹",
      "recorded": "劉昭禹"
    },
    "title": "冬日暮國清寺留題",
    "poem": [
      "天台山下寺，冬暮景如屏。",
      "樹密風長在，年深像有靈。",
      "高鐘疑到月，遠燒欲連星。",
      "因共真僧話，心中萬慮寧。"
    ]
  },
  {
    "uid": "QTS_762_004_01",
    "volume": 762,
    "author": {
      "canonical": "劉昭禹",
      "recorded": "劉昭禹"
    },
    "title": "靈溪觀",
    "poem": [
      "鼇海西邊地，宵吟景象寬。",
      "雲開孤月上，瀑噴一山寒。",
      "人異髮常綠，草靈秋不乾。",
      "無由此棲息，魂夢在長安。"
    ]
  },
  {
    "uid": "QTS_762_005_01",
    "volume": 762,
    "author": {
      "canonical": "劉昭禹",
      "recorded": "劉昭禹"
    },
    "title": "懷華山隱者",
    "poem": [
      "先生入太華，杳杳絕良音。",
      "秋夢有時見，孤雲無處尋。",
      "神清峰頂立，衣冷瀑邊吟。",
      "應笑干名者，六街塵土深。"
    ]
  },
  {
    "uid": "QTS_762_006_01",
    "volume": 762,
    "author": {
      "canonical": "劉昭禹",
      "recorded": "劉昭禹"
    },
    "title": "贈惠律大師",
    "poem": [
      "秋是憶山日，禪窗露灑餘。",
      "幾懸華頂夢，應寄沃洲書。",
      "風月資吟筆，杉篁籠靜居。",
      "滿城誰不重，見著紫衣初。"
    ]
  },
  {
    "uid": "QTS_762_007_01",
    "volume": 762,
    "author": {
      "canonical": "劉昭禹",
      "recorded": "劉昭禹"
    },
    "title": "經費冠卿舊隱",
    "poem": [
      "節高終不起，死戀九華山。",
      "聖主情何切，孤雲性本閑。",
      "名傳中國外，墳在亂松間。",
      "依約曾棲處，斜陽鳥自還。"
    ]
  },
  {
    "uid": "QTS_762_008_01",
    "volume": 762,
    "author": {
      "canonical": "劉昭禹",
      "recorded": "劉昭禹"
    },
    "title": "聞蟬",
    "poem": [
      "一雨一番晴，山林冷落青。",
      "莫侵殘日噪，正在異鄉聽。",
      "孤館宿漳浦，扁舟離洞庭。",
      "年年當此際，那免鬢凋零。"
    ]
  },
  {
    "uid": "QTS_762_009_01",
    "volume": 762,
    "author": {
      "canonical": "劉昭禹",
      "recorded": "劉昭禹"
    },
    "title": "送休公歸衡",
    "poem": [
      "草履初登南嶽船，銅瓶猶貯北山泉。",
      "衡陽舊寺春歸晚，門鎖寒潭幾樹蟬。"
    ]
  },
  {
    "uid": "QTS_762_010_01",
    "volume": 762,
    "author": {
      "canonical": "劉昭禹",
      "recorded": "劉昭禹"
    },
    "title": "句",
    "poem": [
      "句向夜深得，心從天外歸。",
      "危樓聊側耳，高柳又鳴蟬。",
      "蘚色圍波井，花陰上竹樓。",
      "對面雷瞋樹，當街雨趁人。",
      "春光懷玉闕，萬里起初程。",
      "江上呼風去，天邊掛席飛。",
      "漆燈尋黑洞，之字上危峰。"
    ],
