        "text": "暖",
        "variant": "曖",
        "source": "一作「曖」"
      }
    ]
  },
  {
    "uid": "QTS_105_002_01",
    "volume": 105,
    "author": {
      "canonical": "王景",
      "recorded": "王景"
    },
    "title": "奉和九月九日登慈恩寺浮圖應制",
    "poem": [
      "玉輦移中禁，珠梯覽四禪。",
      "重階清漢接，飛竇紫霄懸。",
      "綴葉披天藻，吹花散御筵。",
      "無因鑾蹕暇，俱舞鶴林前。"
    ]
  },
  {
    "uid": "QTS_105_003_01",
    "volume": 105,
    "author": {
      "canonical": "畢乾泰",
      "recorded": "畢乾泰"
    },
    "title": "奉和九月九日登慈恩寺浮圖應制",
    "poem": [
      "鸚林花塔啟，鳳輦順時遊。",
      "重九昭皇慶，大千揚帝休。",
      "耆闍妙法闡，王舍睿文流。",
      "至德覃無極，小臣歌詎酬。"
    ]
  },
  {
    "uid": "QTS_105_004_01",
    "volume": 105,
    "author": {
      "canonical": "麴瞻",
      "recorded": "麴瞻"
    },
    "title": "奉和九月九日登慈恩寺浮圖應制",
    "poem": [
      "扈蹕遊玄地，陪仙瞰紫微。",
      "似邁銖衣刼，將同羽化飛。",
      "雕戈秋日麗，寶劒曉霜霏。",
      "獻觴乘菊序，長願奉天暉。"
    ]
  },
  {
    "uid": "QTS_105_005_01",
    "volume": 105,
    "author": {
      "canonical": "樊忱",
      "recorded": "樊忱"
    },
    "title": "奉和九月九日登慈恩寺浮圖應制",
    "poem": [
      "淨境重陽節，仙遊萬乘來。",
      "插萸登鷲嶺，把菊坐蜂臺。",
      "十地祥雲合，三天瑞景開。",
      "秋風詞更遠，竊抃樂康哉。"
    ],
    "variants": [
