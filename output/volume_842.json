      "wikidata_id": "Q11180237"
    },
    "title": "貽廬岳陳沆秀才",
    "poem": [
      "為儒老雙鬢，勤苦竟何如。",
      "四海方磨劍，空山自讀書。",
      "石圍泉眼碧，秋落洞門虛。",
      "莫慮搜賢僻，征君舊此居。"
    ]
  },
  {
    "uid": "QTS_842_003_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "邊上",
    "poem": [
      "漢地從休馬，胡家自牧羊。",
      "都來銷帝道，渾不用兵防。",
      "草上孤城白，沙翻大漠黃。",
      "秋風起邊雁，一一向瀟湘。"
    ]
  },
  {
    "uid": "QTS_842_004_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "蟋蟀",
    "poem": [
      "聲異蟪蛄聲，聽須是正聽。",
      "無風來竹院，有月在莎庭。",
      "雖不妨調瑟，多堪伴誦經。",
      "誰人向秋夕，為爾欲忘形。"
    ]
  },
  {
    "uid": "QTS_842_005_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "寄西山鄭穀神",
    "poem": [
      "西望鄭先生，焚修在杳冥。",
      "幾番松骨朽，未換鬢根青。",
      "石闕涼調瑟，秋壇夜拜星。",
      "俗人應撫掌，閑處誦黃庭。"
    ]
  },
  {
    "uid": "QTS_842_006_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "讀參同契",
    "poem": [
      "堪笑修仙侶，燒金覓大還。",
      "不知消息火，只在寂寥關。",
      "鬢白爐中術，魂飛海上山。",
      "悲哉五千字，無用在人間。"
    ]
  },
  {
    "uid": "QTS_842_007_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "聞落葉",
    "poem": [
      "楚樹雪晴後，蕭蕭落晚風。",
      "因思故國夜，臨水幾株空。",
      "煮茗燒乾脆，行苔踏爛紅。",
      "來年未離此，還見碧叢叢。"
    ]
  },
  {
    "uid": "QTS_842_008_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "謝王先輩昆弟游湘中回各見示新詩",
    "poem": [
      "瀟湘多勝異，宗社久裴回。",
      "兄弟同游去，幽奇盡采來。",
      "只應求妙唱，何以示寒灰。",
      "上國攜歸後，唯呈不世才。"
    ]
  },
  {
    "uid": "QTS_842_009_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "寄酬高輦推官",
    "poem": [
      "道自閑機長，詩從靜境生。",
      "不知春豔盡，但覺雅風清。",
      "竹膩題幽碧，蕉乾裂脆聲。",
      "何當九霄客，重疊記無名。"
    ]
  },
  {
    "uid": "QTS_842_010_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "逢詩僧",
    "poem": [
      "禪玄無可並，詩妙有何評。",
      "五七字中苦，百千年後清。",
      "難求方至理，不朽始為名。",
      "珍重重相見，忘機話此情。"
    ]
  },
  {
    "uid": "QTS_842_011_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "話道",
    "poem": [
      "大道多大笑，寂寥何以論。",
      "霜楓翻落葉，水鳥啄閑門。",
      "服藥還傷性，求珠亦損魂。",
      "無端鑿混沌，一死不還源。"
    ]
  },
  {
    "uid": "QTS_842_012_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "謝歐陽侍郎寄示新集",
    "poem": [
      "宮錦三十段，金梭新織來。",
      "殷勤謝君子，迢遞寄寒灰。",
      "鸑鷟對鼓舞，神仙雙裴回。",
      "誰當巧裁製，披去升瑤台。"
    ]
  },
  {
    "uid": "QTS_842_013_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "西墅新居",
    "poem": [
      "漸漸見苔青，疏疏遍地生。",
      "閑穿藤屐起，亂踏石階行。",
      "野鳥啼幽樹，名僧笑此情。",
      "殘陽竹陰裏，老圃打門聲。"
    ]
  },
  {
    "uid": "QTS_842_014_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "酬孫魴",
    "poem": [
      "幽人還愛雲，才子已從軍。",
      "可信鴛鴻侶，更思麋鹿群。",
      "新題雖有寄，舊論竟難聞。",
      "知己今如此，編聯悉欲焚。"
    ]
  },
  {
    "uid": "QTS_842_015_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "掃地",
    "poem": [
      "日日掃複灑，不容纖物侵。",
      "敢望來客口，道似主人心。",
      "蟻過光中少，苔依潤處深。",
      "門前亦如此，一徑入疏林。"
    ]
  },
  {
    "uid": "QTS_842_016_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "書匡山隱者壁",
    "poem": [
      "紅霞青壁底，石室薜蘿垂。",
      "應有迷仙者，曾逢采藥時。",
      "桃花饒兩頰，松葉淺長髭。",
      "直是來城市，何人識得伊。"
    ]
  },
  {
    "uid": "QTS_842_017_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "送幹康禪師入山過夏",
    "poem": [
      "由來喧滑境，難駐寂寥蹤。",
      "逼夏搖孤錫，離城入亂峰。",
      "雲門應近寺，石路或穿松。",
      "知在棲禪外，題詩寄北宗。"
    ]
  },
  {
    "uid": "QTS_842_018_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "野鴨",
    "poem": [
      "野鴨殊家鴨，離群忽遠飛。",
      "長生緣甚瘦，近死為傷肥。",
      "江海遊空闊，池塘啄細微。",
      "紅蘭白蘋渚，春暖刷毛衣。"
    ]
  },
  {
    "uid": "QTS_842_019_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "傷秋",
    "poem": [
      "旦暮餘生在，肌膚十分無。",
      "眠寒半榻朽，立月一株枯。",
      "夢已隨雙樹，詩猶卻萬夫。",
      "名山未歸得，可惜死江湖。"
    ]
  },
  {
    "uid": "QTS_842_020_01",
    "volume": 842,
    "author": {
      "canonical": "齊己",
      "recorded": "齊己",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "懷東湖寺",
    "poem": [
      "鐵柱東湖岸，寺高人亦閑。",
      "往年曾每日，來此看西山。",
      "竹徑青苔合，茶軒白鳥還。",
      "而今在天末，欲去已衰顏。"
    ]
  },
  {
    "uid": "QTS_842_021_01",
    "volume": 842,
    "author": {
