      "wikidata_id": "Q11180237"
    },
    "title": "寄峴山願公三首 其一",
    "poem": [
      "形影更誰親，應懷漆道人。",
      "片言酬鑿齒，半偈伏姚秦。",
      "榛莽池經燒，蒿萊寺過春。",
      "心期重西去，一共吊遺塵。"
    ],
    "part_index": 1,
    "total_parts": 3
  },
  {
    "uid": "QTS_842_021_02",
    "volume": 842,
    "author": {
