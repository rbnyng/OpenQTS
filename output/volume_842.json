      "english_name": "Qiji",
      "wikidata_id": "Q11180237"
    },
    "title": "寄峴山願公三首 其三",
    "poem": [
      "彼此無消息，所思江漢遙。",
      "轉聞多患難，甚說遠相招。",
      "老至何悲歎，生知便寂寥。",
      "終期踏松影，攜手虎溪橋。"
    ],
    "part_index": 3,
    "total_parts": 3
  },
  {
    "uid": "QTS_842_022_01",
    "volume": 842,
    "author": {
