    ]
  },
  {
    "uid": "QTS_812_016_01",
    "volume": 812,
    "author": {
      "canonical": "清江",
      "recorded": "清江",
      "gender": "male"
    },
    "title": "酬姚補闕南仲雲溪館中戲題隨書見寄",
    "poem": [
      "寺溪臨使府，風景借仁祠。",
      "補袞周官貴，能名漢主慈。",
      "臥雲知獨處，望月憶同時。",
      "忽枉緘中贈，瓊瑤滿手持。"
    ]
  },
  {
    "uid": "QTS_812_017_01",
    "volume": 812,
    "author": {
