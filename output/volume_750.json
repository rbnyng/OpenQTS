[
  {
    "uid": "QTS_750_001_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "和潯陽宰感舊絕句五首 其一",
    "poem": [
      "追感古今情不已，竹軒閒取史書看。",
      "欲親往哲無因見，空樹臨風襟袖寒。"
    ],
    "part_index": 1,
    "total_parts": 5
  },
  {
    "uid": "QTS_750_001_02",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "和潯陽宰感舊絕句五首 其二",
    "poem": [
      "潯陽物景真難及，練㵼澄江最好看。",
      "曾上虛樓吟倚檻，五峰擎雪照人寒。"
    ],
    "part_index": 2,
    "total_parts": 5
  },
  {
    "uid": "QTS_750_001_03",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "和潯陽宰感舊絕句五首 其三",
    "poem": [
      "園林春媚千花發，爛熳如將畫障看。",
      "惟愛松筠多冷淡，青青偏稱雪霜寒。"
    ],
    "part_index": 3,
    "total_parts": 5
  },
  {
    "uid": "QTS_750_001_04",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "和潯陽宰感舊絕句五首 其四",
    "poem": [
      "知君百里鳴琴處，公退千山盡日看。",
      "政化有同風偃草，更將餘力拯孤寒。"
    ],
    "part_index": 4,
    "total_parts": 5
  },
  {
    "uid": "QTS_750_001_05",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "和潯陽宰感舊絕句五首 其五",
    "poem": [
      "昔歲尋芳忻得侶，江堤物景盡情看。",
      "就中吟戀垂楊下，撼起啼鶯晩吹寒。"
    ],
    "part_index": 5,
    "total_parts": 5
  },
  {
    "uid": "QTS_750_002_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "哭柴郎中",
    "poem": [
      "昔歲遭逢在海城，曾容孤跡奉雙旌。",
      "酒邊不厭笙歌盛，花下只愁風雨生。",
      "棊接山亭松影晩，吟陪月檻露華清。",
      "音塵自此無因問，淚灑川波夕照明。"
    ]
  },
  {
    "uid": "QTS_750_003_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "訪章禪老",
    "poem": [
      "比尋禪客叩禪機，澄卻心如月在池。",
      "松下偶然醒一夢，卻成無語問吾師。"
    ]
  },
  {
    "uid": "QTS_750_004_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "泊秋浦",
    "poem": [
      "葦㟁風高宿雁驚，維舟特地起鄉情。",
      "漁兒隔水吹橫笛，半夜空江月正明。"
    ]
  },
  {
    "uid": "QTS_750_005_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "閒居言懷",
    "poem": [
      "未逹難隨衆，從他俗所憎。",
      "閒聽九秋雨，遠憶四明僧。",
      "病後倦吟嘯，貧來疎友朋。",
      "寂寥元合道，未必是無能。"
    ]
  },
  {
    "uid": "QTS_750_006_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "舟次彭澤",
    "poem": [
      "飄泛經彭澤，扁舟思莫窮。",
      "無人秋浪晚，一㟁蓼花風。",
      "鄉里夢漸遠，交親書未通。",
      "今宵見圓月，難坐冷光中。"
    ]
  },
  {
    "uid": "QTS_750_007_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "宿鍾山知覺院",
    "poem": [
      "宿投林下寺，中夜覺神清。",
      "磬罷僧初定，山空月又生。",
      "籠燈吐冷艷，嵒樹起寒聲。",
      "待暁紅塵裏，依前冒遠程。"
    ]
  },
  {
    "uid": "QTS_750_008_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "遊茅山二首 其一",
    "poem": [
      "綠蘚深迎步，紅霞爛滿衣。",
      "洞天應不遠，鸞鶴向人飛。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_750_008_02",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "遊茅山二首 其二",
    "poem": [
      "茅許仙蹤在，煙霞一境清。",
      "夷希何許叩，松徑月空明。"
    ],
    "part_index": 2,
    "total_parts": 2,
    "variants": [
      {
        "line": 2,
        "text": "夷希",
        "variant": "希夷",
        "source": "一作「希夷」"
      }
    ]
  },
  {
    "uid": "QTS_750_009_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "鶴",
    "poem": [
      "九皋羽翼下晴空，萬里心難駐玉籠。",
      "清露滴時翹蘚徑，白雲開處唳松風。",
      "歸當華表千年後，怨在瑤琴別操中。",
      "好共靈龜作儔侶，十洲三島逐仙翁。"
    ]
  },
  {
    "uid": "QTS_750_010_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "暮春吟懷寄姚端先輩",
    "poem": [
      "無奈詩魔旦夕生，更堪芳草滿長汀。",
      "故人還爽花前約，新月又生江上亭。",
      "莊夢斷時燈欲燼，蜀魂啼處酒初醒。",
      "何時得見登龍客，隔卻千山萬仭青。"
    ]
  },
  {
    "uid": "QTS_750_011_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "送圓上人歸廬山",
    "poem": [
      "蓮宮舊隠塵埃外，策杖臨風拂袖還。",
      "踏雪獨尋青嶂下，聽猿重入白雲間。",
      "蕭騷紅樹當門老，斑駮蒼苔鏁徑閑。",
      "預想松軒夜禪處，虎溪圓月照空山。"
    ]
  },
  {
    "uid": "QTS_750_012_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "送相里秀才之匡山國子監",
    "poem": [
      "氣秀情閑杳莫羣，廬山逰去志求文。",
      "已能探虎窮騷雅，又欲囊螢就典墳。",
      "目豁乍窺千里浪，夢寒初宿五峰雲。",
      "業成早赴春闈約，要使嘉名海內聞。"
    ]
  },
  {
    "uid": "QTS_750_013_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "漁父二首 其一",
    "poem": [
      "偶向蘆花深處行，溪光山色晚來晴。",
      "漁家開戶相迎接，稚子爭窺犬吠聲。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_750_013_02",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "漁父二首 其二",
    "poem": [
      "雪鬢衰髯白布袍，笑攜赬鯉換村醪。",
      "慇懃留我宿溪上，釣艇歸來明月高。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_750_014_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "旅次聞砧",
    "poem": [
      "砧杵誰家夜搗衣，金風淅淅露微微。",
      "月中獨坐不成寐，舊業經年未得歸。"
    ]
  },
  {
    "uid": "QTS_750_015_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "寄楊先生",
    "poem": [
      "仙翁別後無信，應共煙霞卜鄰。",
      "莫把壺中袐訣，輕傳塵裏逰人。",
      "浮生日月自急，上境鶯花正春。",
      "安得一招琴酒，與君共泛天津。"
    ]
  },
  {
    "uid": "QTS_750_016_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "對酒招陳昭用",
    "poem": [
      "花開葉落堪悲，似水年光暗移。",
      "身世都如夢役，是非空使神疲。",
      "良圖有分終在，所欲無勞妄思。",
      "幸有一壺清酒，且來閑語希夷。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "妄",
        "variant": "遠",
        "source": "一作「遠」"
      }
    ]
  },
  {
    "uid": "QTS_750_017_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "旅夜聞笛",
    "poem": [
      "長笛起誰家，秋涼夜漏賒。",
      "一聲來枕上，孤客在天涯。",
      "木末風微動，窗前月漸斜。",
      "暗牽詩思苦，不獨落梅花。"
    ]
  },
  {
    "uid": "QTS_750_018_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "送紹明上人之毘陵",
    "poem": [
      "忽起毘陵念，飄然不可留。",
      "聽蟬離古寺，攜錫上扁舟。",
      "月出沙汀冷，風高葦㟁秋。",
      "回期端的否，千里路悠悠。"
    ]
  },
  {
    "uid": "QTS_750_019_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "再到山陽尋故人不遇二首 其一",
    "poem": [
      "維舟登野㟁，因訪故人居。",
      "亂後知何處，荊榛匝弊廬。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_750_019_02",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "再到山陽尋故人不遇二首 其二",
    "poem": [
      "欲問當年事，耕人都不知。",
      "空餘堤上柳，依舊自垂絲。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_750_020_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "寄廬山簡寂觀重道者",
    "poem": [
      "憶昔採芝廬岳頂，清宮常接絳霄人。",
      "玉書閑展石樓曉，瑤瑟醉彈琪樹春。",
      "惟恨仙桃遲結實，不憂滄海易成塵。",
      "似醒一夢歸凡世，空向彤霞寄夢頻。"
    ]
  },
  {
    "uid": "QTS_750_021_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "思湓渚舊居",
    "poem": [
      "昔歲曾居湓水頭，草堂吟嘯興何幽。",
      "迎僧常踏竹間蘚，愛月獨登溪上樓。",
      "寒翠入簷嵐岫暁，冷聲縈枕野泉秋。",
      "從拘宦路無由到，昨夜分明夢去逰。"
    ]
  },
  {
    "uid": "QTS_750_022_01",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "思朐陽春遊感舊寄柴司徒五首 其一",
    "poem": [
      "王孫昔日甚相親，共賞西園正媚春。",
      "醉臥如茵芳草上，覺來花月影籠身。"
    ],
    "part_index": 1,
    "total_parts": 5
  },
  {
    "uid": "QTS_750_022_02",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "思朐陽春遊感舊寄柴司徒五首 其二",
    "poem": [
      "徑鋪芳草正綿綿，藉草傳杯似列仙。",
      "暫輟笙歌且聨句，含毫花下破香牋。"
    ],
    "part_index": 2,
    "total_parts": 5
  },
  {
    "uid": "QTS_750_022_03",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "思朐陽春遊感舊寄柴司徒五首 其三",
    "poem": [
      "南陌風和舞蝶狂，惜春公子戀斜陽。",
      "高歌飲罷將廻轡，衣上花兼百草香。"
    ],
    "part_index": 3,
    "total_parts": 5
  },
  {
    "uid": "QTS_750_022_04",
    "volume": 750,
    "author": {
      "canonical": "李中",
      "recorded": "李中"
    },
    "title": "思朐陽春遊感舊寄柴司徒五首 其四",
    "poem": [
      "春郊飲散暮煙收，卻引絲簧上翠樓。",
      "紅袖歌長金斚亂，銀蟾飛出海東頭。"
    ],
    "part_index": 4,
    "total_parts": 5
  },
  {
    "uid": "QTS_750_022_05",
    "volume": 750,
    "author": {
