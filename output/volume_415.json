      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "歲日贈拒非",
    "poem": [
      "君思曲水嗟身老，我望通州感道窮。",
      "同入新年兩行淚，白頭翁坐說城中。"
    ]
  },
  {
    "uid": "QTS_415_007_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "送盧戡",
    "poem": [
      "紅樹蟬聲滿夕陽，白頭相送倍相傷。",
      "老嗟去日光陰促，病覺今年晝夜長。",
      "顧我親情皆遠道，念君兄弟欲他鄉。",
      "紅旗滿眼襄州路，此別淚流千萬行。"
    ]
  },
  {
    "uid": "QTS_415_008_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "雨聲",
    "poem": [
      "風吹竹葉休還動，雨點荷心暗復明。",
      "曾向西江船上宿，慣聞寒夜滴篷聲。"
    ]
  },
  {
    "uid": "QTS_415_009_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "奉和滎陽公離筵作",
    "poem": [
      "南郡生徒辭絳帳，東山妓樂擁油旌。",
      "鈞天排比簫韶待，猶顧人間有別情。"
    ]
  },
  {
    "uid": "QTS_415_010_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "嘉陵水",
    "poem": [
      "古時應是山頭水，自古流來江路深。",
      "若使江流會人意，也應知我遠來心。"
    ]
  },
  {
    "uid": "QTS_415_011_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "閬州開元寺壁題樂天詩",
    "poem": [
      "憶君無計寫君詩，寫盡千行說向誰。",
      "題在閬州東寺壁，幾時知是見君時。"
    ]
  },
  {
    "uid": "QTS_415_012_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "憑李忠州寄書樂天",
    "poem": [
      "萬里寄書將出峽，卻憑巫峽寄江州。",
      "傷心最是江頭月，莫把書將上庾樓。"
    ]
  },
  {
    "uid": "QTS_415_013_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "得樂天書",
    "poem": [
      "遠信入門先有淚，妻驚女哭問何如。",
      "尋常不省曾如此，應是江州司馬書。"
    ]
  },
  {
    "uid": "QTS_415_014_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "寄樂天",
    "poem": [
      "無身尚擬魂相就，身在那無夢往還。",
      "直到他生亦相覓，不能空記樹中環。"
    ]
  },
  {
    "uid": "QTS_415_015_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "酬知退",
    "poem": [
      "終須修到無修處，聞盡聲聞始不聞。",
      "莫著妄心銷彼我，我心無我亦無君。"
    ]
  },
  {
    "uid": "QTS_415_016_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "通州",
    "poem": [
      "平生欲得山中住，天與通州繞郡山。",
      "睡到日西無一事，月儲三萬買教閑。"
    ]
  },
  {
    "uid": "QTS_415_017_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "酬樂天書後三韻",
    "poem": [
      "今日廬峰霞繞寺，昔時鸞殿鳳回書。",
      "兩封相去八年後，一種俱雲五夜初。",
      "漸覺此生都是夢，不能將淚滴雙魚。"
    ]
  },
  {
    "uid": "QTS_415_018_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "相憶淚",
    "poem": [
      "西江流水到江州，聞道分成九道流。",
      "我滴兩行相憶淚，遣君何處遣人求。",
      "除非入海無由住，縱使逢灘未擬休。",
      "會向伍員潮上見，氣充頑石報心仇。"
    ]
  },
  {
    "uid": "QTS_415_019_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "喜李十一景信到",
    "poem": [
      "何事相逢翻有淚，念君緣我到通州。",
      "留君剩住君須住，我不自由君自由。"
    ]
  },
  {
    "uid": "QTS_415_020_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "與李十一夜飲",
    "poem": [
      "寒夜燈前賴酒壺，與君相對興猶孤。",
      "忠州刺史應閑臥，江水猿聲睡得無。"
    ]
  },
  {
    "uid": "QTS_415_021_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "贈李十一",
    "poem": [
      "淮水連年起戰塵，油旌三換一何頻。",
      "共君前後俱從事，羞見功名與別人。"
    ]
  },
  {
    "uid": "QTS_415_022_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "寒食日",
    "poem": [
      "今年寒食好風流，此日一家同出遊。",
      "碧水青山無限思，莫將心道是涪州。"
    ]
  },
  {
    "uid": "QTS_415_023_01",
    "volume": 415,
    "author": {
