    },
    "title": "三兄以白角巾寄遺，髪不勝冠，因有感歎",
    "poem": [
      "三兄以白角巾寄遺，",
      "髪不勝冠，",
      "因有感歎"
    ]
  },
  {
    "uid": "QTS_415_024_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "別李十一五絕",
    "poem": [
      "巴南分與親情別，不料與君床並頭。",
      "為我遠來休悵望，折君災難是通州。",
      "京城每與閒人別，猶自傷心與白頭。",
      "今日別君心更苦，別君緣是在通州。",
      "萬里尚能來遠道，一程那忍便分頭。",
      "鳥籠猿檻君應會，十步向前非我州。",
      "來時見我江南岸，今日送君江上頭。",
      "別後料添新夢寐，虎驚蛇伏是通州。",
      "聞君欲去潛銷骨，一夜暗添新白頭。",
      "明朝別後應腸斷，獨棹破船歸到州。"
    ]
  },
  {
    "uid": "QTS_415_025_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "酬樂天醉別",
    "poem": [
      "前回一去五年別，此別又知何日回。",
      "好住樂天休悵望，匹如元不到京來。"
    ]
  },
  {
    "uid": "QTS_415_026_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "酬樂天雨後見憶",
    "poem": [
      "雨滑危梁性命愁，差池一步一生休。",
      "黃泉便是通州郡，漸入深泥漸到州。"
    ]
  },
  {
    "uid": "QTS_415_027_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "和樂天過秘閣書省舊廳",
    "poem": [
      "聞君西省重徘徊，秘閣書房次第開。",
      "壁記欲題三漏合，吏人驚問十年來。",
      "經排蠹簡憐初校，芸長陳根識舊栽。",
      "司馬見詩心最苦，滿身蚊蚋哭煙埃。"
    ]
  },
  {
    "uid": "QTS_415_028_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "和樂天贈楊秘書",
    "poem": [
      "舊與楊郎在帝城，搜天斡地覓詩情。",
      "曾因並句甘稱小，不為論年便喚兄。",
      "刮骨直穿由苦鬥，夢腸翻出暫閑行。",
      "因君投贈還相和，老去那能競底名。"
    ]
  },
  {
    "uid": "QTS_415_029_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "和樂天題王家亭子",
    "poem": [
      "風吹筍籜飄紅砌，雨打桐花盡綠莎。",
      "都大資人無暇日，泛池全少買池多。"
    ]
  },
  {
    "uid": "QTS_415_030_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "酬樂天頻夢微之",
    "poem": [
      "山水萬重書斷絕，念君憐我夢相聞。",
      "我今因病魂顛倒，惟夢閒人不夢君！"
    ]
  },
  {
    "uid": "QTS_415_031_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "琵琶",
    "poem": [
      "學語胡兒撼玉玲，甘州破裏最星星。",
      "使君自恨常多事，不得工夫夜夜聽。"
    ]
  },
  {
    "uid": "QTS_415_032_01",
    "volume": 415,
    "author": {
      "canonical": "元稹",
      "recorded": "元稹",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yuan Zhen",
      "wikidata_id": "Q468709"
    },
    "title": "春詞",
    "poem": [
      "山翠湖光似欲流，蜂聲鳥思卻堪愁。",
      "西施顏色今何在，但看春風百草頭。"
    ]
  }
