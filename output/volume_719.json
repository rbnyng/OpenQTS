[
  {
    "uid": "QTS_719_001_01",
    "volume": 719,
    "author": {
      "canonical": "路德延",
      "recorded": "路德延"
    },
    "title": "芭蕉",
    "poem": [
      "一種靈苗異，天然體性虛。",
      "葉如斜界紙，心似倒抽書。"
    ],
    "notes": [
      {
        "content": "數嵗時作，傳於都下。",
        "context": "芭蕉",
        "original_title": "芭蕉〈數嵗時作，傳於都下。〉"
      }
    ]
  },
  {
    "uid": "QTS_719_002_01",
    "volume": 719,
    "author": {
      "canonical": "路德延",
      "recorded": "路德延"
    },
    "title": "感舊詩",
    "poem": [
      "初騎竹馬詠芭蕉，嘗忝名卿誦滿朝。",
      "五字便容趨絳帳，一枝尋許折丹霄。",
      "豈知流落萍蓬遠，不覺推遷嵗月遙。",
      "國境未安身未立，至今顏巷守簞瓢。"
    ]
  },
  {
    "uid": "QTS_719_003_01",
    "volume": 719,
    "author": {
      "canonical": "路德延",
      "recorded": "路德延"
    },
    "title": "小兒詩",
    "poem": [
      "情態任天然，桃紅兩頰鮮。",
      "乍行人共看，初語客多憐。",
      "臂膊肥如瓠，肌膚軟勝綿。",
      "長頭纔覆額，分角漸垂肩。",
      "散誕無塵慮，逍遙占地仙。",
      "排衙朱閣上，喝道畫堂前。",
      "合調歌楊柳，齊聲踏採蓮。",
      "走隄行細雨，奔巷趁輕煙。",
      "嫩竹乘為馬，新蒲折作鞭。",
      "鶯雛金鏇繫，貓子綵絲牽。",
      "擁鶴歸晴島，驅鵝入暖泉。",
      "楊花爭弄雪，榆葉共收錢。",
      "錫鏡當胸掛，銀珠對耳懸。",
      "頭依蒼鶻裹，袖學柘枝揎。",
      "酒殢丹砂暖，茶催小玉煎。",
      "頻邀籌箸掙，時乞繡鍼穿。",
      "寶篋拏紅豆，妝奩拾翠鈿。",
      "戲袍披按褥，劣帽戴靴氊。",
      "展畫趨三聖，開屏笑七賢。",
      "貯懷青杏小，垂額緑荷圓。",
      "驚滴霑羅淚，嬌流汚錦涎。",
      "倦書饒婭奼，憎藥巧遷延。",
      "弄帳鸞綃映，藏衾鳳綺纏。",
      "指敲迎使鼓，筋撥賽神弦。",
      "簾拂魚鉤動，箏推雁柱偏。",
      "碁圖添路畫，笛管欠聲鐫。",
      "惱客初酣睡，驚僧半入禪。",
      "尋蛛窮屋瓦，探雀遍樓椽。",
      "拋果忙開口，藏鉤亂出拳。",
      "夜分圍榾柮，朝聚打鞦韆。",
      "折竹裝泥燕，添絲放紙鳶。",
      "互誇輪水碓，相教放風旋。",
      "旗小裁紅絹，書幽截碧牋。",
      "遠鋪張鴿網，低控射蠅弦。",
      "詀語時時道，謠歌處處傳。",
      "匿牕眉乍曲，遮路臂相連。",
      "鬬草當春逕，爭毬出晚田。",
      "柳傍慵獨坐，花底困橫眠。",
      "等鵲前籬畔，聽蛩伏砌邊。",
      "傍枝粘舞蝶，隈樹捉鳴蟬。",
      "平島誇趫上，層崖逞捷緣。",
      "嫩苔車跡小，深雪履痕全。",
      "競指雲生岫，齊呼月上天。",
      "蟻窠尋逕斸，蜂穴遶階填。",
      "樵唱回深嶺，牛歌下遠川。",
      "壘柴為屋木，和土作盤筵。",
      "險砌高臺石，危跳峻塔磚。",
      "忽陞鄰舍樹，偷上後池船。",
      "項橐稱師日，甘羅作相年。",
      "明時方任德，勸爾減狂顛。"
    ],
