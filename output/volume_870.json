  {
    "uid": "QTS_870_017_01",
    "volume": 870,
    "author": {
      "canonical": "章孝標",
      "recorded": "章孝標",
      "gender": "male",
      "english_name": "Zhang Xiaobiao",
      "wikidata_id": "Q30017996"
    },
    "title": "及第後寄李紳",
    "poem": [
      "及第全勝十政官，金鞍鍍了出長安。",
      "馬頭漸入揚州郭，為報時人洗眼看。"
    ]
  },
  {
    "uid": "QTS_870_018_01",
    "volume": 870,
    "author": {
      "canonical": "李紳",
      "recorded": "李紳",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Li Shen",
      "wikidata_id": "Q6539062"
    },
    "title": "答章孝標",
    "poem": [
      "假金只用真金鍍，若是真金不鍍金。",
      "十載長安得一第，何須空腹用高心。"
    ]
  },
  {
    "uid": "QTS_870_019_01",
    "volume": 870,
    "author": {
      "canonical": "楊汝士",
      "recorded": "楊汝士",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Yang Rushi",
      "wikidata_id": "Q10360753"
    },
    "title": "戲柳棠",
    "poem": [
      "文章漫道能吞鳳，杯酒何曾解吃魚。",
      "今日梓州張社會，應須遭這老尚書。"
    ]
  },
  {
    "uid": "QTS_870_020_01",
    "volume": 870,
    "author": {
      "canonical": "柳棠",
      "recorded": "柳棠",
      "gender": "male",
      "english_name": "Liu Tang",
      "wikidata_id": "Q45569645"
    },
    "title": "答楊尚書",
    "poem": [
      "未向燕台逢厚禮，幸因社會接餘歡。",
      "一魚吃了終無愧，鯤化為鵬也不難。"
    ]
  },
  {
    "uid": "QTS_870_021_01",
    "volume": 870,
    "author": {
      "canonical": "柳棠",
      "recorded": "柳棠",
      "gender": "male",
      "english_name": "Liu Tang",
      "wikidata_id": "Q45569645"
    },
    "title": "又忤楊尚書詩",
    "poem": [
      "莫言名位未相儔，風月何曾阻獻酬。",
      "前輩不須輕後輩，靖安今日在衡州。"
    ]
  },
  {
    "uid": "QTS_870_022_01",
    "volume": 870,
    "author": {
      "canonical": "朱澤",
      "recorded": "朱澤"
    },
    "title": "嘲郭凝素",
    "poem": [
      "三春桃李本無言，苦被殘陽鳥雀喧。",
      "借問東鄰效西子，何如郭素擬王軒。"
    ]
  },
  {
    "uid": "QTS_870_023_01",
    "volume": 870,
    "author": {
      "canonical": "鄭光業",
      "recorded": "鄭光業"
    },
    "title": "紀中表試案",
    "poem": [
      "新糊案子，其白如銀。",
      "入試出試，千春萬春。"
    ]
  },
  {
    "uid": "QTS_870_024_01",
    "volume": 870,
    "author": {
      "canonical": "鄭愚",
      "recorded": "鄭愚",
      "gender": "male",
      "wikidata_id": "Q18906136"
    },
    "title": "醉題廣州使院",
    "poem": [
      "數年百姓受饑荒，太守貪殘似虎狼。",
      "今日海隅魚米賤，大須慚愧石榴黃。"
    ]
  },
  {
    "uid": "QTS_870_025_01",
    "volume": 870,
    "author": {
      "canonical": "鄭愚",
      "recorded": "鄭愚",
      "gender": "male",
      "wikidata_id": "Q18906136"
    },
    "title": "擬權龍褒體贈鄠縣李令及寄朝右",
    "poem": [
      "鄠縣李長官，橫琴膝上弄。",
      "不聞有政聲，但見手子動。"
    ]
  },
  {
    "uid": "QTS_870_026_01",
    "volume": 870,
    "author": {
      "canonical": "鄭仁表",
      "recorded": "鄭仁表",
      "gender": "male",
      "english_name": "Zheng Renbiao",
      "wikidata_id": "Q18905976"
    },
    "title": "題滄浪峽榜",
    "poem": [
      "分峽東西路正長，行人名利火然湯。",
      "路傍著板滄浪峽，真是將閑攪撩忙。"
    ]
  },
  {
    "uid": "QTS_870_027_01",
    "volume": 870,
    "author": {
      "canonical": "胡曾",
      "recorded": "胡曾",
      "gender": "male",
      "english_name": "Hu Ceng",
      "wikidata_id": "Q18906310"
    },
    "title": "戲妻族語不正",
    "poem": [
      "呼十卻為石，喚針將作真。",
      "忽然雲雨至，總道是天因。"
    ]
  },
  {
    "uid": "QTS_870_028_01",
    "volume": 870,
    "author": {
      "canonical": "李昌符",
      "recorded": "李昌符"
    },
    "title": "婢僕詩",
    "poem": [
      "春娘愛上酒家樓，不怕歸遲總不憂。",
      "推道那家娘子臥，且留教住待梳頭。",
      "不論秋菊與春花，個個能噇空腹茶。",
      "無事莫教頻入庫，一名閑物要些些。"
    ]
  },
  {
    "uid": "QTS_870_029_01",
    "volume": 870,
    "author": {
      "canonical": "孫子多",
      "recorded": "孫子多"
    },
    "title": "嘲鄭傪妓",
    "poem": [
      "相公經文複經武，常侍好今兼好古。",
      "昔人曾聞阿武婆，今日親見阿婆舞。"
    ]
  },
  {
    "uid": "QTS_870_030_01",
    "volume": 870,
    "author": {
      "canonical": "薛能",
      "recorded": "薛能",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Xue Neng",
      "wikidata_id": "Q15941967"
    },
    "title": "嘲趙璘",
    "poem": [
      "巡關每傍摴蒲局，望月還登乞巧樓。",
      "第一莫教嬌太過，緣人衣帶上人頭。",
      "不知原在鞍轎裏，將謂空馱席帽歸。",
      "火爐床上平身立，便與夫人作鏡臺。"
    ]
  },
  {
    "uid": "QTS_870_031_01",
    "volume": 870,
    "author": {
      "canonical": "薛能",
      "recorded": "薛能",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Xue Neng",
      "wikidata_id": "Q15941967"
    },
    "title": "口號",
    "poem": [
      "素脊鳴秋杖，烏靴響暮廳。",
      "刃飛三尺雪，白日落文星。"
    ],
    "notes": [
      {
