        "content": "秦宗權",
        "context": "刃飛三尺雪，白日落文星。"
      }
    ]
  },
  {
    "uid": "QTS_870_032_01",
    "volume": 870,
    "author": {
      "canonical": "皮日休",
      "recorded": "皮日休",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Pi Rixiu",
      "wikidata_id": "Q855797"
    },
    "title": "嘲歸仁紹龜詩",
    "poem": [
      "硬骨殘形知幾秋，屍骸終是不風流。",
      "頑皮死後鑽須遍，都為平生不出頭。"
    ]
  },
  {
    "uid": "QTS_870_033_01",
    "volume": 870,
    "author": {
      "canonical": "皮日休",
      "recorded": "皮日休",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Pi Rixiu",
      "wikidata_id": "Q855797"
    },
    "title": "詠螃蟹呈浙西從事",
    "poem": [
      "未游滄海早知名，有骨還從肉上生。",
      "莫道無心畏雷電，海龍王處也橫行。"
    ]
  },
  {
    "uid": "QTS_870_034_01",
    "volume": 870,
    "author": {
      "canonical": "鄭綮",
      "recorded": "鄭綮",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Zheng Qi",
      "wikidata_id": "Q8070731"
    },
    "title": "題中書壁",
    "poem": [
      "側坡蛆蜫蜦，蟻子競來拖。",
      "一朝白雨中，無鈍無嘍羅。"
    ]
  },
  {
    "uid": "QTS_870_035_01",
    "volume": 870,
    "author": {
      "canonical": "鄭綮",
      "recorded": "鄭綮",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Zheng Qi",
      "wikidata_id": "Q8070731"
    },
    "title": "別廬州郡人",
    "poem": [
      "唯有兩行公廨淚，一時灑向渡頭風。"
    ]
  },
  {
    "uid": "QTS_870_036_01",
    "volume": 870,
    "author": {
      "canonical": "徐彥若",
      "recorded": "徐彥若"
    },
    "title": "戲答成汭",
    "poem": [
      "南海黃茅瘴，不死成和尚。"
    ]
  },
  {
    "uid": "QTS_870_037_01",
    "volume": 870,
    "author": {
      "canonical": "崔立言",
      "recorded": "崔立言"
    },
    "title": "醉中謔浙江廉使",
    "poem": [
      "山夫留意向丹梯，連帥邀來出藥畦。",
      "常見浙東誇鏡水，鏡湖元在浙江西。"
    ]
  },
  {
    "uid": "QTS_870_038_01",
    "volume": 870,
    "author": {
      "canonical": "韋鵬翼",
      "recorded": "韋鵬翼"
    },
    "title": "戲題盱眙邵明府壁",
    "poem": [
      "豈肯閑尋竹徑行，卻嫌絲管好蛙聲。",
      "自從煮鶴燒琴後，背卻青山臥月明。"
    ]
  },
  {
    "uid": "QTS_870_039_01",
    "volume": 870,
    "author": {
      "canonical": "姚嶸",
      "recorded": "姚嶸"
    },
    "title": "題大樑臨汴驛",
    "poem": [
      "近日侯門不重才，莫將文藝擬為媒。",
      "相逢若要如膠漆，不是紅妝即撥灰。"
    ]
  },
  {
    "uid": "QTS_870_040_01",
    "volume": 870,
    "author": {
      "canonical": "李日新",
      "recorded": "李日新"
    },
    "title": "題仙娥驛",
    "poem": [
      "商山食店大悠悠，陳鶡䭔鑼古䭃頭。",
      "更有台中牛肉炙，尚盤數臠紫光球。"
    ]
  },
  {
    "uid": "QTS_870_041_01",
    "volume": 870,
    "author": {
      "canonical": "柳逢",
      "recorded": "柳逢"
    },
    "title": "嘲染家",
    "poem": [
      "紫綠終朝染，因何不識非。",
      "莆田竹木貴，背負十柴歸。"
    ]
  },
  {
    "uid": "QTS_870_042_01",
    "volume": 870,
    "author": {
      "canonical": "黎瓘",
      "recorded": "黎瓘"
    },
    "title": "贈漳州崔使君鄉飲翻韻詩",
    "poem": [
      "慣向溪邊折柳楊，因循行客到州漳。",
      "無端觸忤王衙押，不得今朝看飲鄉。"
    ]
  },
  {
    "uid": "QTS_870_043_01",
    "volume": 870,
    "author": {
      "canonical": "張保胤",
      "recorded": "張保胤"
    },
    "title": "示妓榜子",
    "poem": [
      "綠羅裙下標三棒，紅粉腮邊淚兩行。",
      "叉手向前咨大使，這回不敢惱兒郎。"
    ]
  },
  {
    "uid": "QTS_870_044_01",
    "volume": 870,
    "author": {
      "canonical": "張保胤",
      "recorded": "張保胤"
    },
    "title": "又留別同院",
    "poem": [
      "憶昔當年富貴時，如今頭腦尚依稀。",
      "布袍破後思宮內，錦袴穿時憶禦衣。",
      "鶻子背鑽高力士，嬋娟翻畫太真妃。",
      "如今憔悴離南海，恰似當時幸蜀時。"
    ]
  },
  {
    "uid": "QTS_870_045_01",
    "volume": 870,
    "author": {
      "canonical": "陸岩夢",
      "recorded": "陸岩夢"
    },
    "title": "桂州筵上贈胡予女",
    "poem": [
      "自道風流不可攀，卻堪蹙額更頹顏。",
      "眼睛深卻湘江水，鼻孔高於華嶽山。",
      "舞態固難居掌上，歌聲應不繞梁間。",
      "孟陽死後欲千載，猶在佳人覓往還。"
    ]
  },
  {
    "uid": "QTS_870_046_01",
    "volume": 870,
    "author": {
      "canonical": "李都",
      "recorded": "李都"
    },
    "title": "戲答朝士",
    "poem": [
      "華緘千里到荊門，章草縱橫任意論。",
      "應笑鐘張虛用力，卻教羲獻枉勞魂。",
      "惟堪愛惜為珍寶，不敢傳留誤子孫。",
      "深荷故人相厚處，天行時氣許教吞。"
    ]
  },
  {
    "uid": "QTS_870_047_01",
    "volume": 870,
    "author": {
      "canonical": "荊人",
      "recorded": "荊人"
    },
    "title": "嘲僧惟恭",
    "poem": [
      "靈巋作盡業，惟恭繼其跡。",
      "地獄千萬重，莫厭排頭入。"
    ]
  },
  {
    "uid": "QTS_870_048_01",
    "volume": 870,
    "author": {
      "canonical": "馮道幕客",
      "recorded": "馮道幕客"
    },
    "title": "題酒戶修孔廟狀",
    "poem": [
      "槐影參差覆杏壇，儒門子弟盡高官。",
      "卻教酒戶重修廟，覓我慚惶也不難。"
    ]
  },
  {
    "uid": "QTS_870_049_01",
    "volume": 870,
    "author": {
      "canonical": "李花開",
      "recorded": "李花開"
    },
    "title": "孔廟口號",
    "poem": [
      "破落三間屋，蕭條一旅人。",
      "不知負何事，生死厄於陳。"
    ]
  },
  {
    "uid": "QTS_870_050_01",
    "volume": 870,
    "author": {
      "canonical": "馮暉",
      "recorded": "馮暉"
    },
    "title": "答妻",
    "poem": [
      "休說辦不辦，且看甕裏飛出雁。"
    ]
  },
  {
    "uid": "QTS_870_051_01",
    "volume": 870,
    "author": {
      "canonical": "李濤",
      "recorded": "李濤",
      "gender": "male",
      "period": "Five Dynasties / Song",
      "english_name": "Li Tao",
      "wikidata_id": "Q11097334"
    },
    "title": "題僧院",
    "poem": [
      "走卻坐禪客，移將不動尊。",
      "世間顛倒事，八萬四千門。"
    ]
  },
  {
    "uid": "QTS_870_052_01",
    "volume": 870,
    "author": {
      "canonical": "楊薴蘿",
      "recorded": "楊薴蘿"
    },
    "title": "詠垂絲蜘蛛嘲雲辨僧",
    "poem": [
      "吃得肚嬰撐，尋思繞寺行。",
      "空中設羅網，只待殺眾生。"
    ]
  },
  {
    "uid": "QTS_870_053_01",
    "volume": 870,
    "author": {
      "canonical": "馮涓",
      "recorded": "馮涓",
      "gender": "male",
      "wikidata_id": "Q18909215"
    },
    "title": "自嘲絕句",
    "poem": [
      "取水郎中何日了，破柴員外幾時休。",
      "早知蜀地區娵與，悔不長安大比丘。"
    ]
  },
  {
    "uid": "QTS_870_054_01",
    "volume": 870,
    "author": {
      "canonical": "盧延讓",
      "recorded": "盧延讓",
      "gender": "male",
      "english_name": "Lu Yanrang",
      "wikidata_id": "Q22078906"
    },
    "title": "哭亡將詩",
    "poem": [
      "自是硇砂發，非幹駭石傷。",
      "牒高身上職，碗大背邊創。"
    ]
  },
  {
    "uid": "QTS_870_055_01",
    "volume": 870,
    "author": {
      "canonical": "蔣貽恭",
      "recorded": "蔣貽恭"
    },
    "title": "詠王給事",
    "poem": [
      "厥父元非道郡奴，允光何事太侏儒。",
      "可中與個皮褌著，擎得天王左腳無。"
    ]
  },
  {
    "uid": "QTS_870_056_01",
    "volume": 870,
    "author": {
      "canonical": "蔣貽恭",
      "recorded": "蔣貽恭"
    },
    "title": "詠金剛",
    "poem": [
      "揚眉鬥目惡精神，捏合將來恰似真。",
      "剛被時流借拳勢，不知身自是泥人。"
    ]
  },
  {
    "uid": "QTS_870_057_01",
    "volume": 870,
    "author": {
      "canonical": "蔣貽恭",
      "recorded": "蔣貽恭"
    },
    "title": "詠傴背子",
    "poem": [
      "出得門來背拄天，同行難可與差肩。",
      "若教倚向閑窗下，恰似箜篌不著弦。"
    ]
  },
  {
    "uid": "QTS_870_058_01",
    "volume": 870,
    "author": {
      "canonical": "蔣貽恭",
      "recorded": "蔣貽恭"
    },
    "title": "詠安仁宰搗蒜",
    "poem": [
      "安仁縣令好誅求，百姓脂膏滿面流。",
      "半破磁缸成醋酒，死牛腸肚作饅頭。",
      "帳生歲取餐三頓，鄉老盤庚犯五甌。",
      "半醉半醒齊出縣，共傷塗炭不勝愁。"
    ]
  },
  {
    "uid": "QTS_870_059_01",
    "volume": 870,
    "author": {
      "canonical": "蔣貽恭",
      "recorded": "蔣貽恭"
    },
    "title": "五門街望有題",
    "poem": [
      "我皇開國十餘年，一輩超升炙手歡。",
      "閑向五門樓下望，衙官騎馬使衙官。"
    ]
  },
  {
    "uid": "QTS_870_060_01",
    "volume": 870,
    "author": {
      "canonical": "蔣貽恭",
      "recorded": "蔣貽恭"
    },
    "title": "謝郎中惠茶",
    "poem": [
      "三斤綠茗賜貽恭，一種頒沾事不同。",
      "想料腸懷無答處，披毛戴角謝郎中。"
    ]
  },
  {
    "uid": "QTS_870_061_01",
    "volume": 870,
    "author": {
      "canonical": "蔣貽恭",
      "recorded": "蔣貽恭"
    },
    "title": "詠蝦蟆",
    "poem": [
      "坐臥兼行總一般，向人努眼太無端。",
      "欲知自己形骸小，試就蹄涔照影看。"
    ]
  },
  {
    "uid": "QTS_870_062_01",
    "volume": 870,
    "author": {
      "canonical": "蔣貽恭",
      "recorded": "蔣貽恭"
    },
    "title": "住名山日陳情上府主高太保",
    "poem": [
      "名山主簿實堪愁，難咬他家大骨頭。",
      "米納功南錢納府，只看江面水東流。"
    ]
  },
  {
    "uid": "QTS_870_063_01",
    "volume": 870,
    "author": {
      "canonical": "李貞白",
      "recorded": "李貞白"
    },
    "title": "詠刺蝟",
    "poem": [
      "行似針氈動，臥若栗球圓。",
      "莫欺如此大，誰敢便行拳。"
    ]
  },
  {
    "uid": "QTS_870_064_01",
    "volume": 870,
    "author": {
      "canonical": "李貞白",
      "recorded": "李貞白"
    },
    "title": "謁貴公子，不禮，書格子屏風",
    "poem": [
      "道格何曾格，言糊又不糊。",
      "渾身總是眼，還解識人無。"
    ]
  },
  {
    "uid": "QTS_870_065_01",
    "volume": 870,
    "author": {
      "canonical": "李貞白",
      "recorded": "李貞白"
    },
    "title": "詠月",
    "poem": [
      "當塗當塗見，蕪湖蕪湖見。",
      "八月十五夜，一似沒柄扇。"
    ]
  },
  {
    "uid": "QTS_870_066_01",
    "volume": 870,
    "author": {
      "canonical": "李貞白",
      "recorded": "李貞白"
    },
    "title": "詠狗蚤",
    "poem": [
      "與虱都來不較多，㩧挑筋斗太嘍羅。",
      "忽然管著一籃子，有甚心情那你何。"
    ]
  },
  {
    "uid": "QTS_870_067_01",
    "volume": 870,
    "author": {
      "canonical": "李貞白",
      "recorded": "李貞白"
    },
    "title": "詠罌粟子",
    "poem": [
      "倒排雙陸子，希插碧牙籌。",
      "既似犧牛乳，又如鈴馬兜。",
      "鼓捶並瀑箭，直是有來由。"
    ]
  },
  {
    "uid": "QTS_870_068_01",
    "volume": 870,
    "author": {
      "canonical": "李貞白",
      "recorded": "李貞白"
    },
    "title": "詠蟹",
    "poem": [
      "蟬眼龜形腳似蛛，未曾正面向人趨。",
      "如今飣在盤筵上，得似江湖亂走無。"
    ]
  },
  {
    "uid": "QTS_870_069_01",
    "volume": 870,
    "author": {
      "canonical": "郫城令",
      "recorded": "郫城令"
    },
    "title": "示女詩",
    "poem": [
      "深宮富貴事風流，莫忘生身老骨頭。",
      "因與太師歡笑處，為吾方便覓彭州。"
    ]
  },
  {
    "uid": "QTS_870_070_01",
    "volume": 870,
    "author": {
      "canonical": "李令",
      "recorded": "李令"
    },
    "title": "寄女",
    "poem": [
      "有人教我向衡陽，一度思歸欲斷腸。",
      "為報豔妻兼少女，與吾覓取朗州場。"
    ]
  },
  {
    "uid": "QTS_870_071_01",
    "volume": 870,
    "author": {
      "canonical": "太守(失其姓名)",
      "recorded": "太守(失其姓名)",
      "gender": "male"
    },
    "title": "諷劉炎索賄詩",
    "poem": [
      "未到桃源時，長憶出家景。",
      "及到桃源了，還似鑒中影。"
    ]
  },
  {
    "uid": "QTS_870_072_01",
    "volume": 870,
    "author": {
      "canonical": "劉炎",
      "recorded": "劉炎"
    },
    "title": "被按自悔詩",
    "poem": [
      "早知太守如狼虎，獵取膏粱以啖之。"
    ]
  }
]