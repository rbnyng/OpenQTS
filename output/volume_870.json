[
  {
    "uid": "QTS_870_001_01",
    "volume": 870,
    "author": {
      "canonical": "高亭",
      "recorded": "高亭"
    },
    "title": "譏元載詩",
    "poem": [
      "上元官吏務剝削，江淮之人皆白著。"
    ]
  },
  {
    "uid": "QTS_870_002_01",
    "volume": 870,
    "author": {
      "canonical": "賀遂涉",
      "recorded": "賀遂涉"
    },
    "title": "嘲趙謙光",
    "poem": [
      "員外由來美，郎中望亦優。",
      "寧知粉署裏，翻作土山頭。"
    ]
  },
  {
    "uid": "QTS_870_003_01",
    "volume": 870,
    "author": {
      "canonical": "趙謙光",
      "recorded": "趙謙光"
    },
    "title": "答賀遂涉",
    "poem": [
      "錦帳隨情設，金爐任意熏。",
      "唯愁員外置，不應列星文。"
    ]
  },
  {
    "uid": "QTS_870_004_01",
    "volume": 870,
    "author": {
      "canonical": "孔顒",
      "recorded": "孔顒"
    },
    "title": "上浙東孟尚書",
    "poem": [
      "有個將軍不得名，唯教健卒喝書生。",
      "尚書近日清如鏡，天子官街不許行。"
    ]
  },
  {
    "uid": "QTS_870_005_01",
    "volume": 870,
    "author": {
      "canonical": "呂溫",
      "recorded": "呂溫",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Lü Wen",
      "wikidata_id": "Q10919969"
    },
    "title": "嘲柳州柳子厚",
    "poem": [
      "柳州柳刺史，種柳柳江邊。",
      "柳管依然在，千秋柳拂天。"
    ]
  },
  {
    "uid": "QTS_870_006_01",
    "volume": 870,
    "author": {
      "canonical": "呂溫",
      "recorded": "呂溫",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Lü Wen",
      "wikidata_id": "Q10919969"
    },
    "title": "嘲黔南觀察南卓",
    "poem": [
      "終南南太守，南郡在雲南。",
      "閑向南亭醉，南風變俗談。"
    ]
  },
  {
    "uid": "QTS_870_007_01",
    "volume": 870,
    "author": {
      "canonical": "張祜",
      "recorded": "張祜",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Zhang Hu",
      "wikidata_id": "Q11067506"
    },
    "title": "戲簡朱壇詩",
    "poem": [
      "昔人有玉碗，擊之千里鳴。",
      "今日睹斯文，碗有當時聲。"
    ]
  },
  {
    "uid": "QTS_870_008_01",
    "volume": 870,
    "author": {
      "canonical": "張祜",
      "recorded": "張祜",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Zhang Hu",
      "wikidata_id": "Q11067506"
    },
    "title": "戲顏郎官騎獵詩",
    "poem": [
      "忽聞射獵出軍城，人著戎衣馬帶纓。",
      "倒把角弓呈一箭，滿山狐兔當頭行。"
    ]
  },
  {
    "uid": "QTS_870_009_01",
    "volume": 870,
    "author": {
      "canonical": "朱沖和",
      "recorded": "朱沖和"
    },
    "title": "嘲張祜",
    "poem": [
      "白在東都元已薨，蘭台鳳閣少人登。",
      "冬瓜堰下逢張祜，牛屎堆邊說我能。"
    ]
  },
  {
    "uid": "QTS_870_010_01",
    "volume": 870,
    "author": {
      "canonical": "崔涯",
      "recorded": "崔涯"
    },
    "title": "嘲妓",
    "poem": [
      "雖得蘇方木，猶貪玳瑁皮。",
      "懷胎十個月，生下昆侖兒。",
      "布袍披襖火燒氈，紙補箜篌麻接弦。",
      "更著一雙皮屐子，紇梯紇榻出門前。"
    ]
  },
  {
    "uid": "QTS_870_011_01",
    "volume": 870,
    "author": {
      "canonical": "崔涯",
      "recorded": "崔涯"
    },
    "title": "嘲李端端",
    "poem": [
      "黃昏不語不知行，鼻似煙窗耳似鐺。",
      "獨把象牙梳插鬢，昆侖山上月初明。",
      "覓得黃騮鞁繡鞍，善和坊裏取端端。",
      "揚州近日渾成差，一朵能行白牡丹。"
    ]
  },
  {
    "uid": "QTS_870_012_01",
    "volume": 870,
    "author": {
      "canonical": "李宣古",
      "recorded": "李宣古"
    },
    "title": "詠崔雲娘",
    "poem": [
      "何事最堪悲，雲娘只首奇。",
      "瘦拳拋令急，長嘯出歌遲。",
      "只見肩侵鬢，唯憂骨透皮。",
      "不須當戶立，頭上有鍾馗。"
    ]
  },
  {
    "uid": "QTS_870_013_01",
    "volume": 870,
    "author": {
      "canonical": "杜牧",
      "recorded": "杜牧",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Du Mu",
      "wikidata_id": "Q334095"
    },
    "title": "嘲妓",
    "poem": [
      "盤古當時有遠孫，尚令今日逞家門。",
      "一車白土將泥項，十幅紅旗補破褌。",
      "瓦官寺裏逢行跡，華嶽山前見掌痕。",
      "不須惆悵憂難嫁，待與將書問樂坤。"
    ]
  },
  {
    "uid": "QTS_870_014_01",
    "volume": 870,
    "author": {
      "canonical": "盧肇",
      "recorded": "盧肇",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Lu Zhao",
      "wikidata_id": "Q10910112"
    },
    "title": "嘲遊使君",
    "poem": [
      "白帝城頭二月時，忍教清醒看花枝。",
      "莫言世上無袁許，客子由來是相師。"
    ]
  },
  {
    "uid": "QTS_870_015_01",
    "volume": 870,
    "author": {
      "canonical": "韋蟾",
      "recorded": "韋蟾",
      "gender": "male",
      "wikidata_id": "Q18908951"
    },
    "title": "嘲李瑒題名",
    "poem": [
      "渭水秦山照眼明，希仁何事寡詩情。",
      "只因學得虞姬婿，書字才能記姓名。"
    ]
  },
  {
    "uid": "QTS_870_016_01",
    "volume": 870,
    "author": {
      "canonical": "嚴震",
      "recorded": "嚴震",
      "gender": "male",
      "period": "High Tang",
      "english_name": "Yan Zhen",
      "wikidata_id": "Q45491393"
    },
    "title": "聞鹿鳴互謔",
    "poem": [
      "釜戴山中鹿又鳴，",
      "此際多應到表兄。",
      "表兄不是嚴家子，合是三兄與四兄。"
    ],
    "notes": [
