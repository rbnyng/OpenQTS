  {
    "uid": "QTS_272_002_01",
    "volume": 272,
    "author": {
      "canonical": "王鋌",
      "recorded": "王鋌"
    },
    "title": "登越王樓見喬公詩偶題",
    "poem": [
      "雲架重樓出郡城，虹梁雅韻仲宣情。",
      "越王空置千年跡，丞相兼揚萬古名。",
      "過鳥時時衝客會，閑風往往弄江聲。",
      "謬將蹇步尋高躅，魚目驪珠豈繼明。"
    ]
  },
  {
    "uid": "QTS_272_003_01",
    "volume": 272,
    "author": {
      "canonical": "潘炎",
      "recorded": "潘炎",
      "gender": "male",
      "wikidata_id": "Q18907292"
    },
    "title": "清如玉壺冰",
    "poem": [
      "琰玉性惟堅，成壺體更圓。",
      "虛心含景象，應物受寒泉。",
      "溫潤資天質，清貞稟自然。",
      "日融光乍散，雪照色逾鮮。",
      "至鑒功寧宰，無私照豈偏。",
      "明將冰鏡對，白與粉花連。",
      "拂拭終爲美，提攜佇見傳。",
      "勿令毫髪累，遺恨鮑公篇。"
    ]
  },
  {
    "uid": "QTS_272_004_01",
    "volume": 272,
    "author": {
      "canonical": "張叔良",
      "recorded": "張叔良",
      "gender": "male",
      "wikidata_id": "Q18909017"
    },
    "title": "長至日上公獻壽",
    "poem": [
      "鳳闕晴鐘動，雞人曉漏長。",
      "九重初啓鑰，三事正稱觴。",
      "日至龍顏近，天旋聖曆昌。",
      "休光連雪淨，瑞氣雜爐香。",
      "化被君臣洽，恩霑士庶康。",
      "不因稽舊典，誰得紀朝章。"
    ]
  },
  {
    "uid": "QTS_272_005_01",
    "volume": 272,
    "author": {
      "canonical": "呂牧",
      "recorded": "呂牧",
      "gender": "male",
      "english_name": "Lv Mu",
      "wikidata_id": "Q18908201"
    },
    "title": "涇渭揚清濁",
    "poem": [
      "涇渭橫秦野，逶迤近帝城。",
      "二渠通作潤，萬戶映皆清。",
      "明晦看殊色，潺湲聽一聲。",
      "岸虛深草掩，波五曉煙輕。",
      "御獵思投釣，漁歌好濯纓。",
      "合流知禹力，同共到滄瀛。"
    ]
  },
  {
    "uid": "QTS_272_006_01",
    "volume": 272,
    "author": {
      "canonical": "韋夏卿",
      "recorded": "韋夏卿",
      "gender": "male",
      "wikidata_id": "Q18907229"
    },
    "title": "別張賈",
    "poem": [
      "束簡下高閣，買符驅短轅。",
      "故人惜分袂，結念醉芳罇。",
      "切切別思纏，蕭蕭征騎煩。",
      "臨歸無限意，相視却忘言。"
    ]
  },
  {
    "uid": "QTS_272_007_01",
    "volume": 272,
    "author": {
      "canonical": "韋夏卿",
      "recorded": "韋夏卿",
      "gender": "male",
      "wikidata_id": "Q18907229"
    },
    "title": "送顧況歸茅山",
    "poem": [
      "聖代爲遷客，虛皇作近臣。",
      "法尊稱大洞，學淺忝初真。",
      "鸞鳳文章麗，煙霞翰墨新。",
      "羨君尋句曲，白鵠是三神。"
    ]
  },
  {
    "uid": "QTS_272_008_01",
    "volume": 272,
    "author": {
      "canonical": "韋夏卿",
      "recorded": "韋夏卿",
      "gender": "male",
      "wikidata_id": "Q18907229"
    },
    "title": "和丘員外題湛長史舊居",
    "poem": [
      "道勝物能齊，累輕身易退。",
      "苟安一丘上，何必三山外。",
      "雲霞長若綺，松石常如黛。",
      "徒有昔王過，竟遺青史載。",
      "詩因埜寺詠，酒向山椒酹。",
      "異時逢爾知，茲辰駐余斾。"
    ]
  },
  {
    "uid": "QTS_272_009_01",
    "volume": 272,
    "author": {
      "canonical": "綦毋誠",
      "recorded": "綦毋誠"
    },
    "title": "同韋夏卿送顧況歸茅山",
    "poem": [
      "謫宦聞嘗賦，遊仙便作詩。",
      "白銀雙闕戀，青竹一龍騎。",
      "先入茅君洞，旋過葛稚陂。",
      "無然列禦寇，五日有還期。"
    ]
  },
  {
