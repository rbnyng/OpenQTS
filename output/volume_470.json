[
  {
    "uid": "QTS_470_001_01",
    "volume": 470,
    "author": {
      "canonical": "盧殷",
      "recorded": "盧殷"
    },
    "title": "妾換馬",
    "poem": [
      "伴鳳樓中妾，如龍櫪上宛。",
      "同年辭舊寵，異地受新恩。",
      "香閣更衣處，塵蒙噴草痕。",
      "連嘶將忍淚，俱戀主人門。"
    ]
  },
  {
    "uid": "QTS_470_002_01",
    "volume": 470,
    "author": {
      "canonical": "盧殷",
      "recorded": "盧殷"
    },
    "title": "七夕",
    "poem": [
      "河耿月涼時，牽牛織女期。",
      "歡娛方在此，漏刻竟由誰。",
      "定不嫌秋駛，唯當乞夜遲。",
      "全勝客子媍，十載泣生離。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "在此",
        "variant": "此在",
        "source": "一作「此在」"
      }
    ]
  },
  {
    "uid": "QTS_470_003_01",
    "volume": 470,
    "author": {
      "canonical": "盧殷",
      "recorded": "盧殷"
    },
    "title": "月夜",
    "poem": [
      "露下涼生簟，無人月滿庭。",
      "難聞逆河浪，徒望白榆星。",
      "樹遶孤棲鵲，窗飛就暗螢。",
      "移時宿蘭影，思共習芳馨。"
    ]
  },
  {
    "uid": "QTS_470_004_01",
    "volume": 470,
    "author": {
      "canonical": "盧殷",
      "recorded": "盧殷"
    },
    "title": "仲夏寄江南",
    "poem": [
      "五月行將近，三年客未廽。",
      "夢成千里去，酒醒百憂來。",
      "晚暮時看槿，悲酸不食梅。",
      "空將白團扇，從寄復裵回。"
    ]
  },
  {
    "uid": "QTS_470_005_01",
    "volume": 470,
    "author": {
      "canonical": "盧殷",
      "recorded": "盧殷"
    },
    "title": "欲銷雲",
    "poem": [
      "欲隱從龍質，仍餘觸石文。",
      "霏微依碧落，髣髴悞非雲。",
      "度月光無隔，傾河影不分。",
      "如逢作霖處，當爲起氤氳。"
    ]
  },
  {
    "uid": "QTS_470_006_01",
    "volume": 470,
    "author": {
      "canonical": "盧殷",
      "recorded": "盧殷"
    },
    "title": "遇邊使",
    "poem": [
      "累年無的信，每夜夢邊城。",
      "袖掩千行淚，書封一尺情。"
    ]
  },
  {
    "uid": "QTS_470_007_01",
    "volume": 470,
    "author": {
      "canonical": "盧殷",
      "recorded": "盧殷"
    },
    "title": "移住別居",
    "poem": [
      "自到西川住，唯君別有情。",
      "常逢對門遠，又隔一重城。"
    ]
  },
  {
    "uid": "QTS_470_008_01",
    "volume": 470,
    "author": {
      "canonical": "盧殷",
      "recorded": "盧殷"
    },
    "title": "堋口逢友人",
    "poem": [
      "艱難別離久，中外往還深。",
      "已改當時法，空餘舊日心。"
    ]
  },
  {
    "uid": "QTS_470_009_01",
    "volume": 470,
    "author": {
      "canonical": "盧殷",
      "recorded": "盧殷"
    },
    "title": "雨霽登北岸寄友人",
    "poem": [
      "稻黃撲撲黍油油，野樹連山澗自流。",
      "憶得年時馮翊部，謝郎相引上樓頭。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "自",
        "variant": "北",
        "source": "一作「北」"
      }
    ]
  },
  {
    "uid": "QTS_470_010_01",
    "volume": 470,
    "author": {
      "canonical": "盧殷",
      "recorded": "盧殷"
    },
    "title": "長安親故",
    "poem": [
      "楚蘭不佩佩吳鉤，帶酒城頭別舊遊。",
      "年事已多筋力在，試將弓箭到幷州。"
    ]
  },
  {
    "uid": "QTS_470_011_01",
    "volume": 470,
    "author": {
      "canonical": "盧殷",
      "recorded": "盧殷"
    },
    "title": "晩蟬",
    "poem": [
      "深藏高柳背斜暉，能軫孤愁減昔圍。",
      "猶畏旅人頭不白，再三移樹帶聲飛。"
    ]
  },
  {
    "uid": "QTS_470_012_01",
    "volume": 470,
    "author": {
      "canonical": "盧殷",
      "recorded": "盧殷"
    },
    "title": "維揚郡西亭贈友人",
    "poem": [
      "萍颯風池香滿船，楊花漠漠暮春天。",
      "玉人此日心中事，何似乘羊入市年。"
    ]
  },
  {
    "uid": "QTS_470_013_01",
    "volume": 470,
    "author": {
      "canonical": "獨孤申叔",
      "recorded": "獨孤申叔",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Dugu Shenshu",
      "wikidata_id": "Q18871131"
    },
    "title": "終南精舍月中聞磬",
    "poem": [
      "精廬殘夜景，天宇滅埃氛。",
      "幽磬此時擊，餘音幾處聞。",
      "隨風樹杪去，支策月中分。",
      "斷絕如殘漏，淒清不隔雲。",
      "羇人方罷夢，獨鴈忽迷羣。",
      "響盡河漢落，千山空糾紛。"
    ]
  },
  {
    "uid": "QTS_470_014_01",
    "volume": 470,
    "author": {
      "canonical": "嚴公弼",
      "recorded": "嚴公弼"
    },
    "title": "題漢州西湖",
    "poem": [
      "西湖創置自房公，心匠縱橫造化同。",
      "見說鳳池推獨步，高名何事滯川中。"
    ]
  },
  {
    "uid": "QTS_470_015_01",
    "volume": 470,
    "author": {
      "canonical": "嚴公貺",
      "recorded": "嚴公貺"
    },
    "title": "題漢州西湖",
    "poem": [
      "鳳沼才難盡，餘思鑿西湖。",
      "珍木羅修岸，冰光映坐隅。",
      "琴臺今寂寞，竹島尚縈紆。",
      "猶藴濟川志，芳名終不渝。"
    ]
  },
  {
    "uid": "QTS_470_016_01",
    "volume": 470,
    "author": {
      "canonical": "荘南傑",
      "recorded": "荘南傑"
    },
    "title": "湘弦曲",
    "poem": [
      "楚雲錚錚戞秋露，巫雲峽雨飛朝暮。",
      "古磬高敲百尺樓，孤猨夜哭千丈樹。",
      "雲軒碾火聲瓏瓏，連山卷盡長江空。",
      "鶯啼寂寞花枝雨，鬼嘯荒郊松栢風。",
      "滿堂怨咽悲相續，苦調中含古離曲。",
      "繁弦響絶楚魂遙，湘江水碧湘山綠。"
    ]
  },
  {
    "uid": "QTS_470_017_01",
    "volume": 470,
    "author": {
      "canonical": "荘南傑",
      "recorded": "荘南傑"
    },
    "title": "黃雀行",
    "poem": [
      "穿屋穿墻不知止，爭樹爭巢入營死。",
      "林間公子挾彈弓，一丸致斃花叢裏。",
      "小口黃雛未有知，青天不解高高飛。",
      "虞人設網當要路，白日啾嘲禍萬機。"
    ]
  },
  {
    "uid": "QTS_470_018_01",
    "volume": 470,
    "author": {
      "canonical": "荘南傑",
      "recorded": "荘南傑"
    },
    "title": "雁門太守行",
    "poem": [
      "旌旗閃閃揺天末，長笛橫吹虜塵闊。",
      "跨下嘶風白練獰，腰間切玉青蛇活。",
      "擊革摐金燧牛尾，犬羊兵敗如山死。",
      "九泉寂寞葬秋蟲，濕雲荒草啼秋思。"
    ]
  },
  {
    "uid": "QTS_470_019_01",
    "volume": 470,
    "author": {
      "canonical": "荘南傑",
      "recorded": "荘南傑"
    },
    "title": "陽春曲",
    "poem": [
      "紫錦紅嚢香滿風，金鸞玉軾揺丁冬。",
      "沙鷗白羽剪晴碧，野桃紅艷燒春空。",
      "芳草緜延鏁平地，壠蝶䨇雙舞幽翠。",
      "鳳葉龍吟白日長，落花聲底仙娥醉。"
    ]
  },
  {
    "uid": "QTS_470_020_01",
    "volume": 470,
    "author": {
      "canonical": "荘南傑",
      "recorded": "荘南傑"
    },
    "title": "傷歌行",
    "poem": [
      "兔走烏飛不相見，人事依稀速如電。",
      "王母夭桃一度開，玉樓紅粉千回變。",
      "車馳馬走咸陽道，石家舊宅空荒草。",
      "秋雨無情不惜花，芙蓉一一驚香倒。",
      "勸君莫謾栽荊棘，秦皇虛費驅山力。",
      "英風一去更無言，白骨沈埋暮山碧。"
    ],
    "variants": [
      {
        "line": 5,
        "text": "費",
        "variant": "負",
        "source": "一作「負」"
      }
    ]
  },
  {
    "uid": "QTS_470_021_01",
    "volume": 470,
    "author": {
      "canonical": "李溟",
      "recorded": "李溟"
    },
    "title": "無題",
    "poem": [
      "喬木掛斗邑，水驛壞門開。",
      "向月片帆去，背雲行雁來。",
      "晩年名利跡，寧免路岐哀。",
      "前計不能息，若為玄鬢廽。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "邑",
        "variant": "色",
        "source": "一作「色」"
      }
    ]
  },
  {
    "uid": "QTS_470_022_01",
    "volume": 470,
    "author": {
      "canonical": "賀蘭朋吉",
      "recorded": "賀蘭朋吉"
    },
    "title": "客舍喜友人相訪",
    "poem": [
      "荒居無四隣，誰肯訪來頻。",
      "古樹秋中葉，他鄉病裏身。",
      "雁聲風送急，螢影月流新。",
      "獨為成名晩，多慙見友人。"
    ]
  },
  {
    "uid": "QTS_470_023_01",
    "volume": 470,
    "author": {
      "canonical": "王魯復",
      "recorded": "王魯復"
    },
    "title": "詣李侍郎",
    "poem": [
      "文字元無底，功夫轉到難。",
      "苦心三百首，暫請侍郎看。"
    ]
  },
  {
    "uid": "QTS_470_024_01",
    "volume": 470,
    "author": {
      "canonical": "王魯復",
      "recorded": "王魯復"
    },
    "title": "弔靈均",
    "poem": [
      "萬古汨羅深，騷人道不沈。",
      "明明唐日月，應見楚臣心。"
    ]
  },
  {
    "uid": "QTS_470_025_01",
    "volume": 470,
    "author": {
      "canonical": "王魯復",
      "recorded": "王魯復"
    },
    "title": "弔韓侍郎",
    "poem": [
      "星落少微宮，高人入古風。",
      "幾年才子淚，併寫五言中。"
    ]
  },
  {
    "uid": "QTS_470_026_01",
    "volume": 470,
    "author": {
      "canonical": "王魯復",
      "recorded": "王魯復"
    },
    "title": "故白巖禪師院",
    "poem": [
      "能師還世名還在，空閉禪堂滿院苔。",
      "花樹不隨人寂寞，數枝猶自出牆來。"
    ]
  },
  {
    "uid": "QTS_470_027_01",
    "volume": 470,
    "author": {
      "canonical": "徐希仁",
      "recorded": "徐希仁"
    },
    "title": "招玉川子詠新文",
    "poem": [
      "清氣宿我心，結為清泠音。",
      "一夜吟不足，君來相和吟。"
    ]
  }
]