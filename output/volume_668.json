[
  {
    "uid": "QTS_668_001_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "途中除夜",
    "poem": [
      "南北浮萍跡，年華又暗催。",
      "殘燈和臘盡，曉角帶春來。",
      "鬢欲漸侵雪，心仍未肯灰。",
      "金門舊知己，誰為脫塵埃。"
    ]
  },
  {
    "uid": "QTS_668_002_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "長門怨",
    "poem": [
      "天上何勞萬古春，君前誰是百年人。",
      "魂銷尚愧金爐燼，思起猶慚玉輦塵。",
      "煙翠薄情攀不得，星茫浮豔採無因。",
      "可憐明鏡來相向，何似恩光朝夕新。"
    ]
  },
  {
    "uid": "QTS_668_003_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "秋日寄華陽山人",
    "poem": [
      "雲木送秋何草草，風波凝冷太星星。",
      "銀鞍公子魂俱斷，玉弩將軍涕自零。",
      "茅洞白龍和雨看，荊溪黃鵠帶霜聽。",
      "人間不見清涼事，猶向溪翁乞畫屏。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "俱",
        "variant": "堪 ",
        "source": "一作「堪 」"
      }
    ]
  },
  {
    "uid": "QTS_668_004_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "感事",
    "poem": [
      "濁河從北下，清洛向東流。",
      "清濁皆如此，何人不白頭。"
    ]
  },
  {
    "uid": "QTS_668_005_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "楚思",
    "poem": [
      "疊浪與雲急，翠蘭和意香。",
      "風流化為雨，日暮下巫陽。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "和",
        "variant": "如",
        "source": "一作「如」"
      }
    ]
  },
  {
    "uid": "QTS_668_006_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "雪中",
    "poem": [
      "金閣倚雲開，朱軒犯雪來。",
      "三冬辛苦樣，天意似難栽。"
    ]
  },
  {
    "uid": "QTS_668_007_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "道中有感",
    "poem": [
      "一醉六十日，一裘三十年。",
      "年華經幾日，日日掉征鞭。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "經",
        "variant": "禁 ",
        "source": "一作「禁 」"
      }
    ]
  },
  {
    "uid": "QTS_668_008_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "宋汴道中",
    "poem": [
      "平野有千里，居人無一家。",
      "甲兵年正少，日久戍天涯。"
    ]
  },
  {
    "uid": "QTS_668_009_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "秋思",
    "poem": [
      "天地太蕭索，山川何渺茫。",
      "不堪星斗柄，猶把歲寒量。"
    ]
  },
  {
    "uid": "QTS_668_010_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "即事",
    "poem": [
      "三年離水石，一旦隱樵漁。",
      "為問青雲上，何人識卷舒。"
    ]
  },
  {
    "uid": "QTS_668_011_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "漁家",
    "poem": [
      "野水千年在，閒花一夕空。",
      "近來浮世狹，何似釣船中。"
    ]
  },
  {
    "uid": "QTS_668_012_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "關中",
    "poem": [
      "風雨去愁晚，關河歸思涼。",
      "西遊無紫氣，一夕九回腸。"
    ]
  },
  {
    "uid": "QTS_668_013_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "歸思",
    "poem": [
      "紫府歸期斷，芳洲別思迢。",
      "黃金作人世，只被歲寒消。"
    ]
  },
  {
    "uid": "QTS_668_014_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "下第出春明門",
    "poem": [
      "曾和秋雨驅愁入，卻向春風領恨回。",
      "深謝灞陵堤畔柳，與人頭上拂塵埃。"
    ]
  },
  {
    "uid": "QTS_668_015_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "華清宮",
    "poem": [
      "何事金輿不再遊，翠鬟丹臉豈勝愁。",
      "重門深鎖禁鐘後，月滿驪山宮樹秋。"
    ]
  },
  {
    "uid": "QTS_668_016_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "秋日北固晚望二首 其一",
    "poem": [
      "風含遠思翛翛晚，日照高情的的秋。",
      "何事滿江惆悵水，年年無語向東流。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_668_016_02",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "秋日北固晚望二首 其二",
    "poem": [
      "澤國路岐當面苦，江城砧杵入心寒。",
      "不知白髮誰醫得，為問無情歲月看。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_668_017_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "送張道士",
    "poem": [
      "因將歲月離三島，閒貯風煙在一壺。",
      "為問金烏頭白後，人間流水卻回無。"
    ]
  },
  {
    "uid": "QTS_668_018_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "吳門春雨",
    "poem": [
      "吳甸落花春漫漫，吳宮芳樹晚沈沈。",
      "王孫不耐如絲雨，罥斷春風一寸心。"
    ]
  },
  {
    "uid": "QTS_668_019_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "旅夕",
    "poem": [
      "風散古陂驚宿雁，月臨荒戍起啼鴉。",
      "不堪吟斷無人見，時複寒燈落一花。"
    ]
  },
  {
    "uid": "QTS_668_020_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "瓜洲夜泊",
    "poem": [
      "偶為芳草無情客，況是青山有事身。",
      "一夕瓜洲渡頭宿，天風吹盡廣陵塵。"
    ]
  },
  {
    "uid": "QTS_668_021_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "金陵晚望",
    "poem": [
      "曾伴浮雲歸晚翠，猶陪落日汎秋聲。",
      "世間無限丹青手，一片傷心畫不成。"
    ],
    "variants": [
