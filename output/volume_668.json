  {
    "uid": "QTS_668_022_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "晚思",
    "poem": [
      "虞泉冬恨由來短，楊葉春期分外長。",
      "惆悵浮生不知處，明朝依舊出滄浪。"
    ]
  },
  {
    "uid": "QTS_668_023_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "長信宮二首 其一",
    "poem": [
      "天上夢魂何杳杳，日宮消息太沈沈。",
      "君恩不似黃金井，一處團圓萬丈深。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_668_023_02",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "長信宮二首 其二",
    "poem": [
      "天上鳳凰休寄夢，人間鸚鵡舊堪悲。",
      "平生心緒無人識，一隻金梭萬丈絲。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_668_024_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "長安旅懷",
    "poem": [
      "馬嘶九陌年年苦，人語千門日日新。",
      "唯有終南寂無事，寒光不入帝鄉塵。"
    ]
  },
  {
    "uid": "QTS_668_025_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "春",
    "poem": [
      "天柱幾條搘白日，天門幾扇鎖明時。",
      "陽春發處無根蒂，憑仗東風分外吹。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "天柱幾",
        "variant": "月桂數 ",
        "source": "一作「月桂數 」"
      }
    ]
  },
  {
    "uid": "QTS_668_026_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "春",
    "poem": [
      "明月斷魂清靄靄，平蕪歸思綠迢迢。",
      "人生莫遣頭如雪，縱得春風亦不消。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "春",
        "variant": "東 ",
        "source": "一作「東 」"
      }
    ]
  },
  {
    "uid": "QTS_668_027_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "秋",
    "poem": [
      "陽羨溪聲冷駭人，洞庭山翠晚凝神。",
      "天將金玉為風露，曾為高秋幾度貧。"
    ]
  },
  {
    "uid": "QTS_668_028_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "灞陵亭",
    "poem": [
      "一條歸夢朱弦直，一片離心白羽輕。",
      "明日灞陵新霽後，馬頭煙樹綠相迎。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "夢",
        "variant": "路",
        "source": "一作「路」"
      }
    ]
  },
  {
    "uid": "QTS_668_029_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "偶作二首 其一",
    "poem": [
      "丁當玉佩三更雨，平帖金閨一覺雲。",
      "明日薄情何處去，風流春水不知君。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_668_029_02",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "偶作二首 其二",
    "poem": [
      "霞衣重疊紅蟬暖，雲髻蔥籠紫鳳寒。",
      "天上少年分散後，一條煙水若為看。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_668_030_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "永夕",
    "poem": [
      "雲鴻宿處江村冷，獨狖啼時海國陰。",
      "不會殘燈無一事，覺來猶有向隅心。"
    ]
  },
  {
    "uid": "QTS_668_031_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "落花",
    "poem": [
      "一葉落時空下淚，三春歸盡復何情。",
      "無人共得東風語，半日尊前計不成。"
    ]
  },
  {
    "uid": "QTS_668_032_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "下第後上永崇高侍郎",
    "poem": [
      "天上碧桃和露種，日邊紅杏倚雲栽。",
      "芙蓉生在秋江上，不向東風怨未開。"
    ]
  },
  {
    "uid": "QTS_668_033_01",
    "volume": 668,
    "author": {
      "canonical": "高蟾",
      "recorded": "高蟾"
    },
    "title": "句",
    "poem": [
      "君恩秋後葉，日日向人疏。"
    ],
    "part_index": 1
  }
