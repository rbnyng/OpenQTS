[
  {
    "uid": "QTS_209_001_01",
    "volume": 209,
    "author": {
      "canonical": "賈邕",
      "recorded": "賈邕"
    },
    "title": "送蕭穎士赴東府得路字",
    "poem": [
      "子欲適東周，門人盈岐路。",
      "高標信難仰，薄官非始務。",
      "綿邈千里途，裴回四郊暮。",
      "征車日雲遠，撫己慙深顧。"
    ]
  },
  {
    "uid": "QTS_209_002_01",
    "volume": 209,
    "author": {
      "canonical": "劉舟",
      "recorded": "劉舟"
    },
    "title": "送蕭穎士赴東府得適字",
    "poem": [
      "大名掩諸古，獨斷無不適。",
      "德遂天下宗，官爲幕中客。",
      "驪山浮雲散，灞岸零雨夕。",
      "請業非遠期，圓光再生魄。"
    ]
  },
  {
    "uid": "QTS_209_003_01",
    "volume": 209,
    "author": {
      "canonical": "長孫鑄",
      "recorded": "長孫鑄"
    },
    "title": "送蕭穎士赴東府得離字",
    "poem": [
      "大德詎可擬，高梧有長離。",
      "素懷經綸具，昭世猶安卑。",
      "落日去關外，悠悠隔山陂。",
      "我心如浮雲，千里相追隨。"
    ]
  },
  {
    "uid": "QTS_209_004_01",
    "volume": 209,
    "author": {
      "canonical": "房白",
      "recorded": "房白"
    },
    "title": "送蕭穎士赴東府得還字",
    "poem": [
      "夫子高世蹟，時人不可攀。",
      "今予亦云幸，謬得承溫顏。",
      "良策資入幕，遂行從近關。",
      "青春灞亭別，此去何時還。"
    ]
  },
  {
    "uid": "QTS_209_005_01",
    "volume": 209,
    "author": {
      "canonical": "元晟",
      "recorded": "元晟"
    },
    "title": "送蕭穎士赴東府得引字",
    "poem": [
      "吾見夫子德，誰雲習相近。",
      "數仞不可窺，言味終難盡。",
      "處喧慮常澹，作吏心亦隱。",
      "更有嵩少峰，東南爲勝引。"
    ]
  },
  {
    "uid": "QTS_209_006_01",
    "volume": 209,
    "author": {
      "canonical": "劉太沖",
      "recorded": "劉太沖"
    },
    "title": "送蕭穎士赴東府得淺字",
    "poem": [
      "吾師繼微言，贊述在墳典。",
      "寸祿聊自資，平生宦情鮮。",
      "逶遲東州路，春草深復淺。",
      "日遠夫子門，中心曷由展。"
    ],
    "variants": [
      {
