    "title": "奉和聖制龍池篇",
    "poem": [
      "代邸東南龍躍泉，清漪碧浪遠浮天。",
      "樓臺影就波中出，日月光疑鏡裏懸。",
      "雁沼洄流成舜海，龜書薦社應堯年。",
      "大川既濟慙爲楫，報德空思奉細涓。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "躍泉",
        "variant": "或躍",
        "source": "一作「或躍」"
      }
    ]
  }
