  {
    "uid": "QTS_600_007_01",
    "volume": 600,
    "author": {
      "canonical": "韋承貽",
      "recorded": "韋承貽"
    },
    "title": "策試夜潛紀長句於都堂西南隅",
    "poem": [
      "褒衣博帶滿塵埃，獨自都堂納卷回。",
      "蓬巷幾時聞吉語，棘籬何日免重來。",
      "三條燭盡鐘初動，九轉丹成鼎未開。",
      "殘月漸低人擾擾，不知誰是謫仙才。"
    ]
  },
  {
    "uid": "QTS_600_008_01",
    "volume": 600,
    "author": {
      "canonical": "韋承貽",
      "recorded": "韋承貽"
    },
    "title": "策試夜潛紀長句於都堂西南隅",
    "poem": [
      "白蓮千朵照廊明，一片升平雅頌聲。",
      "才唱第三條燭盡，南宮風月畫難成。"
    ]
  },
  {
    "uid": "QTS_600_009_01",
    "volume": 600,
    "author": {
      "canonical": "鄭洪業",
      "recorded": "鄭洪業"
    },
    "title": "詔放雲南子弟還國",
    "poem": [
      "德被陪臣子，仁垂聖主恩。",
      "雕題辭鳳闕，丹服出金門。",
      "有澤沾殊俗，無征及獷？",
      "。",
      "銅梁分漢土，玉壘駕鸞軒。",
      "瘴嶺蠶叢盛，巴江越巂垠。",
      "萬方同感化，豈獨自南蕃。"
    ]
  },
  {
    "uid": "QTS_600_010_01",
    "volume": 600,
    "author": {
      "canonical": "孫緯",
      "recorded": "孫緯"
    },
    "title": "中秋夜思鄭延美有作",
    "poem": [
      "中秋中夜月，世說慴妖精。",
      "顧兔雲初蔽，長虵誰與勍。",
      "未追良友翫，安用玉輪盈。",
      "此意人誰喻，裁詩穿禁城。"
    ]
  },
  {
    "uid": "QTS_600_011_01",
    "volume": 600,
    "author": {
      "canonical": "歐陽玭",
      "recorded": "歐陽玭",
      "gender": "male",
      "english_name": "Ouyang Pin",
      "wikidata_id": "Q45548331"
    },
    "title": "清曉捲簾",
    "poem": [
      "清曉意未愜，捲簾時一吟。",
      "檻虛花氣密，地暖竹聲深。",
      "秀色還朝暮，浮雲自古今。",
      "石泉驚已躍，會可洗幽心。"
    ]
  },
  {
    "uid": "QTS_600_012_01",
    "volume": 600,
    "author": {
      "canonical": "歐陽玭",
      "recorded": "歐陽玭",
      "gender": "male",
      "english_name": "Ouyang Pin",
      "wikidata_id": "Q45548331"
    },
    "title": "巴陵",
    "poem": [
      "孤城向夕原，春入景初暄。",
      "綠樹低官舍，青山在縣門。",
      "樓臺疑結蜃，枕席更聞猨。",
      "客路何曾定，棲遲欲斷魂。"
    ]
  },
  {
    "uid": "QTS_600_013_01",
    "volume": 600,
    "author": {
      "canonical": "歐陽玭",
      "recorded": "歐陽玭",
      "gender": "male",
      "english_name": "Ouyang Pin",
      "wikidata_id": "Q45548331"
    },
    "title": "榆溪道上",
    "poem": [
      "初日在斜溪，山雲片片低。",
      "鄉愁夢裏失，馬色望中迷。",
      "澗底淒泉氣，巖前遍綠荑。",
      "非關秦塞去，無事候晨雞。"
    ]
  },
  {
    "uid": "QTS_600_014_01",
    "volume": 600,
    "author": {
      "canonical": "歐陽玭",
      "recorded": "歐陽玭",
      "gender": "male",
      "english_name": "Ouyang Pin",
      "wikidata_id": "Q45548331"
    },
    "title": "新嶺臨眺寄連總進士",
    "poem": [
      "關勢遙臨海，峰巒半入雲。",
      "煙中獨鳥下，潭上雜花熏。",
      "寄遠悲春草，登臨憶使君。",
      "此時還極目，離思更紛紛。"
    ]
  },
  {
    "uid": "QTS_600_015_01",
    "volume": 600,
    "author": {
      "canonical": "歐陽玭",
      "recorded": "歐陽玭",
      "gender": "male",
      "english_name": "Ouyang Pin",
      "wikidata_id": "Q45548331"
    },
    "title": "幽軒",
    "poem": [
      "幽軒斜映山，空澗復潺潺。",
      "重疊巖巒趣，遙來窗戶間。",
      "桃花飄岫幌，燕子語松關。",
      "衣桁侵池翠，階痕露蘚斑。",
      "臨風清瑟奏，對客白雲閒。",
      "眷戀青春色，含毫俯碧灣。"
    ]
  },
  {
    "uid": "QTS_600_016_01",
