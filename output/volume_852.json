    "title": "答宋之問",
    "poem": [
      "時既暮兮節欲春，山林寂兮懷幽人。",
      "登奇峰兮望白雲，悵緬邈兮象欲紛。",
      "白雲悠悠去不返，寒風颼颼吹日晚。",
      "不見其人誰與言，歸坐彈琴思逾遠。"
    ]
  },
  {
    "uid": "QTS_852_002_01",
    "volume": 852,
    "author": {
      "canonical": "張氳",
      "recorded": "張氳",
      "gender": "male"
    },
    "title": "醉吟三首 其一",
    "poem": [
      "去歲無田種，今春乏酒材。",
      "從他花鳥笑，佯醉臥樓臺。"
    ],
    "part_index": 1,
    "total_parts": 3
  },
  {
    "uid": "QTS_852_002_02",
    "volume": 852,
    "author": {
      "canonical": "張氳",
      "recorded": "張氳",
      "gender": "male"
    },
    "title": "醉吟三首 其二",
    "poem": [
      "下調無人睬，高心又被瞋。",
      "不知時俗意，教我若為人。"
    ],
    "part_index": 2,
    "total_parts": 3
  },
  {
    "uid": "QTS_852_002_03",
    "volume": 852,
    "author": {
      "canonical": "張氳",
      "recorded": "張氳",
      "gender": "male"
    },
    "title": "醉吟三首 其三",
    "poem": [
      "入市非求利，過朝不為名。",
      "有時隨俗物，相伴且營營。"
    ],
    "part_index": 3,
    "total_parts": 3
  },
  {
    "uid": "QTS_852_003_01",
    "volume": 852,
    "author": {
      "canonical": "司馬退之",
      "recorded": "司馬退之",
      "gender": "male"
    },
    "title": "洗心",
    "poem": [
      "不踐名利道，始覺塵土腥。",
      "不味稻粱食，始覺精神清。",
      "羅浮奔走外，日月無短明。",
      "山瘦松亦勁，鶴老飛更輕。",
      "逍遙此中客，翠發皆長生。",
      "草木多古色，雞犬無新聲。",
      "君有出俗志，不貪英雄名。",
      "傲然脫冠帶，改換人間情。",
      "去矣丹霄路，向曉雲冥冥。"
    ]
  },
  {
    "uid": "QTS_852_004_01",
    "volume": 852,
    "author": {
      "canonical": "裵翛然",
      "recorded": "裵翛然",
      "gender": "male"
    },
    "title": "夜醉臥街",
    "poem": [
      "遮莫冬冬動，須傾滿滿杯。",
      "金吾如借問，但道玉山頹。"
    ]
  },
  {
    "uid": "QTS_852_005_01",
    "volume": 852,
    "author": {
      "canonical": "軒轅彌明",
      "recorded": "軒轅彌明",
      "gender": "male"
    },
    "title": "謁堯帝廟",
    "poem": [
      "祖龍開國盡遐荒，廟建唐堯鎮此邦。",
      "山卷白雲朝帝座，林疏紅日列仙幢。",
      "巍巍聖跡陵松嶠，蕩蕩恩波洽桂江。",
      "瞻仰威靈共回首，紫霞深處鎖軒窗。"
    ]
  },
  {
    "uid": "QTS_852_006_01",
    "volume": 852,
    "author": {
      "canonical": "陳寡言",
      "recorded": "陳寡言",
      "gender": "male"
    },
    "title": "山居",
    "poem": [
      "照水冰如鑒，掃雪玉為塵。",
      "何須問今古，便是上皇人。",
      "醉臥茅堂不閉關，覺來開眼見青山。",
      "松花落處宿猿在，麋鹿群群林際還。"
    ]
  },
  {
    "uid": "QTS_852_007_01",
    "volume": 852,
    "author": {
      "canonical": "陳寡言",
      "recorded": "陳寡言",
      "gender": "male"
    },
    "title": "臨化示弟子",
    "poem": [
      "我本無形暫有形，偶來人世逐營營。",
      "輪回債負今還畢，搔首翛然歸上清。"
    ]
  },
  {
    "uid": "QTS_852_008_01",
    "volume": 852,
    "author": {
      "canonical": "李昇",
      "recorded": "李昇",
      "gender": "male",
      "period": "Five Dynasties / Song",
      "english_name": "Emperor Liezu of Southern Tang",
      "wikidata_id": "Q711844"
    },
    "title": "元白席上作",
    "poem": [
      "生在儒家遇太平，懸纓垂帶布衣輕。",
      "誰能世路趨名利，臣事玉皇歸上清。"
    ]
  },
  {
    "uid": "QTS_852_009_01",
    "volume": 852,
    "author": {
      "canonical": "范堯佐",
      "recorded": "范堯佐",
      "gender": "male"
    },
    "title": "一字至七字詩：書",
    "poem": [
      "書。",
      "憑雁，寄魚。",
      "出王屋，入匡廬。",
      "文生益智，道著清虛。",
      "葛洪一萬卷，惠子五車餘。",
      "銀鉤屈曲索靖，題橋司馬相如。",
      "別後莫暌千里信，數封緘送到閒居。"
    ]
  },
  {
    "uid": "QTS_852_010_01",
    "volume": 852,
    "author": {
      "canonical": "徐霛府",
      "recorded": "徐霛府",
      "gender": "male"
    },
    "title": "言志獻浙東廉訪辭召",
    "poem": [
      "野性歌三樂，皇恩出九重。",
      "那煩紫宸命，遠下白雲峰。",
      "多愧書傳鶴，深慚紙畫龍。",
      "將何佐明主，甘老在岩松。"
    ]
  },
  {
    "uid": "QTS_852_011_01",
    "volume": 852,
    "author": {
      "canonical": "徐霛府",
      "recorded": "徐霛府",
      "gender": "male"
    },
    "title": "自詠二首 其一",
    "poem": [
      "寂寂凝神太極初，無心應物等空虛。",
      "性修自性非求得，欲識真人只是渠。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_852_011_02",
    "volume": 852,
    "author": {
      "canonical": "徐霛府",
      "recorded": "徐霛府",
      "gender": "male"
    },
    "title": "自詠二首 其二",
    "poem": [
      "學道全真在此生，何須待死更求生。",
      "今生不了無生理，縱複生知那處生。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
