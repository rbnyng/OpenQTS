[
  {
    "uid": "QTS_866_001_01",
    "volume": 866,
    "author": {
      "canonical": "九華山白衣",
      "recorded": "九華山白衣"
    },
    "title": "吟",
    "poem": [
      "澗水潺潺聲不絕，溪壟茫茫野花發。",
      "自去自來人不知，歸時唯對空山月。"
    ]
  },
  {
    "uid": "QTS_866_002_01",
    "volume": 866,
    "author": {
      "canonical": "田達城借宅鬼",
      "recorded": "田達城借宅鬼"
    },
    "title": "詩",
    "poem": [
      "天然與我一靈通，還與人間事不同。",
      "要識吾家真姓字，天地南頭一段紅。"
    ]
  },
  {
    "uid": "QTS_866_003_01",
    "volume": 866,
    "author": {
      "canonical": "長安中鬼",
      "recorded": "長安中鬼",
      "period": "Early Tang"
    },
    "title": "秋夜吟",
    "poem": [
      "六街鼓歇行人絕，九衢茫茫室有月。",
      "——",
      "九衢生人何勞勞，長安土盡槐根高。",
      "——"
    ]
  },
  {
    "uid": "QTS_866_004_01",
    "volume": 866,
    "author": {
      "canonical": "隔窗鬼",
      "recorded": "隔窗鬼"
    },
    "title": "題窗上詩",
    "poem": [
      "何人窗下讀書聲，南斗闌幹北斗橫。",
      "千里思家歸不得，春風腸斷石頭城。"
    ]
  },
  {
    "uid": "QTS_866_005_01",
    "volume": 866,
    "author": {
      "canonical": "巴陵館鬼",
      "recorded": "巴陵館鬼"
    },
    "title": "柱上詩",
    "poem": [
      "爺娘送我青楓根，不記青楓幾回落。",
      "當時手刺衣上花，今日為灰不堪著。"
    ]
  },
  {
    "uid": "QTS_866_006_01",
    "volume": 866,
    "author": {
      "canonical": "徐侃",
      "recorded": "徐侃"
    },
    "title": "留別安鳳",
    "poem": [
      "君寄長安久，恥不還故鄉。",
      "我別長安去，切在慰高堂。",
      "不意與離恨，泉下亦難忘。"
    ]
  },
  {
    "uid": "QTS_866_007_01",
    "volume": 866,
    "author": {
      "canonical": "安鳳",
      "recorded": "安鳳"
    },
    "title": "附：安鳳贈別徐侃",
    "poem": [
      "一自離鄉國，十年在咸秦。",
      "泣盡卞和血，不逢一故人。",
      "今日舊友別，羞此漂泊身。",
      "離情吟詩處，麻衣掩淚頻。",
      "淚別各分袂，且及來年春。"
    ]
  },
  {
    "uid": "QTS_866_008_01",
    "volume": 866,
    "author": {
      "canonical": "商山客死書生",
      "recorded": "商山客死書生"
    },
    "title": "述懷",
    "poem": [
      "家住驛北路，百里無四鄰。",
      "往來不相問，寂寂山家春。",
      "南岡夜蕭蕭，青松與白楊。",
      "家人應有夢，遠客已無腸。",
      "白草寒露裏，亂山明月中。",
      "是夕苦吟罷，寒燭與君同。"
    ]
  },
  {
    "uid": "QTS_866_009_01",
    "volume": 866,
    "author": {
      "canonical": "塚中人",
      "recorded": "塚中人"
    },
    "title": "續鄭郊吟",
    "poem": [
      "塚上兩竿竹，風吹常嫋嫋。",
      "下有百年人，長眠不知曉。"
    ],
    "notes": [
      {
