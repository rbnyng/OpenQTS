        "context": "除夜長安作",
        "original_title": "除夜長安作〈一作李京詩。〉"
      }
    ]
  },
  {
    "uid": "QTS_542_008_01",
    "volume": 542,
    "author": {
      "canonical": "李景",
      "recorded": "李景",
      "gender": "male",
      "period": "Pre-Tang",
      "wikidata_id": "Q24837687"
    },
    "title": "都堂試貢士日慶春雪",
    "poem": [
      "密雪分天路，羣才坐粉廊。",
      "靄空迷晝景，臨宇借寒光。",
      "似暖花消地，無聲玉滿堂。",
      "灑池偏誤曲，留硯忽因方。",
      "幾處曹風比，何人謝賦長。",
      "春暉早相照，莫滯九衢旁。"
    ]
  },
  {
    "uid": "QTS_542_009_01",
    "volume": 542,
    "author": {
      "canonical": "張元宗",
      "recorded": "張元宗"
    },
    "title": "登景雲寺閣",
    "poem": [
      "胡馬飲河洛，我家從此遷。",
      "今來獨垂淚，三十六峰前。"
    ]
  },
  {
    "uid": "QTS_542_010_01",
    "volume": 542,
    "author": {
      "canonical": "張元宗",
      "recorded": "張元宗"
    },
    "title": "望終南山",
    "poem": [
      "紅塵白日長安路，馬足車輪不暫閒。",
      "唯有茂陵多病客，每來高處望南山。"
    ]
  },
  {
    "uid": "QTS_542_011_01",
    "volume": 542,
    "author": {
      "canonical": "李肱",
      "recorded": "李肱"
    },
    "title": "省試霓裳羽衣曲",
    "poem": [
      "開元太平時，萬國賀豐歲。",
      "梨園獻舊曲，玉座流新製。",
      "鳳管遞參差，霞衣競搖曳。",
      "醼罷水殿空，輦餘春草細。",
      "蓬壺事已久，仙樂功無替。",
      "詎肯聽遺音，聖明知善繼。"
    ]
  },
  {
    "uid": "QTS_542_012_01",
    "volume": 542,
    "author": {
      "canonical": "李肱",
      "recorded": "李肱"
    },
    "title": "句",
    "poem": [
      "水光先見月，露氣早知秋。"
    ],
    "notes": [
      {
        "line": 3,
        "content": "見《萬花谷》。",
        "context": ""
      }
    ]
  },
  {
    "uid": "QTS_542_013_01",
    "volume": 542,
    "author": {
      "canonical": "鄭史",
      "recorded": "鄭史"
    },
    "title": "永州送姪歸宜春",
    "poem": [
      "宋玉正秋悲，那堪更別離。",
      "從來襟上淚，盡作鬢邊絲。",
      "永水清如此，袁江色可知。",
      "到家黃菊坼，亦莫怪歸遲。"
    ]
  },
  {
    "uid": "QTS_542_014_01",
    "volume": 542,
    "author": {
      "canonical": "鄭史",
      "recorded": "鄭史"
    },
    "title": "秋日零陵與幕下諸賓遊河夜飲",
    "poem": [
      "湘月蘋風乍暢襟，燭前江水練千尋。",
      "新秋宋玉能為賦，永夕袁安好共吟。",
      "輦下翠蛾須強展，尊中綠蟻且徐斟。",
      "汀沙漸有珠凝露，緩棹蘭橈任夜深。"
    ]
  },
  {
    "uid": "QTS_542_015_01",
    "volume": 542,
    "author": {
      "canonical": "鄭史",
      "recorded": "鄭史"
    },
    "title": "贈妓行雲詩",
    "poem": [
      "最愛鉛華薄薄妝，更兼衣著又鵝黃。",
      "從來南國名佳麗，何事今朝在北行。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "北",
        "variant": "此",
        "source": "一作「此」"
      }
    ]
  },
  {
    "uid": "QTS_542_016_01",
    "volume": 542,
    "author": {
      "canonical": "許瀍",
      "recorded": "許瀍"
    },
    "title": "紀夢",
    "poem": [
      "晚入瑤臺露氣清，天風飛下步虛聲。",
      "塵心未盡俗緣在，十里下山空月明。"
    ]
  },
  {
    "uid": "QTS_542_017_01",
    "volume": 542,
    "author": {
      "canonical": "牛叢",
      "recorded": "牛叢",
      "gender": "male",
      "wikidata_id": "Q30017943"
    },
    "title": "題朝陽巖",
    "poem": [
      "躡石攀蘿路不迷，曉天風好浪花低。",
      "洞名獨佔朝陽號，應有梧桐待鳳棲。"
    ]
  },
  {
    "uid": "QTS_542_018_01",
    "volume": 542,
    "author": {
      "canonical": "陳上美",
      "recorded": "陳上美"
    },
    "title": "咸陽有懷",
    "poem": [
      "山連河水碧氛氳，瑞氣東移擁聖君。",
      "秦苑有花空笑日，漢陵無主自侵雲。",
      "古槐堤上鶯千囀，遠渚沙中鷺一羣。",
      "賴與淵明同把菊，煙郊西望夕陽曛。"
    ]
  },
  {
    "uid": "QTS_542_019_01",
    "volume": 542,
    "author": {
      "canonical": "楊鴻",
      "recorded": "楊鴻",
      "gender": "male",
      "english_name": "Yang Hong",
      "wikidata_id": "Q24833623"
    },
    "title": "晴望九華山",
    "poem": [
      "九華閒望簇青虛，氣象羣峰盡不如。",
      "惆悵都南掛冠吏，無人解向此山居。"
    ]
  },
  {
    "uid": "QTS_542_020_01",
    "volume": 542,
    "author": {
      "canonical": "趙璜",
      "recorded": "趙璜"
    },
    "title": "正月",
    "poem": [
      "正月今朝半，陽臺信未迴。",
      "水芹寒不食，山杏雨應開。",
      "世網留三宿，真源寄一杯。",
      "因聲謝猨鳥，歲晏會歸來。"
    ]
  },
  {
    "uid": "QTS_542_021_01",
    "volume": 542,
    "author": {
      "canonical": "趙璜",
      "recorded": "趙璜"
    },
    "title": "七夕詩",
    "poem": [
      "烏鵲橋頭雙扇開，年年一度過河來。",
      "莫嫌天上稀相見，猶勝人間去不迴。",
      "欲減煙花饒俗世，暫煩雲月掩樓臺。",
      "別時舊路長清淺，豈肯離情似死灰。"
    ],
    "notes": [
      {
        "content": "一作李郢詩",
        "context": "七夕詩",
        "original_title": "七夕詩〈一作李郢詩〉"
      }
    ]
  },
  {
    "uid": "QTS_542_022_01",
    "volume": 542,
    "author": {
      "canonical": "趙璜",
      "recorded": "趙璜"
    },
    "title": "曲江上巳",
    "poem": [
      "長隄十里轉香車，兩岸煙花錦不如。",
      "欲問神仙在何處，紫雲樓閣向空虛。"
    ]
  },
  {
    "uid": "QTS_542_023_01",
    "volume": 542,
    "author": {
      "canonical": "趙璜",
      "recorded": "趙璜"
    },
    "title": "題七夕圖",
    "poem": [
      "帝子吹簫上翠微，秋風一曲鳳凰歸。",
      "明年七月重相見，依舊高懸織女機。"
    ]
  },
  {
    "uid": "QTS_542_024_01",
    "volume": 542,
    "author": {
      "canonical": "潘咸",
      "recorded": "潘咸"
    },
    "title": "登明戍堡",
    "poem": [
      "來經古城上，極目思無窮。",
      "寇盡煙蘿外，人歸蔓草中。",
      "峰巒當闕古，堞壘對雲空。",
      "不見昔名將，徒稱有戰功。"
    ]
  },
  {
    "uid": "QTS_542_025_01",
    "volume": 542,
    "author": {
      "canonical": "潘咸",
      "recorded": "潘咸"
    },
    "title": "送陳明府之任",
    "poem": [
      "客見天台縣，閭閻樹色間。",
      "驂回幾臨水，帶緩獨開山。",
      "吏散落花盡，人居遠島閒。",
      "過於老萊子，端簡獨承顏。"
    ]
  },
  {
    "uid": "QTS_542_026_01",
    "volume": 542,
    "author": {
      "canonical": "潘咸",
      "recorded": "潘咸"
    },
    "title": "長安春暮",
    "poem": [
      "客在關西春暮夜，還同江外已清明。",
      "三更獨立看花月，惟欠子規啼一聲。"
    ]
  },
  {
    "uid": "QTS_542_027_01",
    "volume": 542,
    "author": {
      "canonical": "潘咸",
      "recorded": "潘咸"
    },
    "title": "舟行",
    "poem": [
      "平沙極浦無人度，猶繫孤舟寒草西。",
      "半夜起看潮上月，萬山中有一猿啼。"
    ]
  },
  {
    "uid": "QTS_542_028_01",
    "volume": 542,
    "author": {
      "canonical": "潘咸",
      "recorded": "潘咸"
    },
    "title": "送僧",
    "poem": [
      "闕下僧歸山頂寺，卻看朝日下方明。",
      "莫道野人尋不見，半天雲裏有鐘聲。"
    ]
  },
  {
    "uid": "QTS_542_029_01",
    "volume": 542,
    "author": {
      "canonical": "潘咸",
      "recorded": "潘咸"
    },
    "title": "句",
    "poem": [
      "棧踏猿聲暮，江看劍影秋。",
      "僧老白雲上，磬寒高鳥邊。",
      "心已同猿狖，不聞人是非。",
      "行人渡流水，白馬入前山。",
      "秋深雪滿黃金塞，夜夜鴻聲入漢陽。"
    ],
