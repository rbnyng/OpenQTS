    "author": {
      "canonical": "薛瑩",
      "recorded": "薛瑩",
      "gender": "male",
      "wikidata_id": "Q3278139"
    },
    "title": "秋晚同友人閒步",
    "poem": [
      "藉草與行莎，相看日未斜。",
      "斷崖分鳥道，疎樹見人家。",
      "望遠臨孤石，吟餘落片霞。",
      "野情看不足，歸路思猶賒。"
    ]
  },
  {
    "uid": "QTS_542_031_01",
    "volume": 542,
    "author": {
      "canonical": "薛瑩",
      "recorded": "薛瑩",
      "gender": "male",
      "wikidata_id": "Q3278139"
    },
    "title": "宿仙都觀陰、王二君修道處",
    "poem": [
      "十載別仙峰，峰前千古蹤。",
      "陰王修道處，雲雪滿高松。",
      "洞口風雷異，池心星漢重。",
      "明朝下山去，片月落殘鐘。"
    ]
  },
  {
    "uid": "QTS_542_032_01",
    "volume": 542,
    "author": {
      "canonical": "薛瑩",
      "recorded": "薛瑩",
      "gender": "male",
      "wikidata_id": "Q3278139"
    },
    "title": "宿東巖寺曉起",
    "poem": [
      "野寺寒塘曉，遊人一夢分。",
      "鐘殘數樹月，僧起半巖雲。",
      "宿鳥驚初見，幽泉落不聞。",
      "吟餘憑前檻，紅葉下紛紛。"
    ]
  },
  {
    "uid": "QTS_542_033_01",
    "volume": 542,
    "author": {
      "canonical": "薛瑩",
      "recorded": "薛瑩",
      "gender": "male",
      "wikidata_id": "Q3278139"
    },
    "title": "秋日湖上",
    "poem": [
      "落日五湖游，煙波處處愁。",
      "沈浮千古事，誰與問東流。"
    ]
  },
  {
    "uid": "QTS_542_034_01",
    "volume": 542,
    "author": {
      "canonical": "薛瑩",
      "recorded": "薛瑩",
      "gender": "male",
      "wikidata_id": "Q3278139"
    },
    "title": "江山閒望",
    "poem": [
      "渺渺無窮盡，風濤幾日平。",
      "年光與人事，東去一聲聲。"
    ]
  },
  {
    "uid": "QTS_542_035_01",
    "volume": 542,
    "author": {
      "canonical": "薛瑩",
      "recorded": "薛瑩",
      "gender": "male",
      "wikidata_id": "Q3278139"
    },
    "title": "訪武陵道者不遇",
    "poem": [
      "花發鳥仍啼，行行路欲迷。",
      "二真無問處，虛度武陵溪。"
    ]
  },
  {
    "uid": "QTS_542_036_01",
    "volume": 542,
    "author": {
      "canonical": "薛瑩",
      "recorded": "薛瑩",
      "gender": "male",
      "wikidata_id": "Q3278139"
    },
    "title": "寄舊山隱侶",
    "poem": [
      "舊山諸隱淪，身在苦無身。",
      "莫鎖白雲路，白雲多悞人。"
    ]
  },
  {
    "uid": "QTS_542_037_01",
    "volume": 542,
    "author": {
      "canonical": "薛瑩",
      "recorded": "薛瑩",
      "gender": "male",
      "wikidata_id": "Q3278139"
    },
    "title": "羨僧",
    "poem": [
      "處世曾無著，生前事盡非。",
      "一瓶兼一衲，南北去如歸。"
    ]
