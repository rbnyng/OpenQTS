[
  {
    "uid": "QTS_542_001_01",
    "volume": 542,
    "author": {
      "canonical": "紀唐夫",
      "recorded": "紀唐夫"
    },
    "title": "送友人歸宜春",
    "poem": [
      "落花兼柳絮，無處不紛紛。",
      "遠道空歸去，流鶯獨自聞。",
      "墅橋喧碓水，山郭入樓雲。",
      "故里南陔曲，秋期欲送君。"
    ]
  },
  {
    "uid": "QTS_542_002_01",
    "volume": 542,
    "author": {
      "canonical": "紀唐夫",
      "recorded": "紀唐夫"
    },
    "title": "驄馬曲",
    "poem": [
      "連錢出塞蹋沙蓬，豈比當時御史驄。",
      "逐北自諳深磧路，連嘶誰念靜邊功。",
      "登山每與青雲合，弄影應知碧草同。",
      "今日虜平將換妾，不如羅袖舞春風。"
    ],
