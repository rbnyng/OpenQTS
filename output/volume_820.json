      "english_name": "Jiaoran",
      "wikidata_id": "Q11644522"
    },
    "title": "從軍行五首 其四",
    "poem": [
      "飛將下天來，奇謀閫外裁。",
      "水心龍劍動，地肺雁山開。",
      "望氣燕師銳，當鋒虜陣摧。",
      "從今射鵰騎，不敢過雲堆。"
    ],
    "part_index": 4,
    "total_parts": 5
  },
  {
