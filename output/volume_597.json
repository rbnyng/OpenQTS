      "wikidata_id": "Q5192674"
    },
    "title": "報何澤",
    "poem": [
      "四十九年前及第，同年唯有老夫存。",
      "今日殷勤訪吾子，穩將鬐鬣上龍門。"
    ]
  },
  {
    "uid": "QTS_597_008_01",
    "volume": 597,
    "author": {
      "canonical": "裴鉶",
      "recorded": "裴鉶",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Pei Xing",
      "wikidata_id": "Q10516472"
    },
    "title": "題文翁石室",
    "poem": [
      "文翁石室有儀形，庠序千秋播德馨。",
      "古柏尚留今日翠，高岷猶藹舊時青。",
      "人心未肯拋羶蟻，弟子依前學聚螢。",
      "更歎沲江無限水，爭流只願到滄溟。"
    ]
  },
  {
    "uid": "QTS_597_009_01",
    "volume": 597,
    "author": {
      "canonical": "劉損",
      "recorded": "劉損"
    },
    "title": "憤惋詩三首 其一",
    "poem": [
      "寶釵分股合無緣，魚在深淵日在天。",
      "得意紫鸞休舞鏡，斷蹤青鳥罷銜箋。",
      "金杯倒覆難收水，玉軫傾欹嬾續弦。",
      "從此蘼蕪山下過，只應將淚比黃泉。"
    ],
    "part_index": 1,
    "total_parts": 3
  },
  {
    "uid": "QTS_597_009_02",
    "volume": 597,
    "author": {
      "canonical": "劉損",
      "recorded": "劉損"
    },
    "title": "憤惋詩三首 其二",
    "poem": [
      "鸞辭舊伴知何止，鳳得新梧想稱心。",
      "紅粉尚存香幕幕，白雲將散信沉沉。",
      "已休磨琢投泥玉，懶更經營買笑金。",
      "願作山頭似人石，丈夫衣上淚痕深。"
    ],
    "part_index": 2,
    "total_parts": 3
  },
  {
    "uid": "QTS_597_009_03",
    "volume": 597,
    "author": {
      "canonical": "劉損",
      "recorded": "劉損"
    },
    "title": "憤惋詩三首 其三",
    "poem": [
      "舊嘗遊處遍尋看，睹物傷情死一般。",
      "買笑樓前花已謝，畫眉窗下月空殘。",
      "雲歸巫峽音容斷，路隔星河去住難。",
      "莫道詩成無淚下，淚如泉滴亦須乾。"
    ],
    "part_index": 3,
    "total_parts": 3
  },
  {
    "uid": "QTS_597_010_01",
    "volume": 597,
    "author": {
      "canonical": "鄭愚",
      "recorded": "鄭愚",
      "gender": "male",
      "wikidata_id": "Q18906136"
    },
    "title": "幼作",
    "poem": [
      "臺山初罷霧，岐海正分流。",
      "漁浦颺來笛，鴻逵翼去舟。"
    ]
  },
  {
    "uid": "QTS_597_011_01",
    "volume": 597,
    "author": {
      "canonical": "鄭愚",
      "recorded": "鄭愚",
      "gender": "male",
      "wikidata_id": "Q18906136"
    },
    "title": "茶詩",
    "poem": [
      "嫩芽香且靈，吾謂草中英。",
      "夜臼和煙擣，寒爐對雪烹。",
      "惟憂碧粉散，嘗見綠花生。"
    ]
  },
  {
    "uid": "QTS_597_012_01",
    "volume": 597,
    "author": {
      "canonical": "霍總",
      "recorded": "霍總"
    },
    "title": "郡樓望九華歌",
    "poem": [
      "樓上坐見九子峰，翠雲赤日光溶溶。",
      "有時朝昏變疏密，八峰和煙一峰出。",
      "有時風卷天雨晴，聚立連連如弟兄。",
      "陽烏生子偶成數，丹鳳養雛同此名。",
      "日日遙看機已靜，未離塵躅思真境。",
      "子明龍駕騰九垓，陵陽相對空崔嵬。",
      "玉漿瑤草不可見，自有神仙風馬來。"
    ]
  },
  {
    "uid": "QTS_597_013_01",
    "volume": 597,
    "author": {
      "canonical": "霍總",
      "recorded": "霍總"
    },
    "title": "塞下曲",
    "poem": [
      "曾當一面戰，頻出九重圍。",
      "但見爭鋒處，長須得勝歸。",
      "雪沾旗尾落，風斷節毛稀。",
      "豈要銘燕石，平生重武威。"
    ]
  },
  {
    "uid": "QTS_597_014_01",
    "volume": 597,
    "author": {
      "canonical": "霍總",
      "recorded": "霍總"
    },
    "title": "關山月",
    "poem": [
      "珠瓏翡翠床，白皙侍中郎。",
      "五日來花下，雙童問道傍。",
      "到門車馬狹，連夜管弦長。",
      "每笑東家子，窺他宋玉牆。"
    ]
  },
  {
    "uid": "QTS_597_015_01",
    "volume": 597,
    "author": {
      "canonical": "霍總",
      "recorded": "霍總"
    },
    "title": "驄馬",
    "poem": [
      "青驪八尺高，俠客倚雄豪。",
      "踏雪生珠汗，障泥護錦袍。",
      "路傍看驟影，鞍底卷旋毛。",
      "豈獨連錢貴，酬恩更代勞。"
    ]
  },
  {
    "uid": "QTS_597_016_01",
    "volume": 597,
    "author": {
      "canonical": "霍總",
      "recorded": "霍總"
    },
    "title": "雉朝飛",
    "poem": [
      "五色有名翬，清晨挾兩雌。",
      "羣羣飛自樂，步步飲相隨。",
      "覘葉逢人處，驚媒妒寵時。",
      "綠毛春鬬盡，強敵願君知。"
    ]
  },
  {
    "uid": "QTS_597_017_01",
    "volume": 597,
    "author": {
      "canonical": "霍總",
      "recorded": "霍總"
    },
    "title": "木芙蓉",
    "poem": [
      "本自江湖遠，常開霜露餘。",
      "爭春候穠李，得水異紅蕖。",
      "孤秀曾無偶，當門幸不鋤。",
      "誰能政搖落，繁綵照堦除。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "偶",
        "variant": "遇",
        "source": "一作「遇」"
      }
    ]
  },
  {
    "uid": "QTS_597_018_01",
    "volume": 597,
    "author": {
      "canonical": "霍總",
      "recorded": "霍總"
    },
    "title": "採蓮女",
    "poem": [
      "舟中採蓮女，兩兩催妝梳。",
      "聞早渡江去，日高來起居。"
    ]
  },
  {
    "uid": "QTS_597_019_01",
    "volume": 597,
    "author": {
      "canonical": "陳琡",
      "recorded": "陳琡"
    },
    "title": "別僧",
    "poem": [
      "行若獨輪車，常畏大道覆。",
      "止若員底器，常恐他物觸。",
      "行止既如此，安得不離俗。"
    ]
  },
  {
    "uid": "QTS_597_020_01",
    "volume": 597,
    "author": {
      "canonical": "裴虔餘",
      "recorded": "裴虔餘"
    },
    "title": "早春殘雪",
    "poem": [
      "霽日雕瓊彩，幽庭減夜寒。",
      "梅飄餘片積，日墮晚光殘。",
      "零落偏依桂，霏微不掩蘭。",
      "陰林披霧縠，小沼破冰盤。",
      "曲檻霜凝砌，疏篁玉碎竿。",
      "已聞三徑好，猶可訪袁安。"
    ]
  },
  {
    "uid": "QTS_597_021_01",
    "volume": 597,
    "author": {
      "canonical": "裴虔餘",
      "recorded": "裴虔餘"
    },
    "title": "柳枝詞詠篙水濺妓衣",
    "poem": [
      "半額微黃金縷衣，玉搔頭褭鳳雙飛。",
      "從教水濺羅裙濕，還道朝來行雨歸。"
    ],
