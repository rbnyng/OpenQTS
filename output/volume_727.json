  },
  {
    "uid": "QTS_727_047_02",
    "volume": 727,
    "author": {
      "canonical": "張直",
      "recorded": "張直"
    },
    "title": "宿顧城二首 其二",
    "poem": [
      "醉臥夜將半，土底聞雞啼。",
      "驚駭問主人，為我剖荒迷。",
      "武湯東伐韋，固君含悲淒。",
      "神奪悔悟魄，幻化為石雞。",
      "形骸僅盈寸，咿喔若啁蜺。",
      "吾村耕耘叟，多獲於鋤犁。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_727_048_01",
    "volume": 727,
    "author": {
      "canonical": "陳光",
      "recorded": "陳光",
      "gender": "male",
      "wikidata_id": "Q30018067"
    },
    "title": "題桃源僧",
    "poem": [
      "桃源有僧舍，跬步異人天。",
      "花亂似無主，鶴鳴疑有仙。",
      "軒廊明野色，松檜濕春煙。",
      "定擬辭塵境，依師過晚年。"
    ]
  }
]