        "variant": "客",
        "source": "一作「客」"
      }
    ]
  },
  {
    "uid": "QTS_727_034_01",
    "volume": 727,
    "author": {
      "canonical": "任翻",
      "recorded": "任翻"
    },
    "title": "冬暮野寺",
    "poem": [
      "江東寒近臘，野寺水天昏。",
      "無酒可銷夜，隨僧早閉門。",
      "照墻燈影短，著瓦雪聲繁。",
      "飄泊仍千里，清吟欲斷魂。"
    ]
  },
  {
    "uid": "QTS_727_035_01",
    "volume": 727,
    "author": {
      "canonical": "任翻",
      "recorded": "任翻"
    },
    "title": "贈濟禪師",
    "poem": [
      "碧峰秋寺內，禪客已無情。",
      "半頂髮根白，一生心地清。",
      "竹房侵月靜，石徑到門平。",
      "山下塵囂路，終年誓不行。"
    ]
  },
  {
    "uid": "QTS_727_036_01",
    "volume": 727,
    "author": {
      "canonical": "任翻",
      "recorded": "任翻"
    },
    "title": "經墮淚碑",
    "poem": [
      "羊公傳化地，千古事空存。",
      "碑已無文字，人猶敬子孫。",
      "峴山長閉恨，漢水自流恩。",
      "數處煙嵐色，分明是淚痕。"
    ]
  },
  {
    "uid": "QTS_727_037_01",
    "volume": 727,
    "author": {
      "canonical": "任翻",
      "recorded": "任翻"
    },
    "title": "長安冬夜書事",
    "poem": [
      "憂來長不寐，往事重思量。",
      "清渭幾年客，故衣今夜霜。",
      "春風誰識面，水國但牽腸。",
      "十二門車馬，昏明各自忙。"
    ]
  },
  {
    "uid": "QTS_727_038_01",
    "volume": 727,
    "author": {
      "canonical": "任翻",
      "recorded": "任翻"
    },
    "title": "越江漁父",
    "poem": [
      "借問釣魚者，持竿多少年？",
      "眼明汀島畔，頭白子孫前。",
      "櫂入花時浪，燈留雨夜船。",
      "越江深見底，誰識此心堅？"
    ]
  },
  {
    "uid": "QTS_727_039_01",
    "volume": 727,
    "author": {
      "canonical": "任翻",
      "recorded": "任翻"
    },
    "title": "哭友人",
    "poem": [
      "逢著南州史，江邊哭問君。",
      "送終時有雪，歸葬處無雲。",
      "官庫惟留劔，隣僧共結墳。",
      "兒孫未成立，誰與集遺文？"
    ]
  },
  {
    "uid": "QTS_727_040_01",
    "volume": 727,
    "author": {
      "canonical": "任翻",
      "recorded": "任翻"
    },
    "title": "送李衡",
    "poem": [
      "羇棲親故少，逺別惜清才。",
      "天畔出相送，路長知未迴。",
      "欲銷今日恨，強把異鄉杯。",
      "君去南堂後，應無客到來。"
    ]
  },
  {
    "uid": "QTS_727_041_01",
    "volume": 727,
    "author": {
      "canonical": "任翻",
      "recorded": "任翻"
    },
    "title": "宮怨",
    "poem": [
      "淚幹紅落臉，心盡白垂頭。",
      "自此方知怨，從來豈信愁。"
    ]
  },
  {
    "uid": "QTS_727_042_01",
    "volume": 727,
    "author": {
      "canonical": "任翻",
      "recorded": "任翻"
    },
    "title": "惜花",
    "poem": [
      "無語與花別，細看枝上紅。",
      "明年又相見，還恐是愁中。"
    ]
  },
  {
    "uid": "QTS_727_043_01",
    "volume": 727,
    "author": {
      "canonical": "任翻",
      "recorded": "任翻"
    },
    "title": "宿巾子山禪寺",
    "poem": [
      "絕頂新秋生夜涼，鶴翻鬆露滴衣裳。",
      "前峰月映半江水，僧在翠微開竹房。"
    ]
  },
  {
    "uid": "QTS_727_044_01",
    "volume": 727,
    "author": {
      "canonical": "任翻",
      "recorded": "任翻"
    },
    "title": "再遊巾子山寺",
    "poem": [
      "靈江江上幘峰寺，三十年來兩度登。",
      "野鶴尚巢松樹徧，竹房不見舊時僧。"
    ]
  },
  {
    "uid": "QTS_727_045_01",
    "volume": 727,
    "author": {
      "canonical": "任翻",
      "recorded": "任翻"
    },
    "title": "三遊巾子山寺感述",
    "poem": [
      "清秋絕頂竹房開，松鶴何年去不迴。",
      "惟有前峰明月在，夜深猶過半江來。"
    ]
  },
  {
    "uid": "QTS_727_046_01",
    "volume": 727,
    "author": {
      "canonical": "荊浩",
      "recorded": "荊浩",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Jing Hao",
      "wikidata_id": "Q2665475"
    },
    "title": "畫山水圖荅大愚",
    "poem": [
      "恣意縱橫埽，峰巒次第成。",
      "筆尖寒樹瘦，墨澹野雲輕。",
      "巖石噴泉窄，山根到水平。",
      "禪房時一展，兼稱苦空情。"
    ]
  },
  {
    "uid": "QTS_727_047_01",
    "volume": 727,
    "author": {
      "canonical": "張直",
      "recorded": "張直"
    },
    "title": "宿顧城二首 其一",
    "poem": [
      "綠草展青裀，樾影連春樹。",
      "茅屋八九家，農器六七具。",
      "主人有好懷，搴衣留我住。",
      "春酒新醱醅，香美連糟濾。",
      "一醉臥花陰，明朝送君去。"
    ],
    "notes": [
      {
        "content": "顧城在范縣東。",
        "context": "宿顧城二首",
        "original_title": "宿顧城二首",
