[
  {
    "uid": "QTS_863_001_01",
    "volume": 863,
    "author": {
      "canonical": "張雲容",
      "recorded": "張雲容"
    },
    "title": "與薛昭合婚詩",
    "poem": [
      "臉花不綻幾含幽，今夕陽春獨換秋。",
      "我守孤燈無白日，寒雲隴上更添愁。",
      "幽谷啼鶯整羽翰，犀沈玉冷自長歎。",
      "月華不向扃泉戶，露滴松枝一夜寒。",
      "韶光不見分成塵，曾餌金丹忽有神。",
      "不意薛生攜舊律，獨開幽谷一枝春。",
      "誤入宮垣漏網人，月華靜洗玉階塵。",
      "自疑飛到蓬萊頂，瓊豔三枝半夜春。"
    ]
  },
  {
    "uid": "QTS_863_002_01",
    "volume": 863,
    "author": {
      "canonical": "崔少玄",
      "recorded": "崔少玄"
    },
    "title": "留別盧陲",
    "poem": [
      "得之一元，匪受自天。",
      "太老之真，無上之仙。",
      "光含影藏，形於自然。",
      "真安匪求，神之久留。",
      "淑美其真，體性剛柔。",
      "丹霄碧虛，上聖之儔。",
      "百歲之後，空餘墳丘。"
    ]
  },
  {
    "uid": "QTS_863_003_01",
    "volume": 863,
    "author": {
      "canonical": "戚逍遙",
      "recorded": "戚逍遙"
    },
    "title": "歌",
    "poem": [
      "笑看滄海欲成塵，王母花前別眾真。",
      "千歲卻歸天上去，一心珍重世間人。"
    ]
  },
  {
    "uid": "QTS_863_004_01",
    "volume": 863,
    "author": {
      "canonical": "卓英英",
      "recorded": "卓英英"
    },
    "title": "錦城春望",
    "poem": [
      "和風裝點錦城春，細雨如絲壓玉塵。",
      "漫把詩情訪奇景，豔花濃酒屬閒人。"
    ]
  },
  {
    "uid": "QTS_863_005_01",
    "volume": 863,
    "author": {
      "canonical": "卓英英",
      "recorded": "卓英英"
    },
    "title": "理笙",
    "poem": [
      "頻倚銀屏理鳳笙，調中幽意起春情。",
      "因思往事成惆悵，不得緱山和一聲。"
    ]
  },
  {
    "uid": "QTS_863_006_01",
    "volume": 863,
    "author": {
      "canonical": "卓英英",
      "recorded": "卓英英"
    },
    "title": "遊福感寺答少年",
    "poem": [
      "牡丹未及開時節，況是秋風莫近前。",
      "留待來年二三月，一枝和露壓神仙。"
    ]
  },
  {
    "uid": "QTS_863_007_01",
    "volume": 863,
    "author": {
      "canonical": "卓英英",
      "recorded": "卓英英"
    },
    "title": "答玄士",
    "poem": [
      "數載幽欄種牡丹，裹香包豔待神仙。",
      "神仙既有丹青術，攜取何妨入洞天。"
    ]
  },
  {
    "uid": "QTS_863_008_01",
    "volume": 863,
    "author": {
      "canonical": "眉娘",
      "recorded": "眉娘",
      "gender": "female"
    },
    "title": "和卓英英錦城春望",
    "poem": [
      "蠶市初開處處春，九衢明豔起香塵。",
      "世間總有浮華事，爭及仙山出世人。"
    ]
  },
  {
    "uid": "QTS_863_009_01",
    "volume": 863,
    "author": {
      "canonical": "眉娘",
      "recorded": "眉娘",
      "gender": "female"
    },
    "title": "和卓英英理笙",
    "poem": [
      "但於閨閣熟吹笙，太白真仙自有情。",
      "他日丹霄驂白鳳，何愁子晉不聞聲。"
    ]
  },
  {
    "uid": "QTS_863_010_01",
    "volume": 863,
    "author": {
      "canonical": "眉娘",
      "recorded": "眉娘",
      "gender": "female"
    },
    "title": "附：太白山玄士畫地吟",
    "poem": [
      "學得丹青數萬年，人間幾度變桑田。",
      "桑田雖變丹青在，誰向丹青合得仙。"
    ]
  },
  {
    "uid": "QTS_863_011_01",
    "volume": 863,
    "author": {
      "canonical": "洛川仙女",
      "recorded": "洛川仙女",
      "gender": "female"
    },
    "title": "答張鬱歌",
    "poem": [
      "彩雲入帝鄉，白鶴又迴翔。",
      "久留深不可，蓬島路遐長。",
      "空愛長生術，不是長生人。",
      "今日洛川別，可惜洞中春。"
    ]
  },
  {
    "uid": "QTS_863_012_01",
    "volume": 863,
    "author": {
      "canonical": "洛川仙女",
      "recorded": "洛川仙女",
      "gender": "female"
    },
    "title": "附：張郁洛川沿步吟",
    "poem": [
      "浮生如夢能幾何，浮生複更憂患多。",
      "無人與我長生術，洛川春日且長歌。"
    ]
  },
  {
    "uid": "QTS_863_013_01",
    "volume": 863,
    "author": {
      "canonical": "南溟夫人",
      "recorded": "南溟夫人",
      "gender": "female"
    },
    "title": "題玉壺贈元柳二子",
    "poem": [
      "來從一葉舟中來，去向百花橋上去。",
      "若到人間扣玉壺，鴛鴦自解分明語。"
    ]
  },
  {
    "uid": "QTS_863_014_01",
    "volume": 863,
    "author": {
      "canonical": "雲臺峯五女仙",
      "recorded": "雲臺峯五女仙",
      "gender": "female"
    },
    "title": "會真詩",
    "poem": [
      "人世徒紛擾，其生似夢華。",
      "誰言今昔裏，俯首視雲霞。"
    ]
  },
  {
    "uid": "QTS_863_015_01",
    "volume": 863,
    "author": {
      "canonical": "雲臺峯五女仙",
      "recorded": "雲臺峯五女仙",
      "gender": "female"
    },
    "title": "會真詩",
    "poem": [
      "幾劫澄煩思，今身僅小成。",
      "誓將雲外隱，不向世間存。"
    ]
  },
  {
    "uid": "QTS_863_016_01",
    "volume": 863,
    "author": {
      "canonical": "雲臺峯五女仙",
      "recorded": "雲臺峯五女仙",
      "gender": "female"
    },
    "title": "會真詩",
    "poem": [
      "綽約離塵世，從容上太清。",
      "雲衣無綻日，鶴駕沒遙程。"
    ]
  },
  {
    "uid": "QTS_863_017_01",
    "volume": 863,
    "author": {
      "canonical": "雲臺峯五女仙",
      "recorded": "雲臺峯五女仙",
      "gender": "female"
    },
    "title": "會真詩",
    "poem": [
      "華嶽無三尺，東瀛僅一杯。",
      "入雲騎彩鳳，歌舞上蓬萊。"
    ]
  },
  {
    "uid": "QTS_863_018_01",
    "volume": 863,
    "author": {
      "canonical": "雲臺峯五女仙",
      "recorded": "雲臺峯五女仙",
      "gender": "female"
    },
    "title": "會真詩",
    "poem": [
      "共作雲山侶，俱辭世界塵。",
      "靜思前日事，拋卻幾年身。"
    ]
  },
  {
    "uid": "QTS_863_019_01",
    "volume": 863,
    "author": {
      "canonical": "吳清妻",
      "recorded": "吳清妻",
      "gender": "female"
    },
    "title": "仙詩五首 其一",
    "poem": [
      "道啟真心覺漸清，天教絕粒應精誠。",
      "雲外仙歌笙管合，花間風引步虛聲。"
    ],
    "part_index": 1,
    "total_parts": 5
  },
  {
    "uid": "QTS_863_019_02",
    "volume": 863,
    "author": {
      "canonical": "吳清妻",
      "recorded": "吳清妻",
      "gender": "female"
    },
    "title": "仙詩五首 其二",
    "poem": [
      "□□□□□□□，□君隱處當一星。",
      "□□蓮花山頭飯，黃精仙人掌上經。"
    ],
    "part_index": 2,
    "total_parts": 5
  },
  {
    "uid": "QTS_863_019_03",
    "volume": 863,
    "author": {
      "canonical": "吳清妻",
      "recorded": "吳清妻",
      "gender": "female"
    },
    "title": "仙詩五首 其三",
    "poem": [
      "飛鳥莫到人莫攀，一隱十年不下山。",
      "袖中短書誰為達，華山道士賣藥還。"
    ],
    "part_index": 3,
    "total_parts": 5
  },
  {
    "uid": "QTS_863_019_04",
    "volume": 863,
    "author": {
      "canonical": "吳清妻",
      "recorded": "吳清妻",
      "gender": "female"
    },
    "title": "仙詩五首 其四",
    "poem": [
      "日落焚香坐醮壇，庭花露濕漸更闌。",
      "淨水仙童調玉液，春宵羽客化金丹。"
    ],
    "part_index": 4,
    "total_parts": 5
  },
  {
    "uid": "QTS_863_019_05",
    "volume": 863,
    "author": {
      "canonical": "吳清妻",
      "recorded": "吳清妻",
      "gender": "female"
    },
    "title": "仙詩五首 其五",
    "poem": [
      "攝念精思引彩霞，焚香虛室對煙花。",
      "道合雲霄遊紫府，湛然真境瑞皇家。"
    ],
    "part_index": 5,
    "total_parts": 5
  },
  {
    "uid": "QTS_863_020_01",
    "volume": 863,
    "author": {
      "canonical": "上元夫人",
      "recorded": "上元夫人",
      "gender": "female",
      "period": "High Tang"
    },
    "title": "贈封陟",
    "poem": [
      "謫居蓬島別瑤池，春媚煙花有所思。",
      "為愛君心能潔白，願操箕帚奉屏幃。"
    ]
  },
  {
    "uid": "QTS_863_021_01",
    "volume": 863,
    "author": {
      "canonical": "上元夫人",
      "recorded": "上元夫人",
      "gender": "female",
      "period": "High Tang"
    },
    "title": "再贈",
    "poem": [
      "弄玉有夫皆得道，劉綱兼室盡登仙。",
      "君能仔細窺朝露，須逐雲車拜洞天。"
    ]
  },
  {
    "uid": "QTS_863_022_01",
    "volume": 863,
    "author": {
      "canonical": "上元夫人",
      "recorded": "上元夫人",
      "gender": "female",
      "period": "High Tang"
    },
    "title": "留別",
    "poem": [
      "蕭郎不顧鳳樓人，雲澀回車淚臉新。",
      "愁想蓬瀛歸去路，難窺舊苑碧桃春。"
    ]
  },
  {
    "uid": "QTS_863_023_01",
    "volume": 863,
    "author": {
      "canonical": "慈恩塔院女仙",
      "recorded": "慈恩塔院女仙",
      "gender": "female"
    },
    "title": "題寺廊柱",
    "poem": [
      "皇子陂頭好月明，忘卻華筵到曉行。",
      "煙收山低翠黛橫，折得荷花遠恨生。",
      "湖水團團夜如鏡，碧樹紅花相掩映。",
      "北斗闌幹移曉柄，有似佳期常不定。"
    ]
  },
  {
    "uid": "QTS_863_024_01",
    "volume": 863,
    "author": {
      "canonical": "蜀宮群仙",
      "recorded": "蜀宮群仙",
      "gender": "male"
    },
    "title": "後土夫人",
    "poem": [
      "偶引群仙到世間，熏風殿裏醉華筵。",
      "等閒貪賞不歸去，愁殺韋郎一覺眠。"
    ]
  },
  {
    "uid": "QTS_863_025_01",
    "volume": 863,
    "author": {
      "canonical": "蜀宮群仙",
      "recorded": "蜀宮群仙",
      "gender": "male"
    },
    "title": "王母",
    "poem": [
      "滄海成塵幾萬秋，碧桃花發長春愁。",
      "不來便是數千載，周穆漢皇何處遊。"
    ]
  },
  {
    "uid": "QTS_863_026_01",
    "volume": 863,
    "author": {
      "canonical": "蜀宮群仙",
      "recorded": "蜀宮群仙",
      "gender": "male"
    },
    "title": "麻姑",
    "poem": [
      "世間何事不潸然，得失人情命不延。",
      "適向蔡家廳上飲，回頭已見一千年。"
    ]
  },
  {
    "uid": "QTS_863_027_01",
    "volume": 863,
    "author": {
      "canonical": "蜀宮群仙",
      "recorded": "蜀宮群仙",
      "gender": "male"
    },
    "title": "上元夫人",
    "poem": [
      "思量往事一愁容，阿母曾邀到漢宮。",
      "城闕不存人不見，茂陵荒草恨無窮。"
    ]
  },
  {
    "uid": "QTS_863_028_01",
    "volume": 863,
    "author": {
      "canonical": "蜀宮群仙",
      "recorded": "蜀宮群仙",
      "gender": "male"
    },
    "title": "弄玉",
    "poem": [
      "采鳳飛來到禁闈，便隨王母駐瑤池。",
      "如今記得秦樓上，偷見蕭郎惱妾時。"
    ]
  },
  {
    "uid": "QTS_863_029_01",
    "volume": 863,
    "author": {
      "canonical": "蜀宮群仙",
      "recorded": "蜀宮群仙",
      "gender": "male"
    },
    "title": "太真",
    "poem": [
      "春夢悠揚生下界，一堪成笑一堪悲。",
      "馬嵬不是無情地，自遇蓬萊睡覺時。"
    ]
  },
  {
    "uid": "QTS_863_030_01",
    "volume": 863,
    "author": {
      "canonical": "織女",
      "recorded": "織女",
      "gender": "female"
    },
    "title": "贈郭翰二首 其一",
    "poem": [
      "河漢雖雲闊，三秋尚有期。",
      "情人終已矣，良會更何時。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_863_030_02",
    "volume": 863,
    "author": {
      "canonical": "織女",
      "recorded": "織女",
      "gender": "female"
    },
    "title": "贈郭翰二首 其二",
    "poem": [
      "朱閣臨清溪，瓊宮銜紫房。",
      "佳情期在此，只是斷人腸。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_863_031_01",
    "volume": 863,
    "author": {
      "canonical": "織女",
      "recorded": "織女",
      "gender": "female"
    },
    "title": "附：郭翰酬織女",
    "poem": [
      "人世將天上，由來不可期。",
      "誰知一回顧，更作兩相思。",
      "贈枕猶香澤，啼衣尚淚痕。",
      "玉顏霄漢裏，空有往來魂。"
    ]
  },
  {
    "uid": "QTS_863_032_01",
    "volume": 863,
    "author": {
      "canonical": "蒿山女",
      "recorded": "蒿山女",
      "gender": "female"
    },
    "title": "書任生案",
    "poem": [
      "我本籍上清，謫居遊五嶽。",
      "以君無俗累，來勸神仙學。",
      "葛洪還有婦，王母亦有夫。",
      "神仙盡靈匹，君意合何如。"
    ]
  },
  {
    "uid": "QTS_863_033_01",
    "volume": 863,
    "author": {
      "canonical": "蒿山女",
      "recorded": "蒿山女",
      "gender": "female"
    },
    "title": "臨去書贈",
    "poem": [
      "君子既執迷，無由達情素。",
      "明月海山上，秋風獨歸去。"
    ]
  },
  {
    "uid": "QTS_863_034_01",
    "volume": 863,
    "author": {
      "canonical": "青童",
      "recorded": "青童"
    },
    "title": "與趙旭叩柱歌",
    "poem": [
      "白雲飄飄星漢斜，獨行窈窕浮雲車。",
      "仙郎獨邀青童君，結情羅帳連心花。"
    ]
  },
  {
    "uid": "QTS_863_035_01",
    "volume": 863,
    "author": {
      "canonical": "觀梅女仙",
      "recorded": "觀梅女仙",
      "gender": "female"
    },
    "title": "題壁",
    "poem": [
      "南枝向暖北枝寒，一種春花有兩般。",
      "憑仗高樓莫吹笛，大家留取倚闌看。"
    ]
  },
  {
    "uid": "QTS_863_036_01",
    "volume": 863,
    "author": {
      "canonical": "吳彩鸞",
      "recorded": "吳彩鸞",
      "gender": "female",
      "english_name": "Wu Cailuan",
      "wikidata_id": "Q17023424"
    },
    "title": "歌",
    "poem": [
      "若能相伴陟仙壇，應得文簫駕彩鸞。",
      "自有繡襦並甲帳，瑤台不怕雪霜寒。"
    ]
  },
  {
    "uid": "QTS_863_037_01",
    "volume": 863,
    "author": {
      "canonical": "王氏女",
      "recorded": "王氏女",
      "gender": "female"
    },
    "title": "臨化絕句",
    "poem": [
      "玩水登山無足時，諸仙頻下聽吟詩。",
      "此心不戀居人世，唯見天邊雙鶴飛。"
    ]
  },
  {
    "uid": "QTS_863_038_01",
    "volume": 863,
    "author": {
      "canonical": "毛女正美",
      "recorded": "毛女正美",
      "gender": "female"
    },
    "title": "贈華山遊人",
    "poem": [
      "藥苗不滿笥，又更上危巔。",
      "回首歸去路，相將入翠煙。",
      "曾折松枝為寶櫛，又編栗葉代羅襦。",
      "有時問卻秦宮事，笑撚山花望太虛。"
    ]
  },
  {
    "uid": "QTS_863_039_01",
    "volume": 863,
    "author": {
      "canonical": "桃花夫人",
      "recorded": "桃花夫人",
      "gender": "female"
    },
    "title": "在紫霄夫人席上作",
    "poem": [
      "昔時訓子西河上，漢使經過問妾緣。",
      "自到仙山不知老，凡間喚作幾千年。"
