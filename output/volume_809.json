      "recorded": "靈一",
      "gender": "male"
    },
    "title": "送王法師之西川",
    "poem": [
      "旅遊無近遠，要自別魂銷。",
      "官柳鄉愁亂，春山客路遙。",
      "伴行芳草遠，緣興野花飄。",
      "計日功成後，還將輔聖朝。"
    ],
    "variants": [
