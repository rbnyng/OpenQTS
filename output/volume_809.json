      }
    ]
  },
  {
    "uid": "QTS_809_039_01",
    "volume": 809,
    "author": {
      "canonical": "靈一",
      "recorded": "靈一",
      "gender": "male"
    },
    "title": "將出宜豐寺留題山房",
    "poem": [
      "池上蓮荷不自開，山中流水偶然來。",
      "若言聚散定由我，未是回時那得回。"
    ],
    "variants": [
      {
