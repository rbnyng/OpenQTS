    "title": "江行寄張舍人",
    "poem": [
      "客程終日風塵苦，蓬轉還家未有期。",
      "林色曉分殘雪後，角聲寒奏落帆時。",
      "月高星使東看遠，雲破霜鴻北度遲。",
      "流蕩此心難共說，千峰澄霽隔瓊枝。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "鴻北",
        "variant": "逢欲",
        "source": "一作「逢欲」"
      }
    ]
  },
  {
    "uid": "QTS_809_009_01",
    "volume": 809,
    "author": {
