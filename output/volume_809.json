  },
  {
    "uid": "QTS_809_025_01",
    "volume": 809,
    "author": {
      "canonical": "靈一",
      "recorded": "靈一",
      "gender": "male"
    },
    "title": "酬陳明府舟中見贈",
    "poem": [
      "長溪通夜靜，素舸與人閒。",
      "月影沈秋水，風聲落暮山。",
      "稻花千頃外，蓮葉兩河間。",
      "陶令多真意，相思一解顏。"
    ]
  },
  {
    "uid": "QTS_809_026_01",
    "volume": 809,
    "author": {
