  {
    "uid": "QTS_809_040_01",
    "volume": 809,
    "author": {
      "canonical": "靈一",
      "recorded": "靈一",
      "gender": "male"
    },
    "title": "妙樂觀",
    "poem": [
      "王喬所居空山觀，白雲至今凝不散。",
      "壇場月路幾千年，往往吹笙下天半。",
      "瀑布西行過石橋，黃精采根還採苗。",
      "忽見一人檠茶椀，篸花昨夜風吹滿。",
      "自言家處在東坡，白犬相隨邀我過。",
      "松間石上有棋局，能使樵人爛斧柯。"
    ],
    "variants": [
      {
        "line": 4,
        "text": "篸",
        "variant": "蓼",
        "source": "一作「蓼」"
      }
    ]
  },
  {
    "uid": "QTS_809_041_01",
    "volume": 809,
    "author": {
      "canonical": "靈一",
      "recorded": "靈一",
      "gender": "male"
    },
    "title": "與元居士青山潭飲茶",
    "poem": [
      "野泉煙火白雲間，坐飲香茶愛此山。",
      "巖下維舟不忍去，青溪流水暮潺潺。"
    ]
  },
  {
    "uid": "QTS_809_042_01",
    "volume": 809,
    "author": {
      "canonical": "靈一",
      "recorded": "靈一",
      "gender": "male"
    },
    "title": "送人得蕩子歸倡婦",
    "poem": [
      "垂涕憑回信，為語柳園人。",
      "情知獨難守，又是一陽春。"
    ]
  },
