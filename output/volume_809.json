      "recorded": "靈一",
      "gender": "male"
    },
    "title": "送陳允初卜居麻園",
    "poem": [
      "欲向麻源隱，能尋謝客蹤。",
      "空山幾千里，幽谷第三重。",
      "茅宇寧須葺，荷衣不待縫。",
      "因君見往事，為我謝喬松。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "茅",
        "variant": "巖",
        "source": "一作「巖」"
      }
    ]
  },
  {
    "uid": "QTS_809_033_01",
    "volume": 809,
    "author": {
      "canonical": "靈一",
      "recorded": "靈一",
      "gender": "male"
    },
    "title": "秋題劉逸人林泉",
    "poem": [
      "涼飆亂黃葉，遲客橘陰清。",
      "蘿徑封行跡，雲門閉野情。",
      "零林秋露響，穿竹暮煙輕。",
      "莫戀幽棲地，懷安卻敗名。"
    ]
  },
  {
    "uid": "QTS_809_034_01",
    "volume": 809,
    "author": {
      "canonical": "靈一",
      "recorded": "靈一",
      "gender": "male"
    },
    "title": "自大林與韓明府歸郭中精舍",
    "poem": [
      "野客同舟楫，相攜復一歸。",
      "孤煙生暮景，遠岫帶春暉。",
      "不道還山是，誰雲向郭非。",
      "禪門有通隱，喧寂共忘機。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "煙",
        "variant": "雲",
        "source": "一作「雲」"
      }
    ]
  },
  {
    "uid": "QTS_809_035_01",
    "volume": 809,
    "author": {
      "canonical": "靈一",
      "recorded": "靈一",
      "gender": "male"
    },
    "title": "同使君宿大樑驛",
    "poem": [
      "旌旗江上出，花外捲簾空。",
      "夜色臨城月，春寒度水風。",
      "雖然行李別，且喜語音同。",
      "若問匡廬事，終身媿遠公。"
    ],
    "notes": [
      {
        "content": "與清江喜皇甫大夫同宿大梁驛詩小異",
        "context": "同使君宿大樑驛",
        "original_title": "同使君宿大樑驛",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_809_036_01",
    "volume": 809,
    "author": {
      "canonical": "靈一",
      "recorded": "靈一",
      "gender": "male"
    },
    "title": "題黃公陶翰別業",
    "poem": [
      "聞說花源堪避秦，幽尋數月不逢人。",
      "煙霞洞裏無雞犬，風雨林間有鬼神。",
      "黃公石上三芝秀，陶令門前五柳春。",
      "醉臥白雲閑入夢，不知何物是吾身。"
    ],
    "notes": [
      {
        "content": "一作處一詩，一作蘇廣文詩，題云：「自商山宿陶令隱居。」",
        "context": "題黃公陶翰別業",
        "original_title": "題黃公陶翰別業",
        "type": "footnote"
      }
    ],
