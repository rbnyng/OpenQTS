  {
    "uid": "QTS_809_022_01",
    "volume": 809,
    "author": {
      "canonical": "靈一",
      "recorded": "靈一",
      "gender": "male"
    },
    "title": "送範律師往果州",
    "poem": [
      "終南千古後，獨爾繼卿名。",
      "離障非今日，修因是幾生。",
      "亂峰寒影暮，深澗野流清。",
      "遠客歸心苦，難為此別情。"
    ]
  },
  {
    "uid": "QTS_809_023_01",
    "volume": 809,
    "author": {
