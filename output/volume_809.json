      }
    ]
  },
  {
    "uid": "QTS_809_019_01",
    "volume": 809,
    "author": {
      "canonical": "靈一",
      "recorded": "靈一",
      "gender": "male"
    },
    "title": "送別",
    "poem": [
      "憑高莫送遠，看欲斷歸心。",
      "別恨啼猨苦，相思流水深。",
      "翠雲南澗影，丹桂晚山陰。",
      "若未來雙鵠，遼城何更尋。"
    ]
  },
  {
    "uid": "QTS_809_020_01",
    "volume": 809,
    "author": {
