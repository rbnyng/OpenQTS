      }
    ]
  },
  {
    "uid": "QTS_106_006_03",
    "volume": 106,
    "author": {
      "canonical": "鄭愔",
      "recorded": "鄭愔"
    },
    "title": "奉和幸上官昭容院獻詩四首 其三",
    "poem": [
      "宮掖賢才重，山林高尚難。",
      "不言辭輦地，更有結廬歡。",
      "池棟清溫燠，巖窗起沍寒。",
      "幽亭有仙桂，聖主萬年看。"
    ],
    "part_index": 3,
    "total_parts": 4
  },
  {
    "uid": "QTS_106_006_04",
    "volume": 106,
    "author": {
      "canonical": "鄭愔",
      "recorded": "鄭愔"
    },
    "title": "奉和幸上官昭容院獻詩四首 其四",
    "poem": [
      "槎流天上轉，茅宇禁中開。",
      "河鵲填橋至，山熊避檻來。",
      "庭花采菉蓐，巖石步莓苔。",
      "願奉輿圖泰，長開錦翰裁。"
    ],
    "part_index": 4,
    "total_parts": 4
  },
  {
    "uid": "QTS_106_007_01",
    "volume": 106,
    "author": {
      "canonical": "鄭愔",
      "recorded": "鄭愔"
    },
    "title": "送金城公主適西蕃應制",
    "poem": [
      "下嫁戎庭遠，和親漢禮優。",
      "笳聲出虜塞，簫曲背秦樓。",
      "貴主悲黃鶴，征人怨紫騮。",
      "皇情眷億兆，割念俯懷柔。"
    ]
  },
  {
    "uid": "QTS_106_008_01",
    "volume": 106,
    "author": {
      "canonical": "鄭愔",
      "recorded": "鄭愔"
    },
    "title": "奉和幸望春宮送朔方大總管張仁亶",
    "poem": [
      "御蹕下都門，軍麾出塞垣。",
      "長楊跨武騎，細柳接戎軒。",
      "睿曲風雲動，邊威鼓吹喧。",
      "坐帷將閫外，俱是報明恩。"
    ]
  },
  {
    "uid": "QTS_106_009_01",
    "volume": 106,
    "author": {
      "canonical": "鄭愔",
      "recorded": "鄭愔"
    },
    "title": "奉和九月九日登慈恩寺浮圖應制",
    "poem": [
      "湧霄開寶塔，倒影駐仙輿。",
      "鴈子乘堂處，龍王起藏初。",
      "秋風聖主曲，佳氣史官書。",
      "願獻重陽壽，承歡萬歲餘。"
    ]
  },
  {
    "uid": "QTS_106_010_01",
    "volume": 106,
    "author": {
      "canonical": "鄭愔",
      "recorded": "鄭愔"
    },
    "title": "銅雀妓",
    "poem": [
      "日斜漳浦望，風起鄴臺寒。",
      "玉座平生晚，金尊妓吹闌。",
      "舞餘依帳泣，歌罷向陵看。",
      "蕭索松風暮，愁煙入井闌。"
    ]
  },
  {
    "uid": "QTS_106_011_01",
    "volume": 106,
    "author": {
      "canonical": "鄭愔",
      "recorded": "鄭愔"
    },
    "title": "胡笳曲",
    "poem": [
      "漢將留邊朔，遙遙歲序深。",
      "誰堪牧馬思，正是胡笳吟。",
      "曲斷關山月，聲悲雨雪陰。",
      "傳書問蘇武，陵也獨何心。"
    ],
    "variants": [
