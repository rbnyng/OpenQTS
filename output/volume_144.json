    "title": "江上琴興",
    "poem": [
      "江上調玉琴，一弦清一心。",
      "泠泠七弦遍，萬木澄幽陰。",
      "能使江月白，又令江水深。",
      "始知梧桐枝，可以徽黃金。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "陰",
        "variant": "音",
        "source": "一作「音」"
      }
