    "volume": 800,
    "author": {
      "canonical": "晁采",
      "recorded": "晁采",
      "gender": "female"
    },
    "title": "子夜歌十八首 其十七",
    "poem": [
      "輕巾手自製，顏色爛含桃。",
      "先懷儂袖裏，然後約郎腰。"
    ],
    "part_index": 17,
    "total_parts": 18
  },
  {
