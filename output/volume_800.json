    "volume": 800,
    "author": {
      "canonical": "晁采",
      "recorded": "晁采",
      "gender": "female"
    },
    "title": "子夜歌十八首 其十八",
    "poem": [
      "儂贈綠絲衣，郎遺玉鉤子。",
      "即欲繫儂心，儂思著郎體。"
    ],
    "part_index": 18,
    "total_parts": 18
  },
  {
