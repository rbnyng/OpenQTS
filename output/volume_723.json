  {
    "uid": "QTS_723_049_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "金陵懷古",
    "poem": [
      "古來無此戰爭功，日日戈船卷海風。",
      "一遇靈鼇開睡眼，六朝灰盡九江空。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "遇",
        "variant": "度",
        "source": "一作「度」"
      }
    ]
  },
  {
    "uid": "QTS_723_050_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "長安縣廳",
    "poem": [
      "主人寂寞客屯邅，愁絕終南滿案前。",
      "乞取中庭藤五尺，為君高斸扣青天。"
    ],
    "variants": [
