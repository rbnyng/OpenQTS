    ]
  },
  {
    "uid": "QTS_723_055_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "山居喜友人見訪",
    "poem": [
      "入雲晴斸茯苓還，日暮逢迎木石間。",
      "看待詩人無別物，半潭秋水一房山。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "水",
        "variant": "燒",
        "source": "一作「燒」"
      }
    ]
  },
  {
    "uid": "QTS_723_056_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "秋宿長安韋主簿廳",
    "poem": [
      "水木清涼夜直廳，愁人樓上唱寒更。",
      "坐勞同步簾前月，鼠動牀頭印鎖聲。"
    ]
  },
  {
    "uid": "QTS_723_057_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "冬憶友人",
    "poem": [
      "吟上山前數竹枝，葉翻似雪落霏霏。",
      "枕前明月誰動影？睡裏驚來不覺歸。"
    ]
  },
  {
    "uid": "QTS_723_058_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "懷圭峰影林泉",
    "poem": [
      "吾家舊物賈生傳，入內遙分錫杖泉。",
      "鶴去帝移宮女散，更堪嗚咽過樓前。"
    ]
  },
  {
    "uid": "QTS_723_059_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "贈青龍印禪師",
    "poem": [
      "雨澀秋刀剃雪時，菴前曾禮草堂師。",
      "居人昨日相過說，鶴已生孫竹滿池。"
    ]
  },
  {
    "uid": "QTS_723_060_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "戲贈侯常侍",
    "poem": [
      "葛洪卷與江淹賦，名動天邊傲石居。",
      "兩蜀詞人多載後，同君諱卻馬相如。"
    ]
  },
  {
    "uid": "QTS_723_061_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "繡嶺宮詞",
    "poem": [
      "春日遲遲春草緑，野棠開盡飄香玉。",
      "繡嶺宮前鶴髮翁，猶唱開元太平曲。"
    ],
