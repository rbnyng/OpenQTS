      }
    ]
  },
  {
    "uid": "QTS_723_043_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "上靈州令狐相公",
    "poem": [
      "征蠻破虜漢功臣，提劔歸來萬里身。",
      "笑倚凌煙金柱看，形容憔悴老於真。"
    ],
    "variants": [
