    ]
  },
  {
    "uid": "QTS_723_044_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "寓言",
    "poem": [
      "三千宮女露蛾眉，笑煮黃金日月遲。",
      "麟鳳隔雲攀不及，空山惆悵夕陽時。"
    ]
  },
  {
    "uid": "QTS_723_045_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "客亭對月",
    "poem": [
      "遊子離魂隴上花，風飄浪捲遶天涯。",
      "一年十二度圓月，十一回圓不在家。"
    ]
  },
  {
    "uid": "QTS_723_046_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "宿鄠郊贈羅處士",
    "poem": [
      "川靜星高櫟已枯，南山落石水聲麤。",
      "白雲釣客窻中宿，臥數嵩峯聽五湖。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "櫟",
        "variant": "栗",
        "source": "一作「栗」"
      }
    ]
  },
  {
    "uid": "QTS_723_047_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "有寄",
    "poem": [
      "愛酒耽棊田處士，彈琴詠史賈先生。",
      "御溝臨岸有雲石，不見鶴來何處行。"
    ]
  },
  {
    "uid": "QTS_723_048_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "送三藏歸西天國",
    "poem": [
      "十萬里程多少磧，沙中彈舌授降龍。",
      "五天到日應頭白，月落長安半夜鐘。"
    ],
