[
  {
    "uid": "QTS_723_001_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "贈曹郎中崇賢所居",
    "poem": [
      "閒坊宅枕穿宮水，聽水分衾蓋蜀繒。",
      "藥杵聲中擣殘夢，茶鐺影裏煮孤燈。",
      "刑曹樹蔭千年井，華嶽樓開萬仞氷。",
      "詩句變風官漸緊，夜濤舂斷海邊藤。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "蓋蜀繒",
        "variant": "盡蜀僧",
        "source": "一作「盡蜀僧」"
      }
    ]
  },
  {
    "uid": "QTS_723_002_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "贈昭應沈少府",
    "poem": [
      "行宮接縣判雲泉，袍色雖青骨且仙。",
      "鄠杜憶過梨栗墅，瀟湘曾棹雪霜天。",
      "華山僧別留茶鼎，渭水人來鎖釣船。",
      "東送西迎終幾考，新詩覓得兩三聯。"
    ]
  },
  {
    "uid": "QTS_723_003_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "上司空員外",
    "poem": [
      "禪心高臥似疎慵，詩客經過不厭重。",
      "藤杖幾攜量磧雪，玉鞭曾把數嵩峯。",
      "夜眠古巷當城月，秋直清曹入省鐘。",
      "禹鑿故山歸未得，河聲暗老兩三松。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "巷",
        "variant": "卷",
        "source": "一作「卷」"
      },
      {
        "line": 4,
        "text": "暗",
        "variant": "聒",
        "source": "一作「聒」"
      }
    ]
  },
  {
    "uid": "QTS_723_004_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "敘舊遊寄棲棲",
    "poem": [
      "老着重袍坐石房，竺經休講白眉長。",
      "省衝鼉沒投江島，曾看魚飛倚海檣。",
      "曉炙凍盂原日氣，夜挑蓮碗禁燈光。",
      "吟詩五嶺尋無可，倏忽如今四十霜。"
    ]
  },
  {
    "uid": "QTS_723_005_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "哭棲白供奉",
    "poem": [
      "聞說孤窓坐化時，白莎蘿雨滴空池。",
      "吟詩堂裏秋關影，禮佛燈前夜照碑。",
      "賀雪已成金殿夢，看濤終負石橋期。",
      "逢山對月還惆悵，爭得無言似祖師。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "橋",
        "variant": "樓",
        "source": "一作「樓」"
      }
    ]
  },
  {
    "uid": "QTS_723_006_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "贈入內供奉僧",
    "poem": [
      "內殿談經愜帝懷，沃州歸隱計全乖。",
      "數條雀尾來南海，一道蟬聲噪御街。",
      "石枕紋含山裏葉，銅缾口塞井中柴。",
      "因逢夏日西明講，不覺宮人拔鳳釵。"
    ]
  },
  {
    "uid": "QTS_723_007_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "感恩書事寄上集義司徒相公",
    "poem": [
      "積雪峯西遇獎稱，半家寒骨起溝塍。",
      "鎮時賢相回人鏡，報德慈親點佛燈。",
      "授鉞已聞諸國靜，坐籌重見大河澄。",
      "功居第一圖煙閣，依舊終南滿杜陵。"
    ]
  },
  {
    "uid": "QTS_723_008_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "贈永崇李將軍充襄陽制置使",
    "poem": [
      "拜官門外發輝光，宿衛陰符注幾行。",
      "行處近天龍尾滑，獵時陪帝馬鬃香。",
      "九城王氣生旗隊，萬里寒風入箭瘡。",
      "從此浩然聲價歇，武中還有李襄陽。"
    ]
  },
  {
    "uid": "QTS_723_009_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "寄淮海惠澤上人",
    "poem": [
      "海濤痕滿舊征衣，長憶初程宿翠微。",
      "竹裏橋鳴知馬過，塔中燈露見鴻飛。",
      "眉毫別後應盈尺，喦木居來定幾圍。",
      "他日願師容一榻，煎茶掃地學忘機。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "毫",
        "variant": "毛",
        "source": "一作「毛」"
      }
    ]
  },
  {
    "uid": "QTS_723_010_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "春日隱居官舍感懷",
    "poem": [
      "風吹燒燼雜汀沙，還似青溪舊寄家。",
      "入戶竹生牀下葉，隔窻蓮謝鏡中花。",
      "苔房毳客論三學，雪嶺巢禽看兩衙。",
      "銷得人間無限事，江亭月白誦《南華》。"
    ]
  },
  {
    "uid": "QTS_723_011_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "春日即事寄一二知己",
    "poem": [
      "浴馬池西一帶泉，開門景物似樊川。",
      "朱衣暎水人歸縣，白羽遺泥鶴上天。",
      "索米夜燒風折木，無車春養雪藏鞭。",
      "縉紳處士知章句，忍使孤窻枕淚眠。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "車",
        "variant": "一作「驢",
        "source": "一作「一作「驢」，一作「輿」」"
      }
    ]
  },
  {
    "uid": "QTS_723_012_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "廢寺閒居寄懷一二罷舉知己",
    "poem": [
      "病居廢廟冷吟煙，無力爭飛類病蟬。",
      "槐省老郎蒙主棄，月陂孤客望誰憐。",
      "稅房兼得調猿石，租地仍分浴鶴泉。",
      "處世堪驚又堪媿，一坡山色不論錢。"
    ],
    "notes": [
      {
