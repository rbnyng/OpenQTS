    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "宿葉公棊閣",
    "poem": [
      "帶風棊閣竹相敲，局瑩無塵拂樹梢。",
      "日到長天征未斷，鐘來嶽頂劫須拋。",
      "挑燈雪客棲寒店，供茗溪僧爇廢巢。",
      "因悟修身試貪教，不須焚火向三茅。"
    ]
  },
  {
    "uid": "QTS_723_029_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "送郄先輩歸覲華陰",
    "poem": [
      "桂枝博得鳳棲枝，歡覲家僮舞翠微。",
      "僧向瀑泉聲裏賀，鳥穿仙掌指間飛。",
      "休停硯筆吟荒廟，永別燈籠赴鎖闈。",
      "騷雅近來頹喪甚，送君傍覺有光輝。"
    ]
  },
  {
    "uid": "QTS_723_030_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "贈可上人",
    "poem": [
      "寺門和鶴倚香杉，月吐秋光到思嚵。",
      "將法傳來穿泱漭，把詩吟去入嵌巖。",
      "模糊書卷煙嵐滴，狼藉衣裳瀑布緘。",
      "不斷清風牙底嚼，無因內殿得名銜。"
    ]
  },
  {
    "uid": "QTS_723_031_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "東川高僕射",
    "poem": [
      "油幢影裏拜清風，十里貔貅一片雄。",
      "二印鎖開霜滿地，四門關定月當空。",
      "泉浮山葉人家過，詔惹罏香鳥道通。",
      "新起畫樓攜客上，弦歌筵內海榴紅。"
    ]
  },
  {
    "uid": "QTS_723_032_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "宿成都松溪院",
    "poem": [
      "松持節操溪澄性，一炷煙嵐壓寺隅。",
      "翡翠鳥飛人不見，琉璃缾貯水疑無。",
      "夜聞子落真山雨，曉汲波圓入畫圖。",
      "塵擁蜀城抽鎖後，此中猶夢在江湖。"
    ]
  },
  {
    "uid": "QTS_723_033_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "弔曹監",
    "poem": [
      "宅上愁雲吹不散，桂林詩骨葬雲根。",
      "滿樓山色供鄰里，一洞松聲付子孫。",
      "甘露施衣封淚點，秘書取集印苔痕。",
      "吟魂醉魄歸何處？御水嗚嗚夜遶門。"
    ]
  },
  {
    "uid": "QTS_723_034_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "贈長安畢郎中",
    "poem": [
      "高門寒沼水連雲，鷺識朱衣傍主人。",
      "地肺半邊晴帶雪，天街一面靜無塵。",
      "\\",
      "朝迴座客酬琴價，衙退留僧寫鶴真。",
      "從此幾遷為計相，蓬萊三刻奏東巡。"
    ]
  },
  {
    "uid": "QTS_723_035_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "寄東蜀幕中友",
    "poem": [
      "官亭池碧海榴殷，遙想清才倚畫欄。",
      "柳絮漲天籠地暖，角聲經雨透雲寒。",
      "曉侵台座香煙濕，夜草軍書蠟炬乾。",
      "為話門人吟太苦，風摧蘭秀一枝殘。"
    ]
  },
  {
    "uid": "QTS_723_036_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "曲江漁父",
    "poem": [
      "兒孫閒弄雪霜髯，浪颭南山影入簷。",
      "臥穩篷舟龜作枕，病來茅舍網為簾。",
      "值春遊子憐蓴滑，通蜀行人說鱠甜。",
      "數尺寒絲一竿竹，豈知浮世有猜嫌。"
    ]
  },
  {
    "uid": "QTS_723_037_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "和劉駕博士贈莊嚴律禪師",
    "poem": [
      "人言紫綬有光輝，不二心觀似草衣。",
      "塵劫自營還自壞，禪門無住亦無歸。",
      "松根穴蟻通山遠，塔頂巢禽見海微。",
      "每話南遊偏起念，五峯波上入船扉。"
    ]
  },
  {
    "uid": "QTS_723_038_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "智新上人話舊",
    "poem": [
      "蟋蟀燈前話舊遊，師經幾夏我經秋。",
      "金陵市合月光裏，甘露門開峰朵頭。",
      "晴眺遠帆飛入海，夜禪陰火吐當樓。",
      "相看未得東歸去，滿壁寒濤瀉白鷗。"
    ]
  },
  {
    "uid": "QTS_723_039_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "和淮南太尉留題鳳州王氏別業",
    "poem": [
      "清秋看長鷺雛成，說向湘僧亦動情。",
      "節屋折將松上影，印龕移鎖月中聲。",
      "野人陪賞增詩價，太尉因居著谷名。",
      "閒想此中遺勝事，宿齋吟遶鳳池行。"
    ]
  },
  {
    "uid": "QTS_723_040_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "乙酉嵗自蜀隨計趂試不及",
    "poem": [
      "客臥涪江蘸月廳，知音喚起進趨生。",
      "寒梅折後方離蜀，臘月圓前未到京。",
      "風卷壞亭羸僕病，雪糊危棧蹇驢行。",
      "文昌一試應關分，豈校褒斜兩日程。"
    ]
  },
  {
    "uid": "QTS_723_041_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "龍州韋郎中先夢六赤，後因打葉子以詩上",
    "poem": [
      "紅蠟香煙撲畫楹，梅花落盡庾樓清。",
      "光輝圓魄銜山冷，彩鏤方牙着腕輕。",
      "寶帖牽來獅子鎮，金盆引出鳳凰傾。",
      "微黃喜兆莊周夢，六赤重新擲印成。"
    ]
  },
  {
    "uid": "QTS_723_042_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "和壽中丞《傷猿》",
    "poem": [
      "遺掛朱欄鎖半尋，清聲難買恨黃金。",
      "懸崖接果今何在，淺井窺星影已沉。",
      "歸宅葉鋪曾睡石，入朝燈照舊啼林。",
      "小山罷遶隨湘客，高樹休升對嶽禽。",
      "天竺省憐傷倍切，親知寬和思難任。",
      "相門恩重無由報，竟託仙郎日夜吟。"
    ],
