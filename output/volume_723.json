  },
  {
    "uid": "QTS_723_051_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "題晰上人賈島詩卷",
    "poem": [
      "賈生詩卷惠休裝，百葉蓮花萬里香。",
      "供得半年吟不足，長須字字頂司倉。"
    ]
  },
  {
    "uid": "QTS_723_052_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "送僧清演歸山",
    "poem": [
      "毛褐斜肩背負經，曉思吟入竇山青。",
      "峯前野水橫官道，踏著秋天三四星。"
    ]
  },
  {
    "uid": "QTS_723_053_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "贈僧",
    "poem": [
      "不羨王公與貴人，唯將雲鶴自相親。",
      "閒來石上觀流水，欲洗禪衣未有塵。"
    ]
  },
  {
    "uid": "QTS_723_054_01",
    "volume": 723,
    "author": {
      "canonical": "李洞",
      "recorded": "李洞"
    },
    "title": "題學公院池蓮",
    "poem": [
      "竹引山泉玉甃池，栽蓮莫怪藕生絲。",
      "如何不似麻衣客，坐對秋風待一枝。"
    ],
    "variants": [
      {
