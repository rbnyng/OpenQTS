  },
  {
    "uid": "QTS_260_005_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "題鏡湖野老所居",
    "poem": [
      "湖裏尋君去，樵風往返吹。",
      "樹喧巢鳥出，路細葑田移。",
      "漚薴成魚網，枯根是酒巵。",
      "老年唯自適，生事任羣兒。"
    ]
  },
  {
    "uid": "QTS_260_006_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "早秋宿崔業居處",
    "poem": [
      "從來席不暖，爲爾便淹流。",
      "雞黍今相會，雲山昔共遊。",
      "上簾宜晚景，臥簟覺新秋。",
      "身事何須問，余心正四愁。"
    ]
  },
  {
    "uid": "QTS_260_007_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "贈烏程楊苹明府",
    "poem": [
      "策杖政成時，清溪弄釣絲。",
      "當年潘子貌，避病沈侯詩。",
      "漉酒迎賓急，看花署字遲。",
      "楊梅今熟未，與我兩三枝。"
    ]
  },
  {
    "uid": "QTS_260_008_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "徐侍郎素未相識時攜酒命饌兼命諸詩客同訪會稽山居",
    "poem": [
      "忽道仙翁至，幽人學拜迎。",
      "華簪窺甕牖，珍味代藜羹。",
      "洗硯魚仍戲，移樽鳥不驚。",
      "蘭亭攀敘卻，會此越中營。"
    ]
  },
  {
    "uid": "QTS_260_009_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "春日閑居三首 其一",
    "poem": [
      "一似桃源隱，將令過客迷。",
      "礙冠門柳長，驚夢院鶯啼。",
      "澆藥泉流細，圍棋日影低。",
      "舉家無外事，共愛草萋萋。"
    ],
    "part_index": 1,
    "total_parts": 3
  },
  {
    "uid": "QTS_260_009_02",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "春日閑居三首 其二",
    "poem": [
      "長謠朝復暝，幽獨幾人知。",
      "老鶴兼雛弄，叢篁帶筍移。",
      "白雲將袖拂，青鏡出簷窺。",
      "邀取漁家叟，花間把酒卮。"
    ],
    "part_index": 2,
    "total_parts": 3
  },
  {
    "uid": "QTS_260_009_03",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "春日閑居三首 其三",
    "poem": [
      "寂寂池亭裡，軒窗間綠苔。",
      "游魚牽荇沒，戲鳥踏花摧。",
      "小徑僧尋去，高峰鹿下來。",
      "中年曾屢辟，多病復遲迴。"
    ],
    "part_index": 3,
    "total_parts": 3
  },
  {
    "uid": "QTS_260_010_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "題石室山王寧所居",
    "poem": [
      "白雲知所好，柏葉幸加餐。",
      "石鏡妻將照，仙書我借看。",
      "鳥來翻藥椀，猿飲怕魚竿。",
      "借問簷前樹，何枝曾掛冠。"
    ]
  },
  {
    "uid": "QTS_260_011_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "送王道士",
    "poem": [
      "真人俄整舄，雙鶴屢飛翔。",
      "恐入壺中住，須傳肘後方。",
      "霓裳雲氣潤，石徑朮苗香。",
      "一去何時見，仙家日月長。"
    ]
  },
  {
    "uid": "QTS_260_012_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "將移耶溪舊居留贈嚴維秘書",
    "poem": [
      "雞犬漁舟裡，長謠任興行。",
      "那邀落日醉，已被遠山迎。",
      "書篋將非重，荷衣著甚輕。",
      "謝安無箇事，忽起為蒼生。"
    ],
