  },
  {
    "uid": "QTS_260_015_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "獻薛僕射",
    "poem": [
      "由來那敢議輕肥，散髮行歌自採薇。",
      "逋客未能忘野興，辟書翻遣脫荷衣。",
      "家中匹婦空相笑，池上群鷗盡欲飛。",
      "更乞大賢容小隱，益看愚谷有光輝。"
    ]
  },
  {
    "uid": "QTS_260_016_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "鮑防員外見尋因書情呈贈",
    "poem": [
      "少小爲儒不自強，如今嬾復見侯王。",
      "覽鏡已知身漸老，買山將作計偏長。",
      "荒涼鳥獸同三逕，撩亂琴書共一牀。",
      "猶有郎官來問疾，時人莫道我佯狂。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "已",
        "variant": "自",
        "source": "一作「自」"
      }
    ]
  },
  {
    "uid": "QTS_260_017_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "寄浙東皇甫中丞",
    "poem": [
      "閑閑麋鹿或相隨，一兩年來鬢欲衰。",
      "琴硯共依春酒甕，雲霞覆著破柴籬。",
      "注書不向時流說，種藥空令道者知。",
      "久帶紗巾仍藉草，山中那得見朝儀。"
    ]
  },
  {
    "uid": "QTS_260_018_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "題章野人山居",
    "poem": [
      "帶郭茅亭詩興饒，回看一曲倚危橋。",
      "門前山色能深淺，壁上湖光自動搖。",
      "閒花散落填書帙，戲鳥低飛礙柳條。",
      "向此隱來經幾載，如今已是漢家朝。"
    ]
  },
  {
    "uid": "QTS_260_019_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "山中枉皇甫溫大夫見招書",
    "poem": [
      "十年木屐步苔痕，石上松間水自喧。",
      "三辟草堂仍被褐，數行書札忽臨門。",
      "臥多共息嵇康病，才劣虛同郭隗尊。",
      "亞相已能憐潦倒，山花笑處莫啼猿。"
    ]
  },
  {
    "uid": "QTS_260_020_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "題茅山李尊師山居",
    "poem": [
      "天師百歲少如童，不到山中竟不逢。",
      "洗藥每臨新瀑水，步虛時上最高峰。",
      "籬間五月留殘雪，座右千年廕老松。",
      "此去人寰今遠近，回看雲壑一重重。"
    ]
  },
  {
    "uid": "QTS_260_021_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "耶溪書懷寄劉長卿員外",
    "poem": [
      "時人多笑樂幽棲，晚起閒行獨杖藜。",
      "雲色卷舒前後嶺，藥苗新舊兩三畦。",
      "偶逢野果將呼子，屢折荊釵亦為妻。",
      "擬共釣竿長往復，嚴陵灘上勝耶溪。"
    ]
  },
  {
    "uid": "QTS_260_022_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "山中崔大夫有書相問",
    "poem": [
      "客在煙霞裡，閑閑逐狎鷗。",
      "終年常裸足，連日半蓬頭。",
      "帶月乘漁艇，迎寒綻鹿裘。",
      "已於人事少，多被掛冠留。",
      "素業堆千卷，清風至一丘。",
      "蒼黃倒藜杖，傴僂睹銀鉤。",
      "跡愧巢由隱，才非管樂儔。",
      "從來自多病，不是傲王侯。"
    ]
  },
  {
    "uid": "QTS_260_023_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "張建封大夫奏系爲校書郎因寄此作",
    "poem": [
      "久是煙霞客，潭深釣得魚。",
      "不知芸閣上，遺校幾多書。"
    ]
  },
  {
    "uid": "QTS_260_024_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "會稽山居寄薛播侍郎袁高給事高參舍人",
    "poem": [
      "稷卨今爲相，明君復是堯。",
      "寧知買臣困，猶負會稽樵。"
    ]
  },
  {
    "uid": "QTS_260_025_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "閑居覽史",
    "poem": [
      "長策胸中不復論，荷衣藍縷閉柴門。",
      "當時漢祖無三傑，爭得咸陽與子孫。"
    ]
  },
  {
    "uid": "QTS_260_026_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "山中贈耿拾遺湋兼兩省故人",
    "poem": [
      "數片荷衣不蔽身，青山白鳥豈知貧。",
      "如今非是秦時世，更隱桃花亦笑人。"
    ]
  },
  {
    "uid": "QTS_260_027_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "秋日送僧志幽歸山寺",
    "poem": [
      "禪室繩牀在翠微，松間荷笠一僧歸。",
      "磬聲寂歷宜秋夜，手冷燈前自衲衣。"
    ]
  },
  {
    "uid": "QTS_260_028_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "題僧明惠房",
    "poem": [
      "簷前朝暮雨添花，八十真僧飯一麻。",
      "入定幾時將出定，不知巢燕污袈裟。"
    ],
