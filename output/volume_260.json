        "text": "團",
        "variant": "芭",
        "source": "一作「芭」"
      }
    ]
  },
  {
    "uid": "QTS_260_036_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
