  {
    "uid": "QTS_260_029_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "答泉州薛播使君重陽日贈酒",
    "poem": [
      "欲強登高無力也，籬邊黃菊為誰開。",
      "共知不是潯陽郡，那得王弘送酒來。"
    ]
  },
  {
    "uid": "QTS_260_030_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "題洪道士山院",
    "poem": [
      "霞外主人門不扃，數株桃樹藥囊青。",
      "閒行池畔隨孤鶴，若問多應道姓丁。"
    ]
  },
  {
    "uid": "QTS_260_031_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "期王鍊師不至",
    "poem": [
      "黃精蒸罷洗瓊杯，林下從留石上苔。",
      "昨日圍棋未終局，多乘白鶴下山來。"
    ]
  },
  {
    "uid": "QTS_260_032_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "題贈張道士山居",
    "poem": [
      "盤石垂蘿即是家，回頭猶看五枝花。",
      "松間寂寂無煙火，應服朝來一片霞。"
    ]
  },
  {
    "uid": "QTS_260_033_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "山中書懷寄張建封大夫",
    "poem": [
      "昨日年催白髮新，身如麋鹿不知貧。",
      "時時亦被群兒笑，賴有南山四老人。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "催",
        "variant": "新",
        "source": "一作「新」"
      }
    ]
  },
  {
    "uid": "QTS_260_034_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "山中贈諸暨丹丘明府",
    "poem": [
      "荷衣半破帶莓苔，笑向陶潛酒甕開。",
      "縱醉遠須上山去，白雲那肯下山來。"
    ]
  },
  {
    "uid": "QTS_260_035_01",
    "volume": 260,
    "author": {
      "canonical": "秦系",
      "recorded": "秦系"
    },
    "title": "奉寄晝公",
    "poem": [
      "簑笠雙童傍酒船，湖山相引到房前。",
      "團蕉何事教人見，暫借空林床守坐禪。"
    ],
    "variants": [
