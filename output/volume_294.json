      "gender": "male",
      "period": "High Tang",
      "english_name": "Cui Dong",
      "wikidata_id": "Q22078967"
    },
    "title": "奉和給事寓直",
    "poem": [
      "桂枝家共折，雞樹代相傳。",
      "忝向鸞臺下，仍看雁影連。",
      "夜閒方步月，漏盡欲朝天。",
      "知去丹墀近，明王許薦賢。"
    ]
  },
