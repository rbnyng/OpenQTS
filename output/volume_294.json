    "title": "客舍書情寄趙中丞",
    "poem": [
      "東楚復西秦，浮雲類此身。",
      "關山勞䇿蹇，僮僕慣投人。",
      "孤客來千里，全家託四鄰。",
      "生涯難自料，中夜問親情。"
    ],
    "variants": [
      {
        "line": 4,
        "text": "問",
        "variant": "見",
        "source": "一作「見」"
      }
    ]
  },
