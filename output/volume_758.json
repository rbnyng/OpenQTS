[
  {
    "uid": "QTS_758_001_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "宿山寺",
    "poem": [
      "溪山盡日行，方聽遠鐘聲。",
      "入院逢僧定，登樓見月生。",
      "露垂羣木潤，泉落一岩清。",
      "此景關吾事，通宵寐不成。"
    ],
    "preface": "孟貫，字一之，建安人。初客江南，後仕周。詩一卷。"
  },
  {
    "uid": "QTS_758_002_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "贈棲隱洞譚先生",
    "poem": [
      "先生雙鬢華，深谷臥雲霞。",
      "不伐有巢樹，多移無主花。",
      "石泉春釀酒，松火夜煎茶。",
      "因問山中事，如君有幾家。"
    ]
  },
  {
    "uid": "QTS_758_003_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "歸雁",
    "poem": [
      "春至衡陽雁，思歸塞路長。",
      "汀洲齊奮翼，霄漢共成行。",
      "雪盡翻風暖，寒收度月涼。",
      "直應到秋日，依舊返瀟湘。"
    ]
  },
  {
    "uid": "QTS_758_004_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "春江送人",
    "poem": [
      "春江多去情，相去枕長汀。",
      "數雁別湓浦，片帆離洞庭。",
      "雨餘沙草綠，雲散岸峰青。",
      "誰共觀明月，漁歌夜好聽。"
    ]
  },
  {
    "uid": "QTS_758_005_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "過秦嶺",
    "poem": [
      "古今傳此嶺，高下勢崢嶸。",
      "安得青山路，化為平地行。",
      "蒼苔留虎跡，碧樹障溪聲。",
      "欲過一回首，踟躕無限情。"
    ]
  },
  {
    "uid": "QTS_758_006_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "送吳夢誾歸閩",
    "poem": [
      "甌閩在天末，此去整行衣。",
      "久客逢春盡，思家冒暑歸。",
      "海雲添晚景，山瘴滅晴暉。",
      "相憶吟偏苦，不堪書信稀。"
    ]
  },
  {
    "uid": "QTS_758_007_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "山中夏日",
    "poem": [
      "深山宜避暑，門戶映嵐光。",
      "夏木蔭溪路，晝雲埋石床。",
      "心源澄道靜，衣葛蘸泉涼。",
      "算得紅塵裏，誰知此興長。"
    ]
  },
  {
    "uid": "QTS_758_008_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "宿故人江居",
    "poem": [
      "渡口樹冥冥，南山漸隱青。",
      "漁舟歸舊浦，鷗鳥宿前汀。",
      "靜榻懸燈坐，閑門對浪扃。",
      "相思頻到此，幾番醉還醒。"
    ]
  },
  {
    "uid": "QTS_758_009_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "寄伍喬",
    "poem": [
      "蹉跎春又晚，天末信來遲。",
      "長憶分攜日，正當搖落時。",
      "獨游饒旅恨，多事失歸期。",
      "君看前溪樹，山禽巢幾枝。"
    ]
  },
  {
    "uid": "QTS_758_010_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "山中訪人不遇",
    "poem": [
      "負琴兼杖藜，特地過岩西。",
      "已見竹軒閉，又聞山鳥啼。",
      "長松寒倚穀，細草暗連溪。",
      "久立無人事，煙霞歸路迷。"
    ]
  },
  {
    "uid": "QTS_758_011_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "贈隱者",
    "poem": [
      "世路爭名利，深山獨結茅。",
      "安情自得所，非道豈相交。",
      "百尺松當戶，千年鶴在巢。",
      "知君於此景，未欲等閒拋。"
    ]
  },
  {
    "uid": "QTS_758_012_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "寄暹上人",
    "poem": [
      "聞罷城中講，來安頂上禪。",
      "夜燈明石室，清磬出巖泉。",
      "欲訪慚多事，相思恨來年。",
      "終期息塵慮，接話虎溪邊。"
    ]
  },
  {
    "uid": "QTS_758_013_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "江邊閒步",
    "poem": [
      "閒來南渡口，迤邐看江楓。",
      "一路波濤畔，數家蘆葦中。",
      "遠汀排晚樹，深浦漾寒鴻。",
      "吟罷慵回首，此情誰與同？"
    ]
  },
  {
    "uid": "QTS_758_014_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "過王逸人園林",
    "poem": [
      "谷口何時住，煙霞一徑深。",
      "水聲離遠洞，山色出疏林。",
      "雪彩從沾鬢，年光不計心。",
      "自言人少到，猶喜我來尋。"
    ]
  },
  {
    "uid": "QTS_758_015_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "寄李處士",
    "poem": [
      "僧話磻溪叟，平生重赤松。",
      "夜堂悲蟋蟀，秋水老芙蓉。",
      "吟坐倦垂釣，閒行多倚筇。",
      "聞名來已久，未得一相逢。"
    ]
  },
  {
    "uid": "QTS_758_016_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "夏日寄史處士",
    "poem": [
      "掩關苔滿地，終日坐騰騰。",
      "暑氣冷衣葛，暮雲催燭燈。",
      "寂寥知得趣，疏懶似無能。",
      "還憶舊游否，何年別杜陵。"
    ]
  },
  {
    "uid": "QTS_758_017_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "夏日登瀑頂寺，因寄諸知己",
    "poem": [
      "曾於塵裏望，此景在煙霄。",
      "巖靜水聲近，山深暑氣遙。",
      "杖藜青石路，煮茗白雲樵。",
      "寄語為郎者，誰能訪寂寥。"
    ]
  },
  {
    "uid": "QTS_758_018_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "懷果上人",
    "poem": [
      "擁錫南遊去，名香幾處焚。",
      "別來無遠信，多恐在深雲。",
      "好月曾同步，幽香省共聞。",
      "相思不相見，林下葉紛紛。"
    ]
  },
  {
    "uid": "QTS_758_019_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "寄故園兄弟",
    "poem": [
      "久與鄉關阻，風塵損舊衣。",
      "水思和月泛，山憶共僧歸。",
      "林想添鄰舍，溪應改釣磯。",
      "弟兄無苦事，不用別庭闈。"
    ]
  },
  {
    "uid": "QTS_758_020_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "早秋吟眺",
    "poem": [
      "新秋初雨後，獨立對遙山。",
      "去鳥望中沒，好雲吟裏還。",
      "長年慚道薄，明代取身閒。",
      "從有西征思，園林懶閉關。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "初",
        "variant": "迎",
        "source": "一作「迎」"
      }
    ]
  },
  {
    "uid": "QTS_758_021_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "送江為歸嶺南",
    "poem": [
      "舊山臨海色，歸路到天涯。",
      "此別各多事，重逢是幾時。",
      "江行晴望遠，嶺宿夜吟遲。",
      "珍重南方客，清風失所思。"
    ]
  },
  {
    "uid": "QTS_758_022_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "山中答友人",
    "poem": [
      "偶愛春山住，因循值暑時。",
      "風塵非所願，泉石本相宜。",
      "坐久松陰轉，吟餘蟬韻移。",
      "自慙疎野甚，多失故人期。"
    ]
  },
  {
    "uid": "QTS_758_023_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "山齋早秋雨中",
    "poem": [
      "深居少往還，卷箔早秋間。",
      "雨灑吟蟬樹，雲藏嘯狖山。",
      "炎蒸如便退，衣葛亦堪閑。",
      "靜坐得無事，酒卮聊暢顏。"
    ]
  },
  {
    "uid": "QTS_758_024_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "送人遊南越",
    "poem": [
      "孑然南越去，替爾畏前程。",
      "見說路岐嶮，不通車馬行。",
      "瘴煙迷海色，嶺樹帶猨聲。",
      "獨向山家宿，多應鄉思生。"
    ]
  },
  {
    "uid": "QTS_758_025_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "酬東溪史處士",
    "poem": [
      "咫尺東溪路，年來偶訪遲。",
      "泉聲迷夜雨，花片落空枝。",
      "石徑逢僧出，山床見鶴移。",
      "貧齋有琴酒，曾許月圓期。"
    ]
  },
  {
    "uid": "QTS_758_026_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "秋江送客",
    "poem": [
      "秋風楚江上，送子話遊遨。",
      "遠水宿何處，孤舟春夜濤。",
      "浦雲沈雁影，山月照猨嘷。",
      "莫為饑寒苦，便成名利勞。"
    ]
  },
  {
    "uid": "QTS_758_027_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "寄山中高逸人",
    "poem": [
      "煙霞多放曠，吟嘯是尋常。",
      "猨共摘山果，僧鄰住石房。",
      "躡雲雙屐冷，採藥一身香。",
      "我憶相逢夜，松潭月色涼。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "一",
        "variant": "滿",
        "source": "一作「滿」"
      }
    ]
  },
  {
    "uid": "QTS_758_028_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "懷友人",
    "poem": [
      "浮世況多事，飄流每歎君。",
      "路岐何處去，消息幾時聞。",
      "吟裏落秋葉，望中生暮雲。",
      "孤懷誰慰我，夕鳥自成羣。"
    ]
  },
  {
    "uid": "QTS_758_029_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "送人歸別業",
    "poem": [
      "別業五湖上，春殘去路賒。",
      "還尋舊山水，重到故人家。",
      "門徑掩芳草，園林落異花。",
      "君知釣磯在，猶喜有生涯。"
    ]
  },
  {
    "uid": "QTS_758_030_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "送人歸別業",
    "poem": [
      "高樓臨古岸，野步晚來登。",
      "江水因寒落，山雲為雪凝。",
      "遠村雖入望，危檻不堪憑。",
      "親老未歸去，鄉愁徒自興。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "步",
        "variant": "老",
        "source": "一作「老」"
      }
    ]
  },
  {
    "uid": "QTS_758_031_01",
    "volume": 758,
    "author": {
      "canonical": "孟貫",
      "recorded": "孟貫"
    },
    "title": "寄張山人",
    "poem": [
      "草堂南澗邊，有客嘯雲煙。",
      "掃葉林風後，拾薪山雨前。",
      "野橋通竹徑，流水入芝田。",
      "琴月相親夜，更深戀不眠。"
    ]
  }
]