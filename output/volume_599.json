  {
    "uid": "QTS_599_003_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "山村曉思",
    "poem": [
      "開門省禾黍，鄰翁水頭住。",
      "今朝南澗波，昨夜西川雨。",
      "牧童披短蓑，腰笛期煙渚。",
      "不問水邊人，騎牛傍山去。"
    ]
  },
  {
    "uid": "QTS_599_004_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "馬嵬驛",
    "poem": [
      "常經馬嵬驛，見說坡前客。",
      "一從屠貴妃，生女愁傾國。",
      "是日芙蓉花，不如秋草色。",
      "當時嫁匹夫，不妨得頭白。"
    ]
  },
  {
    "uid": "QTS_599_005_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "苦辛吟",
    "poem": [
      "壟上扶犁兒，手種腹長飢。",
      "窗下拋梭女，手織身無衣。",
      "我願燕趙姝，化為嫫母姿。",
      "一笑不值錢，自然家國肥。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "下拋",
        "variant": "前擲",
        "source": "一作「前擲」"
      },
      {
        "line": 4,
        "text": "錢",
        "variant": "金",
        "source": "一作「金」"
      }
    ]
  },
  {
    "uid": "QTS_599_006_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "野蠶",
    "poem": [
      "野蠶食青桑，吐絲亦成繭。",
      "無功及生人，何異偷飽煖。",
      "我願均爾絲，化為寒者衣。"
    ]
  },
  {
    "uid": "QTS_599_007_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "秦原覽古",
    "poem": [
      "耕者戮力地，龍虎曾角逐。",
      "火德道將亨，夜逢蛇母哭。",
      "昔日望夷宮，是處尋桑穀。",
      "漢祖竟為龍，趙高徒指鹿。",
      "當時行路人，已合傷心目。",
      "漢祚又千年，秦原草還綠。"
    ]
  },
  {
    "uid": "QTS_599_008_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "古宴曲",
    "poem": [
      "雉扇合蓬萊，朝車回紫陌。",
      "重門集嘶馬，言宴金張宅。",
      "燕娥奉卮酒，低鬟若無力。",
      "十戶手胼胝，鳳凰釵一隻。",
      "高樓齊下視，日照羅衣色。",
      "笑指負薪人，不信生中國。"
    ],
    "variants": [
      {
        "line": 5,
        "text": "衣",
        "variant": "綺",
        "source": "一作「綺」"
      }
    ]
  },
  {
    "uid": "QTS_599_009_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "南越謠",
    "poem": [
      "迢迢東南天，巨浸無津壖。",
      "雄風卷昏霧，干戈滿樓船。",
      "此時尉佗心，兒童待幽燕。",
      "三寸陸賈舌，萬里漢山川。",
      "若令交趾貨，盡生虞芮田。",
      "天意苟如此，遐人誰肯憐。"
    ]
  },
  {
    "uid": "QTS_599_010_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "述己歎",
    "poem": [
      "不長不成人，及長老逼身。",
      "履善本求樂，及善尤苦辛。",
      "如何幽並兒，一箭取功勳。"
    ]
  },
  {
    "uid": "QTS_599_011_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "遼陽行",
    "poem": [
      "遼陽在何處，妾欲隨君去。",
      "義合齊死生，本不誇機杼。",
      "誰能守空閨，虛問遼陽路。"
    ]
  },
  {
    "uid": "QTS_599_012_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "旅館秋思",
    "poem": [
      "旅館坐孤寂，出門成苦吟。",
      "何事覺歸晚，黃花秋意深。",
      "寒蝶戀衰草，軫我離鄉心。",
      "更見庭前樹，南枝巢宿禽。"
    ]
  },
  {
    "uid": "QTS_599_013_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "長城",
    "poem": [
      "秦皇豈無德，蒙氏非不武。",
      "豈將版築功，萬里遮胡虜。",
      "團沙世所難，作壘明知苦。",
      "死者倍堪傷，僵屍猶抱杵。",
      "十年居上郡，四海誰為主。",
      "縱使骨為塵，冤名不入土。"
    ]
  },
  {
    "uid": "QTS_599_014_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "田翁歎",
    "poem": [
      "手植千樹桑，文杏作中梁。",
      "頻年徭役重，盡屬富家郎。",
      "富家田業廣，用此買金章。",
      "昨日門前過，軒車滿垂楊。",
      "歸來說向家，兒孫竟咨嗟。",
      "不見千樹桑，一浦芙蓉花。"
    ],
    "notes": [
      {
        "content": "一本下有「桑」字",
        "context": "田翁歎",
        "original_title": "田翁歎〈一本下有「桑」字〉"
      }
    ]
  },
  {
    "uid": "QTS_599_015_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "沙場夜",
    "poem": [
      "城上更聲發，城下杵聲歇。",
      "征人燒斷蓬，對泣沙中月。",
      "耕牛朝挽甲，戰馬夜銜鐵。",
      "士卒浣戎衣，交河水為血。",
      "輕裘兩都客，洞房愁宿別。",
      "何況遠辭家，生死猶未決。"
    ]
  },
  {
    "uid": "QTS_599_016_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "里中女",
    "poem": [
      "吾聞池中魚，不識海水深。",
      "吾聞桑下女，不識華堂陰。",
      "貧窗苦機杼，富家鳴杵砧。",
      "天與雙明眸，只教識蒿簪。",
      "徒惜越娃貌，亦蘊韓娥音。",
      "珠玉不到眼，遂無奢侈心。",
      "豈知趙飛燕，滿髻釵黃金。"
    ]
  },
  {
    "uid": "QTS_599_017_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "寒食",
    "poem": [
      "二月野中芳，凡花亦能香。",
      "素娥哭新塚，樵柯鳴柔桑。",
      "田父引黃犬，尋狐上高岡。",
      "墳前呼犬歸，不知頭似霜。"
    ]
  },
  {
    "uid": "QTS_599_018_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "邊遊錄戍卒言",
    "poem": [
      "二十屬盧龍，三十防沙漠。",
      "平生愛功業，不覺從軍惡。",
      "今來客鬢改，知學彎弓錯。",
      "赤肉痛金瘡，他人成衛霍。",
      "目斷望君門，君門苦寥廓。"
    ]
  },
  {
    "uid": "QTS_599_019_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "古征戰",
    "poem": [
      "高峰淩青冥，深穴萬丈坑。",
      "皇天自山谷，焉得人心平。",
      "齊魯足兵甲，燕趙多娉婷。",
      "仍聞麗水中，日日黃金生。",
      "苟非夷齊心，豈得無戰爭。"
    ]
  },
  {
    "uid": "QTS_599_020_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "山村叟",
    "poem": [
      "古鑿巖居人，一廛稱有產。",
      "雖沾巾覆形，不及貴門犬。",
      "驅牛耕白石，課女經黃繭。",
      "歲暮霜霰濃，畫樓人飽暖。"
    ]
  },
  {
    "uid": "QTS_599_021_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "戍客南歸",
    "poem": [
      "北別黃榆塞，南歸白雲鄉。",
      "孤舟下彭蠡，楚月沈滄浪。",
      "為子惜功業，滿身刀箭瘡。",
      "莫渡汨羅水，回君忠孝腸。"
    ]
  },
  {
    "uid": "QTS_599_022_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "經館娃宮",
    "poem": [
      "館娃宮畔顧，國變生嬌妒。",
      "勾踐膽未嘗，夫差心已誤。",
      "吳亡甘已矣，越勝今何處。",
      "當時二國君，一種江邊墓。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "甘已矣",
        "variant": "昔誰在",
        "source": "一作「昔誰在」"
      }
    ]
  },
  {
    "uid": "QTS_599_023_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "村居晏起",
    "poem": [
      "村舍少聞事，日高猶閉關。",
      "起來花滿地，戴勝鳴桑間。",
      "居安即永業，何者為故山。",
      "朱門與蓬戶，六十頭盡斑。"
    ]
  },
  {
    "uid": "QTS_599_024_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "感懷",
    "poem": [
      "採薇易為山，何必登首陽。",
      "濯纓易為水，何必泛滄浪。",
      "貴崇已難慕，諂笑何所長。",
      "東堂桂欲空，猶有收螢光。"
    ]
  },
  {
    "uid": "QTS_599_025_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "金谷感懷",
    "poem": [
      "黃金驕石崇，與晉爭國力。",
      "更欲住人間，一日買不得。",
      "行為忠信主，身是文章宅。",
      "四者俱不聞，空傳墮樓客。"
    ]
  },
  {
    "uid": "QTS_599_026_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "恨從軍",
    "poem": [
      "不嫁白衫兒，愛君新紫衣。",
      "早知遽相別，何用假光輝。",
      "已聞都萬騎，又道出重圍。",
      "一軸金裝字，致君終不歸。"
    ]
  },
  {
    "uid": "QTS_599_027_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "燒金曲",
    "poem": [
      "天壽畏不永，燒金希長年。",
      "積土培枯根，自謂松柏堅。",
      "南陌試腰褭，西樓歌嬋娟。",
      "豈知蔓草中，日日開夜泉。"
    ]
  },
  {
    "uid": "QTS_599_028_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "子從軍",
    "poem": [
      "男作鄉中丁，女作鄉男婦。",
      "南村與北里，日日見父母。",
      "豈似從軍兒，一去便白首。",
      "何當鑄劍戟，盡得丁男力。"
    ]
  },
  {
    "uid": "QTS_599_029_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "越溪女",
    "poem": [
      "會稽山上雲，化作越溪人。",
      "枉破吳王國，徒為西子身。",
      "江邊浣紗伴，黃金扼雙腕。",
      "倏忽不相期，思傾趙飛燕。",
      "妾家基業薄，空有如花面。",
      "嫁盡綠窗人，獨自盤金線。"
    ]
  },
  {
    "uid": "QTS_599_030_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "巫山高",
    "poem": [
      "何山無朝雲，彼雲亦悠揚。",
      "何山無暮雨，彼雨亦蒼茫。",
      "宋玉恃才者，恁虛構高唐。",
      "自垂文賦名，荒淫歸楚襄。",
      "峩峩十二峰，永作妖鬼鄉。"
    ]
  },
  {
    "uid": "QTS_599_031_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "織素謠",
    "poem": [
      "貧女苦筋力，繰絲夜夜織。",
      "萬梭為一素，世重韓娥色。",
      "五侯初買笑，建章方落籍。",
      "一曲古涼州，六親長血食。",
      "勸爾畫長眉，學歌飽親戚。"
    ]
  },
  {
    "uid": "QTS_599_032_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "擬古諷",
    "poem": [
      "洛陽大道傍，甲第何深邃。",
      "南畝無一廛，東園有餘地。",
      "春溪化桃李，秋沼生荷芰。",
      "草木本無情，此時如有為。",
      "旱苗當壟死，流水資嘉致。",
      "余心甘至愚，不會皇天意。"
    ]
  },
  {
    "uid": "QTS_599_033_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "贈太行開路者",
    "poem": [
      "手劚太行山，心齊太行巔。",
      "劚盡太行險，君心更摩天。",
      "何如回苦辛，自鑿東皋田。"
    ]
  },
  {
    "uid": "QTS_599_034_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "戍卒傷春",
    "poem": [
      "連年戍邊塞，過卻芳菲節。",
      "東風氣力盡，不減陰山雪。",
      "蕭條柳一株，南枝葉微發。",
      "為帶故鄉情，依依藉攀折。",
      "晚風吹磧沙，夜淚啼鄉月。",
      "淩煙閣上人，未必皆忠烈。"
    ]
  },
  {
    "uid": "QTS_599_035_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "富農詩",
    "poem": [
      "長聞鄉人語，此家勝良賈。",
      "骨肉化飢魂，倉中有飽鼠。",
      "青春滿桑柘，旦夕鳴機杼。",
      "秋風一夜來，累累聞砧杵。",
      "西鄰有原憲，蓬蒿繞環堵。",
      "自樂固窮心，天意在何處。",
      "當門見堆子，已作桑田主。",
      "安得四海中，盡為虞芮土。"
    ],
    "preface": "濆寓居堯山南六十里，里有富農得氏，瑯琊人，指其貌，此多藏者也。\n積粟萬庾，馬牛無算，血屬星居于里土，生不遺，死不贈，環顧妻孥，意與天地等。\n故作是詩，用廣知者。",
    "variants": [
      {
        "line": 7,
        "text": "堆",
        "variant": "稚",
        "source": "一作「稚」"
      }
    ]
  },
  {
    "uid": "QTS_599_036_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "早發",
    "poem": [
      "綠野含曙光，東北雲如茜。",
      "棲鴉林際起，落月水中見。",
      "此身何自苦，日日淩霜霰。",
      "流蘇帳裏人，猶在陽臺畔。"
    ]
  },
  {
    "uid": "QTS_599_037_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "季夏逢朝客",
    "poem": [
      "滻水桃李熟，杜曲芙蓉老。",
      "九天休沐歸，腰玉垂楊道。",
      "避路回綺羅，迎風嘶騕褭。",
      "豈知山谷中，日日吹瑤草。"
    ]
  },
  {
    "uid": "QTS_599_038_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "隴頭水",
    "poem": [
      "行人何彷徨，隴頭水嗚咽。",
      "寒沙戰鬼愁，白骨風霜切。",
      "薄日朦朧秋，怨氣陰雲結。",
      "殺成邊將名，名著生靈滅。"
    ]
  },
  {
    "uid": "QTS_599_039_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "古別離",
    "poem": [
      "入室少情意，出門多路岐。",
      "黃鶴有歸日，蕩子無還時。",
      "人誰無分命，妾身何太奇。",
      "君為東南風，妾作西北枝。",
      "青樓鄰里婦，終年畫長眉。",
      "自倚對良匹，笑妾空羅幃。"
    ]
  },
  {
    "uid": "QTS_599_040_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "古別離",
    "poem": [
      "郎本東家兒，妾本西家女。",
      "對門中道間，終謂無離阻。",
      "豈知中道間，遣作空閨主。",
      "自是愛封侯，非關備胡虜。",
      "知子去從軍，何處無良人。"
    ]
  },
  {
    "uid": "QTS_599_041_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "擬古意",
    "poem": [
      "白玉若無玷，花顏須及時。",
      "國色久在室，良媒亦生疑。",
      "鴉鬟未成髻，鸞鏡徒相知。",
      "翻慙效顰者，卻笑從人遲。"
    ]
  },
  {
    "uid": "QTS_599_042_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "隴頭吟",
    "poem": [
      "借問隴頭水，終年恨何事。",
      "深疑嗚咽聲，中有徵人淚。",
      "自古蘊長策，況我非才智。",
      "無計謝潺湲，一宵空不寐。"
    ]
  },
  {
