[
  {
    "uid": "QTS_599_001_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "青樓曲",
    "poem": [
      "青樓臨大道，一上一回老。",
      "所思終不來，極目傷春草。"
    ]
  },
  {
    "uid": "QTS_599_002_01",
    "volume": 599,
    "author": {
      "canonical": "于濆",
      "recorded": "于濆"
    },
    "title": "塞下曲",
    "poem": [
      "紫塞曉屯兵，黃沙披甲臥。",
      "戰鼓聲未齊，烏鳶已相賀。",
      "燕然山上雲，半是離鄉魂。",
      "衛霍待富貴，豈能無乾坤。"
    ],
