        "text": "柱",
        "variant": "炷",
        "source": "一作「炷」"
      }
    ]
  },
  {
    "uid": "QTS_584_003_01",
    "volume": 584,
    "author": {
      "canonical": "段成式",
      "recorded": "段成式",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Duan Chengshi",
      "wikidata_id": "Q855746"
    },
    "title": "觀山燈獻徐尚書",
    "poem": [
      "磊落風初定，輕明雲乍妨。",
      "疎中揺月彩，繁處雜星芒。",
      "火樹枝柯密，燭龍鱗甲張。",
      "窮愁讀書者，應得假餘光。"
    ]
  },
