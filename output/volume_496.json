      "recorded": "四百九十六"
    },
    "title": "姚合 送李秀才赴舉",
    "poem": [
      "羅剎樓頭醉，送君西入京。",
      "秦吳無限地，山水半分程。",
      "海上煙霞濕，關中日月明。",
      "登科舊鄉里，當為改嘉名。"
    ]
  },
  {
    "uid": "QTS_496_081_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送李傳秀才歸宣州",
    "poem": [
      "謝守青山宅，山孤宅亦平。",
      "池塘無複見，春草野中生。",
      "常日登樓望，今朝送客行。",
      "殷勤拂石壁，為我一書名。"
    ]
  },
  {
    "uid": "QTS_496_082_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送元緒上人游商山",
    "poem": [
      "萬法空門裏，師修歷幾生。",
      "過來心已悟，未到行彌精。",
      "溪寂鐘還度，林昏錫獨鳴。",
      "朝簪抽未得，此別豈忘情。"
    ]
  },
  {
    "uid": "QTS_496_083_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送僧棲真歸杭州天竺寺",
    "poem": [
      "吏事日紛然，無因到佛前。",
      "勞師相借問，知我亦通禪。",
      "古寺杉松出，殘陽鐘磬連。",
      "草庵磐石上，歸此是因緣。"
    ]
  },
  {
    "uid": "QTS_496_084_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送敬法師歸福州",
    "poem": [
      "結得隨緣伴，蟬鳴方出關。",
      "新經譯舊寺，故國與誰還。",
      "齋為無鐘早，心因罷講閒。",
      "東南數千里，何處不逢山。"
    ]
  },
  {
    "uid": "QTS_496_085_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送清敬闍黎歸浙西",
    "poem": [
      "大地無生理，吳中豈是歸。",
      "自翻貝葉偈，人施福田衣。",
      "夏盡灘聲出，潮來日色微。",
      "郡齋師去後，寂寞夜吟稀。"
    ]
  },
  {
    "uid": "QTS_496_086_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送賈島及鐘渾",
    "poem": [
      "日日攻詩亦自強，年年供應在名場。",
      "春風驛路歸何處，紫閣山邊是草堂。"
    ]
  },
  {
    "uid": "QTS_496_087_01",
    "volume": 496,
    "author": {
