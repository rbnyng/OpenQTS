[
  {
    "uid": "QTS_496_001_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合",
    "poem": [
      "姚合，陝州硤石人。",
      "宰相祟曾孫。",
      "登元和進士第，授武功主簿，調富平萬年尉。",
      "寶曆中，監察御史戶部外郎，出荊、杭州刺史，後為給事中，陝虢觀察使。",
      "開成末，終秘書監。",
      "與馬戴、費冠卿、殷堯藩、張籍遊。",
      "李頻師之。",
      "合詩名重於時，人稱姚武功云。",
      "詩七卷。"
    ]
  },
  {
    "uid": "QTS_496_002_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送狄尚書鎮太原",
    "poem": [
      "授鉞儒生貴，傾朝赴餞筵。",
      "麾幢官在省，禮樂將臨邊。",
      "代馬龍相雜，汾河海暗連。",
      "遠戎移帳幕，高鳥避旌旃。",
      "天下屯兵處，皇威破虜年。",
      "防秋嫌壘近，入塞必身先。",
      "中外恩重疊，科名歲接連。",
      "散材無所用，老向瑣闈眠。"
    ],
    "preface": "姚合，陝州硤石人。宰相祟曾孫。登元和進士第，授武功主簿，調富平萬年尉。寶曆中，監察御史戶部外郎，出荊、杭州刺史，後為給事中，陝虢觀察使。開成末，終秘書監。與馬戴、費冠卿、殷堯藩、張籍遊。李頻師之。合詩名重於時，人稱姚武功云。詩七卷。"
  },
  {
    "uid": "QTS_496_003_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送楊尚書祭西嶽",
    "poem": [
      "報功嚴祀典，寵詔下明庭。",
      "酒氣飄林嶺，香煙入杳冥。",
      "樂清三奏備，詞直百神聽。",
      "衣拂雲霞濕，詩通水石靈。",
      "何因逐騶騎，暫得到巖扃。"
    ],
    "notes": [
      {
        "content": "一本無西字。",
        "context": "楊尚書祭西",
        "original_title": "送楊尚書祭西〈一本無西字。〉嶽"
      }
    ]
  },
  {
    "uid": "QTS_496_004_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送李侍御過夏州",
    "poem": [
      "酬恩不顧名，走馬覺身輕。",
      "迢遞河邊路，蒼茫塞上城。",
      "沙寒無宿雁，虜近少閑兵。",
      "飲罷揮鞭去，旁人意氣生。"
    ],
    "notes": [
      {
        "content": "一作送李廓侍郎。",
        "context": "侍御過夏州",
        "original_title": "送李侍御過夏州〈一作送李廓侍郎。〉"
      }
    ]
  },
  {
    "uid": "QTS_496_005_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送李起居赴池州",
    "poem": [
      "天子念疲民，分憂輟侍臣。",
      "紅旗高起焰，綠野靜無塵。",
      "闕下親知別，江南惠化新。",
      "朝昏即千里，且願話逡巡。"
    ]
  },
  {
    "uid": "QTS_496_006_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送劉詹事赴壽州",
    "poem": [
      "慇勤莫遽起，四坐悉同袍。",
      "世上詩難得，林中酒更高。",
      "隋堤傍楊柳，楚驛在波濤。",
      "別後書頻寄，無辭費筆毫。"
    ]
  },
  {
    "uid": "QTS_496_007_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送裴大夫赴亳州",
    "poem": [
      "杭人遮道路，垂泣浙江前。",
      "譙國迎舟艦，行歌汴水邊。",
      "周旋君量遠，交代我才偏。",
      "寒日嚴旌戟，晴風出管弦。",
      "一杯誠淡薄，四坐願留連。",
      "異政承殊澤，應為天下先。"
    ]
  },
  {
    "uid": "QTS_496_008_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送徐州韋僅行軍",
    "poem": [
      "餞幕儼征軒，行軍歸大藩。",
      "山程度函谷，水驛到夷門。",
      "曉日詩情遠，春風酒色渾。",
      "逡巡何足貴，所貴盡殘樽。"
    ]
  },
  {
    "uid": "QTS_496_009_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送劉禹錫郎中赴蘇州",
    "poem": [
      "三十年來天下名，銜恩東守闔閭城。",
      "初經咸谷眠山驛，漸入梁園問水程。",
      "霽日滿江寒浪靜，春風繞郭白蘋生。",
      "虎丘野寺吳中少，誰伴吟詩月裏行。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "咸",
        "variant": "函",
        "source": "一作「函」"
      }
    ]
  },
  {
    "uid": "QTS_496_010_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送劉禹錫郎中赴蘇州",
    "poem": [
      "州城全是故吳宮，香徑難尋古蘚中。",
      "雲水計程千里遠，軒車送別九衢空。",
      "鶴聲高下聽無盡，潮色朝昏望不同。",
      "太守吟詩人自理，小齋閒臥白蘋風。"
    ]
  },
  {
    "uid": "QTS_496_011_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送賈謩赴共城營田",
    "poem": [
      "上國羞長選，戎裝貴所從。",
      "山田依法種，兵食及時供。",
      "水氣詩書軟，嵐煙筆硯濃。",
      "幾時無事擾，相見得從容。"
    ]
  },
  {
    "uid": "QTS_496_012_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送裴宰君",
    "poem": [
      "見說為官處，煙霞思不窮。",
      "夜猿啼戶外，瀑水落廚中。",
      "名藥人難識，仙山路易通。",
      "還應施靜化，誰復與君同。"
    ],
    "variants": [
      {
        "line": 4,
        "text": "應施靜",
        "variant": "施清淨",
        "source": "一作「施清淨」"
      }
    ]
  },
  {
    "uid": "QTS_496_013_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送顧非熊下第歸越",
    "poem": [
      "失意尋歸路，親知不復過。",
      "家山去城遠，日月在船多。",
      "楚塞數逢雁，浙江長有波。",
      "秋風別鄉老，還聽鹿鳴歌。"
    ]
  },
  {
    "uid": "QTS_496_014_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送雍陶遊蜀",
    "poem": [
      "春色三千里，愁人意未開。",
      "木梢穿棧出，雨勢隔江來。",
      "荒館因花宿，深山羨客回。",
      "相如何物在，應只有琴台。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "勢",
        "variant": "氣",
        "source": "一作「氣」"
      }
    ]
  },
  {
    "uid": "QTS_496_015_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送崔約下第歸揚州",
    "poem": [
      "滿座詩人吟送酒，離城此會亦應稀。",
      "春風下第時稱屈，秋卷呈親自束歸。",
      "日晚山花當馬落，天陰水鳥傍船飛。",
      "江邊道路多苔蘚，塵土無由得上衣。"
    ]
  },
  {
    "uid": "QTS_496_016_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送李廓侍御赴西川行營",
    "poem": [
      "不道弓箭字，罷官唯醉眠。",
      "何人薦籌策，走馬逐旌旃。",
      "陣變孤虛外，功成語笑前。",
      "從今巂州路，無復有烽煙。"
    ]
  },
  {
    "uid": "QTS_496_017_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送楊尚書赴東川",
    "poem": [
      "郤縠詩書將，銜恩赴梓州。",
      "繞身垂印綬，護馬執戈矛。",
      "劍閣和銘峭，巴江帶字流。",
      "從來皆惜別，此別復何愁。"
    ]
  },
  {
    "uid": "QTS_496_018_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送邢郎中赴太原",
    "poem": [
      "上將得良策，恩威作長城。",
      "如今並州北，不見有胡兵。",
      "晉野雨初足，汾河波亦清。",
      "所從古無比，意氣送君行。"
    ]
  },
  {
    "uid": "QTS_496_019_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送裴中丞赴華州",
    "poem": [
      "我夢何曾應，看君渡滻川。",
      "自無仙掌分，非是聖心偏。",
      "徑草多生藥，庭花半落泉。",
      "人間有此郡，況在鳳城邊。"
    ]
  },
  {
    "uid": "QTS_496_020_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送徐員外赴河中從事",
    "poem": [
      "赤府從軍美，儒衣結束輕。",
      "涼飆下山寺，曉浪滿關城。",
      "閒坐饒詩景，高眠長道情。",
      "將軍不戰術，計日立功名。"
    ]
  },
  {
    "uid": "QTS_496_021_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送殷堯藩侍御赴同州",
    "poem": [
      "吟詩擲酒船，仙掌白樓前。",
      "從事關中貴，主人天下賢。",
      "此生無了日，終歲踏離筵。",
      "何計因歸去，深山恣意眠。"
    ]
  },
  {
    "uid": "QTS_496_022_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送崔中丞赴鄭州",
    "poem": [
      "僕射陂前郡，清高越四鄰。",
      "丹霄鳳詔下，太守虎符新。",
      "霧濕關城月，花香驛路塵。",
      "連枝相庭樹，歲歲一家春。"
    ]
  },
  {
    "uid": "QTS_496_023_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送丁端公赴河陰",
    "poem": [
      "炎天木葉焦，曉夕絕涼飆。",
      "念子獨歸縣，何人不在朝。",
      "市連風浪動，帆徹海門遙。",
      "飲盡樽中酒，同年同寂寥。"
    ],
    "variants": [
      {
        "line": 4,
        "text": "同",
        "variant": "共",
        "source": "一作「共」"
      }
    ]
  },
  {
    "uid": "QTS_496_024_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送鄭尚書赴興元",
    "poem": [
      "儒有登壇貴，何人得此功。",
      "紅旗燒密雪，白馬踏長風。",
      "斧鉞來天上，詩書理漢中。",
      "方知百勝略，應不在彎弓。"
    ]
  },
  {
    "uid": "QTS_496_025_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送田使君赴蔡州",
    "poem": [
      "長年離別情，百盞酒須傾。",
      "詩外應無思，人間半是行。",
      "路遙嘶白馬，林斷出紅旌。",
      "功業今應立，淮西有勁兵。"
    ]
  },
  {
    "uid": "QTS_496_026_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送無可上人遊邊",
    "poem": [
      "一缽與三衣，經行遠近隨。",
      "出家還養母，持律複能詩。",
      "春雪離京厚，晨鐘近塞遲。",
      "亦知蓮府客，夜坐喜同師。"
    ]
  },
  {
    "uid": "QTS_496_027_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送僧",
    "poem": [
      "人間擾擾唯閒事，自見高人只有詩。",
      "寂寞嵩峰雲外寺，常多夢裏過齋時。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "寂寞",
        "variant": "舊住",
        "source": "一作「舊住」"
      },
      {
        "line": 2,
        "text": "多夢",
        "variant": "聞定",
        "source": "一作「聞定」"
      }
    ]
  },
  {
    "uid": "QTS_496_028_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送僧",
    "poem": [
      "城中聽得新經論，卻過關東說向人。",
      "舊國門徒終日望，見時應是見真身。"
    ]
  },
  {
    "uid": "QTS_496_029_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送宋慎言",
    "poem": [
      "童稚便知聞，如今祇有君。",
      "百篇詩盡和，一盞酒須分。",
      "驛路多連水，州城半在雲。",
      "離情同落葉，向晚更紛紛。"
    ]
  },
  {
    "uid": "QTS_496_030_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送家兄赴任昭義",
    "poem": [
      "早得白眉名，之官濠上城。",
      "別離浮世事，迢遞長年情。",
      "廣陌垂花影，遙林起雨聲。",
      "出關春草長，過汴夏雲生。",
      "黠吏先潛去，疲人相次迎。",
      "宴餘和酒拜，魂夢共東行。"
    ]
  },
  {
    "uid": "QTS_496_031_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送崔玄亮赴果州冬夜宴韓卿宅",
    "poem": [
      "蘭燭照重茵，飛杯複幾分。",
      "主人寒不寐，上客曉離群。",
      "騎吏緣青壁，旌旗度白雲。",
      "劍銘生蘚色，巴字疊冰文。",
      "華省思仙侶，疲民愛使君。",
      "泠泠唯自適，郡邸有誰聞。"
    ]
  },
  {
    "uid": "QTS_496_032_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送喻鳧校書歸毘陵",
    "poem": [
      "主人庭葉黑，詩稿更誰書。",
      "闕下科名出，鄉中賦籍除。",
      "山春煙樹眾，江遠晚帆疏。",
      "吾亦家吳者，無因到弊廬。"
    ]
  },
  {
    "uid": "QTS_496_033_01",
    "volume": 496,
    "author": {
      "canonical": "四百九十六",
      "recorded": "四百九十六"
    },
    "title": "姚合 送董正字武歸常州覲親",
    "poem": [
      "路岐知不盡，離別自無窮。",
      "行客心方切，主人罇未空。",
      "楚檣收月下，江樹在潮中。",
      "人各還家去，還家慶不同。"
