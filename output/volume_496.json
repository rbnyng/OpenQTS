      "recorded": "四百九十六"
    },
    "title": "姚合 送潘傳秀才歸宣州",
    "poem": [
      "李白墳三尺，嵯峨萬古名。",
      "因君還故里，為我吊先生。",
      "晴日移虹影，空山出鶴聲。",
      "老郎閒未得，無計此中行。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "出",
        "variant": "聚",
        "source": "一作「聚」"
