[
  {
    "uid": "QTS_726_001_01",
    "volume": 726,
    "author": {
      "canonical": "陸貞洞",
      "recorded": "陸貞洞"
    },
    "title": "和",
    "poem": [
      "惆悵殘花怨暮春，孤鸞舞鏡倍傷神。",
      "清詞好箇干人事，疑是文姬第二身。"
    ],
    "notes": [
      {
        "content": "會昌時，有女子題詩三鄉驛，和者十人。",
        "context": "和《三鄉詩》",
        "original_title": "和《三鄉詩》",
        "type": "footnote"
      },
      {
        "content": "三鄉詩",
        "context": "和",
        "original_title": "和《三鄉詩》"
      }
    ]
  },
  {
    "uid": "QTS_726_002_01",
    "volume": 726,
    "author": {
      "canonical": "劉谷",
      "recorded": "劉谷"
    },
    "title": "和",
    "poem": [
      "蘭蕙芬香見玉姿，路傍花笑景遲遲。",
      "薴蘿山下無窮意，併在三鄉惜別時。"
    ],
    "notes": [
      {
        "content": "三鄉詩",
        "context": "和",
        "original_title": "和《三鄉詩》"
      }
    ]
  },
  {
    "uid": "QTS_726_003_01",
    "volume": 726,
    "author": {
      "canonical": "王祝",
      "recorded": "王祝"
    },
    "title": "和",
    "poem": [
      "女几山前嵐氣低，佳人留恨此中題。",
      "不知雲雨歸何處，空使王孫見即迷。"
    ],
    "notes": [
      {
        "content": "三鄉詩",
        "context": "和",
        "original_title": "和《三鄉詩》"
      }
    ]
  },
  {
    "uid": "QTS_726_004_01",
    "volume": 726,
    "author": {
      "canonical": "王滌",
      "recorded": "王滌"
    },
    "title": "和",
    "poem": [
      "浣紗遊女出闗東，舊跡新詞一夢中。",
      "槐陌柳亭何限事，年年回首向春風。"
    ],
    "notes": [
      {
        "content": "三鄉詩",
        "context": "和",
        "original_title": "和《三鄉詩》"
      }
    ]
  },
  {
    "uid": "QTS_726_005_01",
    "volume": 726,
    "author": {
      "canonical": "韋氷",
      "recorded": "韋氷"
    },
    "title": "和",
    "poem": [
      "來時歡笑去時哀，家國迢迢向越臺。",
      "待寫百年幽思盡，故宮流水莫相催。"
    ],
    "notes": [
      {
        "content": "三鄉詩",
        "context": "和",
        "original_title": "和《三鄉詩》"
      }
    ]
  },
  {
    "uid": "QTS_726_006_01",
    "volume": 726,
    "author": {
      "canonical": "李昌鄴",
      "recorded": "李昌鄴"
    },
    "title": "和",
    "poem": [
      "紅粉蕭娘手自題，分明幽怨發雲閨。",
      "不應更學文君去，泣向殘花歸剡溪。"
    ],
    "notes": [
      {
        "content": "三鄉詩",
        "context": "和",
        "original_title": "和《三鄉詩》"
      }
    ]
  },
  {
    "uid": "QTS_726_007_01",
    "volume": 726,
    "author": {
      "canonical": "王碩",
      "recorded": "王碩"
    },
    "title": "和",
    "poem": [
      "無姓無名越水濵，芳詞空怨路傍人。",
      "莫教才子偏惆悵，宋玉東家是舊鄰。"
    ],
    "notes": [
      {
        "content": "三鄉詩",
        "context": "和",
        "original_title": "和《三鄉詩》"
      }
    ]
  },
  {
    "uid": "QTS_726_008_01",
    "volume": 726,
    "author": {
      "canonical": "李縞",
      "recorded": "李縞"
    },
    "title": "和",
    "poem": [
      "會稽王、謝兩風流，王子沉淪謝女愁。",
      "歸思若隨文字在，路傍空為感千秋。"
    ],
    "notes": [
      {
        "content": "三鄉詩",
        "context": "和",
        "original_title": "和《三鄉詩》"
      }
    ]
  },
  {
    "uid": "QTS_726_009_01",
    "volume": 726,
    "author": {
      "canonical": "張綺",
      "recorded": "張綺"
    },
    "title": "和",
    "poem": [
      "張綺著",
      "洛川依舊好風光，蓮帳無因見女郎。",
      "雲雨散來音信斷，此生遺恨寄三鄉。"
    ],
    "notes": [
      {
        "content": "三鄉詩",
        "context": "和",
        "original_title": "和《三鄉詩》"
      }
    ]
  },
  {
    "uid": "QTS_726_010_01",
    "volume": 726,
    "author": {
      "canonical": "高衢",
      "recorded": "高衢"
    },
    "title": "和",
    "poem": [
      "南北千山與萬山，軒車誰不思鄉闗。",
      "獨留芳翰悲前跡，陌上恐傷桃李顏。"
    ],
    "notes": [
      {
        "content": "三鄉詩",
        "context": "和",
        "original_title": "和《三鄉詩》"
      }
    ]
  },
  {
    "uid": "QTS_726_011_01",
    "volume": 726,
    "author": {
      "canonical": "賈馳",
      "recorded": "賈馳",
      "gender": "male",
      "english_name": "Jia Chi",
      "wikidata_id": "Q22098554"
    },
    "title": "復覩三鄉題處留贈",
    "poem": [
      "壁古字未滅，聲長響不絕。",
      "蕙質本如雲，松心應耐雪。",
      "耿耿離幽谷，悠悠望甌越。",
      "杞婦哭夫時，城崩無此說。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "幽",
        "variant": "崖",
        "source": "一作「崖」"
      }
    ]
  },
  {
    "uid": "QTS_726_012_01",
    "volume": 726,
    "author": {
      "canonical": "賈馳",
      "recorded": "賈馳",
      "gender": "male",
      "english_name": "Jia Chi",
      "wikidata_id": "Q22098554"
    },
    "title": "秋入闗",
    "poem": [
      "河上微風來，闗頭樹初濕。",
      "今朝關城吏，又見孤客入。",
      "上國誰與期？西來徒自急。"
    ]
  },
  {
    "uid": "QTS_726_013_01",
    "volume": 726,
    "author": {
      "canonical": "趙光遠",
      "recorded": "趙光遠"
    },
    "title": "詠手二首 其一",
    "poem": [
      "妝成皓腕洗凝脂，背接紅巾掬水時。",
      "薄霧袖中拈玉斝，斜陽屏上撚青絲。",
      "喚人急拍臨前檻，摘杏高揎近曲池。",
      "好是琵琶弦畔見，細圓無節玉參差。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_726_013_02",
    "volume": 726,
    "author": {
      "canonical": "趙光遠",
      "recorded": "趙光遠"
    },
    "title": "詠手二首 其二",
    "poem": [
      "撚玉搓瓊軟復圓，緑窗誰見上琴弦？",
      "慢籠彩筆閒書字，斜指瑤階笑打錢。",
      "爐面試香添麝炷，舌頭輕點貼金鈿。",
      "象床珍簟宮棊處，拈定文楸占角邊。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_726_014_01",
    "volume": 726,
    "author": {
      "canonical": "趙光遠",
      "recorded": "趙光遠"
    },
    "title": "題妓萊兒壁",
    "poem": [
      "魚鑰獸環斜掩門，萋萋芳草憶王孫。",
      "醉憑青瑣窺韓壽，閒擲金梭惱謝鯤。",
      "不夜珠光連玉匣，辟寒釵影落瑤尊。",
      "欲知腸斷相思處，役盡江淹別後魂。"
    ]
  },
  {
    "uid": "QTS_726_015_01",
    "volume": 726,
    "author": {
      "canonical": "鄭良士",
      "recorded": "鄭良士"
    },
    "title": "題興化高田院橋亭",
    "poem": [
      "到此溪亭上，浮生始覺非。",
      "野僧還惜別，遊客亦忘歸。",
      "月滿千巖靜，風清一磬微。",
      "何時脫塵役，杖履願相依。"
    ]
  },
  {
    "uid": "QTS_726_016_01",
    "volume": 726,
    "author": {
      "canonical": "鄭良士",
      "recorded": "鄭良士"
    },
    "title": "遊九鯉湖",
    "poem": [
      "仄徑傾崖不可通，湖嵐林靄共溟濛。",
      "九溪瀑影飛花外，萬樹春聲細雨中。",
      "覆石雲閒丹竈冷，採芝人去洞門空。",
      "我來不乞邯鄲夢，取醉聊乘鄭國風。"
    ]
  },
  {
    "uid": "QTS_726_017_01",
    "volume": 726,
    "author": {
      "canonical": "鄭良士",
      "recorded": "鄭良士"
    },
    "title": "寄富洋院禪者",
    "poem": [
      "畫破青山路一條，走鞭飛葢去何遙。",
      "礙天巖樹春先冷，鎖院溪雲晝不銷。",
      "霅上茗芽因客煑，海南沈屑為齋燒。",
      "誰能學得空門士，冷卻心灰守寂寥。"
    ]
  },
  {
    "uid": "QTS_726_018_01",
    "volume": 726,
    "author": {
      "canonical": "蕭項",
      "recorded": "蕭項"
    },
    "title": "贈翁承贊漆林書堂詩",
    "poem": [
      "軺車故國世應稀，昔日書堂二紀歸。",
      "手植松筠同茂盛，身榮金紫倍光輝。",
      "入門鄰里喧迎接，列坐兒童見等威。",
      "卻對芸窗勤苦處，舉頭全是錦為衣。"
    ]
  }
]