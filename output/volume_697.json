      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "送崔郎中往使西川行在",
    "poem": [
      "拜書辭玉帳，萬里劔關長。",
      "新馬杏花色，綠袍春草香。",
      "一身朝玉陛，幾日過銅梁。",
      "莫戀爐邊醉，僊宮待侍郎。"
    ]
  },
  {
    "uid": "QTS_697_013_01",
    "volume": 697,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "潤州顯濟閣曉望",
    "poem": [
      "清曉水如鏡，隔江人似鷗。",
      "遠煙藏海島，初日照揚州。",
      "地壯孫權氣，雲凝庾信愁。",
      "一篷何處客，吟憑釣魚舟。"
    ]
  },
  {
    "uid": "QTS_697_014_01",
    "volume": 697,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "觀淛西府相畋遊",
    "poem": [
      "十里旌旗十萬兵，等閒遊獵出軍城。",
      "紫袍日照金鵝鬬，紅旆風吹畫虎獰。",
      "帶箭彩禽雲外落，避鵰寒兔月中驚。",
      "歸來一路笙歌滿，更有僊娥載酒迎。"
    ]
  },
  {
    "uid": "QTS_697_015_01",
    "volume": 697,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "官莊",
    "poem": [
      "誰氏園林一簇煙，路人遙指盡長歎。",
      "桑田稻澤今無主，新犯香醪沒入官。"
    ],
