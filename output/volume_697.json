      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "江上逢史館李學士",
    "poem": [
      "前年分袂陝城西，醉憑征軒日欲低。",
      "去浪指期魚必變，出門回首馬空嘶。",
      "關河自此為征壘，城闕於今陷戰鼙。",
      "誰謂世途陵是谷，燕來還識舊巢泥。"
    ],
    "notes": [
      {
        "line": 3,
        "content": "時巢宼未平。",
        "context": "誰謂世途陵是谷，燕來還識舊巢泥。"
      }
    ]
  },
  {
    "uid": "QTS_697_003_01",
    "volume": 697,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "金陵圖",
    "poem": [
      "誰謂傷心畫不成，畫人心逐世人情。",
      "君看六幅南朝事，老木寒雲滿故城。"
    ]
  },
  {
    "uid": "QTS_697_004_01",
    "volume": 697,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "謁蔣帝廟",
    "poem": [
      "建業城邊蔣帝祠，素髯清骨舊風姿。",
      "江聲似激秦軍破，山勢如匡晉祚危。",
      "殘雪嶺頭明組練，晚霞簷外簇旌旗。",
      "金陵客路方流落，空祝回鑾奠酒巵。"
    ]
  },
  {
    "uid": "QTS_697_005_01",
    "volume": 697,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "聞再幸梁洋",
    "poem": [
      "才喜中原息戰鼙，又聞天子幸巴西。",
      "延燒魏闕非關燕，大狩陳倉不為雞。",
      "興慶玉龍寒自躍，昭陵石馬夜空嘶。",
      "遙思萬里行宮夢，太白山前月欲低。"
    ]
  },
  {
    "uid": "QTS_697_006_01",
    "volume": 697,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "王道者",
    "poem": [
      "五雲遙指海中央，金鼎曾傳肘後方。",
      "三島路岐空有月，十洲花木不知霜。",
      "因攜竹杖聞龍氣，為使仙童帶橘香。",
      "應笑我曹身是夢，白頭猶自學詩狂。"
    ]
  },
  {
    "uid": "QTS_697_007_01",
    "volume": 697,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "陪金陵府相中堂夜宴",
    "poem": [
      "滿耳笙歌滿眼花，滿樓珠翠勝吳娃。",
      "因知海上神仙窟，只似人間富貴家。",
      "繡戶夜攢紅燭市，舞衣晴曳碧天霞。",
      "卻愁宴罷青蛾散，楊子江頭月半斜。"
    ]
  },
  {
    "uid": "QTS_697_008_01",
    "volume": 697,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "和侯秀才同友生泛舟溪中相招之作",
    "poem": [
      "嵇阮相將棹酒船，晚風侵浪水侵舷。",
      "輕如控鯉初離岸，遠似乘槎欲上天。",
      "雨外鳥歸吳苑樹，鏡中人入洞庭煙。",
      "憑君不用回舟疾，今夜西江月正圓。"
    ]
  },
  {
    "uid": "QTS_697_009_01",
    "volume": 697,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "贈野童",
    "poem": [
      "羨爾無知野性真，亂搔蓬髮笑看人。",
      "閒衝暮雨騎牛去，肯問中興社稷臣。"
    ]
  },
  {
    "uid": "QTS_697_010_01",
    "volume": 697,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "代書寄馬",
    "poem": [
      "驅馳曾在五侯家，見說初生自渥窪。",
      "鬃白似披梁苑雪，頸肥如撲杏園花。",
      "休嫌綠綬嘶貧舍，好著紅纓入使衙。",
      "穩上雲衢千萬里，年年長踏魏堤沙。"
    ]
  },
  {
    "uid": "QTS_697_011_01",
    "volume": 697,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "題淮陰侯廟",
    "poem": [
      "滿把椒漿奠楚祠，碧幢黃鉞舊英威。",
      "能扶漢代成王業，忍見唐民陷戰機。",
      "雲夢去時高鳥盡，淮陰歸日故人稀。",
      "如何不借平齊策，空看長星落賊圍。"
    ],
    "variants": [
      {
