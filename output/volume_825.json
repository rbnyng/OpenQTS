[
  {
    "uid": "QTS_825_001_01",
    "volume": 825,
    "author": {
      "canonical": "可止",
      "recorded": "可止",
      "gender": "male"
    },
    "title": "山居",
    "poem": [
      "雪消春力展，花漫洞門垂。",
      "果長纖枝曲，巖崩直道移。",
      "重猿圍淺井，鬬鼠下疎籬。",
      "寒食微燈在，高風勢徹陂。"
    ]
  },
  {
    "uid": "QTS_825_002_01",
    "volume": 825,
    "author": {
      "canonical": "可止",
      "recorded": "可止",
      "gender": "male"
    },
    "title": "贈樊川長老",
    "poem": [
      "瘦顏顴骨見，滿面雪毫垂。",
      "坐石鳥疑死，出門人謂癡。",
      "照身潭入楚，浸影檜生隋。",
      "太白曾經夏，清風涼四肢。"
    ],
    "notes": [
      {
        "content": "一作清尚詩。",
        "context": "贈樊川長老",
        "original_title": "贈樊川長老",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_825_003_01",
    "volume": 825,
    "author": {
      "canonical": "可止",
      "recorded": "可止",
      "gender": "male"
    },
    "title": "寄積麥山會如長老",
    "poem": [
      "默然如大道，塵世不相關。",
      "青檜行時靜，白雲禪處閒。",
      "貧高一生行，病長十年顏。",
      "夏滿期遊寺，尋山又下山。"
    ]
  },
  {
    "uid": "QTS_825_004_01",
    "volume": 825,
    "author": {
      "canonical": "可止",
      "recorded": "可止",
      "gender": "male"
    },
    "title": "送僧",
    "poem": [
      "四海無拘繫，行心興自濃。",
      "百年三事衲，萬里一枝筇。",
      "夜減當晴影，春消過雪蹤。",
      "白雲深處去，知宿在何峯？"
    ]
  },
  {
    "uid": "QTS_825_005_01",
    "volume": 825,
    "author": {
      "canonical": "可止",
      "recorded": "可止",
      "gender": "male"
    },
    "title": "哭賈島",
    "poem": [
      "燕生松雪地，蜀死葬山根。",
      "詩僻降今古，官卑誤子孫。",
      "塚欄寒月色，人哭苦吟魂。",
      "墓雨滴碑字，年年添蘚痕。"
    ]
  },
  {
    "uid": "QTS_825_006_01",
    "volume": 825,
    "author": {
      "canonical": "可止",
      "recorded": "可止",
      "gender": "male"
    },
    "title": "雪十二韻",
    "poem": [
      "落處咸過尺，翛然物象淒。",
      "瑞凝金殿上，寒甚玉關西。",
      "潤比江河普，明將日月齊。",
      "淩雲花頂膩，鎖徑竹梢低。",
      "出谷樵童怯，歸林野鳥迷。",
      "煮茶融破練，磨墨染成黳。",
      "陷兔埋平澤，和魚凍合溪。",
      "入樓消酒力，當檻寫詩題。",
      "道路依憑馬，朝昏委託雞。",
      "洞深猿作族，松亞鶴移棲。",
      "及夏清巖穴，經春溜石梯。",
      "豐年兼泰國，天道育黔黎。"
    ]
  },
  {
    "uid": "QTS_825_007_01",
    "volume": 825,
    "author": {
      "canonical": "可止",
      "recorded": "可止",
      "gender": "male"
    },
    "title": "精舍遇雨",
    "poem": [
      "空門寂寂淡吾身，溪雨微微洗客塵。",
      "臥向白雲情未盡，任他黃鳥醉芳春。"
    ]
  },
  {
    "uid": "QTS_825_008_01",
    "volume": 825,
    "author": {
      "canonical": "可止",
      "recorded": "可止",
      "gender": "male"
    },
    "title": "小雪",
    "poem": [
      "落雪臨風不厭看，更多還恐蔽林巒。",
      "愁人正在書窓下，一片飛來一片寒。"
    ]
  },
  {
    "uid": "QTS_825_009_01",
    "volume": 825,
    "author": {
      "canonical": "可止",
      "recorded": "可止",
      "gender": "male"
    },
    "title": "送婆羅門僧",
    "poem": [
      "雪嶺金河獨向東，吳山楚澤意無窮。",
      "如今白首鄉心盡，萬里歸程在夢中。"
    ]
  },
  {
    "uid": "QTS_825_010_01",
    "volume": 825,
    "author": {
      "canonical": "可止",
      "recorded": "可止",
      "gender": "male"
    },
    "title": "句",
    "poem": [
      "不知誰會喃喃語，必向王前報太平。"
    ],
    "notes": [
      {
        "line": 2,
        "content": "中山節度王處直座詠白鵲，時諸侯兼併，王欲繼好息民，故云。《高僧傳》",
        "context": "句"
      }
    ]
  },
  {
    "uid": "QTS_825_011_01",
    "volume": 825,
    "author": {
      "canonical": "雲表",
      "recorded": "雲表",
      "gender": "male"
    },
    "title": "寒食日",
    "poem": [
      "寒食悲看郭外春，野田無處不傷神。",
      "平原纍纍添新塚，半是去年來哭人。"
    ],
    "variants": [
