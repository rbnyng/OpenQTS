    ]
  },
  {
    "uid": "QTS_825_019_01",
    "volume": 825,
    "author": {
      "canonical": "卿雲",
      "recorded": "卿雲",
      "gender": "male"
    },
    "title": "秋日江居閒詠",
    "poem": [
      "寄居江島邊，閒詠見秋殘。",
      "草白牛羊瘦，風高猨鳥寒。",
      "檢方醫故疾，挑薺備中餐。",
      "時復停書卷，鉏莎種木蘭。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "見",
        "variant": "幾",
        "source": "一作「幾」"
      },
      {
        "line": 2,
        "text": "瘦",
        "variant": "攫",
        "source": "一作「攫」"
      }
    ]
  },
  {
    "uid": "QTS_825_020_01",
    "volume": 825,
    "author": {
      "canonical": "卿雲",
      "recorded": "卿雲",
      "gender": "male"
    },
    "title": "長安言懷寄沈彬侍郎",
    "poem": [
      "故園梨嶺下，歸路接天涯。",
      "生作長安草，勝為邊地花。",
      "雁南飛不到，書北寄來賒。",
      "堪羨神仙客，青雲早致家。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "梨",
        "variant": "黎",
        "source": "一作「黎」"
      }
    ]
  },
  {
    "uid": "QTS_825_021_01",
    "volume": 825,
    "author": {
      "canonical": "卿雲",
      "recorded": "卿雲",
      "gender": "male"
    },
    "title": "送人游塞",
    "poem": [
      "去去玉關路，省君曾未行。",
      "塞深多伏寇，時靜亦屯兵。",
      "雪每先秋降，花嘗近夏生。",
      "閒陪射鵰將，應到受降城。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "亦",
        "variant": "欲",
        "source": "一作「欲」"
      }
    ]
  },
  {
    "uid": "QTS_825_022_01",
    "volume": 825,
    "author": {
      "canonical": "隱巒",
      "recorded": "隱巒",
      "gender": "male"
    },
    "title": "逢老人",
    "poem": [
      "路逢一老翁，兩鬢白如雪。",
      "一里二里行，四回五回歇。"
    ]
  },
  {
    "uid": "QTS_825_023_01",
    "volume": 825,
    "author": {
      "canonical": "隱巒",
      "recorded": "隱巒",
      "gender": "male"
    },
    "title": "牧童",
    "poem": [
      "牧童見人俱不識，盡著芒鞋戴箬笠。",
      "朝陽未出眾山晴，露滴蓑衣猶半濕。",
      "二月三月時，平原草初綠。",
      "三箇五箇騎羸牛，前村後村來放牧。",
      "笛聲纔一舉，眾稚齊歌舞。",
      "看看白日向西斜，各自騎牛又歸去。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "識",
        "variant": "會",
        "source": "一作「會」"
      }
    ]
  },
  {
    "uid": "QTS_825_024_01",
    "volume": 825,
    "author": {
      "canonical": "隱巒",
      "recorded": "隱巒",
      "gender": "male"
    },
    "title": "蜀中送人游廬山",
    "poem": [
      "居遊正值芳春月，蜀道千山皆秀發。",
      "溪邊十里五里花，雲外三峰兩峰雪。",
      "君上匡山我舊居，松蘿拋擲十年餘。",
      "君行試到山前問，山鳥只今相憶無。"
    ]
  },
  {
    "uid": "QTS_825_025_01",
    "volume": 825,
    "author": {
      "canonical": "隱巒",
      "recorded": "隱巒",
      "gender": "male"
    },
    "title": "琴",
    "poem": [
      "七條絲上寄深意，澗水松風生十指。",
      "自乃知音猶尚稀，欲教更入何人耳。"
    ]
  },
  {
    "uid": "QTS_825_026_01",
    "volume": 825,
    "author": {
      "canonical": "隱巒",
      "recorded": "隱巒",
      "gender": "male"
    },
    "title": "浮橋",
    "poem": [
      "橫壓驚波防沒溺，當初元剏是軍機。",
      "行人到此全無滯，一片江雲踏欲飛。"
    ]
  },
  {
    "uid": "QTS_825_027_01",
    "volume": 825,
    "author": {
      "canonical": "泠然",
      "recorded": "泠然",
      "gender": "male"
    },
    "title": "宿九華化成寺莊",
    "poem": [
      "佛寺孤莊千嶂間，我來詩境強相關。",
      "巖邊樹動猿下澗，雲裏錫鳴僧上山。",
      "松月影寒生碧落，石泉聲亂噴潺湲。",
      "明朝更躡層霄去，誓共煙霞到老閒。"
    ]
  },
  {
    "uid": "QTS_825_028_01",
    "volume": 825,
    "author": {
      "canonical": "大愚",
      "recorded": "大愚",
      "gender": "male"
    },
    "title": "乞荊浩畫",
    "poem": [
      "六幅故牢健，知君恣筆蹤。",
      "不求千澗水，止要兩株松。",
      "樹下留盤石，天邊縱遠峯。",
      "近巖幽濕處，惟藉墨煙濃。"
    ]
  },
  {
    "uid": "QTS_825_029_01",
    "volume": 825,
    "author": {
      "canonical": "懷濬",
      "recorded": "懷濬",
      "gender": "male"
    },
    "title": "上歸州刺史代通狀二首 其一",
    "poem": [
      "家在閩山西復西，其中歲歲有鶯啼。",
      "如今不在鶯啼處，鶯在舊時啼處啼。"
    ],
    "notes": [
      {
        "content": "懐濬能逆知未兆之事，東里人以神聖待之，刺史於公捕詰，乃以詩通狀於異而釋之。",
        "context": "上歸州刺史代通狀二首",
        "original_title": "上歸州刺史代通狀二首",
        "type": "footnote"
      }
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_825_029_02",
    "volume": 825,
    "author": {
      "canonical": "懷濬",
      "recorded": "懷濬",
      "gender": "male"
    },
    "title": "上歸州刺史代通狀二首 其二",
    "poem": [
      "家在閩山東復東，其中歲歲有花紅。",
      "而今不在花紅處，花在舊時紅處紅。"
    ],
    "notes": [
      {
        "content": "懐濬能逆知未兆之事，東里人以神聖待之，刺史於公捕詰，乃以詩通狀於異而釋之。",
        "context": "上歸州刺史代通狀二首",
