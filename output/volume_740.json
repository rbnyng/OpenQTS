      "recorded": "左偃",
      "gender": "male",
      "english_name": "Zuo Yan",
      "wikidata_id": "Q45458352"
    },
    "title": "寄廬山白上人",
    "poem": [
      "潦倒門前客，閒眠歲又殘。",
      "連天數峰雪，終日與誰看。",
      "萬丈高松古，千尋落水寒。",
      "仍聞有新作，嬾寄入長安。"
    ]
  },
  {
    "uid": "QTS_740_022_01",
    "volume": 740,
    "author": {
      "canonical": "左偃",
      "recorded": "左偃",
      "gender": "male",
      "english_name": "Zuo Yan",
      "wikidata_id": "Q45458352"
    },
    "title": "寄韓侍郎",
    "poem": [
      "謀身謀隱兩無成，拙計深慙負耦耕。",
      "漸老可堪懷故國，多愁翻覺厭浮生。",
      "言詩幸遇明公許，守朴甘遭俗者輕。",
      "今日況聞搜草澤，獨悲顦顇臥昇平。"
    ]
  },
  {
    "uid": "QTS_740_023_01",
