  {
    "uid": "QTS_869_013_01",
    "volume": 869,
    "author": {
      "canonical": "釋元康",
      "recorded": "釋元康",
      "gender": "male"
    },
    "title": "與講師互謔",
    "poem": [
      "甘桃不結實，苦李壓低枝。",
      "輪王千個子，巷伯勿孫兒。"
    ],
    "notes": [
      {
        "type": "author_attribution",
        "line": 1,
        "content": "釋元康",
        "context": "甘桃不結實，苦李壓低枝。"
      },
      {
        "type": "author_attribution",
        "line": 2,
        "content": "講師",
        "context": "輪王千個子，巷伯勿孫兒。"
      }
    ]
  },
  {
    "uid": "QTS_869_014_01",
    "volume": 869,
    "author": {
      "canonical": "李榮",
      "recorded": "李榮"
    },
    "title": "詠興善寺佛殿災",
    "poem": [
      "道善何曾善，言興且不興。",
      "如來燒赤盡，惟有一群僧。"
    ]
  },
  {
    "uid": "QTS_869_015_01",
    "volume": 869,
    "author": {
      "canonical": "張元一",
      "recorded": "張元一",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Zhang Maozong",
      "wikidata_id": "Q45360794"
    },
    "title": "敘可笑事",
    "poem": [
      "朱前疑著綠，逯仁傑著朱。",
      "閻知微騎馬，馬吉甫騎驢。",
      "將名作姓李千里，將姓作名吳棲梧。",
      "左台胡禦史，右台禦史胡。"
    ]
  },
  {
    "uid": "QTS_869_016_01",
    "volume": 869,
    "author": {
      "canonical": "張元一",
      "recorded": "張元一",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Zhang Maozong",
      "wikidata_id": "Q45360794"
    },
    "title": "嘲武懿宗",
    "poem": [
      "長弓短度箭，蜀馬臨階騙。",
      "去賊七百里，隈牆獨自戰。",
      "忽然逢著賊，騎豬向南䞼。"
    ]
  },
  {
    "uid": "QTS_869_017_01",
    "volume": 869,
    "author": {
      "canonical": "張元一",
      "recorded": "張元一",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Zhang Maozong",
      "wikidata_id": "Q45360794"
    },
    "title": "又嘲",
    "poem": [
      "裹頭極草草，掠鬢不菶菶。",
      "未見桃花麵皮，漫作杏子眼孔。"
    ]
  },
  {
    "uid": "QTS_869_018_01",
    "volume": 869,
    "author": {
      "canonical": "張元一",
      "recorded": "張元一",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Zhang Maozong",
      "wikidata_id": "Q45360794"
    },
    "title": "詠靜樂縣主",
    "poem": [
      "馬帶桃花錦，裙銜綠草羅。",
      "定知幃帽底，儀容似大哥。"
    ]
  },
  {
    "uid": "QTS_869_019_01",
    "volume": 869,
    "author": {
      "canonical": "杜易簡",
      "recorded": "杜易簡"
    },
    "title": "嘲格輔元",
    "poem": [
      "有恥宿龍門，精彩先瞰渾。",
      "眼瘦呈近店，睡響徹遙林。",
      "埒囊將舊識，制被異新婚。",
      "誰言驄馬使，翻作蟄熊蹲。"
    ]
  },
  {
    "uid": "QTS_869_020_01",
    "volume": 869,
    "author": {
      "canonical": "石抱忠",
      "recorded": "石抱忠"
    },
    "title": "始平諧詩",
    "poem": [
      "平明發始平，薄暮至何城。",
      "庫塔朝雲上，晃池夜月明。",
      "略彴橋頭逢長史，欞星門外揖司兵，一群縣尉驢騾驟，數個參軍鵝鴨行。"
    ]
  },
  {
    "uid": "QTS_869_021_01",
    "volume": 869,
    "author": {
      "canonical": "梁載言",
      "recorded": "梁載言",
      "gender": "male",
      "english_name": "Liang Zaiyan",
      "wikidata_id": "Q10356940"
    },
    "title": "詠傅岩監祠",
    "poem": [
      "聞道監中溜，初言是大祠。",
      "很傍索傳馬，傯動出安徽。",
      "衛司無帟幕，供膳乏鮮肥。",
      "形容消瘦盡，空往復空歸。"
    ]
  },
  {
    "uid": "QTS_869_022_01",
    "volume": 869,
    "author": {
      "canonical": "劉行敏",
      "recorded": "劉行敏"
    },
    "title": "嘲崔生",
    "poem": [
      "崔生犯夜行，武候正嚴更。",
      "襆頭拳下落，高髻掌中擎。",
      "杖跡胸前出，繩文腕後生。",
      "愁人不惜夜，隨意曉參橫。"
    ]
  },
  {
    "uid": "QTS_869_023_01",
    "volume": 869,
    "author": {
      "canonical": "劉行敏",
      "recorded": "劉行敏"
    },
    "title": "又嘲楊文瓘",
    "poem": [
      "武陵敬愛客，終宴不知疲。",
      "遣共渾王飲，錯宴延陀兒。",
      "始被鴻臚識，終蒙禦史知。",
      "精神既如此，長歎複何為。"
    ]
  },
  {
    "uid": "QTS_869_024_01",
    "volume": 869,
    "author": {
      "canonical": "劉行敏",
      "recorded": "劉行敏"
    },
    "title": "嘲李叔慎、賀蘭僧伽、杜善賢",
    "poem": [
      "叔慎騎烏馬，僧伽把漆弓。",
      "喚取長安令，共獵北山熊。"
    ]
  },
  {
    "uid": "QTS_869_025_01",
    "volume": 869,
    "author": {
      "canonical": "陸子",
      "recorded": "陸子"
    },
    "title": "嘲父",
    "poem": [
      "陸餘慶，筆頭無力觜頭硬。",
      "一朝受辭訟，十日判不竟。"
    ]
  },
  {
    "uid": "QTS_869_026_01",
    "volume": 869,
    "author": {
      "canonical": "楊延玉",
      "recorded": "楊延玉"
    },
    "title": "回波詞",
    "poem": [
      "回波爾時廷玉，打獠取錢未足。",
      "阿姑婆見作天子，傍人不得棖觸。"
    ]
  },
  {
    "uid": "QTS_869_027_01",
    "volume": 869,
    "author": {
      "canonical": "中宗朝優人",
      "recorded": "中宗朝優人",
      "period": "Early Tang"
    },
    "title": "回波詞",
    "poem": [
      "回波爾時栲栳，怕婦也是大好。",
      "外邊只有裴談，內裏無過李老。"
    ]
  },
  {
    "uid": "QTS_869_028_01",
    "volume": 869,
    "author": {
      "canonical": "崔日用",
      "recorded": "崔日用",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Cui Riyong",
      "wikidata_id": "Q5192695"
    },
    "title": "乞金魚詞",
    "poem": [
      "台中鼠子直須諳，信足跳樑上壁龕。",
      "倚翻燈脂汙張五，還來齧帶報韓三。",
      "莫浪語，直王相。",
      "大家必若賜金龜，賣卻貓兒相報賞。"
    ]
  },
  {
    "uid": "QTS_869_029_01",
    "volume": 869,
    "author": {
      "canonical": "崔日用",
      "recorded": "崔日用",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Cui Riyong",
      "wikidata_id": "Q5192695"
    },
    "title": "又賜宴自歌",
    "poem": [
      "東館總是鵷鸞，南台自多杞梓。",
      "日用讀書萬卷，何忍不蒙學士。",
      "墨制簾下出來，微臣眼看喜死。"
    ]
  },
  {
    "uid": "QTS_869_030_01",
    "volume": 869,
    "author": {
      "canonical": "吳人",
      "recorded": "吳人"
    },
    "title": "詠癡",
    "poem": [
      "榆兒複榆婦，造屋兼造車。",
      "十七八九夜，還書複借書。"
    ]
  },
  {
    "uid": "QTS_869_031_01",
    "volume": 869,
    "author": {
      "canonical": "封袍一",
      "recorded": "封袍一"
    },
    "title": "歇後",
    "poem": [
      "面作天地玄，鼻有雁門紫。",
      "既無左達承，何勞罔談彼。"
    ]
  },
  {
    "uid": "QTS_869_032_01",
    "volume": 869,
    "author": {
      "canonical": "曲崇玉",
      "recorded": "曲崇玉"
    },
    "title": "送司功入京",
    "poem": [
      "崇裕有幸會，得遇明流行。",
      "司士向京去，曠野哭聲哀。"
    ]
  },
  {
    "uid": "QTS_869_033_01",
    "volume": 869,
    "author": {
      "canonical": "權龍褒",
      "recorded": "權龍褒",
      "gender": "male",
      "wikidata_id": "Q21015092"
    },
    "title": "嶺南歸後獻詩",
    "poem": [
      "龍褒有何罪，天恩放嶺南。",
      "敕知無罪過，追來與將軍。"
    ]
  },
  {
    "uid": "QTS_869_034_01",
    "volume": 869,
    "author": {
      "canonical": "權龍褒",
      "recorded": "權龍褒",
      "gender": "male",
      "wikidata_id": "Q21015092"
    },
    "title": "初到滄州呈州官",
    "poem": [
      "遙看滄海城，楊柳鬱青青。",
      "中央一群漢，聚坐打杯觥。"
    ]
  },
  {
    "uid": "QTS_869_035_01",
    "volume": 869,
    "author": {
      "canonical": "權龍褒",
      "recorded": "權龍褒",
      "gender": "male",
      "wikidata_id": "Q21015092"
    },
    "title": "秋日述懷",
    "poem": [
      "簷前飛七百，雪白後園強。",
      "飽食房裏側，家糞集野螂。"
    ]
  },
  {
    "uid": "QTS_869_036_01",
    "volume": 869,
    "author": {
      "canonical": "權龍褒",
      "recorded": "權龍褒",
      "gender": "male",
      "wikidata_id": "Q21015092"
    },
    "title": "喜雨",
    "poem": [
      "暗去也沒雨，明來也沒雲。",
      "日頭赫赤出，地上綠氤氳。"
    ]
  },
  {
    "uid": "QTS_869_037_01",
    "volume": 869,
    "author": {
      "canonical": "權龍褒",
      "recorded": "權龍褒",
      "gender": "male",
      "wikidata_id": "Q21015092"
    },
    "title": "皇太子夏日賜宴詩",
    "poem": [
      "嚴霜白浩浩，明月赤團團。"
    ]
  },
  {
    "uid": "QTS_869_038_01",
    "volume": 869,
    "author": {
      "canonical": "崔泰之",
      "recorded": "崔泰之"
    },
    "title": "哭李嶠詩",
    "poem": [
      "台閣神仙地，衣冠君子鄉。",
      "昨朝猶對坐，今日忽雲亡。",
      "魂隨司命鬼，魄逐見閻王。",
      "此時罷歡笑，無複向朝堂。"
    ]
  },
  {
    "uid": "QTS_869_039_01",
    "volume": 869,
    "author": {
      "canonical": "蘇頲",
      "recorded": "蘇頲",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Su Ting",
      "wikidata_id": "Q5956587"
    },
    "title": "詠尹字",
    "poem": [
      "醜雖有足，甲不全身。",
      "見君無口，知伊少人。"
    ]
  },
  {
    "uid": "QTS_869_040_01",
    "volume": 869,
    "author": {
      "canonical": "張敬忠",
      "recorded": "張敬忠",
      "gender": "male",
      "english_name": "Zhang Jingzhong",
      "wikidata_id": "Q18909195"
    },
    "title": "詠王主敬",
    "poem": [
      "有意嫌兵部，專心望考功。",
      "誰知腳踜蹬，卻落省牆東。"
    ]
  },
  {
    "uid": "QTS_869_041_01",
    "volume": 869,
    "author": {
      "canonical": "韋鏗",
      "recorded": "韋鏗"
    },
    "title": "嘲邵景、蕭嵩",
    "poem": [
      "一雙鬍子著緋袍，一個須多一鼻高。",
      "相對廳前捺且立，自慚身品世間毛。"
    ]
