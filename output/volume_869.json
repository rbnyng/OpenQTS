[
  {
    "uid": "QTS_869_001_01",
    "volume": 869,
    "author": {
      "canonical": "李淵",
      "recorded": "李淵",
      "gender": "male",
      "period": "Pre-Tang",
      "english_name": "Emperor Gaozu of Tang",
      "wikidata_id": "Q9700"
    },
    "title": "嘲蘇世長",
    "poem": [
      "名長意短，口正心邪。",
      "棄忠貞於鄭國，忘信義於吾家。"
    ]
  },
  {
    "uid": "QTS_869_002_01",
    "volume": 869,
    "author": {
      "canonical": "李旦",
      "recorded": "李旦",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Emperor Ruizong of Tang",
      "wikidata_id": "Q9722"
    },
    "title": "戲題畫",
    "poem": [
      "喚出眼，何用苦深藏。",
      "縮卻鼻，何畏不聞香。"
    ]
  },
  {
    "uid": "QTS_869_003_01",
    "volume": 869,
    "author": {
      "canonical": "歐陽詢",
      "recorded": "歐陽詢",
      "gender": "male",
      "period": "Pre-Tang",
      "english_name": "Ouyang Xun",
      "wikidata_id": "Q1207679"
    },
    "title": "嘲蕭瑀射",
    "poem": [
      "急風吹緩箭，弱手馭強弓。",
      "欲高翻複下，應西還更東。",
      "十回俱著地，兩手並擎空。",
      "借問誰為此，乃應是宋公。"
    ]
  },
  {
    "uid": "QTS_869_004_01",
    "volume": 869,
    "author": {
      "canonical": "長孫無忌",
      "recorded": "長孫無忌",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Zhangsun Wuji",
      "wikidata_id": "Q1192341"
    },
    "title": "與歐陽詢互嘲",
    "poem": [
      "聳膊成山字，埋肩不出頭。",
      "誰家麟角上，畫此一獼猴。"
    ]
  },
  {
    "uid": "QTS_869_005_01",
    "volume": 869,
    "author": {
      "canonical": "長孫無忌",
      "recorded": "長孫無忌",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Zhangsun Wuji",
      "wikidata_id": "Q1192341"
    },
    "title": "與歐陽詢互嘲",
    "poem": [
      "索頭連背暖，漫襠畏肚寒。",
      "只因心渾渾，所以麵團團。"
    ]
  },
  {
    "uid": "QTS_869_006_01",
    "volume": 869,
    "author": {
      "canonical": "裴略",
      "recorded": "裴略"
    },
    "title": "為溫僕射嘲竹",
    "poem": [
      "竹，風吹青肅肅。",
      "淩冬葉不凋，經春子不熟。",
      "虛心未得待國士，皮上何須生節目。"
    ]
  },
  {
    "uid": "QTS_869_007_01",
    "volume": 869,
    "author": {
      "canonical": "裴略",
      "recorded": "裴略"
    },
    "title": "又嘲屏牆",
    "poem": [
      "高下八九尺，東西六七步。",
      "突兀當廳坐，幾許遮賢路。"
    ]
  },
  {
    "uid": "QTS_869_008_01",
    "volume": 869,
    "author": {
      "canonical": "省吏",
      "recorded": "省吏"
    },
    "title": "嘲崔左丞",
    "poem": [
      "崔子曲如鉤，隨例得封侯。",
      "髆上全無項，胸前別有頭。"
    ]
  },
  {
    "uid": "QTS_869_009_01",
    "volume": 869,
    "author": {
      "canonical": "選人",
      "recorded": "選人"
    },
    "title": "嘲高士廉木履",
    "poem": [
      "刺鼻何曾嚏，蹋面不知嗔。",
      "高生兩個齒，自謂得勝人。"
    ]
  },
  {
    "uid": "QTS_869_010_01",
    "volume": 869,
    "author": {
      "canonical": "裴玄智",
      "recorded": "裴玄智"
    },
    "title": "書化度藏院壁",
    "poem": [
      "將肉遣狼守，置骨向狗頭。",
      "自非阿羅漢，焉能免得偷。"
    ]
  },
  {
    "uid": "QTS_869_011_01",
    "volume": 869,
    "author": {
      "canonical": "竇昉",
      "recorded": "竇昉"
    },
    "title": "嘲許子儒",
    "poem": [
      "不能專習禮，虛心強覓階。",
      "一年辭爵弁，半歲履麻鞋。",
      "瓦惡頻䝉𢸗，牆虛屢被叉。",
      "映樹便側睡，過匱即放乖。",
      "歲暮良工畢，言是越朋儕。",
      "今日綸言降，方知愚計喎。"
    ]
  },
  {
    "uid": "QTS_869_012_01",
    "volume": 869,
    "author": {
      "canonical": "梁寶",
      "recorded": "梁寶"
    },
    "title": "與趙神德互嘲",
    "poem": [
      "趙神德，天上既無雲，閃電何以無準則？",
      "向者入門來，案後惟見一挺墨。",
      "官裏料硃砂，半眼供一國。",
      "磨公小拇指，塗得太社北。"
    ],
    "notes": [
