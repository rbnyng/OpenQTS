  {
    "uid": "QTS_495_015_01",
    "volume": 495,
    "author": {
      "canonical": "張勝之",
      "recorded": "張勝之",
      "gender": "male",
      "wikidata_id": "Q18908994"
    },
    "title": "山出雲",
    "poem": [
      "片雲初出岫，孤迥色難親。",
      "蓋小辭山近，根輕觸石新。",
      "飄颻經綠野，明麗照晴春。",
      "拂樹疑舒葉，臨流似結鱗。",
      "從龍方有感，捧日豈無因。",
      "看取為霖去，恩沾雨露均。"
    ]
  }
