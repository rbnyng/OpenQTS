[
  {
    "uid": "QTS_773_001_01",
    "volume": 773,
    "author": {
      "canonical": "蕭意",
      "recorded": "蕭意"
    },
    "title": "長門失寵",
    "poem": [
      "自從別鑾殿，長門幾度春。",
      "不知金屋裏，更貯若為人。"
    ]
  },
  {
    "uid": "QTS_773_002_01",
    "volume": 773,
    "author": {
      "canonical": "徐之才",
      "recorded": "徐之才",
      "gender": "male",
      "wikidata_id": "Q11070292"
    },
    "title": "下山逢故夫",
    "poem": [
      "踟躕下山婦，共申別離久。",
      "為問織縑人，何必長相守。"
    ]
  },
  {
    "uid": "QTS_773_003_01",
    "volume": 773,
    "author": {
      "canonical": "張陵",
      "recorded": "張陵"
    },
    "title": "虜患",
    "poem": [
      "今日漢家探使迴，蟻疊胡兵來未歇。",
      "春風渭水不敢流，總作六軍心上血。"
    ]
  },
  {
    "uid": "QTS_773_004_01",
    "volume": 773,
    "author": {
      "canonical": "蔡瓌",
      "recorded": "蔡瓌"
    },
    "title": "夏日閨怨",
    "poem": [
      "桃徑李蹊絕芳園，炎氛熾日滿愁軒。",
      "枝上鳥驚朱槿落，池中魚戲綠蘋翻。",
      "君戀京師久留滯，妾怨高樓積年歲。",
      "非關曾入楚王宮，直為相思腰轉細。",
      "臥簟乘閑乍逐涼，熏爐畏熱嬾焚香。",
      "雨霑柳葉如啼眼，露滴蓮花似汗妝。",
      "全由獨自羞看影，豔是孤眠疑夜永。",
      "無情拂鏡不成妝，有時卻扇還風靜。",
      "近日書來道欲歸，鴛鴦文錦字息機。",
      "但恐愁容不相識，為教恆著別時衣。"
    ]
  },
  {
    "uid": "QTS_773_005_01",
    "volume": 773,
    "author": {
      "canonical": "唐怡",
      "recorded": "唐怡"
    },
    "title": "詠破扇",
    "poem": [
      "輪如明月盡，羅似薄雲穿。",
      "無由重掩笑，分在秋風前。"
    ]
  },
  {
    "uid": "QTS_773_006_01",
    "volume": 773,
    "author": {
      "canonical": "唐怡",
      "recorded": "唐怡"
    },
    "title": "述懷",
    "poem": [
      "萬事皆零落，平生不可思。",
      "惟餘酒中趣，不減少年時。"
    ]
  },
  {
    "uid": "QTS_773_007_01",
    "volume": 773,
    "author": {
      "canonical": "潘求仁",
      "recorded": "潘求仁"
    },
    "title": "詠燭寄人",
    "poem": [
      "燭與人相似，通宵遽白煎。",
      "不應須下淚，祗是為人然。"
    ]
  },
  {
    "uid": "QTS_773_008_01",
    "volume": 773,
    "author": {
      "canonical": "閻德隱",
      "recorded": "閻德隱"
    },
    "title": "薛王花燭行",
    "poem": [
      "王子仙車下鳳臺，紫纓金勒馭龍媒。",
      "□□□□□□出，環佩鏘鏘天上來。",
      "鳷鵲樓前雲半卷，鴛鴦殿上月裵回。",
      "玉盤錯落銀燈照，珠帳玲瓏寶扇開。",
      "盈盈二八誰家子，紅粉新妝勝桃李。",
      "從來六行比齊姜，自許千門奉楚王。",
      "楚王宮裏能服飾，顧盼傾城復傾國。",
      "合歡錦帶蒲萄花，連理香裙石榴色。",
      "金爐半夜起氛氳，翡翠被重蘇合熏。",
      "不學曹王遇神女，莫言羅敷邀使君。",
      "同心婉娩若琴瑟，更笑天河有靈匹。",
      "一朝福履盛王門，百代光輝增帝室。",
      "富貴榮華實可憐，路傍觀者謂神仙。",
      "祇應早得淮南術，會見雙飛入紫煙。"
    ],
    "notes": [
