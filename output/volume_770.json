[
  {
    "uid": "QTS_770_001_01",
    "volume": 770,
    "author": {
      "canonical": "董初",
      "recorded": "董初"
    },
    "title": "昭君怨",
    "poem": [
      "新年猶尚小，那堪遠聘秦。",
      "裾衫沾馬汗，眉黛染胡塵。",
      "舉眼無相識，路逢皆異人。",
      "唯有梅將李，猶帶故鄉春。"
    ],
    "notes": [
      {
        "content": "一作董思恭詩。",
        "context": "昭君怨"
      }
    ]
  },
  {
    "uid": "QTS_770_002_01",
    "volume": 770,
    "author": {
      "canonical": "賀朝清",
      "recorded": "賀朝清"
    },
    "title": "南山",
    "poem": [
      "湖北雨初晴，湖南山盡見。",
      "喦喦石帆影，如得海風便。",
      "仙穴茅山峰，彩雲時一見。",
      "邀君共探此，異籙殘幾卷。"
    ],
    "notes": [
      {
        "content": "一作賀朝詩。",
        "context": "南山",
        "original_title": "南山",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_770_003_01",
    "volume": 770,
    "author": {
      "canonical": "賀朝清",
      "recorded": "賀朝清"
    },
    "title": "賦得遊人久不歸",
    "poem": [
      "鄉關眇天末，引領悵懷歸。",
      "羈旅久淫滯，物色屢芳菲。",
      "稍覺私意盡，行看鬔鬢稀。",
      "如何千里外，佇立沾裳衣。"
    ],
    "notes": [
      {
        "content": "一作劉孝孫詩，又作賀朝詩。",
        "context": "賦得遊人久不歸",
        "original_title": "賦得遊人久不歸",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_770_004_01",
    "volume": 770,
    "author": {
      "canonical": "楊衡",
      "recorded": "楊衡"
    },
    "title": "白紵辭",
    "poem": [
      "玉纓翠佩雜輕羅，香汗微漬朱顏酡。",
      "為君起唱白紵歌，清聲嫋雲思繁多。",
      "凝笳哀琴時相和，金壺半傾芳夜促。",
      "梁塵霏霏暗紅燭，令君安坐聽終曲，墜葉飄花難再復。",
      "躡珠履，步瓊筵，輕身起舞紅燭前。",
      "芳姿豔態妖且妍，回眸轉袖暗催弦。",
      "涼風蕭蕭漏水急，月華泛溢紅蓮濕，牽裙攬帶翻成泣。"
    ],
    "notes": [
      {
        "content": "此二首又見貞元進士《楊衡集》中詩紀詩所俱編入初唐。",
        "context": "白紵辭",
        "original_title": "白紵辭",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_770_005_01",
    "volume": 770,
    "author": {
      "canonical": "唐暄",
      "recorded": "唐暄"
    },
    "title": "還渭南感舊二首 其一",
    "poem": [
      "寢室悲長簟，妝樓泣鏡臺。",
      "獨悲桃李節，不共一時開。",
      "魂兮若有感，髣髴夢中來。"
    ],
    "part_index": 1,
    "total_parts": 2,
    "variants": [
      {
        "line": 2,
        "text": "一時",
        "variant": "夜泉",
        "source": "一作「夜泉」"
      }
    ]
  },
  {
    "uid": "QTS_770_005_02",
    "volume": 770,
    "author": {
      "canonical": "唐暄",
      "recorded": "唐暄"
    },
    "title": "還渭南感舊二首 其二",
    "poem": [
      "常時華室靜，笑語度更籌。",
      "恍惚人事改，冥漠委荒丘。",
      "陽原歎薤露，陰壑悼藏舟。",
      "清夜妝臺月，空想畫眉愁。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_770_006_01",
    "volume": 770,
    "author": {
      "canonical": "唐暄",
      "recorded": "唐暄"
    },
    "title": "贈亡妻張氏",
    "poem": [
      "嶧陽桐半死，延津劍一沈。",
      "如何宿昔內，空負百年心。"
    ]
  },
  {
    "uid": "QTS_770_007_01",
    "volume": 770,
    "author": {
      "canonical": "李韶",
      "recorded": "李韶",
      "gender": "male",
      "wikidata_id": "Q18236201"
    },
    "title": "題司空山觀",
    "poem": [
      "梁代真人上紫微，水盤山腳五雲飛。",
      "松杉老盡無消息，猶得千年一度歸。"
    ]
  },
  {
    "uid": "QTS_770_008_01",
    "volume": 770,
    "author": {
      "canonical": "李韶",
      "recorded": "李韶",
      "gender": "male",
      "wikidata_id": "Q18236201"
    },
    "title": "戲題盱眙壁",
    "poem": [
      "豈肯閒尋竹徑行，卻嫌絲管好蛙聲。",
      "自從煮鶴燒琴後，背卻青山臥月明。"
    ]
  },
  {
    "uid": "QTS_770_009_01",
    "volume": 770,
    "author": {
      "canonical": "安鴻漸",
      "recorded": "安鴻漸"
    },
    "title": "題楊少卿書後",
    "poem": [
      "端溪石硯宣城管，王屋松煙紫兔毫。",
      "更得孤卿老書札，人間無此五般高。"
    ]
  },
  {
    "uid": "QTS_770_010_01",
    "volume": 770,
    "author": {
      "canonical": "李延陵",
      "recorded": "李延陵"
    },
    "title": "自紫陽觀至華陽洞，宿侯尊師草堂簡同遊",
    "poem": [
      "石林媚煙景，句曲盤江甸。",
      "南向佳氣濃，峰峰遙隱見。",
      "漸臨華陽口，微路入蔥蒨。",
      "七曜懸洞宮，五雲抱山殿。",
      "銀函意誰發，金液徒堪薦。",
      "千載桃花春，秦人深不見。",
      "東溪喜相遇，貞白如會面。",
      "青鳥來去閒，紅霞朝夕變。",
      "一從化真骨，萬里乘飛電。",
      "蘿月延步虛，松花醉閑宴。",
      "幽人即長往，茂宰應交戰。",
      "明發歸琴堂，知君嬾為縣。"
    ],
    "variants": [
      {
        "line": 6,
        "text": "桃花春",
        "variant": "空桃花",
        "source": "一作「空桃花」"
      }
    ]
  },
  {
    "uid": "QTS_770_011_01",
    "volume": 770,
    "author": {
      "canonical": "秦尚運",
      "recorded": "秦尚運"
    },
    "title": "題鐘雅青紗枕",
    "poem": [
      "陰香裝豔入青紗，還與欹眠好事家。",
      "夢裏卻成山色雨，沈山不敢鬬青華。"
    ]
  },
  {
    "uid": "QTS_770_012_01",
    "volume": 770,
    "author": {
      "canonical": "張仲謀",
      "recorded": "張仲謀"
    },
    "title": "題搔口",
    "poem": [
      "嘗聞燒尾便拏空，只過天門更一重。",
      "大禹未生門未鑿，可能天下總無龍。"
    ]
  },
  {
    "uid": "QTS_770_013_01",
    "volume": 770,
    "author": {
      "canonical": "馮少吉",
      "recorded": "馮少吉"
    },
    "title": "山寺見楊少卿書壁，因題其尾",
    "poem": [
      "少卿真跡滿僧居，只恐鐘王也不如。",
      "為報遠公須愛惜，此書書後更無書。"
    ]
  },
  {
    "uid": "QTS_770_014_01",
    "volume": 770,
    "author": {
      "canonical": "殷陶",
      "recorded": "殷陶"
    },
    "title": "經杜甫舊宅",
    "poem": [
      "浣花溪裏花多處，為憶先生在蜀時。",
      "萬古只應留舊宅，千金無復換新詩。",
      "沙棚水檻鷗飛盡，樹壓村橋馬過時。",
      "山月不知人事變，夜來江上與誰期。"
    ]
  },
  {
    "uid": "QTS_770_015_01",
    "volume": 770,
    "author": {
      "canonical": "羅炯",
      "recorded": "羅炯"
    },
    "title": "行縣至浮查寺",
    "poem": [
      "二十年前此布衣，鹿鳴西上虎符歸。",
      "行時賓從光前事，到處松杉長舊圍。",
      "野老競遮官道拜，沙鷗遙避隼旟飛。",
      "春風一宿琉璃地，自有泉聲愜素機。"
    ],
    "notes": [
      {
        "content": "一作羅晌詩",
        "context": "行縣至浮查寺",
        "original_title": "行縣至浮查寺",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_770_016_01",
    "volume": 770,
    "author": {
      "canonical": "韓雄",
      "recorded": "韓雄"
    },
    "title": "敕和元相公家園即事寄王相公",
    "poem": [
      "共列中台貴，能齊物外心。",
      "回車青閣晚，解帶碧芳深。",
      "夜水隨畦入，晴花度竹尋。",
      "題詩更相應，一字重千金。"
    ]
  },
  {
    "uid": "QTS_770_017_01",
    "volume": 770,
    "author": {
      "canonical": "苗仲方",
      "recorded": "苗仲方"
    },
    "title": "仲秋太常寺觀公輅車拜陵",
    "poem": [
      "南宮初開律，金風已戒涼。",
      "拜陵將展敬，車輅儼成行。",
      "士庶觀祠禮，公卿習舊章。",
      "郊原佳氣引，園寢瑞煙長。",
      "鹵簿辭丹闕，威儀列太常。",
      "聖心何所寄，惟德在無忘。"
    ]
  },
  {
    "uid": "QTS_770_018_01",
    "volume": 770,
    "author": {
      "canonical": "陳嶰",
      "recorded": "陳嶰"
    },
    "title": "尋易尊師不遇",
    "poem": [
      "爛熳紅霞光照衣，苔封白石路微微。",
      "華陽洞裏何人在，落盡松花不見歸。"
    ]
  },
  {
    "uid": "QTS_770_019_01",
    "volume": 770,
    "author": {
      "canonical": "張起",
      "recorded": "張起"
    },
    "title": "早過梨嶺，喜雪書情呈崔判官",
    "poem": [
      "度嶺逢朝雪，行看馬跡深。",
      "輕標南國瑞，寒慰北人心。",
      "皎潔停丹嶂，飄颻映綠林。",
      "共君歌樂土，無作白頭吟。"
    ]
  },
  {
    "uid": "QTS_770_020_01",
    "volume": 770,
    "author": {
      "canonical": "張起",
      "recorded": "張起"
    },
    "title": "春情",
    "poem": [
      "畫閣餘寒在，新年舊燕歸。",
      "梅花猶帶雪，未得試春衣。"
    ]
  },
  {
    "uid": "QTS_770_021_01",
    "volume": 770,
    "author": {
      "canonical": "陳政",
      "recorded": "陳政"
    },
    "title": "贈竇蔡二記室入蜀",
    "poem": [
      "崑山積良寶，大廈構眾材。",
      "馬卿委官去，鄒子背淮來。",
      "風流信多美，朝夕豫平臺。",
      "逸翮獨不群，清才復遒上。",
      "六輔昔推名，二江今振響。",
      "英華雖外發，磨琢終內朗。",
      "四海奮羽儀，清風久播馳。",
      "沈鬱林難廁，青山翻易阻。",
      "迴首望煙霞，誰知慕儔侶。",
      "飄然不繫舟，為情自可求。",
      "若奉西園夜，浩想北園愁。",
      "無因逐萍藻，從爾泛清流。"
    ]
  },
  {
    "uid": "QTS_770_022_01",
    "volume": 770,
    "author": {
      "canonical": "李建業",
      "recorded": "李建業"
    },
    "title": "採菊",
    "poem": [
      "簇簇竟相鮮，一枝開幾番。",
      "味甘資麴糵，香好勝蘭蓀。",
      "古道風搖遠，荒籬露壓繁。",
      "盈筐時採得，服餌近知門。"
    ]
  },
  {
    "uid": "QTS_770_023_01",
    "volume": 770,
    "author": {
      "canonical": "羅維",
      "recorded": "羅維"
    },
    "title": "水精環",
    "poem": [
      "王室符長慶，環中得水精。",
      "任圓循不極，見素質仍貞。",
      "信是天然瑞，非因朴斫成。",
      "無瑕勝玉美，至潔過冰清。",
      "未肯齊瑉價，寧同雜佩聲。",
      "能銜任黃雀，亦欲應時明。"
    ]
  },
  {
    "uid": "QTS_770_024_01",
    "volume": 770,
    "author": {
      "canonical": "殷益",
      "recorded": "殷益"
    },
    "title": "看牡丹",
    "poem": [
      "擁毳對芳叢，由來趣不同。",
      "髮從今日白，花是去年紅。",
      "豔色隨朝露，馨香逐晚風。",
      "何須待零落，然後始知空。"
    ]
  },
  {
    "uid": "QTS_770_025_01",
    "volume": 770,
    "author": {
      "canonical": "李得",
      "recorded": "李得"
    },
    "title": "賦得垣衣",
    "poem": [
      "漠漠復霏霏，為君垣上衣。",
      "昭陽輦下草，應笑此生非。",
      "掩藹青春去，蒼茫白露稀。",
      "猶勝萍逐水，流浪不相依。"
    ]
  },
  {
    "uid": "QTS_770_026_01",
    "volume": 770,
    "author": {
      "canonical": "王邵",
      "recorded": "王邵"
    },
    "title": "冬晚對雪憶胡處士",
    "poem": [
      "寒更傳唱晚，清鏡覽衰顏。",
      "隔牖風驚竹，開簾雪滿山。",
      "灑空深巷靜，積素廣庭閒。",
      "借問袁安舍，翛然尚閉關。"
    ]
  },
  {
    "uid": "QTS_770_027_01",
    "volume": 770,
    "author": {
      "canonical": "曹脩古",
      "recorded": "曹脩古"
    },
    "title": "池上",
    "poem": [
      "荷葉罩芙蓉，圓青映嫩紅。",
      "佳人南陌上，翠蓋立春風。"
    ]
  },
  {
    "uid": "QTS_770_028_01",
    "volume": 770,
    "author": {
      "canonical": "朱子真",
      "recorded": "朱子真"
    },
    "title": "對趙穎歌",
    "poem": [
      "人間幾日變桑田，誰識神仙洞裏天。",
      "短促雖知有殊異，且須歡醉在生前。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "醉",
        "variant": "笑",
        "source": "一作「笑」"
      }
    ]
  },
  {
    "uid": "QTS_770_029_01",
    "volume": 770,
    "author": {
      "canonical": "嚴郭",
      "recorded": "嚴郭"
    },
    "title": "賦百舌鳥",
    "poem": [
      "此禽輕巧少同倫，我聽長疑舌滿身。",
      "星未沒河先報曉，柳猶粘雪便迎春。",
      "頻嫌海燕巢難定，卻訝林鶯語不真。",
      "莫倚清風更多事，玉樓還有晏眠人。"
    ]
  },
  {
    "uid": "QTS_770_030_01",
    "volume": 770,
    "author": {
      "canonical": "張子明",
      "recorded": "張子明"
    },
    "title": "孤雁",
    "poem": [
      "隻影翩翩下碧湘，傍池鴛鷺宿銀塘。",
      "雖逢夜雨迷深浦，終向晴天著舊行。",
      "憶伴幾回思片月，蛻翎多為繫繁霜。",
      "江南塞北俱關念，兩地飛歸是故鄉。"
    ]
  },
  {
    "uid": "QTS_770_031_01",
    "volume": 770,
    "author": {
      "canonical": "李謹言",
      "recorded": "李謹言"
    },
    "title": "水殿拋球曲二首 其一",
    "poem": [
      "侍宴黃昬曉未休，玉階夜色月如流。",
      "朝來自覺承恩最，笑倩傍人認繡毬。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_770_031_02",
    "volume": 770,
    "author": {
      "canonical": "李謹言",
      "recorded": "李謹言"
    },
    "title": "水殿拋球曲二首 其二",
    "poem": [
      "堪恨隋家幾帝王，舞裀揉盡繡鴛鴦。",
      "如今重到拋毬處，不是金爐舊日香。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_770_032_01",
    "volume": 770,
    "author": {
      "canonical": "吳燭",
      "recorded": "吳燭"
    },
    "title": "銅雀妓",
    "poem": [
      "秋色西陵滿綠蕪，繁弦急管強歡娛。",
      "長舒羅袖不成舞，卻向風前承淚珠。"
    ]
  },
  {
    "uid": "QTS_770_033_01",
    "volume": 770,
    "author": {
      "canonical": "張保嗣",
      "recorded": "張保嗣"
    },
    "title": "戲示諸妓",
    "poem": [
      "綠羅裙上標三棒，紅粉腮邊淚兩行。",
      "抄手向前咨大使，這回不敢惱兒郎。"
    ]
  },
  {
    "uid": "QTS_770_034_01",
    "volume": 770,
    "author": {
      "canonical": "潘圖",
      "recorded": "潘圖",
      "gender": "male",
      "english_name": "Pan Tu",
      "wikidata_id": "Q18907271"
    },
    "title": "末秋到家",
    "poem": [
      "歸來無所利，骨肉亦不喜。",
      "黃犬卻有情，當門臥搖尾。"
    ]
  },
  {
    "uid": "QTS_770_035_01",
    "volume": 770,
    "author": {
