      "recorded": "潘佐"
    },
    "title": "送人往宣城",
    "poem": [
      "江畔送行人，千山生暮氛。",
      "謝安團扇上，為畫敬亭雲。"
    ]
  },
  {
    "uid": "QTS_770_036_01",
    "volume": 770,
    "author": {
      "canonical": "李逸",
      "recorded": "李逸",
      "gender": "male",
