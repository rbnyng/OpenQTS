      "wikidata_id": "Q703639"
    },
    "title": "令狐綯 登望京樓賦綯",
    "poem": [
      "夷門一鎮五經秋，未得朝天不免愁。",
      "因上此樓望京國，便名樓作望京樓。"
    ]
  },
  {
    "uid": "QTS_563_004_01",
    "volume": 563,
    "author": {
      "canonical": "裴休",
      "recorded": "裴休",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Pei Xiu",
      "wikidata_id": "Q703639"
    },
    "title": "夏侯孜 享太廟樂章孜",
    "poem": [
      "於鑠令主，聖祚重昌。",
      "興起教義，申明典章。",
      "俗尚素樸，人皆樂康。",
      "積德可報，流慶無疆。"
    ]
  },
  {
    "uid": "QTS_563_005_01",
    "volume": 563,
    "author": {
      "canonical": "裴休",
      "recorded": "裴休",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Pei Xiu",
      "wikidata_id": "Q703639"
    },
    "title": "魏謨 和重陽錫宴御制詩",
    "poem": [
      "四方無事去，宸豫杪秋來。",
      "八水寒光起，千山霽色開。"
    ]
  },
  {
    "uid": "QTS_563_006_01",
    "volume": 563,
    "author": {
