        "context": "句"
      },
      {
        "line": 6,
        "content": "《題永》",
        "context": "句"
      }
    ]
  },
  {
    "uid": "QTS_757_018_01",
    "volume": 757,
    "author": {
      "canonical": "李詢",
      "recorded": "李詢",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Li Xun",
      "wikidata_id": "Q15889809"
    },
    "title": "贈織錦人",
    "poem": [
      "札札機聲曉復晡，眼穿力盡竟何如。",
      "美人一曲成千賜，心裏猶嫌花樣疎。"
    ]
  },
  {
    "uid": "QTS_757_019_01",
    "volume": 757,
    "author": {
      "canonical": "韓垂",
      "recorded": "韓垂"
    },
    "title": "題金山",
    "poem": [
      "靈山一峰秀，岌然殊眾山。",
      "盤根大江底，插影浮雲間。",
      "雷霆常間作，風雨時往還。",
      "象外懸清影，千載長躋攀。"
    ]
  },
  {
    "uid": "QTS_757_020_01",
    "volume": 757,
    "author": {
      "canonical": "朱存",
      "recorded": "朱存",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Zhu Cun",
      "wikidata_id": "Q795129"
    },
    "title": "後湖",
    "poem": [
      "雷轟疊鼓火翻旗，三異翩翩試水師。",
      "驚起黑龍眠不得，狂風猛雨不多時。"
    ]
  },
  {
    "uid": "QTS_757_021_01",
    "volume": 757,
    "author": {
      "canonical": "陳彥",
      "recorded": "陳彥"
    },
    "title": "和徐舍人九月十一日見寄",
    "poem": [
      "衡門寂寂逢迎少，不見仙郎向五旬。",
      "莫問龍山前日事，菊花開卻為閒人。"
    ]
  },
  {
    "uid": "QTS_757_022_01",
    "volume": 757,
    "author": {
      "canonical": "許堅",
      "recorded": "許堅"
    },
    "title": "登游齊山",
    "poem": [
      "星使南馳入楚重，此山偏得駐行蹤。",
      "落花滿地月華冷，寂寞舊山三四峰。"
    ]
  },
  {
    "uid": "QTS_757_023_01",
    "volume": 757,
    "author": {
      "canonical": "許堅",
      "recorded": "許堅"
    },
    "title": "游溧陽下山寺",
    "poem": [
      "地枕吳溪與越峰，前朝恩錫靈泉額。",
      "竹林晴見雁塔高，石室曾棲幾禪伯。",
      "荒碑字沒秋苔深，古池香泛荷花白。",
      "客有經年說別林，落日啼猨情脈脈。"
    ],
