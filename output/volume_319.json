[
  {
    "uid": "QTS_319_001_01",
    "volume": 319,
    "author": {
      "canonical": "顏粲",
      "recorded": "顏粲"
    },
    "title": "白露為霜",
    "poem": [
      "悲秋將歲晚，繁露已成霜。",
      "遍渚蘆先白，沾籬菊自黃。",
      "應鐘鳴遠寺，擁雁度三湘。",
      "氣逼襦衣薄，寒侵宵夢長。",
      "滿庭添月色，拂水斂荷香。",
      "獨念蓬門下，窮年在一方。"
    ]
  },
  {
    "uid": "QTS_319_002_01",
    "volume": 319,
    "author": {
      "canonical": "顏粲",
      "recorded": "顏粲"
    },
    "title": "吳宮教美人戰",
    "poem": [
      "有客陳兵畫，功成欲霸吳。",
      "玉顏承將略，金鈿指軍符。",
      "轉佩風雲暗，鳴鼙錦繡趨。",
      "雪花頻落粉，香汗盡流珠。",
      "掩笑誰干令，嚴刑必用誅。",
      "至今孫子術，猶可靜邊隅。"
    ],
    "notes": [
      {
        "content": "一作吳秘詩。",
        "context": "吳宮教美人戰",
        "original_title": "吳宮教美人戰",
        "type": "footnote"
      },
      {
        "line": 5,
        "content": "刑一作師；術一作法。",
        "context": "至今孫子術，猶可靜邊隅。"
      }
    ]
  },
  {
    "uid": "QTS_319_003_01",
    "volume": 319,
    "author": {
      "canonical": "徐敞",
      "recorded": "徐敞"
    },
    "title": "月映清淮流",
    "poem": [
      "遙夜淮彌淨，浮空月正明。",
      "虛無含氣白，凝澹映波清。",
      "見底深還淺，居高缺復盈。",
      "處柔知坎德，持潔表陰精。",
      "利物功難並，和光道已成。",
      "安流方利涉，應鑒此時情。"
    ]
  },
  {
    "uid": "QTS_319_004_01",
    "volume": 319,
    "author": {
      "canonical": "徐敞",
      "recorded": "徐敞"
    },
    "title": "圓靈水鏡",
    "poem": [
      "浮光上東洛，揚彩滿圓靈。",
      "明滅淪江水，盈虛逐砌蓂。",
      "不分沙岸白，偏照海山清。",
      "練色臨窗牖，蟾光靄戶庭。",
      "成輪疑璧影，初魄類弓形。",
      "遠近凝清質，娟娟出眾星。"
    ],
    "notes": [
      {
        "content": "娟娟一作依微。",
        "context": "圓靈水鏡"
      }
    ]
  },
  {
    "uid": "QTS_319_005_01",
    "volume": 319,
    "author": {
      "canonical": "徐敞",
      "recorded": "徐敞"
    },
    "title": "虹藏不見",
    "poem": [
      "迎冬小雪至，應節晚虹藏。",
      "玉氣徒成象，星精不散光。",
      "美人初比色，飛鳥罷呈祥。",
      "石澗收晴影，天津失彩梁。",
      "霏霏空暮雨，杳杳映殘陽。",
      "舒捲應時令，因知聖曆長。"
    ]
  },
  {
    "uid": "QTS_319_006_01",
    "volume": 319,
    "author": {
      "canonical": "徐敞",
      "recorded": "徐敞"
    },
    "title": "白露為霜",
    "poem": [
      "早寒青女至，零露結為霜。",
      "入夜飛清景，凌晨積素光。",
      "駟星初晳晳，葭菼復蒼蒼。",
      "色冒沙灘白，威加木葉黃。",
      "鮮輝襲紈扇，殺氣掩干將。",
      "葛屨那堪履，徒令君子傷。"
    ]
  },
  {
    "uid": "QTS_319_007_01",
    "volume": 319,
    "author": {
      "canonical": "徐敞",
      "recorded": "徐敞"
    },
    "title": "賦得金莖露",
    "poem": [
      "武帝貴長生，延年餌玉英。",
      "銅盤貯珠露，仙掌抗金莖。",
      "拂曙氛埃斂，凌空沆瀣清。",
      "岧嶤捧瑞氣，巃嵸出宮城。",
      "勢入浮雲聳，形標霽色明。",
      "大君當御宇，何必去蓬瀛。"
    ]
  },
  {
    "uid": "QTS_319_008_01",
    "volume": 319,
    "author": {
      "canonical": "張聿",
      "recorded": "張聿"
    },
    "title": "圓靈水鏡",
    "poem": [
      "鳳池開月鏡，清瑩寫寥天。",
      "影散微波上，光含片玉懸。",
      "菱花凝泛灩，桂樹映清鮮。",
      "樂廣披雲日，山濤卷霧年。",
      "濯纓何處去，鑒物自堪妍。",
      "回首看雲液，蟾蜍勢正圓。"
    ]
  },
  {
    "uid": "QTS_319_009_01",
    "volume": 319,
    "author": {
      "canonical": "張聿",
      "recorded": "張聿"
    },
    "title": "景風扇物",
    "poem": [
      "何處青蘋末，呈祥起遠空。",
      "曉來搖草樹，輕度淨塵蒙。",
      "水上微波動，林前媚景通。",
      "寥天鳴萬籟，蘭徑長幽叢。",
      "漸颺摶扶勢，應從橐籥功。",
      "開襟若有日，願睹大王風。"
    ],
    "notes": [
      {
        "line": 2,
        "content": "一作輕去動溟濛。",
        "context": "水上微波動，林前媚景通。"
      }
    ]
  },
  {
    "uid": "QTS_319_010_01",
    "volume": 319,
    "author": {
      "canonical": "張聿",
      "recorded": "張聿"
    },
    "title": "劍化為龍",
    "poem": [
      "古劍誠難屈，精明有所從。",
      "沉埋方出獄，合會卻成龍。",
      "牛鬥光初歇，蜿蜒氣漸濃。",
      "雲濤透百丈，水府躍千重。",
      "拖尾迷蓮鍔，張鱗露錦容。",
      "至今沙岸下，誰得睹玄蹤。"
    ]
  },
  {
    "uid": "QTS_319_011_01",
    "volume": 319,
    "author": {
      "canonical": "張聿",
      "recorded": "張聿"
    },
    "title": "餘瑞麥",
    "poem": [
      "瑞麥生堯日，芃芃雨露偏。",
      "兩岐分更合，異畝穎仍連。",
      "冀獲明王慶，寧唯太守賢。",
      "仁風吹靡靡，甘雨長芊芊。",
      "聖德應多稔，皇家配有年。",
      "已聞天下泰，誰為濟西田。"
    ]
  },
  {
    "uid": "QTS_319_012_01",
    "volume": 319,
    "author": {
      "canonical": "張聿",
      "recorded": "張聿"
    },
    "title": "賦得首夏猶清和",
    "poem": [
      "早夏宜春景，和光起禁城。",
      "祝融將御節，炎帝啟朱明。",
      "日送殘花晚，風過御苑清。",
      "郊原浮麥氣，池沼發荷英。",
      "樹影臨山動，禽飛入漢輕。",
      "幸逢堯禹化，全勝谷中情。"
    ],
    "notes": [
      {
        "content": "一作黎逢詩。",
        "context": "賦得首夏猶清和",
        "original_title": "賦得首夏猶清和",
        "type": "footnote"
      }
    ]
  },
  {
    "uid": "QTS_319_013_01",
    "volume": 319,
    "author": {
      "canonical": "麴信陵",
      "recorded": "麴信陵"
    },
    "title": "移居洞庭",
    "poem": [
      "重林將疊嶂，此處可逃秦。",
      "水隔人間世，花開洞裏春。",
      "荷鋤分地利，縱酒樂天真。",
      "萬事更何有，吾今已外身。"
    ]
  },
  {
    "uid": "QTS_319_014_01",
    "volume": 319,
    "author": {
      "canonical": "麴信陵",
      "recorded": "麴信陵"
    },
    "title": "吳門送客",
    "poem": [
      "亂山吳苑外，臨水讓王祠。",
      "素是傷情處，春非送客時。",
      "不須愁落日，且願駐青絲。",
      "千里會應到，一尊誰共持。"
    ]
  },
  {
    "uid": "QTS_319_015_01",
    "volume": 319,
    "author": {
      "canonical": "麴信陵",
      "recorded": "麴信陵"
    },
    "title": "長安道",
    "poem": [
      "朱門映綠楊，雙闕抵通莊。",
      "玉珮聲逾遠，紅塵猶自香。"
    ]
  },
  {
    "uid": "QTS_319_016_01",
    "volume": 319,
    "author": {
      "canonical": "麴信陵",
      "recorded": "麴信陵"
    },
    "title": "出自賊中謁恆上人",
    "poem": [
      "再拜吾師喜復悲，誓心從此永歸依。",
      "浮生恍忽若真夢，何事於中有是非。"
    ]
  },
  {
    "uid": "QTS_319_017_01",
    "volume": 319,
    "author": {
      "canonical": "麴信陵",
      "recorded": "麴信陵"
    },
    "title": "過真律師舊院",
    "poem": [
      "寂然秋院閉秋光，過客閒來禮影堂。",
      "堅冰銷盡還成水，本自無形何足傷。"
    ]
  },
  {
    "uid": "QTS_319_018_01",
    "volume": 319,
    "author": {
      "canonical": "麴信陵",
      "recorded": "麴信陵"
    },
    "title": "酬談上人詠海石榴",
    "poem": [
      "真僧相勸外浮華，萬法無常可歎嗟。",
      "但試尋思階下樹，何人種此我看花。"
    ]
  },
  {
    "uid": "QTS_319_019_01",
    "volume": 319,
    "author": {
      "canonical": "麴信陵",
      "recorded": "麴信陵"
    },
    "title": "句",
    "poem": [
      "台笠冒山雨，渚田耕荇花。"
    ],
    "notes": [
      {
        "content": "見《石林燕語》。",
        "context": "句"
      }
    ],
    "part_index": 1
  },
  {
