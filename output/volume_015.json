    },
    "title": "郊廟歌辭 讓皇帝廟樂章 迎神",
    "poem": [
      "皇矣天宗，德先王季。",
      "因心則友，克讓以位。",
      "爰命有司，式遵前志。",
      "神其降靈，昭饗祀事。"
    ]
  },
  {
    "uid": "QTS_015_002_01",
    "volume": 15,
    "author": {
      "canonical": "李舒",
      "recorded": "李舒",
      "gender": "male",
      "wikidata_id": "Q97345820"
    },
    "title": "郊廟歌辭 讓皇帝廟樂章 奠幣",
    "poem": [
      "惟帝時若，去而上仙。",
      "祀用商舞，樂備宮懸。",
      "白璧加薦，玄纁告虔。",
      "子孫拜後，承茲吉蠲。"
    ]
  },
  {
    "uid": "QTS_015_003_01",
    "volume": 15,
    "author": {
      "canonical": "李舒",
      "recorded": "李舒",
      "gender": "male",
      "wikidata_id": "Q97345820"
    },
    "title": "郊廟歌辭 讓皇帝廟樂章 迎俎",
    "poem": [
      "祀盛體薦，禮協粢盛。",
      "方周假廟，用魯純牲。",
      "捧徹祗敬，擊拊和鳴。",
      "受厘歸胙，既戒而平。"
    ]
  },
  {
    "uid": "QTS_015_004_01",
    "volume": 15,
    "author": {
      "canonical": "李舒",
      "recorded": "李舒",
      "gender": "male",
      "wikidata_id": "Q97345820"
    },
    "title": "郊廟歌辭 讓皇帝廟樂章 酌獻",
    "poem": [
      "八音具舉，三壽既盥。",
      "潔茲宗彝，瑟彼圭瓚。",
      "蘭肴重錯，椒醑飄散。",
      "降胙維城，永為藩翰。"
    ]
  },
  {
    "uid": "QTS_015_005_01",
    "volume": 15,
    "author": {
      "canonical": "李舒",
      "recorded": "李舒",
      "gender": "male",
      "wikidata_id": "Q97345820"
    },
    "title": "郊廟歌辭 讓皇帝廟樂章 亞獻終獻",
    "poem": [
      "秩禮有序，和音既同。",
      "九儀不忒，三揖將終。",
      "孝感藩後，相維辟公。",
      "四時之典，永永無窮。"
    ]
  },
  {
    "uid": "QTS_015_006_01",
    "volume": 15,
    "author": {
      "canonical": "李舒",
      "recorded": "李舒",
      "gender": "male",
      "wikidata_id": "Q97345820"
    },
    "title": "郊廟歌辭 讓皇帝廟樂章 送神",
    "poem": [
      "奠獻已事，昏昕載分。",
      "風搖雨散，靈衛絪縕。",
      "龍駕帝服，上騰五雲。",
      "泮宮複閟，寂寞無聞。"
    ]
  },
  {
    "uid": "QTS_015_007_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享隱太子廟樂章 誠和",
    "poem": [
      "道閟鶴關，運纏鳩裏。",
      "門集大命，俾歆嘉祀。",
      "禮亞六瑚，誠殫二簋。",
      "有誠顒若，神斯戾止。"
    ]
  },
  {
    "uid": "QTS_015_008_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享隱太子廟樂章 肅和",
    "poem": [
      "歲肇春宗，幹開震長。",
      "瑤山既寂，戾園斯享。",
      "玉肅其事，物昭其象。",
      "弦誦成風，笙歌合響。"
    ]
  },
  {
    "uid": "QTS_015_009_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享隱太子廟樂章 雍和",
    "poem": [
      "明典肅陳，神居邃啟。",
      "春伯聯事，秋官相禮。",
      "有來雍雍，登歌濟濟。",
      "緬維主鬯，庶歆芳醴。"
    ]
  },
  {
    "uid": "QTS_015_010_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享隱太子廟樂章 舒和",
    "poem": [
      "三縣已判歌鐘列，六佾將開羽戚分。",
      "尚想燕飛來蔽日，終疑鶴影降淩雲。"
    ]
  },
  {
    "uid": "QTS_015_011_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享隱太子廟樂章 凱安",
    "poem": [
      "天步昔將開，商郊初欲踐。",
      "撫戎金陣廓，貳極瑤圖闡。",
      "雞戟遂崇儀，龍樓期好善。",
      "弄兵隳震業，啟聖隆嗣典。"
    ]
  },
  {
    "uid": "QTS_015_012_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享隱太子廟樂章 迎神",
    "poem": [
      "蒼震有位，黃離蔽明。",
      "江充禍結，戾據災成。",
      "銜冤昔痛，贈典今榮。",
      "享靈有秩，奉樂以迎。"
    ]
  },
  {
    "uid": "QTS_015_013_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享隱太子廟樂章 送神",
    "poem": [
      "皇情悼往，祀議增設。",
      "鐘鼓鏗鏘，羽旄昭晰。",
      "掌禮雲備，司筵告徹。",
      "樂以送神，靈其鑒闋。"
    ]
  },
  {
    "uid": "QTS_015_014_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享章懷太子廟樂章 迎神",
    "poem": [
      "副君昭象，道應黃離。",
      "銅樓備德，玉裕成規。",
      "仙氣靄靄，靈從師師。",
      "前驅戾止，控鶴來儀。"
    ]
  },
  {
    "uid": "QTS_015_015_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享章懷太子廟樂章 登歌酌鬯",
    "poem": [
      "忠孝本著，羽翼先成。",
      "寢門昭德，馳道為程。",
      "幣帛有典，容衛無聲。",
      "司存既肅，廟享惟清。"
    ]
  },
  {
    "uid": "QTS_015_016_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享章懷太子廟樂章 迎俎酌獻",
    "poem": [
      "通三錫胤，明兩承英。",
      "太山比赫，伊水聞笙。",
      "宗祧是寄，禮樂其亨。",
      "嘉辰薦俎，以發聲明。"
    ]
  },
  {
    "uid": "QTS_015_017_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享章懷太子廟樂章 送文舞迎武舞",
    "poem": [
      "羽鑰崇文禮以畢，干戚奮武事將行。",
      "用舍繇來其有致，壯志宣威樂太平。"
    ]
  },
  {
    "uid": "QTS_015_018_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享章懷太子廟樂章 武舞作",
    "poem": [
      "綠林熾炎曆，黃虞格有苗。",
      "沙塵驚塞外，帷幄命嫖姚。",
      "七德干戈止，三邊雲霧消。",
      "寶祚長無極，歌舞盛今朝。"
    ]
  },
  {
    "uid": "QTS_015_019_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享懿德太子廟樂章 迎神",
    "poem": [
      "甲觀昭祥，畫堂升位。",
      "禮絕群後，望尊儲貳。",
      "啟誦慚德，莊丕掩粹。",
      "伊浦鳳翔，緱峰鶴至。"
    ]
  },
  {
    "uid": "QTS_015_020_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享懿德太子廟樂章 登歌酌鬯",
    "poem": [
      "譽闡元儲，寄崇明兩。",
      "玉裕雖晦，銅樓可想。",
      "弦誦輟音，笙歌罷響。",
      "幣帛言設，禮容無爽。"
    ]
  },
  {
    "uid": "QTS_015_021_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享懿德太子廟樂章 迎俎酌獻",
    "poem": [
      "雍雍盛典，肅肅靈祠。",
      "賓天有聖，對日無期。",
      "飄颻羽服，掣曳雲旗。",
      "眷言主鬯，心乎愴茲。"
    ]
  },
  {
    "uid": "QTS_015_022_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享懿德太子廟樂章 送文舞迎武舞",
    "poem": [
      "八音協奏陳金石，六佾分行整禮容。",
      "滄溟赴海還稱少，素月開輪即是重。"
    ]
  },
  {
    "uid": "QTS_015_023_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享懿德太子廟樂章 武舞作",
    "poem": [
      "隋季昔雲終，唐年初啟聖。",
      "纂戎將禁暴，崇儒更敷政。",
      "威略靜三邊，仁恩覃萬姓。"
    ]
  },
  {
    "uid": "QTS_015_024_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享節湣太子廟樂章 迎神",
    "poem": [
      "儲後望崇，元良寄切。",
      "寢門是仰，馳道不絕。",
      "仙袂雲會，靈旗電晰。",
      "煌煌而來，禮物攸設。"
    ]
  },
  {
    "uid": "QTS_015_025_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享節湣太子廟樂章 登歌酌鬯",
    "poem": [
      "灼灼重明，仰承元首。",
      "既賢且哲，惟孝與友。",
      "惟孝雖遙，靈規不朽。",
      "禮因誠致，備絜玄酒。"
    ]
  },
  {
    "uid": "QTS_015_026_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享節湣太子廟樂章 迎俎酌獻",
    "poem": [
      "嘉薦有典，至誠莫騫。",
      "畫梁雲亙，雕俎星連。",
      "樂器周列，禮容備宣。",
      "依稀如在，若未賓天。"
    ]
  },
  {
    "uid": "QTS_015_027_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享節湣太子廟樂章 送文舞出迎武舞入",
    "poem": [
      "邕邕闡化憑文德，赫赫宣威藉武功。",
      "既執羽旄先拂吹，還持玉戚更揮空。"
    ]
  },
  {
    "uid": "QTS_015_028_01",
    "volume": 15,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "郊廟歌辭 享節湣太子廟樂章 武舞作",
    "poem": [
      "武德諒雍雍，由來掃寇戎。",
      "劍光揮作電，旗影列成虹。",
      "霧廓三邊靜，波澄四海同。",
      "睿圖今已盛，相共舞皇風。"
    ]
  },
  {
    "uid": "QTS_015_029_01",
