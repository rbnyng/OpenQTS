  {
    "uid": "QTS_715_011_01",
    "volume": 715,
    "author": {
      "canonical": "裴皡",
      "recorded": "裴皡"
    },
    "title": "示門生馬侍郎胤孫",
    "poem": [
      "宦途最重是文衡，天與愚夫著盛名。",
      "三主禮闈年八十，門生門下見門生。"
    ]
  },
  {
    "uid": "QTS_715_012_01",
    "volume": 715,
    "author": {
      "canonical": "王希羽",
      "recorded": "王希羽"
    },
    "title": "贈杜荀鶴",
    "poem": [
      "金榜曉懸生世日，玉書潛記上升時。",
      "九華山色高千尺，未必高於第八枝。"
    ]
  },
  {
    "uid": "QTS_715_013_01",
    "volume": 715,
    "author": {
      "canonical": "柯崇",
      "recorded": "柯崇"
    },
    "title": "宮怨二首 其一",
    "poem": [
      "塵滿金爐不炷香，黃昏獨自立重廊。",
      "笙歌何處承恩寵，一一隨風入上陽。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_715_013_02",
    "volume": 715,
    "author": {
      "canonical": "柯崇",
      "recorded": "柯崇"
    },
    "title": "宮怨二首 其二",
    "poem": [
      "長門槐柳半蕭疎，玉輦沈思恨有餘。",
      "紅淚漸消傾國態，黃金誰為達相如。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_715_014_01",
    "volume": 715,
    "author": {
      "canonical": "劉象",
      "recorded": "劉象"
    },
    "title": "早春池亭獨遊三首 其一",
    "poem": [
      "春意送殘臘，春晴融小洲。",
      "蒲茸纔簇岸，柳頰已遮樓。",
      "便有杯觴興，可據羈旅愁。",
      "鳧鷖亦相狎，盡日戲清流。"
    ],
    "part_index": 1,
    "total_parts": 3
  },
  {
    "uid": "QTS_715_014_02",
    "volume": 715,
    "author": {
      "canonical": "劉象",
      "recorded": "劉象"
    },
    "title": "早春池亭獨遊三首 其二",
    "poem": [
      "清流環綠筱，清景媚虹橋。",
      "鶯刷初遷羽，莎拳擬拆苗。",
      "細沙擢暖岸，淑景動和飈。",
      "倍憶同袍侶，相歡倒一瓢。"
    ],
    "part_index": 2,
    "total_parts": 3
  },
  {
    "uid": "QTS_715_014_03",
    "volume": 715,
    "author": {
      "canonical": "劉象",
      "recorded": "劉象"
    },
    "title": "早春池亭獨遊三首 其三",
    "poem": [
      "一瓢歡自足，一日興偏多。",
      "幽意人先賞，疎叢蝶未過。",
      "知音新句苦，窺沼醉顏酡。",
      "萬慮從相擬，今朝欲奈何。"
    ],
    "part_index": 3,
    "total_parts": 3
  },
  {
    "uid": "QTS_715_015_01",
    "volume": 715,
    "author": {
      "canonical": "劉象",
      "recorded": "劉象"
    },
    "title": "鷺鷥",
    "poem": [
      "潔白孤高生不同，頂絲清軟冷搖風。",
      "窺魚翹立荷香裏，慕侶低翻柳影中。",
      "幾日下巢辭紫閣，多時凝目向晴空。",
      "摩霄志在潛修羽，會接鸞凰別葦叢。"
    ]
  },
  {
    "uid": "QTS_715_016_01",
    "volume": 715,
    "author": {
      "canonical": "劉象",
      "recorded": "劉象"
    },
    "title": "春夜二首 其一",
    "poem": [
      "幾處兵戈阻路岐，憶山心切與山違。",
      "時難何處披懷抱，日日日斜空醉歸。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_715_016_02",
    "volume": 715,
    "author": {
      "canonical": "劉象",
      "recorded": "劉象"
    },
    "title": "春夜二首 其二",
    "poem": [
      "一別杜陵歸未期，秪憑魂夢接親知。",
      "近來欲睡兼難睡，夜夜夜深聞子規。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
