[
  {
    "uid": "QTS_728_001_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "吟敘",
    "poem": [
      "歷代興亡億萬心，聖人觀古貴知今。",
      "古今成敗無多事，月殿花臺幸一吟。"
    ],
    "preface": "周曇，唐末守國子直講。《詠史詩》八卷，今編爲二卷。"
  },
  {
    "uid": "QTS_728_002_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "閒吟",
    "poem": [
      "考摭妍媸用破心，翦裁千古獻當今。",
      "閒吟不是閒吟事，事有閒思閒要吟。"
    ]
  },
  {
    "uid": "QTS_728_003_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "唐虞門 唐堯",
    "poem": [
      "祅氛不起瑞煙輕，端拱垂衣日月明。",
      "傳事四方無外役，茅茨深處土堦平。"
    ]
  },
  {
    "uid": "QTS_728_004_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "唐虞門 虞舜",
    "poem": [
      "進善懲奸立帝功，功成揖讓益溫恭。",
      "滿朝卿士多元凱，為黜兜苗與四凶。"
    ]
  },
  {
    "uid": "QTS_728_005_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "唐虞門 舜妃",
    "poem": [
      "蒼梧一望隔重雲，帝子悲尋不記春。",
      "何事淚痕偏在竹，貞姿應念節高人。"
    ]
  },
  {
    "uid": "QTS_728_006_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "唐虞門 再吟",
    "poem": [
      "瀟湘何代泣幽魂，骨化重泉志尚存。",
      "若地道中休下淚，不應新竹有啼痕。"
    ]
  },
  {
    "uid": "QTS_728_007_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三代門 夏禹",
    "poem": [
      "堯違天孽賴詢謨，頓免洪波浸碧虛。",
      "海內生靈微伯禹，盡應隨浪化為魚。"
    ]
  },
  {
    "uid": "QTS_728_008_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三代門 再吟",
    "poem": [
      "萬古龍門一旦開，無成甘死作黃能。",
      "司空定有匡堯術，九載之前何處來？"
    ]
  },
  {
    "uid": "QTS_728_009_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三代門 太康",
    "poem": [
      "師保何人為琢磨，安知父祖苦辛多。",
      "酒酣禽色方為樂，詎肯閒聽五子歌。"
    ]
  },
  {
    "uid": "QTS_728_010_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三代門 后稷",
    "poem": [
      "人惟邦本本由農，曠古誰高后稷功。",
      "百穀且繁三曜在，牲牢郊祀信無窮。"
    ]
  },
  {
    "uid": "QTS_728_011_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三代門 文王",
    "poem": [
      "昭然明德報天休，禴祭惟馨勝殺牛。",
      "二老五侯何所詐，不歸商受盡歸周。"
    ]
  },
  {
    "uid": "QTS_728_012_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三代門 武王",
    "poem": [
      "文王寢膳武王隨，內豎言安色始怡。",
      "七載豈堪囚羑里，一夫為報亦何疑。"
    ]
  },
  {
    "uid": "QTS_728_013_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三代門 太公",
    "poem": [
      "昌獵闗西紂獵東，紂憐崇虎棄非熊。",
      "危邦自謂多麟鳳，肯把王綱取釣翁。"
    ]
  },
  {
    "uid": "QTS_728_014_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三代門 再吟",
    "poem": [
      "東鄰不事事西鄰，御物卑和物自親。",
      "天下言知天下者，兆人無主屬賢人。"
    ]
  },
  {
    "uid": "QTS_728_015_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三代門 又吟",
    "poem": [
      "千妖萬態逞妍姿，破國亡家更是誰。",
      "匡政必能除苟媚，去邪當斷勿狐疑。"
    ]
  },
  {
    "uid": "QTS_728_016_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三代門 子牙妻",
    "poem": [
      "陵柏無心竹變秋，不能同戚擬同休。",
      "嵗寒焉在空垂涕，覆水如何欲再收。"
    ]
  },
  {
    "uid": "QTS_728_017_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三代門 周公",
    "poem": [
      "文武傳芳百代基，幾多賢哲守成規。",
      "仍聞吐握延儒素，猶恐民疵未盡知。"
    ]
  },
  {
    "uid": "QTS_728_018_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三代門 夷齊",
    "poem": [
      "讓國由衷義亦乖，不知天命匹夫才。",
      "將除暴虐誠能阻，何異崎嶇助紂來。"
    ]
  },
  {
    "uid": "QTS_728_019_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三代門 管蔡",
    "poem": [
      "伊商胡越尚同圖，管蔡如何有異謨。",
      "不念祖宗危社稷，強於仁聖遣行誅。"
    ]
  },
  {
    "uid": "QTS_728_020_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三代門 成王",
    "poem": [
      "成王有過伯禽笞，聖惠能新日自奇。",
      "王道既成何所感，越裳呈瑞鳳來儀。"
    ]
  },
  {
    "uid": "QTS_728_021_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三代門 幽王",
    "poem": [
      "狼煙篝火為邊塵，烽候那宜悅婦人。",
      "厚德未聞聞厚色，不亡家國幸亡身。"
    ]
  },
  {
    "uid": "QTS_728_022_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "三代門 平王",
    "poem": [
      "犬戎西集殺幽王，邦土何由不便亡。",
      "宜臼東來年更遠，川流難絕信源長。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "集殺",
        "variant": "犯滅",
        "source": "一作「犯滅」"
      },
      {
        "line": 2,
        "text": "難",
        "variant": "雖",
        "source": "一作「雖」"
      }
    ]
  },
  {
    "uid": "QTS_728_023_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 祭足",
    "poem": [
      "吳魯燕韓豈別宗，曾無外禦但相攻。",
      "當時周鄭誰為相，交質將何服遠戎。"
    ]
  },
  {
    "uid": "QTS_728_024_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 再吟",
    "poem": [
      "周室衰微不共匡，干戈終日互爭強。",
      "諸侯若解尊天子，列國何因次第亡。"
    ]
  },
  {
    "uid": "QTS_728_025_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 隱公",
    "poem": [
      "今古難隄是小人，苟希榮寵任相親。",
      "陳謀不信懷憂懼，反間須防卻害身。"
    ]
  },
  {
    "uid": "QTS_728_026_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 莊公",
    "poem": [
      "齊甲強臨力有餘，魯莊為戰念區區。",
      "魚麗三鼓微曹劌，肉食安能暇遠謨。"
    ]
  },
  {
    "uid": "QTS_728_027_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 哀公",
    "poem": [
      "賢為鄰用國憂危，廟算無非委豔奇。",
      "兩葉翠娥春乍展，一毛須去不難吹。"
    ]
  },
  {
    "uid": "QTS_728_028_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 再吟",
    "poem": [
      "好龍天為降真龍，及見真龍瘁厥躬。",
      "接下不勤徒好士，葉公何異魯哀公。"
    ]
  },
  {
    "uid": "QTS_728_029_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 平公",
    "poem": [
      "鴻鵠輕騰萬里高，何殊朝野得賢豪。",
      "能知翼戴穹蒼力，不是蒙茸腹背毛。"
    ]
  },
  {
    "uid": "QTS_728_030_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 文公",
    "poem": [
      "滅虢吞虞未息兵，柔秦敗楚霸威成。",
      "文公徒欲三強服，分晉元來是六卿。"
    ]
  },
  {
    "uid": "QTS_728_031_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 景公",
    "poem": [
      "覺病當宜早問師，病深難療恨難追。",
      "晉侯徒有秦毉緩，疾在膏肓救已遲。"
    ]
  },
  {
    "uid": "QTS_728_032_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 衛靈公",
    "poem": [
      "子魚無隱欲源清，死不忘忠感衛靈。",
      "伯玉既親知德潤，殘桃休喫悟蘭馨。"
    ]
  },
  {
    "uid": "QTS_728_033_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 陳靈公",
    "poem": [
      "誰與陳君嫁禍來，孔寧行父夏姬媒。",
      "靈公徒認徵舒面，至死何曾識禍胎。"
    ]
  },
  {
    "uid": "QTS_728_034_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 陳蔡君",
    "poem": [
      "楚聘宣尼欲道光，是時陳蔡畏鄰強。",
      "庸謀但解遮賢路，不解迎賢謀自昌。"
    ]
  },
  {
    "uid": "QTS_728_035_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 楚惠王",
    "poem": [
      "芹中遇蛭強為吞，不欲緣微有害人。",
      "何事免成心腹疾？皇天惟德是相親。"
    ]
  },
  {
    "uid": "QTS_728_036_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 楚懷王",
    "poem": [
      "不聽陳軫信張儀，六里商於果見欺。",
      "既捨黔中西換得，又令生去益堪悲。"
    ]
  },
  {
    "uid": "QTS_728_037_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 再吟",
    "poem": [
      "不得商於又失齊，楚懷方寸一何迷。",
      "明知秦是虎狼國，更忍車輪獨向西。"
    ]
  },
  {
    "uid": "QTS_728_038_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 韓惠王",
    "poem": [
      "韓惠開渠止暴秦，營田萬頃飽秦人。",
      "何殊般肉供羸獸，獸壯安知不害身。"
    ]
  },
  {
    "uid": "QTS_728_039_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 頃襄王",
    "poem": [
      "秦陷荊王死不還，秪緣偏聽子蘭言。",
      "頃襄還信子蘭語，忍使江魚葬屈原。"
    ]
  },
  {
    "uid": "QTS_728_040_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 武公",
    "poem": [
      "猛獸來兵秪為文，豈宜涼德擬圖尊。",
      "君看豹彩蒙麋質，人取無難必不存。"
    ]
  },
  {
    "uid": "QTS_728_041_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 華元",
    "poem": [
      "未知軍法忌偏頗，徒解於思腹漫皤。",
      "昔日羊斟曾不預，今朝為政事如何？"
    ]
  },
  {
    "uid": "QTS_728_042_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 臧孫",
    "poem": [
      "諸孟憎吾似犬獰，賢臧哭孟倍傷情。",
      "季孫愛我如甘疾，疾足亡身藥故寧。"
    ]
  },
  {
    "uid": "QTS_728_043_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 公叔",
    "poem": [
      "吳起南奔魏國荒，必聽公叔失賢良。",
      "無謀縱欲離安邑，可免河溝徙大梁。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "河溝",
        "variant": "他時",
        "source": "一作「他時」"
      }
    ]
  },
  {
    "uid": "QTS_728_044_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 莊辛",
    "poem": [
      "莊辛正諫謂妖詞，兵及鄢陵始悔思。",
      "見兔必能知顧犬，亡羊補棧未為遲。"
    ]
  },
  {
    "uid": "QTS_728_045_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 孫臏",
    "poem": [
      "曾嫌勝己害賢人，鑽火明知速自焚。",
      "斷足爾能行不足，逢君誰肯不酬君。"
    ]
  },
  {
    "uid": "QTS_728_046_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 靈轍",
    "poem": [
      "失水枯鱗得再生，翳桑無地謝深情。",
      "朱輪未染酬恩血，公子何由見赤誠。"
    ]
  },
  {
    "uid": "QTS_728_047_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 郭開",
    "poem": [
      "秦襲邯鄲歲月深，何人沾贈郭開金。",
      "廉頗還國李牧在，安得趙王為爾擒。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "沾",
        "variant": "解",
        "source": "一作「解」"
      }
    ]
  },
  {
    "uid": "QTS_728_048_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 樂羊",
    "poem": [
      "桮羹忍啜得非忠，巧佞胡為惑主聰。",
      "盈篋謗書能寢默，中山不是樂羊功。"
    ]
  },
  {
    "uid": "QTS_728_049_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 虞卿",
    "poem": [
      "割地求和國必危，安知堅守絕來思。",
      "年年來伐年年割，割盡邯鄲何所之。"
    ]
  },
  {
    "uid": "QTS_728_050_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 豫讓",
    "poem": [
      "門客家臣義莫儔，漆身吞炭不能休。",
      "中行智伯思何異，國士終期國士酬。"
    ]
  },
  {
    "uid": "QTS_728_051_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 毛遂",
    "poem": [
      "不識囊中穎脫錐，功成方信有英奇。",
      "平原門下三千客，得力何曾是素知。"
    ]
  },
  {
    "uid": "QTS_728_052_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 再吟",
    "poem": [
      "定獲英奇不在多，然須設網遍山河。",
      "禽雖一目羅中得，豈可空張一目羅。"
    ]
  },
  {
    "uid": "QTS_728_053_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 田文",
    "poem": [
      "下客常才不足珍，誰為狗盜脫強秦。",
      "秦闗若待雞鳴出，笑殺臨淄土偶人。"
    ]
  },
  {
    "uid": "QTS_728_054_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 再吟",
    "poem": [
      "門下三千各自矜，頻彈劍客獨無能。",
      "田文不厭無能客，三窟全身果有憑。"
    ]
  },
  {
    "uid": "QTS_728_055_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 馮讙",
    "poem": [
      "兔窟穿成主再興，輩流狐伏敢驕矜。",
      "馮讙不是無能者，要試君心欲展能。"
    ]
  },
  {
    "uid": "QTS_728_056_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 章子",
    "poem": [
      "在家能子必能臣，齊將功成以孝聞。",
      "改葬義無欺死父，臨戎安肯背生君。"
    ]
  },
  {
    "uid": "QTS_728_057_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 卞和",
    "poem": [
      "磷磷誰為惑溫溫，至寶凡姿甚易分。",
      "自是時人多貴耳，目無明鑒使俱焚。"
    ]
  },
  {
    "uid": "QTS_728_058_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 季札",
    "poem": [
      "吹毛霜刃過千金，生許徐君死掛林。",
      "寶劍徒稱無價寶，行心更貴不欺心。"
    ]
  },
  {
    "uid": "QTS_728_059_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 孫武",
    "poem": [
      "理國無難似理兵，兵家法令貴遵行。",
      "行刑不避君王寵，一笑隨刀八陣成。"
    ]
  },
  {
    "uid": "QTS_728_060_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 夫差",
    "poem": [
      "信聽讒言疾不除，忠臣須殺竟何如。",
      "會稽既雪夫差死，泉下胡顏見子胥。"
    ]
  },
  {
    "uid": "QTS_728_061_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 少孺",
    "poem": [
      "寶貴親仁與善鄰，鄰兵何要互相臻。",
      "螳螂定是遭黃雀，黃雀須防挾彈人。"
    ]
  },
  {
    "uid": "QTS_728_062_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 蘇厲",
    "poem": [
      "百步穿楊箭不移，養由堪教聽弘規。",
      "身隆業著未知退，勿遣功名一旦隳。"
    ]
  },
  {
    "uid": "QTS_728_063_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 鬻拳",
    "poem": [
      "鬻拳強諫懼威刑，退省懷慙不顧生。",
      "雙刖忍行留痛恨，惟君適足見忠誠。"
    ]
  },
  {
    "uid": "QTS_728_064_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 荊軻",
    "poem": [
      "反刃相酬是匹夫，安知突騎駕羣胡。",
      "有心為報懷權略，可在於期與地圖。"
    ]
  },
  {
    "uid": "QTS_728_065_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 再吟",
    "poem": [
      "幾尺如霜利不羣，恩仇未報反亡身。",
      "誠哉利器全由用，可惜吹毛不得人。"
    ]
  },
  {
    "uid": "QTS_728_066_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 陳軫",
    "poem": [
      "丹青徒有逞喧嘩，有足由來不是蛇。",
      "殺將破軍為柱國，君今官極更何加？"
    ]
  },
  {
    "uid": "QTS_728_067_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 田饒",
    "poem": [
      "廚拋敗肉士懷飢，倉爛餘糧客未炊。",
      "臨難欲行求死士，將何恩信致扶危。"
    ]
  },
  {
    "uid": "QTS_728_068_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 鮑叔",
    "poem": [
      "忠臣祝壽吐嘉詞，鮑叔臨軒酒一巵。",
      "安不忘危臣所願，願思危困必無危。"
    ]
  },
  {
    "uid": "QTS_728_069_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 晏嬰",
    "poem": [
      "正人徒以刃相危，貪利忘忠死不為。",
      "麋鹿命懸當有處，驅車何必用奔馳。"
    ]
  },
  {
    "uid": "QTS_728_070_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 再吟",
    "poem": [
      "下澤逢蛇葢是常，還如山上見豺狼。",
      "國中有怪非蛇獸，不用賢能是不祥。"
    ]
  },
  {
    "uid": "QTS_728_071_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 又吟",
    "poem": [
      "馬斃廄人慾就刑，百年臨盡一言生。",
      "賴逢賢相能匡救，仍免吾君播惡聲。"
    ]
  },
  {
    "uid": "QTS_728_072_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 叔向",
    "poem": [
      "重祿存家不敢言，小臣憂禍亦如然。",
      "明開諫諍能無罪，祗此宜為理國先。"
    ]
  },
  {
    "uid": "QTS_728_073_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 師曠",
    "poem": [
      "老能勸學照餘生，似夜隨燈到處明。",
      "往行前言如不見，暗中無燭若為行。"
    ]
  },
  {
    "uid": "QTS_728_074_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 智伯",
    "poem": [
      "三國連兵敵就擒，晉陽城下碧波深。",
      "風濤撼處看沈趙，舟楫不從飜自沈。"
    ]
  },
  {
    "uid": "QTS_728_075_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 再吟",
    "poem": [
      "攻城來下惜先分，一旦家邦屬四鄰。",
      "徒逞威強稱智伯，不知權變是愚人。"
    ]
  },
  {
    "uid": "QTS_728_076_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 襄子",
    "poem": [
      "君子常聞不迫危，城崩何用急重圍。",
      "叛亡能退修文德，果見中牟以義歸。"
    ]
  },
  {
    "uid": "QTS_728_077_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 楊回",
    "poem": [
      "三逐鄉閭五去君，莫知何地可容身。",
      "楊回不是逢英鑒，白首無成一旅人。"
    ]
  },
  {
    "uid": "QTS_728_078_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 顏回",
    "poem": [
      "陋巷簞瓢困有年，是時端木飫腥膻。",
      "宣尼行教何形迹，不肯分甘救子淵。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "分甘救",
        "variant": "徒行葬",
        "source": "一作「徒行葬」"
      }
    ]
  },
  {
    "uid": "QTS_728_079_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 子貢",
    "poem": [
      "救魯亡吳事可傷，誰令利口說田常。",
      "吳亡必定由端木，魯亦宜其運不長。"
    ]
  },
  {
    "uid": "QTS_728_080_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 再吟",
    "poem": [
      "一言能使定安危，安己危人是所宜。",
      "仁義不思垂教化，背恩亡德豈儒為。"
    ]
  },
  {
    "uid": "QTS_728_081_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 鄭相",
    "poem": [
      "鄭相清賢慎有餘，好魚魚至竟何如。",
      "退魚留得終身祿，祿在何憂不得魚。"
    ]
  },
  {
    "uid": "QTS_728_082_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 子產",
    "poem": [
      "為政何門是化源，寬仁高下保安全。",
      "如嫌水德人多狎，拯溺宜將猛濟寬。"
    ]
  },
  {
    "uid": "QTS_728_083_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 管仲",
    "poem": [
      "美酒濃馨客要沽，門深誰敢強提壺。",
      "苟非賢主詢賢士，肯信沽人畏子獹。"
    ]
  },
  {
    "uid": "QTS_728_084_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 再吟",
    "poem": [
      "社鼠穿牆巧庇身，何由攻灌若為燻。",
      "能知窟穴依形勢，不聽讒邪是聖君。"
    ]
  },
  {
    "uid": "QTS_728_085_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 范蠡",
    "poem": [
      "西子能令轉嫁吳，會稽知爾啄姑蘇。",
      "跡高塵外功成處，一葉翩翩在五湖。"
    ]
  },
  {
    "uid": "QTS_728_086_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 屈原",
    "poem": [
      "滿朝皆醉不容醒，眾濁如何擬獨清。",
      "江上流人真浪死，誰知浸潤誤深誠。"
    ]
  },
  {
    "uid": "QTS_728_087_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 黃歇",
    "poem": [
      "春申隨質若王圖，為主輕生大丈夫。",
      "女子異心安足聽，功成何更用陰謨。"
    ]
  },
  {
    "uid": "QTS_728_088_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 王后",
    "poem": [
      "連環要解解非難，忽碎瑤堦一旦間。",
      "兩國相持兵不解，會應俱碎似連環。"
    ]
  },
  {
    "uid": "QTS_728_089_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 樊姬",
    "poem": [
      "側影頻移未退朝，喜逢賢相日從高。",
      "當時不有樊姬問，令尹何由進叔敖。"
    ]
  },
  {
    "uid": "QTS_728_090_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 齊桓公",
    "poem": [
      "三往何勞萬乘君，五來方見一微臣。",
      "微臣傲爵能輕主，霸主如何敢傲人。"
    ]
  },
  {
    "uid": "QTS_728_091_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 中山君",
    "poem": [
      "敵臨烹子一何庸，激怒來軍速自攻。",
      "結怨豈思圍不解，愚謀多以殺為雄。"
    ]
  },
  {
    "uid": "QTS_728_092_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 趙簡子",
    "poem": [
      "簡子雄心蓄霸機，賢愚聊欲試諸兒。",
      "假言藏寶非真寶，不是生知焉得知。"
    ]
  },
  {
    "uid": "QTS_728_093_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 再吟",
    "poem": [
      "諤諤能昌唯唯亡，亦由匡正得賢良。",
      "一從忠讜無周舍，吾過何人為短長。"
    ]
  },
  {
    "uid": "QTS_728_094_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 趙宣子",
    "poem": [
      "門人曾不有提彌，連嗾呀呀孰敢支。",
      "臨難若教無苟免，亂朝爭那以獒為。"
    ]
  },
  {
    "uid": "QTS_728_095_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 韓昭侯",
    "poem": [
      "去年秦伐我宜陽，今歲天災旱且荒。",
      "對此不思人力困，樓門何可更高張。"
    ]
  },
  {
    "uid": "QTS_728_096_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 魏文侯",
    "poem": [
      "冒雨如何固出畋，慮乖羣約失乾乾。",
      "文侯不是貪禽者，示信將為教化先。"
    ]
  },
  {
    "uid": "QTS_728_097_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 郄成子",
    "poem": [
      "陳樂無懽璧在隅，宰臣懷智有微謨。",
      "苟非成子當明哲，誰是仁人可託孤。"
    ]
  },
  {
    "uid": "QTS_728_098_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 秦武陽",
    "poem": [
      "丱歲徒聞有壯名，及令為副誤荊卿。",
      "是時環柱能相副，誰謂燕囚事不成。"
    ]
  },
  {
    "uid": "QTS_728_099_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 田子方",
    "poem": [
      "太子無嫌禮樂虧，願聽貧富與安危。",
      "賤貧驕物貧終在，富貴驕人貴必隳。"
    ]
  },
  {
    "uid": "QTS_728_100_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 淳于髡",
    "poem": [
      "穰穰何禱手何賫，一呷村漿與隻雞。",
      "以少求多誠可笑，還如輕幣欲全齊。"
    ]
  },
  {
    "uid": "QTS_728_101_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 再吟",
    "poem": [
      "戲問將何對所躭，滑稽無骨是常譚。",
      "昔時王者皆通四，近見君王祗好三。"
    ]
  },
  {
    "uid": "QTS_728_102_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 再吟",
    "poem": [
      "曲突徙薪不謂賢，焦頭爛額饗盤筵。",
      "時人多是輕先見，不獨田家國亦然。"
    ]
  },
  {
    "uid": "QTS_728_103_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 田子奇",
    "poem": [
      "少年為吏慮非循，一騎奔追委使臣。",
      "使者不追何所對，車中緣見白頭人。"
    ]
  },
  {
    "uid": "QTS_728_104_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 百里奚",
    "poem": [
      "船驥由來是股肱，在虞虞滅在秦興。",
      "裁量何異刀將尺，秪繫用之能不能。"
    ]
  },
  {
    "uid": "QTS_728_105_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 孫叔敖",
    "poem": [
      "童稚逢蛇歎不祥，慮悲來者為埋藏。",
      "是知陽報由陰施，天爵昭然契日彰。"
    ]
  },
  {
    "uid": "QTS_728_106_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 魯仲連",
    "poem": [
      "昔迸燒牛發戰機，夜奔驚火走燕師。",
      "今來躍馬懷驕惰，十萬如無一撮時。"
    ]
  },
  {
    "uid": "QTS_728_107_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 宋子罕",
    "poem": [
      "子憐溫潤欲歸仁，吾貴堅廉是寶身。",
      "自有不貪身內寶，玉人徒獻外來珍。"
    ]
  },
  {
    "uid": "QTS_728_108_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 宮之奇",
    "poem": [
      "虞虢相依自保安，謀臣吞度不為難。",
      "貪憐璧馬迷香餌，肯信之奇諭齒寒。"
    ]
  },
  {
    "uid": "QTS_728_109_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 王孫滿",
    "poem": [
      "九牧金熔物像成，辭昏去亂祚休明。",
      "興亡在德不在鼎，楚子何勞問重輕。"
    ]
  },
  {
    "uid": "QTS_728_110_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 顏叔子",
    "poem": [
      "夜雨鄰娃告屋傾，一宵從寄念悲驚。",
      "誠知獨處從燒燭，君子行心要自明。"
    ]
  },
  {
    "uid": "QTS_728_111_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 張孟譚",
    "poem": [
      "強兵四合國將危，賴有謀臣為發揮。",
      "城內蒿銅誠自有，無謀誰解見玄機。"
    ]
  },
  {
    "uid": "QTS_728_112_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 公子無忌",
    "poem": [
      "按劍臨籠震咄呼，鷂甘梟戮伏鳩辜。",
      "能憐鈍拙誅豪俊，憫弱摧強真丈夫。"
    ]
  },
  {
    "uid": "QTS_728_113_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 再吟",
    "poem": [
      "趙解重圍魏再昌，信陵賢德日馨芳。",
      "昬蒙愚主聽讒說，公子云亡國亦亡。"
    ]
  },
  {
    "uid": "QTS_728_114_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 侯嬴、朱亥",
    "poem": [
      "屠肆監門一賤微，信陵交結國人非。",
      "當時不是二君計，匹馬那能解趙圍。"
    ]
  },
  {
    "uid": "QTS_728_115_01",
    "volume": 728,
    "author": {
      "canonical": "周曇",
      "recorded": "周曇"
    },
    "title": "春秋戰國門 再吟",
    "poem": [
      "走敵存亡義有餘，全由雄勇與英謨。",
      "但如公子能交結，朱亥、侯嬴何代無。"
    ]
  }
]