    "title": "題棲霞寺",
    "poem": [
      "南山勢迴合，靈境依此住。",
      "殿轉雲崖陰，僧探石泉度。",
      "龍蛇爭翕習，神鬼皆密護。",
      "萬壑奔道場，羣峰向雙樹。",
      "天花飛不著，水月白成路。",
      "今日觀身我，歸心復何處。"
    ],
    "variants": [
      {
        "line": 6,
        "text": "身我",
        "variant": "我身",
        "source": "一作「我身」"
      }
    ]
