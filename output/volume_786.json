      "recorded": "無名氏",
      "gender": "male",
      "english_name": "anonymous",
      "wikidata_id": "Q4233718"
    },
    "title": "三學山盤陀石上刻詩",
    "poem": [
      "拔地山巒秀，排空殿閣斜。",
      "雲供數州雨，樹獻九天花。",
      "夜月摩峰頂，秋鐘徹海涯。",
      "長松拂星漢，一一是仙槎。"
    ]
  },
  {
    "uid": "QTS_786_028_01",
