    "author": {
      "canonical": "無名氏",
      "recorded": "無名氏",
      "gender": "male",
      "english_name": "anonymous",
      "wikidata_id": "Q4233718"
    },
    "title": "粉牋題詩",
    "poem": [
      "二月江南花滿枝，風輕簾幕燕爭飛。",
      "遊人休惜夜秉燭，楊柳陰濃春欲歸。"
    ]
  },
  {
    "uid": "QTS_786_008_01",
    "volume": 786,
    "author": {
      "canonical": "無名氏",
      "recorded": "無名氏",
      "gender": "male",
      "english_name": "anonymous",
      "wikidata_id": "Q4233718"
    },
    "title": "詠美人騎馬",
    "poem": [
      "駿馬嬌仍穩，春風灞岸晴。",
      "促來金鐙短，扶上玉人輕。",
      "帽束雲鬟亂，鞭籠翠袖明。",
      "不知從此去，何處更傾城。"
    ]
  },
  {
    "uid": "QTS_786_009_01",
    "volume": 786,
    "author": {
      "canonical": "無名氏",
      "recorded": "無名氏",
      "gender": "male",
      "english_name": "anonymous",
      "wikidata_id": "Q4233718"
    },
    "title": "六言詩",
    "poem": [
      "把酒留君聽琴，那堪歲暮離心。",
      "霜葉無風自落，秋天不雨多陰。",
      "人愁荒村路遠，馬怯寒溪水深。",
      "望盡青山猶在，不知何處相尋。"
    ]
  },
  {
    "uid": "QTS_786_010_01",
    "volume": 786,
    "author": {
      "canonical": "無名氏",
      "recorded": "無名氏",
      "gender": "male",
