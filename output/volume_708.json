[
  {
    "uid": "QTS_708_001_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "釣臺",
    "poem": [
      "金門誰奉詔，碧岸獨垂鉤。",
      "舊友只樵叟，新交惟野鷗。",
      "嘉名懸日月，深谷化陵丘。",
      "便可招巢父，長川好飲牛。"
    ],
    "preface": "徐夤，字昭夢，莆田人，登乾寜進士第，授秘書省正字。依王審知禮，待簡畧，遂拂衣去，歸隠延夀溪。著有《探龍》、《釣磯》二集，編詩四卷。"
  },
  {
    "uid": "QTS_708_002_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "旅次寓題",
    "poem": [
      "胡為名利役，來往老關河。",
      "白髮隨梳少，青山入夢多。",
      "途窮憐抱疾，世亂恥登科。",
      "卻起漁舟念，春風釣綠波。"
    ]
  },
  {
    "uid": "QTS_708_003_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "贈嚴司直",
    "poem": [
      "承家居闕下，避世出關東。",
      "有酒劉伶醉，無兒伯道窮。",
      "新詩吟閣賞，舊業釣臺空。",
      "雨雪還相訪，心懷與我同。"
    ]
  },
  {
    "uid": "QTS_708_004_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "贈東方道士",
    "poem": [
      "葫蘆窗畔掛，是物在其間。",
      "雪色老人鬢，桃花童子顏。",
      "祭星秋卜日，採藥曉登山。",
      "舊放長生鹿，時銜瑞草還。"
    ]
  },
  {
    "uid": "QTS_708_005_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "題僧壁",
    "poem": [
      "香廚流瀑布，獨院鏁孤峰。",
      "紺髮青螺長，文茵紫豹重。",
      "卵枯皆化燕，蜜老卻成蜂。",
      "明月留人宿，秋聲夜著松。"
    ]
  },
  {
    "uid": "QTS_708_006_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "和人經隋唐間戰處",
    "poem": [
      "孤軍前度戰，一敗一成功。",
      "卷旆早歸國，臥屍猶臂弓。",
      "草間腥半在，沙上血殘紅。",
      "傷魄何為者，五湖垂釣翁。"
    ]
  },
  {
    "uid": "QTS_708_007_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "追和常建",
    "poem": [
      "紅顏如朔雪，日爍忽成空。",
      "淚盡黃雲雨，塵消白草風。",
      "君心爭不悔，恨思竟何窮。",
      "願化南飛燕，年年入漢宮。"
    ],
    "notes": [
      {
        "content": "嘆王昭君",
        "context": "追和常建",
        "original_title": "追和常建《嘆王昭君》"
      }
    ]
  },
  {
    "uid": "QTS_708_008_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "贈董先生",
    "poem": [
      "壽歲過於百，時閒到上京。",
      "餐松雙鬢嫩，絕粒四支輕。",
      "雨雪思中嶽，雲霞夢赤城。",
      "來年期壽籙，何處待先生？"
    ]
  },
  {
    "uid": "QTS_708_009_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "河流",
    "poem": [
      "洪流盤砥柱，淮濟不同波。",
      "莫訝清時少，都緣曲處多。",
      "遠能通玉塞，高復接銀河。",
      "大禹成門嶮，為龍始得過。"
    ]
  },
  {
    "uid": "QTS_708_010_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "題南寺",
    "poem": [
      "久別猨啼寺，流年刦逝波。",
      "舊僧歸塔盡，古瓦長松多。",
      "壁蘚昏題記，窗螢散薜蘿。",
      "平生英壯節，何故旋消磨？"
    ]
  },
  {
    "uid": "QTS_708_011_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "北山秋晚",
    "poem": [
      "十載衣裘盡，臨寒隱薜蘿。",
      "心閒緣事少，身老愛山多。",
      "玉露催收菊，金風促翦禾。",
      "燕秦正戎馬，林下好婆娑。"
    ]
  },
  {
    "uid": "QTS_708_012_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "昔游",
    "poem": [
      "昔遊紅杏苑，今隱刺桐村。",
      "歲計懸僧債，科名負國恩。",
      "不書胝漸穩，頻鑷鬢無根。",
      "惟有經邦事，年年志尚存。"
    ]
  },
  {
    "uid": "QTS_708_013_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "酒鬍子",
    "poem": [
      "紅筵絲竹合，用爾作歡娛。",
      "直指寧偏黨，無私絕覬覦。",
      "當歌誰擐袖，應節漸輕軀。",
      "恰與真相似，氊裘滿頷鬚。"
    ]
  },
  {
    "uid": "QTS_708_014_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "弔崔補闕",
    "poem": [
      "近來吾道少，慟哭博陵君。",
      "直節岩前竹，孤魂嶺上雲。",
      "縉紳傳確論，丞相取遺文。",
      "廢卻中興策，何由免用軍。"
    ]
  },
  {
    "uid": "QTS_708_015_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "弔赤水李先生",
    "poem": [
      "三年悲過隙，一室類銷氷。",
      "妻病入仙觀，子窮隨嶽僧。",
      "荒丘寒有雨，古屋夜無燈。",
      "往日清猷著，金門幾欲徵。"
    ]
  },
  {
    "uid": "QTS_708_016_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "香鴨",
    "poem": [
      "不假陶鎔妙，誰教羽翼全。",
      "五金池畔質，百和口中煙。",
      "觜鈍魚難啄，心空火自燃。",
      "御爐如有闕，須進聖君前。"
    ]
  },
  {
    "uid": "QTS_708_017_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "雞",
    "poem": [
      "名參十二屬，花入羽毛深。",
      "守信催朝日，能鳴送曉陰。",
      "峨冠裝瑞璧，利爪削黃金。",
      "徒有稻粱感，何由報德音。"
    ]
  },
  {
    "uid": "QTS_708_018_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "白鴿",
    "poem": [
      "舉翼淩空碧，依人到大邦。",
      "粉翎棲畫閣，雪影拂瓊窗。",
      "振鷺堪為侶，鳴鳩好作雙。",
      "狎鷗歸未得，覩爾憶晴江。"
    ]
  },
  {
    "uid": "QTS_708_019_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "龜",
    "poem": [
      "行止竟何從，深溪與古峰。",
      "青荷巢瑞質，綠水返靈蹤。",
      "鑽骨神明應，酬恩感激重。",
      "仙翁求一卦，何日脫龍鍾。"
    ]
  },
  {
    "uid": "QTS_708_020_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "銀結條冠子",
    "poem": [
      "日下徵良匠，宮中贈阿嬌。",
      "瑞蓮開二孕，瓊縷織千條。",
      "蟬翼輕輕結，花紋細細挑。",
      "舞時紅袖舉，纖影透龍綃。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "孕",
        "variant": "朶",
        "source": "一作「朶」"
      }
    ]
  },
  {
    "uid": "QTS_708_021_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "蜀葵",
    "poem": [
      "劍門南面樹，移向會仙亭。",
      "錦水饒花豔，岷山帶葉青。",
      "文君慚婉娩，神女讓娉婷。",
      "爛熳紅兼紫，飄香入繡扃。"
    ]
  },
  {
    "uid": "QTS_708_022_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "華清宮",
    "poem": [
      "十二瓊樓鏁翠微，暮霞遺卻六銖衣。",
      "桐枯丹穴鳳何去，天在鼎湖龍不歸。",
      "簾影罷添新翡翠，露華猶濕舊珠璣。",
      "君王魂斷驪山路，且向蓬瀛伴貴妃。"
    ]
  },
  {
    "uid": "QTS_708_023_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "再幸華清宮",
    "poem": [
      "腸斷將軍改葬歸，錦囊香在憶當時。",
      "年來卻恨相思樹，春至不生連理枝。",
      "雪女塚頭瑤草合，貴妃池裏玉蓮衰。",
      "霓裳舊曲飛霜殿，夢破魂驚絕後期。"
    ]
  },
  {
    "uid": "QTS_708_024_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "喜雨上主人尚書",
    "poem": [
      "天皇攘袂勅神龍，雨我公田兆歲豐。",
      "幾日淋漓侵暮角，數宵滂沛徹晨鐘。",
      "細如春霧籠平野，猛似秋風擊古松。",
      "門下十年耕稼者，坐來偏憶翠微峰。"
    ]
  },
  {
    "uid": "QTS_708_025_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "迴文詩二首 其一",
    "poem": [
      "飛書一幅錦文迴，恨寫深情寄雁來。",
      "機上月殘香閣掩，樹梢煙澹緑窗開。",
      "霏霏雨罷歌終曲，漠漠雲深酒滿杯。",
      "歸日幾人行問卜，徽音想望倚高臺。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_708_025_02",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "迴文詩二首 其二",
    "poem": [
      "輕帆數點千峰碧，水接雲山四望遙。",
      "晴日海霞紅靄靄，曉天江樹綠迢迢。",
      "清波石眼泉當檻，小徑松門寺對橋。",
      "明月釣舟漁浦遠，傾山雪浪暗隨潮。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_708_026_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "不把漁竿",
    "poem": [
      "不把漁竿不灌園，策笻吟遶綠蕪村。",
      "得爭野老眠雲樂，倍感閩王與善恩。",
      "鳥趂竹風穿靜戶，魚吹煙浪噴晴軒。",
      "何人買我安貧趣，百萬黃金未可論。"
    ]
  },
  {
    "uid": "QTS_708_027_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "古往今來",
    "poem": [
      "古往今來恨莫窮，不如沈醉臥春風。",
      "雀兒無角長穿屋，鸚鵡能言卻入籠。",
      "柳惠豈嫌居下位，朱雲直去指三公。",
      "閒思郭令長安宅，草沒匡墻舊事空。"
    ]
  },
  {
    "uid": "QTS_708_028_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "十里煙籠",
    "poem": [
      "十里煙籠一徑分，故人迢遰久離羣。",
      "白雲明月皆由我，碧水青山忽贈君。",
      "浮世宦名渾似夢，半生勤苦謾為文。",
      "北邙坡上青松下，儘是鏘金佩玉墳。"
    ]
  },
  {
    "uid": "QTS_708_029_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "偶書",
    "poem": [
      "巧者多為拙者資，良籌第一在乘時。",
      "市門逐利終身飽，谷口躬耕盡日飢。",
      "瓊玖鬻來燕石貴，蓬蒿芳處楚蘭衰。",
      "高皇冷笑重瞳客，蓋世拔山何所為？"
    ]
  },
  {
    "uid": "QTS_708_030_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "潤屋",
    "poem": [
      "潤屋豐家莫妄求，眼看多是與身讐。",
      "百禽羅得皆黃口，四皓山居始白頭。",
      "玉爍火光爭肯變，草芳崎岸不曾秋。",
      "朱門粉署何由到，空寄新詩謝列侯。"
    ]
  },
  {
    "uid": "QTS_708_031_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "退居",
    "poem": [
      "鶴性松心合在山，五侯門館怯趨攀。",
      "三年臥病不能免，一日受恩方得還。",
      "明月送人沿驛路，白雲隨馬入柴關。",
      "笑他范蠡貪惏甚，相罷金多始退閑。"
    ]
  },
  {
    "uid": "QTS_708_032_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "閉門",
    "poem": [
      "閉卻閒門臥小窗，更何人與療膏肓。",
      "一生有酒唯知醉，四大無根可預量。",
      "骨冷欲針先覺痛，肉頑頻灸不成瘡。",
      "漳濱伏枕文園渴，盜跖縱橫似虎狼。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "小窗",
        "variant": "竹房",
        "source": "一作「竹房」"
      }
    ]
  },
  {
    "uid": "QTS_708_033_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "開窗",
    "poem": [
      "閉戸開窗寢又興，三更時節也如氷。",
      "長閒便是忘機者，不出真如過夏僧。",
      "環堵豈慚蝸作舍，布衣寧假鶴為翎。",
      "薔薇花盡薰風起，綠葉空隨滿架藤。"
    ]
  },
  {
    "uid": "QTS_708_034_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "燈花",
    "poem": [
      "點蠟燒銀卻勝栽，九華紅豔吐玫瑰。",
      "獨含冬夜寒光拆，不傍春風暖處開。",
      "難見只因能送喜，莫挑唯恐墮成灰。",
      "貪膏附熱多相誤，爲報飛蛾罷拂來。"
    ]
  },
  {
    "uid": "QTS_708_035_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "東歸出城留別知己",
    "poem": [
      "韋蒙屈指許非才，三載長安共酒桮。",
      "欲別未攀楊柳贈，相留擬待牡丹開。",
      "寒隨御水波光散，暖逐衡陽雁影來。",
      "他日因書問衰颯，東溪須訪子陵臺。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "韋",
        "variant": "常",
        "source": "一作「常」"
      }
    ]
  },
  {
    "uid": "QTS_708_036_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "詠懷",
    "poem": [
      "愁花變出白髭鬚，半世辛勤一事無。",
      "道在或期君夢想，貧來爭奈鬼揶揄。",
      "馬卿自愧長嬰疾，顏子誰憐不是愚。",
      "借取秦宮臺上鏡，為時開照漢妖狐。"
    ]
  },
  {
    "uid": "QTS_708_037_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "郊村獨游",
    "poem": [
      "歲閏堪憐厯候遲，出門惟與野雲期。",
      "驚魚擲上綠荷芰，棲鳥啄餘紅荔枝。",
      "末路可能長薄命，修途應合有良時。",
      "市頭相者休相戲，蹙膝先生半自知。"
    ]
  },
  {
    "uid": "QTS_708_038_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "經故翰林楊左丞池亭",
    "poem": [
      "八角紅亭蔭綠池，一朝青草蓋遺基。",
      "薔薇藤老開花淺，翡翠巢空落羽奇。",
      "春榜幾深門下客，樂章多取集中詩。",
      "平生德義人間誦，身後何勞更立碑。"
    ]
  },
  {
    "uid": "QTS_708_039_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "經故廣平員外舊宅",
    "poem": [
      "門巷蕭條引涕洟，遺孤三歲著麻衣。",
      "綠楊樹老垂絲短，翠竹林荒著筍稀。",
      "結社僧因秋朔弔，買書船近葬時歸。",
      "平生欲獻匡君策，抱病猶言未息機。"
    ]
  },
  {
    "uid": "QTS_708_040_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "潘丞相舊宅",
    "poem": [
      "綠樹垂枝蔭四鄰，春風還似舊時春。",
      "年年燕是雕梁主，處處花隨落月塵。",
      "七貴竟為長逝客，五侯尋作不歸人。",
      "秋槐影薄蟬聲盡，休謂龍門待化鱗。"
    ]
  },
  {
    "uid": "QTS_708_041_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "門外閒田數畝，長有泉源，因築直堤，分為兩沼",
    "poem": [
      "左右澄漪小檻前，直堤高築古平川。",
      "十分春水雙簷影，一片秋空兩月懸。",
      "前岸好山搖細浪，夾門嘉樹合晴煙。",
      "坐來暗起江湖思，速問溪翁買釣船。"
    ]
  },
  {
    "uid": "QTS_708_042_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "北園",
    "poem": [
      "北園乾葉旋空枝，蘭蕙還將眾草衰。",
      "籠鳥上天猶有待，病龍興雨豈無期。",
      "身閒不厭頻來客，年老偏憐最小兒。",
      "生事罷求名與利，一窗書策是年支。"
    ]
  },
  {
    "uid": "QTS_708_043_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "溪上要一隻白簟扇蓋頭垂釣，去年就節推侍御請之，蒙惠一柄紫花紋者，雖則鱗華具甚，紕薄不及清源所出，因就南郡陳常侍請之，遂成拙句",
    "poem": [
      "難求珍箑過炎天，遠就金貂乞月圓。",
      "直在引風欹角枕，且圖遮日上漁船。",
      "但令織取無花簟，不用挑為飲露蟬。",
      "莫道如今時較晚，也應留得到明年。"
    ]
  },
  {
    "uid": "QTS_708_044_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "招隱",
    "poem": [
      "齒髮那能敵歲華，早知休去避塵沙。",
      "鬼神只闞高明里，倚伏不干棲隱家。",
      "陶景豈全輕組綬，留侯非獨愛煙霞。",
      "贈君吉語堪銘座，看取朝開暮落花。"
    ]
  },
  {
    "uid": "QTS_708_045_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "憶山中友人",
    "poem": [
      "憶得當年接善鄰，苦將閒事強夫君。",
      "鬬開碧沼分明月，各領青山占白雲。",
      "近日藥方多繕寫，舊來詩草半燒焚。",
      "金門幾欲言西上，惆悵關河正用軍。"
    ]
  },
  {
    "uid": "QTS_708_046_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "溪隱",
    "poem": [
      "將名將利已無緣，深隱清溪擬學仙。",
      "絕卻腥羶勝服藥，斷除桮酒合延年。",
      "蝸牛殼漏寧同舍，榆莢花開不是錢。",
      "鸞鶴久從籠檻閉，春風卻放紙為鳶。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "漏",
        "variant": "滿",
        "source": "一作「滿」"
      }
    ]
  },
  {
    "uid": "QTS_708_047_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "酒醒",
    "poem": [
      "酒醒欲得適閒情，騎馬那勝策杖行。",
      "天暖天寒三月暮，溪南溪北兩村名。",
      "沙澄淺水魚知釣，花落平田鶴見耕。",
      "望斷長安故交遠，來書未說九河清。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "村",
        "variant": "川",
        "source": "一作「川」"
      }
    ]
  },
  {
    "uid": "QTS_708_048_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "夢斷",
    "poem": [
      "夢斷紗窗半夜雷，別君花落又花開。",
      "漁陽路遠書難寄，衡嶽山高月不來。",
      "玄燕有情穿繡戶，靈龜無應祝金杯。",
      "人生若得長相對，螢火生煙草化灰。"
    ]
  },
  {
    "uid": "QTS_708_049_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "人事",
    "poem": [
      "人事飄如一炷煙，且須求佛與求仙。",
      "豐年甲子春無雨，良夜庚申夏足眠。",
      "顏氏豈嫌瓢裏飲，孟光非取鏡中妍。",
      "平生生計何為者？三逕蒼苔十畝田。"
    ]
  },
  {
    "uid": "QTS_708_050_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "休說",
    "poem": [
      "休說人間有陸沈，一樽閒待月明斟。",
      "時來不怕滄溟闊，道大卻憂潢潦深。",
      "白首釣魚應是分，青雲干祿已無心。",
      "梓桐賦罷相如隱，誰為君前永夜吟？"
    ]
  },
  {
    "uid": "QTS_708_051_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "嘉運",
    "poem": [
      "嘉運良時兩阻修，釣竿蓑笠樂林丘。",
      "家無寸帛渾閒事，身似浮雲且自繇。",
      "庭際鳥啼花旋落，潭心月在水空流。",
      "晨炊一箸紅銀粒，憶著長安索米秋。"
    ]
  },
  {
    "uid": "QTS_708_052_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "綠鬢",
    "poem": [
      "緑鬢先生自出林，孟光同樂野雲深。",
      "躬耕為食古人操，非織不衣賢者心。",
      "眼眾豈能分瑞璧，舌多須信爍良金。",
      "君看黃閣南遷客，一過瀧州絕好音。"
    ]
  },
  {
    "uid": "QTS_708_053_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "驕侈",
    "poem": [
      "驕侈阽危儉素牢，鏡中形影豈能逃。",
      "石家恃富身還滅，顏子非貧道不遭。",
      "蝙蝠亦能知日月，鸞鳳那肯啄腥臊。",
      "古今人事惟堪醉，好脫驦裘換緑醪。"
    ]
  },
  {
    "uid": "QTS_708_054_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "龍蟄二首 其一",
    "poem": [
      "龍蟄蛇蟠卻待伸，和光何惜且同塵。",
      "伍員豈是吹簫者，冀缺非同執耒人。",
      "神劍觸星當變化，良金成器在陶鈞。",
      "穰侯休忌關東客，張祿先生竟相秦。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_708_054_02",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "龍蟄二首 其二",
    "poem": [
      "休說雄才間代生，到頭難與運相爭。",
      "時通有詔徵枚乘，世亂無人薦禰衡。",
      "逐日莫矜駑馬步，司晨誰要牝雞鳴。",
      "中林且作煙霞侶，塵滿關河未可行。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_708_055_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "逐臭蒼蠅",
    "poem": [
      "逐臭蒼蠅豈有為，清蟬吟露最高奇。",
      "多藏苟得何名富，飽食嗟來未勝飢。",
      "窮寂不妨延壽考，貪狂總待算毫釐。",
      "首陽山翠千年在，好奠氷壺弔伯夷。"
    ]
  },
  {
    "uid": "QTS_708_056_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "牡丹花二首 其一",
    "poem": [
      "看徧花無勝此花，剪雲披雪蘸丹砂。",
      "開當青律二三月，破卻長安千萬家。",
      "天縱穠華刳鄙吝，春教妖豔毒豪奢。",
      "不隨寒令同時放，倍種雙松與辟邪。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_708_056_02",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "牡丹花二首 其二",
    "poem": [
      "萬萬花中第一流，淺霞輕染嫩銀甌。",
      "能狂綺陌千金子，也惑朱門萬戶侯。",
      "朝日照開攜酒看，暮風吹落遶欄收。",
      "詩書滿架塵埃撲，盡日無人畧舉頭。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_708_057_01",
    "volume": 708,
    "author": {
      "canonical": "徐夤",
      "recorded": "徐夤"
    },
    "title": "尚書座上賦牡丹花得輕字韻，其花自越中移植",
    "poem": [
      "流蘇凝作瑞華精，仙閣開時麗日晴。",
      "霜月冷銷銀燭焰，寶甌圓印綵雲英。",
      "嬌含嫩臉春妝薄，紅蘸香綃豔色輕。",
      "早晚有人天上去，寄他將贈董雙成。"
    ],
