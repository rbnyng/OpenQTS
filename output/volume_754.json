      "wikidata_id": "Q11070999"
    },
    "title": "送黃秀才姑孰辟命",
    "poem": [
      "世亂離情苦，家貧色養難。",
      "水雲孤棹去，風雨暮春寒。",
      "幕府才方急，騷人淚未乾。",
      "何時王道泰，萬里看鵬摶。"
    ]
  },
  {
    "uid": "QTS_754_026_01",
