    "title": "省試秋風生桂枝",
    "poem": [
      "涼吹從何起，中宵景象清。",
      "漫隨雲葉動，高傍桂枝生。",
      "漠漠看無際，蕭蕭別有聲。",
      "遠吹斜漢轉，低拂白榆輕。",
      "寥泬工夫大，乾坤歲序更。",
      "因悲遠歸客，長望一枝榮。"
    ],
    "variants": [
      {
        "line": 6,
        "text": "遠",
        "variant": "未",
        "source": "一作「未」"
      }
    ]
