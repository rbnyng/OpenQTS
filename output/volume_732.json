    "title": "句",
    "poem": [
      "煙燻眼落膜",
      "瘴染面朱虞"
    ],
    "part_index": 1
  },
  {
    "uid": "QTS_732_003_01",
    "volume": 732,
    "author": {
      "canonical": "王越賓",
      "recorded": "王越賓"
    },
    "title": "使至灊山",
    "poem": [
      "碧䲧煙霞晝未開",
      "遊人到處盡裴回",
      "憑誰借問岩前叟",
      "曾托吾皇一夢來"
    ]
  },
  {
    "uid": "QTS_732_004_01",
    "volume": 732,
    "author": {
      "canonical": "王良會",
      "recorded": "王良會"
    },
    "title": "和武相公中秋夜西蜀錦樓望月得清字",
    "poem": [
      "德星搖此夜",
      "珥耳滿重城",
      "杳靄煙氛色",
      "飄颻砧杵聲",
      "令行秋氣爽",
      "樂感素風輕",
      "共賞千年聖",
      "長歌四海清"
    ]
  },
  {
    "uid": "QTS_732_005_01",
    "volume": 732,
    "author": {
      "canonical": "南詔驃信",
      "recorded": "南詔驃信"
    },
    "title": "星回節遊避風臺與清平官賦",
    "poem": [
      "避風善闡臺",
      "極目見藤越",
      "悲哉古與今",
      "依然煙與月",
      "自我居震旦",
      "翊衛類夔契",
      "伊惜勁皇運",
      "艱難仰忠烈",
      "不覺歲雲暮",
      "感極星回節",
      "元昶，同一心",
      "子孫堪貽厥"
    ]
  },
  {
    "uid": "QTS_732_006_01",
    "volume": 732,
    "author": {
      "canonical": "趙叔達",
      "recorded": "趙叔達"
    },
    "title": "星回節避風臺驃信命賦",
    "poem": [
      "法駕避星回",
      "波羅毗勇猜",
      "河潤冰難合",
      "地暖梅先開",
      "下令俚柔洽",
      "獻賝弄楝，來",
      "願將不才質",
      "千載侍遊臺"
    ]
  },
  {
    "uid": "QTS_732_007_01",
    "volume": 732,
    "author": {
      "canonical": "楊奇鯤",
      "recorded": "楊奇鯤"
    },
    "title": "途中詩",
    "poem": [
      "□□□□□□□",
      "□□□□□□□",
      "風裏浪花吹更白",
      "雨中山色洗還青",
      "海鷗聚處窗前見",
      "林狖啼時枕上聽",
      "此際自然無限趣",
      "王程不敢暫留停"
    ]
  },
  {
    "uid": "QTS_732_008_01",
    "volume": 732,
    "author": {
      "canonical": "布燮",
      "recorded": "布燮"
    },
    "title": "聽妓洞雲歌",
    "poem": [
      "嵇叔夜",
      "鼓琴飲酒無閑暇",
      "若使當時無此歌",
      "拋擲廣陵都不藉",
      "劉伯倫",
      "虛生浪死過青春",
      "一飲一碩猶自醉",
      "無人為爾卜深塵"
    ]
  },
  {
    "uid": "QTS_732_009_01",
    "volume": 732,
    "author": {
      "canonical": "布燮",
      "recorded": "布燮"
    },
    "title": "思鄉作",
    "poem": [
      "瀘北行人絕",
      "雲南信未還",
      "庭前花不掃",
      "門外柳誰攀",
      "坐久銷銀燭",
      "愁多減玉顏",
      "懸心秋夜月",
      "萬里照關山"
    ]
  },
  {
    "uid": "QTS_732_010_01",
    "volume": 732,
    "author": {
      "canonical": "朝衡",
      "recorded": "朝衡",
      "gender": "male",
      "period": "High Tang",
      "english_name": "Abe no Nakamaro",
      "wikidata_id": "Q479788"
    },
    "title": "銜命還國作",
    "poem": [
      "銜命將辭國，非才忝侍臣。",
      "天中戀明主，海外憶慈親。",
      "伏奏違金闕，騑驂去玉津。",
      "蓬萊郷路遠，若木故園鄰。",
      "西望懷恩日，東歸感義辰。",
      "平生一寶劒，留贈結交人。"
    ],
    "variants": [
      {
        "line": 4,
        "text": "鄰",
        "variant": "林",
        "source": "一作「林」"
      }
    ]
  },
  {
    "uid": "QTS_732_011_01",
    "volume": 732,
    "author": {
      "canonical": "長屋",
      "recorded": "長屋"
    },
    "title": "繡袈裟衣緣",
    "poem": [
      "山川異域，風月同天。",
      "寄諸佛子，共結來緣。"
    ]
  },
  {
    "uid": "QTS_732_012_01",
    "volume": 732,
    "author": {
      "canonical": "王巨仁",
      "recorded": "王巨仁"
    },
    "title": "憤怨詩",
    "poem": [
      "于公慟哭三年旱，鄒衍含愁五月霜。",
      "今我幽愁還似古，皇天無語但蒼蒼。"
    ]
  },
  {
    "uid": "QTS_732_013_01",
    "volume": 732,
    "author": {
      "canonical": "李贊華",
      "recorded": "李贊華"
    },
    "title": "立木海上刻詩",
    "poem": [
      "小山壓大山，大山全無力。",
      "羞見故鄉人，從此投外國。"
    ],
    "variants": [
