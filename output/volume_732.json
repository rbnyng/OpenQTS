      },
      {
        "line": 2,
        "text": "外國",
        "variant": "化外",
        "source": "一作「化外」"
      }
    ]
  },
  {
    "uid": "QTS_732_014_01",
    "volume": 732,
    "author": {
      "canonical": "成輔端",
      "recorded": "成輔端"
    },
    "title": "戲語",
    "poem": [
      "秦地城池二百年",
      "何期如此賤家園",
      "一頃麥苗碩伍米",
      "三間堂屋兩千錢"
    ],
    "notes": [
      {
        "content": "《唐書》：京兆尹司農卿李寔，務聚歛進奉，不恤災歉，人窮無告，乃徹屋瓦木、賣麥苖以供賦歛。輔端因戲作語，為秦民艱苦之狀，如此者數十篇。寔怒之，言於帝，故坐殺",
        "context": "戲語",
        "original_title": "戲語〈《唐書》：京兆尹司農卿李寔，務聚歛進奉，不恤災歉，人窮無告，乃徹屋瓦木、賣麥苖以供賦歛。輔端因戲作語，為秦民艱苦之狀，如此者數十篇。寔怒之，言於帝，故坐殺〉"
      }
    ]
  },
  {
    "uid": "QTS_732_015_01",
    "volume": 732,
    "author": {
      "canonical": "張隱",
      "recorded": "張隱"
    },
    "title": "萬壽寺歌詞",
    "poem": [
      "位乖燮理至傷殘",
      "四面牆匡不忍看",
      "正是花時堪下淚",
      "相公何必更追歡"
    ]
  },
  {
    "uid": "QTS_732_016_01",
    "volume": 732,
    "author": {
      "canonical": "朱元",
      "recorded": "朱元"
    },
    "title": "迎孫刺史",
    "poem": [
      "昔日郎君今刺史",
      "朱元依舊守朱門",
      "今朝竹馬諸童子",
      "盡是當年竹馬孫"
    ]
  },
  {
    "uid": "QTS_732_017_01",
    "volume": 732,
    "author": {
      "canonical": "陳璠",
      "recorded": "陳璠"
    },
    "title": "臨刑詩",
    "poem": [
      "積玉堆金官又崇，禍來倏忽變成空。",
      "五年榮貴今何在？",
      "不異南柯一夢中。"
    ],
    "notes": [
      {
        "content": "璠不知書，時以為鬼代作",
        "context": "臨刑詩",
        "original_title": "臨刑詩〈璠不知書，時以為鬼代作〉"
      }
    ]
  },
  {
    "uid": "QTS_732_018_01",
    "volume": 732,
    "author": {
      "canonical": "捧劍僕",
      "recorded": "捧劍僕"
    },
    "title": "詩",
    "poem": [
      "青鳥銜葡萄，飛上金井欄。",
      "美人恐驚去，不敢捲簾看。"
    ]
  },
  {
    "uid": "QTS_732_019_01",
    "volume": 732,
    "author": {
      "canonical": "捧劍僕",
      "recorded": "捧劍僕"
    },
    "title": "題牡丹",
    "poem": [
      "一種芳菲出後庭",
      "卻輸桃李得姓名",
      "誰能為向天人說",
      "從此移根近太清"
    ]
  },
  {
    "uid": "QTS_732_020_01",
    "volume": 732,
    "author": {
      "canonical": "捧劍僕",
      "recorded": "捧劍僕"
    },
    "title": "將竄留詩",
    "poem": [
      "珍重郭四郎",
      "臨行不得別",
      "曉漏洞離心",
      "輕車冒殘雪",
      "欲出主人門",
      "零涕暗嗚咽",
      "萬里隔關山",
      "一心思漢月"
    ]
  }
]