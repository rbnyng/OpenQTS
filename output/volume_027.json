      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Yifu",
      "wikidata_id": "Q711640"
    },
    "title": "雜曲歌辭·堂堂",
    "poem": [
      "堂堂復堂堂，紅脫梅灰香。",
      "十年粉蠹生畫梁，飢蟲不食推碎黃。",
      "蕙花已老桃葉長，禁院懸簾隔御光。",
      "華清源中礜石湯，裴回百鳳隨君王。"
    ]
  },
  {
    "uid": "QTS_027_037_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·涼州歌第一",
    "poem": [
      "漢家宮裡柳如絲，上苑桃花連碧池。",
      "聖壽已傳千歲酒，天文更賞百僚詩。"
    ]
  },
  {
    "uid": "QTS_027_038_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·涼州歌第二",
    "poem": [
      "朔風吹葉雁門秋，萬里煙塵昏戍樓。",
      "征馬長思青海北，胡笳夜聽隴山頭。"
    ]
  },
  {
    "uid": "QTS_027_039_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·涼州歌第三",
    "poem": [
      "開篋淚沾襦，見君前日書。",
      "夜台空寂寞，猶見紫雲車。"
    ]
  },
  {
    "uid": "QTS_027_040_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·排遍第一",
    "poem": [
      "三秋陌上早霜飛，羽獵平田淺草齊。",
      "錦背蒼鷹初出按，五花驄馬餵來肥。"
    ]
  },
  {
    "uid": "QTS_027_041_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·排遍第二",
    "poem": [
      "鴛鴦殿裡笙歌起，翡翠樓前出舞人。",
      "喚上紫微三五夕，聖明方壽一千春。"
    ]
  },
  {
    "uid": "QTS_027_042_01",
    "volume": 27,
    "author": {
      "canonical": "耿緯",
      "recorded": "耿緯"
    },
    "title": "雜曲歌辭·涼州詞",
    "poem": [
      "國使翩翩隨旆旌，隴西岐路足荒城。",
      "氈裘牧馬胡雛小，日暮蕃歌三兩聲。"
    ]
  },
  {
    "uid": "QTS_027_043_01",
    "volume": 27,
    "author": {
      "canonical": "張籍",
      "recorded": "張籍",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Zhang Ji",
      "wikidata_id": "Q836849"
    },
    "title": "雜曲歌辭·涼州詞",
    "poem": [
      "邊城暮雨雁飛低，蘆筍初生漸欲齊。",
      "無數鈴聲遙過磧，應馱白練到安西。",
      "古鎮城門白磧開，胡兵往往傍沙堆。",
      "巡邊使客行應早，每待平安火到來。",
      "鳳林關里水東流，白草黃榆六十秋。",
      "邊將皆承主恩澤，無人解道取涼州。"
    ]
  },
  {
    "uid": "QTS_027_044_01",
    "volume": 27,
    "author": {
      "canonical": "薛逢",
      "recorded": "薛逢",
      "gender": "male",
      "english_name": "Xue Feng",
      "wikidata_id": "Q11622255"
    },
    "title": "雜曲歌辭·涼州詞",
    "poem": [
      "昨夜蕃兵報國讎，沙州都護破涼州。",
      "黃河九曲今歸漢，塞外縱橫戰血流。"
    ]
  },
  {
    "uid": "QTS_027_045_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·太和第一",
    "poem": [
      "國門卿相舊山莊，聖主移來宴綠芳。",
      "簾外輾為車馬路，花間踏出舞人場。"
    ]
  },
  {
    "uid": "QTS_027_046_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·太和第二",
    "poem": [
      "國鳥尚含天樂轉，寒風猶帶御衣香。",
      "為報碧潭明月夜，會須留賞待君王。"
    ]
  },
  {
    "uid": "QTS_027_047_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·太和第三",
    "poem": [
      "庭前鵲繞相思樹，井上鶯歌爭刺桐。",
      "含情少婦悲春草，多是良人學轉蓬。"
    ]
  },
  {
    "uid": "QTS_027_048_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·太和第四",
    "poem": [
      "塞北江南共一家，何須淚落怨黃沙。",
      "春酒半酣千日醉，庭前還有落梅花。"
    ]
  },
  {
    "uid": "QTS_027_049_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·太和第五徹",
    "poem": [
      "我皇膺運太平年，四海朝宗會百川。",
      "自古幾多明聖主，不如今帝勝堯天。"
    ]
  },
  {
    "uid": "QTS_027_050_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·伊川歌第一",
    "poem": [
      "秋風明月獨離居，蕩子從戎十載餘。",
      "征人去日殷勤屬，歸雁來時數寄書。"
    ]
  },
  {
    "uid": "QTS_027_051_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·伊川歌第二",
    "poem": [
      "彤闈曉辟萬鞍回，玉輅春遊薄晚開。",
      "渭北清光搖草樹，州南嘉景入樓台。"
    ]
  },
  {
    "uid": "QTS_027_052_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·伊川歌第三",
    "poem": [
      "聞道黃花戍，頻年不解兵。",
      "可憐閨里月，偏照漢家營。"
    ]
  },
  {
    "uid": "QTS_027_053_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·伊川歌第四",
    "poem": [
      "千里東歸客，無心憶舊遊。",
      "掛帆游白水，高枕到青州。"
    ]
  },
  {
    "uid": "QTS_027_054_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·伊川歌第五",
    "poem": [
      "桂殿江烏對，雕屏海燕重。",
      "只應多釀酒，醉罷樂高鍾。"
    ]
  },
  {
    "uid": "QTS_027_055_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·入破第一",
    "poem": [
      "千門今夜曉初晴，萬里天河徹帝京。",
      "璨璨繁星駕秋色，稜稜霜氣韻鐘聲。"
    ]
  },
  {
    "uid": "QTS_027_056_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·入破第二",
    "poem": [
      "長安二月柳依依，西出流沙路漸微。",
      "閼氏山上春光少，相府庭邊驛使稀。"
    ]
  },
  {
    "uid": "QTS_027_057_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·入破第三",
    "poem": [
      "三秋大漠冷溪山，八月嚴霜變草顏。",
      "卷旆風行宵渡磧，銜枚電掃曉應還。"
    ]
  },
  {
    "uid": "QTS_027_058_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·入破第四",
    "poem": [
      "行樂三陽早，芳菲二月春。",
      "閨中紅粉態，陌上看花人。"
    ]
  },
  {
    "uid": "QTS_027_059_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·入破第五",
    "poem": [
      "君住孤山下，煙深夜徑長。",
      "轅門渡綠水，游苑繞垂楊。"
    ]
  },
  {
    "uid": "QTS_027_060_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·陸州歌第一",
    "poem": [
      "分野中峰變，陰晴眾壑殊。",
      "欲投人處宿，隔浦問樵夫。"
    ]
  },
  {
    "uid": "QTS_027_061_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·陸州歌第二",
    "poem": [
      "共得煙霞徑，東歸山水游。",
      "蕭蕭望林夜，寂寂坐中秋。"
    ]
  },
  {
    "uid": "QTS_027_062_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·陸州歌第三",
    "poem": [
      "香氣傳空滿，妝花映薄紅。",
      "歌聲天仗外，舞態御樓中。"
    ]
  },
  {
    "uid": "QTS_027_063_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·排遍第一",
    "poem": [
      "樹發花如錦，鶯啼柳若絲。",
      "更逢歡宴地，愁見別離時。"
    ]
  },
  {
    "uid": "QTS_027_064_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·排遍第二",
    "poem": [
      "明月照秋葉，西風響夜砧。",
      "強言徒自亂，往事不堪尋。"
    ]
  },
  {
    "uid": "QTS_027_065_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·排遍第三",
    "poem": [
      "坐對銀釭曉，停留玉箸痕。",
      "君門常不見，無處謝前恩。"
    ]
  },
  {
    "uid": "QTS_027_066_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·排遍第四",
    "poem": [
      "曙月當窗滿，征人出塞遙。",
      "畫樓終日閉，清管為誰調。"
    ]
  },
  {
    "uid": "QTS_027_067_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·簇拍陸州",
    "poem": [
      "西去輪台萬里餘，故鄉音耗日應疏。",
      "隴山鸚鵡能言語，為報閨人數寄書。"
    ]
  },
  {
    "uid": "QTS_027_068_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·石州",
    "poem": [
      "自從君去遠巡邊，終日羅幃獨自眠。",
      "看花情轉切，攬鏡淚如泉。",
      "一自離君後，啼多雙臉穿。",
      "何時狂虜滅，免得更留連。"
    ]
  },
  {
    "uid": "QTS_027_069_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·蓋羅縫",
    "poem": [
      "秦時明月漢時關，萬里征人尚未還。",
      "但願龍庭神將在，不教胡馬渡陰山。",
      "音書杜絕白狼西，桃李無顏黃鳥啼。",
      "寒鳥春深歸去盡，出門腸斷草萋萋。"
    ]
  },
  {
    "uid": "QTS_027_070_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·雙帶子",
    "poem": [
      "私言切語誰人會，海燕雙飛繞畫梁。",
      "君學秋胡不相識，妾亦無心去採桑。"
    ]
  },
  {
    "uid": "QTS_027_071_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·崑崙子",
    "poem": [
      "揚子譚經去，淮王載酒過。",
      "醉來啼鳥喚，坐久落花多。"
    ]
  },
  {
    "uid": "QTS_027_072_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·祓禊曲",
    "poem": [
      "昨見春條綠，那知秋葉黃。",
      "蟬聲猶未斷，寒雁已成行。",
      "金谷園中柳，春來已舞腰。",
      "那堪好風景，獨上洛陽橋。",
      "何處堪愁思，花間長樂宮。",
      "君王不重客，泣淚向春風。"
    ]
  },
  {
    "uid": "QTS_027_073_01",
    "volume": 27,
    "author": {
      "canonical": "張祜",
      "recorded": "張祜",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Zhang Hu",
      "wikidata_id": "Q11067506"
    },
    "title": "雜曲歌辭·上巳樂",
    "poem": [
      "猩猩血彩系頭標，天上齊聲舉畫橈。",
      "卻是內人爭意切，六宮羅袖一時招。"
    ]
  },
  {
    "uid": "QTS_027_074_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·穆護砂",
    "poem": [
      "玉管朝朝弄，清歌日日新。",
      "折花當驛路，寄與隴頭人。"
    ]
  },
  {
    "uid": "QTS_027_075_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·思歸樂",
    "poem": [
      "晚日催弦管，春風入綺羅。",
      "杏花如有意，偏落舞衫多。",
      "萬里春應盡，三江雁亦稀。",
      "連天漢水廣，孤客未言歸。"
    ]
  },
  {
    "uid": "QTS_027_076_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·金殿樂",
    "poem": [
      "入夜秋砧動，千門起四鄰。",
      "不緣樓上月，應為隴頭人。"
    ]
  },
  {
    "uid": "QTS_027_077_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·胡渭州",
    "poem": [
      "亭亭孤月照行舟，寂寂長江萬里流。",
      "鄉國不知何處是，雲山漫漫使人愁。",
      "楊柳千尋色，桃花一苑芳。",
      "風吹入簾里，惟有惹衣香。"
    ]
  },
  {
    "uid": "QTS_027_078_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·戎渾",
    "poem": [
      "風勁角弓鳴，將軍獵渭城。",
      "草枯鷹眼疾，雪盡馬蹄輕。"
    ]
  },
  {
    "uid": "QTS_027_079_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·牆頭花",
    "poem": [
      "蟋蟀鳴洞房，梧桐落金井。",
      "為君裁舞衣，天寒剪刀冷。",
      "妾有羅衣裳，秦王在時作。",
      "為舞春風多，秋來不堪着。"
    ]
  },
  {
    "uid": "QTS_027_080_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·採桑",
    "poem": [
      "自古多征戰，由來尚甲兵。",
      "長驅千里去，一舉兩蕃平。",
      "按劍從沙漠，歌謠滿帝京。",
      "寄言天下將，須立武功名。"
    ]
  },
  {
    "uid": "QTS_027_081_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·楊下採桑",
    "poem": [
      "飛絲惹綠塵，軟葉對孤輪。",
      "今朝入園去，物色強看人。"
    ]
  },
  {
    "uid": "QTS_027_082_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·破陣樂",
    "poem": [
      "秋來四面足風沙，塞外征人暫別家。",
      "千里不辭行路遠，時光早晚到天涯。",
      "漢兵出頓金微，照日明光鐵衣。",
      "百里火幡焰焰，千行雲騎騑騑。",
      "蹙踏遼河自竭，鼓譟燕山可飛。",
      "正屬四方朝賀，端知萬舞皇威。",
      "少年膽氣凌雲，共許驍雄出群。",
      "匹馬城南挑戰，單刀薊北從軍。",
      "一鼓鮮卑送款，五餌單于解紛。",
      "誓欲成名報國，羞將開口論勛。"
    ]
  },
  {
    "uid": "QTS_027_083_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·戰勝樂",
    "poem": [
      "百戰得功名，天兵意氣生。",
      "三邊永不戰，此是我皇英。"
    ]
  },
  {
    "uid": "QTS_027_084_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·劍南臣",
    "poem": [
      "不分君恩斷，觀妝視鏡中。",
      "容華尚春日，嬌愛已秋風。",
      "枕席臨窗曉，屏帷對月空。",
      "年年後庭樹，芳悴在深宮。"
    ]
  },
  {
    "uid": "QTS_027_085_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·征步郎",
    "poem": [
      "塞外虜塵飛，頻年度磧西。",
      "死生隨玉劍，辛苦向金微。"
    ]
  },
  {
    "uid": "QTS_027_086_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·嘆疆場",
    "poem": [
      "聞道行人至，妝梳對鏡台。",
      "淚痕猶尚在，笑靨自然開。"
    ]
  },
  {
    "uid": "QTS_027_087_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·塞姑",
    "poem": [
      "昨日盧梅塞口，整見諸人鎮守。",
      "都護三年不歸，折盡江邊楊柳。"
    ]
  },
  {
    "uid": "QTS_027_088_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·水鼓子",
    "poem": [
      "雕弓白羽獵初回，薄夜牛羊復下來。",
      "夢水河邊秋草合，黑山峰外陣雲開。"
    ]
  },
  {
    "uid": "QTS_027_089_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·婆羅門",
    "poem": [
      "回樂峰前沙似雪，受降城外月如霜。",
      "不知何處吹蘆管，一夜征人盡望鄉。"
    ]
  },
  {
    "uid": "QTS_027_090_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·浣沙女",
    "poem": [
      "南陌春風早，東鄰去日斜。",
      "千花開瑞錦，香撲美人車。",
      "長樂青門外，宜春小苑東。",
      "樓開萬戶上，人向百花中。"
    ]
  },
  {
    "uid": "QTS_027_091_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·鎮西",
    "poem": [
      "天邊物色更無春，只有羊群與馬群。",
      "誰家營里吹羌笛，哀怨教人不忍聞。",
      "歲去年來拜聖朝，更無山闕對溪橋。",
      "九門楊柳渾無半，猶自千條與萬條。"
    ]
  },
  {
    "uid": "QTS_027_092_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·回紇",
    "poem": [
      "曾聞瀚海使難通，幽閨少婦罷裁縫。",
      "緬想邊庭征戰苦，誰能對鏡治愁容。",
      "久戍人將老，須臾變作白頭翁。"
    ]
  },
  {
    "uid": "QTS_027_093_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·長命女",
    "poem": [
      "雲送關西雨，風傳渭北秋。",
      "孤燈然客夢，寒杵搗鄉愁。"
    ]
  },
  {
    "uid": "QTS_027_094_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·醉公子",
    "poem": [
      "昨日春園飲，今朝倒接籬。",
      "誰人扶上馬，不省下樓時。"
    ]
  },
  {
    "uid": "QTS_027_095_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·一片子",
    "poem": [
      "柳色青山映，梨花雪鳥藏。",
      "綠窗桃李下，閒坐嘆春芳。"
    ]
  },
  {
    "uid": "QTS_027_096_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·甘州",
    "poem": [
      "欲使傳消息，空書意不任。",
      "寄君明月鏡，偏照故人心。"
    ]
  },
  {
    "uid": "QTS_027_097_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·濮陽女",
    "poem": [
      "雁來書不至，月照獨眠房。",
      "賤妾多愁思，不堪秋夜長。"
    ]
  },
  {
    "uid": "QTS_027_098_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·相府蓮",
    "poem": [
      "夜聞鄰婦泣，切切有餘哀。",
      "即問緣何事，征人戰未回。"
    ]
  },
  {
    "uid": "QTS_027_099_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·簇拍相府蓮",
    "poem": [
      "莫以今時寵，寧無舊日恩。",
      "看花滿眼淚，不共楚王言。",
      "閨燭無人影，羅屏有夢魂。",
      "近來音耗絕，終日望應門。"
    ]
  },
  {
    "uid": "QTS_027_100_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·離別難",
    "poem": [
      "此別難重陳，花深復變人。",
      "來時梅覆雪，去日柳含春。",
      "物候催行客，歸途淑氣新。",
      "剡川今已遠，魂夢暗相親。"
    ]
  },
  {
    "uid": "QTS_027_101_01",
    "volume": 27,
    "author": {
      "canonical": "白居易",
      "recorded": "白居易",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Bai Juyi",
      "wikidata_id": "Q313324"
    },
    "title": "雜曲歌辭·離別難",
    "poem": [
      "綠楊陌上送行人，馬去車回一望塵。",
      "不覺別時紅淚盡，歸來無淚可沾巾。"
    ]
  },
  {
    "uid": "QTS_027_102_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·山鷓鴣",
    "poem": [
      "玉關征戍久，空閨人獨愁。",
      "寒露濕青苔，別來蓬鬢秋。",
      "人坐青樓晚，鶯語百花時。",
      "愁人多自老，腸斷君不知。"
    ]
  },
  {
    "uid": "QTS_027_103_01",
    "volume": 27,
    "author": {
      "canonical": "李益",
      "recorded": "李益",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Li Yi",
      "wikidata_id": "Q3237588"
    },
    "title": "雜曲歌辭·鷓鴣詞",
    "poem": [
      "湘江斑竹枝，錦翼鷓鴣飛。",
      "處處湘陰合，郎從何處歸。"
    ]
  },
  {
    "uid": "QTS_027_104_01",
    "volume": 27,
    "author": {
      "canonical": "李涉",
      "recorded": "李涉",
      "gender": "male",
      "english_name": "Li She",
      "wikidata_id": "Q18909427"
    },
    "title": "雜曲歌辭·鷓鴣詞",
    "poem": [
      "湘江煙水深，沙岸隔楓林。",
      "何處鷓鴣飛，日斜斑竹陰。",
      "二女虛垂淚，三閭枉自沉。",
      "惟有鷓鴣鳥，獨傷行客心。",
      "越岡連越井，越鳥更南飛。",
      "何處鷓鴣啼，夕煙東嶺歸。",
      "嶺頭行人少，天涯北客稀。",
      "鷓鴣啼別處，相對淚沾衣。"
    ]
  },
  {
    "uid": "QTS_027_105_01",
    "volume": 27,
    "author": {
      "canonical": "白居易",
      "recorded": "白居易",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Bai Juyi",
      "wikidata_id": "Q313324"
    },
    "title": "雜曲歌辭·樂世",
    "poem": [
      "管急絲繁拍漸稠，綠腰宛轉曲終頭。",
      "誠知樂世聲聲樂，老病人聽未免愁。"
    ]
  },
  {
    "uid": "QTS_027_106_01",
    "volume": 27,
    "author": {
      "canonical": "白居易",
      "recorded": "白居易",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Bai Juyi",
      "wikidata_id": "Q313324"
    },
    "title": "雜曲歌辭·急樂世",
    "poem": [
      "正抽碧線繡紅羅，忽聽黃鶯斂翠蛾。",
      "秋思冬愁春恨望，大都不得意時多。"
    ]
  },
  {
    "uid": "QTS_027_107_01",
    "volume": 27,
    "author": {
      "canonical": "白居易",
      "recorded": "白居易",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Bai Juyi",
      "wikidata_id": "Q313324"
    },
    "title": "雜曲歌辭·何滿子",
    "poem": [
      "世傳滿子是人名，臨就刑時曲始成。",
      "一曲四詞歌八迭，從頭便是斷腸聲。"
    ]
  },
  {
    "uid": "QTS_027_108_01",
    "volume": 27,
    "author": {
      "canonical": "薛逢",
      "recorded": "薛逢",
      "gender": "male",
      "english_name": "Xue Feng",
      "wikidata_id": "Q11622255"
    },
    "title": "雜曲歌辭·何滿子",
    "poem": [
      "系馬宮槐老，持懷店菊黃。",
      "故交今不見，流恨滿川光。"
    ]
  },
  {
    "uid": "QTS_027_109_01",
    "volume": 27,
    "author": {
      "canonical": "李白",
      "recorded": "李白",
      "gender": "male",
      "period": "High Tang",
      "english_name": "Li Bai",
      "wikidata_id": "Q7071"
    },
    "title": "雜曲歌辭·清平調",
    "poem": [
      "雲想衣裳花想容，春風拂檻露華濃。",
      "若非群玉山頭見，會向瑤台月下逢。",
      "一枝紅艷露凝香，雲雨巫山枉斷腸。",
      "借問漢宮誰得似，可憐飛燕倚新妝。",
      "名花傾國兩相歡，長得君王帶笑看。",
      "解釋春風無限恨，沉香亭北倚闌干。"
    ]
  },
  {
    "uid": "QTS_027_110_01",
    "volume": 27,
    "author": {
      "canonical": "李景伯",
      "recorded": "李景伯",
      "gender": "male",
      "wikidata_id": "Q18906245"
    },
    "title": "雜曲歌辭·回波樂",
    "poem": [
      "回波爾時酒卮，微臣職在箴規。",
      "侍宴既過三爵，喧譁竊恐非儀。"
    ]
  },
  {
    "uid": "QTS_027_111_01",
    "volume": 27,
    "author": {
      "canonical": "張仲素",
      "recorded": "張仲素",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Zhang Zhongsu",
      "wikidata_id": "Q11066470"
    },
    "title": "雜曲歌辭·聖明樂",
    "poem": [
      "玉帛殊方至，歌鐘比屋聞。",
      "華夷今一貫，同賀聖明君。",
      "九陌祥煙合，千春瑞月明。",
      "宮花將苑柳，先發鳳凰城。"
    ]
  },
  {
    "uid": "QTS_027_112_01",
    "volume": 27,
    "author": {
      "canonical": "令狐楚",
      "recorded": "令狐楚",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Linghu Chu",
      "wikidata_id": "Q5955927"
    },
    "title": "雜曲歌辭·聖明樂",
    "poem": [
      "海浪恬丹徼，邊塵靖黑山。",
      "從今萬里外，不復鎮蕭關。"
    ]
  },
  {
    "uid": "QTS_027_113_01",
    "volume": 27,
    "author": {
      "canonical": "Unknown",
      "recorded": "Unknown"
    },
    "title": "雜曲歌辭·大酺樂",
    "poem": [
      "淚滴珠難盡，容殘玉易銷。",
      "儻隨明月去，莫道夢魂遙。"
    ],
    "notes": [
      {
        "content": "商調曲",
        "context": "辭·大酺樂",
        "original_title": "雜曲歌辭·大酺樂（商調曲）"
      }
    ]
  },
  {
    "uid": "QTS_027_114_01",
    "volume": 27,
    "author": {
      "canonical": "杜審言",
      "recorded": "杜審言",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Du Shenyan",
      "wikidata_id": "Q718118"
    },
    "title": "雜曲歌辭·大酺樂",
    "poem": [
      "聖后乘干日，皇明御歷辰。",
      "紫宮初啟坐，蒼璧正臨春。",
      "雷雨垂膏澤，金錢賜下人。",
      "詔酺歡賞遍，交泰睹惟新。",
      "毗陵震澤九州通，士女歡娛萬國同。",
      "伐鼓撞鐘驚海上，新妝袨服照江東。",
      "梅花落處疑殘雪，柳葉開時任好風。",
      "大德不官逢道泰，天長地久屬年豐。"
    ]
  },
  {
    "uid": "QTS_027_115_01",
    "volume": 27,
    "author": {
      "canonical": "張祜",
      "recorded": "張祜",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Zhang Hu",
      "wikidata_id": "Q11067506"
    },
    "title": "雜曲歌辭·大酺樂",
    "poem": [
      "車駕東來值太平，大酺三日洛陽城。",
      "小兒一伎竿頭絕，天下傳呼萬歲聲。",
      "紫陌酺歸日欲斜，紅塵開路薛王家。",
      "雙鬟前說樓前鼓，兩伎爭輪好結花。"
    ]
  },
  {
    "uid": "QTS_027_116_01",
    "volume": 27,
    "author": {
      "canonical": "張祜",
      "recorded": "張祜",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Zhang Hu",
      "wikidata_id": "Q11067506"
    },
    "title": "雜曲歌辭·千秋樂",
    "poem": [
      "八月平時花萼樓，萬方同樂奏千秋。",
      "傾城人看長竿出，一伎初成趙解愁。"
    ]
  },
  {
    "uid": "QTS_027_117_01",
    "volume": 27,
    "author": {
      "canonical": "李百藥",
      "recorded": "李百藥",
      "gender": "male",
      "period": "Pre-Tang",
      "english_name": "Li Baiyao",
      "wikidata_id": "Q718176"
    },
    "title": "雜曲歌辭·火鳳辭",
    "poem": [
      "歌聲扇里出，妝影扇中輕。",
      "未能令掩笑，何處欲鄣聲。",
      "知音自不惑，得念是分明。",
      "莫見雙嚬斂，疑人含笑情。",
      "佳人靚晚妝，清唱動蘭房。",
      "影入含風扇，聲飛照日梁。",
      "嬌嚬眉際斂，逸韻口中香。",
      "自有橫陳分，應憐秋夜長。"
    ]
  },
  {
    "uid": "QTS_027_118_01",
    "volume": 27,
    "author": {
      "canonical": "張祜",
      "recorded": "張祜",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Zhang Hu",
      "wikidata_id": "Q11067506"
    },
    "title": "雜曲歌辭·熱戲樂",
    "poem": [
      "熱戲爭心劇火燒，銅槌暗執不相饒。",
      "上皇失喜寧王笑，百尺幢竿果動搖。"
    ]
  },
  {
    "uid": "QTS_027_119_01",
    "volume": 27,
    "author": {
      "canonical": "張祜",
      "recorded": "張祜",
      "gender": "male",
      "period": "Middle Tang",
      "english_name": "Zhang Hu",
      "wikidata_id": "Q11067506"
    },
    "title": "雜曲歌辭·春鶯囀",
    "poem": [
      "興慶池南柳未開，太真先把一枝梅。",
      "內人已唱春鶯囀，花下傞傞軟舞來。"
    ]
  },
  {
    "uid": "QTS_027_120_01",
    "volume": 27,
    "author": {
      "canonical": "溫庭筠",
      "recorded": "溫庭筠",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wen Tingyun",
      "wikidata_id": "Q1367928"
    },
    "title": "雜曲歌辭·達摩支",
    "poem": [
      "搗麝成塵香不滅，拗蓮作寸絲難絕。",
      "紅淚文姬洛水春，白頭蘇武天山雪。",
      "君不見無愁高緯花漫漫，漳浦宴餘清露寒。",
      "一旦臣僚共囚虜，欲吹羌管先汍瀾。",
      "舊臣頭鬢霜華早，可惜雄心醉中老。",
      "萬古春歸夢不歸，鄴城風雨連天草。"
    ]
