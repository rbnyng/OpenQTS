    "title": "奉和聖制過溫湯",
    "poem": [
      "鳳輦騰宸駕",
      "驪籞次乾遊",
      "坎德疏溫液",
      "山隈派暖流",
      "寒氛空外擁",
      "蒸氣沼中浮",
      "林凋帷影散",
      "雲斂蓋陰收",
      "霜郊暢玄覽",
      "參差落景遒"
    ]
  },
  {
    "uid": "QTS_006_004_01",
