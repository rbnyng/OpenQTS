      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "聞回戈軍",
    "poem": [
      "上將鏖兵又欲旋，翠華巡幸已三年。",
      "營中不用栽楊柳，願戴儒冠為控弦。"
    ],
