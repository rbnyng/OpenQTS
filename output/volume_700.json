      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "悔恨",
    "poem": [
      "六七年來春又秋，也同歡笑也同愁。",
      "才聞及第心先喜，試說求婚淚便流。",
      "幾為妒來頻斂黛，每思閒事不梳頭。",
      "如今悔恨將何益，腸斷千休與萬休。"
    ]
  },
  {
    "uid": "QTS_700_020_01",
    "volume": 700,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "虛席",
    "poem": [
      "一閉香閨後，羅衣盡施僧。",
      "鼠偷筵上果，蛾撲帳前燈。",
      "土蝕釵無鳳，塵生鏡少菱。",
      "有時還影響，花葉曳香繒。"
    ]
  },
  {
    "uid": "QTS_700_021_01",
    "volume": 700,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "舊居",
    "poem": [
      "芳草又芳草，故人楊子家。",
      "青雲容易散，白日等閒斜。",
      "皓質留殘雪，香魂逐斷霞。",
      "不知何處笛，一夜叫梅花。"
    ]
  },
  {
    "uid": "QTS_700_022_01",
    "volume": 700,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "晏起",
    "poem": [
      "爾來中酒起常遲，臥看南山改舊詩。",
      "開戶日高春寂寂，數聲啼鳥上花枝。"
    ]
  },
  {
    "uid": "QTS_700_023_01",
    "volume": 700,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "幽居春思",
    "poem": [
      "綠映紅藏江上村，一聲雞犬似山源。",
      "閉門盡日無人到，翠羽春禽滿樹喧。"
    ]
  },
  {
    "uid": "QTS_700_024_01",
    "volume": 700,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "思歸引",
    "poem": [
      "越鳥南翔雁北飛，兩鄉雲路各言歸。",
      "如何我是飄飄者，獨向江頭戀釣磯。"
    ]
  },
  {
    "uid": "QTS_700_025_01",
    "volume": 700,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "與小女",
    "poem": [
      "見人初解語嘔啞，不肯歸眠戀小車。",
      "一夜嬌啼緣底事，為嫌衣少縷金華。"
    ]
  },
  {
    "uid": "QTS_700_026_01",
    "volume": 700,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "虎跡",
    "poem": [
      "白額頻頻夜到門，水邊蹤跡漸成羣。",
      "我今避世棲巖穴，巖穴如何又見君。"
    ]
  },
  {
    "uid": "QTS_700_027_01",
    "volume": 700,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "買酒不得",
    "poem": [
      "停尊待爾怪來遲，手挈空缾毷氉歸。",
      "滿面春愁消不得，更看溪鷺寂寥飛。"
    ]
  },
  {
    "uid": "QTS_700_028_01",
    "volume": 700,
    "author": {
