      "wikidata_id": "Q1291502"
    },
    "title": "姬人養蠶",
    "poem": [
      "昔年愛笑蠶家婦，今日辛勤自養蠶。",
      "仍道不愁羅與綺，女郎初解織桑籃。"
    ]
  },
  {
    "uid": "QTS_700_004_01",
    "volume": 700,
    "author": {
      "canonical": "韋莊",
      "recorded": "韋莊",
      "gender": "male",
      "period": "Late Tang",
      "english_name": "Wei Zhuang",
      "wikidata_id": "Q1291502"
    },
    "title": "長干塘別徐茂才",
    "poem": [
      "亂離時節別離輕，別酒應須滿滿傾。",
      "纔喜相逢又相送，有情爭得似無情。"
    ]
  },
  {
    "uid": "QTS_700_005_01",
    "volume": 700,
    "author": {
