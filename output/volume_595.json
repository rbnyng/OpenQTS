[
  {
    "uid": "QTS_595_001_01",
    "volume": 595,
    "author": {
      "canonical": "于武陵",
      "recorded": "于武陵"
    },
    "title": "早春山行",
    "poem": [
      "江草暖初綠，雁行皆北飛。",
      "異鄉那久客，野鳥尚思歸。",
      "十載過如夢，素心應已違。",
      "行行家漸遠，更苦得書稀。"
    ]
  },
  {
    "uid": "QTS_595_002_01",
    "volume": 595,
    "author": {
      "canonical": "于武陵",
      "recorded": "于武陵"
    },
    "title": "宿友生林居因懷賈區",
    "poem": [
      "繞屋樹森森，多棲紫閣禽。",
      "暫過當永夜，微得話前心。",
      "入楚行應遠，經湘恨必深。",
      "那堪對寒燭，更賦別離吟。"
    ]
  },
  {
    "uid": "QTS_595_003_01",
    "volume": 595,
    "author": {
      "canonical": "于武陵",
      "recorded": "于武陵"
    },
    "title": "贈賣松人",
    "poem": [
      "入市雖求利，憐君意獨真。",
      "劚將寒澗樹，賣與翠樓人。",
      "瘦葉幾經雪，淡花應少春。",
      "長安重桃李，徒染六街塵。"
    ],
    "variants": [
      {
