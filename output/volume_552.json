[
  {
    "uid": "QTS_552_001_01",
    "volume": 552,
    "author": {
      "canonical": "丁棱",
      "recorded": "丁棱"
    },
    "title": "塞下曲",
    "poem": [
      "北風鳴晚角，雨雪塞雲低。",
      "烽舉戰軍動，天寒征馬嘶。",
      "出營紅旆展，過磧暗沙迷。",
      "諸將年皆老，何時罷鼓鼙。"
    ]
  },
  {
    "uid": "QTS_552_002_01",
    "volume": 552,
    "author": {
      "canonical": "丁棱",
      "recorded": "丁棱"
    },
    "title": "和主司王起",
    "poem": [
      "公心獨立副天心，三轄春闈冠古今。",
      "蘭署門生皆入室，蓮峰太守別知音。",
      "同升翰苑時名重，遍歷朝端主意深。",
      "新有受恩江海客，坐聽朝夕繼為霖。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "升",
        "variant": "飛",
        "source": "一作「飛」"
      }
    ]
  },
  {
    "uid": "QTS_552_003_01",
    "volume": 552,
    "author": {
      "canonical": "高退之",
      "recorded": "高退之"
    },
    "title": "和主司王起",
    "poem": [
      "昔年桃李已滋榮，今日蘭蓀又發生。",
      "葑菲采時皆有道，權衡分處且無情。",
      "叨陪鴛鷺朝天客，共作門闌出谷鸎。",
      "何事感恩偏覺重，忽聞金榜扣柴荊。"
    ]
  },
  {
    "uid": "QTS_552_004_01",
    "volume": 552,
    "author": {
      "canonical": "孟球",
      "recorded": "孟球"
    },
    "title": "和主司王起",
    "poem": [
      "當年門下化龍成，今日餘波進後生。",
      "仙籍共知推麗藻，禁垣同得薦嘉名。",
      "桃蹊早茂誇新萼，菊圃初開耀晚英。",
      "誰料羽毛方出谷，許教齊和九皋嗚。"
    ],
    "variants": [
      {
