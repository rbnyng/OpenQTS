  {
    "uid": "QTS_865_022_01",
    "volume": 865,
    "author": {
      "canonical": "商山三丈夫",
      "recorded": "商山三丈夫"
    },
    "title": "天明聯句",
    "poem": [
      "幽樹高高影，",
      "山花寂寂香。",
      "山天遙歷歷，",
      "山水急湯湯。"
    ],
    "notes": [
