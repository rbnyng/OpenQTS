[
  {
    "uid": "QTS_865_001_01",
    "volume": 865,
    "author": {
      "canonical": "慕容垂",
      "recorded": "慕容垂"
    },
    "title": "塚上答太宗",
    "poem": [
      "我昔勝君昔，君今勝我今。",
      "榮華各異代，何用苦追尋。"
    ]
  },
  {
    "uid": "QTS_865_002_01",
    "volume": 865,
    "author": {
      "canonical": "釋明解",
      "recorded": "釋明解",
      "gender": "male"
    },
    "title": "遺畫工詩",
    "poem": [
      "握手不能別，撫膺聊自傷。",
      "痛矣時陰短，悲哉泉路長。",
      "松林驚野吹，荒隧落寒霜。",
      "言離何以贈，留心內典章。"
    ]
  },
  {
    "uid": "QTS_865_003_01",
    "volume": 865,
    "author": {
      "canonical": "巴峽鬼",
      "recorded": "巴峽鬼"
    },
    "title": "夜吟",
    "poem": [
      "秋徑填黃葉，寒摧露草根。",
      "猿聲一叫斷，客淚數重痕。"
    ]
  },
  {
    "uid": "QTS_865_004_01",
    "volume": 865,
    "author": {
      "canonical": "河湄鬼",
      "recorded": "河湄鬼"
    },
    "title": "愧謝詩",
    "poem": [
      "我本邯鄲士，祇役死河湄。",
      "不得家人哭，勞君行路悲。"
    ]
  },
  {
    "uid": "QTS_865_005_01",
    "volume": 865,
    "author": {
      "canonical": "介冑鬼",
      "recorded": "介冑鬼"
    },
    "title": "擲裴武公詩",
    "poem": [
      "屢策羸驂曆亂峋，叢嵐映日晝如曛。",
      "長橋駕險浮天漢，危棧通岐觸岫雲。",
      "卻念淮陰空得計，又嗟忠武不堪聞。",
      "廢興盡系前生數，休衒英雄勇冠軍。"
    ]
  },
  {
    "uid": "QTS_865_006_01",
    "volume": 865,
    "author": {
      "canonical": "李叔霽",
      "recorded": "李叔霽"
    },
    "title": "死後詩",
    "poem": [
      "忽作無期別，沈冥恨有餘。",
      "長安雖不遠，無信可傳書。"
    ]
  },
  {
    "uid": "QTS_865_007_01",
    "volume": 865,
    "author": {
      "canonical": "竇裕",
      "recorded": "竇裕"
    },
    "title": "洋州館夜吟",
    "poem": [
      "門依楚水岸，身寄洋州館。",
      "望月獨相思，塵襟淚痕滿。"
    ]
  },
  {
    "uid": "QTS_865_008_01",
    "volume": 865,
    "author": {
      "canonical": "書生",
      "recorded": "書生"
    },
    "title": "獻元載",
    "poem": [
      "城東城西舊居處，城裏飛花亂如絮。",
      "海燕銜泥欲下來，屋裏無人卻飛去。"
    ]
  },
  {
    "uid": "QTS_865_009_01",
    "volume": 865,
    "author": {
      "canonical": "虎丘山石壁鬼",
      "recorded": "虎丘山石壁鬼"
    },
    "title": "詩二首 其一",
    "poem": [
      "高松多悲風，蕭蕭清且哀。",
      "南山接幽壟，幽壟空崔嵬。",
      "白日徒昭昭，不照長夜台。",
      "雖知生者樂，魂魄安能回。",
      "況複念所親，慟哭心肝摧。",
      "慟哭更何言，哀哉複哀哉。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_865_009_02",
    "volume": 865,
    "author": {
      "canonical": "虎丘山石壁鬼",
      "recorded": "虎丘山石壁鬼"
    },
    "title": "詩二首 其二",
    "poem": [
      "神仙不可學，形化空遊魂。",
      "白日非我朝，青松為我門。",
      "雖複隔幽顯，猶知念子孫。",
      "何以遣悲惋，萬物歸其根。",
      "寄語世上人，莫厭臨芳尊。",
      "莊生問枯骨，三樂成虛言。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_865_010_01",
    "volume": 865,
    "author": {
      "canonical": "虎丘山石壁鬼",
      "recorded": "虎丘山石壁鬼"
    },
    "title": "祭後見石上詩",
    "poem": [
      "幽明雖異路，平昔忝攻文。",
      "欲知潛昧處，山北兩孤墳。"
    ]
  },
  {
    "uid": "QTS_865_011_01",
    "volume": 865,
    "author": {
      "canonical": "陸憑",
      "recorded": "陸憑"
    },
    "title": "詠浮雲",
    "poem": [
      "虛虛複空空，瞬息天地中。",
      "假合成此像，吾亦非吾躬。"
    ]
  },
  {
    "uid": "QTS_865_012_01",
    "volume": 865,
    "author": {
      "canonical": "韓弇",
      "recorded": "韓弇"
    },
    "title": "呈李續",
    "poem": [
      "我有敵國讎，無人可為雪。",
      "每至秦隴頭，遊魂自嗚咽。"
    ]
  },
  {
    "uid": "QTS_865_013_01",
    "volume": 865,
    "author": {
      "canonical": "尉陀",
      "recorded": "尉陀"
    },
    "title": "和崔侍禦",
    "poem": [
      "千歲荒台隳路隅，一煩太守重椒塗。",
      "感君拂拭意何極，贈爾美婦與明珠。"
    ]
  },
  {
    "uid": "QTS_865_014_01",
    "volume": 865,
    "author": {
      "canonical": "劉溉",
      "recorded": "劉溉"
    },
    "title": "贈竇丞",
    "poem": [
      "冥路杳杳人不知，不用苦說使人悲。",
      "喜得逢君傳家信，後會茫茫何處期。"
    ]
  },
  {
    "uid": "QTS_865_015_01",
    "volume": 865,
    "author": {
      "canonical": "鄭瓊羅",
      "recorded": "鄭瓊羅"
    },
    "title": "敘幽冤",
    "poem": [
      "痛填心兮不能語，寸斷腸兮訴何處。",
      "春生萬物妾不生，更恨香魂不相遇。"
    ]
  },
  {
    "uid": "QTS_865_016_01",
    "volume": 865,
    "author": {
      "canonical": "瀋青箱",
      "recorded": "瀋青箱"
    },
    "title": "過台城感舊",
    "poem": [
      "六代舊山川，興亡幾百年。",
      "繁華今寂寞，朝市昔喧闐。",
      "夜月琉璃水，春風卵色天。",
      "傷時與懷古，垂淚國門前。"
    ]
  },
  {
    "uid": "QTS_865_017_01",
    "volume": 865,
    "author": {
      "canonical": "襄陽旅殯舉人",
      "recorded": "襄陽旅殯舉人",
      "gender": "male"
    },
    "title": "詩",
    "poem": [
      "流水涓涓芹努芽，織烏西飛客還家。",
      "荒村無人作寒食，殯宮空對棠梨花。"
    ]
  },
  {
    "uid": "QTS_865_018_01",
    "volume": 865,
    "author": {
      "canonical": "河中鬼",
      "recorded": "河中鬼"
    },
    "title": "踏歌",
    "poem": [
      "河水流溷溷，山頭種蕎麥。",
      "兩個胡孫門底來，東家阿嫂決一百。"
    ]
  },
  {
    "uid": "QTS_865_019_01",
    "volume": 865,
    "author": {
      "canonical": "蕭微",
      "recorded": "蕭微"
    },
    "title": "題少陵別墅",
    "poem": [
      "新構茅齋野澗東，松楸交影足悲風。",
      "人間歲月如流水，何事頻行此路中。"
    ]
  },
  {
    "uid": "QTS_865_020_01",
    "volume": 865,
    "author": {
      "canonical": "張省躬",
      "recorded": "張省躬",
      "gender": "male",
      "wikidata_id": "Q18905278"
    },
    "title": "夢張垂贈詩",
    "poem": [
      "戚戚複戚戚，秋堂百年色。",
      "而我獨茫茫，荒郊遇寒食。"
    ]
  },
  {
    "uid": "QTS_865_021_01",
    "volume": 865,
    "author": {
      "canonical": "商山三丈夫",
      "recorded": "商山三丈夫"
    },
    "title": "秋月聯句",
    "poem": [
      "秋月圓如鏡，",
      "秋風利似刀。",
      "秋雲輕比絮，",
      "秋草細如毛。"
    ],
