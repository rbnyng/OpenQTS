      }
    ]
  },
  {
    "uid": "QTS_811_007_01",
    "volume": 811,
    "author": {
      "canonical": "護國",
      "recorded": "護國",
      "gender": "male"
    },
    "title": "愴故人舊居",
    "poem": [
      "惆悵至日暮，寒鴉啼樹林。",
      "破階苔色厚，殘壁雨痕深。",
      "命與時不遇，福為禍所侵。",
      "空餘行逕在，令我歎人吟。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "啼",
        "variant": "青",
        "source": "一作「青」"
      },
      {
        "line": 4,
        "text": "行",
        "variant": "竹",
        "source": "一作「竹」"
      }
    ]
  },
  {
    "uid": "QTS_811_008_01",
    "volume": 811,
    "author": {
      "canonical": "護國",
      "recorded": "護國",
      "gender": "male"
    },
    "title": "逢靈道士",
    "poem": [
      "浮丘山上見黃冠，松柏森森登古壇。",
      "一莖青竹以為杖，數顆仙桃仍未餐。",
      "長安市里仍賣卜，武陵溪畔每燒丹。",
      "縮地往來無定所，花源到處路漫漫。"
    ]
  },
  {
    "uid": "QTS_811_009_01",
    "volume": 811,
    "author": {
      "canonical": "護國",
      "recorded": "護國",
      "gender": "male"
    },
    "title": "別盛安",
    "poem": [
      "情人取次幾淹留，別後南州與北州。",
      "月色為憐今夜客，砧聲那似去年秋。",
      "欲除豺虎論三略，莫對雲山詠四愁。",
      "親故相逢且借問，古來無種是王侯。"
    ]
  },
  {
    "uid": "QTS_811_010_01",
    "volume": 811,
    "author": {
      "canonical": "護國",
      "recorded": "護國",
      "gender": "male"
    },
    "title": "傷蔡處士",
    "poem": [
      "篋中遺草是琅玕，對此空令灑淚看。",
      "三徑尚餘行跡在，數螢猶是映書殘。",
      "晨光不借泉門曉，暝色唯添隴樹寒。",
      "欲問皇天天更遠，有才無命說應難。"
    ]
  },
  {
    "uid": "QTS_811_011_01",
    "volume": 811,
    "author": {
      "canonical": "護國",
      "recorded": "護國",
      "gender": "male"
    },
    "title": "臨川道中",
    "poem": [
      "出谷入谷路回轉，秋風已至歸期晚。",
      "舉頭何處望來蹤，萬仞千山鳥飛遠。"
    ]
  },
  {
    "uid": "QTS_811_012_01",
    "volume": 811,
    "author": {
      "canonical": "護國",
      "recorded": "護國",
      "gender": "male"
    },
    "title": "贈張駙馬斑竹柱杖",
    "poem": [
      "此君與我在雲溪，勁節奇文勝杖藜。",
      "為有歲寒堪贈遠，玉階行處願提攜。"
    ]
  },
  {
    "uid": "QTS_811_013_01",
    "volume": 811,
    "author": {
      "canonical": "法振",
      "recorded": "法振",
      "gender": "male"
    },
    "title": "病癒寄友",
    "poem": [
      "哀樂暗成疾，臥中芳月移。",
      "西山有清士，孤嘯不可追。",
      "擣藥晝林靜，汲泉陰澗遲。",
      "微蹤與麋鹿，遠謝求羊知。"
    ]
  },
  {
    "uid": "QTS_811_014_01",
    "volume": 811,
    "author": {
      "canonical": "法振",
      "recorded": "法振",
      "gender": "male"
    },
    "title": "程評事西園之作",
    "poem": [
      "誰向春鶯道，名園已共知。",
      "簷前迴水影，城上出花枝。",
      "搖拂煙雲動，登臨翰墨隨。",
      "相招能不厭，山舍為君移。"
    ]
  },
  {
    "uid": "QTS_811_015_01",
    "volume": 811,
    "author": {
      "canonical": "法振",
      "recorded": "法振",
      "gender": "male"
    },
    "title": "陳九溪中草堂",
    "poem": [
      "溪草落濺濺，魚飛入稻田。",
      "早寒臨洞月，輕素捲簾煙。",
      "�幘題新句，蓑衣象古賢。",
      "曙花閑秀色，三十六峰前。"
    ]
  },
  {
    "uid": "QTS_811_016_01",
    "volume": 811,
    "author": {
      "canonical": "法振",
      "recorded": "法振",
      "gender": "male"
    },
    "title": "題天長阮少府湖上客歸",
    "poem": [
      "孤櫂移官舍，新農寄楚田。",
      "晴林渡海日，春草長湖煙。",
      "臥對閒鷗戲，談經稚子賢。",
      "佳期更何許，應向嘯臺前。"
    ]
  },
  {
    "uid": "QTS_811_017_01",
    "volume": 811,
    "author": {
      "canonical": "法振",
      "recorded": "法振",
      "gender": "male"
    },
    "title": "題萬山許煉師",
    "poem": [
      "道成人不識，流水響空山。",
      "花暗軒窓外，雲隨坐臥間。",
      "驗圖名已久，絕粒事長閑。",
      "更欲崑崙去，羞看絳節還。"
    ]
  },
  {
    "uid": "QTS_811_018_01",
    "volume": 811,
    "author": {
      "canonical": "法振",
      "recorded": "法振",
      "gender": "male"
    },
    "title": "河源破賊後贈袁將軍",
    "poem": [
      "白羽三千駐，蕭蕭萬里行。",
      "出關深漢壘，帶月破蕃營。",
      "蔓草河原色，悲笳碎葉聲。",
      "欲朝王母殿，前路駐高旌。"
    ]
  },
  {
    "uid": "QTS_811_019_01",
    "volume": 811,
    "author": {
      "canonical": "法振",
      "recorded": "法振",
      "gender": "male"
    },
    "title": "越中贈程先生",
    "poem": [
      "紗帽度殘春，虛舟寄一身。",
      "溪邊逢越女，花裏問秦人。",
      "古塞連山靜，陰霞落海新。",
      "有時城郭去，暗與酒家親。"
    ]
  },
  {
    "uid": "QTS_811_020_01",
    "volume": 811,
    "author": {
      "canonical": "法振",
      "recorded": "法振",
      "gender": "male"
    },
    "title": "送常大夫赴朔方",
    "poem": [
      "關山今不掩，軍候鳥先知。",
      "大漢嫖姚入，烏孫部曲隨。",
      "高旌天外駐，寒角月中吹。",
      "歸到長安第，花應再滿枝。"
    ]
  },
  {
    "uid": "QTS_811_021_01",
    "volume": 811,
    "author": {
      "canonical": "法振",
      "recorded": "法振",
      "gender": "male"
    },
    "title": "送人遊閩越",
    "poem": [
      "不須行借問，為爾話閩中。",
      "海島陰晴日，江帆來去風。",
      "道游玄度宅，身寄朗陵公。",
      "此別何傷遠，如今關塞通。"
    ]
  },
  {
    "uid": "QTS_811_022_01",
    "volume": 811,
    "author": {
      "canonical": "法振",
      "recorded": "法振",
      "gender": "male"
    },
    "title": "送褚先生海上尋封煉師",
    "poem": [
      "潮落風初定，天吳避客舟。",
      "近承三殿旨，欲向五湖遊。",
      "不厭烏皮幾，新縫鶴氅裘。",
      "明珠漂斷岸，陰火映中流。",
      "華蓋芝童引，神丹桂女收。",
      "懸知居縹緲，因為識浮丘。"
    ]
  },
  {
    "uid": "QTS_811_023_01",
    "volume": 811,
    "author": {
      "canonical": "法振",
      "recorded": "法振",
      "gender": "male"
    },
    "title": "送韓侍御自使幕巡海北",
    "poem": [
      "微雨空山夜洗兵，繡衣朝拂海雲清。",
      "幕中運策心應苦，馬上吟詩卷已成。",
      "離亭不惜花源醉，古道猶看蔓草生。",
      "因說元戎能破敵，高歌一曲隴關情。"
    ]
  },
  {
    "uid": "QTS_811_024_01",
    "volume": 811,
    "author": {
      "canonical": "法振",
      "recorded": "法振",
      "gender": "male"
    },
    "title": "張舍人南谿別業",
    "poem": [
      "新田繞屋半春耕，藜杖閑門引客行。",
      "山翠自成微雨色，溪花不隱亂泉聲。",
      "漁家遠到堪留興，公府懸知欲厭名。",
      "入夜更宜明月滿，雙童喚出解吹笙。"
    ]
  },
  {
    "uid": "QTS_811_025_01",
    "volume": 811,
    "author": {
      "canonical": "法振",
      "recorded": "法振",
      "gender": "male"
    },
    "title": "別盧使君歸故柵村",
    "poem": [
      "歸風白馬引嘶聲，落日猶看楚客情。",
      "塞口竹緣空戍沒，潮頭沙擁慢岡成。",
      "松田且欲親耕種，郡守何偏問姓名。",
      "東道宿程投故柵，依依漁父解相迎。"
    ]
  },
  {
    "uid": "QTS_811_026_01",
    "volume": 811,
    "author": {
      "canonical": "法振",
      "recorded": "法振",
      "gender": "male"
    },
    "title": "丹陽浦送客之海上",
    "poem": [
      "不到終南向幾秋，移居更欲近滄洲。",
      "風吹雨色連村暗，潮擁菱花出岸浮。",
      "漠漠望中春自豔，寥寥泊處夜堪愁。",
      "如君豈得空高枕，只益天書遣遠求。"
    ]
  },
  {
    "uid": "QTS_811_027_01",
    "volume": 811,
    "author": {
      "canonical": "法振",
      "recorded": "法振",
      "gender": "male"
    },
    "title": "月夜泛舟",
    "poem": [
      "西塞長雲盡，南湖片月斜。",
      "漾舟人不見，臥入武陵花。"
    ]
  },
  {
    "uid": "QTS_811_028_01",
    "volume": 811,
    "author": {
      "canonical": "法振",
      "recorded": "法振",
      "gender": "male"
    },
    "title": "送友人之上都",
    "poem": [
      "玉帛徵賢楚客稀，猨啼相送武陵歸。",
      "湖頭望入桃花去，一片春帆帶雨飛。"
    ]
  },
  {
    "uid": "QTS_811_029_01",
    "volume": 811,
    "author": {
      "canonical": "法振",
      "recorded": "法振",
      "gender": "male"
    },
    "title": "句",
    "poem": [
      "畫鼓催來錦臂襄，小娥雙起整霓裳。"
    ],
    "notes": [
      {
        "line": 2,
        "content": "《柘枝》，《韻語陽秋》。",
        "context": "句"
      }
    ]
  }
