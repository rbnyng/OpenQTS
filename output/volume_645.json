      "recorded": "李咸用",
      "gender": "male",
      "english_name": "Li Xianyong",
      "wikidata_id": "Q10333221"
    },
    "title": "江行",
    "poem": [
      "瀟湘無事後，征棹復嘔啞。",
      "高岫留斜照，歸鴻背落霞。",
      "魚殘沙岸草，蝶寄洑流槎。",
      "共說干戈苦，汀洲減釣家。"
    ],
