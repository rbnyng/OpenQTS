[
  {
    "uid": "QTS_063_001_01",
    "volume": 63,
    "author": {
      "canonical": "董思恭",
      "recorded": "董思恭"
    },
    "title": "三婦豔",
    "poem": [
      "大婦裁紈素，中婦弄明璫。",
      "小婦多姿態，登樓紅粉妝。",
      "丈人且安坐，初日漸流光。"
    ]
  },
  {
    "uid": "QTS_063_002_01",
    "volume": 63,
    "author": {
      "canonical": "董思恭",
      "recorded": "董思恭"
    },
    "title": "感懷",
    "poem": [
      "野郊愴新別，河橋非舊餞。",
      "慘日映峰沈，愁雲隨蓋轉。",
      "哀笳時斷續，悲旌乍舒捲。",
      "望望情何極，浪浪淚空泫。",
      "無復昔時人，芳春共誰遣。"
    ]
  },
  {
    "uid": "QTS_063_003_01",
    "volume": 63,
    "author": {
      "canonical": "董思恭",
      "recorded": "董思恭"
    },
    "title": "守歲二首 其一",
    "poem": [
      "暮景斜芳殿，年華麗綺宮。",
      "寒辭去冬雪，暖帶入春風。",
      "階馥舒梅素，盤花卷燭紅。",
      "共歡新故歲，迎送一宵中。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_063_003_02",
    "volume": 63,
    "author": {
      "canonical": "董思恭",
      "recorded": "董思恭"
    },
    "title": "守歲二首 其二",
    "poem": [
      "歲陰窮暮紀，獻節啓新芳。",
      "冬盡今宵促，年開明日長。",
      "冰銷出鏡水，梅散入風香。",
      "對此歡終宴，傾壺待曙光。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_063_004_01",
    "volume": 63,
    "author": {
      "canonical": "董思恭",
      "recorded": "董思恭"
    },
    "title": "昭君怨二首 其一",
    "poem": [
      "新年猶尚小，那堪遠聘秦。",
      "裾衫霑馬汗，眉黛染胡塵。",
      "舉眼無相識，路逢皆異人。",
      "唯有梅將李，猶帶故鄉春。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_063_004_02",
