      "wikidata_id": "Q11070999"
    },
    "title": "又絕句寄題毗陵驛",
    "poem": [
      "曾持使節駐毗陵，長與州人有舊情。",
      "為向驛橋風月道，舍人髭鬢白千莖。"
    ]
  },
  {
    "uid": "QTS_756_019_01",
    "volume": 756,
    "author": {
      "canonical": "徐鉉",
      "recorded": "徐鉉",
      "gender": "male",
      "period": "Five Dynasties / Song",
      "english_name": "Xu Xuan",
      "wikidata_id": "Q11070999"
    },
    "title": "陳侍郎宅觀花燭",
    "poem": [
      "今夜銀河萬里秋，人言織女嫁牽牛。",
      "佩聲寥亮和金奏，燭影熒煌映玉鉤。",
      "座客亦從天子賜，更籌須為主人留。",
      "世間盛事君知否，朝下鸞臺夕鳳樓。"
    ]
  },
  {
    "uid": "QTS_756_020_01",
    "volume": 756,
    "author": {
      "canonical": "徐鉉",
      "recorded": "徐鉉",
      "gender": "male",
      "period": "Five Dynasties / Song",
      "english_name": "Xu Xuan",
      "wikidata_id": "Q11070999"
    },
    "title": "送蕭尚書致仕歸廬陵",
    "poem": [
      "江海分飛二十春，重論前事不堪聞。",
      "主憂臣辱誰非我，曲突徙薪唯有君。",
      "金紫滿身皆外物，雪霜垂領便離群。",
      "鶴歸華表望不盡，玉笥山頭多白雲。"
    ]
  },
  {
    "uid": "QTS_756_021_01",
    "volume": 756,
    "author": {
