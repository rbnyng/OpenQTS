    "title": "兵馬曹季良宅夜集",
    "poem": [
      "清景不可失，尋君趣有餘。",
      "身高避事後，道長問心初。",
      "出處名則異，游從跡何疎。",
      "吟看刻盡燭，笑卷讀殘書。",
      "露彩生筆硯，風音入庭除。",
      "平明仙侶散，觳觫動迴車。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "後",
        "variant": "外",
        "source": "一作「外」"
      }
    ]
