[
  {
    "uid": "QTS_861_001_01",
    "volume": 861,
    "author": {
      "canonical": "馬湘",
      "recorded": "馬湘",
      "gender": "male"
    },
    "title": "登杭州秦望山",
    "poem": [
      "太乙初分何處尋，空留歷數變人心。",
      "九天日月移朝暮，萬里山川換古今。",
      "風動水光吞遠嶠，雨添嵐氣沒高林。",
      "秦皇謾作驅山計，滄海茫茫轉更深。"
    ]
  },
  {
    "uid": "QTS_861_002_01",
    "volume": 861,
    "author": {
      "canonical": "馬湘",
      "recorded": "馬湘",
      "gender": "male"
    },
    "title": "題龍興觀壁",
    "poem": [
      "世有無窮事，生知遂百春。",
      "問程方外路，宜是上清人。"
    ]
  },
  {
    "uid": "QTS_861_003_01",
    "volume": 861,
    "author": {
      "canonical": "馬湘",
      "recorded": "馬湘",
      "gender": "male"
    },
    "title": "又詩一首",
    "poem": [
      "昔日曾隨魏伯陽，無端醉臥紫金床。",
      "東君謂我多情賴，罰向人間作酒狂。"
    ]
  },
  {
    "uid": "QTS_861_004_01",
    "volume": 861,
    "author": {
      "canonical": "馬湘",
      "recorded": "馬湘",
      "gender": "male"
    },
    "title": "又詩二首 其一",
    "poem": [
      "省悟前非一息間，更拋閒事棄塵寰。",
      "徒誇美酒如瓊液，休戀嬌娥似玉顏。",
      "含笑謾教情面厚，多愁還使鬢毛斑。",
      "雲中幸有堪歸路，無限青山是我山。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_861_004_02",
    "volume": 861,
    "author": {
      "canonical": "馬湘",
      "recorded": "馬湘",
      "gender": "male"
    },
    "title": "又詩二首 其二",
    "poem": [
      "何用燒丹學駐顏，鬧非城市靜非山。",
      "時人若覓長生藥，對景無心是大還。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_861_005_01",
    "volume": 861,
    "author": {
      "canonical": "張辭",
      "recorded": "張辭",
      "gender": "male"
    },
    "title": "題壁",
    "poem": [
      "爭那金烏何，頭上飛不住。",
      "紅爐漫燒藥，玉顏安可駐。",
      "今年花發枝，明年葉落樹。",
      "不如且飲酒，莫管流年度。"
    ]
  },
  {
    "uid": "QTS_861_006_01",
    "volume": 861,
    "author": {
      "canonical": "張辭",
      "recorded": "張辭",
      "gender": "male"
    },
    "title": "上鹽城令述德詩",
    "poem": [
      "門風常有蕙蘭馨，鼎族家傳霸國名。",
      "容貌靜懸秋月彩，文章高振海濤聲。",
      "訟堂無事調琴軫，郡閣何妨醉玉觥。",
      "今日東漸橋下水，一條從此鎮常清。"
    ]
  },
  {
    "uid": "QTS_861_007_01",
    "volume": 861,
    "author": {
      "canonical": "張辭",
      "recorded": "張辭",
      "gender": "male"
    },
    "title": "謝令學道詩",
    "poem": [
      "何用梯媒向外求，長生只合內中修。",
      "莫言大道人難得，自是行心不到頭。"
    ]
  },
  {
    "uid": "QTS_861_008_01",
    "volume": 861,
    "author": {
      "canonical": "張辭",
      "recorded": "張辭",
      "gender": "male"
    },
    "title": "別令詩",
    "poem": [
      "張辭張辭自不會，天下經書在腹內。",
      "身即騰騰處世間，心即逍遙出天外。"
    ]
  },
  {
    "uid": "QTS_861_009_01",
    "volume": 861,
    "author": {
      "canonical": "陸禹臣",
      "recorded": "陸禹臣",
      "gender": "male"
    },
    "title": "贈吳生",
    "poem": [
      "露下瑤簪濕，雲生石室寒。",
      "星壇鸞鶴舞，丹灶虎龍蟠。"
    ]
  },
  {
    "uid": "QTS_861_010_01",
    "volume": 861,
    "author": {
      "canonical": "李真",
      "recorded": "李真",
      "gender": "male"
    },
    "title": "丈人山詩",
    "poem": [
      "春凍曉韉露重，夜寒幽枕雲生。",
      "豈是與山無素，丈人著帽相迎。"
    ]
  },
  {
    "uid": "QTS_861_011_01",
    "volume": 861,
    "author": {
      "canonical": "殷七七",
      "recorded": "殷七七",
      "gender": "male"
    },
    "title": "醉歌",
    "poem": [
      "琴彈碧玉調，藥煉白硃砂。",
      "解醞頃刻酒，能開非時花。"
    ]
  },
  {
    "uid": "QTS_861_012_01",
    "volume": 861,
    "author": {
      "canonical": "殷七七",
      "recorded": "殷七七",
      "gender": "male"
    },
    "title": "陽春曲",
    "poem": [
      "愁見唱陽春，令人離腸結。",
      "郎去未歸家，柳自飄香雪。"
    ]
  },
  {
    "uid": "QTS_861_013_01",
    "volume": 861,
    "author": {
      "canonical": "張令問",
      "recorded": "張令問",
      "gender": "male"
    },
    "title": "寄杜光庭",
    "poem": [
      "試問朝中為宰相，何如林下作神仙。",
      "一壺美酒一爐藥，飽聽松風清晝眠。"
    ]
  },
  {
    "uid": "QTS_861_014_01",
    "volume": 861,
    "author": {
      "canonical": "吳涵虛",
      "recorded": "吳涵虛",
      "gender": "male"
    },
    "title": "上升歌",
    "poem": [
      "玉皇有詔登仙職，龍吐雲兮鳳著力。",
      "眼前驀地見樓臺，異草奇花不可識。",
      "我向大羅觀世界，世界即如指掌大。",
      "當時不為上升忙，一時提向瀛洲賣。"
    ]
  },
  {
    "uid": "QTS_861_015_01",
    "volume": 861,
    "author": {
      "canonical": "李夢符",
      "recorded": "李夢符",
      "gender": "male"
    },
    "title": "答常學士",
    "poem": [
      "罷修儒業罷修真，養拙藏愚春複春。",
      "到老不疏林裏鹿，平生難見日邊人。",
      "洞桃深處千林錦，岩雪鋪時萬草新。",
      "深謝名賢遠相訪，求聞難博鳳為鄰。"
    ]
  },
  {
    "uid": "QTS_861_016_01",
    "volume": 861,
    "author": {
      "canonical": "李夢符",
      "recorded": "李夢符",
      "gender": "male"
    },
    "title": "漁父引二首 其一",
    "poem": [
      "村寺鐘聲度遠灘，半輪殘月落山前。",
      "徐徐撥棹卻歸灣，浪疊朝霞錦繡翻。"
    ],
    "part_index": 1,
    "total_parts": 2
  },
  {
    "uid": "QTS_861_016_02",
    "volume": 861,
    "author": {
      "canonical": "李夢符",
      "recorded": "李夢符",
      "gender": "male"
    },
    "title": "漁父引二首 其二",
    "poem": [
      "漁弟漁兄喜到來，波官賽卻坐江隈。",
      "椰榆杓子木瘤杯，爛煮鱸魚滿案堆。"
    ],
    "part_index": 2,
    "total_parts": 2
  },
  {
    "uid": "QTS_861_017_01",
    "volume": 861,
    "author": {
      "canonical": "李夢符",
      "recorded": "李夢符",
      "gender": "male"
    },
    "title": "察考取狀答",
    "poem": [
      "插花飲酒何妨事，樵唱漁歌不礙時。"
    ]
  },
  {
    "uid": "QTS_861_018_01",
    "volume": 861,
    "author": {
      "canonical": "沈廷瑞",
      "recorded": "沈廷瑞",
      "gender": "male"
    },
    "title": "答高安宰",
    "poem": [
      "何須問我道成時，紫府清都自有期。",
      "手握藥苗人不識，體含金骨俗爭知。"
    ]
  },
  {
    "uid": "QTS_861_019_01",
    "volume": 861,
    "author": {
      "canonical": "沈廷瑞",
      "recorded": "沈廷瑞",
      "gender": "male"
    },
    "title": "贈僧昭瑩",
    "poem": [
      "南北東西路，人生會不無。",
      "早曾依閣皂，又卻上玄都。",
      "雲片隨天闊，泉聲落石孤。",
      "何期早相遇，樂共煮菖蒲。"
    ]
  },
  {
    "uid": "QTS_861_020_01",
    "volume": 861,
    "author": {
      "canonical": "沈廷瑞",
      "recorded": "沈廷瑞",
      "gender": "male"
    },
    "title": "寄袁州陳智周",
    "poem": [
      "名山相別後，別後會難期。",
      "金鼎銷紅日，丹田老紫芝。",
      "訪君雖有路，懷我豈無詩。",
      "休羨繁華事，百年能幾時。"
    ]
  },
  {
    "uid": "QTS_861_021_01",
    "volume": 861,
    "author": {
      "canonical": "沈廷瑞",
      "recorded": "沈廷瑞",
      "gender": "male"
    },
    "title": "壟穴遺詩",
    "poem": [
      "虛勞營殯玉山前，殯後那知已脫蟬。",
      "應是元神歸洞府，更與遺魄在黃泉。",
      "靈台已得修真訣，塵世空留悟道篇。",
      "堪歎浮生今古事，北邙山下草芊芊。"
    ]
  },
  {
    "uid": "QTS_861_022_01",
    "volume": 861,
    "author": {
      "canonical": "譚峭",
      "recorded": "譚峭",
      "gender": "male",
      "period": "Five Dynasties / Song",
      "english_name": "Qiao Tan",
      "wikidata_id": "Q15941462"
    },
    "title": "大言詩",
    "poem": [
      "線作長江扇作天，靸鞋拋向海東邊。",
      "蓬萊通道無多路，只在譚生拄杖前。"
    ]
  },
  {
    "uid": "QTS_861_023_01",
    "volume": 861,
    "author": {
      "canonical": "譚峭",
      "recorded": "譚峭",
      "gender": "male",
      "period": "Five Dynasties / Song",
      "english_name": "Qiao Tan",
      "wikidata_id": "Q15941462"
    },
    "title": "句",
    "poem": [
      "雲外星霜如走電，世間娛樂似拋磚。"
    ]
  },
  {
    "uid": "QTS_861_024_01",
    "volume": 861,
    "author": {
      "canonical": "伊用昌",
      "recorded": "伊用昌",
      "gender": "male"
    },
    "title": "望江南詞詠鼓",
    "poem": [
      "江南鼓，梭肚兩頭欒。",
      "釘著不知侵骨髓，打來只是沒心肝，空腹被人謾。"
    ]
  },
  {
    "uid": "QTS_861_025_01",
    "volume": 861,
    "author": {
      "canonical": "伊用昌",
      "recorded": "伊用昌",
      "gender": "male"
    },
    "title": "題茶陵縣門",
    "poem": [
      "茶陵一道好長街，兩畔栽柳不栽槐。",
      "夜後不聞更漏鼓，只聽錘芒織草鞋。"
    ]
  },
  {
    "uid": "QTS_861_026_01",
    "volume": 861,
    "author": {
      "canonical": "伊用昌",
      "recorded": "伊用昌",
      "gender": "male"
    },
    "title": "題酒樓壁",
    "poem": [
      "此生生在此生先，何事從玄不復玄。",
      "已在淮南雞犬後，而今便到玉皇前。"
    ]
  },
  {
    "uid": "QTS_861_027_01",
    "volume": 861,
    "author": {
      "canonical": "伊用昌",
      "recorded": "伊用昌",
      "gender": "male"
    },
    "title": "題遊帷觀真君殿後",
    "poem": [
      "日日祥雲瑞氣連，儂家應作大神仙。",
      "筆頭灑起風雷力，劍下驅馳造化權。",
      "更無戎夷添禮樂，永教胡虜絕烽煙。",
      "列仙功業只如此，直上三清第一天。"
    ]
  },
  {
    "uid": "QTS_861_028_01",
    "volume": 861,
    "author": {
      "canonical": "伊用昌",
      "recorded": "伊用昌",
      "gender": "male"
    },
    "title": "留題閣皂觀",
    "poem": [
      "花洞門前吠似雷，險聲流斷俗塵埃。",
      "雨噴山腳毒龍起，月照松梢孤鶴回。",
      "蘿幕秋高添碧翠，畫簾時卷到樓臺。",
      "兩壇詩客何年去，去後門關更不開。"
    ]
  },
  {
    "uid": "QTS_861_029_01",
    "volume": 861,
    "author": {
      "canonical": "伊用昌",
      "recorded": "伊用昌",
      "gender": "male"
    },
    "title": "湖南闖齋吟",
    "poem": [
      "誰人能識白元君，上士由來盡見聞。",
      "避世早空南火宅，植田高種北山雲。",
      "雞能抱卵心常聽，蟬到成形殼自分。",
      "學取大羅些子術，免教松下作孤墳。"
    ]
  },
  {
    "uid": "QTS_861_030_01",
    "volume": 861,
    "author": {
      "canonical": "許堅",
      "recorded": "許堅",
      "gender": "male"
    },
    "title": "游溧陽霞泉寺限白字",
    "poem": [
      "近枕吳溪與越峰，前朝恩賜雲泉額。",
      "竹林晴見雁塔高，石室曾棲幾禪伯。",
      "荒碑字沒莓苔深，古池香泛荷花白。",
      "客有經年別故林，落日啼猿情脈脈。"
    ]
  },
  {
    "uid": "QTS_861_031_01",
    "volume": 861,
    "author": {
      "canonical": "許堅",
      "recorded": "許堅",
      "gender": "male"
    },
    "title": "幽棲觀",
    "poem": [
      "仙翁上升去，丹井寄晴壑。",
      "山色接天臺，湖光照寥廓。",
      "玉洞絕無人，老檜猶棲鶴。",
      "我欲掣青蛇，他時沖碧落。"
    ]
  },
  {
    "uid": "QTS_861_032_01",
    "volume": 861,
    "author": {
      "canonical": "許堅",
      "recorded": "許堅",
      "gender": "male"
    },
    "title": "題茅山觀",
    "poem": [
      "嘗恨清風千載鬱，洞天今得恣遊遨。",
      "松楸一色古壇靜，鸞鶴不來青漢高。",
      "茅氏井寒丹已化，玄宗碑斷夢仍勞。",
      "分明有個長生路，休向紅塵歎二毛。"
    ]
  },
  {
    "uid": "QTS_861_033_01",
    "volume": 861,
    "author": {
      "canonical": "許堅",
      "recorded": "許堅",
      "gender": "male"
    },
    "title": "題扇",
    "poem": [
      "哦吟但寫胸中妙，飲酒能忘身後名。",
      "但願長閑有詩酒，一溪風月共清明。"
    ]
  },
  {
    "uid": "QTS_861_034_01",
    "volume": 861,
    "author": {
      "canonical": "許堅",
      "recorded": "許堅",
      "gender": "male"
    },
    "title": "上徐舍人鉉",
    "poem": [
      "幾宵煙月鎖樓臺，欲寄侯門薦禰才。",
      "滿面塵埃人不識，謾隨流水出山來。"
    ]
  },
  {
    "uid": "QTS_861_035_01",
    "volume": 861,
    "author": {
      "canonical": "許堅",
      "recorded": "許堅",
      "gender": "male"
    },
    "title": "句",
    "poem": [
      "道既學不得，仙從何處來。",
      "臥久似慵伸雪項，立遲猶未整霜衣。"
    ],
    "notes": [
      {
        "line": 5,
        "content": "《病鶴》，見《吟窗雜錄》",
        "context": ""
      }
    ]
  },
  {
    "uid": "QTS_861_036_01",
    "volume": 861,
    "author": {
      "canonical": "許碏",
      "recorded": "許碏",
      "gender": "male"
    },
    "title": "醉吟",
    "poem": [
      "閬苑花前是醉鄉，踏翻王母九霞觴。",
      "群仙拍手嫌輕薄，謫向人間作酒狂。"
    ]
  },
  {
    "uid": "QTS_861_037_01",
    "volume": 861,
    "author": {
      "canonical": "許碏",
      "recorded": "許碏",
      "gender": "male"
    },
    "title": "題南嶽招仙觀壁上",
    "poem": [
      "洪爐烹鍛人性命，器用不同分皆定。",
      "妖精鬼魅鬥神通，只自幹邪不幹正。",
      "黃口小兒初學行，唯知日月東西生。",
      "還為萬靈威聖力，移月在南日在北。",
      "玉為玉兮石是石，蘊棄深泥終不易。",
      "鄧通餓死嚴陵貧，帝王豈是無人力。",
      "丈夫未達莫相侵，攀龍附鳳捐精神。"
    ]
  },
  {
    "uid": "QTS_861_038_01",
    "volume": 861,
    "author": {
      "canonical": "張白",
      "recorded": "張白",
      "gender": "male"
    },
    "title": "武陵春色",
    "poem": [
      "武陵春色好，十二酒家樓。",
      "大醉方回首，逢人不舉頭。",
      "是非都不採，名利混然休。",
      "戴個星冠子，浮沈逐世流。"
    ]
  },
  {
    "uid": "QTS_861_039_01",
    "volume": 861,
    "author": {
      "canonical": "張白",
      "recorded": "張白",
      "gender": "male"
    },
    "title": "贈酒店崔氏",
    "poem": [
      "武陵城裏崔家酒，地上應無天上有。",
      "南遊道士飲一鬥，臥向白雲深洞口。"
    ]
  },
  {
    "uid": "QTS_861_040_01",
