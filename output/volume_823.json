      }
    ]
  },
  {
    "uid": "QTS_823_011_01",
    "volume": 823,
    "author": {
      "canonical": "元孚",
      "recorded": "元孚",
      "gender": "male"
    },
    "title": "送李四校書",
    "poem": [
      "朱絲寫別鶴泠泠，詩滿紅箋月滿庭。",
      "莫學楚狂隳姓字，知音還有子期聽。"
    ]
  },
  {
    "uid": "QTS_823_012_01",
    "volume": 823,
    "author": {
      "canonical": "棲白",
      "recorded": "棲白",
      "gender": "male"
    },
    "title": "邊思",
    "poem": [
      "西北黃雲暮，聲聲畫角愁。",
      "陰山一夜雨，白草四郊秋。",
      "亂雁鳴寒渡，飛沙入廢樓。",
      "何時番色盡，此地見芳洲。"
    ]
  },
  {
    "uid": "QTS_823_013_01",
    "volume": 823,
    "author": {
      "canonical": "棲白",
      "recorded": "棲白",
      "gender": "male"
    },
    "title": "八月十五夜翫月",
    "poem": [
      "尋常三五夜，不是不嬋娟。",
      "及至中秋滿，還勝別夜圓。",
      "清光凝有露，皓魄爽無煙。",
      "自古人皆望，年來又一年。"
    ]
  },
  {
    "uid": "QTS_823_014_01",
    "volume": 823,
    "author": {
      "canonical": "棲白",
      "recorded": "棲白",
      "gender": "male"
    },
    "title": "尋山僧真勝上人不遇",
    "poem": [
      "松下禪棲所，苔滋徑莫分。",
      "青山春暮見，流水夜深聞。",
      "不坐看心石，應隨出定雲。",
      "猨猱非可問，巖谷自空曛。"
    ]
  },
  {
    "uid": "QTS_823_015_01",
    "volume": 823,
    "author": {
      "canonical": "棲白",
      "recorded": "棲白",
      "gender": "male"
    },
    "title": "贈李溟秀才",
    "poem": [
      "南居古廟深，高樹宿山禽。",
      "明月上清漢，騷人動楚吟。",
      "數篇正始韻，一片補亡心。",
      "孤悄欺何謝，雲波不可尋。"
    ]
  },
  {
    "uid": "QTS_823_016_01",
    "volume": 823,
    "author": {
      "canonical": "棲白",
      "recorded": "棲白",
      "gender": "male"
    },
    "title": "送石秀才",
    "poem": [
      "正是歎羈游，知音拜楚侯。",
      "何須辭遠道，自可樂扁舟。",
      "倚棹江洲雨，聞猨島岫秋。",
      "謝家山水興，終日待詩流。"
    ]
  },
  {
    "uid": "QTS_823_017_01",
    "volume": 823,
    "author": {
      "canonical": "棲白",
      "recorded": "棲白",
      "gender": "male"
    },
    "title": "送造微上人游五臺及禮本師",
    "poem": [
      "寒空金錫響，欲過渭陽津。",
      "極目多來雁，孤城少故人。",
      "與師雖別久，於法本相親。",
      "又對清涼月，中宵語宿因。"
    ]
  },
  {
    "uid": "QTS_823_018_01",
    "volume": 823,
    "author": {
      "canonical": "棲白",
      "recorded": "棲白",
      "gender": "male"
    },
    "title": "送禪師宗極歸玉峰",
    "poem": [
      "背郭去歸宿，頭陀意頗濃。",
      "鶴爭棲遠樹，猿鬬上孤峯。",
      "夜戍經霜月，秋城過雨鐘。",
      "由來無定止，何處訪高蹤。"
    ]
  },
  {
    "uid": "QTS_823_019_01",
    "volume": 823,
    "author": {
      "canonical": "棲白",
      "recorded": "棲白",
      "gender": "male"
    },
    "title": "送僧歸舊山",
    "poem": [
      "談空與破邪，獻壽複榮家。",
      "白日得何偈，青天落幾花。",
      "傳燈皆有分，化俗獨無涯。",
      "卻入中峯寺，還知有聚沙。"
    ],
    "variants": [
      {
        "line": 2,
        "text": "白日",
        "variant": "百生",
        "source": "一作「百生」"
      }
    ]
  },
  {
    "uid": "QTS_823_020_01",
    "volume": 823,
    "author": {
      "canonical": "棲白",
      "recorded": "棲白",
      "gender": "male"
    },
    "title": "送圓仁三藏歸本國",
    "poem": [
      "家山臨晚日，海路信歸橈。",
      "樹滅渾無岸，風生只有潮。",
      "歲窮程未盡，天末國仍遙。",
      "已入閩王夢，香花境外邀。"
    ]
  },
  {
    "uid": "QTS_823_021_01",
    "volume": 823,
    "author": {
      "canonical": "棲白",
      "recorded": "棲白",
      "gender": "male"
    },
    "title": "送王煉師歸嵩嶽",
    "poem": [
      "飄然綠毛節，杳去洛城端。",
      "隔水見秋嶽，兼霜掃石壇。",
      "一溪松色古，半夜鶴聲寒。",
      "迥與人寰別，勞生不可觀。"
    ]
  },
  {
    "uid": "QTS_823_022_01",
    "volume": 823,
    "author": {
      "canonical": "棲白",
      "recorded": "棲白",
      "gender": "male"
    },
    "title": "壽昌節賦得紅雲表夏日",
    "poem": [
      "景候融融陰氣潛，如峯雲共火相兼。",
      "霞光捧日登天上，丹彩乘風入殿簷。",
      "行逐赤龍千歲出，明當朱夏萬方瞻。",
      "微臣多幸逢佳節，得賦殊祥近御簾。"
    ]
  },
  {
    "uid": "QTS_823_023_01",
    "volume": 823,
    "author": {
      "canonical": "棲白",
      "recorded": "棲白",
      "gender": "male"
    },
    "title": "經廢宮",
    "poem": [
      "終日河聲咽暮空，煙愁此地晝濛濛。",
      "錦帆東去沙侵苑，玉輦西來樹滿宮。",
      "魯客望津天欲雪，朔鴻離岸葦生風。",
      "那堪獨立思前事，回首殘陽雉堞紅。"
    ]
  },
  {
    "uid": "QTS_823_024_01",
    "volume": 823,
    "author": {
      "canonical": "棲白",
      "recorded": "棲白",
      "gender": "male"
    },
    "title": "贈識古法師",
    "poem": [
      "重城深寺講初休，卻憶家山訪舊游。",
      "對月與君相送夜，聞蛩教我獨驚秋。",
      "雲心杳杳難為別，鶴性蕭蕭不可留。",
      "遙想孤舟清渭上，飄然帆影起離愁。"
    ]
  },
  {
    "uid": "QTS_823_025_01",
    "volume": 823,
    "author": {
      "canonical": "棲白",
      "recorded": "棲白",
      "gender": "male"
    },
    "title": "月夜懷劉秀才",
    "poem": [
      "獨夜相思但自勞，阮生吟罷夢雲濤。",
      "此時小定未禪寂，古塔月中松磬高。"
    ],
