      }
    ]
  },
  {
    "uid": "QTS_823_002_01",
    "volume": 823,
    "author": {
      "canonical": "善生",
      "recorded": "善生",
      "gender": "male"
    },
    "title": "旅中答喻軍事問客情",
    "poem": [
      "一自遊他國，相逢少故人。",
      "縱然為客樂，爭似在家貧。",
      "畜恨霜侵鬢，搜詩病入神。",
      "若非憐片善，誰肯問風塵。"
    ]
  },
  {
    "uid": "QTS_823_003_01",
    "volume": 823,
    "author": {
      "canonical": "善生",
      "recorded": "善生",
      "gender": "male"
    },
    "title": "贈盧逸人",
    "poem": [
      "高眠巖野間，至藝敵應難。",
      "詩苦無多首，藥靈惟一丸。",
      "引泉魚落釜，攀果露沾冠。",
      "已得嵇康趣，逢迎事每闌。"
    ]
  },
  {
    "uid": "QTS_823_004_01",
    "volume": 823,
    "author": {
      "canonical": "善生",
      "recorded": "善生",
      "gender": "male"
    },
    "title": "送玉禪師",
    "poem": [
      "飄然無定跡，迥與律乘違。",
      "入郭隨緣住，思山破夏歸。",
      "盂擎數家飯，衲乞幾人衣。",
      "洞了曹溪旨，寧輸俗者機。"
    ],
    "notes": [
      {
        "line": 2,
        "content": "過夏不終，謂之破夏。",
        "context": "盂擎數家飯，衲乞幾人衣。"
      }
    ]
  },
  {
    "uid": "QTS_823_005_01",
    "volume": 823,
    "author": {
      "canonical": "善生",
      "recorded": "善生",
      "gender": "male"
    },
    "title": "送智光之南值雨",
    "poem": [
      "結束衣囊了，炎州定去游。",
      "草堂方惜別，山雨為相留。",
      "又得一宵話，免生千里愁。",
      "莫辭重卜日，後會必經秋。"
    ]
  },
  {
    "uid": "QTS_823_006_01",
    "volume": 823,
    "author": {
      "canonical": "韜光",
      "recorded": "韜光",
      "gender": "male"
    },
    "title": "謝白樂天招",
    "poem": [
      "山僧野性好林泉，每向岩阿倚石眠。",
      "不解栽松陪玉勒，惟能引水種金蓮。",
      "白雲乍可來青嶂，明月難教下碧天。",
      "城市不能飛錫去，恐妨鶯囀翠樓前。"
    ]
  },
  {
    "uid": "QTS_823_007_01",
    "volume": 823,
    "author": {
      "canonical": "知玄",
      "recorded": "知玄",
      "gender": "male"
    },
    "title": "五歲詠花",
    "poem": [
      "花開滿樹紅，花落萬枝空。",
      "唯餘一朵在，明日定隨風。"
    ]
  },
  {
    "uid": "QTS_823_008_01",
    "volume": 823,
    "author": {
      "canonical": "知玄",
      "recorded": "知玄",
      "gender": "male"
    },
    "title": "祝堯詩",
    "poem": [
      "生天本自生天業，未必求仙便得仙。",
      "鶴背傾危龍背滑，君王且住一千年。"
    ]
  },
  {
    "uid": "QTS_823_009_01",
    "volume": 823,
    "author": {
      "canonical": "知玄",
      "recorded": "知玄",
      "gender": "male"
    },
    "title": "答僧澈",
    "poem": [
      "觀君法苑思沖虛，使我真乘刃有餘。",
      "若使龍光時可待，應憐僧肇論成初。",
      "五車外典知誰敵，九趣多才恐不如。",
      "蕭寺講軒橫淡蕩，帝鄉雲樹正扶疎。",
      "幾生曾得闍瑜意，今日堪將貝葉書。",
      "一振微言冠千古，何人執卷問吾廬。"
    ]
  },
  {
    "uid": "QTS_823_010_01",
    "volume": 823,
    "author": {
      "canonical": "元孚",
      "recorded": "元孚",
      "gender": "male"
    },
    "title": "月夜懷劉秀才",
    "poem": [
      "獨夜相思但自勞，阮生吟罷夢雲濤。",
      "此時小定未禪寂，古塔月中松磬高。"
    ],
    "notes": [
