  {
    "uid": "QTS_823_026_01",
    "volume": 823,
    "author": {
      "canonical": "棲白",
      "recorded": "棲白",
      "gender": "male"
    },
    "title": "寄南山景禪師",
    "poem": [
      "一度林前見遠公，靜聞真語世情空。",
      "至今寂寞禪心在，任起桃花柳絮風。"
    ]
  },
  {
    "uid": "QTS_823_027_01",
    "volume": 823,
    "author": {
      "canonical": "棲白",
      "recorded": "棲白",
      "gender": "male"
    },
    "title": "哭劉得仁",
    "poem": [
      "為愛詩名吟至死，風魂雪魄去難招。",
      "直須桂子落墳上，生得一枝冤始消。"
    ],
    "variants": [
      {
