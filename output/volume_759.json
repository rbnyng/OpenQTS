[
  {
    "uid": "QTS_759_001_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "杜鵑花",
    "poem": [
      "杜鵑花與鳥，怨豔兩何賒。",
      "疑是口中血，滴成枝上花。",
      "一聲寒食夜，數朵野僧家。",
      "謝豹出不出，日遲遲又斜。"
    ],
    "preface": "成彥雄，字文幹，南唐進士。《梅嶺集》五卷，今編詩一卷。"
  },
  {
    "uid": "QTS_759_002_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "江上楓",
    "poem": [
      "江楓自蓊鬱，不競松筠力。",
      "一葉落漁家，殘陽帶秋色。"
    ]
  },
  {
    "uid": "QTS_759_003_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "夜夜曲",
    "poem": [
      "自從君去夜，錦幌孤蘭麝。",
      "欹枕對銀缸，秦箏綠窗下。"
    ]
  },
  {
    "uid": "QTS_759_004_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "村行",
    "poem": [
      "曖曖村煙暮，牧童出深塢。",
      "騎牛不顧人，吹笛尋山去。"
    ]
  },
  {
    "uid": "QTS_759_005_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "煎茶",
    "poem": [
      "岳寺春深睡起時，虎跑泉畔思遲遲。",
      "蜀茶倩個雲僧碾，自拾枯松三四枝。"
    ]
  },
  {
    "uid": "QTS_759_006_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "松",
    "poem": [
      "大夫名價古今聞，盤屈孤貞更出羣。",
      "將謂嶺頭閒得了，夕陽猶掛數枝雲。"
    ]
  },
  {
    "uid": "QTS_759_007_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "新燕",
    "poem": [
      "纔離海島宿江濱，應夢笙歌作近鄰。",
      "減省雕梁並頭語，畫堂中有未歸人。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "海",
        "variant": "江",
        "source": "一作「江」"
      }
    ]
  },
  {
    "uid": "QTS_759_008_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "會友不至",
    "poem": [
      "王孫還是負佳期，玉馬追遊日漸西。",
      "獨上郊原人不見，鷓鴣飛過落花溪。"
    ]
  },
  {
    "uid": "QTS_759_009_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "惜花",
    "poem": [
      "忘餐為戀滿枝紅，錦障頻移護晚風。",
      "客散酒酣歸未得，欄邊獨立月明中。"
    ]
  },
  {
    "uid": "QTS_759_010_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "中秋月",
    "poem": [
      "王母粧成鏡未收，倚欄人在水精樓。",
      "笙歌莫占清光盡，留與溪翁一釣舟。"
    ]
  },
  {
    "uid": "QTS_759_011_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "暮春日宴溪亭",
    "poem": [
      "寒食尋芳遊不足，溪亭還醉綠楊煙。",
      "誰家花落臨流樹，數片殘紅到檻前。"
    ]
  },
  {
    "uid": "QTS_759_012_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "曉",
    "poem": [
      "列宿回元朝北極，爽神晞露滴樓臺。",
      "佳人卷箔臨階砌，笑指庭花昨夜開。"
    ]
  },
  {
    "uid": "QTS_759_013_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "夕",
    "poem": [
      "臺榭沉沉禁漏初，麝煙紅蠟透蝦鬚。",
      "雕籠鸚鵡將棲宿，不許鵶鬟轉轆轤。"
    ]
  },
  {
    "uid": "QTS_759_014_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "露",
    "poem": [
      "銀河昨夜降醍醐，灑遍坤維萬象蘇。",
      "疑是鮫人曾泣處，滿池荷葉捧真珠。"
    ]
  },
  {
    "uid": "QTS_759_015_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "游紫陽宮",
    "poem": [
      "古殿煙霞簇畫屏，直疑蹤跡到蓬瀛。",
      "碧桃滿地眠花鹿，深院松窗搗藥聲。"
    ]
  },
  {
    "uid": "QTS_759_016_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "除夜",
    "poem": [
      "銅龍看卻送春來，莫惜顛狂酒百杯。",
      "吟鬢就中專擬白，那堪更被二更催。"
    ]
  },
  {
    "uid": "QTS_759_017_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "元日",
    "poem": [
      "戴星先捧祝堯觴，鏡裏堪驚兩鬢霜。",
      "好是燈前偷失笑，屠蘇應不得先嘗。"
    ]
  },
  {
    "uid": "QTS_759_018_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "寒夜吟",
    "poem": [
      "洞房脈脈寒宵永，燭影香消金鳳冷。",
      "猧兒睡魘喚不醒，滿窗撲落銀蟾影。"
    ]
  },
  {
    "uid": "QTS_759_019_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "柳枝辭九首 其一",
    "poem": [
      "輕籠小徑近誰家，玉馬追風翠影斜。",
      "愛把長條惱公子，惹他頭上海棠花。"
    ],
    "part_index": 1,
    "total_parts": 9
  },
  {
    "uid": "QTS_759_019_02",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "柳枝辭九首 其二",
    "poem": [
      "鵝黃剪出小花鈿，綴上芳枝色轉鮮。",
      "飲散無人收拾得，月明階下伴鞦韆。"
    ],
    "part_index": 2,
    "total_parts": 9
  },
  {
    "uid": "QTS_759_019_03",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "柳枝辭九首 其三",
    "poem": [
      "東君愛惜與先春，草澤無人處也新。",
      "委囑露華並細雨，莫教遲日惹風塵。"
    ],
    "part_index": 3,
    "total_parts": 9
  },
  {
    "uid": "QTS_759_019_04",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "柳枝辭九首 其四",
    "poem": [
      "句踐初迎西子年，琉璃為帚掃溪煙。",
      "至今不改當時色，留與王孫繫酒船。"
    ],
    "part_index": 4,
    "total_parts": 9
  },
  {
    "uid": "QTS_759_019_05",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "柳枝辭九首 其五",
    "poem": [
      "綠楊移傍小亭栽，便擁穠煙撥不開。",
      "誰把金刀為刪掠，放教明月入窗來。"
    ],
    "part_index": 5,
    "total_parts": 9
  },
  {
    "uid": "QTS_759_019_06",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "柳枝辭九首 其六",
    "poem": [
      "遠接關河高接雲，雨餘洗出半天津。",
      "牡丹不用相輕薄，自有清陰覆得人。"
    ],
    "part_index": 6,
    "total_parts": 9
  },
  {
    "uid": "QTS_759_019_07",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "柳枝辭九首 其七",
    "poem": [
      "掩映鶯花媚有餘，風流才調比應無。",
      "朝朝奉御臨池上，不羨青松拜大夫。"
    ],
    "part_index": 7,
    "total_parts": 9
  },
  {
    "uid": "QTS_759_019_08",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "柳枝辭九首 其八",
    "poem": [
      "王孫宴罷曲江池，折取春光伴醉歸。",
      "怪得美人爭鬬乞，要他穠翠染羅衣。"
    ],
    "part_index": 8,
    "total_parts": 9
  },
  {
    "uid": "QTS_759_019_09",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "柳枝辭九首 其九",
    "poem": [
      "殘照林梢嫋數枝，能招醉客上金堤。",
      "馬驕如練纓如火，瑟瑟陰中步步嘶。"
    ],
    "part_index": 9,
    "total_parts": 9
  },
  {
    "uid": "QTS_759_020_01",
    "volume": 759,
    "author": {
      "canonical": "成彥雄",
      "recorded": "成彥雄"
    },
    "title": "句",
    "poem": [
      "莎草放茵深護砌，海榴噴火巧橫牆。",
      "紋鱗引子跳銀海，紫燕呼雛語畫梁。"
    ],
