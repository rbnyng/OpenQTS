    "title": "珠",
    "poem": [
      "燦爛金輿側，玲瓏玉殿隈。",
      "昆池明月滿，合浦夜光回。",
      "彩逐靈蛇轉，行隨舞鳳來。",
      "甘泉宮起罷，花媚望風臺。"
    ]
  },
  {
    "uid": "QTS_060_002_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "玉",
    "poem": [
      "映石先過魏，連城欲向秦。",
      "洛陽陪勝友，燕趙類佳人。",
      "方水晴虹媚，常山瑞馬新。",
      "徒爲卞和識，不遇楚王珍。"
    ]
  },
  {
    "uid": "QTS_060_003_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "金",
    "poem": [
      "南楚標前貢，西秦識舊城。",
      "祭天封漢嶺，擲地警孫聲。",
      "向日披沙淨，含風振鐸鳴。",
      "方同楊伯起，獨有四知名。"
    ]
  },
  {
    "uid": "QTS_060_004_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "銀",
    "poem": [
      "思婦屏輝掩，遊人燭影長。",
      "玉壺初下箭，桐井共安牀。",
      "色帶長河色，光浮滿月光。",
      "靈山有珍甕，仙闕薦君王。"
    ]
  },
  {
    "uid": "QTS_060_005_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "錢",
    "poem": [
      "漢日五銖建，姬年九府流。",
      "天龍帶泉寶，地馬列金溝。",
      "趙壹囊初乏，何曾箸欲收。",
      "金門應入論，玉井冀來求。"
    ]
  },
  {
    "uid": "QTS_060_006_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "錦",
    "poem": [
      "漢使巾車遠，河陽步障陳。",
      "雲浮仙石日，霞滿蜀江春。",
      "機迥回文巧，紳兼束髪新。",
      "若逢楚王貴，不作夜行人。"
    ]
  },
  {
    "uid": "QTS_060_007_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "羅",
    "poem": [
      "妙舞隨裙動，行歌入扇清。",
      "蓮花依帳發，秋月鑒帷明。",
      "雲薄衣初捲，蟬飛翼轉輕。",
      "若珍三代服，同擅綺紈名。"
    ]
  },
  {
    "uid": "QTS_060_008_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "綾",
    "poem": [
      "金縷通秦國，爲裘指魏君。",
      "落花遙寫霧，飛鶴近圖雲。",
      "馬眼冰凌影，竹根雪霰文。",
      "何當畫秦女，煙際坐氤氳。"
    ]
  },
  {
    "uid": "QTS_060_009_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "素",
    "poem": [
      "□□□□女，纖腰洛浦妃。",
      "□□遠方望，雁足上林飛。",
      "妙奪鮫綃色，光騰月扇輝。",
      "非君下路去，誰賞故人機。"
    ]
  },
  {
    "uid": "QTS_060_010_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "布",
    "poem": [
      "御績創羲黃，緇冠表素王。",
      "瀑飛臨碧海，火浣擅炎方。",
      "孫被登三相，劉衣闡四方。",
      "佇因舂斗粟，來曉棣華芳。"
    ]
  },
  {
    "uid": "QTS_060_011_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "舟",
    "poem": [
      "征櫂三江暮，連檣萬里回。",
      "相烏風際轉，畫鷁浪前開。",
      "羽客乘霞至，仙人弄月來。",
      "何當同傅說，特展巨川材。"
    ]
  },
  {
    "uid": "QTS_060_012_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "車",
    "poem": [
      "天子馭金根，蒲輪闢四門。",
      "五神趨雪至，雙轂似雷奔。",
      "丹鳳棲金轄，非熊載寶軒。",
      "無階忝虛左，珠乘奉王言。"
    ]
  },
  {
    "uid": "QTS_060_013_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "牀",
    "poem": [
      "傳聞有象牀，疇昔獻君王。",
      "玳瑁千金起，珊瑚七寶妝。",
      "桂筵含柏馥，蘭席拂沈香。",
      "願奉羅帷夜，長乘秋月光。"
    ]
  },
  {
    "uid": "QTS_060_014_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "席",
    "poem": [
      "避席承宣父，重筵揖戴公。",
      "桂香浮半月，蘭氣襲回風。",
      "舞拂丹霞上，歌清白雪中。",
      "佇將文綺色，舒捲帝王宮。"
    ]
  },
  {
    "uid": "QTS_060_015_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "帷",
    "poem": [
      "久閉先生戶，高褰太守車。",
      "羅將翡翠合，錦逐鳳皇舒。",
      "明月彈琴夜，清風入幌初。",
      "方知決勝策，黃石受兵書。"
    ]
  },
  {
    "uid": "QTS_060_016_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "簾",
    "poem": [
      "清風時入燕，紫殿幾含秋。",
      "曖曖籠鈴閣，纖纖上玉鉤。",
      "窗中翡翠動，戶外水精浮。",
      "巧作盤龍勢，長迎飛燕遊。"
    ]
  },
  {
    "uid": "QTS_060_017_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "屏",
    "poem": [
      "洞徹琉璃蔽，威紆屈膝回。",
      "錦中雲母列，霞上織成開。",
      "山上含春動，神仙倒景來。",
      "脩身兼竭節，誰識作銘才。"
    ]
  },
  {
    "uid": "QTS_060_018_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "被",
    "poem": [
      "桂友尋東閣，蘭交聚北堂。",
      "象筵分錦繡，羅薦合鴛鴦。",
      "光逸偷眠穩，王章泣恨長。",
      "孔懷欣共寢，棣萼幾含芳。"
    ]
  },
  {
    "uid": "QTS_060_019_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "鑑",
    "poem": [
      "明鑑掩塵埃，含情照魏臺。",
      "日中烏鵲至，花裏鳳皇來。",
      "玉彩疑冰徹，金輝似月開。",
      "方知樂彥輔，自有鑒人才。"
    ]
  },
  {
    "uid": "QTS_060_020_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "扇",
    "poem": [
      "翟羽舊傳名，蒲葵價不輕。",
      "花芳不滿面，羅薄詎障聲。",
      "禦熱含風細，臨秋帶月明。",
      "同心如可贈，持表合歡情。"
    ]
  },
  {
    "uid": "QTS_060_021_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "燭",
    "poem": [
      "兔月清光隱，龍盤畫燭新。",
      "三星花入夜，四序玉調晨。",
      "浮炷依羅幌，吹香匝綺茵。",
      "若逢燕國相，持用舉賢人。"
    ]
  },
  {
    "uid": "QTS_060_022_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "酒",
    "poem": [
      "孔坐洽良儔，陳筵幾獻酬。",
      "臨風竹葉滿，湛月桂香浮。",
      "每接高陽宴，長陪河朔遊。",
      "會從玄石飲，雲雨出圓丘。"
    ]
  },
  {
    "uid": "QTS_060_023_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "蘭",
    "poem": [
      "虛室重招尋，忘言契斷金。",
      "英浮漢家酒，雪儷楚王琴。",
      "廣殿輕香發，高臺遠吹吟。",
      "河汾應擢秀，誰肯訪山陰。"
    ]
  },
  {
    "uid": "QTS_060_024_01",
    "volume": 60,
    "author": {
      "canonical": "李嶠",
      "recorded": "李嶠",
      "gender": "male",
      "period": "Early Tang",
      "english_name": "Li Jiao",
      "wikidata_id": "Q1564707"
    },
    "title": "菊",
    "poem": [
      "玉律三秋暮，金精九日開。",
      "榮舒洛媛浦，香泛野人杯。",
      "靃靡寒潭側，丰茸曉岸隈。",
      "黃花今日晚，無復白衣來。"
    ]
  },
  {
    "uid": "QTS_060_025_01",
    "volume": 60,
    "author": {
