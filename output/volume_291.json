    "title": "奉酬韋滁州寄示",
    "poem": [
      "淮揚為郡暇，坐惜流芳歇。",
      "散懷累榭風，清暑澄潭月。",
      "陪燕辭三楚，戒途綿百越。",
      "非當遠別離，雅奏何由發。"
    ]
  },
  {
    "uid": "QTS_291_002_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "梅裏旅夕",
    "poem": [
      "滄洲東望路，旅棹愴羈遊。",
      "楓浦蟬隨岸，沙汀鷗轉流。",
      "露天星上月，水國夜生秋。",
      "誰忍持相憶，南歸一葉舟。"
    ]
  },
  {
    "uid": "QTS_291_003_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "鐘陵雪夜酬友人",
    "poem": [
      "窮臘催年急，陽春怯和歌。",
      "殘燈閃壁盡，夜雪透窗多。",
      "歸路山川險，遊人夢寐過。",
      "龍洲不可泊，歲晚足驚波。"
    ]
  },
  {
    "uid": "QTS_291_004_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "潤州水樓",
    "poem": [
      "歸心不可留，雪桂一叢秋。",
      "葉雨空江月，螢飛白露洲。",
      "野蟬依獨樹，水郭帶孤樓。",
      "遙望山川路，相思萬里遊。"
    ]
  },
  {
    "uid": "QTS_291_005_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "江上秋月",
    "poem": [
      "隴雁送鄉心，羈情屬歲陰。",
      "驚秋黃葉遍，愁暮碧雲深。",
      "月色吳江上，風聲楚木林。",
      "交親幾重別，歸夢並愁侵。"
    ]
  },
  {
    "uid": "QTS_291_006_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "閣前雙槿",
    "poem": [
      "群玉開雙槿，丹榮對絳紗。",
      "含煙疑出火，隔雨怪舒霞。",
      "向晚爭辭蕊，迎朝鬥發花。",
      "非關後桃李，為欲繼年華。"
    ]
  },
  {
    "uid": "QTS_291_007_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "小苑春望宮池柳色",
    "poem": [
      "上苑閒遊早，東風柳色輕。",
      "儲胥遙掩映，池水隔微明。",
      "春至條偏弱，寒餘葉未成。",
      "和煙變濃淡，轉日異陰晴。",
      "不獨芳菲好，還因雨露榮。",
      "行人望攀折，遠翠暮愁生。"
    ]
  },
  {
    "uid": "QTS_291_008_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "送客往睦州",
    "poem": [
      "水闊盡南天，孤舟去渺然。",
      "驚秋路傍客，日暮數聲蟬。"
    ]
  },
  {
    "uid": "QTS_291_009_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "送客之蜀",
    "poem": [
      "西蜀三千里，巴南水一方。",
      "曉雲天際斷，夜月峽中長。"
    ]
  },
  {
    "uid": "QTS_291_010_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "剡溪看花",
    "poem": [
      "花落千回舞，鶯聲百囀歌。",
      "還同異方樂，不奈客愁多。"
    ]
  },
  {
    "uid": "QTS_291_011_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "江中風",
    "poem": [
      "白浪暗江中，南泠路不通。",
      "高檣帆自滿，出浦莫呼風。"
    ]
  },
  {
    "uid": "QTS_291_012_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "詠破扇",
    "poem": [
      "粉落空床棄，塵生故篋留。",
      "先來無一半，情斷不勝愁。"
    ]
  },
  {
    "uid": "QTS_291_013_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "賈客愁",
    "poem": [
      "山水路悠悠，逢灘即殢留。",
      "西江風未便，何日到荊州。"
    ]
  },
  {
    "uid": "QTS_291_014_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "即事寄人",
    "poem": [
      "中禁鳴鐘日欲高，北窗欹枕望頻搔。",
      "相思寂寞青苔合，唯有春風啼伯勞。"
    ]
  },
  {
    "uid": "QTS_291_015_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "早春雪中",
    "poem": [
      "新年雨雪少晴時，屢失尋梅看柳期。",
      "鄉信憶隨回鴈早，江春寒帶故陰遲。"
    ]
  },
  {
    "uid": "QTS_291_016_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "北行留別",
    "poem": [
      "日日山川烽火頻，山河重起舊煙塵。",
      "一生孤負龍泉劍，羞把詩書問故人。"
    ]
  },
  {
    "uid": "QTS_291_017_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "秋原野望",
    "poem": [
      "客鴈秋來次第逢，家書頻寄兩三封。",
      "夕陽天外雲歸盡，亂見青山無數峰。"
    ]
  },
  {
    "uid": "QTS_291_018_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "春霽花萼樓南聞宮鶯",
    "poem": [
      "祥煙瑞氣曉來輕，柳變花開共作晴。",
      "黃鳥遠啼鳷鵲觀，春風流出鳳凰城。"
    ]
  },
  {
    "uid": "QTS_291_019_01",
    "volume": 291,
    "author": {
      "canonical": "楊淩",
      "recorded": "楊淩",
      "gender": "male",
      "wikidata_id": "Q30017921"
    },
    "title": "明妃怨",
    "poem": [
      "漢國明妃去不還，馬馱絃管向陰山。",
      "匣中縱有菱花鏡，羞對單于照舊顏。"
    ]
  },
  {
    "uid": "QTS_291_020_01",
