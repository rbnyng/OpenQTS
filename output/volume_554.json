      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "晚春花",
    "poem": [
      "陰洞日光薄，花開不及時。",
      "當春無半樹，經燒足空枝。",
      "疏與香風會，細將泉影移。",
      "此中人到少，開盡幾人知。"
    ],
    "variants": [
      {
