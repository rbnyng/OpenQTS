    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "送顧少府",
    "poem": [
      "作尉年猶少，無辭去路賒。",
      "漁舟縣前泊，山吏日高衙。",
      "幽景臨谿寺，秋蟬織杼家。",
      "行程須過越，先醉鏡湖花。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "杼",
        "variant": "紵",
