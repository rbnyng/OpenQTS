    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "咸陽別李處士",
    "poem": [
      "古道自迢迢，咸陽離別橋。",
      "越人聞水處，秦樹帶霜朝。",
      "駐馬言難盡，分程望易遙。",
      "秋前未相見，此意轉蕭條。"
    ],
    "variants": [
      {
        "line": 4,
        "text": "轉",
        "variant": "各",
        "source": "一作「各」"
      }
    ]
  },
  {
    "uid": "QTS_554_037_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "寄流人",
    "poem": [
      "毒草不曾枯，長添客健無。",
      "霧開蠻市合，船散海城孤。",
      "象跡頻藏齒，龍涎遠蔽珠。",
      "家人秦地老，泣對日南圖。"
    ]
  },
  {
    "uid": "QTS_554_038_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "華頂道者",
    "poem": [
      "仙人掌中住，生有上天期。",
      "已廢燒丹處，猶多種杏時。",
      "養龍於淺水，寄鶴在高枝。",
      "得道復無事，相逢盡日棋。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "生",
        "variant": "坐",
        "source": "一作「坐」"
      }
    ]
  },
  {
    "uid": "QTS_554_039_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "酬從叔聽夜泉見寄",
    "poem": [
      "夢罷更開戶，寒泉聲隔雲。",
      "共誰尋最遠，獨自坐偏聞。",
      "巖際和風滴，溪中泛月分。",
      "豈知當此夜，流念到江濆。"
    ]
  },
  {
    "uid": "QTS_554_040_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "和李用夫栽小松",
    "poem": [
      "移來未換葉，已勝在空山。",
      "靜對心標直，遙吟境助閑。",
      "影侵殘雪際，聲透小窗間。",
      "即聳淩空榦，翛翛豈易攀。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "空",
        "variant": "深",
        "source": "一作「深」"
      }
    ]
  },
  {
    "uid": "QTS_554_041_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "哭南流人",
    "poem": [
      "遙見南來使，江頭哭問君。",
      "臨終時有雪，旅葬處無雲。",
      "官庫空收劍，蠻僧共起墳。",
      "知名人尚少，誰為錄遺文。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "蠻",
        "variant": "山",
        "source": "一作「山」"
      }
    ]
  },
  {
    "uid": "QTS_554_042_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "經李白墓",
    "poem": [
      "夜郎歸未老，醉死此江邊。",
      "葬闕官家禮，詩殘樂府篇。",
      "遊魂應到蜀，小碣豈旌賢。",
      "身沒猶何罪，遺墳野火燃。"
    ]
  },
  {
    "uid": "QTS_554_043_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "春夜樊川竹亭陪諸同年宴",
    "poem": [
      "相知皆是舊，每恨獨遊頻。",
      "幸此同芳夕，寧辭倒醉身。",
      "燈光遙映燭，萼粉暗飄茵。",
      "明月分歸騎，重來更幾春。"
    ]
  },
  {
    "uid": "QTS_554_044_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "送僧",
    "poem": [
      "靈山巡未遍，不作住持心。",
      "逢寺暫投宿，是山皆獨尋。",
      "有時過靜界，在處想空林。",
      "從小即行腳，出家來至今。"
    ]
  },
  {
    "uid": "QTS_554_045_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "送蘇處士歸西山",
    "poem": [
      "南遊何所為，一篋又空歸。",
      "守道安清世，無心換白衣。",
      "深林蟬噪暮，絕頂客來稀。",
      "早晚重相見，論詩更及微。"
    ]
  },
  {
    "uid": "QTS_554_046_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "游爛柯山",
    "poem": [
      "步步出塵氛，溪山別是春。",
      "壇邊時過鶴，棋處寂無人。",
      "訪古碑多缺，探幽路不真。",
      "翻疑歸去晚，清世累移晨。"
    ]
  },
  {
    "uid": "QTS_554_047_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "送友人之永嘉",
    "poem": [
      "長貧知不易，去計擬何逃。",
      "相對人愁別，經過幾處勞。",
      "城連沙岫遠，山斷夏雲高。",
      "猶想成詩處，秋燈半照濤。"
    ]
  },
  {
    "uid": "QTS_554_048_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "巴中逢故人",
    "poem": [
      "勞思空積歲，偶會更無由。",
      "以分難相舍，將行且暫留。",
      "路岐何處極，江峽半猿愁。",
      "到此分南北，離懷豈易收。"
    ]
  },
  {
    "uid": "QTS_554_049_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "送歸江州友人初下第",
    "poem": [
      "名高不俟召，收采獻君門。",
      "偶屈應緣數，他人盡為冤。",
      "新春城外路，舊隱水邊村。",
      "歸去無勞久，知君更待論。"
    ]
  },
  {
    "uid": "QTS_554_050_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "舜城懷古",
    "poem": [
      "禪禹遜堯聰，巍巍盛此中。",
      "四隅咸啟聖，萬古賴成功。",
      "道德去彌遠，山河勢不窮。",
      "停車一再拜，帝業即今同。"
    ]
  },
  {
    "uid": "QTS_554_051_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "送劉道士之成都嚴真觀",
    "poem": [
      "嚴君名不朽，道出二經中。",
      "歸去精誠懇，還應夢寐通。",
      "池台鏡定月，松檜雨餘風。",
      "想對靈玄憶，人間戀若空。"
    ],
    "notes": [
      {
        "content": "嚴公通老子，易以成道。",
        "context": "成都嚴真觀",
        "original_title": "送劉道士之成都嚴真觀〈嚴公通老子，易以成道。〉"
      }
    ]
  },
  {
    "uid": "QTS_554_052_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "漢南遇友人",
    "poem": [
      "此身西複東，何計此相逢。",
      "夢盡吳越水，恨深襄漢鐘。",
      "積雲開去路，曙雪疊前峰。",
      "誰即知非舊，憐君忽見容。"
    ]
  },
  {
    "uid": "QTS_554_053_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "遊頭陀寺上方",
    "poem": [
      "高步陟崔嵬，吟閑路惜回。",
      "寺知何代有，僧見梵天來。",
      "暮靄連沙積，餘霞遍檻開。",
      "更期招靜者，長嘯上南台。"
    ]
  },
  {
    "uid": "QTS_554_054_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "送友人遊河東",
    "poem": [
      "停車曉燭前，一語幾潸然。",
      "路去干戈日，鄉遙饑饉年。",
      "湖波晴見雁，槐驛晚無蟬。",
      "莫縱經時住，東南書信偏。"
    ]
  },
  {
    "uid": "QTS_554_055_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "中秋夜懷",
    "poem": [
      "趨馳早晚休，一歲又殘秋。",
      "若只如今日，何難至白頭。",
      "滄波歸處遠，旅食尚邊愁。",
      "賴見前賢說，窮通不自由。"
    ],
    "variants": [
      {
        "line": 3,
        "text": "尚",
        "variant": "向",
        "source": "一作「向」"
      }
    ]
  },
  {
    "uid": "QTS_554_056_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "寄富春孫路處士",
    "poem": [
      "平生醉與吟，誰是見君心。",
      "上國一歸去，滄江閑至今。",
      "鐘繁秋寺近，峰闊晚濤深。",
      "疏放長如此，何人長得尋。"
    ]
  },
  {
    "uid": "QTS_554_057_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "送客歸新羅",
    "poem": [
      "君家滄海外，一別見何因。",
      "風土雖知教，程途自致貧。",
      "浸天波色晚，橫笛鳥行春。",
      "明發千檣下，應無更遠人。"
    ]
  },
  {
    "uid": "QTS_554_058_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "杭州江亭留題登眺",
    "poem": [
      "處處日馳銷，憑軒夕似朝。",
      "漁翁閑鼓棹，沙鳥戲迎潮。",
      "樹間津亭密，城連塢寺遙。",
      "因誰報隱者，向此得耕樵。"
    ]
  },
  {
    "uid": "QTS_554_059_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "荊州夜與友親相遇",
    "poem": [
      "山海兩分岐，停舟偶似期。",
      "別來何限意，相見卻無辭。",
      "坐永神凝夢，愁繁鬢欲絲。",
      "趨名易遲晚，此去莫經時。"
    ]
  },
  {
    "uid": "QTS_554_060_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "送友人遊邊",
    "poem": [
      "方春到帝京，有戀有愁并。",
      "萬里江海思，半年沙塞程。",
      "綠陰斜向驛，殘照遠侵城。",
      "自可資新課，還期振盛名。"
    ],
    "variants": [
      {
        "line": 1,
        "text": "京",
        "variant": "城",
        "source": "一作「城」"
      }
    ]
  },
  {
    "uid": "QTS_554_061_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "題贈宣州亢拾遺",
    "poem": [
      "傳騎一何催，山門晝未開。",
      "高人終避世，聖主不遺才。",
      "坐次欹臨水，門中獨舉杯。",
      "誰為旦夕侶，深寺數僧來。"
    ]
  },
  {
    "uid": "QTS_554_062_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "姚氏池亭",
    "poem": [
      "池館饒嘉致，幽人愜所閑。",
      "篠風能動浪，岸樹不遮山。",
      "嘯檻魚驚後，眠窗鶴語間。",
      "何須說廬阜，深處更躋攀。"
    ]
  },
  {
    "uid": "QTS_554_063_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "送友人之江南",
    "poem": [
      "東南路苦辛，去路見無因。",
      "萬里此相送，故交誰更親。",
      "日浮汀草綠，煙霽海山春。",
      "握手無別贈，為予書札頻。"
    ]
  },
  {
    "uid": "QTS_554_064_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "彭蠡湖春望",
    "poem": [
      "湖亭東極望，遠棹不須回。",
      "遍草新湖落，連天眾雁來。",
      "蘆洲殘照盡，雲障積煙開。",
      "更想鴟夷子，扁舟安在哉。"
    ]
  },
  {
    "uid": "QTS_554_065_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "聞友人會裴明府縣樓",
    "poem": [
      "閑閣雨吹塵，陶家揖上賓。",
      "湖山萬疊翠，門樹一行春。",
      "景遍歸簷燕，歌喧已醉身。",
      "登臨興不足，喜有數來因。"
    ]
  },
  {
    "uid": "QTS_554_066_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "歸家山行",
    "poem": [
      "獻賦才何拙，經時不恥歸。",
      "能知此意是，甘取眾人非。",
      "遍隴耕無圃，緣溪釣有磯。",
      "此懷難自遣，期在振儒衣。"
    ]
  },
  {
    "uid": "QTS_554_067_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "長安書懷呈知己",
    "poem": [
      "江湖歸不易，京邑計長貧。",
      "獨夜有知己，論心無故人。",
      "一燈愁裏夢，九陌病中春。",
      "為問清平日，無門致出身。"
    ]
  },
  {
    "uid": "QTS_554_068_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "聞蟬",
    "poem": [
      "動葉復驚神，聲聲斷續勻。",
      "坐來同聽者，俱是未歸人。",
      "一棹三湘浪，單車二蜀塵。",
      "傷秋各有日，千可念因循。"
    ]
  },
  {
    "uid": "QTS_554_069_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "李處士道院南樓",
    "poem": [
      "霜晚復秋殘，樓明近遠山。",
      "滿壺邀我醉，一榻為僧閑。",
      "樹簇孤汀眇，帆欹積浪間。",
      "從容更南望，殊欲外人寰。"
    ]
  },
  {
    "uid": "QTS_554_070_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "送顧非熊及第歸茅山",
    "poem": [
      "吟詩三十載，成此一名難。",
      "自有恩門入，全無帝裏歡。",
      "湖光愁裏碧，巖景夢中寒。",
      "到後松杉月，何人共曉看。"
    ]
  },
  {
    "uid": "QTS_554_071_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "春日題李中丞樊川別墅",
    "poem": [
      "心知受恩地，到此亦裴回。",
      "上路移時立，中軒隔宿來。",
      "川光通沼沚，寺影帶樓臺。",
      "無限成蹊樹，花多向客開。"
    ]
  },
  {
    "uid": "QTS_554_072_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "龍州與韓將軍夜會",
    "poem": [
      "庭綠草纖纖，邊州白露沾。",
      "別歌緣劍起，客淚是愁添。",
      "見月鵲啼樹，避風雲滿簾。",
      "將軍盡尊酒，樓上賦星占。"
    ]
  },
  {
    "uid": "QTS_554_073_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "途中逢友人",
    "poem": [
      "長大有南北，山川各所之。",
      "相逢孤館夜，共憶少年時。",
      "爛醉百花酒，狂題幾首詩。",
      "來朝又分袂，後會鬢應絲。"
    ]
  },
  {
    "uid": "QTS_554_074_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "送友人下第歸襄陽",
    "poem": [
      "失意已春殘，歸愁與別難。",
      "山分關路細，江繞夜城寒。",
      "草色連晴阪，鼉聲離曉灘。",
      "差池是秋賦，何以暫懷安。"
    ]
  },
  {
    "uid": "QTS_554_075_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "宿山寺",
    "poem": [
      "栗葉重重復翠微，黃昏溪上語人稀。",
      "月明古寺客初到，風度閑門僧未歸。",
      "山果經霜多自落，水螢穿竹不停飛。",
      "中宵能得幾時睡，又被鐘聲催著衣。"
    ]
  },
  {
    "uid": "QTS_554_076_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "病鶴",
    "poem": [
      "青雲有意力猶微，豈料低回得所依。",
      "幸念翅因風雨困，豈教身陷稻粱肥。",
      "曾遊碧落寧無侶，見有清池不忍飛。",
      "縱使他年引仙駕，主人恩在亦應歸。"
    ]
  },
  {
    "uid": "QTS_554_077_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "夢仙",
    "poem": [
      "昨宵魂夢到仙津，得見蓬山不死人。",
      "雲葉許裁成野服，玉漿教吃潤愁身。",
      "紅樓近月宜寒水，綠杏搖風占古春。",
      "次第引看行未遍，浮光牽入世間塵。"
    ]
  },
  {
    "uid": "QTS_554_078_01",
    "volume": 554,
    "author": {
      "canonical": "項斯",
      "recorded": "項斯"
    },
    "title": "古扇",
    "poem": [
      "昨日裁成奪夏威，忽逢秋節便相違。",
      "寒塵妒盡秦王女，涼殿恩隨漢主妃。",
      "似月舊臨紅粉面，有風休動麝香衣。",
      "千年蕭瑟關人事，莫語當時掩淚歸。"
    ],
